{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0138oguazLXf6HS8bSDNR2QB","type":"tool_result","content":"1\t(ns yin.vm.ucf.ledger-test\n2\t  (:require [clojure.test :refer [deftest is testing]]\n3\t            [dao.jing.cbor :as cbor]\n4\t            [yin.vm.ucf.custody :as custody]\n5\t            [yin.vm.ucf.ledger :as ledger]))\n6\t\n7\t\n8\t(def ^:private arb \"arb\")\n9\t\n10\t(def ^:private target (ledger/target-identity arb 0))\n11\t\n12\t\n13\t(defn- record\n14\t  [t datoms]\n15\t  {:dao.space/transaction {:t t :datoms datoms}})\n16\t\n17\t\n18\t(defn- stamp\n19\t  \"Pad `[e a v]` datoms with t and the assertion op, as the transactor\n20\t   does.\"\n21\t  [t datoms]\n22\t  (mapv #(conj % t 1) datoms))\n23\t\n24\t\n25\t(def ^:private enrolled\n26\t  {:yin.k/custody :yin.k/enrolled\n27\t   :yin.k/target target\n28\t   :yin.k/effect-kinds #{:yin.k/append}})\n29\t\n30\t\n31\t(defn- admitted\n32\t  [op value]\n33\t  {:yin.k/custody :yin.k/admitted\n34\t   :yin.k/target target\n35\t   :yin.k/op-id {:yin.k/occurrence \"O\" :yin.k/seq op}\n36\t   :yin.k/intent (ledger/intent target value)\n37\t   :yin.k/value value\n38\t   :yin.k/result ledger/ok-result})\n39\t\n40\t\n41\t(defn- fold\n42\t  \"Fold each transaction's facts in turn, from the empty projection.\"\n43\t  [& txs]\n44\t  (reduce (fn [p facts]\n45\t            (if (::ledger/defect p)\n46\t              p\n47\t              (ledger/fold-record\n48\t                p\n49\t                (record (:next-t p)\n50\t                        (stamp (:next-t p)\n51\t                               (ledger/facts->datoms (:next-e p) facts))))))\n52\t          (ledger/empty-projection arb)\n53\t          txs))\n54\t\n55\t\n56\t(deftest datoms-follow-the-published-attribute-order\n57\t  (is (= [[16 :yin.k/custody :yin.k/enrolled]\n58\t          [16 :yin.k/target target]\n59\t          [16 :yin.k/effect-kinds #{:yin.k/append}]\n60\t          [17 :yin.k/custody :yin.k/target-closed]\n61\t          [17 :yin.k/target target]]\n62\t         (ledger/facts->datoms 16 [(into {} (reverse (seq enrolled)))\n63\t                                   {:yin.k/target target\n64\t                                    :yin.k/custody :yin.k/target-closed}])))\n65\t  (is (= [:yin.k/custody :yin.k/target :yin.k/op-id :yin.k/intent\n66\t          :yin.k/result]\n67\t         (mapv second\n68\t               (ledger/fact-datoms 20 (dissoc (admitted 0 :v) :yin.k/value))))\n69\t      \"an absent attribute is skipped, the rest keep their order\")\n70\t  (is (= 4503599627370495 ledger/max-exact)))\n71\t\n72\t\n73\t(deftest authoring-refuses-a-fact-outside-the-published-order\n74\t  (let [defect (fn [facts]\n75\t                 (try (ledger/facts->datoms 16 facts)\n76\t                      nil\n77\t                      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n78\t                        (::ledger/defect (ex-data e)))))]\n79\t    (is (= :unknown-kind (defect [{:yin.k/custody :yin.k/other}])))\n80\t    (is (= :unknown-kind (defect [{:yin.k/target target}]))\n81\t        \"a fact with no dispatch key\")\n82\t    (is (= :unpublished-attribute\n83\t           (defect [(assoc enrolled :yin.k/extra 1)]))\n84\t        \"an attribute outside the kind's order is never silently dropped\")\n85\t    (is (= :unknown-kind\n86\t           (defect [(assoc enrolled :dao.lease/status :dao.lease/accepted)]))\n87\t        \"both dispatch keys\")))\n88\t\n89\t\n90\t(deftest the-fold-builds-the-projection\n91\t  (let [p (fold [enrolled] [(admitted 0 :a) (admitted 1 :a)]\n92\t                [{:yin.k/custody :yin.k/target-closed :yin.k/target target}])]\n93\t    (is (= 3 (:next-t p)))\n94\t    (is (= 20 (:next-e p)))\n95\t    (is (= {target {:closed? true :values [:a :a]}} (:targets p)))\n96\t    (is (= ledger/ok-result\n97\t           (get-in p [:admitted (cbor/content-key {:yin.k/occurrence \"O\"\n98\t                                                   :yin.k/seq 1})\n99\t                      :yin.k/result])))))\n100\t\n101\t\n102\t(deftest the-fold-refuses-what-the-ledger-cannot-hold\n103\t  (testing \"transaction time must equal the position\"\n104\t    (is (= :t-mismatch\n105\t           (::ledger/defect\n106\t             (ledger/fold-record (ledger/empty-projection arb)\n107\t                                 (record 1 (stamp 1 (ledger/facts->datoms\n108\t                                                      16 [enrolled]))))))))\n109\t  (testing \"a datom stamped with another t\"\n110\t    (is (= :malformed-datom\n111\t           (::ledger/defect\n112\t             (ledger/fold-record (ledger/empty-projection arb)\n113\t                                 (record 0 (stamp 1 (ledger/facts->datoms\n114\t                                                      16 [enrolled]))))))))\n115\t  (testing \"a reused entity id\"\n116\t    (let [p (fold [enrolled])]\n117\t      (is (= :malformed-datom\n118\t             (::ledger/defect\n119\t               (ledger/fold-record\n120\t                 p (record 1 (stamp 1 (ledger/facts->datoms\n121\t                                        16 [(admitted 0 :a)])))))))))\n122\t  (testing \"a target this ledger did not mint at that t\"\n123\t    (is (= :foreign-target\n124\t           (::ledger/defect (fold [(assoc enrolled :yin.k/target \"x\")])))))\n125\t  (testing \"attributes out of the published order\"\n126\t    (is (= :malformed-fact\n127\t           (::ledger/defect\n128\t             (ledger/fold-record\n129\t               (ledger/empty-projection arb)\n130\t               (record 0 (stamp 0 (vec (reverse (ledger/facts->datoms\n131\t                                                  16 [enrolled]))))))))))\n132\t  (testing \"a duplicate op id\"\n133\t    (is (= :duplicate-op-id\n134\t           (::ledger/defect (fold [enrolled] [(admitted 0 :a)]\n135\t                                  [(admitted 0 :a)])))))\n136\t  (testing \"an admission to an unknown target\"\n137\t    (is (= :unknown-target (::ledger/defect (fold [(admitted 0 :a)])))))\n138\t  (testing \"a fact kind this ledger does not know\"\n139\t    (is (= :malformed-fact\n140\t           (::ledger/defect\n141\t             (ledger/fold-record\n142\t               (ledger/empty-projection arb)\n143\t               (record 0 (stamp 0 [[16 :yin.k/custody :yin.k/other]])))))))\n144\t  (testing \"a retraction: the ledger is add-only\"\n145\t    (is (= :malformed-datom\n146\t           (::ledger/defect\n147\t             (ledger/fold-record\n148\t               (ledger/empty-projection arb)\n149\t               (record 0\n150\t                       (mapv #(conj % 0 0)\n151\t                             (ledger/facts->datoms 16 [enrolled]))))))))\n152\t  (testing \"a non-record value\"\n153\t    (is (= :malformed-record\n154\t           (::ledger/defect\n155\t             (ledger/fold-record (ledger/empty-projection arb) :x))))))\n156\t\n157\t\n158\t;; =============================================================================\n159\t;; Custody facts (slice C5)\n160\t;; =============================================================================\n161\t\n162\t(def ^:private occ \"8f0c6a52-6a1e-4e43-9d55-3f0a4c1b2e01\")\n163\t\n164\t\n165\t(defn- address\n166\t  [digit]\n167\t  (keyword \"segment\" (str \"blake3-\" (apply str (repeat 64 digit)))))\n168\t\n169\t\n170\t(def ^:private addr-1 (address \"1\"))\n171\t\n172\t(def ^:private addr-2 (address \"2\"))\n173\t\n174\t\n175\t(def ^:private baseline\n176\t  {:yin.k/kind :blocked\n177\t   :yin.k/occurrence occ\n178\t   :yin.k/arbitration {:dao.stream/identity arb :dao.stream/descriptor {}}\n179\t   :yin.k/next-op-seq 0\n180\t   :yin.k/ops {}})\n181\t\n182\t\n183\t(defn- offered\n184\t  ([] (offered addr-1))\n185\t  ([address] (offered address baseline))\n186\t  ([address b] (custody/offer occ address \"carrier\" b)))\n187\t\n188\t\n189\t(defn- grant\n190\t  ([] (grant \"lease-1\" \"holder-a\"))\n191\t  ([l h]\n192\t   {:dao.lease/status :dao.lease/accepted\n193\t    :dao.lease/lease l\n194\t    :dao.lease/proposal \"p-1\"\n195\t    :dao.lease/subject {:yin.k/occurrence occ}\n196\t    :dao.lease/holder h\n197\t    :dao.lease/duration {:s 30}}))\n198\t\n199\t\n200\t(defn- bound\n201\t  ([] (bound \"lease-1\" \"holder-a\" 0))\n202\t  ([l h e] (custody/bound occ l h e)))\n203\t\n204\t\n205\t(deftest the-fold-records-offers-grants-and-bindings\n206\t  (let [p (fold [(offered)]\n207\t                [(offered addr-2)]\n208\t                [(grant) (bound)])]\n209\t    (is (= {occ {:yin.k/baseline baseline\n210\t                 :yin.k/variants #{addr-1 addr-2}\n211\t                 :yin.k/epoch 0\n212\t                 :dao.lease/lease \"lease-1\"}}\n213\t           (:occurrences p))\n214\t        \"an equal-baseline variant joins its occurrence\")\n215\t    (is (= {\"lease-1\" {:yin.k/occurrence occ\n216\t                       :dao.lease/holder \"holder-a\"\n217\t                       :yin.k/epoch 0\n218\t                       :dao.space/t 2\n219\t                       :dao.lease/duration {:s 30}\n220\t                       :dao.lease/proposal \"p-1\"}}\n221\t           (:leases p))\n222\t        \"a lease keeps its grant's terms\")\n223\t    (is (= {[\"holder-a\" \"p-1\"] :dao.lease/accepted} (:answered p))\n224\t        \"the grant answers its holder's proposal\")\n225\t    (is (= #{:arbitration :max-epoch :next-t :next-e :targets :admitted\n226\t             :occurrences :leases :answered}\n227\t           (set (keys p)))\n228\t        \"no transient fold state stays in a projection\")))\n229\t\n230\t\n231\t(defn- raw\n232\t  \"The defect of folding one record of `[e a v]` datoms after `txs`.\"\n233\t  [txs datoms]\n234\t  (let [p (apply fold txs)]\n235\t    (::ledger/defect\n236\t      (ledger/fold-record p (record (:next-t p) (stamp (:next-t p) datoms))))))\n237\t\n238\t\n239\t(deftest the-fold-refuses-malformed-custody-facts\n240\t  (let [defect (fn [& txs] (::ledger/defect (apply fold txs)))\n241\t        other \"1d3e5b7a-0c2f-4a69-8b11-7e6d5c4b3a02\"]\n242\t    (testing \"offers\"\n243\t      (is (= :malformed-fact\n244\t             (defect [(assoc (offered) :yin.k/occurrence \"O\")])))\n245\t      (is (= :malformed-fact (defect [(assoc (offered) :yin.k/id \"addr\")])))\n246\t      (is (= :malformed-fact\n247\t             (defect [(assoc (offered) :yin.k/policy :yin.k/fork)])))\n248\t      (is (= :malformed-fact (defect [(dissoc (offered) :yin.k/medium)])))\n249\t      (is (= :malformed-fact\n250\t             (defect [(offered addr-1\n251\t                               (assoc baseline :yin.k/occurrence other))]))\n252\t          \"a baseline of another occurrence\")\n253\t      (is (= :malformed-fact\n254\t             (defect [(offered addr-1\n255\t                               (assoc baseline :yin.k/kind :halted))])))\n256\t      (is (= :foreign-arbitration\n257\t             (defect [(offered addr-1\n258\t                               (assoc-in baseline\n259\t                                         [:yin.k/arbitration\n260\t                                          :dao.stream/identity]\n261\t                                         \"other\"))])))\n262\t      (is (= :duplicate-offer (defect [(offered)] [(offered)])))\n263\t      (is (= :variant-conflict\n264\t             (defect [(offered)]\n265\t               [(offered addr-2\n266\t                         (assoc baseline :yin.k/next-op-seq 1))]))))\n267\t    (testing \"grants\"\n268\t      (is (= :unknown-occurrence (defect [(grant) (bound)])))\n269\t      (is (= :malformed-fact\n270\t             (defect [(offered)]\n271\t               [(dissoc (grant) :dao.lease/duration) (bound)])))\n272\t      (is (= :malformed-fact\n273\t             (defect [(offered)]\n274\t               [(assoc (grant) :dao.lease/subject\n275\t                       {:yin.k/occurrence occ :x 1})\n276\t                (bound)])))\n277\t      (is (= :unbound-grant (defect [(offered)] [(grant)]))\n278\t          \"a grant without its binding in one record\")\n279\t      (is (= :unbound-grant (defect [(offered)] [(grant)] [(bound)])))\n280\t      (is (= :held-occurrence\n281\t             (defect [(offered)] [(grant) (bound)]\n282\t               [(grant \"lease-2\" \"holder-b\")\n283\t                (bound \"lease-2\" \"holder-b\" 0)])))\n284\t      (is (= :duplicate-lease\n285\t             (defect [(offered)] [(grant) (bound)] [(grant) (bound)]))))\n286\t    (testing \"bindings\"\n287\t      (is (= :unknown-lease (defect [(offered)] [(bound)])))\n288\t      (is (= :malformed-fact\n289\t             (defect [(offered)]\n290\t               [(grant) (bound \"lease-1\" \"holder-a\" (cbor/float64 0))]))\n291\t          \"a float epoch\")\n292\t      (is (= :epoch-mismatch\n293\t             (defect [(offered)] [(grant) (bound \"lease-1\" \"holder-a\" 1)]))\n294\t          \"the first grant binds 0\")\n295\t      (is (= :binding-mismatch\n296\t             (defect [(offered)] [(grant) (bound \"lease-1\" \"holder-b\" 0)])))\n297\t      (is (= :duplicate-binding\n298\t             (defect [(offered)] [(grant) (bound) (bound)]))))\n299\t    (testing \"a fact carrying both dispatch keys\"\n300\t      (is (= :malformed-fact\n301\t             (raw [[(offered)]]\n302\t                  [[20 :yin.k/custody :yin.k/bound]\n303\t                   [20 :dao.lease/status :dao.lease/accepted]]))))))\n304\t\n305\t\n306\t;; =============================================================================\n307\t;; Lapses, epochs and refusals (slice C6)\n308\t;; =============================================================================\n309\t\n310\t(defn- lapse\n311\t  ([] (lapse \"lease-1\"))\n312\t  ([l] {:dao.lease/status :dao.lease/lapsed\n313\t        :dao.lease/lease l\n314\t        :dao.lease/cause :policy}))\n315\t\n316\t\n317\t(defn- reclaimed\n318\t  ([e] (reclaimed \"lease-1\" e))\n319\t  ([l e] (custody/reclaimed occ l e)))\n320\t\n321\t\n322\t(defn- rejected\n323\t  [pid]\n324\t  {:dao.lease/status :dao.lease/rejected :dao.lease/proposal pid})\n325\t\n326\t\n327\t(defn- refusal\n328\t  \"The refusal of `proposer`'s proposal pid: the plain lease fact and\n329\t   the authority's custody fact naming the proposer, one transaction.\"\n330\t  [proposer pid]\n331\t  [(rejected pid) (custody/refused proposer pid)])\n332\t\n333\t\n334\t(defn- granted\n335\t  \"A grant of lease l to holder h answering proposal pid, with its\n336\t   binding at epoch e.\"\n337\t  [l h pid e]\n338\t  [(assoc (grant l h) :dao.lease/proposal pid) (bound l h e)])\n339\t\n340\t\n341\t(deftest a-lapse-and-its-epoch-commit-together\n342\t  (let [p (fold [(offered)] [(grant) (bound)] [(lapse) (reclaimed 1)])]\n343\t    (is (nil? (::ledger/defect p)))\n344\t    (is (= 1 (get-in p [:occurrences occ :yin.k/epoch]))\n345\t        \"the reclaim raises the epoch by one\")\n346\t    (is (nil? (get-in p [:occurrences occ :dao.lease/lease]))\n347\t        \"and leaves the occurrence with no live lease\")\n348\t    (is (= :policy (get-in p [:leases \"lease-1\" :dao.lease/cause]))))\n349\t  (let [p (fold [(offered)] [(grant) (bound)] [(lapse) (reclaimed 1)]\n350\t                (granted \"lease-2\" \"holder-b\" \"p-2\" 1)\n351\t                [(lapse \"lease-2\") (reclaimed \"lease-2\" 2)]\n352\t                (granted \"lease-3\" \"holder-a\" \"p-3\" 2))]\n353\t    (is (nil? (::ledger/defect p)))\n354\t    (is (= [0 1 2] (mapv #(get-in p [:leases % :yin.k/epoch])\n355\t                         [\"lease-1\" \"lease-2\" \"lease-3\"]))\n356\t        \"the grant after k reclaims binds k\")))\n357\t\n358\t\n359\t(deftest no-reader-sees-a-lapse-without-its-epoch\n360\t  (let [defect (fn [& txs] (::ledger/defect (apply fold txs)))\n361\t        base [[(offered)] [(grant) (bound)]]]\n362\t    (is (= :lapse-without-epoch (apply defect (conj base [(lapse)]))))\n363\t    (is (= :lapse-without-epoch\n364\t           (apply defect (conj base [(lapse)] [(reclaimed 1)])))\n365\t        \"the epoch fact in a later record is too late\")\n366\t    (is (= :unpaired-epoch (apply defect (conj base [(reclaimed 1)])))\n367\t        \"an epoch change without its lapse\")\n368\t    (is (= :unpaired-epoch\n369\t           (apply defect (conj base [(reclaimed 1) (lapse)])))\n370\t        \"the epoch fact follows its lapse\")\n371\t    (is (= :epoch-mismatch\n372\t           (apply defect (conj base [(lapse) (reclaimed 2)])))\n373\t        \"exactly one\")\n374\t    (is (= :epoch-mismatch\n375\t           (apply defect (conj base [(lapse) (reclaimed 0)])))\n376\t        \"never unchanged below the bound\")\n377\t    (is (= :malformed-fact\n378\t           (apply defect (conj base [(lapse) (reclaimed (cbor/float64 1))]))))\n379\t    (is (= :unpaired-epoch\n380\t           (apply defect (conj base [(lapse) (reclaimed 1) (reclaimed 1)]))))\n381\t    (is (= :binding-mismatch\n382\t           (apply defect\n383\t                  (conj base\n384\t                        [(lapse)\n385\t                         (assoc (reclaimed 1) :yin.k/occurrence\n386\t                                \"1d3e5b7a-0c2f-4a69-8b11-7e6d5c4b3a02\")]))))\n387\t    (is (= :unknown-lease (defect [(offered)] [(lapse) (reclaimed 1)])))\n388\t    (is (= :duplicate-lapse\n389\t           (apply defect (conj base [(lapse) (reclaimed 1)]\n390\t                               [(lapse) (reclaimed 2)]))))\n391\t    (is (= :malformed-fact\n392\t           (apply defect (conj base [(dissoc (lapse) :dao.lease/cause)\n393\t                                     (reclaimed 1)]))))))\n394\t\n395\t\n396\t(deftest a-successor-occurrence-starts-at-epoch-zero\n397\t  (let [other \"1d3e5b7a-0c2f-4a69-8b11-7e6d5c4b3a02\"\n398\t        p (fold [(offered)] [(grant) (bound)] [(lapse) (reclaimed 1)]\n399\t                [(custody/offer other addr-2 \"carrier\"\n400\t                                (assoc baseline :yin.k/occurrence other))])]\n401\t    (is (= 1 (get-in p [:occurrences occ :yin.k/epoch])))\n402\t    (is (= 0 (get-in p [:occurrences other :yin.k/epoch])))))\n403\t\n404\t\n405\t(defn- at-epoch\n406\t  \"The projection after offering occ, its epoch set to `e` as if e\n407\t   reclaims had passed.\"\n408\t  [e]\n409\t  (assoc-in (fold [(offered)]) [:occurrences occ :yin.k/epoch] e))\n410\t\n411\t\n412\t(defn- fold-on\n413\t  [p & txs]\n414\t  (reduce (fn [p facts]\n415\t            (if (::ledger/defect p)\n416\t              p\n417\t              (ledger/fold-record\n418\t                p\n419\t                (record (:next-t p)\n420\t                        (stamp (:next-t p)\n421\t                               (ledger/facts->datoms (:next-e p) facts))))))\n422\t          p\n423\t          txs))\n424\t\n425\t\n426\t(deftest the-epoch-exhausts-at-the-bound\n427\t  (let [top ledger/max-exact\n428\t        p (fold-on (at-epoch top) [(grant) (bound \"lease-1\" \"holder-a\" top)])]\n429\t    (is (nil? (::ledger/defect p)) \"a grant at 2^52-1 is valid\")\n430\t    (is (= top (get-in p [:leases \"lease-1\" :yin.k/epoch])))\n431\t    (let [p' (fold-on p [(lapse) (reclaimed top)])]\n432\t      (is (nil? (::ledger/defect p'))\n433\t          \"the reclaim records the lapse and leaves the epoch\")\n434\t      (is (= top (get-in p' [:occurrences occ :yin.k/epoch])))\n435\t      (is (true? (get-in p' [:occurrences occ :yin.k/exhausted])))\n436\t      (is (= :exhausted-occurrence\n437\t             (::ledger/defect\n438\t               (fold-on p' (granted \"lease-2\" \"holder-b\" \"p-2\" top))))\n439\t          \"no further grant\"))\n440\t    (is (= :malformed-fact\n441\t           (::ledger/defect (fold-on p [(lapse) (reclaimed (inc top))])))\n442\t        \"2^52 is refused on the bytes\"))\n443\t  (is (= :malformed-fact\n444\t         (::ledger/defect\n445\t           (fold-on (at-epoch 0) [(grant) (bound \"lease-1\" \"holder-a\"\n446\t                                                 (inc ledger/max-exact))]))))\n447\t  (is (= :malformed-fact\n448\t         (::ledger/defect\n449\t           (fold-on (at-epoch 0) [(grant) (bound \"lease-1\" \"holder-a\" -1)]))))\n450\t  (is (= :malformed-fact\n451\t         (::ledger/defect\n452\t           (fold [(offered)] [(grant) (bound)] [(lapse) (reclaimed -1)])))))\n453\t\n454\t\n455\t(deftest a-lower-epoch-bound-exhausts-earlier\n456\t  (let [p (fold-on (ledger/empty-projection arb 1)\n457\t                   [(offered)] [(grant) (bound)] [(lapse) (reclaimed 1)]\n458\t                   (granted \"lease-2\" \"holder-b\" \"p-2\" 1)\n459\t                   [(lapse \"lease-2\") (reclaimed \"lease-2\" 1)])]\n460\t    (is (nil? (::ledger/defect p)))\n461\t    (is (true? (get-in p [:occurrences occ :yin.k/exhausted])))))\n462\t\n463\t\n464\t(deftest refusals-answer-their-proposer\n465\t  (let [p (fold [(offered)] (refusal \"holder-b\" \"p-1\"))]\n466\t    (is (nil? (::ledger/defect p)))\n467\t    (is (= {[\"holder-b\" \"p-1\"] :dao.lease/rejected} (:answered p))))\n468\t  (let [defect (fn [& txs] (::ledger/defect (apply fold txs)))]\n469\t    (is (= :answered-proposal\n470\t           (defect (refusal \"holder-b\" \"p-1\") (refusal \"holder-b\" \"p-1\"))))\n471\t    (is (= :answered-proposal\n472\t           (defect [(offered)] [(grant) (bound)]\n473\t             (refusal \"holder-a\" \"p-1\")))\n474\t        \"a granted proposal is answered\")\n475\t    (is (= :answered-proposal\n476\t           (defect [(offered)] (refusal \"holder-a\" \"p-1\") [(grant) (bound)]))\n477\t        \"a refused proposal gets no grant\")\n478\t    (is (nil? (defect [(offered)] (refusal \"holder-b\" \"p-1\")\n479\t                [(grant) (bound)]))\n480\t        \"another proposer's id is another answer\")))\n481\t\n482\t\n483\t(deftest a-rejection-and-its-refused-fact-commit-together\n484\t  (let [defect (fn [& txs] (::ledger/defect (apply fold txs)))]\n485\t    (is (= :unpaired-refusal (defect [(custody/refused \"holder-b\" \"p-1\")]))\n486\t        \"a refused fact without its rejection\")\n487\t    (is (= :rejection-without-refusal (defect [(rejected \"p-1\")]))\n488\t        \"a rejection without its refused fact\")\n489\t    (is (= :rejection-without-refusal\n490\t           (defect [(rejected \"p-1\")] [(custody/refused \"holder-b\" \"p-1\")]))\n491\t        \"the refused fact in a later record is too late\")\n492\t    (is (= :unpaired-refusal\n493\t           (defect [(custody/refused \"holder-b\" \"p-1\") (rejected \"p-1\")]))\n494\t        \"the refused fact follows its rejection\")\n495\t    (is (= :unpaired-refusal\n496\t           (defect (conj (refusal \"holder-b\" \"p-1\")\n497\t                         (custody/refused \"holder-c\" \"p-1\"))))\n498\t        \"a doubled refused fact\")\n499\t    (is (= :duplicate-rejection\n500\t           (defect [(rejected \"p-1\") (rejected \"p-1\")\n501\t                    (custody/refused \"holder-b\" \"p-1\")]))\n502\t        \"a doubled rejection\")\n503\t    (is (= :unpaired-refusal\n504\t           (defect [(rejected \"p-1\") (custody/refused \"holder-b\" \"p-2\")]))\n505\t        \"another proposal's refused fact\")\n506\t    (is (= :malformed-fact\n507\t           (defect [(rejected \"p-1\") (custody/refused nil \"p-1\")]))\n508\t        \"a nil proposer\")\n509\t    (is (= :malformed-fact\n510\t           (defect [(rejected \"p-1\") (custody/refused \"holder-b\" nil)])))\n511\t    (is (= :malformed-fact\n512\t           (defect [(dissoc (rejected \"p-1\") :dao.lease/proposal)\n513\t                    (custody/refused \"holder-b\" \"p-1\")])))\n514\t    (is (= :malformed-fact\n515\t           (raw [] [[100 :dao.lease/status :dao.lease/rejected]\n516\t                    [100 :dao.lease/proposal \"p-1\"]\n517\t                    [100 :yin.k/proposer \"holder-b\"]\n518\t                    [101 :yin.k/custody :yin.k/refused]\n519\t                    [101 :yin.k/proposer \"holder-b\"]\n520\t                    [101 :dao.lease/proposal \"p-1\"]]))\n521\t        \"the lease fact carries no proposer\")))\n522\t\n523\t\n524\t(deftest a-grant-with-a-nil-proposal-answers-nothing\n525\t  (let [p (fold [(offered)]\n526\t                [(assoc (grant) :dao.lease/proposal nil) (bound)])]\n527\t    (is (nil? (::ledger/defect p)))\n528\t    (is (= {} (:answered p))\n529\t        \"as dao.lease's judge records no answer for it\")))\n530\t"}]},"parent_tool_use_id":null,"session_id":"23e67cb0-f183-4c2e-b3d6-2e5b6c44b814","uuid":"0e999c98-ac4c-4148-a506-aac54cac6dc6","timestamp":"2026-10-13T08:32:29.375Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7plan/test/yin/vm/ucf/ledger_test.cljc","content":"(ns yin.vm.ucf.ledger-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing.cbor :as cbor]\n            [yin.vm.ucf.custody :as custody]\n            [yin.vm.ucf.ledger :as ledger]))\n\n\n(def ^:private arb \"arb\")\n\n(def ^:private target (ledger/target-identity arb 0))\n\n\n(defn- record\n  [t datoms]\n  {:dao.space/transaction {:t t :datoms datoms}})\n\n\n(defn- stamp\n  \"Pad `[e a v]` datoms with t and the assertion op, as the transactor\n   does.\"\n  [t datoms]\n  (mapv #(conj % t 1) datoms))\n\n\n(def ^:private enrolled\n  {:yin.k/custody :yin.k/enrolled\n   :yin.k/target target\n   :yin.k/effect-kinds #{:yin.k/append}})\n\n\n(defn- admitted\n  [op value]\n  {:yin.k/custody :yin.k/admitted\n   :yin.k/target target\n   :yin.k/op-id {:yin.k/occurrence \"O\" :yin.k/seq op}\n   :yin.k/intent (ledger/intent target value)\n   :yin.k/value value\n   :yin.k/result ledger/ok-result})\n\n\n(defn- fold\n  \"Fold each transaction's facts in turn, from the empty projection.\"\n  [& txs]\n  (reduce (fn [p facts]\n            (if (::ledger/defect p)\n              p\n              (ledger/fold-record\n                p\n                (record (:next-t p)\n                        (stamp (:next-t p)\n                               (ledger/facts->datoms (:next-e p) facts))))))\n          (ledger/empty-projection arb)\n          txs))\n\n\n(deftest datoms-follow-the-published-attribute-order\n  (is (= [[16 :yin.k/custody :yin.k/enrolled]\n          [16 :yin.k/target target]\n          [16 :yin.k/effect-kinds #{:yin.k/append}]\n          [17 :yin.k/custody :yin.k/target-closed]\n          [17 :yin.k/target target]]\n         (ledger/facts->datoms 16 [(into {} (reverse (seq enrolled)))\n                                   {:yin.k/target target\n                                    :yin.k/custody :yin.k/target-closed}])))\n  (is (= [:yin.k/custody :yin.k/target :yin.k/op-id :yin.k/intent\n          :yin.k/result]\n         (mapv second\n               (ledger/fact-datoms 20 (dissoc (admitted 0 :v) :yin.k/value))))\n      \"an absent attribute is skipped, the rest keep their order\")\n  (is (= 4503599627370495 ledger/max-exact)))\n\n\n(deftest authoring-refuses-a-fact-outside-the-published-order\n  (let [defect (fn [facts]\n                 (try (ledger/facts->datoms 16 facts)\n                      nil\n                      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n                        (::ledger/defect (ex-data e)))))]\n    (is (= :unknown-kind (defect [{:yin.k/custody :yin.k/other}])))\n    (is (= :unknown-kind (defect [{:yin.k/target target}]))\n        \"a fact with no dispatch key\")\n    (is (= :unpublished-attribute\n           (defect [(assoc enrolled :yin.k/extra 1)]))\n        \"an attribute outside the kind's order is never silently dropped\")\n    (is (= :unknown-kind\n           (defect [(assoc enrolled :dao.lease/status :dao.lease/accepted)]))\n        \"both dispatch keys\")))\n\n\n(deftest the-fold-builds-the-projection\n  (let [p (fold [enrolled] [(admitted 0 :a) (admitted 1 :a)]\n                [{:yin.k/custody :yin.k/target-closed :yin.k/target target}])]\n    (is (= 3 (:next-t p)))\n    (is (= 20 (:next-e p)))\n    (is (= {target {:closed? true :values [:a :a]}} (:targets p)))\n    (is (= ledger/ok-result\n           (get-in p [:admitted (cbor/content-key {:yin.k/occurrence \"O\"\n                                                   :yin.k/seq 1})\n                      :yin.k/result])))))\n\n\n(deftest the-fold-refuses-what-the-ledger-cannot-hold\n  (testing \"transaction time must equal the position\"\n    (is (= :t-mismatch\n           (::ledger/defect\n             (ledger/fold-record (ledger/empty-projection arb)\n                                 (record 1 (stamp 1 (ledger/facts->datoms\n                                                      16 [enrolled]))))))))\n  (testing \"a datom stamped with another t\"\n    (is (= :malformed-datom\n           (::ledger/defect\n             (ledger/fold-record (ledger/empty-projection arb)\n                                 (record 0 (stamp 1 (ledger/facts->datoms\n                                                      16 [enrolled]))))))))\n  (testing \"a reused entity id\"\n    (let [p (fold [enrolled])]\n      (is (= :malformed-datom\n             (::ledger/defect\n               (ledger/fold-record\n                 p (record 1 (stamp 1 (ledger/facts->datoms\n                                        16 [(admitted 0 :a)])))))))))\n  (testing \"a target this ledger did not mint at that t\"\n    (is (= :foreign-target\n           (::ledger/defect (fold [(assoc enrolled :yin.k/target \"x\")])))))\n  (testing \"attributes out of the published order\"\n    (is (= :malformed-fact\n           (::ledger/defect\n             (ledger/fold-record\n               (ledger/empty-projection arb)\n               (record 0 (stamp 0 (vec (reverse (ledger/facts->datoms\n                                                  16 [enrolled]))))))))))\n  (testing \"a duplicate op id\"\n    (is (= :duplicate-op-id\n           (::ledger/defect (fold [enrolled] [(admitted 0 :a)]\n                                  [(admitted 0 :a)])))))\n  (testing \"an admission to an unknown target\"\n    (is (= :unknown-target (::ledger/defect (fold [(admitted 0 :a)])))))\n  (testing \"a fact kind this ledger does not know\"\n    (is (= :malformed-fact\n           (::ledger/defect\n             (ledger/fold-record\n               (ledger/empty-projection arb)\n               (record 0 (stamp 0 [[16 :yin.k/custody :yin.k/other]])))))))\n  (testing \"a retraction: the ledger is add-only\"\n    (is (= :malformed-datom\n           (::ledger/defect\n             (ledger/fold-record\n               (ledger/empty-projection arb)\n               (record 0\n                       (mapv #(conj % 0 0)\n                             (ledger/facts->datoms 16 [enrolled]))))))))\n  (testing \"a non-record value\"\n    (is (= :malformed-record\n           (::ledger/defect\n             (ledger/fold-record (ledger/empty-projection arb) :x))))))\n\n\n;; =============================================================================\n;; Custody facts (slice C5)\n;; =============================================================================\n\n(def ^:private occ \"8f0c6a52-6a1e-4e43-9d55-3f0a4c1b2e01\")\n\n\n(defn- address\n  [digit]\n  (keyword \"segment\" (str \"blake3-\" (apply str (repeat 64 digit)))))\n\n\n(def ^:private addr-1 (address \"1\"))\n\n(def ^:private addr-2 (address \"2\"))\n\n\n(def ^:private baseline\n  {:yin.k/kind :blocked\n   :yin.k/occurrence occ\n   :yin.k/arbitration {:dao.stream/identity arb :dao.stream/descriptor {}}\n   :yin.k/next-op-seq 0\n   :yin.k/ops {}})\n\n\n(defn- offered\n  ([] (offered addr-1))\n  ([address] (offered address baseline))\n  ([address b] (custody/offer occ address \"carrier\" b)))\n\n\n(defn- grant\n  ([] (grant \"lease-1\" \"holder-a\"))\n  ([l h]\n   {:dao.lease/status :dao.lease/accepted\n    :dao.lease/lease l\n    :dao.lease/proposal \"p-1\"\n    :dao.lease/subject {:yin.k/occurrence occ}\n    :dao.lease/holder h\n    :dao.lease/duration {:s 30}}))\n\n\n(defn- bound\n  ([] (bound \"lease-1\" \"holder-a\" 0))\n  ([l h e] (custody/bound occ l h e)))\n\n\n(deftest the-fold-records-offers-grants-and-bindings\n  (let [p (fold [(offered)]\n                [(offered addr-2)]\n                [(grant) (bound)])]\n    (is (= {occ {:yin.k/baseline baseline\n                 :yin.k/variants #{addr-1 addr-2}\n                 :yin.k/epoch 0\n                 :dao.lease/lease \"lease-1\"}}\n           (:occurrences p))\n        \"an equal-baseline variant joins its occurrence\")\n    (is (= {\"lease-1\" {:yin.k/occurrence occ\n                       :dao.lease/holder \"holder-a\"\n                       :yin.k/epoch 0\n                       :dao.space/t 2\n                       :dao.lease/duration {:s 30}\n                       :dao.lease/proposal \"p-1\"}}\n           (:leases p))\n        \"a lease keeps its grant's terms\")\n    (is (= {[\"holder-a\" \"p-1\"] :dao.lease/accepted} (:answered p))\n        \"the grant answers its holder's proposal\")\n    (is (= #{:arbitration :max-epoch :next-t :next-e :targets :admitted\n             :occurrences :leases :answered}\n           (set (keys p)))\n        \"no transient fold state stays in a projection\")))\n\n\n(defn- raw\n  \"The defect of folding one record of `[e a v]` datoms after `txs`.\"\n  [txs datoms]\n  (let [p (apply fold txs)]\n    (::ledger/defect\n      (ledger/fold-record p (record (:next-t p) (stamp (:next-t p) datoms))))))\n\n\n(deftest the-fold-refuses-malformed-custody-facts\n  (let [defect (fn [& txs] (::ledger/defect (apply fold txs)))\n        other \"1d3e5b7a-0c2f-4a69-8b11-7e6d5c4b3a02\"]\n    (testing \"offers\"\n      (is (= :malformed-fact\n             (defect [(assoc (offered) :yin.k/occurrence \"O\")])))\n      (is (= :malformed-fact (defect [(assoc (offered) :yin.k/id \"addr\")])))\n      (is (= :malformed-fact\n             (defect [(assoc (offered) :yin.k/policy :yin.k/fork)])))\n      (is (= :malformed-fact (defect [(dissoc (offered) :yin.k/medium)])))\n      (is (= :malformed-fact\n             (defect [(offered addr-1\n                               (assoc baseline :yin.k/occurrence other))]))\n          \"a baseline of another occurrence\")\n      (is (= :malformed-fact\n             (defect [(offered addr-1\n                               (assoc baseline :yin.k/kind :halted))])))\n      (is (= :foreign-arbitration\n             (defect [(offered addr-1\n                               (assoc-in baseline\n                                         [:yin.k/arbitration\n                                          :dao.stream/identity]\n                                         \"other\"))])))\n      (is (= :duplicate-offer (defect [(offered)] [(offered)])))\n      (is (= :variant-conflict\n             (defect [(offered)]\n               [(offered addr-2\n                         (assoc baseline :yin.k/next-op-seq 1))]))))\n    (testing \"grants\"\n      (is (= :unknown-occurrence (defect [(grant) (bound)])))\n      (is (= :malformed-fact\n             (defect [(offered)]\n               [(dissoc (grant) :dao.lease/duration) (bound)])))\n      (is (= :malformed-fact\n             (defect [(offered)]\n               [(assoc (grant) :dao.lease/subject\n                       {:yin.k/occurrence occ :x 1})\n                (bound)])))\n      (is (= :unbound-grant (defect [(offered)] [(grant)]))\n          \"a grant without its binding in one record\")\n      (is (= :unbound-grant (defect [(offered)] [(grant)] [(bound)])))\n      (is (= :held-occurrence\n             (defect [(offered)] [(grant) (bound)]\n               [(grant \"lease-2\" \"holder-b\")\n                (bound \"lease-2\" \"holder-b\" 0)])))\n      (is (= :duplicate-lease\n             (defect [(offered)] [(grant) (bound)] [(grant) (bound)]))))\n    (testing \"bindings\"\n      (is (= :unknown-lease (defect [(offered)] [(bound)])))\n      (is (= :malformed-fact\n             (defect [(offered)]\n               [(grant) (bound \"lease-1\" \"holder-a\" (cbor/float64 0))]))\n          \"a float epoch\")\n      (is (= :epoch-mismatch\n             (defect [(offered)] [(grant) (bound \"lease-1\" \"holder-a\" 1)]))\n          \"the first grant binds 0\")\n      (is (= :binding-mismatch\n             (defect [(offered)] [(grant) (bound \"lease-1\" \"holder-b\" 0)])))\n      (is (= :duplicate-binding\n             (defect [(offered)] [(grant) (bound) (bound)]))))\n    (testing \"a fact carrying both dispatch keys\"\n      (is (= :malformed-fact\n             (raw [[(offered)]]\n                  [[20 :yin.k/custody :yin.k/bound]\n                   [20 :dao.lease/status :dao.lease/accepted]]))))))\n\n\n;; =============================================================================\n;; Lapses, epochs and refusals (slice C6)\n;; =============================================================================\n\n(defn- lapse\n  ([] (lapse \"lease-1\"))\n  ([l] {:dao.lease/status :dao.lease/lapsed\n        :dao.lease/lease l\n        :dao.lease/cause :policy}))\n\n\n(defn- reclaimed\n  ([e] (reclaimed \"lease-1\" e))\n  ([l e] (custody/reclaimed occ l e)))\n\n\n(defn- rejected\n  [pid]\n  {:dao.lease/status :dao.lease/rejected :dao.lease/proposal pid})\n\n\n(defn- refusal\n  \"The refusal of `proposer`'s proposal pid: the plain lease fact and\n   the authority's custody fact naming the proposer, one transaction.\"\n  [proposer pid]\n  [(rejected pid) (custody/refused proposer pid)])\n\n\n(defn- granted\n  \"A grant of lease l to holder h answering proposal pid, with its\n   binding at epoch e.\"\n  [l h pid e]\n  [(assoc (grant l h) :dao.lease/proposal pid) (bound l h e)])\n\n\n(deftest a-lapse-and-its-epoch-commit-together\n  (let [p (fold [(offered)] [(grant) (bound)] [(lapse) (reclaimed 1)])]\n    (is (nil? (::ledger/defect p)))\n    (is (= 1 (get-in p [:occurrences occ :yin.k/epoch]))\n        \"the reclaim raises the epoch by one\")\n    (is (nil? (get-in p [:occurrences occ :dao.lease/lease]))\n        \"and leaves the occurrence with no live lease\")\n    (is (= :policy (get-in p [:leases \"lease-1\" :dao.lease/cause]))))\n  (let [p (fold [(offered)] [(grant) (bound)] [(lapse) (reclaimed 1)]\n                (granted \"lease-2\" \"holder-b\" \"p-2\" 1)\n                [(lapse \"lease-2\") (reclaimed \"lease-2\" 2)]\n                (granted \"lease-3\" \"holder-a\" \"p-3\" 2))]\n    (is (nil? (::ledger/defect p)))\n    (is (= [0 1 2] (mapv #(get-in p [:leases % :yin.k/epoch])\n                         [\"lease-1\" \"lease-2\" \"lease-3\"]))\n        \"the grant after k reclaims binds k\")))\n\n\n(deftest no-reader-sees-a-lapse-without-its-epoch\n  (let [defect (fn [& txs] (::ledger/defect (apply fold txs)))\n        base [[(offered)] [(grant) (bound)]]]\n    (is (= :lapse-without-epoch (apply defect (conj base [(lapse)]))))\n    (is (= :lapse-without-epoch\n           (apply defect (conj base [(lapse)] [(reclaimed 1)])))\n        \"the epoch fact in a later record is too late\")\n    (is (= :unpaired-epoch (apply defect (conj base [(reclaimed 1)])))\n        \"an epoch change without its lapse\")\n    (is (= :unpaired-epoch\n           (apply defect (conj base [(reclaimed 1) (lapse)])))\n        \"the epoch fact follows its lapse\")\n    (is (= :epoch-mismatch\n           (apply defect (conj base [(lapse) (reclaimed 2)])))\n        \"exactly one\")\n    (is (= :epoch-mismatch\n           (apply defect (conj base [(lapse) (reclaimed 0)])))\n        \"never unchanged below the bound\")\n    (is (= :malformed-fact\n           (apply defect (conj base [(lapse) (reclaimed (cbor/float64 1))]))))\n    (is (= :unpaired-epoch\n           (apply defect (conj base [(lapse) (reclaimed 1) (reclaimed 1)]))))\n    (is (= :binding-mismatch\n           (apply defect\n                  (conj base\n                        [(lapse)\n                         (assoc (reclaimed 1) :yin.k/occurrence\n                                \"1d3e5b7a-0c2f-4a69-8b11-7e6d5c4b3a02\")]))))\n    (is (= :unknown-lease (defect [(offered)] [(lapse) (reclaimed 1)])))\n    (is (= :duplicate-lapse\n           (apply defect (conj base [(lapse) (reclaimed 1)]\n                               [(lapse) (reclaimed 2)]))))\n    (is (= :malformed-fact\n           (apply defect (conj base [(dissoc (lapse) :dao.lease/cause)\n                                     (reclaimed 1)]))))))\n\n\n(deftest a-successor-occurrence-starts-at-epoch-zero\n  (let [other \"1d3e5b7a-0c2f-4a69-8b11-7e6d5c4b3a02\"\n        p (fold [(offered)] [(grant) (bound)] [(lapse) (reclaimed 1)]\n                [(custody/offer other addr-2 \"carrier\"\n                                (assoc baseline :yin.k/occurrence other))])]\n    (is (= 1 (get-in p [:occurrences occ :yin.k/epoch])))\n    (is (= 0 (get-in p [:occurrences other :yin.k/epoch])))))\n\n\n(defn- at-epoch\n  \"The projection after offering occ, its epoch set to `e` as if e\n   reclaims had passed.\"\n  [e]\n  (assoc-in (fold [(offered)]) [:occurrences occ :yin.k/epoch] e))\n\n\n(defn- fold-on\n  [p & txs]\n  (reduce (fn [p facts]\n            (if (::ledger/defect p)\n              p\n              (ledger/fold-record\n                p\n                (record (:next-t p)\n                        (stamp (:next-t p)\n                               (ledger/facts->datoms (:next-e p) facts))))))\n          p\n          txs))\n\n\n(deftest the-epoch-exhausts-at-the-bound\n  (let [top ledger/max-exact\n        p (fold-on (at-epoch top) [(grant) (bound \"lease-1\" \"holder-a\" top)])]\n    (is (nil? (::ledger/defect p)) \"a grant at 2^52-1 is valid\")\n    (is (= top (get-in p [:leases \"lease-1\" :yin.k/epoch])))\n    (let [p' (fold-on p [(lapse) (reclaimed top)])]\n      (is (nil? (::ledger/defect p'))\n          \"the reclaim records the lapse and leaves the epoch\")\n      (is (= top (get-in p' [:occurrences occ :yin.k/epoch])))\n      (is (true? (get-in p' [:occurrences occ :yin.k/exhausted])))\n      (is (= :exhausted-occurrence\n             (::ledger/defect\n               (fold-on p' (granted \"lease-2\" \"holder-b\" \"p-2\" top))))\n          \"no further grant\"))\n    (is (= :malformed-fact\n           (::ledger/defect (fold-on p [(lapse) (reclaimed (inc top))])))\n        \"2^52 is refused on the bytes\"))\n  (is (= :malformed-fact\n         (::ledger/defect\n           (fold-on (at-epoch 0) [(grant) (bound \"lease-1\" \"holder-a\"\n                                                 (inc ledger/max-exact))]))))\n  (is (= :malformed-fact\n         (::ledger/defect\n           (fold-on (at-epoch 0) [(grant) (bound \"lease-1\" \"holder-a\" -1)]))))\n  (is (= :malformed-fact\n         (::ledger/defect\n           (fold [(offered)] [(grant) (bound)] [(lapse) (reclaimed -1)])))))\n\n\n(deftest a-lower-epoch-bound-exhausts-earlier\n  (let [p (fold-on (ledger/empty-projection arb 1)\n                   [(offered)] [(grant) (bound)] [(lapse) (reclaimed 1)]\n                   (granted \"lease-2\" \"holder-b\" \"p-2\" 1)\n                   [(lapse \"lease-2\") (reclaimed \"lease-2\" 1)])]\n    (is (nil? (::ledger/defect p)))\n    (is (true? (get-in p [:occurrences occ :yin.k/exhausted])))))\n\n\n(deftest refusals-answer-their-proposer\n  (let [p (fold [(offered)] (refusal \"holder-b\" \"p-1\"))]\n    (is (nil? (::ledger/defect p)))\n    (is (= {[\"holder-b\" \"p-1\"] :dao.lease/rejected} (:answered p))))\n  (let [defect (fn [& txs] (::ledger/defect (apply fold txs)))]\n    (is (= :answered-proposal\n           (defect (refusal \"holder-b\" \"p-1\") (refusal \"holder-b\" \"p-1\"))))\n    (is (= :answered-proposal\n           (defect [(offered)] [(grant) (bound)]\n             (refusal \"holder-a\" \"p-1\")))\n        \"a granted proposal is answered\")\n    (is (= :answered-proposal\n           (defect [(offered)] (refusal \"holder-a\" \"p-1\") [(grant) (bound)]))\n        \"a refused proposal gets no grant\")\n    (is (nil? (defect [(offered)] (refusal \"holder-b\" \"p-1\")\n                [(grant) (bound)]))\n        \"another proposer's id is another answer\")))\n\n\n(deftest a-rejection-and-its-refused-fact-commit-together\n  (let [defect (fn [& txs] (::ledger/defect (apply fold txs)))]\n    (is (= :unpaired-refusal (defect [(custody/refused \"holder-b\" \"p-1\")]))\n        \"a refused fact without its rejection\")\n    (is (= :rejection-without-refusal (defect [(rejected \"p-1\")]))\n        \"a rejection without its refused fact\")\n    (is (= :rejection-without-refusal\n           (defect [(rejected \"p-1\")] [(custody/refused \"holder-b\" \"p-1\")]))\n        \"the refused fact in a later record is too late\")\n    (is (= :unpaired-refusal\n           (defect [(custody/refused \"holder-b\" \"p-1\") (rejected \"p-1\")]))\n        \"the refused fact follows its rejection\")\n    (is (= :unpaired-refusal\n           (defect (conj (refusal \"holder-b\" \"p-1\")\n                         (custody/refused \"holder-c\" \"p-1\"))))\n        \"a doubled refused fact\")\n    (is (= :duplicate-rejection\n           (defect [(rejected \"p-1\") (rejected \"p-1\")\n                    (custody/refused \"holder-b\" \"p-1\")]))\n        \"a doubled rejection\")\n    (is (= :unpaired-refusal\n           (defect [(rejected \"p-1\") (custody/refused \"holder-b\" \"p-2\")]))\n        \"another proposal's refused fact\")\n    (is (= :malformed-fact\n           (defect [(rejected \"p-1\") (custody/refused nil \"p-1\")]))\n        \"a nil proposer\")\n    (is (= :malformed-fact\n           (defect [(rejected \"p-1\") (custody/refused \"holder-b\" nil)])))\n    (is (= :malformed-fact\n           (defect [(dissoc (rejected \"p-1\") :dao.lease/proposal)\n                    (custody/refused \"holder-b\" \"p-1\")])))\n    (is (= :malformed-fact\n           (raw [] [[100 :dao.lease/status :dao.lease/rejected]\n                    [100 :dao.lease/proposal \"p-1\"]\n                    [100 :yin.k/proposer \"holder-b\"]\n                    [101 :yin.k/custody :yin.k/refused]\n                    [101 :yin.k/proposer \"holder-b\"]\n                    [101 :dao.lease/proposal \"p-1\"]]))\n        \"the lease fact carries no proposer\")))\n\n\n(deftest a-grant-with-a-nil-proposal-answers-nothing\n  (let [p (fold [(offered)]\n                [(assoc (grant) :dao.lease/proposal nil) (bound)])]\n    (is (nil? (::ledger/defect p)))\n    (is (= {} (:answered p))\n        \"as dao.lease's judge records no answer for it\")))\n","numLines":530,"startLine":1,"totalLines":530}},"tool_result_meta":[{"id":"toolu_0138oguazLXf6HS8bSDNR2QB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011Cfyvex8RcYzmuP27G4f7i","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DMBWcSj8rcL75qEN9ZLMKT","name":"Read","input":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7plan/test/yin/vm/ucf/handoff_v2_holder_test.cljc"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":62003,"cache_read_input_tokens":175413,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":62003},"output_tokens":7,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"23e67cb0-f183-4c2e-b3d6-2e5b6c44b814","uuid":"6f155742-c18b-4cd9-8bb0-831ccd323f13","timestamp":"2026-10-13T08:32:30.148Z","request_id":"req_011Cfyvew1iHvQV7skLEZvqX","wire_tool_inputs":{"toolu_01DMBWcSj8rcL75qEN9ZLMKT":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7plan/test/yin/vm/ucf/handoff_v2_holder_test.cljc"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DMBWcSj8rcL75qEN9ZLMKT","type":"tool_result","content":"1\t(ns yin.vm.ucf.handoff-v2-holder-test\n2\t  \"UCF version 2, section 11 rows 9, 10, 11 and 12 over the holder's\n3\t   exporting state: the D4-D9 holds in root and child refuse the lift and\n4\t   leave the machine as it was; canonical bytes do not depend on map\n5\t   insertion order; a version-2 recovery snapshot freezes, rehydrates in\n6\t   a fresh receiver with its gates exporting and its bytes reproduced,\n7\t   and refuses a restarted abort; and a receiver poisoned with guest\n8\t   state behaves exactly as a clean one.\"\n9\t  (:require [clojure.test :refer [deftest is testing]]\n10\t            [clojure.walk :as walk]\n11\t            [dao.jing.cbor :as cbor]\n12\t            [dao.jing.cbor-fixtures :as fx]\n13\t            [dao.stream :as stream]\n14\t            [yin.vm :as vm]\n15\t            [yin.vm.debruijn.register :as register]\n16\t            [yin.vm.debruijn.stack :as stack]\n17\t            [yin.vm.ucf.handoff :as handoff]\n18\t            [yin.vm.ucf.holder.export :as export]\n19\t            [yin.vm.ucf.v2-support :as s]))\n20\t\n21\t\n22\t(defn- served-table\n23\t  \"A `serve!` answering one stable identity per handle.\"\n24\t  []\n25\t  (let [table (atom {})]\n26\t    {:table table\n27\t     :serve! (fn [h]\n28\t               (or (get @table h)\n29\t                   (let [served {:dao.stream/identity\n30\t                                 (str \"s\" (count @table))\n31\t                                 :dao.stream/channel\n32\t                                 {:dao.stream/type :test/channel}}]\n33\t                     (swap! table assoc h served)\n34\t                     served)))}))\n35\t\n36\t\n37\t(defn- hold-at\n38\t  \"`machine` with `f` applied at the root, or at the install child\n39\t   `path` names.\"\n40\t  [machine path f]\n41\t  (if (empty? path)\n42\t    (f machine)\n43\t    (update-in machine [:installs (first path) :vm] hold-at (rest path) f)))\n44\t\n45\t\n46\t(def ^:private holds\n47\t  \"Each hold: [kind f], `f` turning a machine into one that holds it.\"\n48\t  [[:held #(assoc-in % [:wait-set 0 :yin.k/held] {:state :observed})]\n49\t   [:observe #(assoc-in % [:wait-set 0 :reason] :observe)]\n50\t   [:unminted-cursor\n51\t    #(assoc-in % [:resources :yin/unminted]\n52\t               {:stream-id :yin/none :cursor nil :yin.k/unminted true})]\n53\t   [:pending-close #(assoc % :yin.k/closes [{:close :pending}])]\n54\t   ;; a :link-request wait whose response cursor was never installed\n55\t   [:link-cursor-not-installed\n56\t    #(update-in % [:wait-set 0]\n57\t                (fn [entry]\n58\t                  (dissoc (assoc entry :reason :link-request)\n59\t                          :cursor)))]])\n60\t\n61\t\n62\t(deftest every-hold-refuses-the-lift-in-root-and-child\n63\t  (doseq [engine s/engines\n64\t          [kind f] holds]\n65\t    (testing (str (name engine) \" \" kind)\n66\t      (let [reader (first (s/parked-reader engine))\n67\t            [installer _] (s/parked-installer engine)\n68\t            held-root (hold-at reader [] f)\n69\t            held-child (hold-at installer ['host.mod] f)]\n70\t        (doseq [[label machine path] [[\"root\" held-root []]\n71\t                                      [\"child\" held-child ['host.mod]]]]\n72\t          (let [entered (export/enter machine {:version 2})\n73\t                lifted (handoff/export-task machine (:serve! (served-table))\n74\t                                            {:version 2})]\n75\t            (is (= :yin.k/non-portable (:yin.k/status entered))\n76\t                (str label \": \" (pr-str (dissoc entered :machine))))\n77\t            (is (= kind (:yin.k/hold entered)))\n78\t            (is (= path (:yin.k/path entered)))\n79\t            (is (not (contains? entered :machine))\n80\t                \"nothing was fenced: the machine stays as it was\")\n81\t            (is (= :yin.k/non-portable (:yin.k/status lifted)))\n82\t            (is (= kind (:yin.k/hold lifted)))))))))\n83\t\n84\t\n85\t(deftest identical-data-lifts-to-identical-canonical-bytes\n86\t  (doseq [engine s/engines]\n87\t    (testing (name engine)\n88\t      (let [[m _] (s/parked-reader engine)\n89\t            make (fn [store] (assoc m :store store))\n90\t            ;; zipmap keeps small-map insertion order on the hosts that\n91\t            ;; have it (so a and b iterate differently there) and\n92\t            ;; compiles on every host -- array-map does not exist on\n93\t            ;; ClojureDart\n94\t            a (make (zipmap '[a b c d] [1 2 3 4]))\n95\t            b (make (zipmap '[d c b a] [4 3 2 1]))\n96\t            lift #(handoff/export-task % (:serve! (served-table))\n97\t                                       {:version 2})\n98\t            ea (lift a)\n99\t            eb (lift b)]\n100\t        (is (= :ok (:status ea)) (pr-str ea))\n101\t        (is (= (vec (:bytes ea)) (vec (:bytes eb)))\n102\t            \"map insertion order never reaches the bytes\")\n103\t        (is (= (:address ea) (:address eb)))\n104\t        (is (= (set (keys (:yin.k/code (:body ea))))\n105\t               (set (keys (:yin.k/code (:body eb))))))\n106\t        (is (= (:yin.k/cells (:body ea)) (:yin.k/cells (:body eb))))))))\n107\t\n108\t\n109\t(defn- observed\n110\t  \"Everything a program could see of stream `h`: the outcome and value\n111\t   at its first positions.  Equal before and after means no program IO\n112\t   appended to it.\"\n113\t  [h]\n114\t  (mapv #(select-keys (stream/next h %) [:dao.stream/outcome\n115\t                                         :dao.stream/value])\n116\t        (range 3)))\n117\t\n118\t\n119\t(defn- cells-of\n120\t  \"Each wait of `waits`, resolved through `machine`'s own resources: its\n121\t   reason, the stream handle it polls and the cell's position, plus the\n122\t   entry's keys but for the recovery's issue mark.\"\n123\t  [machine waits]\n124\t  (mapv (fn [e]\n125\t          [(:reason e)\n126\t           (get-in machine [:resources (:stream-id e)])\n127\t           (get-in machine [:resources (get-in e [:cursor-ref :id]) :cursor])\n128\t           (disj (set (keys e)) :yin.k/issue)])\n129\t        waits))\n130\t\n131\t\n132\t(defn- resolved\n133\t  \"`x` with every stream and cursor reference replaced by what it names\n134\t   in `machine`'s own resources -- the stream handle, the handle and the\n135\t   cell's position -- so records held under receiver-owned ids and seals\n136\t   compare by content.\"\n137\t  [machine x]\n138\t  (walk/postwalk\n139\t    (fn [n]\n140\t      (if (and (map? n) (contains? #{:stream-ref :cursor-ref} (:type n)))\n141\t        (let [r (get-in machine [:resources (:id n)])]\n142\t          (if (= :stream-ref (:type n))\n143\t            [:stream r]\n144\t            [:cursor (get-in machine [:resources (:stream-id r)]) (:cursor r)]))\n145\t        n))\n146\t    x))\n147\t\n148\t\n149\t(defn- sources\n150\t  \"The machines the recovery row freezes, by label: a reader parked on a\n151\t   wait (cells), and an explicit park whose record holds a cursor (a\n152\t   parked record).  Each answers [machine stream].\"\n153\t  [engine]\n154\t  [[\"reader\" (s/parked-reader engine)]\n155\t   [\"explicit park\" (let [m (s/parked-explicit engine)]\n156\t                      [m (get-in m [:resources (some (fn [[_ r]]\n157\t                                                       (:stream-id r))\n158\t                                                     (:resources m))])])]])\n159\t\n160\t\n161\t;; A genuinely fresh process is not portable across the three test\n162\t;; hosts, so this row stands in for one in process: the frozen object\n163\t;; crosses only as text (lowercase hex of its bytes and the address's\n164\t;; string), the receiver is a new machine of the composition that shares\n165\t;; nothing with the source, and the one capability it gets -- `attach`,\n166\t;; answering a descriptor by its identity -- is what a fresh process's\n167\t;; transport would offer.  `rehydrate-fenced` reads nothing else, so\n168\t;; what it can reach is exactly what a fresh process could.\n169\t(deftest a-version-2-recovery-snapshot-freezes-and-rehydrates-fenced\n170\t  (doseq [engine s/engines\n171\t          [what [source src]] (sources engine)\n172\t          [label header] [[\"fork\" nil]\n173\t                          [\"exclusive\" (s/header 0 nil #{})]]]\n174\t    (testing (str (name engine) \" \" what \" \" label)\n175\t      (let [before (observed src)\n176\t            {machine :machine record :record} (export/enter source\n177\t                                                            {:version 2})\n178\t            {:keys [serve! table]} (served-table)\n179\t            serves (atom 0)\n180\t            prepared (export/prepare machine record\n181\t                                     (fn [h] (swap! serves inc) (serve! h))\n182\t                                     header)\n183\t            served @serves\n184\t            frozen (export/freeze machine (:record prepared))\n185\t            wire {:hex (fx/bytes->hex (:bytes frozen))\n186\t                  :address (str (:address frozen))}\n187\t            by-identity (into {} (map (fn [[handle descriptor]]\n188\t                                        [(:dao.stream/identity descriptor)\n189\t                                         handle]))\n190\t                              @table)\n191\t            attached (atom 0)\n192\t            restored (export/rehydrate-fenced\n193\t                       (s/new-machine engine)\n194\t                       (fx/hex->bytes (:hex wire))\n195\t                       {:address (keyword (subs (:address wire) 1))\n196\t                        :attach (fn [descriptor]\n197\t                                  (swap! attached inc)\n198\t                                  {:dao.stream/outcome :dao.stream/ok\n199\t                                   :dao.stream/handle\n200\t                                   (by-identity\n201\t                                     (:dao.stream/identity descriptor))})})\n202\t            encoded (when (= :ok (:status restored))\n203\t                      (export/encode (:machine restored)\n204\t                                     (:record restored)))\n205\t            body (cbor/decode (:body-bytes frozen))]\n206\t        (is (= :ok (:status prepared)) (pr-str prepared))\n207\t        (is (= :ok (:status frozen)) (pr-str frozen))\n208\t        (is (= 2 (:yin.k/version body))\n209\t            \"the embedded body is version 2; the recovery's own stays 1\")\n210\t        (is (= 1 (:yin.k/version (cbor/decode (:bytes frozen)))))\n211\t        (is (= :ok (:status restored)) (pr-str restored))\n212\t        (is (= :exporting (vm/gate-mode (:machine restored))))\n213\t        (is (empty? (:wait-set (:machine restored))))\n214\t        (testing \"zero program IO during freeze and rehydrate\"\n215\t          (is (= served @serves) \"no stream served after prepare\")\n216\t          (is (= before (observed src))\n217\t              \"the task's stream reads exactly as it did before the lift\"))\n218\t        (testing \"the cells and parked records come back whole\"\n219\t          (is (= (count (:wait-set record))\n220\t                 (count (get-in restored [:record :wait-set]))))\n221\t          (is (= (cells-of source (:wait-set record))\n222\t                 (cells-of (:machine restored)\n223\t                           (get-in restored [:record :wait-set])))\n224\t              \"each wait polls the same stream from the same position\")\n225\t          (is (= (resolved source (:parked record))\n226\t                 (resolved (:machine restored)\n227\t                           (get-in restored [:record :parked])))\n228\t              \"every parked record whole: registers, code and the streams\n229\t               and positions its references name\")\n230\t          (is (= (keys (:parked record))\n231\t                 (keys (:parked (:record prepared))))\n232\t              \"the parked records are the ones the source entered with\")\n233\t          (is (every? #(and (some? (nth % 1)) (some? (nth % 2)))\n234\t                      (cells-of (:machine restored)\n235\t                                (get-in restored [:record :wait-set])))\n236\t              \"each restored wait names a live stream and a position\")\n237\t          (when (= \"explicit park\" what)\n238\t            (is (seq (:parked record)) \"a parked record crosses\")\n239\t            (is (some #(and (vector? %) (= :cursor (first %))\n240\t                            (some? (second %)) (some? (nth % 2)))\n241\t                      (tree-seq coll? seq\n242\t                                (resolved (:machine restored)\n243\t                                          (get-in restored\n244\t                                                  [:record :parked]))))\n245\t                \"the record's cursor resolves to a live stream and position\")))\n246\t        (is (pos? @attached))\n247\t        (is (= (vec (:body-bytes frozen)) (vec (:bytes encoded)))\n248\t            \"the published bytes are reproduced exactly\")\n249\t        (is (= :yin.k/refused\n250\t               (:yin.k/status (export/abort (:machine restored)\n251\t                                            (:record restored) [] nil)))\n252\t            \"a restarted abort is refused\")\n253\t        (testing \"recovery bytes are no handoff body\"\n254\t          (let [[r n] (s/read! engine (s/toy) (:bytes frozen) nil)]\n255\t            (is (not= :ok (:status r)))\n256\t            (is (zero? n))))))))\n257\t\n258\t\n259\t(def ^:private code-keys\n260\t  \"Where each profile holds its code: the semantic segment table, the\n261\t   walker's rows, the stack and register segment, layout and hash.\"\n262\t  [:code :code-aliases :rows :row-index :row-nodes :segment :images :hash])\n263\t\n264\t\n265\t(deftest a-poisoned-receiver-behaves-as-a-clean-one\n266\t  (doseq [engine s/engines]\n267\t    (testing (name engine)\n268\t      (let [t (s/toy)\n269\t            peer (s/served-peer t)\n270\t            [parked src] (s/parked-reader engine)\n271\t            export (s/lift parked t peer)\n272\t            reference (do (stream/append! src \"B\")\n273\t                          (vm/value (s/drive-local parked)))\n274\t            own-code (s/load-ast engine (s/new-machine engine) (s/lit 99))\n275\t            ;; the receiver's own code: its loaded program, and under\n276\t            ;; stack and register a second image grown onto its layout\n277\t            own-code (case engine\n278\t                       :stack (stack/attach-image\n279\t                                own-code (s/module-image :stack (s/lit 77))\n280\t                                vm/stack-contract)\n281\t                       :register (register/attach-image\n282\t                                   own-code\n283\t                                   (s/module-image :register (s/lit 77))\n284\t                                   vm/register-contract)\n285\t                       own-code)\n286\t            poisoned (assoc own-code\n287\t                            :store {'poison :wrong}\n288\t                            :module-stores {:segment/poison {'x 1}}\n289\t                            :parked {:poison {:type :parked-continuation}}\n290\t                            :installs {'poison {:phase :running}}\n291\t                            :wait-set [{:reason :next :poison true}]\n292\t                            :ready-queue []\n293\t                            :yin.k/closes [{:close :pending}]\n294\t                            :yin.k/issued 99)\n295\t            attach (s/attacher t)\n296\t            r (handoff/resume-task poisoned (:bytes export) attach\n297\t                                   {:address (:address export)})\n298\t            recv (:vm r)\n299\t            [clean _] (s/read! engine t (:bytes export)\n300\t                               {:address (:address export)})\n301\t            code-of #(select-keys % code-keys)\n302\t            done (s/drive recv peer)]\n303\t        (is (= :ok (:status r)) (pr-str r))\n304\t        (is (seq (code-of poisoned)) \"the receiver held code of its own\")\n305\t        (is (not= (code-of poisoned) (code-of recv)))\n306\t        (is (= (code-of (:vm clean)) (code-of recv))\n307\t            \"the code the task runs is a clean receiver's: nothing of the\n308\t             receiver's own program, layout or segment remains\")\n309\t        (when (contains? #{:stack :register} engine)\n310\t          (is (= 2 (count (:images poisoned))) \"a grown stale layout\")\n311\t          (is (= (:images parked) (:images recv)))\n312\t          (is (= (:hash parked) (:hash recv))))\n313\t        (is (not (contains? (:store recv) 'poison)))\n314\t        (is (empty? (:module-stores recv)))\n315\t        (is (not (contains? (:parked recv) :poison)))\n316\t        (is (not (contains? (:installs recv) 'poison)))\n317\t        (is (empty? (:yin.k/closes recv)))\n318\t        (is (= reference (vm/value done)))))))\n319\t\n320\t\n321\t(deftest an-unknown-required-primitive-is-unsatisfied-before-attachment\n322\t  (doseq [engine s/engines]\n323\t    (testing (name engine)\n324\t      (let [t (s/toy)\n325\t            peer (s/served-peer t)\n326\t            parked (s/run-ast engine\n327\t                              (s/let1 'p (s/v '+)\n328\t                                      (s/let1 's {:type :stream/make\n329\t                                                  :buffer 4}\n330\t                                              (s/next-of\n331\t                                                (s/cursor-of (s/v 's))))))\n332\t            export (s/lift parked t peer)\n333\t            body (cbor/decode (:bytes export))\n334\t            markers (filter #(and (map? %)\n335\t                                  (= :yin.k/primitive (:yin.k/tag %)))\n336\t                            (tree-seq coll?\n337\t                                      (fn [n]\n338\t                                        (if (map? n)\n339\t                                          (concat (keys n) (vals n))\n340\t                                          (seq n)))\n341\t                                      body))\n342\t            unknown (walk/postwalk\n343\t                      (fn [x]\n344\t                        (if (and (map? x) (= :yin.k/primitive (:yin.k/tag x)))\n345\t                          (assoc x :yin.k/name 'no.such/primitive)\n346\t                          x))\n347\t                      body)\n348\t            [r n] (s/read! engine t (cbor/encode unknown) nil)]\n349\t        (is (= :ok (:status export)) (pr-str export))\n350\t        (is (seq markers) \"the primitive travels as a marker\")\n351\t        (is (= :yin.k/unsatisfied (:yin.k/status r)) (pr-str r))\n352\t        (is (= 'no.such/primitive (:yin.k/name r)))\n353\t        (is (zero? n) \"refused before one attachment\")\n354\t        (is (not (contains? r :vm)))))))\n355\t\n356\t\n357\t(deftest a-name-nothing-answers-refuses-the-lift-in-every-profile\n358\t  (doseq [engine s/engines]\n359\t    (testing (name engine)\n360\t      (let [t (s/toy)\n361\t            peer (s/served-peer t)\n362\t            parked (s/run-ast engine\n363\t                              (s/let1 's {:type :stream/make, :buffer 4}\n364\t                                      (s/then (s/next-of (s/cursor-of (s/v 's)))\n365\t                                              (s/v 'zz))))\n366\t            r (s/lift parked t peer)]\n367\t        (is (= :yin.k/unsatisfied (:yin.k/status r)) (pr-str r))\n368\t        (is (contains? (get-in r [:yin.k/missing :obligations]) 'zz))))))\n369\t"}]},"parent_tool_use_id":null,"session_id":"23e67cb0-f183-4c2e-b3d6-2e5b6c44b814","uuid":"489c48a5-ec53-45ab-a28e-46d687588923","timestamp":"2026-10-13T08:32:30.158Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7plan/test/yin/vm/ucf/handoff_v2_holder_test.cljc","content":"(ns yin.vm.ucf.handoff-v2-holder-test\n  \"UCF version 2, section 11 rows 9, 10, 11 and 12 over the holder's\n   exporting state: the D4-D9 holds in root and child refuse the lift and\n   leave the machine as it was; canonical bytes do not depend on map\n   insertion order; a version-2 recovery snapshot freezes, rehydrates in\n   a fresh receiver with its gates exporting and its bytes reproduced,\n   and refuses a restarted abort; and a receiver poisoned with guest\n   state behaves exactly as a clean one.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [clojure.walk :as walk]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.cbor-fixtures :as fx]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n            [yin.vm.debruijn.register :as register]\n            [yin.vm.debruijn.stack :as stack]\n            [yin.vm.ucf.handoff :as handoff]\n            [yin.vm.ucf.holder.export :as export]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n(defn- served-table\n  \"A `serve!` answering one stable identity per handle.\"\n  []\n  (let [table (atom {})]\n    {:table table\n     :serve! (fn [h]\n               (or (get @table h)\n                   (let [served {:dao.stream/identity\n                                 (str \"s\" (count @table))\n                                 :dao.stream/channel\n                                 {:dao.stream/type :test/channel}}]\n                     (swap! table assoc h served)\n                     served)))}))\n\n\n(defn- hold-at\n  \"`machine` with `f` applied at the root, or at the install child\n   `path` names.\"\n  [machine path f]\n  (if (empty? path)\n    (f machine)\n    (update-in machine [:installs (first path) :vm] hold-at (rest path) f)))\n\n\n(def ^:private holds\n  \"Each hold: [kind f], `f` turning a machine into one that holds it.\"\n  [[:held #(assoc-in % [:wait-set 0 :yin.k/held] {:state :observed})]\n   [:observe #(assoc-in % [:wait-set 0 :reason] :observe)]\n   [:unminted-cursor\n    #(assoc-in % [:resources :yin/unminted]\n               {:stream-id :yin/none :cursor nil :yin.k/unminted true})]\n   [:pending-close #(assoc % :yin.k/closes [{:close :pending}])]\n   ;; a :link-request wait whose response cursor was never installed\n   [:link-cursor-not-installed\n    #(update-in % [:wait-set 0]\n                (fn [entry]\n                  (dissoc (assoc entry :reason :link-request)\n                          :cursor)))]])\n\n\n(deftest every-hold-refuses-the-lift-in-root-and-child\n  (doseq [engine s/engines\n          [kind f] holds]\n    (testing (str (name engine) \" \" kind)\n      (let [reader (first (s/parked-reader engine))\n            [installer _] (s/parked-installer engine)\n            held-root (hold-at reader [] f)\n            held-child (hold-at installer ['host.mod] f)]\n        (doseq [[label machine path] [[\"root\" held-root []]\n                                      [\"child\" held-child ['host.mod]]]]\n          (let [entered (export/enter machine {:version 2})\n                lifted (handoff/export-task machine (:serve! (served-table))\n                                            {:version 2})]\n            (is (= :yin.k/non-portable (:yin.k/status entered))\n                (str label \": \" (pr-str (dissoc entered :machine))))\n            (is (= kind (:yin.k/hold entered)))\n            (is (= path (:yin.k/path entered)))\n            (is (not (contains? entered :machine))\n                \"nothing was fenced: the machine stays as it was\")\n            (is (= :yin.k/non-portable (:yin.k/status lifted)))\n            (is (= kind (:yin.k/hold lifted)))))))))\n\n\n(deftest identical-data-lifts-to-identical-canonical-bytes\n  (doseq [engine s/engines]\n    (testing (name engine)\n      (let [[m _] (s/parked-reader engine)\n            make (fn [store] (assoc m :store store))\n            ;; zipmap keeps small-map insertion order on the hosts that\n            ;; have it (so a and b iterate differently there) and\n            ;; compiles on every host -- array-map does not exist on\n            ;; ClojureDart\n            a (make (zipmap '[a b c d] [1 2 3 4]))\n            b (make (zipmap '[d c b a] [4 3 2 1]))\n            lift #(handoff/export-task % (:serve! (served-table))\n                                       {:version 2})\n            ea (lift a)\n            eb (lift b)]\n        (is (= :ok (:status ea)) (pr-str ea))\n        (is (= (vec (:bytes ea)) (vec (:bytes eb)))\n            \"map insertion order never reaches the bytes\")\n        (is (= (:address ea) (:address eb)))\n        (is (= (set (keys (:yin.k/code (:body ea))))\n               (set (keys (:yin.k/code (:body eb))))))\n        (is (= (:yin.k/cells (:body ea)) (:yin.k/cells (:body eb))))))))\n\n\n(defn- observed\n  \"Everything a program could see of stream `h`: the outcome and value\n   at its first positions.  Equal before and after means no program IO\n   appended to it.\"\n  [h]\n  (mapv #(select-keys (stream/next h %) [:dao.stream/outcome\n                                         :dao.stream/value])\n        (range 3)))\n\n\n(defn- cells-of\n  \"Each wait of `waits`, resolved through `machine`'s own resources: its\n   reason, the stream handle it polls and the cell's position, plus the\n   entry's keys but for the recovery's issue mark.\"\n  [machine waits]\n  (mapv (fn [e]\n          [(:reason e)\n           (get-in machine [:resources (:stream-id e)])\n           (get-in machine [:resources (get-in e [:cursor-ref :id]) :cursor])\n           (disj (set (keys e)) :yin.k/issue)])\n        waits))\n\n\n(defn- resolved\n  \"`x` with every stream and cursor reference replaced by what it names\n   in `machine`'s own resources -- the stream handle, the handle and the\n   cell's position -- so records held under receiver-owned ids and seals\n   compare by content.\"\n  [machine x]\n  (walk/postwalk\n    (fn [n]\n      (if (and (map? n) (contains? #{:stream-ref :cursor-ref} (:type n)))\n        (let [r (get-in machine [:resources (:id n)])]\n          (if (= :stream-ref (:type n))\n            [:stream r]\n            [:cursor (get-in machine [:resources (:stream-id r)]) (:cursor r)]))\n        n))\n    x))\n\n\n(defn- sources\n  \"The machines the recovery row freezes, by label: a reader parked on a\n   wait (cells), and an explicit park whose record holds a cursor (a\n   parked record).  Each answers [machine stream].\"\n  [engine]\n  [[\"reader\" (s/parked-reader engine)]\n   [\"explicit park\" (let [m (s/parked-explicit engine)]\n                      [m (get-in m [:resources (some (fn [[_ r]]\n                                                       (:stream-id r))\n                                                     (:resources m))])])]])\n\n\n;; A genuinely fresh process is not portable across the three test\n;; hosts, so this row stands in for one in process: the frozen object\n;; crosses only as text (lowercase hex of its bytes and the address's\n;; string), the receiver is a new machine of the composition that shares\n;; nothing with the source, and the one capability it gets -- `attach`,\n;; answering a descriptor by its identity -- is what a fresh process's\n;; transport would offer.  `rehydrate-fenced` reads nothing else, so\n;; what it can reach is exactly what a fresh process could.\n(deftest a-version-2-recovery-snapshot-freezes-and-rehydrates-fenced\n  (doseq [engine s/engines\n          [what [source src]] (sources engine)\n          [label header] [[\"fork\" nil]\n                          [\"exclusive\" (s/header 0 nil #{})]]]\n    (testing (str (name engine) \" \" what \" \" label)\n      (let [before (observed src)\n            {machine :machine record :record} (export/enter source\n                                                            {:version 2})\n            {:keys [serve! table]} (served-table)\n            serves (atom 0)\n            prepared (export/prepare machine record\n                                     (fn [h] (swap! serves inc) (serve! h))\n                                     header)\n            served @serves\n            frozen (export/freeze machine (:record prepared))\n            wire {:hex (fx/bytes->hex (:bytes frozen))\n                  :address (str (:address frozen))}\n            by-identity (into {} (map (fn [[handle descriptor]]\n                                        [(:dao.stream/identity descriptor)\n                                         handle]))\n                              @table)\n            attached (atom 0)\n            restored (export/rehydrate-fenced\n                       (s/new-machine engine)\n                       (fx/hex->bytes (:hex wire))\n                       {:address (keyword (subs (:address wire) 1))\n                        :attach (fn [descriptor]\n                                  (swap! attached inc)\n                                  {:dao.stream/outcome :dao.stream/ok\n                                   :dao.stream/handle\n                                   (by-identity\n                                     (:dao.stream/identity descriptor))})})\n            encoded (when (= :ok (:status restored))\n                      (export/encode (:machine restored)\n                                     (:record restored)))\n            body (cbor/decode (:body-bytes frozen))]\n        (is (= :ok (:status prepared)) (pr-str prepared))\n        (is (= :ok (:status frozen)) (pr-str frozen))\n        (is (= 2 (:yin.k/version body))\n            \"the embedded body is version 2; the recovery's own stays 1\")\n        (is (= 1 (:yin.k/version (cbor/decode (:bytes frozen)))))\n        (is (= :ok (:status restored)) (pr-str restored))\n        (is (= :exporting (vm/gate-mode (:machine restored))))\n        (is (empty? (:wait-set (:machine restored))))\n        (testing \"zero program IO during freeze and rehydrate\"\n          (is (= served @serves) \"no stream served after prepare\")\n          (is (= before (observed src))\n              \"the task's stream reads exactly as it did before the lift\"))\n        (testing \"the cells and parked records come back whole\"\n          (is (= (count (:wait-set record))\n                 (count (get-in restored [:record :wait-set]))))\n          (is (= (cells-of source (:wait-set record))\n                 (cells-of (:machine restored)\n                           (get-in restored [:record :wait-set])))\n              \"each wait polls the same stream from the same position\")\n          (is (= (resolved source (:parked record))\n                 (resolved (:machine restored)\n                           (get-in restored [:record :parked])))\n              \"every parked record whole: registers, code and the streams\n               and positions its references name\")\n          (is (= (keys (:parked record))\n                 (keys (:parked (:record prepared))))\n              \"the parked records are the ones the source entered with\")\n          (is (every? #(and (some? (nth % 1)) (some? (nth % 2)))\n                      (cells-of (:machine restored)\n                                (get-in restored [:record :wait-set])))\n              \"each restored wait names a live stream and a position\")\n          (when (= \"explicit park\" what)\n            (is (seq (:parked record)) \"a parked record crosses\")\n            (is (some #(and (vector? %) (= :cursor (first %))\n                            (some? (second %)) (some? (nth % 2)))\n                      (tree-seq coll? seq\n                                (resolved (:machine restored)\n                                          (get-in restored\n                                                  [:record :parked]))))\n                \"the record's cursor resolves to a live stream and position\")))\n        (is (pos? @attached))\n        (is (= (vec (:body-bytes frozen)) (vec (:bytes encoded)))\n            \"the published bytes are reproduced exactly\")\n        (is (= :yin.k/refused\n               (:yin.k/status (export/abort (:machine restored)\n                                            (:record restored) [] nil)))\n            \"a restarted abort is refused\")\n        (testing \"recovery bytes are no handoff body\"\n          (let [[r n] (s/read! engine (s/toy) (:bytes frozen) nil)]\n            (is (not= :ok (:status r)))\n            (is (zero? n))))))))\n\n\n(def ^:private code-keys\n  \"Where each profile holds its code: the semantic segment table, the\n   walker's rows, the stack and register segment, layout and hash.\"\n  [:code :code-aliases :rows :row-index :row-nodes :segment :images :hash])\n\n\n(deftest a-poisoned-receiver-behaves-as-a-clean-one\n  (doseq [engine s/engines]\n    (testing (name engine)\n      (let [t (s/toy)\n            peer (s/served-peer t)\n            [parked src] (s/parked-reader engine)\n            export (s/lift parked t peer)\n            reference (do (stream/append! src \"B\")\n                          (vm/value (s/drive-local parked)))\n            own-code (s/load-ast engine (s/new-machine engine) (s/lit 99))\n            ;; the receiver's own code: its loaded program, and under\n            ;; stack and register a second image grown onto its layout\n            own-code (case engine\n                       :stack (stack/attach-image\n                                own-code (s/module-image :stack (s/lit 77))\n                                vm/stack-contract)\n                       :register (register/attach-image\n                                   own-code\n                                   (s/module-image :register (s/lit 77))\n                                   vm/register-contract)\n                       own-code)\n            poisoned (assoc own-code\n                            :store {'poison :wrong}\n                            :module-stores {:segment/poison {'x 1}}\n                            :parked {:poison {:type :parked-continuation}}\n                            :installs {'poison {:phase :running}}\n                            :wait-set [{:reason :next :poison true}]\n                            :ready-queue []\n                            :yin.k/closes [{:close :pending}]\n                            :yin.k/issued 99)\n            attach (s/attacher t)\n            r (handoff/resume-task poisoned (:bytes export) attach\n                                   {:address (:address export)})\n            recv (:vm r)\n            [clean _] (s/read! engine t (:bytes export)\n                               {:address (:address export)})\n            code-of #(select-keys % code-keys)\n            done (s/drive recv peer)]\n        (is (= :ok (:status r)) (pr-str r))\n        (is (seq (code-of poisoned)) \"the receiver held code of its own\")\n        (is (not= (code-of poisoned) (code-of recv)))\n        (is (= (code-of (:vm clean)) (code-of recv))\n            \"the code the task runs is a clean receiver's: nothing of the\n             receiver's own program, layout or segment remains\")\n        (when (contains? #{:stack :register} engine)\n          (is (= 2 (count (:images poisoned))) \"a grown stale layout\")\n          (is (= (:images parked) (:images recv)))\n          (is (= (:hash parked) (:hash recv))))\n        (is (not (contains? (:store recv) 'poison)))\n        (is (empty? (:module-stores recv)))\n        (is (not (contains? (:parked recv) :poison)))\n        (is (not (contains? (:installs recv) 'poison)))\n        (is (empty? (:yin.k/closes recv)))\n        (is (= reference (vm/value done)))))))\n\n\n(deftest an-unknown-required-primitive-is-unsatisfied-before-attachment\n  (doseq [engine s/engines]\n    (testing (name engine)\n      (let [t (s/toy)\n            peer (s/served-peer t)\n            parked (s/run-ast engine\n                              (s/let1 'p (s/v '+)\n                                      (s/let1 's {:type :stream/make\n                                                  :buffer 4}\n                                              (s/next-of\n                                                (s/cursor-of (s/v 's))))))\n            export (s/lift parked t peer)\n            body (cbor/decode (:bytes export))\n            markers (filter #(and (map? %)\n                                  (= :yin.k/primitive (:yin.k/tag %)))\n                            (tree-seq coll?\n                                      (fn [n]\n                                        (if (map? n)\n                                          (concat (keys n) (vals n))\n                                          (seq n)))\n                                      body))\n            unknown (walk/postwalk\n                      (fn [x]\n                        (if (and (map? x) (= :yin.k/primitive (:yin.k/tag x)))\n                          (assoc x :yin.k/name 'no.such/primitive)\n                          x))\n                      body)\n            [r n] (s/read! engine t (cbor/encode unknown) nil)]\n        (is (= :ok (:status export)) (pr-str export))\n        (is (seq markers) \"the primitive travels as a marker\")\n        (is (= :yin.k/unsatisfied (:yin.k/status r)) (pr-str r))\n        (is (= 'no.such/primitive (:yin.k/name r)))\n        (is (zero? n) \"refused before one attachment\")\n        (is (not (contains? r :vm)))))))\n\n\n(deftest a-name-nothing-answers-refuses-the-lift-in-every-profile\n  (doseq [engine s/engines]\n    (testing (name engine)\n      (let [t (s/toy)\n            peer (s/served-peer t)\n            parked (s/run-ast engine\n                              (s/let1 's {:type :stream/make, :buffer 4}\n                                      (s/then (s/next-of (s/cursor-of (s/v 's)))\n                                              (s/v 'zz))))\n            r (s/lift parked t peer)]\n        (is (= :yin.k/unsatisfied (:yin.k/status r)) (pr-str r))\n        (is (contains? (get-in r [:yin.k/missing :obligations]) 'zz))))))\n","numLines":369,"startLine":1,"totalLines":369}},"tool_result_meta":[{"id":"toolu_01DMBWcSj8rcL75qEN9ZLMKT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
