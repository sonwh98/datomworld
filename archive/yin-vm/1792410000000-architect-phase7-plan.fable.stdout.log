ts task) census (nth slots 9)\n822\t                  cursor-cells (into {} (map vec) (partition 2 (:slots census))) reached (atom #{})]\n823\t              (visit task path cursor-cells reached)\n824\t              (when-not (= (set (keys cursor-cells)) @reached) (bad! :extra-cursor-cell (conj path 9)))))]\n825\t    (when (= :task (:kind root)) (check-task root []))))\n826\t\n827\t\n828\t(defn- decode*\n829\t  \"Validate gate, local schema, finite reachable graph, hashes, canonical\n830\t   form and cursor-cell numbering, then expand structural refs. No attachment.\n831\t   Frame checks are available separately through validate-frames.\"\n832\t  ([wire] (decode* wire default-budget))\n833\t  ([wire budget]\n834\t   (let [budget (merge default-budget budget) counter (atom {})\n835\t         rs (:yin.k/rows wire)]\n836\t     (when-not (and (= true (:yin.k/handoff wire)) (= 3 (:yin.k/version wire))\n837\t                    (code/reg? (:yin.k/version wire)))\n838\t       (refuse! :yin.k/profile-mismatch :version [:yin.k/version]))\n839\t     (when-not (and (= #{:yin.k/handoff :yin.k/version :yin.k/root :yin.k/rows} (set (keys wire)))\n840\t                    (vector? rs) (every? #(and (vector? %) (<= 2 (count %))) rs))\n841\t       (bad! :row-shape [:yin.k/rows]))\n842\t     (spend! counter budget :rows (count rs))\n843\t     (spend! counter budget :bytes (count (seq (cbor/encode wire))))\n844\t     (let [index (into {} (map (fn [r] [(first r) r])) rs)\n845\t           root (:yin.k/root wire)]\n846\t       (when-not (= (count rs) (count index)) (bad! :duplicate-row [:yin.k/rows]))\n847\t       (when-not (contains? #{:task :act :tail :wait} (second (get index root))) (bad! :root [:yin.k/root]))\n848\t       ;; Gate children before schema, with an active path (DAG sharing is legal).\n849\t       (letfn [(gate\n850\t                 [id active]\n851\t                 (when (contains? active id) (bad! :cyclic [id]))\n852\t                 (let [row (get index id) slots (when row (subvec row 2))]\n853\t                   (when-not (and (= :task (second row)) (= 17 (count slots))\n854\t                                  (vector? (nth slots 12)) (every? keyword? (nth slots 12)))\n855\t                     (bad! :task-shape [id]))\n856\t                   (when-not (= 3 (nth slots 0)) (refuse! :yin.k/profile-mismatch :version [id 0]))\n857\t                   (when-not (= profile (nth slots 1)) (refuse! :yin.k/profile-mismatch :profile [id 1]))\n858\t                   (doseq [install (nth slots 12)]\n859\t                     (let [r (get index install)]\n860\t                       (when-not (and (= :install (second r)) (= 7 (count r))) (bad! :install-shape [install]))\n861\t                       (gate (nth r 6) (conj active id))))))]\n862\t         (when (= :task (second (get index root))) (gate root #{})))\n863\t       (doseq [[id kind & slots] rs]\n864\t         (let [schema (get row-table kind) ds (descriptors kind slots)]\n865\t           (when-not (and schema\n866\t                          (cond\n867\t                            (= schema :pending) (contains? pending-table (first slots))\n868\t                            (= :pairs (first schema)) (even? (count slots))\n869\t                            :else true)\n870\t                          (= (count ds) (count slots))) (bad! :row-shape [id]))\n871\t           (doseq [[i d x] (map vector (range) ds slots)]\n872\t             (when-not (structural? kind d x) (bad! :slot-kind [id i])))))\n873\t       (let [seen (atom #{})]\n874\t         (letfn [(walk\n875\t                   [id active depth]\n876\t                   (when (> depth (:depth budget)) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n877\t                   (when (contains? active id) (bad! :cyclic [id]))\n878\t                   (when-not (contains? @seen id)\n879\t                     (let [r (get index id)]\n880\t                       (when-not r (bad! :missing-row [id]))\n881\t                       (let [kind (second r) slots (subvec r 2)]\n882\t                         (doseq [[i d x] (map vector (range) (descriptors kind slots) slots)]\n883\t                           (let [targets (cond (ref? d) [x] (refs? d) x\n884\t                                               (and (contains? #{:V :optional-V} d) (= :row (first x))) [(second x)]\n885\t                                               :else [])]\n886\t                             (doseq [target targets]\n887\t                               (when (and (contains? #{:V :optional-V} d)\n888\t                                          (not (contains? value-row-kinds (second (get index target)))))\n889\t                                 (bad! :value-reference-kind [id i]))\n890\t                               (when (and (or (ref? d) (refs? d))\n891\t                                          (not (contains? (set (rest d)) (second (get index target)))))\n892\t                                 (bad! :reference-kind [id i]))\n893\t                               (walk target (conj active id) (inc depth))))))\n894\t                       (swap! seen conj id))))]\n895\t           (walk root #{} 0)\n896\t           (when-not (= @seen (set (keys index))) (bad! :unreachable-row [:yin.k/rows]))))\n897\t       (doseq [[id & body] rs]\n898\t         (when-not (and (= :blake3 (:algorithm (jing/parse-segment-address id)))\n899\t                        (= id (jing/segment-key (vec body))))\n900\t           (refuse! :yin.k/hash-mismatch :row [id])))\n901\t       (doseq [[id kind & slots] rs :when (= :task kind)]\n902\t         (doseq [[address v] (nth slots 11)]\n903\t           (when-not (= address (jing/segment-key v))\n904\t             (refuse! :yin.k/hash-mismatch :code [id 11 address]))\n905\t           (when (code/well-formed? v) (bad! :code [id 11 address]))))\n906\t       (doseq [[_ kind & slots] rs\n907\t               [d x] (map vector (descriptors kind slots) slots)]\n908\t         (when-not (or (ref? d) (refs? d) (= :C d))\n909\t           (check-literal-markers! (if (contains? #{:V :optional-V} d)\n910\t                                     (when (= :lit (first x)) (second x)) x))))\n911\t       (doseq [[id kind & slots] rs]\n912\t         (when-not (= (vec slots) (ordered-slots kind (vec slots))) (bad! :row-order [id]))\n913\t         (when (contains? #{:map :bindings :store :parked-table :window :cursor-cells :set} kind)\n914\t           (let [keys (if (= kind :set) slots (map first (partition 2 slots)))]\n915\t             (when-not (and (= (count keys) (count (distinct keys)))\n916\t                            (= (count keys) (count (distinct (map #(bytes-key (cbor/encode %)) keys)))))\n917\t               (bad! :duplicate-key [id])))))\n918\t       (letfn [(expand-slot\n919\t                 [d x]\n920\t                 (cond (ref? d) (expand x) (refs? d) (mapv expand x)\n921\t                       (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (expand (second x))]\n922\t                       :else x))\n923\t               (expand\n924\t                 [id]\n925\t                 (let [[_ kind & slots] (get index id)]\n926\t                   (node kind (mapv expand-slot (descriptors kind slots) slots))))]\n927\t         (let [task (expand root)\n928\t               _ (check-abstract! task)\n929\t               ;; Only the lift's tie refusal (root or child) is translated; a\n930\t               ;; resource refusal propagates as itself.\n931\t               canonical (if (= :task (:kind task))\n932\t                           (try (emit task budget)\n933\t                                (catch #?(:cljd Object :clj Throwable :cljs :default) e\n934\t                                  (let [d (ex-data e)]\n935\t                                    (if (and (= :yin.k/non-portable (:yin.k/status d))\n936\t                                             (= :unresolved-cursor-cells (:yin.k/kind d)))\n937\t                                      (throw (ex-info \"Row codec refused data\"\n938\t                                                      (assoc d :yin.k/status :yin.k/undecodable\n939\t                                                             :yin.k/path (into [root] (:yin.k/path d)))))\n940\t                                      (throw e)))))\n941\t                           (let [[id _] (emit-node task {} {})] {:yin.k/root id}))]\n942\t           (when (and (not= false (:check-numbering budget)) (not= root (:yin.k/root canonical)))\n943\t             (bad! :noncanonical-cursor-cells [root]))\n944\t           (when (= :task (:kind task))\n945\t             (when-let [d (validate-frames task)]\n946\t               (throw (ex-info \"Frame validation failed\" (update d :yin.k/path #(into [root] %))))))\n947\t           task))))))\n948\t\n949\t\n950\t(defn decode\n951\t  \"Validate and expand a row pack, including canonical cursor-cell numbering.\n952\t   For task roots, run X1 and frame validation after numbering.\"\n953\t  ([wire] (decode* wire default-budget))\n954\t  ([wire budget] (decode* wire (dissoc budget :check-numbering))))\n955\t\n956\t\n957\t(defn canonical-under\n958\t  \"Test-only §5.5 re-emission under an explicit stream correspondence.\n959\t   Missing marker coverage fails; neither traversal order nor original\n960\t   cursor-cell numbering chooses a logical identity. Accepts a carrier.\"\n961\t  [wire correspondence]\n962\t  (let [task (decode* wire (assoc default-budget :check-numbering false))]\n963\t    (letfn [(rewrite-slot\n964\t              [d x]\n965\t              (cond (ref? d) (rewrite x) (refs? d) (mapv rewrite x)\n966\t                    (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (rewrite (second x))]\n967\t                    :else x))\n968\t            (rewrite\n969\t              [n]\n970\t              (let [{:keys [kind slots]} n]\n971\t                (if (= :stream kind)\n972\t                  (let [id (first slots)]\n973\t                    (when-not (contains? correspondence id) (bad! :missing-stream-correspondence [id]))\n974\t                    (node :stream [(get correspondence id) (get correspondence id)]))\n975\t                  (node kind (mapv rewrite-slot (descriptors kind slots) slots)))))]\n976\t      (emit (rewrite task)))))\n977\t\n978\t\n979\t(defn- value-node\n980\t  [x]\n981\t  (check-literal-markers! x)\n982\t  [:lit x])\n983\t\n984\t\n985\t(defn- decoded-value\n986\t  [v]\n987\t  (case (first v)\n988\t    :row {:yin.k/row (second v)}\n989\t    :cursor-cell {:yin.k/cursor-cell (second v)}\n990\t    :lit (if (marker-shaped? (second v)) (refuse! :yin.k/non-portable :marker []) (second v))))\n991\t\n992\t\n993\t(defn- keyed-node\n994\t  [kind m encode]\n995\t  (node kind (mapcat (fn [[k v]] [k (encode v)]) m)))\n996\t\n997\t\n998\t(defn- env-node\n999\t  [e encode]\n1000\t  (node :env [(keyed-node :bindings (:yin.k/bindings e) encode) (:yin.k/store-of e)]))\n1001\t\n1002\t\n1003\t(defn- kframe-node\n1004\t  [f encode]\n1005\t  (node :kframe [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n1006\t                 (keyed-node :window (:yin.k/window f) encode) (:yin.k/rd f)]))\n1007\t\n1008\t\n1009\t(def pending-keys\n1010\t  {:next [:yin.k/cursor-cell]\n1011\t   :put [:yin.k/stream :yin.k/value :yin.k/op-id]\n1012\t   :ffi [:yin.k/cursor-cell :yin.k/call-id :yin.k/op]\n1013\t   :ffi-request [:yin.k/call-id :yin.k/envelope :yin.k/request-stream :yin.k/response-stream :yin.k/response-cursor-cell :yin.k/op-id]\n1014\t   :link-request [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell :yin.k/envelope :yin.k/op-id]\n1015\t   :link-response [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell]\n1016\t   :install [:yin.k/name]})\n1017\t\n1018\t\n1019\t(defn frame->rows\n1020\t  \"Encode a keyed frame to a frame-rooted version-3 row pack. Values are\n1021\t   plain literals by default. An explicit value encoder classifies portable\n1022\t   references as [:row abstract-row] or [:cursor-cell id], distinct from guest maps.\n1023\t   This reshapes; frame/defect owns semantic validity.\"\n1024\t  ([f] (frame->rows f value-node))\n1025\t  ([f encode]\n1026\t   (let [k (node :k (mapv #(kframe-node % encode) (:yin.k/k f)))\n1027\t         state (if (= :act (:yin.k/state f))\n1028\t                 (node :act [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n1029\t                             (keyed-node :window (:yin.k/window f) encode) k (get-in f [:yin.k/deliver :yin.k/rd])])\n1030\t                 (node :tail [(:yin.k/segment f) (:yin.k/site f) k]))\n1031\t         pending (:yin.k/pending f)\n1032\t         reason (:yin.k/reason pending)\n1033\t         root (if (contains? f :yin.k/pending)\n1034\t                (node :wait [state (node :pending\n1035\t                                         (into [reason]\n1036\t                                               (map (fn [key d]\n1037\t                                                      (let [x (get pending key)]\n1038\t                                                        (if (= :V d) (encode x) x)))\n1039\t                                                    (get pending-keys reason) (get pending-table reason))))])\n1040\t                state)\n1041\t         [id rows] (emit-node root {} {})]\n1042\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n1043\t\n1044\t\n1045\t(defn- decode-keyed\n1046\t  [n decode-value]\n1047\t  (into {} (map (fn [[k v]] [k (decode-value v)])) (partition 2 (:slots n))))\n1048\t\n1049\t\n1050\t(defn- decode-env\n1051\t  [n decode-value]\n1052\t  (let [[bindings store-of] (:slots n)]\n1053\t    (cond-> {:yin.k/bindings (decode-keyed bindings decode-value)}\n1054\t      (some? store-of) (assoc :yin.k/store-of store-of))))\n1055\t\n1056\t\n1057\t(defn- decode-kframe\n1058\t  [n decode-value]\n1059\t  (let [[seg pc e w rd] (:slots n)]\n1060\t    {:yin.k/frame-type :return :yin.k/segment seg :yin.k/pc pc\n1061\t     :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value) :yin.k/rd rd}))\n1062\t\n1063\t\n1064\t(defn- decode-frame\n1065\t  [n decode-value]\n1066\t  (if (= :wait (:kind n))\n1067\t    (let [[state pending] (:slots n) [reason & slots] (:slots pending)]\n1068\t      (assoc (decode-frame state decode-value) :yin.k/pending\n1069\t             (into {:yin.k/reason reason}\n1070\t                   (map (fn [key d x] [key (if (= :V d) (decode-value x) x)])\n1071\t                        (get pending-keys reason) (get pending-table reason) slots))))\n1072\t    (let [act? (= :act (:kind n)) [seg pc e w k rd] (:slots n)\n1073\t          k (if act? k e)]\n1074\t      (cond-> {:yin.k/state (:kind n) :yin.k/segment seg\n1075\t               :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd rd} {:yin.k/deliver :return})\n1076\t               :yin.k/k (mapv #(decode-kframe % decode-value) (:slots k))}\n1077\t        act? (assoc :yin.k/pc pc :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value))\n1078\t        (not act?) (assoc :yin.k/site pc)))))\n1079\t\n1080\t\n1081\t(defn rows->frame\n1082\t  \"Validate row syntax and hashes, then reshape to the keyed frame.\n1083\t   Semantic code/context rules remain frame/defect's responsibility.\n1084\t   The default decoder produces in-band row/cursor-cell markers that the default\n1085\t   encoder refuses. frame->rows after rows->frame is identity only when\n1086\t   both sides are given a classifier for those values.\"\n1087\t  ([wire] (rows->frame wire decoded-value))\n1088\t  ([wire decode-value] (decode-frame (decode wire) decode-value)))\n1089\t\n1090\t\n1091\t(defn validate-frames\n1092\t  \"Carrier step 7, after decode's canonical numbering. Judge each task's\n1093\t   X1 first, then waits, parked states, and all reified values. Return the\n1094\t   first defect with the abstract row path, or nil.\"\n1095\t  [task]\n1096\t  (let [slots (:slots task) code-map (nth slots 11)\n1097\t        free-env (decode-keyed (nth slots 5) decoded-value)\n1098\t        waits (nth slots 13)\n1099\t        ffi-ids (into #{} (keep (fn [w]\n1100\t                                  (let [[_ p] (:slots w) [reason & xs] (:slots p)]\n1101\t                                    (case reason :ffi (second xs) :ffi-request (first xs) nil)))) waits)\n1102\t        ctx {:free-env free-env :ffi-call-ids ffi-ids}]\n1103\t    (letfn [(judge\n1104\t              [n context context-map path]\n1105\t              (when-let [d (frame/defect (decode-frame n decoded-value) code-map context context-map)]\n1106\t                (-> d (assoc :yin.k/status :yin.k/undecodable)\n1107\t                    (update :yin.k/path #(into path %)))))\n1108\t            (captures\n1109\t              [n path]\n1110\t              (if (= :reified (:kind n))\n1111\t                (or (judge (first (:slots n)) :captured ctx path)\n1112\t                    (captures (first (:slots n)) (conj path 0)))\n1113\t                (some (fn [[i d x]]\n1114\t                        (cond\n1115\t                          (and (ref? d) (= :task (:kind x))) (validate-frames x)\n1116\t                          (ref? d) (captures x (conj path i))\n1117\t                          (refs? d) (some (fn [[j child]] (captures child (conj path i j))) (map-indexed vector x))\n1118\t                          (and (contains? #{:V :optional-V} d) (= :row (first x))) (captures (second x) (conj path i))\n1119\t                          :else nil))\n1120\t                      (map vector (range) (descriptors (:kind n) (:slots n)) (:slots n)))))]\n1121\t      (or\n1122\t        (when-let [d (frame/task-defect ctx)] (assoc d :yin.k/status :yin.k/undecodable))\n1123\t        (some (fn [[i w]] (judge w :wait ctx [:frames i])) (map-indexed vector waits))\n1124\t        (some (fn [[p state]] (judge state :parked (assoc ctx :parked-key p) [:parked p]))\n1125\t              (partition 2 (:slots (nth slots 8))))\n1126\t        (captures task [])))))\n1127\t\n1128\t\n1129\t;; =============================================================================\n1130\t;; Task transport (continuation design §7): lift-task and lower-task\n1131\t;; =============================================================================\n1132\t;;\n1133\t;; The lift walks a quiescent semantic-register machine into the abstract\n1134\t;; task the codec above emits: waits, parked records, the store, module\n1135\t;; stores, the free environment, the result and install children, every\n1136\t;; value classified as [:lit x], [:row n] or [:cursor-cell source]. A\n1137\t;; cursor cell's source is the resource id of a cursor reference, or\n1138\t;; [response-resource position] for a link wait's kept response cursor,\n1139\t;; so one resource reached twice is one cursor cell. The lower decodes the\n1140\t;; carrier (gate to frames, §3.3), checks pendings, dependencies and\n1141\t;; custody for every task of the tree, and only then attaches streams and"}]},"parent_tool_use_id":null,"session_id":"23e67cb0-f183-4c2e-b3d6-2e5b6c44b814","uuid":"4aaf36a7-34eb-48fc-b567-06ded7a42ce0","timestamp":"2026-10-13T08:32:01.051Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7plan/src/cljc/yin/vm/ucf/rows.cljc","content":"(ns yin.vm.ucf.rows\n  \"Version-3 row codec. Pure row construction, graph decoding and\n   discovery-order cursor-cell numbering (design note §1), then full task\n   transport for the semantic-register kernel (continuation design §7):\n   lift-task walks a quiescent machine into an abstract task and emits it;\n   lower-task decodes, checks and restores one into a fresh receiver.\n   An abstract row is {:kind keyword :slots vector}. Structural references\n   contain abstract rows; values use [:lit d], [:row abstract-row], [:cursor-cell id].\n   A task's :cursor-cells row holds alternating source identities and :cursor-cell-body\n   rows. Install children are separate tasks with separate cursor-cell scopes.\n\n   The census is ordered numerically by n (draft §3, \\\"sorted by n\\\"), so\n   :yin.k/cc-10 follows :yin.k/cc-9; its keys must spell cc-N with no leading\n   zero, else :slot-kind.\n\n   Default value markers are plain maps {:yin.k/row abstract-row} and\n   {:yin.k/cursor-cell keyword}. A guest map whose sole key is :yin.k/row or\n   :yin.k/cursor-cell collides with them and is not portable: on encode and decode\n   every literal of that shape is refused :yin.k/non-portable. Explicit\n   markers use the caller value encoder.\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.stream.apply :as apply2]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.semantic-register.analysis :as analysis]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.frame :as frame]\n            [yin.vm.semantic-register.scan :as scan]\n            [yin.vm.ucf.remote :as remote]))\n\n\n(def profile {:yin.code/contract \"v4\" :yin.k/version 1})\n\n\n(def pending-table\n  {:next [:C]\n   :put [[:ref :stream] :V :D]\n   :ffi [:C :D :D]\n   :ffi-request [:D :V [:ref :stream] [:ref :stream] :C :D]\n   :link-request [:D :S [:ref :stream] [:ref :stream] :C :D :D]\n   :link-response [:D :S [:ref :stream] [:ref :stream] :C]\n   :install [:S]})\n\n\n(def row-table\n  \"Slot descriptors, excluding id and kind. :repeat/:pairs are variadic;\n   :refs is an ordered vector of structural references. :pending is\n   discriminated by pending-table. Nothing in this table is executable.\"\n  {:vec [:repeat :V] :list [:repeat :V] :set [:repeat :V]\n   :map [:pairs :V :V] :bindings [:pairs :S :V] :store [:pairs :D :V]\n   :env [[:ref :bindings] :optional-D]\n   :closure [:A :N :syms [:ref :bindings] :optional-D]\n   :prim [:S] :stream [:D :D] :reified [[:ref :act]] :parked-ref [:D]\n   :act [:A :N [:ref :env] [:ref :window] [:ref :k] :N]\n   :tail [:A :N [:ref :k]]\n   :window [:pairs :N :V] :k [:repeat [:ref :kframe]]\n   :kframe [:A :N [:ref :env] [:ref :window] :N]\n   :wait [[:ref :act :tail] [:ref :pending]] :pending :pending\n   :module-store [:D [:ref :store]]\n   :parked-table [:pairs :D [:ref :act :tail]]\n   :install [:S :D :D :D [:ref :task]]\n   :cursor-cells [:pairs :C [:ref :cursor-cell-body]] :cursor-cell-body [[:ref :stream] :D]\n   :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n          [:refs :module-store] [:ref :parked-table] [:ref :cursor-cells]\n          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n\n\n(defn node\n  [kind slots]\n  {:kind kind :slots (if (= :window kind)\n                       (vec (mapcat identity (sort-by first (partition 2 slots))))\n                       (vec slots))})\n\n\n(defn- refuse!\n  [status kind path]\n  (throw (ex-info \"Row codec refused data\"\n                  {:yin.k/status status :yin.k/kind kind :yin.k/path path})))\n\n\n(defn- bad!\n  [kind path]\n  (refuse! :yin.k/undecodable kind path))\n\n\n(defn- marker-shaped?\n  [x]\n  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cursor-cell))))\n\n\n(defn- check-literal-markers!\n  [x]\n  (when (marker-shaped? x) (refuse! :yin.k/non-portable :marker []))\n  (when (coll? x)\n    (doseq [v (if (map? x) (mapcat identity x) x)] (check-literal-markers! v)))\n  (when (meta x) (check-literal-markers! (meta x))))\n\n\n(defn- bytes-key\n  [bs]\n  ;; Unsigned bytewise order, without a length-first comparison.\n  (mapv #(bit-and (int %) 255) (seq bs)))\n\n\n(defn- compare-bytes\n  [a b]\n  (loop [i 0]\n    (cond\n      (= i (count a)) (if (= i (count b)) 0 -1)\n      (= i (count b)) 1\n      (= (nth a i) (nth b i)) (recur (inc i))\n      :else (compare (nth a i) (nth b i)))))\n\n\n(defn- byte-compare\n  [a b]\n  (compare-bytes (bytes-key (cbor/encode a)) (bytes-key (cbor/encode b))))\n\n\n(defn- sorted-bytes\n  [xs]\n  (vec (sort byte-compare xs)))\n\n\n(defn- descriptors\n  [kind slots]\n  ;; :entry is the numbering's synthetic map entry [:entry k v], never a carrier row.\n  (let [schema (if (= :entry kind) [:V :V] (get row-table kind))]\n    (cond\n      (= schema :pending) (into [:D] (get pending-table (first slots)))\n      (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n      (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n      :else schema)))\n\n\n(defn- ref?\n  [d]\n  (and (vector? d) (= :ref (first d))))\n\n\n(defn- refs?\n  [d]\n  (and (vector? d) (= :refs (first d))))\n\n\n(def ^:private census-key #\"cc-([1-9][0-9]*)\")\n\n\n(defn- census-order\n  ;; Numeric order of cc-N without reading wire data: fewer digits first,\n  ;; then the digits. Other keys (a partial emit-numbered) sort last.\n  [k]\n  (let [digits (when (keyword? k) (second (re-matches census-key (name k))))]\n    (if digits [0 (count digits) digits] [1 0 (str k)])))\n\n\n(defn- ordered-slots\n  [kind slots]\n  (cond\n    (= kind :window) (vec (mapcat identity (sort-by first (partition 2 slots))))\n    (= kind :cursor-cells) (vec (mapcat identity (sort-by #(census-order (first %)) (partition 2 slots))))\n    (contains? #{:map :bindings :store :parked-table} kind)\n    (vec (mapcat identity (sort #(byte-compare (first %1) (first %2)) (partition 2 slots))))\n    (= kind :set) (sorted-bytes slots)\n    :else slots))\n\n\n(def default-budget\n  \"Local resource bounds, independent of canonical bytes. :work counts the\n   numbering's positions and the representation bound of every value it\n   encodes for a comparison (design note §1.5).\"\n  {:rows 10000 :cursor-cells 64 :depth 256 :work 4194304 :bytes 16777216})\n\n\n(declare emit-node canonical-numbering child-numberer validate-frames)\n\n\n(defn- emit-slot\n  [d x numbering rows path number-child]\n  (when-not (or (ref? d) (refs? d) (= :C d))\n    (check-literal-markers! (if (contains? #{:V :optional-V} d)\n                              (when (= :lit (first x)) (second x)) x)))\n  (cond\n    (ref? d) (emit-node x numbering rows path number-child)\n    (refs? d) (reduce (fn [[out rs] [j n]]\n                        (let [p (conj path (if (= :install (:kind n)) (first (:slots n)) j))\n                              [id rs'] (emit-node n numbering rs p number-child)]\n                          [(conj out id) rs']))\n                      [[] rows] (map-indexed vector x))\n    (= d :C) [(get numbering x x) rows]\n    (contains? #{:V :optional-V} d)\n    (case (first x)\n      :row (let [[id rs] (emit-node (second x) numbering rows path number-child)] [[:row id] rs])\n      :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n      [x rows])\n    :else [x rows]))\n\n\n(defn- emit-node\n  ;; path is the row path of n, so a child's refusal reports [12 <install name> ...].\n  ([n numbering rows] (emit-node n numbering rows [] (child-numberer default-budget)))\n  ([n numbering rows path number-child]\n   (let [{:keys [kind slots]} n\n         ;; A child is canonicalized in its own identity scope.\n         [slots rows] (reduce (fn [[out rs] [i d x]]\n                                (if (and (ref? d) (= :task (:kind x)))\n                                  (let [[id child-rows] (emit-node x (number-child x path) {} path number-child)]\n                                    [(conj out id) (merge rs child-rows)])\n                                  (let [[x' rs'] (emit-slot d x numbering rs (conj path i) number-child)]\n                                    [(conj out x') rs'])))\n                              [[] rows] (map vector (range) (descriptors kind slots) slots))\n         slots (if (= kind :task)\n                 (-> slots\n                     (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n                     (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n                 (ordered-slots kind slots))\n         body (into [kind] slots) id (jing/segment-key body)]\n     [id (assoc rows id (into [id] body))])))\n\n\n(defn- spend!\n  [counter budget category amount]\n  (let [n (get (swap! counter update category (fnil + 0) amount) category)]\n    (when (> n (get budget category))\n      (refuse! :yin.k/unsupported :resource-limit [category]))))\n\n\n;; Discovery-order cursor-cell numbering (design note\n;; yin.vm.semantic-register-vm.cursor-cell-numbering.md §1). A cursor cell is\n;; named by the order in which a fixed pre-order walk of the task meets it. A\n;; guest :set or :map is entered as the vector of its members sorted by key:\n;; the member's spelling by a key walk, numbered cursor cells by number and\n;; the others by local first-occurrence index, body rank and occurrence\n;; count. Members with equal keys form a tie group, postponed and re-keyed\n;; until a pass numbers nothing; a surviving group is entered in host order\n;; only when the tie test proves that harmless, else the lift refuses\n;; :unresolved-cursor-cells.\n\n\n(defn- work!\n  [ctx amount]\n  (spend! (:counter ctx) (:budget ctx) :work amount))\n\n\n(defn- charge-representation!\n  \"Charge to :work, before x is CBOR-encoded for a comparison, a conservative\n   bound of its representation: 128 per node or scalar, 4 per character, 16\n   plus the length per byte payload, metadata included. Iterative, against\n   the budget remaining at the call: it stops as soon as its running total\n   exceeds that, so it never reads to the end of a value it cannot afford.\"\n  [ctx x]\n  (let [{:keys [counter budget]} ctx\n        remaining (- (:work budget) (get @counter :work 0))]\n    (loop [stack (list (list x)) total 0 steps 0]\n      (if (empty? stack)\n        (do (swap! counter update :estimator-steps (fnil + 0) steps)\n            (work! ctx total))\n        (let [s (first stack) stack (rest stack)]\n          (if (empty? s)\n            (recur stack total steps)\n            (let [x (first s)\n                  stack (cons (rest s) stack)\n                  total (+ total (cond\n                                   (cbor/byte-payload? x) (+ 16 #?(:cljd (.-length x) :default (alength x)))\n                                   (string? x) (+ 128 (* 4 (count x)))\n                                   (or (keyword? x) (symbol? x)) (+ 128 (* 4 (count (str x))))\n                                   :else 128))]\n              (if (> total remaining)\n                (do (swap! counter update :estimator-steps (fnil + 0) (inc steps))\n                    (work! ctx total))\n                (recur (cond->> stack\n                         (coll? x) (cons (if (map? x) (mapcat identity x) (seq x)))\n                         (meta x) (cons (list (meta x))))\n                       total (inc steps))))))))))\n\n\n(defn- key-bytes!\n  \"Every comparison encoding of the numbering: charged, then encoded.\"\n  [ctx x]\n  (charge-representation! ctx x)\n  (bytes-key (cbor/encode x)))\n\n\n(defn- sort-by-key!\n  \"xs in the bytewise order of (f x), each encoded once.\"\n  [ctx f xs]\n  (mapv second (sort #(compare-bytes (first %1) (first %2))\n                     (mapv (fn [x] [(key-bytes! ctx (f x)) x]) xs))))\n\n\n(def ^:private keyed-structural #{:bindings :store :parked-table})\n\n\n(defn- value-slot?\n  [d]\n  (contains? #{:V :optional-V} d))\n\n\n(defn- child-task?\n  [ctx n]\n  (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n\n\n(defn- elem-item\n  ;; A :set member is its V; a :map entry is the synthetic ordered row\n  ;; [:entry k v], so the alias pattern across key and value is in its key.\n  [kind e]\n  (if (= :map kind) [:row (node :entry e)] e))\n\n\n(defn- depth-scan!\n  \"The :depth gate, before any recursive traversal of the task: one pre-order\n   scan with an explicit stack over rows, members, structural and literal\n   data and the census, install children skipped (each is gated by its own\n   numbering). A position's depth is its slot steps from the task (a member\n   step counts one, a map entry's key or value two) plus, inside data, its\n   collection nesting. Each position costs one :work unit, charged when it\n   is popped, before any work proportional to it.\"\n  [ctx task]\n  (let [limit (:depth (:budget ctx))\n        row (fn [n k] [:row nil n k])\n        slot (fn [d v k] [:slot d v k])\n        data (fn [v k] [:data nil v k])]\n    (loop [stack (list (list (row task 0)))]\n      (when (seq stack)\n        (let [s (first stack) stack (rest stack)]\n          (if (empty? s)\n            (recur stack)\n            (let [[tag d x k] (first s)\n                  stack (cons (rest s) stack)]\n              (work! ctx 1)\n              (when (> k limit) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n              (recur\n                (cons\n                  (case tag\n                    :row\n                    (let [{:keys [kind slots]} x k' (inc k)]\n                      (when-not (child-task? ctx x)\n                        (let [ds (descriptors kind slots)]\n                          (cond\n                            (= :task kind)\n                            (mapcat (fn [i d v]\n                                      (if (contains? #{7 12} i)\n                                        (map (fn [child] (row child (inc k'))) v)\n                                        [(slot d v k')]))\n                                    (range) ds slots)\n                            (contains? keyed-structural kind)\n                            (mapcat (fn [[key v]] [(data key k') (slot (second ds) v k')]) (partition 2 slots))\n                            (= :window kind)\n                            (mapcat (fn [[r v]] [(data r k') (slot :V v k')]) (partition 2 slots))\n                            (= :set kind) (map (fn [v] (slot :V v k')) slots)\n                            (= :map kind)\n                            (mapcat (fn [[a b]] [(slot :V a (inc k')) (slot :V b (inc k'))]) (partition 2 slots))\n                            :else (map (fn [d v] (slot d v k')) ds slots)))))\n                    :slot\n                    (cond\n                      (ref? d) [(row x k)]\n                      (refs? d) (map (fn [n] (row n (inc k))) x)\n                      (= :C d) nil\n                      (value-slot? d) (when x\n                                        (case (first x)\n                                          :cursor-cell nil\n                                          :row [(row (second x) k)]\n                                          :lit [(data (second x) k)]\n                                          [(data x k)]))\n                      :else [(data x k)])\n                    :data\n                    (concat (when (coll? x) (map (fn [e] (data e (inc k))) (if (map? x) (mapcat identity x) x)))\n                            (when (meta x) [(data (meta x) (inc k))])))\n                  stack)))))))))\n\n\n(defn- walk-cells\n  \"Call f on the cursor cell at every position under slot (d x), the census\n   and install children excluded; one :work unit per position. Recursive,\n   so it runs only after the depth scan.\"\n  [ctx d x f]\n  (letfn [(slot\n            [d x]\n            (work! ctx 1)\n            (cond\n              (ref? d) (row x)\n              (refs? d) (doseq [n x] (row n))\n              (= :C d) (f x)\n              (value-slot? d) (when x\n                                (case (first x)\n                                  :cursor-cell (f (second x))\n                                  :row (row (second x))\n                                  nil))\n              :else nil))\n          (row\n            [n]\n            (when-not (or (= :cursor-cells (:kind n)) (child-task? ctx n))\n              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))] (slot d x))))]\n    (slot d x)))\n\n\n(defn- item-cells\n  \"The cursor cells under slot (d x), memoized per numbering on the slot.\"\n  [ctx d x]\n  (or (get @(:cells-memo ctx) [d x])\n      (let [acc (atom #{})]\n        (walk-cells ctx d x #(swap! acc conj %))\n        (swap! (:cells-memo ctx) assoc [d x] @acc)\n        @acc)))\n\n\n(defn- body-ranks\n  \"Cursor cell -> rank of its body label [:body [:stream identity\n   descriptor] position] among the census's distinct labels in bytewise\n   order, so a key never repeats a descriptor.\"\n  [ctx bodies]\n  (let [labels (into {} (map (fn [[c b]]\n                               (let [[stream position] (:slots b)]\n                                 [c [:body (into [:stream] (:slots stream)) position]])))\n                     bodies)\n        ranks (into {} (map-indexed (fn [i l] [l i]) (sort-by-key! ctx identity (distinct (vals labels)))))]\n    (into {} (map (fn [[c l]] [c (get ranks l)])) labels)))\n\n\n(defn- new-run\n  [ctx num tag start]\n  {:ctx ctx :num (atom num) :tag tag :next (atom start)\n   :groups (atom []) :gid (atom 0) :refused (atom nil)})\n\n\n(defn- meet!\n  \"W2: a cursor cell met for the first time receives the run's next number.\"\n  [run c]\n  (when-not (contains? @(:num run) c)\n    (swap! (:num run) assoc c [(:tag run) @(:next run)])\n    (swap! (:next run) inc)))\n\n\n(declare enter-node! unordered! key-walk spell-slot spell-node)\n\n\n(defn- enter-slot!\n  [run d x path]\n  (let [ctx (:ctx run)]\n    (work! ctx 1)\n    (when (> (count path) (:depth (:budget ctx)))\n      (refuse! :yin.k/unsupported :resource-limit [:depth]))\n    (cond\n      (ref? d) (enter-node! run x path)\n      (refs? d) (doseq [[i n] (map-indexed vector x)] (enter-node! run n (conj path i)))\n      (= :C d) (meet! run x)\n      (value-slot? d) (when x\n                        (case (first x)\n                          :cursor-cell (meet! run (second x))\n                          :row (enter-node! run (second x) path)\n                          nil))\n      :else nil)))\n\n\n(defn- enter-node!\n  \"W1: pre-order in table order; ordered repeated slots in order; keyed\n   structural rows, installs and module stores in the byte order of the\n   key; :window in register order; :set and :map by member keys, ties\n   postponed; the census and install children are not entered.\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (or (= :cursor-cells kind) (child-task? ctx n)) nil\n      (= :task kind)\n      (doseq [[i d x] (map vector (range) ds slots)]\n        (if (contains? #{7 12} i)\n          (doseq [child (sort-by-key! ctx #(first (:slots %)) x)]\n            (enter-node! run child (conj path i (first (:slots child)))))\n          (enter-slot! run d x (conj path i))))\n      (contains? keyed-structural kind)\n      (doseq [[k v] (sort-by-key! ctx first (partition 2 slots))]\n        (enter-slot! run (second ds) v (conj path k)))\n      (= :window kind)\n      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n      (= :set kind) (unordered! run n :set (vec slots) path)\n      (= :map kind) (unordered! run n :map (mapv vec (partition 2 slots)) path)\n      :else (doseq [[i d x] (map vector (range) ds slots)] (enter-slot! run d x (conj path i))))))\n\n\n(defn- unordered!\n  \"Key every member by a key walk under the numbering at this moment; enter\n   members with a unique key in key order and postpone each run of equal\n   keys, a tie group, to the run's queue. A member's path is the\n   container's path plus :member: no index into an unordered container is\n   canonical.\"\n  [run container kind elems path]\n  (let [ctx (:ctx run)\n        keyed (mapv (fn [e]\n                      ;; One unit per member keyed, so key walks and memo lookups are charged.\n                      (work! ctx 1)\n                      [(key-walk run (elem-item kind e) (conj path :member)) e])\n                    elems)\n        groups (partition-by (comp :bytes first)\n                             (sort #(compare-bytes (:bytes (first %1)) (:bytes (first %2))) keyed))]\n    (doseq [g groups]\n      (if (= 1 (count g))\n        (enter-slot! run :V (elem-item kind (second (first g))) (conj path :member))\n        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :container container :kind kind :path path\n                                   :key (:spell (first (first g))) :complete? (:complete? (first (first g)))\n                                   :elems (mapv second g)})))))\n\n\n(defn- fixpoint!\n  \"W3: re-key the postponed groups under the current numbering, in queue\n   order; repeat while a pass numbers a cursor cell and groups remain.\"\n  [run]\n  (loop []\n    (let [before (count @(:num run)) groups @(:groups run)]\n      (reset! (:groups run) [])\n      (doseq [{:keys [container kind elems path]} groups] (unordered! run container kind elems path))\n      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n\n\n(defn- unnumbered-cells\n  [run kind e]\n  (let [num @(:num run)]\n    (set (remove #(contains? num %) (item-cells (:ctx run) :V (elem-item kind e))))))\n\n\n(defn- tie-failure\n  \"The tie test, nil when the group passes: its common key is complete, and\n   its members' unnumbered cursor cells are pairwise disjoint and occur in\n   no member of another surviving group.\"\n  [run groups g]\n  (let [own (mapv #(unnumbered-cells run (:kind g) %) (:elems g))\n        others (reduce (fn [acc h]\n                         (if (= (:id h) (:id g))\n                           acc\n                           (reduce #(into %1 (unnumbered-cells run (:kind h) %2)) acc (:elems h))))\n                       #{} groups)]\n    (cond\n      (not (:complete? g)) :incomplete-key\n      (not= (reduce + (map count own)) (count (reduce into #{} own))) :shared-within-group\n      (some (fn [cells] (some #(contains? others %) cells)) own) :shared-across-groups\n      :else nil)))\n\n\n(defn- resolve!\n  \"The postponed groups to completion: the fixpoint, then the tie test on\n   every surviving group. All pass: enter them in host order and repeat. Any\n   fails: the root walk refuses; a key walk leaves them as [:tie ...] residue.\"\n  [run]\n  (loop []\n    (fixpoint! run)\n    (let [groups @(:groups run)]\n      (when (seq groups)\n        (let [failing (filterv #(tie-failure run groups %) groups)]\n          (cond\n            (empty? failing)\n            ;; Passing groups are independent (their cursor cells are\n            ;; confined), so all are entered before the next pass.\n            (do (reset! (:groups run) [])\n                (doseq [g groups e (:elems g)]\n                  (enter-slot! run :V (elem-item (:kind g) e) (conj (:path g) :member)))\n                (recur))\n            (= :n (:tag run))\n            (reset! (:refused run)\n                    {:path (:path (first failing))\n                     :cursor-cells (vec (sort-by str (distinct (mapcat (fn [g] (mapcat #(unnumbered-cells run (:kind g) %) (:elems g)))\n                                                                       failing))))})\n            :else nil))))))\n\n\n(defn- key-walk\n  \"A member's key: the walk over the member from the enclosing walk's\n   numbering, local numbers counted on from an enclosing key walk's counter,\n   spelled under its final numbering. Memoized on the member, the numbering\n   of its cursor cells and the counter.\"\n  [run item path]\n  (let [ctx (:ctx run)\n        cells (item-cells ctx :V item)\n        num @(:num run)\n        start (if (= :u (:tag run)) @(:next run) 0)\n        memo-key [item (select-keys num cells) start]]\n    (or (get @(:memo ctx) memo-key)\n        (let [sub (new-run ctx num :u start)]\n          (work! ctx (count cells))\n          (enter-slot! sub :V item path)\n          (resolve! sub)\n          (let [spelling (spell-slot sub :V item path)\n                k {:spell spelling :bytes (key-bytes! ctx spelling) :complete? (empty? @(:groups sub))}]\n            (swap! (:memo ctx) assoc memo-key k)\n            k)))))\n\n\n(defn- spell-cell\n  [run c]\n  (let [ctx (:ctx run) [tag k] (get @(:num run) c)]\n    (case tag\n      :n [:cursor-cell [:n k]]\n      :u [:cursor-cell [:u k (get (:ranks ctx) c) (get (:counts ctx) c)]]\n      (throw (ex-info \"Spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n\n\n(defn- spell-slot\n  [run d x path]\n  (work! (:ctx run) 1)\n  (cond\n    (ref? d) (spell-node run x path)\n    (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n    (= :C d) (spell-cell run x)\n    (value-slot? d) (if (nil? x)\n                      x\n                      (case (first x)\n                        :cursor-cell (spell-cell run (second x))\n                        :row [:row (spell-node run (second x) path)]\n                        x))\n    :else x))\n\n\n(defn- spell-node\n  \"Literals and structural data as themselves (by reference), rows expanded\n   in place, keyed rows in key order, a :set or :map as the sorted vector of\n   its members' spellings with each surviving tie group as [:tie K ... K].\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (= :cursor-cells kind) [:cursor-cells]\n      (child-task? ctx n) [:child]\n      (= :task kind)\n      (into [kind] (map (fn [i d x]\n                          (if (contains? #{7 12} i)\n                            (sort-by-key! ctx #(nth % 1) (mapv #(spell-node run % (conj path i (first (:slots %)))) x))\n                            (spell-slot run d x (conj path i))))\n                        (range) ds slots))\n      (contains? keyed-structural kind)\n      (into [kind] (mapcat identity (sort-by-key! ctx first\n                                                  (mapv (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n                                                        (partition 2 slots)))))\n      (= :window kind)\n      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n      (contains? #{:set :map} kind)\n      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n            tied (filterv #(identical? n (:container %)) @(:groups run))\n            tied-elems (set (mapcat :elems tied))\n            plain (into [] (keep (fn [e]\n                                   (when-not (contains? tied-elems e)\n                                     (spell-slot run :V (elem-item kind e) (conj path :member)))))\n                        elems)\n            ties (mapv #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n        (into [kind] (sort-by-key! ctx identity (into plain ties))))\n      :else (into [kind] (map (fn [i d x] (spell-slot run d x (conj path i))) (range) ds slots)))))\n\n\n(defn- discovery-numbering\n  \"The root walk: {:numbering {source -> :yin.k/cc-n}}, or {:refused {:path\n   :cursor-cells}} when a tie group fails the tie test. The census's pair\n   count is charged first, then the depth scan runs, before anything\n   recursive. Throws the resource refusal, or a defect without\n   :yin.k/status when the numbering is not a bijection onto the census.\"\n  [task budget counter]\n  (let [budget (merge default-budget budget)\n        census (:slots (nth (:slots task) 9))]\n    (spend! counter budget :cursor-cells (quot (count census) 2))\n    (if (empty? census)\n      {:numbering {}}\n      (let [ctx {:task task :budget budget :counter counter :memo (atom {}) :cells-memo (atom {})}\n            _ (depth-scan! ctx task)\n            bodies (into {} (map vec) (partition 2 census))\n            ranks (body-ranks ctx bodies)\n            counts (let [acc (atom {})]\n                     (walk-cells ctx [:ref :task] task #(swap! acc update % (fnil inc 0)))\n                     @acc)\n            run (new-run (assoc ctx :ranks ranks :counts counts) {} :n 1)]\n        (enter-node! run task [])\n        (resolve! run)\n        (if-let [refused @(:refused run)]\n          {:refused refused}\n          (let [numbered (set (keys @(:num run))) declared (set (keys bodies))]\n            (when (or (seq @(:groups run)) (not= numbered declared))\n              (throw (ex-info \"Cursor-cell numbering is not total\"\n                              {:missing (vec (sort-by str (remove numbered declared)))\n                               :extra (vec (sort-by str (remove declared numbered)))})))\n            {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))}))))))\n\n\n(defn- unresolved!\n  [refused prefix]\n  (throw (ex-info \"Row codec refused data\"\n                  {:yin.k/status :yin.k/non-portable :yin.k/kind :unresolved-cursor-cells\n                   :yin.k/path (into prefix (:path refused)) :yin.k/cursor-cells (:cursor-cells refused)})))\n\n\n(defn canonical-numbering\n  \"Discovery-order cursor-cell numbering (design note §1): source cursor\n   cell -> :yin.k/cc-n, the n-th cursor cell the canonical walk meets.\n   Refuses :yin.k/non-portable :unresolved-cursor-cells when tied members of\n   a guest set or map cannot be proved interchangeable. A budget exhaustion\n   is a resource refusal, never a canonicality verdict. counter, when\n   supplied, is the atom the charges accumulate in.\"\n  ([task] (canonical-numbering task default-budget))\n  ([task budget] (canonical-numbering task budget (atom {})))\n  ([task budget counter]\n   (let [r (discovery-numbering task budget counter)]\n     (if-let [refused (:refused r)] (unresolved! refused []) (:numbering r)))))\n\n\n(defn- child-numberer\n  \"Numbers an install child in its own scope under budget; a refusal's path\n   is prefixed by the install's row path [12 <name> ...].\"\n  [budget]\n  (fn [child path]\n    (let [r (discovery-numbering child budget (atom {}))]\n      (if-let [refused (:refused r)] (unresolved! refused path) (:numbering r)))))\n\n\n(defn emit-numbered\n  \"Emit under a supplied numbering. Useful for canonicality probes;\n   ordinary callers use emit, which computes the canonical numbering.\n   number-child, (fn [child path] numbering), numbers install children;\n   by default canonically.\"\n  ([task numbering] (emit-numbered task numbering (child-numberer default-budget)))\n  ([task numbering number-child]\n   (let [[id rows] (emit-node task numbering {} [] number-child)]\n     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n\n\n(defn emit\n  \"Emit an abstract task as a self-contained carrier. This is a codec,\n   not lift-task: the caller supplies the complete abstract row tree.\"\n  ([task] (emit task default-budget))\n  ([task budget]\n   (let [budget (merge default-budget budget)\n         [id rows] (emit-node task (canonical-numbering task budget) {} [] (child-numberer budget))]\n     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n\n\n(defn- structural?\n  [kind d x]\n  (cond\n    (and (= :cursor-cells kind) (= :C d)) (and (keyword? x) (some? (re-matches census-key (name x))))\n    (or (ref? d) (= :C d)) (keyword? x)\n    (refs? d) (and (vector? x) (every? keyword? x))\n    (contains? #{:V :optional-V} d)\n    (or (and (= :optional-V d) (nil? x))\n        (and (vector? x) (= 2 (count x)) (contains? #{:lit :row :cursor-cell} (first x))\n             (or (= :lit (first x)) (keyword? (second x)))))\n    (= :N d) (and (code/reg? x) (<= x 4503599627370495))\n    (= :S d) (symbol? x)\n    (= :syms d) (and (vector? x) (every? symbol? x))\n    (= :A d) (some? (jing/parse-segment-address x))\n    :else true))\n\n\n(defn- literal?\n  [x]\n  (and (not (cbor/byte-payload? x))\n       (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n           (number? x)\n           (and (coll? x)\n                (every? literal? (if (map? x) (mapcat identity x) x))\n                (or (nil? (meta x)) (literal? (meta x))))\n           (try (some? (cbor/numeric-kind x))\n                (catch #?(:cljd Object :clj Throwable :cljs :default) _e false)))))\n\n\n(def value-row-kinds #{:vec :list :set :map :closure :prim :stream :reified :parked-ref})\n\n\n(defn- check-abstract!\n  [root]\n  (letfn [(literal-value\n            [x]\n            (cond\n              (map? x) [:map (into {} (map (fn [[k v]] [(literal-value k) (literal-value v)])) x)]\n              (set? x) [:set (set (map literal-value x))]\n              (sequential? x) [:seq (mapv literal-value x)]\n              :else [:literal x]))\n          (value\n            [v]\n            (case (first v)\n              :lit (literal-value (second v))\n              :cursor-cell [:identity (second v)]\n              :row (let [n (second v) ss (:slots n)]\n                     (case (:kind n)\n                       :vec [:seq (mapv value ss)]\n                       :list [:seq (mapv value ss)]\n                       :set [:set (set (map value ss))]\n                       :map [:map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))]\n                       [:row n]))))\n          (reference?\n            [v]\n            (case (first v)\n              :cursor-cell true\n              :lit false\n              :row (let [n (second v)]\n                     (if (contains? #{:vec :list :set :map} (:kind n))\n                       (boolean (some reference? (:slots n))) true))\n              false))\n          (visit\n            [n path cursor-cells reached]\n            (let [{:keys [kind slots]} n ds (descriptors kind slots)]\n              (when (contains? #{:map :set} kind)\n                (let [vs (if (= :set kind) slots (map first (partition 2 slots)))\n                      decoded (map value vs)]\n                  (when-not (= (count decoded) (count (distinct decoded))) (bad! :duplicate-key path))))\n              (when (and (contains? #{:vec :list :set :map} kind)\n                         (not (some reference? slots))) (bad! :reference-free-row path))\n              (doseq [[i d x] (map vector (range) ds slots)]\n                (let [p (conj path i)]\n                  (cond\n                    (= :C d) (do (when-not (contains? cursor-cells x) (bad! :missing-cursor-cell p)) (swap! reached conj x))\n                    (and (ref? d) (= :task (:kind x))) (check-task x p)\n                    (and (ref? d) (not= :cursor-cells (:kind x))) (visit x p cursor-cells reached)\n                    (refs? d) (doseq [[j child] (map-indexed vector x)]\n                                (visit child (conj p j) cursor-cells reached))\n                    (contains? #{:V :optional-V} d)\n                    (when x\n                      (case (first x)\n                        :lit (when-not (literal? (second x)) (bad! :literal p))\n                        :cursor-cell (do (when-not (contains? cursor-cells (second x)) (bad! :missing-cursor-cell p))\n                                         (swap! reached conj (second x)))\n                        :row (visit (second x) p cursor-cells reached)))\n                    :else nil)))))\n          (check-task\n            [task path]\n            (let [slots (:slots task) census (nth slots 9)\n                  cursor-cells (into {} (map vec) (partition 2 (:slots census))) reached (atom #{})]\n              (visit task path cursor-cells reached)\n              (when-not (= (set (keys cursor-cells)) @reached) (bad! :extra-cursor-cell (conj path 9)))))]\n    (when (= :task (:kind root)) (check-task root []))))\n\n\n(defn- decode*\n  \"Validate gate, local schema, finite reachable graph, hashes, canonical\n   form and cursor-cell numbering, then expand structural refs. No attachment.\n   Frame checks are available separately through validate-frames.\"\n  ([wire] (decode* wire default-budget))\n  ([wire budget]\n   (let [budget (merge default-budget budget) counter (atom {})\n         rs (:yin.k/rows wire)]\n     (when-not (and (= true (:yin.k/handoff wire)) (= 3 (:yin.k/version wire))\n                    (code/reg? (:yin.k/version wire)))\n       (refuse! :yin.k/profile-mismatch :version [:yin.k/version]))\n     (when-not (and (= #{:yin.k/handoff :yin.k/version :yin.k/root :yin.k/rows} (set (keys wire)))\n                    (vector? rs) (every? #(and (vector? %) (<= 2 (count %))) rs))\n       (bad! :row-shape [:yin.k/rows]))\n     (spend! counter budget :rows (count rs))\n     (spend! counter budget :bytes (count (seq (cbor/encode wire))))\n     (let [index (into {} (map (fn [r] [(first r) r])) rs)\n           root (:yin.k/root wire)]\n       (when-not (= (count rs) (count index)) (bad! :duplicate-row [:yin.k/rows]))\n       (when-not (contains? #{:task :act :tail :wait} (second (get index root))) (bad! :root [:yin.k/root]))\n       ;; Gate children before schema, with an active path (DAG sharing is legal).\n       (letfn [(gate\n                 [id active]\n                 (when (contains? active id) (bad! :cyclic [id]))\n                 (let [row (get index id) slots (when row (subvec row 2))]\n                   (when-not (and (= :task (second row)) (= 17 (count slots))\n                                  (vector? (nth slots 12)) (every? keyword? (nth slots 12)))\n                     (bad! :task-shape [id]))\n                   (when-not (= 3 (nth slots 0)) (refuse! :yin.k/profile-mismatch :version [id 0]))\n                   (when-not (= profile (nth slots 1)) (refuse! :yin.k/profile-mismatch :profile [id 1]))\n                   (doseq [install (nth slots 12)]\n                     (let [r (get index install)]\n                       (when-not (and (= :install (second r)) (= 7 (count r))) (bad! :install-shape [install]))\n                       (gate (nth r 6) (conj active id))))))]\n         (when (= :task (second (get index root))) (gate root #{})))\n       (doseq [[id kind & slots] rs]\n         (let [schema (get row-table kind) ds (descriptors kind slots)]\n           (when-not (and schema\n                          (cond\n                            (= schema :pending) (contains? pending-table (first slots))\n                            (= :pairs (first schema)) (even? (count slots))\n                            :else true)\n                          (= (count ds) (count slots))) (bad! :row-shape [id]))\n           (doseq [[i d x] (map vector (range) ds slots)]\n             (when-not (structural? kind d x) (bad! :slot-kind [id i])))))\n       (let [seen (atom #{})]\n         (letfn [(walk\n                   [id active depth]\n                   (when (> depth (:depth budget)) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n                   (when (contains? active id) (bad! :cyclic [id]))\n                   (when-not (contains? @seen id)\n                     (let [r (get index id)]\n                       (when-not r (bad! :missing-row [id]))\n                       (let [kind (second r) slots (subvec r 2)]\n                         (doseq [[i d x] (map vector (range) (descriptors kind slots) slots)]\n                           (let [targets (cond (ref? d) [x] (refs? d) x\n                                               (and (contains? #{:V :optional-V} d) (= :row (first x))) [(second x)]\n                                               :else [])]\n                             (doseq [target targets]\n                               (when (and (contains? #{:V :optional-V} d)\n                                          (not (contains? value-row-kinds (second (get index target)))))\n                                 (bad! :value-reference-kind [id i]))\n                               (when (and (or (ref? d) (refs? d))\n                                          (not (contains? (set (rest d)) (second (get index target)))))\n                                 (bad! :reference-kind [id i]))\n                               (walk target (conj active id) (inc depth))))))\n                       (swap! seen conj id))))]\n           (walk root #{} 0)\n           (when-not (= @seen (set (keys index))) (bad! :unreachable-row [:yin.k/rows]))))\n       (doseq [[id & body] rs]\n         (when-not (and (= :blake3 (:algorithm (jing/parse-segment-address id)))\n                        (= id (jing/segment-key (vec body))))\n           (refuse! :yin.k/hash-mismatch :row [id])))\n       (doseq [[id kind & slots] rs :when (= :task kind)]\n         (doseq [[address v] (nth slots 11)]\n           (when-not (= address (jing/segment-key v))\n             (refuse! :yin.k/hash-mismatch :code [id 11 address]))\n           (when (code/well-formed? v) (bad! :code [id 11 address]))))\n       (doseq [[_ kind & slots] rs\n               [d x] (map vector (descriptors kind slots) slots)]\n         (when-not (or (ref? d) (refs? d) (= :C d))\n           (check-literal-markers! (if (contains? #{:V :optional-V} d)\n                                     (when (= :lit (first x)) (second x)) x))))\n       (doseq [[id kind & slots] rs]\n         (when-not (= (vec slots) (ordered-slots kind (vec slots))) (bad! :row-order [id]))\n         (when (contains? #{:map :bindings :store :parked-table :window :cursor-cells :set} kind)\n           (let [keys (if (= kind :set) slots (map first (partition 2 slots)))]\n             (when-not (and (= (count keys) (count (distinct keys)))\n                            (= (count keys) (count (distinct (map #(bytes-key (cbor/encode %)) keys)))))\n               (bad! :duplicate-key [id])))))\n       (letfn [(expand-slot\n                 [d x]\n                 (cond (ref? d) (expand x) (refs? d) (mapv expand x)\n                       (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (expand (second x))]\n                       :else x))\n               (expand\n                 [id]\n                 (let [[_ kind & slots] (get index id)]\n                   (node kind (mapv expand-slot (descriptors kind slots) slots))))]\n         (let [task (expand root)\n               _ (check-abstract! task)\n               ;; Only the lift's tie refusal (root or child) is translated; a\n               ;; resource refusal propagates as itself.\n               canonical (if (= :task (:kind task))\n                           (try (emit task budget)\n                                (catch #?(:cljd Object :clj Throwable :cljs :default) e\n                                  (let [d (ex-data e)]\n                                    (if (and (= :yin.k/non-portable (:yin.k/status d))\n                                             (= :unresolved-cursor-cells (:yin.k/kind d)))\n                                      (throw (ex-info \"Row codec refused data\"\n                                                      (assoc d :yin.k/status :yin.k/undecodable\n                                                             :yin.k/path (into [root] (:yin.k/path d)))))\n                                      (throw e)))))\n                           (let [[id _] (emit-node task {} {})] {:yin.k/root id}))]\n           (when (and (not= false (:check-numbering budget)) (not= root (:yin.k/root canonical)))\n             (bad! :noncanonical-cursor-cells [root]))\n           (when (= :task (:kind task))\n             (when-let [d (validate-frames task)]\n               (throw (ex-info \"Frame validation failed\" (update d :yin.k/path #(into [root] %))))))\n           task))))))\n\n\n(defn decode\n  \"Validate and expand a row pack, including canonical cursor-cell numbering.\n   For task roots, run X1 and frame validation after numbering.\"\n  ([wire] (decode* wire default-budget))\n  ([wire budget] (decode* wire (dissoc budget :check-numbering))))\n\n\n(defn canonical-under\n  \"Test-only §5.5 re-emission under an explicit stream correspondence.\n   Missing marker coverage fails; neither traversal order nor original\n   cursor-cell numbering chooses a logical identity. Accepts a carrier.\"\n  [wire correspondence]\n  (let [task (decode* wire (assoc default-budget :check-numbering false))]\n    (letfn [(rewrite-slot\n              [d x]\n              (cond (ref? d) (rewrite x) (refs? d) (mapv rewrite x)\n                    (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (rewrite (second x))]\n                    :else x))\n            (rewrite\n              [n]\n              (let [{:keys [kind slots]} n]\n                (if (= :stream kind)\n                  (let [id (first slots)]\n                    (when-not (contains? correspondence id) (bad! :missing-stream-correspondence [id]))\n                    (node :stream [(get correspondence id) (get correspondence id)]))\n                  (node kind (mapv rewrite-slot (descriptors kind slots) slots)))))]\n      (emit (rewrite task)))))\n\n\n(defn- value-node\n  [x]\n  (check-literal-markers! x)\n  [:lit x])\n\n\n(defn- decoded-value\n  [v]\n  (case (first v)\n    :row {:yin.k/row (second v)}\n    :cursor-cell {:yin.k/cursor-cell (second v)}\n    :lit (if (marker-shaped? (second v)) (refuse! :yin.k/non-portable :marker []) (second v))))\n\n\n(defn- keyed-node\n  [kind m encode]\n  (node kind (mapcat (fn [[k v]] [k (encode v)]) m)))\n\n\n(defn- env-node\n  [e encode]\n  (node :env [(keyed-node :bindings (:yin.k/bindings e) encode) (:yin.k/store-of e)]))\n\n\n(defn- kframe-node\n  [f encode]\n  (node :kframe [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n                 (keyed-node :window (:yin.k/window f) encode) (:yin.k/rd f)]))\n\n\n(def pending-keys\n  {:next [:yin.k/cursor-cell]\n   :put [:yin.k/stream :yin.k/value :yin.k/op-id]\n   :ffi [:yin.k/cursor-cell :yin.k/call-id :yin.k/op]\n   :ffi-request [:yin.k/call-id :yin.k/envelope :yin.k/request-stream :yin.k/response-stream :yin.k/response-cursor-cell :yin.k/op-id]\n   :link-request [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell :yin.k/envelope :yin.k/op-id]\n   :link-response [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell]\n   :install [:yin.k/name]})\n\n\n(defn frame->rows\n  \"Encode a keyed frame to a frame-rooted version-3 row pack. Values are\n   plain literals by default. An explicit value encoder classifies portable\n   references as [:row abstract-row] or [:cursor-cell id], distinct from guest maps.\n   This reshapes; frame/defect owns semantic validity.\"\n  ([f] (frame->rows f value-node))\n  ([f encode]\n   (let [k (node :k (mapv #(kframe-node % encode) (:yin.k/k f)))\n         state (if (= :act (:yin.k/state f))\n                 (node :act [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n                             (keyed-node :window (:yin.k/window f) encode) k (get-in f [:yin.k/deliver :yin.k/rd])])\n                 (node :tail [(:yin.k/segment f) (:yin.k/site f) k]))\n         pending (:yin.k/pending f)\n         reason (:yin.k/reason pending)\n         root (if (contains? f :yin.k/pending)\n                (node :wait [state (node :pending\n                                         (into [reason]\n                                               (map (fn [key d]\n                                                      (let [x (get pending key)]\n                                                        (if (= :V d) (encode x) x)))\n                                                    (get pending-keys reason) (get pending-table reason))))])\n                state)\n         [id rows] (emit-node root {} {})]\n     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n\n\n(defn- decode-keyed\n  [n decode-value]\n  (into {} (map (fn [[k v]] [k (decode-value v)])) (partition 2 (:slots n))))\n\n\n(defn- decode-env\n  [n decode-value]\n  (let [[bindings store-of] (:slots n)]\n    (cond-> {:yin.k/bindings (decode-keyed bindings decode-value)}\n      (some? store-of) (assoc :yin.k/store-of store-of))))\n\n\n(defn- decode-kframe\n  [n decode-value]\n  (let [[seg pc e w rd] (:slots n)]\n    {:yin.k/frame-type :return :yin.k/segment seg :yin.k/pc pc\n     :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value) :yin.k/rd rd}))\n\n\n(defn- decode-frame\n  [n decode-value]\n  (if (= :wait (:kind n))\n    (let [[state pending] (:slots n) [reason & slots] (:slots pending)]\n      (assoc (decode-frame state decode-value) :yin.k/pending\n             (into {:yin.k/reason reason}\n                   (map (fn [key d x] [key (if (= :V d) (decode-value x) x)])\n                        (get pending-keys reason) (get pending-table reason) slots))))\n    (let [act? (= :act (:kind n)) [seg pc e w k rd] (:slots n)\n          k (if act? k e)]\n      (cond-> {:yin.k/state (:kind n) :yin.k/segment seg\n               :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd rd} {:yin.k/deliver :return})\n               :yin.k/k (mapv #(decode-kframe % decode-value) (:slots k))}\n        act? (assoc :yin.k/pc pc :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value))\n        (not act?) (assoc :yin.k/site pc)))))\n\n\n(defn rows->frame\n  \"Validate row syntax and hashes, then reshape to the keyed frame.\n   Semantic code/context rules remain frame/defect's responsibility.\n   The default decoder produces in-band row/cursor-cell markers that the default\n   encoder refuses. frame->rows after rows->frame is identity only when\n   both sides are given a classifier for those values.\"\n  ([wire] (rows->frame wire decoded-value))\n  ([wire decode-value] (decode-frame (decode wire) decode-value)))\n\n\n(defn validate-frames\n  \"Carrier step 7, after decode's canonical numbering. Judge each task's\n   X1 first, then waits, parked states, and all reified values. Return the\n   first defect with the abstract row path, or nil.\"\n  [task]\n  (let [slots (:slots task) code-map (nth slots 11)\n        free-env (decode-keyed (nth slots 5) decoded-value)\n        waits (nth slots 13)\n        ffi-ids (into #{} (keep (fn [w]\n                                  (let [[_ p] (:slots w) [reason & xs] (:slots p)]\n                                    (case reason :ffi (second xs) :ffi-request (first xs) nil)))) waits)\n        ctx {:free-env free-env :ffi-call-ids ffi-ids}]\n    (letfn [(judge\n              [n context context-map path]\n              (when-let [d (frame/defect (decode-frame n decoded-value) code-map context context-map)]\n                (-> d (assoc :yin.k/status :yin.k/undecodable)\n                    (update :yin.k/path #(into path %)))))\n            (captures\n              [n path]\n              (if (= :reified (:kind n))\n                (or (judge (first (:slots n)) :captured ctx path)\n                    (captures (first (:slots n)) (conj path 0)))\n                (some (fn [[i d x]]\n                        (cond\n                          (and (ref? d) (= :task (:kind x))) (validate-frames x)\n                          (ref? d) (captures x (conj path i))\n                          (refs? d) (some (fn [[j child]] (captures child (conj path i j))) (map-indexed vector x))\n                          (and (contains? #{:V :optional-V} d) (= :row (first x))) (captures (second x) (conj path i))\n                          :else nil))\n                      (map vector (range) (descriptors (:kind n) (:slots n)) (:slots n)))))]\n      (or\n        (when-let [d (frame/task-defect ctx)] (assoc d :yin.k/status :yin.k/undecodable))\n        (some (fn [[i w]] (judge w :wait ctx [:frames i])) (map-indexed vector waits))\n        (some (fn [[p state]] (judge state :parked (assoc ctx :parked-key p) [:parked p]))\n              (partition 2 (:slots (nth slots 8))))\n        (captures task [])))))\n\n\n;; =============================================================================\n;; Task transport (continuation design §7): lift-task and lower-task\n;; =============================================================================\n;;\n;; The lift walks a quiescent semantic-register machine into the abstract\n;; task the codec above emits: waits, parked records, the store, module\n;; stores, the free environment, the result and install children, every\n;; value classified as [:lit x], [:row n] or [:cursor-cell source]. A\n;; cursor cell's source is the resource id of a cursor reference, or\n;; [response-resource position] for a link wait's kept response cursor,\n;; so one resource reached twice is one cursor cell. The lower decodes the\n;; carrier (gate to frames, §3.3), checks pendings, dependencies and\n;; custody for every task of the tree, and only then attaches streams and","numLines":1141,"startLine":1,"totalLines":1855,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_01SBafUK74T9Ufnvy893AwMJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CfyvcyQmh9jNivjjDn8Mh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SRSyKj16dtK3e9enWafaJa","name":"Read","input":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7plan/src/cljc/yin/vm/ucf/holder/export.cljc"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":49129,"cache_read_input_tokens":74976,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":49129},"output_tokens":5,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"23e67cb0-f183-4c2e-b3d6-2e5b6c44b814","uuid":"675ffa14-af41-4ef4-b7cb-e32e0e4671db","timestamp":"2026-10-13T08:32:01.068Z","request_id":"req_011Cfyvcx5tqx3NaBKfVz47o","wire_tool_inputs":{"toolu_01SRSyKj16dtK3e9enWafaJa":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7plan/src/cljc/yin/vm/ucf/holder/export.cljc"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SRSyKj16dtK3e9enWafaJa","type":"tool_result","content":"1\t(ns yin.vm.ucf.holder.export\n2\t  \"The exporting state of M-next D slice D8 (UCF 7.7.4; r3 1.8 and 1.9):\n3\t   the holder side of a lift, over a machine value and data.\n4\t\n5\t   `enter` is the one-step transition into exporting: it sets\n6\t   `:yin.k/gate :exporting` on the root, requires an empty ready queue,\n7\t   and moves the wait set and the reachable parked records into an\n8\t   export record.  The machine then has nothing to poll, resume or\n9\t   advance, and the gate refuses what remains.  It refuses, as\n10\t   `:yin.k/non-portable` of kind `:reason-mismatch`, a task that holds\n11\t   (root or any install child) an `:observe` entry, any entry or cell\n12\t   carrying `:yin.k/held`, an unminted cursor cell, a pending close, or\n13\t   a `:link-request` entry whose response cursor is not installed.\n14\t\n15\t   `prepare` and `encode` are the split of r3 1.8.  Prepare calls the\n16\t   exporter's `serve!` once per stream (recursively for install\n17\t   children) and stores every answer in the record; `encode` is a pure\n18\t   function of that record: it allocates and publishes nothing, and the\n19\t   same record gives the same canonical bytes.\n20\t\n21\t   `abort` returns the record to the machine only when the offer\n22\t   cannot have been admitted (7.7.4, r3 1.9).\n23\t\n24\t   Nothing here knows a transport, a driver or a journal.\"\n25\t  (:require [yin.vm :as vm]\n26\t            [dao.jing :as jing]\n27\t            [dao.jing.cbor :as cbor]\n28\t            [yin.vm.ucf.handoff :as handoff]))\n29\t\n30\t\n31\t;; =============================================================================\n32\t;; Refusal data\n33\t;; =============================================================================\n34\t\n35\t(defn- non-portable\n36\t  [data]\n37\t  (assoc data\n38\t         :yin.k/status :yin.k/non-portable\n39\t         :yin.k/kind :reason-mismatch))\n40\t\n41\t\n42\t(defn- refused\n43\t  [reason]\n44\t  {:yin.k/status :yin.k/refused :yin.k/reason reason})\n45\t\n46\t\n47\t;; =============================================================================\n48\t;; The tree of machines: the root and every install child\n49\t;; =============================================================================\n50\t\n51\t(defn- machines\n52\t  \"`[path machine]` of `vm` and, recursively, each install child, in\n53\t   install-name order of the map's own iteration.\"\n54\t  [path vm]\n55\t  (cons [path vm]\n56\t        (mapcat (fn [[m inst]]\n57\t                  (when (map? (:vm inst))\n58\t                    (machines (conj path m) (:vm inst))))\n59\t                (:installs vm))))\n60\t\n61\t\n62\t(defn- held-entry?\n63\t  [x]\n64\t  (and (map? x) (contains? x :yin.k/held)))\n65\t\n66\t\n67\t(defn- refusal-at\n68\t  \"The first thing machine `m` holds that has no wire form, as the\n69\t   data the refusal carries, or nil.\"\n70\t  [m]\n71\t  (let [waits (:wait-set m)\n72\t        cells (filter map? (vals (:resources m)))]\n73\t    (cond\n74\t      (some #(= :observe (:reason %)) waits)\n75\t      {:yin.k/hold :observe}\n76\t\n77\t      (or (some held-entry? waits) (some held-entry? cells))\n78\t      {:yin.k/hold :held}\n79\t\n80\t      (some :yin.k/unminted cells)\n81\t      {:yin.k/hold :unminted-cursor}\n82\t\n83\t      (seq (:yin.k/closes m))\n84\t      {:yin.k/hold :pending-close}\n85\t\n86\t      (some #(and (= :link-request (:reason %)) (not (contains? % :cursor)))\n87\t            waits)\n88\t      {:yin.k/hold :link-cursor-not-installed})))\n89\t\n90\t\n91\t(defn- first-refusal\n92\t  [vm]\n93\t  (some (fn [[path m]]\n94\t          (when (seq (:ready-queue m))\n95\t            {:yin.k/status :yin.k/not-quiescent\n96\t             :yin.k/path path\n97\t             :yin.k/ready (count (:ready-queue m))}))\n98\t        (machines [] vm)))\n99\t\n100\t\n101\t;; =============================================================================\n102\t;; Entering exporting\n103\t;; =============================================================================\n104\t\n105\t(defn- reachable-parked\n106\t  \"The ids of the parked records the lift would carry, by the same\n107\t   census the lift runs (`handoff/reachable-parked`); a walk refusal\n108\t   answers data.\"\n109\t  [vm]\n110\t  (let [r (handoff/reachable-parked vm)]\n111\t    (if (contains? r :refusal)\n112\t      {::refusal (:refusal r)}\n113\t      {::ids (:ids r)})))\n114\t\n115\t\n116\t(declare enter*)\n117\t\n118\t\n119\t(defn enter\n120\t  \"Enter exporting from `machine`.  Answers\n121\t   `{:status :ok :machine m :record r}`: `m` is `machine` with the gate\n122\t   `:exporting`, an empty wait set and no reachable parked record, and\n123\t   `r` the export record, holding the wait set in order, the parked\n124\t   records, and the gate to return to.  Otherwise answers the data\n125\t   outcome of the first refusal, leaving `machine` as it was:\n126\t   `:yin.k/not-quiescent` for queued work in the root or a child, a\n127\t   `:yin.k/non-portable` of kind `:reason-mismatch` (naming the hold\n128\t   and the task path) or the lift's own, or `:yin.k/refused` for a\n129\t   machine that is already exporting or ended.\"\n130\t  ([machine] (enter* machine nil))\n131\t  ([machine opts] (enter* machine opts)))\n132\t\n133\t\n134\t(defn- enter*\n135\t  [machine opts]\n136\t  (cond\n137\t    (contains? #{:exporting :ended} (vm/gate-mode machine))\n138\t    (refused :not-running)\n139\t\n140\t    :else\n141\t    (or (first-refusal machine)\n142\t        (some (fn [[path m]]\n143\t                (when-some [h (refusal-at m)]\n144\t                  (non-portable (assoc h :yin.k/path path))))\n145\t              (machines [] machine))\n146\t        (let [walk (reachable-parked machine)]\n147\t          (or (::refusal walk)\n148\t              (let [ids (::ids walk)\n149\t                    parked (:parked machine)\n150\t                    taken (select-keys parked ids)]\n151\t                {:status :ok\n152\t                 :machine (-> machine\n153\t                              (assoc :yin.k/gate :exporting\n154\t                                     :wait-set [])\n155\t                              (assoc :parked (apply dissoc parked ids)))\n156\t                 :record (cond-> {:wait-set (vec (:wait-set machine))\n157\t                                  :parked taken\n158\t                                  :gate (vm/gate-mode machine)\n159\t                                  :served {}}\n160\t                           (some? (:version opts))\n161\t                           (assoc :version (:version opts)))}))))))\n162\t\n163\t\n164\t(defn- reinstated\n165\t  \"`machine`, an exporting machine, carrying `record`'s waits and\n166\t   parked records again: the value the lift reads.\"\n167\t  [machine record]\n168\t  (-> (reduce-kv (fn [restored module-name child-record]\n169\t                   (update-in restored [:installs module-name :vm]\n170\t                              reinstated child-record))\n171\t                 machine (or (:children record) {}))\n172\t      (assoc :wait-set (:wait-set record))\n173\t      (update :parked merge (:parked record))))\n174\t\n175\t\n176\t;; =============================================================================\n177\t;; Prepare, then encode\n178\t;; =============================================================================\n179\t\n180\t(defn- check-header!\n181\t  \"A header is nil (the version-0 fork lift) or a map carrying the\n182\t   arbitration, the counter and the enrolled set; anything else is a\n183\t   defect of the caller, not a refusal.  The lift judges the rest.\"\n184\t  [header]\n185\t  (when (some? header)\n186\t    (when-not (and (map? header)\n187\t                   (contains? header :yin.k/arbitration)\n188\t                   (contains? header :yin.k/next-op-seq)\n189\t                   (set? (:yin.k/enrolled header)))\n190\t      (throw (ex-info \"Prepare of a malformed header\"\n191\t                      {:yin.k/hint :malformed-header})))))\n192\t\n193\t\n194\t(defn- seeded-by-handle\n195\t  \"handle -> descriptor for every key the retained `table` already\n196\t   answers, resolved through `machine`'s own resource bindings at each\n197\t   key's task path: the alias reuse an interrupted prepare had already\n198\t   proved, reconstructed before any new key is served, so a retry never\n199\t   serves a handle the record already answers under another alias.\n200\t   Handles are never persisted; this mapping lives within the one\n201\t   call.\"\n202\t  [machine table]\n203\t  (let [at (into {} (machines [] machine))]\n204\t    (into {}\n205\t          (keep (fn [[[path id] descriptor]]\n206\t                  (when-some [h (get-in (get at path) [:resources id])]\n207\t                    [h descriptor])))\n208\t          table)))\n209\t\n210\t\n211\t(defn prepare\n212\t  \"Prepare `record`: call `serve!` once per stream of the exporting\n213\t   `machine`, install children included, and answer\n214\t   `{:status :ok :record r}` with every answer retained in `r`, or the\n215\t   data outcome of the lift's refusal with `:record` added, carrying\n216\t   what was served before the refusal so a retry never serves a stream\n217\t   twice -- not even under a resource alias the refused attempt never\n218\t   reached, whose handle the retained table and the machine's bindings\n219\t   still identify.\n220\t\n221\t   The served table is keyed by `[task-path resource-id]` and holds the\n222\t   descriptor `serve!` answered. This table is plain data, but the live\n223\t   waits can contain authentic values: `freeze` is the persistence seam.\n224\t   A handle is asked at most once, across the calls\n225\t   of one retained record, even when two resources hold it.  `header`\n226\t   is nil for the version-0 fork lift, or the version-1 custody header\n227\t   (`handoff/export-task`), kept in the record as `:header`.  Prepare\n228\t   mints nothing: the occurrence was minted by the driver before it was\n229\t   called.\"\n230\t  [machine record serve! header]\n231\t  (check-header! header)\n232\t  (let [table (atom (:served record))\n233\t        by-handle (atom (seeded-by-handle machine (:served record)))\n234\t        once (fn [k h]\n235\t               (let [t @table]\n236\t                 (cond\n237\t                   (contains? t k)\n238\t                   (let [served (get t k)]\n239\t                     ;; an alias of an already-served key asks again for\n240\t                     ;; nothing: the handle is known served from here on\n241\t                     (swap! by-handle assoc h served)\n242\t                     served)\n243\t                   (contains? @by-handle h)\n244\t                   (let [served (get @by-handle h)]\n245\t                     ;; a handle already served under another resource id\n246\t                     ;; is the one stream: no second call, and the table\n247\t                     ;; must hold this key too or the record is unprepared\n248\t                     ;; for a resource it reached\n249\t                     (swap! table assoc k served)\n250\t                     served)\n251\t                   :else\n252\t                   (let [served (serve! h)]\n253\t                     ;; a refusal is not an answer: a retry asks again\n254\t                     (when (some? served)\n255\t                       (swap! table assoc k served)\n256\t                       (swap! by-handle assoc h served))\n257\t                     served))))\n258\t        record (assoc record :header header)\n259\t        r (handoff/export-task (reinstated machine record) nil\n260\t                               (cond-> {:header header :serve-keyed once\n261\t                                        :yin.vm.ucf.handoff/recovery true}\n262\t                                 (:version record)\n263\t                                 (assoc :version (:version record))))]\n264\t    (if (= :ok (:status r))\n265\t      {:status :ok :record (assoc record :served @table)}\n266\t      (assoc r :record (assoc record :served @table)))))\n267\t\n268\t\n269\t(defn encode\n270\t  \"The lift of the prepared `record` over `machine`: the answer of\n271\t   `handoff/export-task`, from a `serve-keyed` that only reads the\n272\t   record, under the header the record retains.  It allocates and\n273\t   publishes nothing, and one record gives equal bytes every time.  A\n274\t   stream the record has no answer for is a defect of the caller (an\n275\t   unprepared record), not a refusal.\"\n276\t  [machine record]\n277\t  (let [served (:served record)]\n278\t    (handoff/export-task\n279\t      (reinstated machine record)\n280\t      nil\n281\t      (cond-> {:header (:header record)\n282\t               :serve-keyed (fn [k _h]\n283\t                              (if (contains? served k)\n284\t                                (get served k)\n285\t                                (throw (ex-info \"Encode of an unprepared record\"\n286\t                                                {:yin.k/hint\n287\t                                                 :unprepared-stream}))))}\n288\t        (:version record) (assoc :version (:version record))))))\n289\t\n290\t\n291\t(defn- recovery-address\n292\t  [bytes]\n293\t  (let [algorithm jing/default-hash-algorithm]\n294\t    (keyword \"segment\"\n295\t             (str (get-in jing/registry [algorithm :address-id]) \"-\"\n296\t                  (jing/digest-bytes algorithm bytes)))))\n297\t\n298\t\n299\t(defn- recovery-metadata\n300\t  [machine record]\n301\t  {:gate (:gate record)\n302\t   :origins (:origins machine)\n303\t   :issues (mapv :yin.k/issue (:wait-set record))\n304\t   :issued (:yin.k/issued machine)\n305\t   :children (into {}\n306\t                   (map (fn [[module-name install]]\n307\t                          [module-name\n308\t                           (recovery-metadata\n309\t                             (:vm install)\n310\t                             (or (get-in record [:children module-name])\n311\t                                 {:gate (vm/gate-mode (:vm install))\n312\t                                  :wait-set (:wait-set (:vm install))}))]))\n313\t                   (:installs machine))})\n314\t\n315\t\n316\t(defn freeze\n317\t  \"Canonical complete export recovery, distinct from the published body.\n318\t   Both returned objects must be stored durably before recording a fence.\"\n319\t  [machine prepared-record]\n320\t  (let [body (encode machine prepared-record)\n321\t        snapshot (when (= :ok (:status body))\n322\t                   (handoff/export-task\n323\t                     (reinstated machine prepared-record) nil\n324\t                     (cond-> {:header (:header prepared-record)\n325\t                              :yin.vm.ucf.handoff/recovery true\n326\t                              :serve-keyed (fn [key _handle]\n327\t                                             (get (:served prepared-record) key))}\n328\t                       (:version prepared-record)\n329\t                       (assoc :version (:version prepared-record)))))\n330\t        inspected (when (= :ok (:status snapshot))\n331\t                    (handoff/inspect-recovery-body (:bytes snapshot) (:address snapshot)\n332\t                                                   (:header prepared-record)))]\n333\t    (if (or (not= :ok (:status body)) (not= :ok (:status snapshot))\n334\t            (not= :ok (:status inspected)))\n335\t      (cond (not= :ok (:status body)) body\n336\t            (not= :ok (:status snapshot)) snapshot\n337\t            :else inspected)\n338\t      (let [recovery {:yin.k/export-recovery true\n339\t                      :yin.k/version 1\n340\t                      :yin.k/body-bytes (jing/bytes->base64 (:bytes body))\n341\t                      :yin.k/body-address (:address body)\n342\t                      :yin.k/snapshot-bytes (jing/bytes->base64 (:bytes snapshot))\n343\t                      :yin.k/snapshot-address (:address snapshot)\n344\t                      :yin.k/header (:header prepared-record)\n345\t                      :yin.k/descriptors (into #{}\n346\t                                               (map #(assoc (select-keys % [:dao.stream/identity\n347\t                                                                            :dao.stream/channel])\n348\t                                                            :dao.stream/type :dao.stream/remote))\n349\t                                               (vals (:served prepared-record)))\n350\t                      :yin.k/state (recovery-metadata machine prepared-record)}\n351\t            bytes (cbor/encode recovery)]\n352\t        {:status :ok :bytes bytes :address (recovery-address bytes)\n353\t         :body-bytes (:bytes body) :body-address (:address body)\n354\t         :kind (:kind body)}))))\n355\t\n356\t\n357\t(defn- extract-recovered\n358\t  [machine metadata version]\n359\t  (let [children (into {}\n360\t                       (map (fn [[module-name install]]\n361\t                              [module-name\n362\t                               (extract-recovered\n363\t                                 (:vm install)\n364\t                                 (get-in metadata [:children module-name])\n365\t                                 version)]))\n366\t                       (:installs machine))\n367\t        waits (mapv (fn [entry issue]\n368\t                      (cond-> entry\n369\t                        (some? issue) (assoc :yin.k/issue issue)))\n370\t                    (:yin.k/recovery-waits machine)\n371\t                    (:issues metadata))\n372\t        record {:wait-set waits :parked (:parked machine) :recovered? true\n373\t                :gate (:gate metadata) :served {}\n374\t                :children (into {} (map (fn [[module-name recovered]]\n375\t                                          [module-name (:record recovered)])) children)}\n376\t        fenced (reduce-kv (fn [parent module-name recovered]\n377\t                            (assoc-in parent [:installs module-name :vm]\n378\t                                      (:machine recovered)))\n379\t                          (-> machine\n380\t                              (dissoc :yin.k/recovery-waits :yin.k/custody)\n381\t                              (assoc :wait-set [] :parked {} :yin.k/gate :exporting\n382\t                                     :origins (:origins metadata) :yin.k/issued (:issued metadata)))\n383\t                          children)]\n384\t    {:machine fenced :record record}))\n385\t\n386\t\n387\t(defn- valid-recovery-state?\n388\t  [body state]\n389\t  (and (map? state)\n390\t       (contains? #{nil :running :exporting :ended} (:gate state))\n391\t       (vector? (:issues state))\n392\t       (= (count (:issues state)) (count (:yin.k/frames body)))\n393\t       (every? #(or (nil? %) (and (integer? %) (<= 0 %))) (:issues state))\n394\t       (or (nil? (:issued state))\n395\t           (and (integer? (:issued state)) (<= 0 (:issued state))))\n396\t       (or (nil? (:origins state))\n397\t           (and (integer? (:origins state)) (<= 0 (:origins state))))\n398\t       (map? (:children state))\n399\t       (= (set (keys (:children state))) (set (keys (:yin.k/installs body))))\n400\t       (every? (fn [[module-name install]]\n401\t                 (valid-recovery-state? (:yin.k/child install)\n402\t                                        (get-in state [:children module-name])))\n403\t               (:yin.k/installs body))))\n404\t\n405\t\n406\t(defn- snapshot-extends-body?\n407\t  [body snapshot]\n408\t  (and (= (dissoc body :yin.k/module-stores :yin.k/cells :yin.k/code\n409\t                  :yin.k/requires :yin.k/installs)\n410\t          (dissoc snapshot :yin.k/module-stores :yin.k/cells :yin.k/code\n411\t                  :yin.k/requires :yin.k/installs))\n412\t       (every? (fn [field]\n413\t                 (every? (fn [[key value]]\n414\t                           (= value (get-in snapshot [field key])))\n415\t                         (get body field)))\n416\t               [:yin.k/module-stores :yin.k/cells :yin.k/code])\n417\t       (every? (fn [field]\n418\t                 (every? #(contains? (get-in snapshot [:yin.k/requires field]) %)\n419\t                         (get-in body [:yin.k/requires field])))\n420\t               [:yin.k/segments :yin.k/cursor-profiles])\n421\t       (= (set (keys (:yin.k/installs body))) (set (keys (:yin.k/installs snapshot))))\n422\t       (every? (fn [[module-name install]]\n423\t                 (let [other (get-in snapshot [:yin.k/installs module-name])]\n424\t                   (and (= (dissoc install :yin.k/child) (dissoc other :yin.k/child))\n425\t                        (snapshot-extends-body? (:yin.k/child install) (:yin.k/child other)))))\n426\t               (:yin.k/installs body))))\n427\t\n428\t\n429\t(defn rehydrate-fenced\n430\t  \"Restore a complete recovery object into fresh receiver-owned values.\n431\t   Attachment reconstructs resources only; it must not perform program IO.\n432\t   Never restores tenure, custody, scheduler waits or a runnable gate.\"\n433\t  [receiver recovery-bytes {:keys [address attach]}]\n434\t  (try\n435\t    (let [recovery (cbor/decode recovery-bytes)]\n436\t      (cond\n437\t        (not (and (true? (:yin.k/export-recovery recovery))\n438\t                  (integer? (:yin.k/version recovery))\n439\t                  (= 1 (:yin.k/version recovery))))\n440\t        {:yin.k/status :yin.k/profile-mismatch}\n441\t\n442\t        (not (jing/segment-bytes-match? address recovery-bytes))\n443\t        {:yin.k/status :yin.k/hash-mismatch}\n444\t\n445\t        :else\n446\t        (let [body-bytes (jing/base64->bytes (:yin.k/body-bytes recovery))\n447\t              body-address (:yin.k/body-address recovery)\n448\t              snapshot-bytes (jing/base64->bytes (:yin.k/snapshot-bytes recovery))\n449\t              snapshot-address (:yin.k/snapshot-address recovery)\n450\t              published (handoff/inspect-recovery-body body-bytes body-address\n451\t                                                       (:yin.k/header recovery) false)\n452\t              inspected (handoff/inspect-recovery-body snapshot-bytes snapshot-address\n453\t                                                       (:yin.k/header recovery))\n454\t              _ (when-not (and (= :ok (:status published))\n455\t                               (= :ok (:status inspected))\n456\t                               (snapshot-extends-body? (:body published) (:body inspected))\n457\t                               (= (:descriptors inspected) (:yin.k/descriptors recovery))\n458\t                               (valid-recovery-state? (:body inspected) (:yin.k/state recovery)))\n459\t                  (throw (ex-info \"Invalid export recovery\"\n460\t                                  (or (when (:yin.k/status inspected) inspected)\n461\t                                      {:yin.k/status :yin.k/undecodable}))))\n462\t              handles (atom {})\n463\t              restored (handoff/rehydrate-fenced-body\n464\t                         receiver snapshot-bytes\n465\t                         (fn [descriptor]\n466\t                           (let [identity (:dao.stream/identity descriptor)]\n467\t                             (if (contains? @handles identity)\n468\t                               (get @handles identity)\n469\t                               (let [answer (attach descriptor)]\n470\t                                 (swap! handles assoc identity answer)\n471\t                                 answer))))\n472\t                         snapshot-address)]\n473\t          (if (not= :ok (:status restored))\n474\t            restored\n475\t            (let [version (when (= 2 (:yin.k/version (:body inspected)))\n476\t                            2)\n477\t                  {:keys [machine record]} (extract-recovered\n478\t                                             (:vm restored)\n479\t                                             (:yin.k/state recovery)\n480\t                                             version)\n481\t                  by-handle (into {}\n482\t                                  (map (fn [descriptor]\n483\t                                         [(get-in @handles [(:dao.stream/identity descriptor)\n484\t                                                            :dao.stream/handle]) descriptor]))\n485\t                                  (:yin.k/descriptors recovery))\n486\t                  prepared (prepare machine\n487\t                                    (cond-> record\n488\t                                      (some? version) (assoc :version version))\n489\t                                    by-handle (:yin.k/header recovery))\n490\t                  reproduced (when (= :ok (:status prepared))\n491\t                               (encode machine (:record prepared)))]\n492\t              (if (and (= :ok (:status reproduced))\n493\t                       (= (vec body-bytes) (vec (:bytes reproduced))))\n494\t                {:status :ok :machine machine :record (assoc (:record prepared) :recovered? true)}\n495\t                {:yin.k/status :yin.k/undecodable\n496\t                 :yin.k/reason :recovery-inconsistent}))))))\n497\t    (catch #?(:cljd Object :clj Throwable :cljs :default) failure\n498\t      (or (when (:yin.k/status (ex-data failure)) (ex-data failure))\n499\t          {:yin.k/status :yin.k/undecodable}))))\n500\t\n501\t\n502\t;; =============================================================================\n503\t;; Abort\n504\t;; =============================================================================\n505\t\n506\t(defn- not-appended?\n507\t  \"True when `outcome`, the answer of an offer attempt's append, proves\n508\t   the value was not appended.  `dao.stream`'s closed append outcome\n509\t   set is {ok full invalid-value closed refused transport-error}: the\n510\t   four refusals prove it; `ok` proves the opposite, and\n511\t   `transport-error` stays the unknown-delivery refusal, as does no\n512\t   answer.\"\n513\t  [outcome]\n514\t  (contains? #{:dao.stream/full :dao.stream/invalid-value\n515\t               :dao.stream/closed :dao.stream/refused}\n516\t             outcome))\n517\t\n518\t\n519\t(defn abort\n520\t  \"Return the exporting `machine` to local execution from `record`.\n521\t\n522\t   `attempts` is the offer-attempt history the composition persisted:\n523\t   one map per attempt whose intent was durable before the send, with\n524\t   `:append` the outcome its append answered (absent when none did).\n525\t   Abort is legal when there is no attempt, or when every attempt's\n526\t   append proves the value was not appended; anything else, including\n527\t   an authority's refusal of one attempt, leaves the source fenced.\n528\t\n529\t   A machine under custody (`:yin.k/custody`) is a holder exporting a\n530\t   successor: it may abort only with `tenure`, `{:now n :bound b :live\n531\t   true}`: `n` before `b` in one unit, and `:live` the ledger reader's\n532\t   evidence that this lease is the occurrence's active lease at its\n533\t   epoch.  A clock reading alone is not tenure.  After the lease has\n534\t   ended its old local machine is never restored.\n535\t\n536\t   Answers `{:status :ok :machine m}` or `:yin.k/refused` data with\n537\t   reason `:tenure-ended` (at or past the bound), `:tenure-unconfirmed`\n538\t   (no ledger evidence) or `:offer-possibly-accepted`.\"\n539\t  [machine record attempts tenure]\n540\t  (cond\n541\t    (:recovered? record)\n542\t    (refused :restarted)\n543\t\n544\t    (not= :exporting (vm/gate-mode machine))\n545\t    (refused :not-exporting)\n546\t\n547\t    (and (contains? machine :yin.k/custody)\n548\t         (some? (:now tenure))\n549\t         (some? (:bound tenure))\n550\t         (>= (:now tenure) (:bound tenure)))\n551\t    (refused :tenure-ended)\n552\t\n553\t    (and (contains? machine :yin.k/custody)\n554\t         (not (and (some? (:now tenure))\n555\t                   (some? (:bound tenure))\n556\t                   (true? (:live tenure)))))\n557\t    (refused :tenure-unconfirmed)\n558\t\n559\t    (not (every? (comp not-appended? :append) attempts))\n560\t    (refused :offer-possibly-accepted)\n561\t\n562\t    :else\n563\t    (let [m (reinstated machine record)\n564\t          prior (:gate record)]\n565\t      {:status :ok\n566\t       :machine (if (some? prior)\n567\t                  (assoc m :yin.k/gate prior)\n568\t                  (dissoc m :yin.k/gate))})))\n569\t"}]},"parent_tool_use_id":null,"session_id":"23e67cb0-f183-4c2e-b3d6-2e5b6c44b814","uuid":"86b5335f-88b9-4931-841f-a904419ee127","timestamp":"2026-10-13T08:32:01.826Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7plan/src/cljc/yin/vm/ucf/holder/export.cljc","content":"(ns yin.vm.ucf.holder.export\n  \"The exporting state of M-next D slice D8 (UCF 7.7.4; r3 1.8 and 1.9):\n   the holder side of a lift, over a machine value and data.\n\n   `enter` is the one-step transition into exporting: it sets\n   `:yin.k/gate :exporting` on the root, requires an empty ready queue,\n   and moves the wait set and the reachable parked records into an\n   export record.  The machine then has nothing to poll, resume or\n   advance, and the gate refuses what remains.  It refuses, as\n   `:yin.k/non-portable` of kind `:reason-mismatch`, a task that holds\n   (root or any install child) an `:observe` entry, any entry or cell\n   carrying `:yin.k/held`, an unminted cursor cell, a pending close, or\n   a `:link-request` entry whose response cursor is not installed.\n\n   `prepare` and `encode` are the split of r3 1.8.  Prepare calls the\n   exporter's `serve!` once per stream (recursively for install\n   children) and stores every answer in the record; `encode` is a pure\n   function of that record: it allocates and publishes nothing, and the\n   same record gives the same canonical bytes.\n\n   `abort` returns the record to the machine only when the offer\n   cannot have been admitted (7.7.4, r3 1.9).\n\n   Nothing here knows a transport, a driver or a journal.\"\n  (:require [yin.vm :as vm]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yin.vm.ucf.handoff :as handoff]))\n\n\n;; =============================================================================\n;; Refusal data\n;; =============================================================================\n\n(defn- non-portable\n  [data]\n  (assoc data\n         :yin.k/status :yin.k/non-portable\n         :yin.k/kind :reason-mismatch))\n\n\n(defn- refused\n  [reason]\n  {:yin.k/status :yin.k/refused :yin.k/reason reason})\n\n\n;; =============================================================================\n;; The tree of machines: the root and every install child\n;; =============================================================================\n\n(defn- machines\n  \"`[path machine]` of `vm` and, recursively, each install child, in\n   install-name order of the map's own iteration.\"\n  [path vm]\n  (cons [path vm]\n        (mapcat (fn [[m inst]]\n                  (when (map? (:vm inst))\n                    (machines (conj path m) (:vm inst))))\n                (:installs vm))))\n\n\n(defn- held-entry?\n  [x]\n  (and (map? x) (contains? x :yin.k/held)))\n\n\n(defn- refusal-at\n  \"The first thing machine `m` holds that has no wire form, as the\n   data the refusal carries, or nil.\"\n  [m]\n  (let [waits (:wait-set m)\n        cells (filter map? (vals (:resources m)))]\n    (cond\n      (some #(= :observe (:reason %)) waits)\n      {:yin.k/hold :observe}\n\n      (or (some held-entry? waits) (some held-entry? cells))\n      {:yin.k/hold :held}\n\n      (some :yin.k/unminted cells)\n      {:yin.k/hold :unminted-cursor}\n\n      (seq (:yin.k/closes m))\n      {:yin.k/hold :pending-close}\n\n      (some #(and (= :link-request (:reason %)) (not (contains? % :cursor)))\n            waits)\n      {:yin.k/hold :link-cursor-not-installed})))\n\n\n(defn- first-refusal\n  [vm]\n  (some (fn [[path m]]\n          (when (seq (:ready-queue m))\n            {:yin.k/status :yin.k/not-quiescent\n             :yin.k/path path\n             :yin.k/ready (count (:ready-queue m))}))\n        (machines [] vm)))\n\n\n;; =============================================================================\n;; Entering exporting\n;; =============================================================================\n\n(defn- reachable-parked\n  \"The ids of the parked records the lift would carry, by the same\n   census the lift runs (`handoff/reachable-parked`); a walk refusal\n   answers data.\"\n  [vm]\n  (let [r (handoff/reachable-parked vm)]\n    (if (contains? r :refusal)\n      {::refusal (:refusal r)}\n      {::ids (:ids r)})))\n\n\n(declare enter*)\n\n\n(defn enter\n  \"Enter exporting from `machine`.  Answers\n   `{:status :ok :machine m :record r}`: `m` is `machine` with the gate\n   `:exporting`, an empty wait set and no reachable parked record, and\n   `r` the export record, holding the wait set in order, the parked\n   records, and the gate to return to.  Otherwise answers the data\n   outcome of the first refusal, leaving `machine` as it was:\n   `:yin.k/not-quiescent` for queued work in the root or a child, a\n   `:yin.k/non-portable` of kind `:reason-mismatch` (naming the hold\n   and the task path) or the lift's own, or `:yin.k/refused` for a\n   machine that is already exporting or ended.\"\n  ([machine] (enter* machine nil))\n  ([machine opts] (enter* machine opts)))\n\n\n(defn- enter*\n  [machine opts]\n  (cond\n    (contains? #{:exporting :ended} (vm/gate-mode machine))\n    (refused :not-running)\n\n    :else\n    (or (first-refusal machine)\n        (some (fn [[path m]]\n                (when-some [h (refusal-at m)]\n                  (non-portable (assoc h :yin.k/path path))))\n              (machines [] machine))\n        (let [walk (reachable-parked machine)]\n          (or (::refusal walk)\n              (let [ids (::ids walk)\n                    parked (:parked machine)\n                    taken (select-keys parked ids)]\n                {:status :ok\n                 :machine (-> machine\n                              (assoc :yin.k/gate :exporting\n                                     :wait-set [])\n                              (assoc :parked (apply dissoc parked ids)))\n                 :record (cond-> {:wait-set (vec (:wait-set machine))\n                                  :parked taken\n                                  :gate (vm/gate-mode machine)\n                                  :served {}}\n                           (some? (:version opts))\n                           (assoc :version (:version opts)))}))))))\n\n\n(defn- reinstated\n  \"`machine`, an exporting machine, carrying `record`'s waits and\n   parked records again: the value the lift reads.\"\n  [machine record]\n  (-> (reduce-kv (fn [restored module-name child-record]\n                   (update-in restored [:installs module-name :vm]\n                              reinstated child-record))\n                 machine (or (:children record) {}))\n      (assoc :wait-set (:wait-set record))\n      (update :parked merge (:parked record))))\n\n\n;; =============================================================================\n;; Prepare, then encode\n;; =============================================================================\n\n(defn- check-header!\n  \"A header is nil (the version-0 fork lift) or a map carrying the\n   arbitration, the counter and the enrolled set; anything else is a\n   defect of the caller, not a refusal.  The lift judges the rest.\"\n  [header]\n  (when (some? header)\n    (when-not (and (map? header)\n                   (contains? header :yin.k/arbitration)\n                   (contains? header :yin.k/next-op-seq)\n                   (set? (:yin.k/enrolled header)))\n      (throw (ex-info \"Prepare of a malformed header\"\n                      {:yin.k/hint :malformed-header})))))\n\n\n(defn- seeded-by-handle\n  \"handle -> descriptor for every key the retained `table` already\n   answers, resolved through `machine`'s own resource bindings at each\n   key's task path: the alias reuse an interrupted prepare had already\n   proved, reconstructed before any new key is served, so a retry never\n   serves a handle the record already answers under another alias.\n   Handles are never persisted; this mapping lives within the one\n   call.\"\n  [machine table]\n  (let [at (into {} (machines [] machine))]\n    (into {}\n          (keep (fn [[[path id] descriptor]]\n                  (when-some [h (get-in (get at path) [:resources id])]\n                    [h descriptor])))\n          table)))\n\n\n(defn prepare\n  \"Prepare `record`: call `serve!` once per stream of the exporting\n   `machine`, install children included, and answer\n   `{:status :ok :record r}` with every answer retained in `r`, or the\n   data outcome of the lift's refusal with `:record` added, carrying\n   what was served before the refusal so a retry never serves a stream\n   twice -- not even under a resource alias the refused attempt never\n   reached, whose handle the retained table and the machine's bindings\n   still identify.\n\n   The served table is keyed by `[task-path resource-id]` and holds the\n   descriptor `serve!` answered. This table is plain data, but the live\n   waits can contain authentic values: `freeze` is the persistence seam.\n   A handle is asked at most once, across the calls\n   of one retained record, even when two resources hold it.  `header`\n   is nil for the version-0 fork lift, or the version-1 custody header\n   (`handoff/export-task`), kept in the record as `:header`.  Prepare\n   mints nothing: the occurrence was minted by the driver before it was\n   called.\"\n  [machine record serve! header]\n  (check-header! header)\n  (let [table (atom (:served record))\n        by-handle (atom (seeded-by-handle machine (:served record)))\n        once (fn [k h]\n               (let [t @table]\n                 (cond\n                   (contains? t k)\n                   (let [served (get t k)]\n                     ;; an alias of an already-served key asks again for\n                     ;; nothing: the handle is known served from here on\n                     (swap! by-handle assoc h served)\n                     served)\n                   (contains? @by-handle h)\n                   (let [served (get @by-handle h)]\n                     ;; a handle already served under another resource id\n                     ;; is the one stream: no second call, and the table\n                     ;; must hold this key too or the record is unprepared\n                     ;; for a resource it reached\n                     (swap! table assoc k served)\n                     served)\n                   :else\n                   (let [served (serve! h)]\n                     ;; a refusal is not an answer: a retry asks again\n                     (when (some? served)\n                       (swap! table assoc k served)\n                       (swap! by-handle assoc h served))\n                     served))))\n        record (assoc record :header header)\n        r (handoff/export-task (reinstated machine record) nil\n                               (cond-> {:header header :serve-keyed once\n                                        :yin.vm.ucf.handoff/recovery true}\n                                 (:version record)\n                                 (assoc :version (:version record))))]\n    (if (= :ok (:status r))\n      {:status :ok :record (assoc record :served @table)}\n      (assoc r :record (assoc record :served @table)))))\n\n\n(defn encode\n  \"The lift of the prepared `record` over `machine`: the answer of\n   `handoff/export-task`, from a `serve-keyed` that only reads the\n   record, under the header the record retains.  It allocates and\n   publishes nothing, and one record gives equal bytes every time.  A\n   stream the record has no answer for is a defect of the caller (an\n   unprepared record), not a refusal.\"\n  [machine record]\n  (let [served (:served record)]\n    (handoff/export-task\n      (reinstated machine record)\n      nil\n      (cond-> {:header (:header record)\n               :serve-keyed (fn [k _h]\n                              (if (contains? served k)\n                                (get served k)\n                                (throw (ex-info \"Encode of an unprepared record\"\n                                                {:yin.k/hint\n                                                 :unprepared-stream}))))}\n        (:version record) (assoc :version (:version record))))))\n\n\n(defn- recovery-address\n  [bytes]\n  (let [algorithm jing/default-hash-algorithm]\n    (keyword \"segment\"\n             (str (get-in jing/registry [algorithm :address-id]) \"-\"\n                  (jing/digest-bytes algorithm bytes)))))\n\n\n(defn- recovery-metadata\n  [machine record]\n  {:gate (:gate record)\n   :origins (:origins machine)\n   :issues (mapv :yin.k/issue (:wait-set record))\n   :issued (:yin.k/issued machine)\n   :children (into {}\n                   (map (fn [[module-name install]]\n                          [module-name\n                           (recovery-metadata\n                             (:vm install)\n                             (or (get-in record [:children module-name])\n                                 {:gate (vm/gate-mode (:vm install))\n                                  :wait-set (:wait-set (:vm install))}))]))\n                   (:installs machine))})\n\n\n(defn freeze\n  \"Canonical complete export recovery, distinct from the published body.\n   Both returned objects must be stored durably before recording a fence.\"\n  [machine prepared-record]\n  (let [body (encode machine prepared-record)\n        snapshot (when (= :ok (:status body))\n                   (handoff/export-task\n                     (reinstated machine prepared-record) nil\n                     (cond-> {:header (:header prepared-record)\n                              :yin.vm.ucf.handoff/recovery true\n                              :serve-keyed (fn [key _handle]\n                                             (get (:served prepared-record) key))}\n                       (:version prepared-record)\n                       (assoc :version (:version prepared-record)))))\n        inspected (when (= :ok (:status snapshot))\n                    (handoff/inspect-recovery-body (:bytes snapshot) (:address snapshot)\n                                                   (:header prepared-record)))]\n    (if (or (not= :ok (:status body)) (not= :ok (:status snapshot))\n            (not= :ok (:status inspected)))\n      (cond (not= :ok (:status body)) body\n            (not= :ok (:status snapshot)) snapshot\n            :else inspected)\n      (let [recovery {:yin.k/export-recovery true\n                      :yin.k/version 1\n                      :yin.k/body-bytes (jing/bytes->base64 (:bytes body))\n                      :yin.k/body-address (:address body)\n                      :yin.k/snapshot-bytes (jing/bytes->base64 (:bytes snapshot))\n                      :yin.k/snapshot-address (:address snapshot)\n                      :yin.k/header (:header prepared-record)\n                      :yin.k/descriptors (into #{}\n                                               (map #(assoc (select-keys % [:dao.stream/identity\n                                                                            :dao.stream/channel])\n                                                            :dao.stream/type :dao.stream/remote))\n                                               (vals (:served prepared-record)))\n                      :yin.k/state (recovery-metadata machine prepared-record)}\n            bytes (cbor/encode recovery)]\n        {:status :ok :bytes bytes :address (recovery-address bytes)\n         :body-bytes (:bytes body) :body-address (:address body)\n         :kind (:kind body)}))))\n\n\n(defn- extract-recovered\n  [machine metadata version]\n  (let [children (into {}\n                       (map (fn [[module-name install]]\n                              [module-name\n                               (extract-recovered\n                                 (:vm install)\n                                 (get-in metadata [:children module-name])\n                                 version)]))\n                       (:installs machine))\n        waits (mapv (fn [entry issue]\n                      (cond-> entry\n                        (some? issue) (assoc :yin.k/issue issue)))\n                    (:yin.k/recovery-waits machine)\n                    (:issues metadata))\n        record {:wait-set waits :parked (:parked machine) :recovered? true\n                :gate (:gate metadata) :served {}\n                :children (into {} (map (fn [[module-name recovered]]\n                                          [module-name (:record recovered)])) children)}\n        fenced (reduce-kv (fn [parent module-name recovered]\n                            (assoc-in parent [:installs module-name :vm]\n                                      (:machine recovered)))\n                          (-> machine\n                              (dissoc :yin.k/recovery-waits :yin.k/custody)\n                              (assoc :wait-set [] :parked {} :yin.k/gate :exporting\n                                     :origins (:origins metadata) :yin.k/issued (:issued metadata)))\n                          children)]\n    {:machine fenced :record record}))\n\n\n(defn- valid-recovery-state?\n  [body state]\n  (and (map? state)\n       (contains? #{nil :running :exporting :ended} (:gate state))\n       (vector? (:issues state))\n       (= (count (:issues state)) (count (:yin.k/frames body)))\n       (every? #(or (nil? %) (and (integer? %) (<= 0 %))) (:issues state))\n       (or (nil? (:issued state))\n           (and (integer? (:issued state)) (<= 0 (:issued state))))\n       (or (nil? (:origins state))\n           (and (integer? (:origins state)) (<= 0 (:origins state))))\n       (map? (:children state))\n       (= (set (keys (:children state))) (set (keys (:yin.k/installs body))))\n       (every? (fn [[module-name install]]\n                 (valid-recovery-state? (:yin.k/child install)\n                                        (get-in state [:children module-name])))\n               (:yin.k/installs body))))\n\n\n(defn- snapshot-extends-body?\n  [body snapshot]\n  (and (= (dissoc body :yin.k/module-stores :yin.k/cells :yin.k/code\n                  :yin.k/requires :yin.k/installs)\n          (dissoc snapshot :yin.k/module-stores :yin.k/cells :yin.k/code\n                  :yin.k/requires :yin.k/installs))\n       (every? (fn [field]\n                 (every? (fn [[key value]]\n                           (= value (get-in snapshot [field key])))\n                         (get body field)))\n               [:yin.k/module-stores :yin.k/cells :yin.k/code])\n       (every? (fn [field]\n                 (every? #(contains? (get-in snapshot [:yin.k/requires field]) %)\n                         (get-in body [:yin.k/requires field])))\n               [:yin.k/segments :yin.k/cursor-profiles])\n       (= (set (keys (:yin.k/installs body))) (set (keys (:yin.k/installs snapshot))))\n       (every? (fn [[module-name install]]\n                 (let [other (get-in snapshot [:yin.k/installs module-name])]\n                   (and (= (dissoc install :yin.k/child) (dissoc other :yin.k/child))\n                        (snapshot-extends-body? (:yin.k/child install) (:yin.k/child other)))))\n               (:yin.k/installs body))))\n\n\n(defn rehydrate-fenced\n  \"Restore a complete recovery object into fresh receiver-owned values.\n   Attachment reconstructs resources only; it must not perform program IO.\n   Never restores tenure, custody, scheduler waits or a runnable gate.\"\n  [receiver recovery-bytes {:keys [address attach]}]\n  (try\n    (let [recovery (cbor/decode recovery-bytes)]\n      (cond\n        (not (and (true? (:yin.k/export-recovery recovery))\n                  (integer? (:yin.k/version recovery))\n                  (= 1 (:yin.k/version recovery))))\n        {:yin.k/status :yin.k/profile-mismatch}\n\n        (not (jing/segment-bytes-match? address recovery-bytes))\n        {:yin.k/status :yin.k/hash-mismatch}\n\n        :else\n        (let [body-bytes (jing/base64->bytes (:yin.k/body-bytes recovery))\n              body-address (:yin.k/body-address recovery)\n              snapshot-bytes (jing/base64->bytes (:yin.k/snapshot-bytes recovery))\n              snapshot-address (:yin.k/snapshot-address recovery)\n              published (handoff/inspect-recovery-body body-bytes body-address\n                                                       (:yin.k/header recovery) false)\n              inspected (handoff/inspect-recovery-body snapshot-bytes snapshot-address\n                                                       (:yin.k/header recovery))\n              _ (when-not (and (= :ok (:status published))\n                               (= :ok (:status inspected))\n                               (snapshot-extends-body? (:body published) (:body inspected))\n                               (= (:descriptors inspected) (:yin.k/descriptors recovery))\n                               (valid-recovery-state? (:body inspected) (:yin.k/state recovery)))\n                  (throw (ex-info \"Invalid export recovery\"\n                                  (or (when (:yin.k/status inspected) inspected)\n                                      {:yin.k/status :yin.k/undecodable}))))\n              handles (atom {})\n              restored (handoff/rehydrate-fenced-body\n                         receiver snapshot-bytes\n                         (fn [descriptor]\n                           (let [identity (:dao.stream/identity descriptor)]\n                             (if (contains? @handles identity)\n                               (get @handles identity)\n                               (let [answer (attach descriptor)]\n                                 (swap! handles assoc identity answer)\n                                 answer))))\n                         snapshot-address)]\n          (if (not= :ok (:status restored))\n            restored\n            (let [version (when (= 2 (:yin.k/version (:body inspected)))\n                            2)\n                  {:keys [machine record]} (extract-recovered\n                                             (:vm restored)\n                                             (:yin.k/state recovery)\n                                             version)\n                  by-handle (into {}\n                                  (map (fn [descriptor]\n                                         [(get-in @handles [(:dao.stream/identity descriptor)\n                                                            :dao.stream/handle]) descriptor]))\n                                  (:yin.k/descriptors recovery))\n                  prepared (prepare machine\n                                    (cond-> record\n                                      (some? version) (assoc :version version))\n                                    by-handle (:yin.k/header recovery))\n                  reproduced (when (= :ok (:status prepared))\n                               (encode machine (:record prepared)))]\n              (if (and (= :ok (:status reproduced))\n                       (= (vec body-bytes) (vec (:bytes reproduced))))\n                {:status :ok :machine machine :record (assoc (:record prepared) :recovered? true)}\n                {:yin.k/status :yin.k/undecodable\n                 :yin.k/reason :recovery-inconsistent}))))))\n    (catch #?(:cljd Object :clj Throwable :cljs :default) failure\n      (or (when (:yin.k/status (ex-data failure)) (ex-data failure))\n          {:yin.k/status :yin.k/undecodable}))))\n\n\n;; =============================================================================\n;; Abort\n;; =============================================================================\n\n(defn- not-appended?\n  \"True when `outcome`, the answer of an offer attempt's append, proves\n   the value was not appended.  `dao.stream`'s closed append outcome\n   set is {ok full invalid-value closed refused transport-error}: the\n   four refusals prove it; `ok` proves the opposite, and\n   `transport-error` stays the unknown-delivery refusal, as does no\n   answer.\"\n  [outcome]\n  (contains? #{:dao.stream/full :dao.stream/invalid-value\n               :dao.stream/closed :dao.stream/refused}\n             outcome))\n\n\n(defn abort\n  \"Return the exporting `machine` to local execution from `record`.\n\n   `attempts` is the offer-attempt history the composition persisted:\n   one map per attempt whose intent was durable before the send, with\n   `:append` the outcome its append answered (absent when none did).\n   Abort is legal when there is no attempt, or when every attempt's\n   append proves the value was not appended; anything else, including\n   an authority's refusal of one attempt, leaves the source fenced.\n\n   A machine under custody (`:yin.k/custody`) is a holder exporting a\n   successor: it may abort only with `tenure`, `{:now n :bound b :live\n   true}`: `n` before `b` in one unit, and `:live` the ledger reader's\n   evidence that this lease is the occurrence's active lease at its\n   epoch.  A clock reading alone is not tenure.  After the lease has\n   ended its old local machine is never restored.\n\n   Answers `{:status :ok :machine m}` or `:yin.k/refused` data with\n   reason `:tenure-ended` (at or past the bound), `:tenure-unconfirmed`\n   (no ledger evidence) or `:offer-possibly-accepted`.\"\n  [machine record attempts tenure]\n  (cond\n    (:recovered? record)\n    (refused :restarted)\n\n    (not= :exporting (vm/gate-mode machine))\n    (refused :not-exporting)\n\n    (and (contains? machine :yin.k/custody)\n         (some? (:now tenure))\n         (some? (:bound tenure))\n         (>= (:now tenure) (:bound tenure)))\n    (refused :tenure-ended)\n\n    (and (contains? machine :yin.k/custody)\n         (not (and (some? (:now tenure))\n                   (some? (:bound tenure))\n                   (true? (:live tenure)))))\n    (refused :tenure-unconfirmed)\n\n    (not (every? (comp not-appended? :append) attempts))\n    (refused :offer-possibly-accepted)\n\n    :else\n    (let [m (reinstated machine record)\n          prior (:gate record)]\n      {:status :ok\n       :machine (if (some? prior)\n                  (assoc m :yin.k/gate prior)\n                  (dissoc m :yin.k/gate))})))\n","numLines":569,"startLine":1,"totalLines":569}},"tool_result_meta":[{"id":"toolu_01SRSyKj16dtK3e9enWafaJa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
