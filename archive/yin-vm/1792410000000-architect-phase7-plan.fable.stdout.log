son {:dao.lease/lease l})\n1614\t\n1615\t      (not= :yin.k/ready (:yin.k/status E))\n1616\t      (unsatisfied state (or (:yin.k/reason E) (:yin.k/status E))\n1617\t                   {:dao.lease/lease l})\n1618\t\n1619\t      (nil? projection)\n1620\t      (unsatisfied state :fold-defect {:dao.lease/lease l})\n1621\t\n1622\t      (not (contains? (:yin.k/variants entry) (:address state)))\n1623\t      (releasing state :yin.k/not-holder\n1624\t                 {:yin.k/reason :variant-not-admitted\n1625\t                  :yin.k/address (:address state)\n1626\t                  :yin.k/admitted (:yin.k/variants entry)} l)\n1627\t\n1628\t      ;; the grant is stale and the occurrence unheld: a fresh\n1629\t      ;; proposal, for a regrant may come -- unless the occurrence can\n1630\t      ;; never be granted again, which is not-holder, as below: the\n1631\t      ;; judge refuses every proposal on such an occurrence, so a\n1632\t      ;; proposal minted here would be minted and refused each pass\n1633\t      ;; forever\n1634\t      (and stale? (nil? (:dao.lease/lease entry)))\n1635\t      (cond\n1636\t        (never-granted-again? entry)\n1637\t        (with-status state :yin.k/not-holder (occurrence-state projection o))\n1638\t        (:stopped? state) (with-status state :yin.k/ended {:cause :stopped})\n1639\t        :else\n1640\t        (propose (if (= (:dao.lease/proposal fact) (get-in state [:proposal :id]))\n1641\t                   (assoc state :proposal nil) state) projection))\n1642\t\n1643\t      ;; stale while another holds the occurrence: not the holder\n1644\t      stale?\n1645\t      (with-status state :yin.k/not-holder (occurrence-state projection o))\n1646\t\n1647\t      (nil? (:grant holder'))\n1648\t      ;; dao.lease refused to hold the raw fact: it does not read as\n1649\t      ;; this holder's grant at all\n1650\t      (releasing state :yin.k/unsatisfied\n1651\t                 {:yin.k/reason :grant-not-held :dao.lease/lease l} l)\n1652\t\n1653\t     