{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'Symbol symbol|symbol\\\\(' .clojuredart libs src/cljd lib/cljd-out/cljd/core.dart 2>/dev/null | head -12; sed -n '108,151p' src/cljc/yin/vm/engine.cljc; sed -n '900,950p' src/cljc/yin/vm/ucf/rows.cljc; rg -n ':install|:response|:manifest|store-of' src/cljc/yin/vm/ucf/rows.cljc | head -30\"","aggregated_output":"  [args]\n  (when-not (= 1 (count args))\n    (throw (ex-info \"Continuation expects exactly one argument\"\n                    {:reason :continuation-arity, :argc (count args)})))\n  (first args))\n\n\n(defn resolve-var\n  \"Look up a variable name: env -> store -> primitives -> module registry.\n\n   A reserved name (Rule R: `yin/def` is syntax, never a name) is refused\n   before env or store is consulted, so no binding, store entry, or\n   registry can give it a meaning. Every executing variable lookup of\n   every engine goes through here.\n\n   The registry is a value supplied by the composition, not a global.\"\n  [env store primitives registry name]\n  (when (vm/reserved-name? name)\n    (vm/refuse-reserved! :variable name))\n  (if-let [pair (find env name)]\n    (val pair)\n    (if-let [pair (find store name)]\n      (val pair)\n      (if-let [pair (find primitives name)]\n        (vm/primitive-function (val pair))\n        (if-let [resolved (when (namespace name)\n                            (module/resolve-module\n                              registry\n                              (symbol (str (namespace name)\n                                           \".\"\n                                           (clojure.core/name name)))))]\n          resolved\n          (fail (str \"Unable to resolve symbol: \" name \" in this context\")\n                {:symbol name}))))))\n\n\n(defn check-store-key!\n  \"Refuse a program store access whose key is a reserved name (Rule R):\n   the definition operator is never a store key.\"\n  [key]\n  (when (vm/reserved-name? key)\n    (vm/refuse-reserved! :store-key key)))\n\n\n       (doseq [[id kind & slots] rs :when (= :task kind)]\n         (doseq [[address v] (nth slots 11)]\n           (when-not (= address (jing/segment-key v))\n             (refuse! :yin.k/hash-mismatch :code [id 11 address]))\n           (when (code/well-formed? v) (bad! :code [id 11 address]))))\n       (doseq [[_ kind & slots] rs\n               [d x] (map vector (descriptors kind slots) slots)]\n         (when-not (or (ref? d) (refs? d) (= :C d))\n           (check-literal-markers! (if (contains? #{:V :optional-V} d)\n                                     (when (= :lit (first x)) (second x)) x))))\n       (doseq [[id kind & slots] rs]\n         (when-not (= (vec slots) (ordered-slots kind (vec slots))) (bad! :row-order [id]))\n         (when (contains? #{:map :bindings :store :parked-table :window :cursor-cells :set} kind)\n           (let [keys (if (= kind :set) slots (map first (partition 2 slots)))]\n             (when-not (and (= (count keys) (count (distinct keys)))\n                            (= (count keys) (count (distinct (map #(bytes-key (cbor/encode %)) keys)))))\n               (bad! :duplicate-key [id])))))\n       (letfn [(expand-slot\n                 [d x]\n                 (cond (ref? d) (expand x) (refs? d) (mapv expand x)\n                       (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (expand (second x))]\n                       :else x))\n               (expand\n                 [id]\n                 (let [[_ kind & slots] (get index id)]\n                   (node kind (mapv expand-slot (descriptors kind slots) slots))))]\n         (let [task (expand root)\n               _ (check-abstract! task)\n               ;; Only the lift's tie refusal (root or child) is translated; a\n               ;; resource refusal propagates as itself.\n               canonical (if (= :task (:kind task))\n                           (try (emit task budget)\n                                (catch #?(:cljd Object :clj Throwable :cljs :default) e\n                                  (let [d (ex-data e)]\n                                    (if (and (= :yin.k/non-portable (:yin.k/status d))\n                                             (= :unresolved-cursor-cells (:yin.k/kind d)))\n                                      (throw (ex-info \"Row codec refused data\"\n                                                      (assoc d :yin.k/status :yin.k/undecodable\n                                                             :yin.k/path (into [root] (:yin.k/path d)))))\n                                      (throw e)))))\n                           (let [[id _] (emit-node task {} {})] {:yin.k/root id}))]\n           (when (and (not= false (:check-numbering budget)) (not= root (:yin.k/root canonical)))\n             (bad! :noncanonical-cursor-cells [root]))\n           (when (= :task (:kind task))\n             (when-let [d (validate-frames task)]\n               (throw (ex-info \"Frame validation failed\" (update d :yin.k/path #(into [root] %))))))\n           task))))))\n\n\n(defn decode\n  \"Validate and expand a row pack, including canonical cursor-cell numbering.\n44:   :install [:S]})\n63:   :install [:S :D :D :D [:ref :task]]\n67:          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n188:                        (let [p (conj path (if (= :install (:kind n)) (first (:slots n)) j))\n859:                       (when-not (and (= :install (second r)) (= 7 (count r))) (bad! :install-shape [install]))\n999:  (node :env [(keyed-node :bindings (:yin.k/bindings e) encode) (:yin.k/store-of e)]))\n1015:   :install [:yin.k/name]})\n1051:  (let [[bindings store-of] (:slots n)]\n1053:      (some? store-of) (assoc :yin.k/store-of store-of))))\n1237:(defn- store-of!\n1239:  (let [store-of (engine/env-store-of e)]\n1240:    (when (some? store-of) (swap! (:acc ctx) update :stores conj store-of))\n1241:    store-of))\n1247:    (node :env [(bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n1254:                    (bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n1325:             (let [carried? (and (:response-cursor e) (:response-stream e))\n1326:                   cursor (if carried? (:response-cursor e) vm/call-out-cursor-key)\n1327:                   response (if carried? (:response-stream e) vm/call-out-stream-key)]\n1334:      (let [c (cell! ctx [(:response e) (:cursor e)] (:response e) (:cursor e))\n1335:            base [(:reason e) (:link-id e) (:name e) (stream-row! ctx (:request e)) (stream-row! ctx (:response e)) c]]\n1337:      :install (do (when-not (contains? (:installs m) (:name e))\n1339:                   (node :pending [:install (:name e)]))\n1368:                           (get-in inst [:response :manifest :yin.module/exports]))))\n1369:        (:installs m)))\n1406:      (outcome! :yin.k/non-portable :install-response {:yin.k/name mn}))\n1407:    (node :install [mn phase parent response\n1435:        installs (mapv (fn [[mn inst]] (install-node ctx mn inst opts)) (sort-by #(str (key %)) (:installs m)))\n1521:          (when (and (= :install reason) (not (contains? names n)))\n1608:                  :closure (let [[a entry params bindings store-of] ss]\n1614:                                                     (some? store-of) (assoc :yin.k/store-of store-of))\n","exit_code":0,"status":"completed"}}
