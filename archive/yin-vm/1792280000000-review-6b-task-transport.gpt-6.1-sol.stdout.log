{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"cat > /private/tmp/review-6b-mutants.py <<'PY'\nfrom pathlib import Path\nimport subprocess, shutil\np=Path('src/cljc/yin/vm/ucf/rows.cljc'); backup=Path('/private/tmp/review-6b-rows.backup'); original=backup.read_text()\nmutants=[\n('M1-attach-before-last-refusals', '(doseq [[t role] (task-tree task :root)] (check-task\"'! recv t role))'\"\\\\n     (restore-task recv task (attach-streams\"'! attach! task))'\"', '(let [handles (attach-streams\"'! attach! task)]'\"\\\\n       (doseq [[t role] (task-tree task :root)] (check-task\"'! recv t role))'\"\\\\n       (restore-task recv task handles))'),\n('M2-serve-before-safepoint-refusal', '(when (some? (:control m))\\\\n    (outcome\"'!'\"', '(when (some? (:control m))\\\\n    (when-let [h (first (vals (:resources m)))] (serve\"'! h))'\"\\\\n    (outcome\"'!'\"'),\n('M3-ignore-free-env-override', '(some? (:free-env opts)) (:free-env opts)', '(some? (:free-env opts)) (:free-env m)'),\n('M4-tail-window', ':site site :k (k-of k) :deliver {:deliver :return}', ':site site :window {} :k (k-of k) :deliver {:deliver :return}'),\n('M5-ignore-ready-queue', '(when (seq (:ready-queue m))\\\\n    (outcome\"'!'\"', '(when false\\\\n    (outcome\"'!'\"'),\n('M6-duplicate-attach', '(if (contains? acc identity)\\\\n                acc', '(if (contains? acc identity)\\\\n                (do (remote/lower-marker attach\"'! {:dao.stream/descriptor descriptor}) acc)'\"'),\n('M7-child-not-restored', ':vm (restore-task spawned child handles)', ':vm spawned'),\n('M8-values-not-resealed', '(values/continuation (:owner base) (assoc (payload (first ss)) :type :reified-continuation))', '(assoc (payload (first ss)) :type :reified-continuation)'),\n('M9-closure-before-walk', '_ (discharge\"'! ctx (into #{} (mapcat scan/free-names) (vals code)) free-env)'\"', '_ nil')]\nfor name,old,new in mutants:\n    assert original.count(old)==1,(name,original.count(o