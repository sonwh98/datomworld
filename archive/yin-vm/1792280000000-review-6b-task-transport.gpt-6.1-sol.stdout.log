{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1520,1710p' src/cljc/yin/vm/ucf/rows.cljc; rg -n 'law|canonical|cases|runs|attach|correspond|deftest' test/yin/vm/semantic_register/safepoint_harness_test.cljc\"","aggregated_output":"        (let [[reason n] (:slots (second (:slots w)))]\n          (when (and (= :install reason) (not (contains? names n)))\n            (outcome! :yin.k/undecodable :incomplete-install {:yin.k/name n})))))\n    (case kind\n      :halted (when (seq waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n      :blocked (when (empty? waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n      :parked (when-not (some #(= parked-id %) (take-nth 2 (:slots parked)))\n                (outcome! :yin.k/undecodable :parked-id {}))\n      (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n    (when-not (and (map? requires) (= (set (:yin.k/segments requires)) (set (keys code))))\n      (outcome! :yin.k/undecodable :requires {}))\n    (let [trees (:yin.k/trees requires)\n          missing (into #{} (remove #(seq (get trees %))) (keys code))]\n      (when (seq missing)\n        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing}})))\n    (doseq [c (rows-of task :closure true)]\n      (when-not (contains? code (first (:slots c)))\n        (outcome! :yin.k/undecodable :segment {:yin.k/segment (first (:slots c))})))\n    (doseq [p (rows-of task :prim true)]\n      (when-not (contains? (:primitives recv) (first (:slots p)))\n        (outcome! :yin.k/unsatisfied nil {:yin.k/name (first (:slots p))})))))\n\n\n(defn- attach-streams!\n  \"Step 11: one attach per distinct stream identity of the whole tree.\"\n  [attach! task]\n  (reduce (fn [acc s]\n            (let [[identity descriptor] (:slots s)]\n              (if (contains? acc identity)\n                acc\n                (if-some [h (remote/lower-marker attach! {:dao.stream/descriptor descriptor})]\n                  (assoc acc identity h)\n                  (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})))))\n          {} (rows-of task :stream false)))\n\n\n(defn- spawn-child\n  \"A fresh install child of recv's composition (the engine's spawn\n   discipline): answers [child recv'].\"\n  [recv response mn]\n  (let [n (or (:origins recv) 0)\n        origin (keyword (str (name (or (:origin recv) :t0)) \".\" n))\n        registry (reduce (fn [r [m e]] (module/assoc-module r m (dissoc e :bindings)))\n                         (:modules recv) (module/module-entries (:modules recv)))\n        source (:secret-source recv)]\n    [(module/spawn-module recv (:value (:image response))\n                          {:modules registry :origin origin\n                           :ancestry (conj (vec (:ancestry recv)) mn)\n                           :capability-secret (when (fn? source) (source origin))})\n     (assoc recv :origins (inc n))]))\n\n\n(defn- restore-task\n  \"Step 12 for one task: code by A, fresh resource keys, values re-sealed\n   under recv, waits as engine entries, parked records, installs.\"\n  [recv task handles]\n  (let [[_ _ kind _ id-counter free-env store module-stores parked census _ code installs waits parked-id result]\n        (:slots task)\n        base (reduce (fn [r [_ v]] (module/attach-module r v))\n                     (assoc recv :code {} :code-aliases {} :program nil)\n                     (sort-by #(str (key %)) code))\n        aliases (:code-aliases base)\n        used (atom (into fixed-resource-keys (keys (:resources base))))\n        identities (sort-by str (distinct (map #(first (:slots %)) (rows-of task :stream true))))\n        stream-keys (into {} (map (fn [identity] [identity (fresh-key! used)])) identities)\n        pairs (mapv vec (partition 2 (:slots census)))\n        cell-keys (into {} (map (fn [[c _]] [c (fresh-key! used)])) pairs)\n        bodies (into {} pairs)\n        stream-key #(get stream-keys (first (:slots %)))\n        parked-index (into {} (map vec) (partition 2 (:slots parked)))\n        cache (atom {})\n        resolving (atom #{})]\n    (letfn [(value\n              [v]\n              (case (first v)\n                :lit (second v)\n                :cursor-cell (engine/issue-ref base :cursor-ref (get cell-keys (second v)))\n                :row (row (second v))))\n            (row\n              [n]\n              (let [ss (:slots n)]\n                (case (:kind n)\n                  :vec (mapv value ss)\n                  :list (apply list (map value ss))\n                  :set (into #{} (map value) ss)\n                  :map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))\n                  :prim (vm/primitive-function (get (:primitives base) (first ss)))\n                  :stream (engine/issue-ref base :stream-ref (stream-key n))\n                  :closure (let [[a entry params bindings store-of] ss]\n                             (module/lower-closure base\n                                                   (cond-> {:yin.k/binding :named\n                                                            :yin.k/format :yin.semantic-register/code\n                                                            :yin.k/segment a :yin.k/entry entry :yin.k/params params\n                                                            :yin.k/env (keyed bindings)}\n                                                     (some? store-of) (assoc :yin.k/store-of store-of))\n                                                   identity))\n                  :reified (values/continuation (:owner base) (assoc (payload (first ss)) :type :reified-continuation))\n                  :parked-ref (parked-record (first ss)))))\n            (keyed\n              [n]\n              (into {} (map (fn [[k x]] [k (value x)])) (partition 2 (:slots n))))\n            (env\n              [n]\n              (let [[b store-of] (:slots n)]\n                (cond-> (keyed b) (some? store-of) (assoc engine/store-of-key store-of))))\n            (k-of\n              [n]\n              (mapv (fn [f]\n                      (let [[a pc e w rd] (:slots f)]\n                        {:type :return :segment (get aliases a) :pc pc :env (env e) :window (keyed w) :rd rd}))\n                    (:slots n)))\n            (payload\n              [n]\n              (if (= :tail (:kind n))\n                (let [[a site k] (:slots n)]\n                  {:segment (get aliases a) :site site :k (k-of k) :deliver {:deliver :return}})\n                (let [[a pc e w k rd] (:slots n)]\n                  {:segment (get aliases a) :pc pc :env (env e) :window (keyed w) :k (k-of k)\n                   :deliver {:deliver :rd :rd rd}})))\n            (parked-record\n              [p]\n              (or (get @cache p)\n                  (do (when (contains? @resolving p)\n                        (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint :parked-cycle}))\n                      (swap! resolving conj p)\n                      (let [r (assoc (payload (get parked-index p)) :type :parked-continuation :id p)]\n                        (swap! cache assoc p r)\n                        (swap! resolving disj p)\n                        r))))\n            (cell-stream\n              [c]\n              (stream-key (first (:slots (get bodies c)))))\n            (entry\n              [w]\n              (let [[state pending] (:slots w)\n                    [reason & xs] (:slots pending)\n                    p (payload state)]\n                (case reason\n                  :next (assoc p :reason :next :stream-id (cell-stream (first xs))\n                               :cursor-ref {:type :cursor-ref :id (get cell-keys (first xs))})\n                  :ffi (let [[c call-id op] xs]\n                         (cond-> (assoc p :reason :next :stream-id (cell-stream c) :call-id call-id\n                                        :cursor-ref {:type :cursor-ref :id (get cell-keys c)})\n                           (some? op) (assoc :op op)))\n                  :put (let [[s v op-id] xs]\n                         (cond-> (assoc p :reason :put :stream-id (stream-key s) :datom (value v))\n                           (some? op-id) (assoc :op-id op-id)))\n                  :ffi-request (let [[call-id envelope req resp c op-id] xs\n                                     datom (value envelope)]\n                                 (cond-> (assoc p :reason :put :stream-id (stream-key req) :datom datom\n                                                :request-sent true :call-id call-id :op (apply2/request-op datom)\n                                                :response-cursor (get cell-keys c) :response-stream (stream-key resp))\n                                   (some? op-id) (assoc :op-id op-id)))\n                  (:link-request :link-response)\n                  (let [[link-id mn _ _ c envelope op-id] xs]\n                    (cond-> (assoc p :reason reason :link-id link-id :name mn\n                                   :request module/link-request-resource :response module/link-response-resource\n                                   :cursor (second (:slots (get bodies c))))\n                      (= :link-request reason) (assoc :envelope envelope)\n                      (some? op-id) (assoc :op-id op-id)))\n                  :install (assoc p :reason :install :name (first xs)))))]\n      (let [store' (reduce (fn [s [k v]] (engine/store-put s k (value v))) {} (partition 2 (:slots store)))\n            stores (into {} (map (fn [ms]\n                                   (let [[mid s] (:slots ms)]\n                                     [mid (into {} (map (fn [[k v]] [k (value v)])) (partition 2 (:slots s)))])))\n                         module-stores)\n            parked' (into {} (map (fn [[p _]] [p (parked-record p)])) parked-index)\n            entries (mapv entry waits)\n            link (some #(let [[reason _ _ req resp] (:slots (second (:slots %)))]\n                          (when (contains? #{:link-request :link-response} reason) [req resp]))\n                       waits)\n            [base installs'] (reduce (fn [[r acc] inst]\n                                       (let [[mn phase parent response child] (:slots inst)\n                                             [spawned r'] (spawn-child r response mn)]\n                                         [r' (assoc acc mn {:phase phase :parent parent :response response\n                                                            :vm (restore-task spawned child handles)})]))\n                                     [base {}] installs)\n            fe (keyed free-env)\n            resources (merge (:resources base)\n                             (into {} (map (fn [[identity k]] [k (get handles identity)])) stream-keys)\n                             (into {} (map (fn [[c body]]\n                                             [(get cell-keys c) {:stream-id (stream-key (first (:slots body)))\n                                                                 :cursor (second (:slots body))}]))\n                                   pairs)\n                             (when-let [[req resp] link]\n                               {module/link-request-resource (get handles (first (:slots req)))\n                                module/link-response-resource (get handles (first (:slots resp)))}))\n            machine (assoc base :store store' :module-stores stores :parked parked' :installs installs'\n                           :resources resources :env fe :free-env fe :window {} :k nil :control nil\n                           :ready-queue [] :id-counter (max (or (:id-counter base) 0) id-counter))]\n        (case kind\n10:   trace equal the reference (law 1); the relift equals the lift by root\n11:   id under rows/canonical-under (law 2); the pending's reason is the\n12:   observed wait's (law 3); every lifted frame passes the validator\n13:   (law 6). Row 20 runs once, outside the wrappers.\"\n14:  (:require [clojure.test :refer [deftest is testing]]\n156:        [ref m1] (engine/attach-resource m0 w)\n306:                 (let [[ref m] (engine/attach-resource m ring) [id m] (engine/gensym m \"cursor\")]\n374:;; The two runs\n406:  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n412:(defn recording-attacher\n413:  \"The receiver's attach!, counting attaches and recording each\n416:  (let [base (s/attacher t) origin (atom {}) n (atom 0)]\n417:    {:attach! (fn [d]\n434:        {:keys [attach! origin]} (recording-attacher toy)\n435:        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n462:(defn laws\n469:      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n470:    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n471:    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n472:        \"law 2: lift(lower(S)) = S by root id\")\n475:        \"law 1: result and effect trace equal the reference\")\n479:(defn matrix-cases\n501:;; Acceptance 1: 89 runs\n504:(deftest ^:slow every-row-every-segment-matches-the-reference\n508:      (let [cases (matrix-cases) runs (atom 0)]\n509:        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n510:        (doseq [[n label expected build] cases]\n515:              (laws (build) ref)\n516:              (swap! runs inc))))\n517:        (is (= 89 @runs))))))\n520:(deftest bare-rows-match-the-reference\n526:        (laws (build identity) ref)))))\n538:(deftest tail-states-carry-no-window\n555:(deftest tail-states-lower-to-through-k-delivery\n559:            {:keys [recv] :as got} (laws (bare n) ref)\n566:        {:keys [recv] :as got} (laws (tail-effect-halt) ref)]\n571:(deftest install-rows-carry-the-child\n579:            recv (rows/lower-task (machine {:attach-stream (s/attacher toy)}) wire (s/attacher toy))\n588:        (is (nil? (:control lowered)) \"no initialization on lower: nothing runs\")\n594:(deftest captures\n598:        (laws (bare n) ref))))\n600:        {:keys [recv] :as got} (laws world (reference (bare 15)))\n609:(deftest free-env-shadowing\n611:        got (laws (bare 21) ref)]\n621:            {:keys [attach!]} (recording-attacher toy)\n622:            recv (rows/lower-task (machine {:attach-stream attach!}) wire attach!)]\n632:(deftest module-store-snapshot\n633:  (let [{:keys [wire recv]} (laws (bare 18) (reference (bare 18)))\n643:(deftest synthetic-tail-bookkeeping\n648:        f (dissoc (ft/canonical m entry false) :yin.k/pending)\n659:        \"T1 runs before P4\")))\n663:;; Acceptance 7: refusals, before any attachment\n687:   without canonicalizing slots: a tamper below the abstract emitter.\"\n720:  \"Lower wire into a fresh receiver: [outcome attaches].\"\n722:  (let [{:keys [attach!] n :count} (recording-attacher toy)\n723:        r (try (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n742:(defn tamper-cases\n793:(deftest refusals\n794:  (doseq [[label n kind tamper] (tamper-cases)]\n797:            [r attaches] (lowered toy (rows/emit-numbered (tamper (root-task wire)) {}))]\n799:        (is (zero? attaches) \"refused before any attachment\"))))\n800:  (testing \"a segment with no tree association (§6.1): unsatisfied, before any attachment\"\n803:          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n807:      (is (zero? attaches)))\n814:          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n817:      (is (zero? attaches))))\n821:          [r attaches] (lowered toy (replace-row wire id (conj (vec body) 0)))]\n823:      (is (= :row-shape (:yin.k/kind r)) \"the codec's structure step (2) runs before the frames step (7)\")\n824:      (is (zero? attaches))))\n837:          (let [[r attaches] (lowered toy (edit f))]\n839:            (is (zero? attaches)))))\n849:          [sref m1] (engine/attach-resource m0 (s/ring 8))\n863:(deftest first-defect-order\n875:    (let [[r attaches] (lowered toy (rows/emit-numbered tampered swapped))]\n876:      (is (= [:yin.k/undecodable :noncanonical-cursor-cells] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n877:      (is (zero? attaches)))))\n892:(deftest a-nonempty-ready-queue-is-not-quiescent\n928:(deftest a-response-cursor-shared-by-two-waiters-crosses-as-one-cursor-cell\n938:        recv (rows/lower-task (machine {:attach-stream (s/attacher toy) :call-in (s/ring 8) :call-out own-out\n940:                              wire (s/attacher toy))\n955:(deftest act-ffi-bookkeeping\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'clojure -M:test -e :slow -n yin.vm.semantic-register.safepoint-harness-test -n yin.vm.ucf.rows-test -n yin.vm.store-write-audit-test'","aggregated_output":"Loading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yin.vm.semantic-register.safepoint-harness-test\n\nTesting yin.vm.store-write-audit-test\n\nTesting yin.vm.ucf.rows-test\ncounterexample-search random values 250 states: {:numbered 248, :refused 2, :max-work 395103} failures: 0\ncounterexample-search frame-bearing 40 states: {:numbered 37, :refused 3, :max-work 125296} failures: 0\ncounterexample-search with children 20 states: {:numbered 19, :refused 1, :max-work 308801} failures: 0\ncounterexample-search incidence families 100 states: {:numbered 74, :refused 26, :max-work 421748} failures: 0\n\nRan 45 tests containing 939 assertions.\n0 failures, 0 errors.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '374,535p' test/yin/vm/semantic_register/safepoint_harness_test.cljc; sed -n '800,930p' test/yin/vm/semantic_register/safepoint_harness_test.cljc; git diff master...HEAD -- test/yin/vm/store_write_audit_test.clj; rg -n 'symbol \\\\(str m|fn\\\\?|numeric\\\\?' src/cljc/yin/vm/ucf/handoff.cljc src/cljc/dao/cbor.cljc; sed -n '1,100p' src/cljc/yin/vm/semantic_register.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '374,535p' test/yin/vm/semantic_register/safepoint_harness_test.cljc; sed -n '800,930p' test/yin/vm/semantic_register/safepoint_harness_test.cljc; git diff master...HEAD -- test/yin/vm/store_write_audit_test.clj; rg -n 'symbol \\\\(str m|fn\\\\?|numeric\\\\?' src/cljc/yin/vm/ucf/handoff.cljc src/cljc/dao/cbor.cljc; sed -n '1,100p' src/cljc/yin/vm/semantic_register.cljc\"","aggregated_output":";; The two runs\n;; =============================================================================\n\n(defn drive-local\n  [m]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n)) m (recur (vm/run m) (dec n)))))\n\n\n(defn drive-peers\n  [m peers]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n))\n      m\n      (do (run! s/serve-mirror! peers) (recur (vm/run m) (dec n))))))\n\n\n(defn satisfy\n  [world m drive]\n  (if-let [resume (:resume world)]\n    (resume m)\n    (reduce (fn [m step] (step) (drive m)) m (:steps world))))\n\n\n(defn reference\n  [world]\n  (let [done (satisfy world (:machine world) drive-local)]\n    (when-let [f (:finish world)] (f))\n    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn served\n  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n  [surfaces]\n  (let [t (s/toy) peer (s/served-peer t)]\n    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n\n\n(defn recording-attacher\n  \"The receiver's attach!, counting attaches and recording each\n   reflection's source identity.\"\n  [t]\n  (let [base (s/attacher t) origin (atom {}) n (atom 0)]\n    {:attach! (fn [d]\n                (swap! n inc)\n                (let [r (base d)]\n                  (when-let [h (:dao.stream/handle r)] (swap! origin assoc h (:dao.stream/identity d)))\n                  r))\n     :origin origin :count n}))\n\n\n(defn handed-off\n  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n   the source's streams.\"\n  [world]\n  (let [surfaces (or (:surfaces world) #{:reader})\n        {:keys [toy peer serve!]} (served surfaces)\n        wire (rows/lift-task (:machine world) serve! (lift-opts))\n        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n        receiver ((or (:receiver world) (constantly nil)))\n        {:keys [attach! origin]} (recording-attacher toy)\n        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n        again (served surfaces)\n        relift (rows/lift-task recv (:serve! again) (lift-opts))\n        corr2 (into {} (map (fn [[id e]] [id (get @origin (:handle e))])) @(:table (:peer again)))\n        done (satisfy world recv #(drive-peers % [peer]))\n        _ (s/serve-mirror! peer)]\n    (when-let [f (:finish world)] (f))\n    (when-let [f (:finish receiver)] (f))\n    {:wire wire :recv recv :relift relift :corr corr :corr2 corr2\n     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn root-task\n  [wire]\n  (rows/decode wire))\n\n\n(defn slot\n  [task i]\n  (nth (:slots task) i))\n\n\n(defn first-pending\n  [task]\n  (second (:slots (first (slot task 13)))))\n\n\n(defn laws\n  \"Laws 1, 2, 3 and 6 for one world; answers the run.\"\n  [world expected]\n  (let [{:keys [wire relift corr corr2] :as got} (handed-off world)\n        task (root-task wire)]\n    (is (= (:kind world) (slot task 2)))\n    (when (= :blocked (:kind world))\n      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n        \"law 2: lift(lower(S)) = S by root id\")\n    (is (:halted expected) \"the reference run completes\")\n    (is (= (select-keys expected [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n        \"law 1: result and effect trace equal the reference\")\n    got))\n\n\n(defn matrix-cases\n  \"22 wrapped rows x 4 segments, plus row 20 once: [row segment expected build].\"\n  []\n  (conj (into [] (mapcat (fn [[n r build]]\n                           (mapv (fn [[label wrap expected-of]]\n                                   ;; nest's own parameter is x: under :depth-3,\n                                   ;; row 21's (fn [] x) closes over the wrapper's\n                                   ;; x = 1, not the free x = 99 (§5.2 assumes 99)\n                                   (let [r (if (and (= 21 n) (= :depth-3 label)) 1 r)]\n                                     [n label (when (some? r) (expected-of r)) #(build wrap)]))\n                                 segments)))\n              rows)\n        [20 :unwrapped \"B\" tail-effect-halt]))\n\n\n(defn bare\n  [n]\n  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n    (build identity)))\n\n\n;; =============================================================================\n;; Acceptance 1: 89 runs\n;; =============================================================================\n\n(deftest ^:slow every-row-every-segment-matches-the-reference\n  (slow/guard\n    \"every-row-every-segment-matches-the-reference\"\n    (fn []\n      (let [cases (matrix-cases) runs (atom 0)]\n        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n        (doseq [[n label expected build] cases]\n          (testing (str \"row \" n \" \" (name label))\n            (let [ref (reference (build))]\n              (when (some? expected)\n                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n              (laws (build) ref)\n              (swap! runs inc))))\n        (is (= 89 @runs))))))\n\n\n(deftest bare-rows-match-the-reference\n  ;; The quick-tier slice of acceptance 1: every row once, bare.\n  (doseq [[n r build] rows]\n    (testing (str \"row \" n)\n      (let [ref (reference (build identity))]\n        (when (some? r) (is (= r (:value ref))))\n        (laws (build identity) ref)))))\n\n\n;; =============================================================================\n;; Acceptance 2-6\n;; =============================================================================\n\n(defn wait-state\n  [wire]\n  (first (:slots (first (slot (root-task wire) 13)))))\n  (testing \"a segment with no tree association (§6.1): unsatisfied, before any attachment\"\n    (let [[toy wire] (lift-bare 1)\n          task (update-at (root-task wire) [10] #(assoc % :yin.k/trees {}))\n          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n      (is (= :yin.k/unsatisfied (:yin.k/status r)) (pr-str r))\n      (is (= :incomplete (:yin.k/discovery r)))\n      (is (seq (get-in r [:yin.k/missing :yin.k/trees])))\n      (is (zero? attaches)))\n    (let [world (bare 1)\n          d (error #(rows/lift-task (:machine world) (:serve! (served #{:reader})) {:source-index {}}))]\n      (is (= [:yin.k/unsatisfied :incomplete] [(:yin.k/status d) (:yin.k/discovery d)]) \"the lift refuses it too\")))\n  (testing \"a return frame's pc moved after a tail call\"\n    (let [[toy wire] (lift-bare 6)\n          [how task] (return-site-case (root-task wire))\n          [r attaches] (lowered toy (rows/emit-numbered task {}))]\n      (is (= :after-tail-call how))\n      (is (= [:yin.k/undecodable :return-site] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n      (is (zero? attaches))))\n  (testing \"a :tail row given a fourth slot is refused at structure, before frames\"\n    (let [[toy wire] (lift-bare 6)\n          [id & body] (first (filter #(= :tail (second %)) (:yin.k/rows wire)))\n          [r attaches] (lowered toy (replace-row wire id (conj (vec body) 0)))]\n      (is (= :yin.k/undecodable (:yin.k/status r)))\n      (is (= :row-shape (:yin.k/kind r)) \"the codec's structure step (2) runs before the frames step (7)\")\n      (is (zero? attaches))))\n  (testing \"E2 over row 21 with the free environment {x 99 y 7}\"\n    (let [world (free-env-world identity {'x 99 'y 7})\n          {:keys [serve! toy]} (served #{:reader})\n          wire (rows/lift-task (:machine world) serve! (lift-opts))\n          task (root-task wire)\n          env-path (conj wait-act 2 0)\n          edit (fn [f] (rows/emit-numbered (update-at task env-path #(rebuild % (fn [ps] (f (into {} ps))))) {}))]\n      (is (= [:lit 1] (second (first (filter #(= 'x (first %)) (pairs-of (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0]))))))\n          \"the lexical x is 1 at the read\")\n      (doseq [[label f] [[\"the unshadowed y changed\" #(assoc % 'y [:lit 8])]\n                         [\"the lexical x removed\" #(dissoc % 'x)]]]\n        (testing label\n          (let [[r attaches] (lowered toy (edit f))]\n            (is (= [:yin.k/undecodable :free-env-mismatch] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n            (is (zero? attaches)))))\n      (testing \"the lexical x changed trips nothing\"\n        (let [[r] (lowered toy (edit #(assoc % 'x [:lit 98])))]\n          (is (vm/blocked? r) (pr-str r))))))\n  (testing \"lift refusals, before any stream is served\"\n    (let [counting (fn []\n                     (let [n (atom 0) {:keys [serve!]} (served #{:reader})]\n                       [(fn [h] (swap! n inc) (serve! h)) n]))\n          stepped (vm/step (load-program (machine) (s/lit 42)))\n          m0 (load-program (machine) (s/app (s/v 'stream/poll!) (s/v 'c)))\n          [sref m1] (engine/attach-resource m0 (s/ring 8))\n          [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n          held (vm/run (assoc m2 :store {'c cref} :yin.k/gate :running))]\n      (is (= [:observe] (mapv :reason (:wait-set held))))\n      (doseq [[label m status kind] [[\"not at a safepoint\" stepped :yin.k/not-at-safepoint nil]\n                                     [\"a held :observe\" held :yin.k/non-portable :reason-mismatch]]]\n        (testing label\n          (let [[serve! n] (counting)\n                d (error #(rows/lift-task m serve! (lift-opts)))]\n            (is (= status (:yin.k/status d)) (pr-str d))\n            (is (= kind (:yin.k/kind d)))\n            (is (zero? @n))))))))\n\n\n(deftest first-defect-order\n  (let [[toy wire] (lift-bare 18)\n        task (root-task wire)\n        state-path [8 1]\n        state (get-in task [:slots 8 :slots 1])\n        ;; the park's window: rd added\n        tampered (update-at task (conj state-path 3)\n                            #(rebuild % (fn [ps] (conj ps [(nth (:slots state) 5) [:lit :x]]))))\n        census (mapv first (pairs-of (slot task 9)))\n        swapped (zipmap census (reverse census))]\n    (is (= 2 (count census)))\n    (is (= :window-self (:yin.k/kind (first (lowered toy (rows/emit-numbered tampered {}))))))\n    (let [[r attaches] (lowered toy (rows/emit-numbered tampered swapped))]\n      (is (= [:yin.k/undecodable :noncanonical-cursor-cells] [(:yin.k/status r) (:yin.k/kind r)]) (pr-str r))\n      (is (zero? attaches)))))\n\n\n;; =============================================================================\n;; Acceptance 8: the two ported tests\n;; =============================================================================\n\n(defn parked-reader\n  []\n  (let [m0 (vm/run (load-program (machine) (with-stream (s/then read-op read-op))))\n        src (s/stream-of m0)]\n    (stream/append! src \"A\")\n    [(vm/run m0) src]))\n\n\n(deftest a-nonempty-ready-queue-is-not-quiescent\n  (let [[parked src] (parked-reader)\n        _ (stream/append! src \"B\")\n        woken (engine/check-wait-set parked)\n        n (atom 0)\n        {:keys [serve!]} (served #{:reader})\n        d (error #(rows/lift-task woken (fn [h] (swap! n inc) (serve! h)) (lift-opts)))]\n    (is (seq (:ready-queue woken)) \"the sweep queued the woken reader\")\n    (is (= :yin.k/not-quiescent (:yin.k/status d)) (pr-str d))\n    (is (zero? @n) \"no stream was served\")))\n\n\n(defn two-callers\n  []\n  (let [call-in (s/ring 8) call-out (s/ring 8)\n        m (vm/run (load-program (machine {:call-in call-in :call-out call-out\n                                          :call-out-cursor (vm/mint-oldest call-out :test)})\n                                (s/then (s/call-node :op/echo \"hello\") (s/call-node :op/echo \"world\"))))\n        e1 (first (:wait-set m))]\n    [(assoc m :wait-set [e1 (assoc e1 :call-id :parked-9)]) call-out (:call-id e1)]))\n\n\n(defn answer-both!\n  [call-out first-id]\n  (stream/append! call-out (apply2/success-response :parked-9 \"second\"))\n  (stream/append! call-out (apply2/success-response first-id \"first\")))\n\n\n(defn sweep\n  [m peers]\n  (loop [m (engine/check-wait-set m) n 12]\n    (if (or (zero? n) (empty? (:wait-set m)))\n      m\n      (do (run! s/serve-mirror! peers) (recur (engine/check-wait-set m) (dec n))))))\n\n\n(deftest a-response-cursor-shared-by-two-waiters-crosses-as-one-cursor-cell\n  (let [[ref-m ref-out id] (two-callers)\n        _ (answer-both! ref-out id)\ndiff --git a/test/yin/vm/store_write_audit_test.clj b/test/yin/vm/store_write_audit_test.clj\nindex 0b76f08d..d63ae214 100644\n--- a/test/yin/vm/store_write_audit_test.clj\n+++ b/test/yin/vm/store_write_audit_test.clj\n@@ -371,9 +371,15 @@\n     [\"driver-config\" :map] 1\n     [\"front-of\" :map] 1}\n    ;; the carrier's row-schema table: `:store` is the name of a wire row\n-   ;; kind (a read-only schema entry), never a VM store write\n+   ;; kind (a read-only schema entry), never a VM store write; and the\n+   ;; version-3 lower's restore (continuation design §7.2, step 12):\n+   ;; every carried key goes through store-put -- a reserved key in a\n+   ;; tampered carrier refuses -- and the checked slice lands on the\n+   ;; fresh receiver in one write, as the handoff lower does\n    \"src/cljc/yin/vm/ucf/rows.cljc\"\n-   {[\"row-table\" :map] 1}})\n+   {[\"row-table\" :map] 1\n+    [\"restore-task\" \"engine/store-put\"] 1\n+    [\"restore-task\" \"assoc\"] 1}})\n \n \n (deftest every-store-mutation-is-on-the-allowlist\nrg: src/cljc/dao/cbor.cljc: No such file or directory (os error 2)\nsrc/cljc/yin/vm/ucf/handoff.cljc:336:              (jing.cbor/numeric? x)\nsrc/cljc/yin/vm/ucf/handoff.cljc:399:              (fn? x) (encode-primitive vm x)\nsrc/cljc/yin/vm/ucf/handoff.cljc:1515:                              (and (jing.cbor/numeric? n)\nsrc/cljc/yin/vm/ucf/handoff.cljc:1997:    (and (jing.cbor/numeric? v)\nsrc/cljc/yin/vm/ucf/handoff.cljc:2006:  (and (jing.cbor/numeric? x)\nsrc/cljc/yin/vm/ucf/handoff.cljc:3039:               (jing.cbor/numeric? x) x\nsrc/cljc/yin/vm/ucf/handoff.cljc:3105:                 :capability-secret (when (fn? source) (source origin))})]\nsrc/cljc/yin/vm/ucf/handoff.cljc:3299:    (when-not (and (jing.cbor/numeric? v)\n(ns yin.vm.semantic-register\n  \"The register-shaped canonical evaluator, phase 4b (effects, continuations, FFI and module installation).\"\n  (:require [dao.jing :as jing]\n            [dao.stream.apply :as apply2]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ffi :as ffi]\n            [yin.vm.module :as module]\n            [yin.vm.telemetry :as telemetry]\n            [yin.vm.values :as values]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.semantic-register.analysis :as analysis]))\n\n\n(defrecord RegisterVM\n  [blocked?       ; boolean, true if blocked\n   bridge         ; explicit host-side FFI bridge state\n   halted?        ; boolean, true when active continuation has completed\n   k              ; continuation, a vector of frames (innermost last) or nil\n   program        ; segment id of the last loaded batch\n   control        ; {:segment id :pc n} or nil\n   env            ; persistent lexical scope map\n   free-env       ; checked initial environment, fixed for this instance\n   window         ; sparse body-local register map\n   id-counter     ; integer counter for unique IDs\n   parked         ; parked continuations map\n   primitives     ; primitive operations map\n   primitive-profiles ; portable primitive profile projection\n   primitive-canonical-names ; declared aliases for identity reverse lookup\n   modules        ; module registry value\n   make-stream    ; host-supplied stream constructor, or nil\n   call-capacity  ; declared capacity of the FFI pair\n   ready-queue    ; vector of runnable continuations\n   store          ; heap memory map\n   value          ; last computed value\n   wait-set       ; vector of continuations waiting on a transport\n   telemetry      ; telemetry config map ({:stream … :vm-id …}) or nil\n   telemetry-step ; telemetry snapshot counter\n   telemetry-t    ; telemetry transaction counter\n   telemetry-eid  ; telemetry entity-id seed, floored at datom/first-user-id\n   vm-model       ; telemetry model keyword\n   vm-id          ; telemetry instance id, minted by telemetry/install\n   code           ; {segment-id image}; built once per segment, never written\n   code-aliases   ; {address segment-id}; additive, one address one id (UCF §7.3.4)\n   gc])           ; {:since :base :threshold :pinned}: heap reclamation\n\n\n\n(defn put-registers\n  \"Materialize control, window, environment and continuation; value is exit-only.\"\n  [machine seg pc W E K]\n  (assoc machine :control (when seg {:segment seg :pc pc})\n         :window W :env E :k (when (seq K) K)\n         :halted? (and (not (:blocked? machine)) (nil? seg))))\n\n\n(defn- return-to\n  \"The one popped-frame delivery: retain exactly the saved window and write rd.\"\n  [frame value]\n  (assoc frame :window (assoc (:window frame) (:rd frame) value)))\n\n\n(defn- act-payload\n  [seg pc E W K rd facts]\n  {:segment seg :pc (inc pc) :env E\n   :window (select-keys W (analysis/saved facts (inc pc) rd))\n   :k K :deliver {:deliver :rd :rd rd}})\n\n\n(defn- entry-builders\n  [payload]\n  {:stream/put (fn [_state _effect result]\n                 (assoc payload :reason :put :stream-id (:stream-id result)))\n   :stream/next (fn [_state _effect result]\n                  (assoc payload :reason :next :cursor-ref (:cursor-ref result)\n                         :stream-id (:stream-id result)))\n   :module/require (fn [_state _effect _result] payload)})\n\n\n(defn- act-builders\n  [seg pc E W K rd facts]\n  (entry-builders (act-payload seg pc E W K rd facts)))\n\n\n(defn- tail-builders\n  [seg pc K]\n  (entry-builders {:segment seg :site pc :k K :deliver {:deliver :return}}))\n\n\n(defn- run-effect\n  [machine seg pc W E K effect builders]\n  (let [{:keys [state value blocked?]}\n        (engine/handle-effect (put-registers machine seg pc W E K) effect\n                              (when builders {:park-entry-fns builders}))]\n    (if blocked?\n      {:stop (assoc state :control nil :k nil)}\n      {:continue [state value]})))\n\n\n","exit_code":0,"status":"completed"}}
