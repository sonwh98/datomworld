or 65536 chars, body spelled by :rank : key bytes 1396 | work 78 | local runs 13 | root :segment/blake3-1b8100852bcc9076883ba6cc282f1bde2b777271ec7cdbe82e21797c33ef964d\n\n== invariance under element reversal + renaming/shuffling\n#{[X X] [Y Y]} DO: :segment/blake3-da69c679d10e5356b17cdb24909a43d7475df9114bba9c09a8f98ac1a35b971e | reversed equal: true | renamed+shuffled equal: true | decode: :ok\n{X 1, Y 1} DO: :segment/blake3-49d4478ce74e89a973c9640498342dfea85867eff1662b9656f7e6b9bcd44e93 | reversed equal: true | renamed+shuffled equal: true | decode: :ok\n#{X Y} DO: :segment/blake3-07eda35d34844aa8e1ce89f07395bd877a49e7a69bdabea55bcf22e600671494 | reversed equal: true | renamed+shuffled equal: true | decode: :ok\nreview counterexample DO: :segment/blake3-a3713a5e1d1a051d1c0aab255bdc48349993fbf21d68ba947e74fc4408c68c28 | reversed equal: true | renamed+shuffled equal: true | decode: :ok\ncodex A DO: :segment/blake3-65ba4530bd8908e734a8be4fcc594d2989c5a8a7d1017779ef8f62991df38dab | reversed equal: true | renamed+shuffled equal: true | decode: :ok\ncodex B DO: :segment/blake3-409548a71f080cae6f3f66911409370d83a5df9e928135d95c497e9b770d9328 | reversed equal: true | renamed+shuffled equal: true | decode: :ok\ncodex C DO: :segment/blake3-18b70de6d4533d5ca797464568b5dd7812ca4b2f36a1e8fb64ef823a2eb3da45 | reversed equal: true | renamed+shuffled equal: true | decode: :ok\n[#{X Y} #{X Y}] DO: :segment/blake3-92747c0f27e9c64876267b19dafa34edd359822341eca32d6067e199a926f116 | reversed equal: true | renamed+shuffled equal: true | decode: :ok\n\n== frame-bearing fixtures (act window, K frame window, environments, parked state)\nwait window x, K window y, env y, parked K window #{x y}\n  DO : {:x :yin.k/cc-2, :y :yin.k/cc-1, :test/cursor :yin.k/cc-3} | work 66 | search 0\n  DO root: :segment/blake3-0b9ef61ebd08535b10e136a6452d942fb0598ad2dd5a13665d7756fac69702b5\n  6a root: :segment/blake3-fd3513dd3f0395f50dc4dcf2f67fed45b7f80f91a20b73a013eb7249a6596ce7\n  decode: :ok\nwait window #{x y}, parked K window y (parked table, slot 8, precedes frames, slot 13)\n  DO : {:x :yin.k/cc-2, :y :yin.k/cc-1, :test/cursor :yin.k/cc-3} | work 52 | search 0\n  DO root: :segment/blake3-ff124bfc1fd2e6c2b8ce29487204b442b8c1143f71339ccab5efd6e48ccc142f\n  6a root: :segment/blake3-e155841068d17087673526c1f6913855e87068e686556ac8c062ed1b35c61544\n  decode: :ok\n\n== install children numbered by discovery order\n  parent root: :segment/blake3-9544fcd745812c04a7f6d6e3d9437501f986a206fcb69882ea0139fa51f340fd | task rows: 2 | child numbering: {:x :yin.k/cc-1, :y :yin.k/cc-2} | decode: :ok\n\n== counterexample search, D5 mode (refuse the residue)\nrandom values 2000 states: {:decode-ok 1783, :max-search 0, :max-local-runs 123, :decode-6a-limit 192, :refused-not-distinguished 11, :invariance-fail 0, :numbered 1975, :max-work 1254, :decode-fail 0, :refused-witnessed-noninterchangeable 14, :refused 25, :resource-limit 0}\nframe-bearing 200 states: {:decode-ok 175, :max-search 0, :max-local-runs 54, :decode-6a-limit 17, :refused-not-distinguished 3, :invariance-fail 0, :numbered 192, :max-work 767, :decode-fail 0, :refused-witnessed-noninterchangeable 5, :refused 8, :resource-limit 0}\nwith children 100 states: {:decode-ok 75, :max-search 0, :max-local-runs 90, :decode-6a-limit 23, :refused-not-distinguished 2, :invariance-fail 0, :numbered 98, :max-work 916, :decode-fail 0, :refused-witnessed-noninterchangeable 0, :refused 2, :resource-limit 0}\n\n== counterexample search, D6 mode (residue search)\nrandom values 2000 states: {:decode-ok 1808, :max-search 13, :max-local-runs 151, :decode-6a-limit 192, :refused-not-distinguished 0, :invariance-fail 0, :numbered 2000, :max-work 1470, :decode-fail 0, :refused-witnessed-noninterchangeable 0, :refused 0, :resource-limit 0}\nframe-bearing 200 states: {:decode-ok 183, :max-search 5, :max-local-runs 54, :decode-6a-limit 17, :refused-not-distinguished 0, :invariance-fail 0, :numbered 200, :max-work 767, :decode-fail 0, :refused-witnessed-noninterchangeable 0, :refused 0, :resource-limit 0}\nwith children 100 states: {:decode-ok 76, :max-search 4, :max-local-runs 90, :decode-6a-limit 24, :refused-not-distinguished 0, :invariance-fail 0, :numbered 100, :max-work 916, :decode-fail 0, :refused-witnessed-noninterchangeable 0, :refused 0, :resource-limit 0}\n","numLines":178,"startLine":1,"totalLines":178}},"tool_result_meta":[{"id":"toolu_015EfW7GyTtJafYn494rXWHD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PDtPkdoATsXqkQwigXcDTZ","type":"tool_result","content":"1\t(ns probe.discovery\n2\t  \"Prototype of discovery-order cursor-cell numbering (note D1-D6, round 3 of\n3\t   2026-10-12) over the 6a abstract task representation (yin.vm.ucf.rows).\n4\t   Not repo code; a scratch project under collab/.\n5\t\n6\t   Vocabulary: UCF 7.5.3. A cursor cell is the VM box the carrier serializes;\n7\t   its source id is the lift's local name; the procedure assigns :yin.k/cc-n.\n8\t\n9\t   Shape of the procedure (one algorithm, three uses):\n10\t   - a RUN traverses an item (D1), numbers cursor cells on first meeting (D2),\n11\t     keys every :set / :map element by a speculative local run and defers equal\n12\t     keys to the run's worklist (D1), re-examines the worklist to a fixpoint\n13\t     (D3), groups the surviving tied elements into components by shared\n14\t     unnumbered cursor cells, encodes every component by a local run over its\n15\t     component item and adopts the least encoding's components (D4). A\n16\t     component holding two elements of one group is refused (D5) or, with\n17\t     :residue-search, resolved by trials (D6): one local run per element of\n18\t     the duplicated group with that element entered first, the least\n19\t     spelling adopted.\n20\t   - the root run assigns [:n k], k = 1, 2, ...; a LOCAL run assigns [:u j r]\n21\t     (j from the enclosing run's local counter, r the body rank) and its\n22\t     spelling is the key. A KEY run is speculative: it never refuses, and its\n23\t     residue (ties or conflicts) is spelled [:tie K ...] in the key. A\n24\t     COMPONENT run (and a D6 trial) must be complete, else D5.\n25\t   - :work is charged per position visited or spelled and per literal byte\n26\t     copied into a spelling; :search per D6 trial; exceeding either refuses\n27\t     :yin.k/unsupported :resource-limit, never a canonicality verdict.\"\n28\t  (:require [dao.jing :as jing]\n29\t            [dao.jing.cbor :as cbor]\n30\t            [yin.vm.ucf.rows :as rows]\n31\t            [yin.vm.ucf.rows-test :as rt]\n32\t            [yin.vm.semantic-register.frame-test :as ft]))\n33\t\n34\t;; ---------------------------------------------------------------- schema\n35\t\n36\t(def synthetic-table\n37\t  \"Rows that exist only inside the procedure: a :map entry as an ordered pair,\n38\t   and a component as the ordered list of its (group-id item) pairs, where the\n39\t   item is the group's one element or a synthetic :set of its elements.\"\n40\t  {:entry [:V :V] :component [:pairs :D :V]})\n41\t\n42\t(defn descriptors [kind slots]\n43\t  (let [schema (or (get rows/row-table kind) (get synthetic-table kind))]\n44\t    (cond (= schema :pending) (into [:D] (get rows/pending-table (first slots)))\n45\t          (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n46\t          (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n47\t          :else schema)))\n48\t\n49\t(defn ref? [d] (and (vector? d) (= :ref (first d))))\n50\t(defn refs? [d] (and (vector? d) (= :refs (first d))))\n51\t(defn v? [d] (contains? #{:V :optional-V} d))\n52\t\n53\t(defn bytes-key [x] (mapv #(bit-and (int %) 255) (seq (cbor/encode x))))\n54\t\n55\t(defn compare-bytes [a b]\n56\t  (loop [i 0]\n57\t    (cond (= i (count a)) (if (= i (count b)) 0 -1)\n58\t          (= i (count b)) 1\n59\t          (= (nth a i) (nth b i)) (recur (inc i))\n60\t          :else (compare (nth a i) (nth b i)))))\n61\t\n62\t(defn by-key-bytes [f xs] (sort #(compare-bytes (f %1) (f %2)) xs))\n63\t\n64\t(def keyed-structural #{:bindings :store :parked-table})\n65\t\n66\t(defn elem-item\n67\t  \"The item an element is entered and keyed as: a :set element is its V; a\n68\t   :map entry [k v] is the synthetic ordered row [:entry k v], so that the\n69\t   alias pattern across key and value is part of the key.\"\n70\t  [kind e]\n71\t  (if (= :map kind) [:row {:kind :entry :slots (vec e)}] e))\n72\t\n73\t(defn child-task? [ctx n] (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n74\t\n75\t;; --------------------------------------------------------------- budgets\n76\t\n77\t(def default-budget\n78\t  \"6a's budget without :label-bytes; :search now counts D6 trials.\"\n79\t  (dissoc rows/default-budget :label-bytes))\n80\t\n81\t(defn- spend! [ctx category amount]\n82\t  (let [n (get (swap! (:counter ctx) update category (fnil + 0) amount) category)]\n83\t    (when (> n (get (:budget ctx) category))\n84\t      (throw (ex-info \"resource limit\"\n85\t                      {:yin.k/status :yin.k/unsupported :yin.k/kind :resource-limit :yin.k/path [category]})))))\n86\t\n87\t(defn- literal-bytes [x] (count (cbor/encode x)))\n88\t\n89\t(defn item-cells\n90\t  \"Cursor cells occurring in slot (d x); census and install children excluded.\n91\t   Memoized per procedure on the slot value.\"\n92\t  [ctx d x]\n93\t  (or (get @(:cells-memo ctx) [d x])\n94\t      (let [acc (atom #{})]\n95\t        (letfn [(slot [d x]\n96\t                  (cond (ref? d) (node x)\n97\t                        (refs? d) (run! node x)\n98\t                        (= :C d) (swap! acc conj x)\n99\t                        (v? d) (when x (case (first x)\n100\t                                         :cursor-cell (swap! acc conj (second x))\n101\t                                         :row (node (second x))\n102\t                                         nil))\n103\t                        :else nil))\n104\t                (node [n]\n105\t                  (let [{:keys [kind slots]} n]\n106\t                    (when-not (or (= :cursor-cells kind) (child-task? ctx n))\n107\t                      (dorun (map slot (descriptors kind slots) slots)))))]\n108\t          (slot d x)\n109\t          (swap! (:cells-memo ctx) assoc [d x] @acc)\n110\t          @acc))))\n111\t\n112\t(defn body-label [body]\n113\t  (let [[stream position] (:slots body)]\n114\t    [:body (into [:stream] (:slots stream)) position]))\n115\t\n116\t(defn body-ranks\n117\t  \"Cursor cell -> rank of its body label among the census's distinct body\n118\t   labels in bytewise order. Rank order equals label order, so spelling the\n119\t   rank instead of the label changes no comparison and no numbering; it keeps\n120\t   key bytes independent of the descriptor size.\"\n121\t  [bodies]\n122\t  (let [labels (into {} (map (fn [[c b]] [c (body-label b)])) bodies)\n123\t        ranks (into {} (map-indexed (fn [i l] [l i]))\n124\t                    (by-key-bytes bytes-key (distinct (vals labels))))]\n125\t    (into {} (map (fn [[c l]] [c (get ranks l)])) labels)))\n126\t\n127\t;; ------------------------------------------------------------------ runs\n128\t\n129\t(def ^:dynamic *trace* false)\n130\t\n131\t(defn- new-run [ctx num tag next first-item]\n132\t  {:ctx ctx :num (atom num) :tag tag :next (atom next) :first (atom first-item)\n133\t   :groups (atom []) :gid (atom 0) :refused (atom nil)})\n134\t\n135\t(defn- meet!\n136\t  \"D2. A cursor cell met for the first time receives the run's next number.\"\n137\t  [run c]\n138\t  (when-not (contains? @(:num run) c)\n139\t    (let [k @(:next run)]\n140\t      (swap! (:num run) assoc c [(:tag run) k])\n141\t      (swap! (:next run) inc)\n142\t      true)))\n143\t\n144\t(declare enter-node! enter-slot! unordered! local-run resolve! spell-slot spell-node)\n145\t\n146\t(defn- enter-slot! [run d x path]\n147\t  (spend! (:ctx run) :work 1)\n148\t  (cond (ref? d) (enter-node! run x path)\n149\t        (refs? d) (dorun (map-indexed (fn [i n] (enter-node! run n (conj path i))) x))\n150\t        (= :C d) (meet! run x)\n151\t        (v? d) (when x (case (first x)\n152\t                         :cursor-cell (meet! run (second x))\n153\t                         :row (enter-node! run (second x) path)\n154\t                         nil))\n155\t        :else nil))\n156\t\n157\t(defn- enter-node!\n158\t  \"D1. Canonical traversal: table order for slots; ordered repeated slots in\n159\t   order; keyed structural rows in the Jing byte order of the key; :window in\n160\t   ascending register order; installs and module stores by name; :set and\n161\t   :map by local keys with ties deferred; census and children not entered.\"\n162\t  [run n path]\n163\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n164\t    (cond\n165\t      (= :cursor-cells kind) nil\n166\t      (child-task? ctx n) nil\n167\t      (= :task kind)\n168\t      (doseq [[i d x] (map vector (range) ds slots)]\n169\t        (if (contains? #{7 12} i)\n170\t          (doseq [child (by-key-bytes #(bytes-key (first (:slots %))) x)]\n171\t            (enter-node! run child (conj path i (first (:slots child)))))\n172\t          (enter-slot! run d x (conj path i))))\n173\t      (contains? keyed-structural kind)\n174\t      (doseq [[k v] (by-key-bytes #(bytes-key (first %)) (partition 2 slots))]\n175\t        (enter-slot! run (second ds) v (conj path k)))\n176\t      (= :window kind)\n177\t      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n178\t      (= :set kind) (unordered! run :set (vec slots) path)\n179\t      (= :map kind) (unordered! run :map (mapv vec (partition 2 slots)) path)\n180\t      :else (dorun (map-indexed (fn [i [d x]] (enter-slot! run d x (conj path i))) (map vector ds slots))))))\n181\t\n182\t(defn- local-key [run item]\n183\t  (let [r (local-run run item nil)] [(bytes-key (:spell r)) (:spell r)]))\n184\t\n185\t(defn- unordered!\n186\t  \"D1 for an unordered container: key every element by a speculative local\n187\t   run under the numbering at this moment; enter singletons in key order;\n188\t   defer equal runs as one tie group (deferral order = canonical order). A D6\n189\t   trial run enters its forced element first, when its container is keyed.\"\n190\t  [run kind elems path]\n191\t  (let [f @(:first run)\n192\t        forced (when f (first (keep-indexed (fn [i e] (when (= f (elem-item kind e)) i)) elems)))]\n193\t    (when forced\n194\t      (reset! (:first run) nil)\n195\t      (enter-slot! run :V (elem-item kind (nth elems forced)) (conj path forced)))\n196\t    (let [keyed (vec (keep-indexed (fn [i e] (when (not= i forced) [(local-key run (elem-item kind e)) e i])) elems))\n197\t          groups (partition-by (comp first first) (sort #(compare-bytes (first (first %1)) (first (first %2))) keyed))]\n198\t      (when (and *trace* (= :n (:tag run)))\n199\t        (println \"  [sort]\" path \"num\" @(:num run))\n200\t        (doseq [g groups] (println \"    \" (if (= 1 (count g)) \"enter\" \"DEFER\") (mapv (fn [[[_ sp] e _]] [e sp]) g))))\n201\t      (doseq [g groups]\n202\t        (if (= 1 (count g))\n203\t          (let [[_ e i] (first g)] (enter-slot! run :V (elem-item kind e) (conj path i)))\n204\t          (swap! (:groups run) conj {:id (swap! (:gid run) inc) :kind kind :path path\n205\t                                     :key (second (first (first g))) :elems (mapv second g)}))))))\n206\t\n207\t(defn- fixpoint!\n208\t  \"D3. Re-examine every deferred group in deferral order under the current\n209\t   numbering; repeat while a round numbers a cursor cell and groups remain.\"\n210\t  [run]\n211\t  (loop []\n212\t    (let [before (count @(:num run)) groups @(:groups run)]\n213\t      (reset! (:groups run) [])\n214\t      (doseq [{:keys [kind elems path]} groups] (unordered! run kind elems path))\n215\t      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n216\t\n217\t(defn- components\n218\t  \"D4. Tied elements of all surviving groups, linked by shared unnumbered\n219\t   cursor cells (union-find). A component is :conflict when it holds two\n220\t   elements of one group; :dup-group is the least such group.\"\n221\t  [run]\n222\t  (let [num @(:num run) ctx (:ctx run)\n223\t        by-id (into {} (map (juxt :id identity)) @(:groups run))\n224\t        elems (vec (for [g @(:groups run) [i e] (map-indexed vector (:elems g))]\n225\t                     {:group (:id g) :kind (:kind g) :elem e :idx i\n226\t                      :cells (set (remove #(contains? num %) (item-cells ctx :V (elem-item (:kind g) e))))}))\n227\t        parent (atom (vec (range (count elems))))\n228\t        find (fn find [i] (let [p (@parent i)] (if (= p i) i (let [r (find p)] (swap! parent assoc i r) r))))\n229\t        union (fn [i j] (let [ri (find i) rj (find j)] (when (not= ri rj) (swap! parent assoc ri rj))))\n230\t        by-cell (reduce (fn [m [i el]] (reduce (fn [m c] (update m c (fnil conj []) i)) m (:cells el)))\n231\t                        {} (map-indexed vector elems))]\n232\t    (doseq [[_ is] by-cell] (doseq [j (rest is)] (union (first is) j)))\n233\t    (->> (group-by find (range (count elems)))\n234\t         (sort-by first)\n235\t         (mapv (fn [[_ is]]\n236\t                 (let [members (vec (sort-by (juxt :group :idx) (map elems is)))\n237\t                       dup (first (sort (keep (fn [[g c]] (when (> c 1) g)) (frequencies (map :group members)))))]\n238\t                   {:members members\n239\t                    :conflict (some? dup)\n240\t                    :dup-group dup\n241\t                    :path (:path (get by-id (or dup (:group (first members)))))\n242\t                    :cells (vec (sort (distinct (mapcat :cells members))))}))))))\n243\t\n244\t(defn- component-item\n245\t  \"[:component g₁ i₁ g₂ i₂ …] in group order; iᵢ is the group's one element\n246\t   in the component, or a synthetic :set of its elements when there are\n247\t   several (the D6 case).\"\n248\t  [comp]\n249\t  [:row {:kind :component\n250\t         :slots (vec (mapcat (fn [ms]\n251\t                               [(:group (first ms))\n252\t                                (if (= 1 (count ms))\n253\t                                  (elem-item (:kind (first ms)) (:elem (first ms)))\n254\t                                  [:row {:kind :set :slots (mapv #(elem-item (:kind %) (:elem %)) ms)}])])\n255\t                             (partition-by :group (:members comp))))}])\n256\t\n257\t(defn- component-encoding\n258\t  \"D4 for a certified component: a local run over its item, required to be\n259\t   complete. D5 for a conflicting component: refuse. D6 (:residue-search): one\n260\t   trial per element of the duplicated group, that element entered first; the\n261\t   least complete spelling is the encoding. :permissive (diagnostic only):\n262\t   a single trial with the host-first element.\"\n263\t  [run comp]\n264\t  (let [ctx (:ctx run) item (component-item comp)]\n265\t    (cond\n266\t      (not (:conflict comp)) (local-run run item nil)\n267\t      (:permissive ctx)\n268\t      (let [m (first (filter #(= (:dup-group comp) (:group %)) (:members comp)))]\n269\t        (local-run run item (elem-item (:kind m) (:elem m))))\n270\t      (:residue-search ctx)\n271\t      (let [es (filter #(= (:dup-group comp) (:group %)) (:members comp))\n272\t            trials (mapv (fn [m] (spend! ctx :search 1) (local-run run item (elem-item (:kind m) (:elem m)))) es)]\n273\t        (when (and *trace* (= :n (:tag run)))\n274\t          (doseq [t trials] (println \"  [trial]\" (:complete? t) (:spell t))))\n275\t        (or (first (remove :complete? trials))\n276\t            (first (sort-by #(bytes-key (:spell %)) compare-bytes trials))))\n277\t      :else {:complete? false\n278\t             :refused {:kind :unresolved-cursor-cells :path (:path comp) :cursor-cells (:cells comp)}})))\n279\t\n280\t(defn- adopt!\n281\t  \"D4. Enter a component by adopting its local run: its fresh cursor cells\n282\t   receive the enclosing run's next numbers in local-index order.\"\n283\t  [run comp]\n284\t  (let [fresh (->> (:num (:ce comp))\n285\t                   (remove (fn [[c _]] (contains? @(:num run) c)))\n286\t                   (sort-by (comp second val)))]\n287\t    (doseq [[c _] fresh] (meet! run c))))\n288\t\n289\t(defn- remove-elements! [run comps]\n290\t  (let [gone (set (for [c comps m (:members c)] [(:group m) (:idx m)]))]\n291\t    (swap! (:groups run)\n292\t           (fn [gs] (vec (keep (fn [g]\n293\t                                 (let [es (vec (keep-indexed (fn [i e] (when-not (gone [(:id g) i]) e)) (:elems g)))]\n294\t                                   (when (seq es) (assoc g :elems es))))\n295\t                               gs))))))\n296\t\n297\t(defn- resolve!\n298\t  \"D3-D6 to completion. Leaves :refused set (D5) with the worklist as of the\n299\t   last fixpoint, or the worklist empty.\"\n300\t  [run]\n301\t  (loop []\n302\t    (fixpoint! run)\n303\t    (when (and *trace* (= :n (:tag run)))\n304\t      (println \"  [resolve] num\" @(:num run) \"groups\" (mapv (fn [g] [(:id g) (:path g) (mapv (fn [e] (if (= :cursor-cell (first e)) (second e) e)) (:elems g))]) @(:groups run))))\n305\t    (when (seq @(:groups run))\n306\t      (let [comps (mapv #(assoc % :ce (component-encoding run %)) (components run))\n307\t            bad (seq (remove #(:complete? (:ce %)) comps))]\n308\t        (if bad\n309\t          ;; The verdict is invariant; the diagnostic names every conflicting\n310\t          ;; component's cells (sorted) and the least conflicting group's path,\n311\t          ;; so it does not depend on host order either.\n312\t          (reset! (:refused run) {:kind :unresolved-cursor-cells\n313\t                                  :path (:path (:refused (:ce (first (sort-by #(or (:dup-group %) Long/MAX_VALUE) bad)))))\n314\t                                  :cursor-cells (vec (sort (distinct (mapcat #(:cursor-cells (:refused (:ce %))) bad))))})\n315\t          (let [sorted (sort #(compare-bytes (bytes-key (:spell (:ce %1))) (bytes-key (:spell (:ce %2)))) comps)\n316\t                least (bytes-key (:spell (:ce (first sorted))))\n317\t                least-run (take-while #(= least (bytes-key (:spell (:ce %)))) sorted)]\n318\t            (when (and *trace* (= :n (:tag run)))\n319\t              (doseq [c sorted] (println \"  [component]\" (mapv (fn [m] [(:group m) (:cells m)]) (:members c)) \"CE\" (:spell (:ce c))))\n320\t              (println \"  [adopt]\" (count least-run)))\n321\t            (doseq [c least-run] (adopt! run c))\n322\t            (remove-elements! run least-run)\n323\t            (recur)))))))\n324\t\n325\t(defn- local-run\n326\t  \"A nested run on one item from the enclosing run's numbering, tag :u. Its\n327\t   result is a key: the spelling under its final numbering, surviving ties\n328\t   spelled [:tie K ...]. `first-item`, when given (D6 trial), is entered\n329\t   before its siblings. Memoized on (item, numbering restricted to the item's\n330\t   cursor cells, local counter, first-item).\"\n331\t  [run item first-item]\n332\t  (let [ctx (:ctx run)\n333\t        cells (item-cells ctx :V item)\n334\t        num @(:num run)\n335\t        start (if (= :u (:tag run)) @(:next run) 0)\n336\t        mk [item (select-keys num cells) start first-item]]\n337\t    (or (get @(:memo ctx) mk)\n338\t        (let [sub (new-run ctx num :u start first-item)]\n339\t          (enter-slot! sub :V item [])\n340\t          (resolve! sub)\n341\t          (let [spell (spell-slot sub :V item [])\n342\t                r {:spell spell\n343\t                   ;; Restricted to the item's own cursor cells: the result is a\n344\t                   ;; function of the memo key, never of the enclosing context.\n345\t                   :num (select-keys @(:num sub) cells)\n346\t                   :complete? (and (nil? @(:refused sub)) (empty? @(:groups sub)))\n347\t                   :refused @(:refused sub)}]\n348\t            (swap! (:counter ctx) update :key-bytes (fnil + 0) (count (bytes-key spell)))\n349\t            (swap! (:counter ctx) update :local-runs (fnil + 0) 1)\n350\t            (swap! (:memo ctx) assoc mk r)\n351\t            r)))))\n352\t\n353\t;; -------------------------------------------------------------- spelling\n354\t\n355\t(defn- spell-cell [run c]\n356\t  (let [[t k] (get @(:num run) c) ctx (:ctx run)]\n357\t    (case t\n358\t      :n [:cursor-cell [:n k]]\n359\t      :u [:cursor-cell [:u k (if (= :label (:spell-body ctx))\n360\t                               (body-label (get (:bodies ctx) c))\n361\t                               (get (:ranks ctx) c))]]\n362\t      (throw (ex-info \"spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n363\t\n364\t(defn- spell-slot [run d x path]\n365\t  (spend! (:ctx run) :work 1)\n366\t  (cond (ref? d) (spell-node run x path)\n367\t        (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n368\t        (= :C d) (spell-cell run x)\n369\t        (v? d) (if (nil? x) x\n370\t                   (case (first x)\n371\t                     :cursor-cell (spell-cell run (second x))\n372\t                     :row [:row (spell-node run (second x) path)]\n373\t                     (do (spend! (:ctx run) :work (literal-bytes (second x))) x)))\n374\t        :else (do (spend! (:ctx run) :work (literal-bytes x)) x)))\n375\t\n376\t(defn- spell-node\n377\t  \"The content encoding CE of a row under the run's final numbering.\"\n378\t  [run n path]\n379\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n380\t    (cond\n381\t      (= :cursor-cells kind) [:cursor-cells]\n382\t      (child-task? ctx n) [:child]\n383\t      (= :task kind)\n384\t      (into [kind]\n385\t            (map-indexed (fn [i [d x]]\n386\t                           (if (contains? #{7 12} i)\n387\t                             (vec (by-key-bytes #(bytes-key (nth % 1))\n388\t                                                (map #(spell-node run % (conj path i (first (:slots %)))) x)))\n389\t                             (spell-slot run d x (conj path i))))\n390\t                         (map vector ds slots)))\n391\t      (contains? keyed-structural kind)\n392\t      (into [kind] (mapcat identity (by-key-bytes #(bytes-key (first %))\n393\t                                                  (map (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n394\t                                                       (partition 2 slots)))))\n395\t      (= :window kind)\n396\t      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n397\t      (contains? #{:set :map} kind)\n398\t      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n399\t            tied (filter #(= path (:path %)) @(:groups run))\n400\t            tied-elems (set (mapcat :elems tied))\n401\t            plain (keep-indexed (fn [i e] (when-not (tied-elems e) (spell-slot run :V (elem-item kind e) (conj path i)))) elems)\n402\t            ties (map #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n403\t        (into [kind] (by-key-bytes bytes-key (concat plain ties))))\n404\t      :else (into [kind] (map-indexed (fn [i [d x]] (spell-slot run d x (conj path i))) (map vector ds slots))))))\n405\t\n406\t;; ------------------------------------------------------------- procedure\n407\t\n408\t(def ^:dynamic *numbering-opts*\n409\t  \"Options for every run of the procedure in scope (root and install children):\n410\t   :residue-search (D6), :permissive (diagnostic), :spell-body :label (the\n411\t   round-2 spelling, for the byte measurement), :budget.\"\n412\t  {})\n413\t\n414\t(defn discovery-numbering\n415\t  \"Returns {:numbering {src -> :yin.k/cc-n} :used {...}} or {:refused {...}}.\n416\t   Throws :resource-limit when the budget is exceeded, and a defect (never a\n417\t   refusal) when the numbering is not total.\"\n418\t  ([task] (discovery-numbering task *numbering-opts*))\n419\t  ([task opts]\n420\t   (let [census (nth (:slots task) 9)\n421\t         bodies (into {} (map vec) (partition 2 (:slots census)))\n422\t         ctx {:task task\n423\t              :bodies bodies\n424\t              :ranks (body-ranks bodies)\n425\t              :memo (atom {}) :cells-memo (atom {})\n426\t              :budget (merge default-budget (:budget opts))\n427\t              :counter (atom {})\n428\t              :permissive (:permissive opts)\n429\t              :residue-search (:residue-search opts)\n430\t              :spell-body (:spell-body opts)}\n431\t         run (new-run ctx {} :n 1 nil)]\n432\t     (enter-node! run task [])\n433\t     (resolve! run)\n434\t     (if-let [r @(:refused run)]\n435\t       {:refused r :used @(:counter ctx)}\n436\t       (let [numbered (set (keys @(:num run))) declared (set (keys bodies))]\n437\t         (when (seq @(:groups run)) (throw (ex-info \"residue after resolve\" {})))\n438\t         (when (not= numbered declared)\n439\t           (throw (ex-info \"numbering is not total\" {:missing (vec (remove numbered declared))\n440\t                                                      :extra (vec (remove declared numbered))})))\n441\t         {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))\n442\t          :used @(:counter ctx)})))))\n443\t\n444\t;; --------------------------------------------------------------- emission\n445\t;; 6a's emit-node with install children numbered by discovery order and a\n446\t;; row path threaded for the child refusal.\n447\t\n448\t(def ^:private ordered-slots @#'rows/ordered-slots)\n449\t(def ^:private check-literal-markers! @#'rows/check-literal-markers!)\n450\t(def ^:private byte-compare @#'rows/byte-compare)\n451\t\n452\t(declare emit-node*)\n453\t\n454\t(defn- refuse-unresolved! [r path]\n455\t  (throw (ex-info \"unresolved cursor cells\"\n456\t                  {:yin.k/status :yin.k/non-portable :yin.k/kind :unresolved-cursor-cells\n457\t                   :yin.k/path (into path (:path r)) :yin.k/cursor-cells (:cursor-cells r)})))\n458\t\n459\t(defn- emit-slot* [d x numbering rows path]\n460\t  (when-not (or (ref? d) (refs? d) (= :C d))\n461\t    (check-literal-markers! (if (v? d) (when (= :lit (first x)) (second x)) x)))\n462\t  (cond\n463\t    (ref? d) (emit-node* x numbering rows path)\n464\t    (refs? d) (reduce (fn [[out rs] [j n]]\n465\t                        (let [p (conj path (if (= :install (:kind n)) (first (:slots n)) j))\n466\t                              [id rs'] (emit-node* n numbering rs p)]\n467\t                          [(conj out id) rs']))\n468\t                      [[] rows] (map-indexed vector x))\n469\t    (= d :C) [(get numbering x x) rows]\n470\t    (v? d) (case (first x)\n471\t             :row (let [[id rs] (emit-node* (second x) numbering rows path)] [[:row id] rs])\n472\t             :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n473\t             [x rows])\n474\t    :else [x rows]))\n475\t\n476\t(defn- emit-node* [n numbering rows path]\n477\t  (let [{:keys [kind slots]} n\n478\t        [slots rows] (reduce (fn [[out rs] [i d x]]\n479\t                               (if (and (ref? d) (= :task (:kind x)))\n480\t                                 ;; An install child: its own scope, numbered by the same procedure.\n481\t                                 (let [r (discovery-numbering x)\n482\t                                       _ (when (:refused r) (refuse-unresolved! (:refused r) path))\n483\t                                       [id child-rows] (emit-node* x (:numbering r) {} [])]\n484\t                                   [(conj out id) (merge rs child-rows)])\n485\t                                 (let [[x' rs'] (emit-slot* d x numbering rs (conj path i))] [(conj out x') rs'])))\n486\t                             [[] rows] (map vector (range) (descriptors kind slots) slots))\n487\t        slots (if (= kind :task)\n488\t                (-> slots\n489\t                    (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n490\t                    (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n491\t                (ordered-slots kind slots))\n492\t        body (into [kind] slots) id (jing/segment-key body)]\n493\t    [id (assoc rows id (into [id] body))]))\n494\t\n495\t(defn emit*\n496\t  \"Lift side: number by discovery order, emit; refuses :yin.k/non-portable\n497\t   :unresolved-cursor-cells (D5) for the root or for any install child (path\n498\t   [12 <name> …]); a budget refusal propagates as itself.\"\n499\t  [task]\n500\t  (let [r (discovery-numbering task)]\n501\t    (when (:refused r) (refuse-unresolved! (:refused r) []))\n502\t    (let [[id rows] (emit-node* task (:numbering r) {} [])]\n503\t      {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n504\t\n505\t(defn decode*\n506\t  \"Receiver side: 6a's decode* with its own numbering check off (it still runs\n507\t   6a's recompute, under 6a's budget), then the whole discovery recomputation\n508\t   (root and install children) under one translation: only a lift-side\n509\t   :yin.k/non-portable of kind :unresolved-cursor-cells becomes\n510\t   :yin.k/undecodable :unresolved-cursor-cells with the path prefixed by the\n511\t   carried root id; anything else (a resource refusal) propagates as itself.\n512\t   In the real codec this check sits at carrier step 6, before\n513\t   validate-frames; here it runs after 6a's decode* returns.\"\n514\t  [wire]\n515\t  (let [task (@#'rows/decode* wire (assoc rows/default-budget :check-numbering false))\n516\t        root (:yin.k/root wire)\n517\t        id (try (:yin.k/root (emit* task))\n518\t                (catch clojure.lang.ExceptionInfo e\n519\t                  (let [d (ex-data e)]\n520\t                    (if (and (= :yin.k/non-portable (:yin.k/status d)) (= :unresolved-cursor-cells (:yin.k/kind d)))\n521\t                      (throw (ex-info \"unresolved cursor cells\"\n522\t                                      (assoc d :yin.k/status :yin.k/undecodable :yin.k/path (into [root] (:yin.k/path d)))))\n523\t                      (throw e)))))]\n524\t    (when (not= id root)\n525\t      (throw (ex-info \"noncanonical\" {:yin.k/status :yin.k/undecodable :yin.k/kind :noncanonical-cursor-cells\n526\t                                      :yin.k/path [root]})))\n527\t    task))\n528\t\n529\t(defn error [f]\n530\t  (try (f) nil (catch Throwable e (or (ex-data e) {:throwable (str e)}))))\n531\t\n532\t(defn do-root\n533\t  \"Root id, {:refused …} for D5, or {:resource-limit path} for a budget.\"\n534\t  [task]\n535\t  (try (:yin.k/root (emit* task))\n536\t       (catch clojure.lang.ExceptionInfo e\n537\t         (let [d (ex-data e)]\n538\t           (case (:yin.k/kind d)\n539\t             :unresolved-cursor-cells {:refused d}\n540\t             :resource-limit {:resource-limit (:yin.k/path d)}\n541\t             (throw e))))))\n542\t\n543\t(defn safe-6a-root [task]\n544\t  (try (:yin.k/root (rows/emit task))\n545\t       (catch Throwable e {:refused (select-keys (ex-data e) [:yin.k/kind :yin.k/path])})))\n546\t\n547\t;; ------------------------------------------------------------ generators\n548\t\n549\t(defn rename-and-shuffle\n550\t  \"Rename every cursor cell by `bij` and shuffle every :set, :map and the\n551\t   census in listed order (shuffle is rebound by callers for determinism).\"\n552\t  [n renaming]\n553\t  (letfn [(value [v] (case (first v)\n554\t                       :cursor-cell [:cursor-cell (bij (second v))]\n555\t                       :row [:row (go (second v))]\n556\t                       v))\n557\t          (bij [x] (get renaming x x))\n558\t          (go [n]\n559\t            (let [{:keys [kind slots]} n]\n560\t              (case kind\n561\t                :set (rows/node :set (vec (shuffle (mapv value slots))))\n562\t                :map (rows/node :map (vec (mapcat identity (shuffle (mapv (fn [[k v]] [(value k) (value v)]) (partition 2 slots))))))\n563\t                :cursor-cells (rows/node :cursor-cells (vec (mapcat (fn [[c b]] [(bij c) (go b)]) (shuffle (mapv vec (partition 2 slots))))))\n564\t                (rows/node kind (mapv (fn [d x]\n565\t                                        (cond (ref? d) (go x)\n566\t                                              (refs? d) (mapv go x)\n567\t                                              (= :C d) (bij x)\n568\t                                              (v? d) (if x (value x) x)\n569\t                                              :else x))\n570\t                                      (descriptors kind slots) slots)))))]\n571\t    (go n)))\n572\t\n573\t(defn all-census-cells\n574\t  \"Source ids of every census in the tree (root and install children).\"\n575\t  [task]\n576\t  (let [acc (atom [])]\n577\t    (letfn [(node [n] (when (map? n)\n578\t                        (when (= :cursor-cells (:kind n)) (swap! acc into (take-nth 2 (:slots n))))\n579\t                        (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n580\t                          (cond (ref? d) (node x) (refs? d) (run! node x)\n581\t                                (v? d) (when (and x (= :row (first x))) (node (second x)))))))]\n582\t      (node task) (vec @acc))))\n583\t\n584\t(defn seeded-shuffle [^java.util.Random r]\n585\t  (fn [xs] (let [a (java.util.ArrayList. ^java.util.Collection (vec xs))]\n586\t             (java.util.Collections/shuffle a r)\n587\t             (vec a))))\n588\t\n589\t(defn decoded\n590\t  \"Portable decoded equality of an abstract value (check-abstract!'s rule):\n591\t   sets as sets, maps as maps, cursor cells by identity.\"\n592\t  [v]\n593\t  (case (first v)\n594\t    :lit [:lit (second v)]\n595\t    :cursor-cell [:identity (second v)]\n596\t    :row (let [n (second v) ss (:slots n)]\n597\t           (case (:kind n)\n598\t             :vec [:seq (mapv decoded ss)]\n599\t             :set [:set (set (map decoded ss))]\n600\t             :map [:map (into {} (map (fn [[k x]] [(decoded k) (decoded x)])) (partition 2 ss))]\n601\t             [:row n]))))\n602\t\n603\t(defn distinct-decoded [vs] (vec (vals (into (sorted-map-by #(compare (pr-str %1) (pr-str %2))) (map (fn [e] [(decoded e) e])) vs))))\n604\t\n605\t(defn gen-value\n606\t  \"Random V over `cells`, depth-bounded. Shapes: literals, cursor cells,\n607\t   vectors, sets, maps (cursor cells as keys too), sets of cursor-cell pairs\n608\t   (edges, aliases such as [X X] included), sets of sets.\"\n609\t  [^java.util.Random r cells depth]\n610\t  (let [pick (fn [xs] (nth xs (.nextInt r (count xs))))\n611\t        cc (fn [] [:cursor-cell (pick cells)])\n612\t        k (.nextInt r (if (pos? depth) 9 3))]\n613\t    (case k\n614\t      0 [:lit (pick [1 2 :k \"s\" nil])]\n615\t      1 (cc)\n616\t      2 (cc)\n617\t      3 (let [elems (vec (repeatedly (inc (.nextInt r 3)) #(gen-value r cells (dec depth))))]\n618\t          (if (some #(not= :lit (first %)) elems) [:row (rows/node :vec elems)] [:lit (mapv second elems)]))\n619\t      4 (let [elems (distinct-decoded (repeatedly (inc (.nextInt r 4)) #(gen-value r cells (dec depth))))]\n620\t          (if (some #(not= :lit (first %)) elems) [:row (rows/node :set elems)] [:lit (set (map second elems))]))\n621\t      5 (let [pairs (vec (vals (into (sorted-map-by #(compare (pr-str %1) (pr-str %2))) (map (fn [p] [(decoded (first p)) p]))\n622\t                                     (repeatedly (inc (.nextInt r 3)) #(vector (gen-value r cells (dec depth)) (gen-value r cells (dec depth)))))))]\n623\t          (if (some (fn [[a b]] (or (not= :lit (first a)) (not= :lit (first b)))) pairs)\n624\t            [:row (rows/node :map (vec (mapcat identity pairs)))]\n625\t            [:lit (into {} (map (fn [[a b]] [(second a) (second b)])) pairs)]))\n626\t      (6 7) (let [edges (distinct-decoded (repeatedly (+ 2 (.nextInt r 3)) #(vector :row (rows/node :vec [(cc) (cc)]))))]\n627\t              [:row (rows/node :set edges)])\n628\t      8 (let [inner (distinct-decoded (repeatedly (+ 2 (.nextInt r 2))\n629\t                                                  #(let [es (distinct-decoded (repeatedly (inc (.nextInt r 3)) cc))]\n630\t                                                     [:row (rows/node :set es)])))]\n631\t          [:row (rows/node :set inner)]))))\n632\t\n633\t(defn reached [v]\n634\t  (let [acc (atom #{})]\n635\t    (letfn [(w [v] (case (first v)\n636\t                     :cursor-cell (swap! acc conj (second v))\n637\t                     :row (doseq [s (:slots (second v))] (w s))\n638\t                     nil))]\n639\t      (w v) @acc)))\n640\t\n641\t(defn gen-task\n642\t  \"A :halted task: 1-6 cursor cells over two bodies (ties common), 1-3 store\n643\t   bindings and the result slot hold random values.\"\n644\t  [seed]\n645\t  (let [r (java.util.Random. seed)\n646\t        k (inc (.nextInt r 6))\n647\t        cells (mapv #(keyword \"src\" (str \"c\" %)) (range k))\n648\t        bodies (mapv (fn [_] (rt/cursor-cell-body :s (if (zero? (.nextInt r 3)) 1 0))) cells)\n649\t        names (vec (take (inc (.nextInt r 3)) '[a b c]))\n650\t        vals (mapv (fn [_] (gen-value r cells 3)) names)\n651\t        result (gen-value r cells 2)\n652\t        used (reduce into (reached result) (map reached vals))\n653\t        census (keep (fn [[c b]] (when (used c) [c b])) (map vector cells bodies))]\n654\t    (if (empty? used)\n655\t      (recur (inc seed))\n656\t      (let [t (rt/task-node census result)]\n657\t        (rows/node :task (assoc (:slots t) 6 (rows/node :store (vec (mapcat (fn [n v] [n v]) names vals)))))))))\n658\t\n659\t(defn worked-act []\n660\t  (first (:slots (rows/decode (rows/frame->rows ft/worked-frame)))))\n661\t\n662\t(def park-vector [[:closure 0 [] 2] [:halt 0] [:park 0] [:return 0]])\n663\t(def park-address (jing/segment-key park-vector))\n664\t\n665\t(defn frame-task\n666\t  \"A blocked task carrying the worked code plus a park segment. The wait's\n667\t   act holds `wait-values` in its window register 1 and in one K frame's\n668\t   window register 1; `env-value`, when given, is bound to e0 in the free\n669\t   environment and in every environment; the parked state (P 7) is an act\n670\t   at the park site whose K frame holds `parked-value` in register 1.\n671\t   Decodes under 6a's validate-frames.\"\n672\t  [census wait-values env-value parked-value]\n673\t  (let [base (rt/task-node (conj (vec census) [:test/cursor (rt/cursor-cell-body :s 0)]) nil)\n674\t        [seg pc env window k rd] (:slots (worked-act))\n675\t        [_ store-of] (:slots env)\n676\t        bindings (rows/node :bindings (if env-value ['e0 env-value] []))\n677\t        env (rows/node :env [bindings store-of])\n678\t        kframe (fn [v] (rows/node :kframe [seg pc env (rows/node :window [1 v]) rd]))\n679\t        [w1 w2] wait-values\n680\t        wait-act (rows/node :act [seg pc env (rows/node :window [1 w1]) (rows/node :k (if w2 [(kframe w2)] [])) rd])\n681\t        pending (second (:slots (rows/decode (rows/frame->rows ft/worked-frame))))\n682\t        parked (rows/node :act [park-address 3 env (rows/node :window []) (rows/node :k [(kframe parked-value)]) 0])]\n683\t    (rows/node :task (-> (:slots base) (assoc 2 :blocked) (assoc 5 bindings)\n684\t                         (assoc 11 (merge ft/worked-code {park-address park-vector}))\n685\t                         (assoc 8 (rows/node :parked-table (if parked-value [7 parked] [])))\n686\t                         (assoc 13 [(rows/node :wait [wait-act pending])]) (assoc 16 {:yin.k/policy :yin.k/fork})))))\n687\t\n688\t(defn gen-frame-task [seed]\n689\t  (let [r (java.util.Random. seed)\n690\t        k (inc (.nextInt r 4))\n691\t        cells (mapv #(keyword \"src\" (str \"f\" %)) (range k))\n692\t        body (rt/cursor-cell-body :s 0)\n693\t        pick (fn [] (gen-value r cells 2))\n694\t        wait-values (vec (repeatedly (inc (.nextInt r 2)) pick))\n695\t        env-value (when (zero? (.nextInt r 2)) (pick))\n696\t        parked-value (when (zero? (.nextInt r 2)) (pick))\n697\t        used (reduce into #{} (map reached (remove nil? (concat wait-values [env-value parked-value]))))]\n698\t    (if (empty? used)\n699\t      (recur (inc seed))\n700\t      (frame-task (mapv #(vector % body) (filter used cells)) wait-values env-value parked-value))))\n701\t\n702\t(defn gen-child-task\n703\t  \"A parent (seed) with two install children: one random child task and the\n704\t   review counterexample as a child; the parent's own values stay random.\"\n705\t  [seed]\n706\t  (let [parent (gen-task seed)\n707\t        child (rows/node :task (assoc (:slots (gen-task (+ 100000 seed))) 3 :child))]\n708\t    (rows/node :task (assoc (:slots parent) 12 [(rows/node :install ['a :running nil {} child])\n709\t                                                (rows/node :install ['b :running nil {} child])]))))\n710\t\n711\t(defn fixture-review-counterexample\n712\t  \"'a bound to #{X Y} with equal bodies, 'b bound to X.\"\n713\t  []\n714\t  (let [body (rt/cursor-cell-body :s 0)\n715\t        t (rt/task-node [[:x body] [:y body]] [:lit nil])]\n716\t    (rows/node :task (assoc (:slots t) 6 (rows/node :store ['a [:row (rows/node :set [[:cursor-cell :x] [:cursor-cell :y]])]\n717\t                                                             'b [:cursor-cell :x]])))))\n718\t\n719\t(defn with-child\n720\t  \"`parent` with one install 'a holding `child` (slot 3 set to :child).\"\n721\t  [parent child]\n722\t  (rows/node :task (assoc (:slots parent) 12\n723\t                          [(rows/node :install ['a :running nil {} (rows/node :task (assoc (:slots child) 3 :child))])])))\n724\t\n725\t;; ------------------------------------------------------------ diagnostics\n726\t\n727\t(defn permissive-roots\n728\t  \"For a refused state: run the procedure with D5 replaced by host-first entry,\n729\t   over `n` shuffles of every unordered container. More than one root is a\n730\t   witness that the state is not interchangeable; one root over n shuffles is\n731\t   not a proof.\"\n732\t  [task n]\n733\t  (let [r (java.util.Random. 7)]\n734\t    (with-redefs [shuffle (seeded-shuffle r)]\n735\t      (->> (repeatedly n #(rename-and-shuffle task identity))\n736\t           (map (fn [t] (binding [*numbering-opts* (assoc *numbering-opts* :permissive true)]\n737\t                          (let [d (discovery-numbering t)\n738\t                                [id _] (emit-node* t (:numbering d) {} [])]\n739\t                            id))))\n740\t           distinct count))))\n741\t\n742\t(defn invariant-roots\n743\t  \"Distinct roots of a state over `n` renamings plus shuffles (1 = invariant\n744\t   under the samples).\"\n745\t  [task n]\n746\t  (let [r (java.util.Random. 5) cells (all-census-cells task)]\n747\t    (with-redefs [shuffle (seeded-shuffle r)]\n748\t      (->> (repeatedly n #(rename-and-shuffle task (zipmap cells (map (fn [i] (keyword \"r\" (str \"z\" i))) (shuffle (range (count cells)))))))\n749\t           (map do-root)\n750\t           distinct count))))\n751\t\n752\t(defn report-fixture [name task]\n753\t  (let [d (discovery-numbering task)]\n754\t    (println name)\n755\t    (println \"  DO :\" (or (:refused d) (into (sorted-map) (:numbering d))) \"| work\" (:work (:used d)) \"| search\" (or (:search (:used d)) 0))\n756\t    (println \"  DO root:\" (do-root task))\n757\t    (println \"  6a root:\" (safe-6a-root task))))\n758\t\n759\t(defn invariance-check\n760\t  \"Root of the state and of the state renamed and shuffled; decode of the\n761\t   carrier. Returns a map of outcomes.\"\n762\t  [task ^java.util.Random r]\n763\t  (let [cells (all-census-cells task)\n764\t        fresh (zipmap cells (map #(keyword \"other\" (str \"z\" %)) (shuffle (range (count cells)))))\n765\t        task2 (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle task fresh))\n766\t        d1 (do-root task) d2 (do-root task2)]\n767\t    (cond\n768\t      (and (map? d1) (:refused d1)) {:refused (:refused d1)}\n769\t      (map? d1) {:resource-limit (:resource-limit d1)}\n770\t      :else\n771\t      (cond-> {:root d1 :invariant (= d1 d2)\n772\t               :used (:used (discovery-numbering task))}\n773\t        true (assoc :decode (let [e (error #(decode* (emit* task)))]\n774\t                              (cond (nil? e) :ok\n775\t                                    (= :resource-limit (:yin.k/kind e)) :sixa-recompute-limit\n776\t                                    :else e)))))))\n777\t\n778\t(defn search [label gen seeds]\n779\t  (let [r (java.util.Random. 11)\n780\t        stats (atom {:numbered 0 :refused 0 :resource-limit 0 :invariance-fail 0 :decode-ok 0 :decode-fail 0 :decode-6a-limit 0\n781\t                     :refused-witnessed-noninterchangeable 0 :refused-not-distinguished 0\n782\t                     :max-work 0 :max-search 0 :max-local-runs 0})]\n783\t    (doseq [seed seeds]\n784\t      (let [task (gen seed) o (invariance-check task r)]\n785\t        (cond\n786\t          (:refused o)\n787\t          (do (swap! stats update :refused inc)\n788\t              (if (> (permissive-roots task 12) 1)\n789\t                (swap! stats update :refused-witnessed-noninterchangeable inc)\n790\t                (swap! stats update :refused-not-distinguished inc)))\n791\t          (:resource-limit o)\n792\t          (do (swap! stats update :resource-limit inc) (println \"RESOURCE LIMIT\" label seed (:resource-limit o)))\n793\t          :else\n794\t          (do (swap! stats update :numbered inc)\n795\t              (swap! stats update :max-work max (:work (:used o) 0))\n796\t              (swap! stats update :max-search max (:search (:used o) 0))\n797\t              (swap! stats update :max-local-runs max (:local-runs (:used o) 0))\n798\t              (when-not (:invariant o) (swap! stats update :invariance-fail inc) (println \"INVARIANCE FAIL\" label seed))\n799\t              (case (:decode o)\n800\t                :ok (swap! stats update :decode-ok inc)\n801\t                :sixa-recompute-limit (swap! stats update :decode-6a-limit inc)\n802\t                (do (swap! stats update :decode-fail inc) (println \"DECODE FAIL\" label seed (:decode o))))))))\n803\t    (println label (count seeds) \"states:\" @stats)\n804\t    @stats))\n805\t\n806\t(defn -main []\n807\t  (let [body (rt/cursor-cell-body :s 0)\n808\t        s (fn [es] [:row (rows/node :set es)])\n809\t        v (fn [cs] [:row (rows/node :vec (mapv #(vector :cursor-cell %) cs))])\n810\t        c (fn [x] [:cursor-cell x])\n811\t        task (fn [ids result] (rt/task-node (mapv #(vector % body) ids) result))\n812\t        two-cycle (task [:a :b] (s [(v [:a :b]) (v [:b :a])]))\n813\t        three-cycle (task [:a :b :c] (s [(v [:a :b]) (v [:b :c]) (v [:c :a])]))\n814\t        path-abc (task [:a :b :c] (s [(v [:a :b]) (v [:b :c])]))\n815\t        loop-2cycle (task [:l :a :b] (s [(v [:l :l]) (v [:a :b]) (v [:b :a])]))\n816\t        seven (rt/seven-cursor-cell-triangle-square)\n817\t        ;; codex round 2: a key-building local run reaches a conflict, the root run does not.\n818\t        local-d5-witness (task [:a :b] [:row (rows/node :vec [(s [(s [(v [:a :b]) (v [:b :a])])]) (c :a)])])\n819\t        refused-list [[\"loop + 2-cycle\" loop-2cycle] [\"2-cycle\" two-cycle] [\"3-cycle\" three-cycle]\n820\t                      [\"seven-cell\" seven] [\"path #{[A B] [B C]}\" path-abc]]]\n821\t    (println \"== fixtures (D5 mode: no residue search)\")\n822\t    (report-fixture \"fixture :s1 :s2 :x :y (pinned fab223...)\" (rt/fixture :s1 :s2 :x :y))\n823\t    (report-fixture \"review counterexample 'a #{X Y}, 'b X\" (fixture-review-counterexample))\n824\t    (report-fixture \"symmetric pair #{X Y}\" (task [:x :y] (s [(c :x) (c :y)])))\n825\t    (report-fixture \"alias a: [x x y]\" (task [:x :y] (v [:x :x :y])))\n826\t    (report-fixture \"alias b: [x y y]\" (task [:x :y] (v [:x :y :y])))\n827\t    (report-fixture \"#{[X X] [Y Y]}\" (task [:x :y] (s [(v [:x :x]) (v [:y :y])])))\n828\t    (report-fixture \"{X 1, Y 1}\" (task [:x :y] [:row (rows/node :map [(c :x) [:lit 1] (c :y) [:lit 1]])]))\n829\t    (report-fixture \"codex A: #{[X X] [Y Z]}\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])])))\n830\t    (report-fixture \"codex A reversed\" (task [:x :y :z] (s [(v [:y :z]) (v [:x :x])])))\n831\t    (report-fixture \"codex B: {X X, Y Z}\" (task [:x :y :z] [:row (rows/node :map [(c :x) (c :x) (c :y) (c :z)])]))\n832\t    (report-fixture \"codex B reversed\" (task [:x :y :z] [:row (rows/node :map [(c :y) (c :z) (c :x) (c :x)])]))\n833\t    (report-fixture \"codex C: #{#{X Y} #{Z W}}\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])])))\n834\t    (report-fixture \"codex C renamed\" (task [:q :r :s :t] (s [(s [(c :s) (c :t)]) (s [(c :q) (c :r)])])))\n835\t    (report-fixture \"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])]))\n836\t    (report-fixture \"[#{X Y} X]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (c :x)])]))\n837\t    (report-fixture \"[#{#{X Y} #{Z W}} X]\" (task [:x :y :z :w] [:row (rows/node :vec [(s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]) (c :x)])]))\n838\t    (report-fixture \"#{[#{X Y} #{X Y}] [#{P Q} #{R S}]} (equal keys would be unsound; keys differ)\"\n839\t                    (task [:x :y :p :q :r :s] (s [[:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])]\n840\t                                                   [:row (rows/node :vec [(s [(c :p) (c :q)]) (s [(c :r) (c :s)])])]])))\n841\t    (report-fixture \"codex r2 witness [#{#{[A B] [B A]}} A] (speculative key conflict; root run numbers)\" local-d5-witness)\n842\t    (println \"  invariant roots over 24 renamings+shuffles:\" (invariant-roots local-d5-witness 24)\n843\t             \"| decode:\" (or (error #(decode* (emit* local-d5-witness))) :ok))\n844\t    (report-fixture \"loop + 2-cycle #{[L L] [A B] [B A]} (6a pinned 55ff16...)\" loop-2cycle)\n845\t    (report-fixture \"2-cycle #{[A B] [B A]}\" two-cycle)\n846\t    (report-fixture \"3-cycle #{[A B] [B C] [C A]}\" three-cycle)\n847\t    (report-fixture \"path #{[A B] [B C]}\" path-abc)\n848\t    (report-fixture \"seven-cell triangle+square\" seven)\n849\t    (let [ids (mapv #(keyword \"src\" (str \"x\" %)) (range 10))]\n850\t      (report-fixture \"ten cells in a vec\" (rt/task-node (mapv (fn [id i] [id (rt/cursor-cell-body :s i)]) ids (range))\n851\t                                                         (v ids))))\n852\t    (println \"\\n== refused states: permissive roots over 24 shuffles (>1 = witnessed non-interchangeable)\")\n853\t    (doseq [[name t] refused-list]\n854\t      (println \" \" name \":\" (permissive-roots t 24) \"distinct root(s)\"))\n855\t    (println \"\\n== D6 residue search on the refused states: root, invariance over 24 renamings+shuffles, trials, decode\")\n856\t    (binding [*numbering-opts* {:residue-search true}]\n857\t      (doseq [[name t] refused-list]\n858\t        (let [d (discovery-numbering t)]\n859\t          (println \" \" name \":\" (do-root t) \"| numbering\" (into (sorted-map) (:numbering d))\n860\t                   \"| trials\" (:search (:used d)) \"| work\" (:work (:used d))\n861\t                   \"| distinct roots\" (invariant-roots t 24)\n862\t                   \"| decode:\" (or (error #(decode* (emit* t))) :ok)\n863\t                   \"| 6a:\" (safe-6a-root t)))))\n864\t    (println \"\\n== D6 does not move a D1-D4 pin (same roots with residue search on)\")\n865\t    (binding [*numbering-opts* {:residue-search true}]\n866\t      (doseq [[name t] [[\"fixture\" (rt/fixture :s1 :s2 :x :y)] [\"review\" (fixture-review-counterexample)]\n867\t                        [\"codex A\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])]))]\n868\t                        [\"codex C\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]))]\n869\t                        [\"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])])]\n870\t                        [\"witness\" local-d5-witness]]]\n871\t        (println \" \" name \":\" (do-root t))))\n872\t    (println \"\\n== install child refusal translates in decode (path prefixed by the root id, then [12 name ...])\")\n873\t    (let [parent (with-child (rt/task-node [] [:lit nil]) two-cycle)]\n874\t      (println \"  lift:\" (error #(emit* parent)))\n875\t      (println \"  decode of a carrier built with emit-numbered:\"\n876\t               (error #(decode* (rows/emit-numbered parent {}))))\n877\t      (binding [*numbering-opts* {:residue-search true}]\n878\t        (println \"  with D6, lift root:\" (do-root parent) \"| decode:\" (or (error #(decode* (emit* parent))) :ok))))\n879\t    (println \"\\n== budgets: {:work 1} and {:search 0} are resource refusals, never canonicality verdicts\")\n880\t    (binding [*numbering-opts* {:budget {:work 1}}]\n881\t      (println \"  loop+2-cycle {:work 1}:\" (error #(emit* loop-2cycle))))\n882\t    (binding [*numbering-opts* {:residue-search true :budget {:search 1}}]\n883\t      (println \"  3-cycle D6 {:search 1}:\" (error #(emit* three-cycle))))\n884\t    (binding [*numbering-opts* {:budget {:work 1}}]\n885\t      (println \"  decode of a valid carrier under {:work 1} propagates the resource refusal:\"\n886\t               (error #(decode* (binding [*numbering-opts* {}] (emit* (rt/fixture :s1 :s2 :x :y)))))))\n887\t    (println \"\\n== key bytes versus stream descriptor size (codex r2: 128 -> 65536 chars grew key bytes 3509 -> 592208)\")\n888\t    (doseq [n [128 65536]]\n889\t      (let [big (fn [i] (rows/node :cursor-cell-body [(rows/node :stream [:s (apply str (repeat n \"d\"))]) i]))\n890\t            t (rt/task-node [[:x (big 0)] [:y (big 0)] [:z (big 1)] [:w (big 1)]]\n891\t                            (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)]) (s [(c :x) (c :z)])]))]\n892\t        (doseq [mode [:label :rank]]\n893\t          (let [d (discovery-numbering t {:spell-body mode})]\n894\t            (println \"  descriptor\" n \"chars, body spelled by\" mode \": key bytes\" (:key-bytes (:used d))\n895\t                     \"| work\" (:work (:used d)) \"| local runs\" (:local-runs (:used d)) \"| root\" (do-root t))))))\n896\t    (println \"\\n== invariance under element reversal + renaming/shuffling\")\n897\t    (let [r (java.util.Random. 3)]\n898\t      (doseq [[name t] [[\"#{[X X] [Y Y]}\" (task [:x :y] (s [(v [:x :x]) (v [:y :y])]))]\n899\t                        [\"{X 1, Y 1}\" (task [:x :y] [:row (rows/node :map [(c :x) [:lit 1] (c :y) [:lit 1]])])]\n900\t                        [\"#{X Y}\" (task [:x :y] (s [(c :x) (c :y)]))]\n901\t                        [\"review counterexample\" (fixture-review-counterexample)]\n902\t                        [\"codex A\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])]))]\n903\t                        [\"codex B\" (task [:x :y :z] [:row (rows/node :map [(c :x) (c :x) (c :y) (c :z)])])]\n904\t                        [\"codex C\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]))]\n905\t                        [\"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])])]]]\n906\t        (let [rev (with-redefs [shuffle (comp vec reverse)] (rename-and-shuffle t identity))\n907\t              ren (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle t (fn [x] (keyword \"q\" (clojure.core/name x)))))]\n908\t          (println name \"DO:\" (do-root t) \"| reversed equal:\" (= (do-root t) (do-root rev))\n909\t                   \"| renamed+shuffled equal:\" (= (do-root t) (do-root ren)) \"| decode:\" (or (error #(decode* (emit* t))) :ok)))))\n910\t    (println \"\\n== frame-bearing fixtures (act window, K frame window, environments, parked state)\")\n911\t    (let [t (frame-task [[:x body] [:y body]] [(c :x) (c :y)] (c :y) (s [(c :x) (c :y)]))]\n912\t      (report-fixture \"wait window x, K window y, env y, parked K window #{x y}\" t)\n913\t      (println \"  decode:\" (or (error #(decode* (emit* t))) :ok)))\n914\t    (let [t (frame-task [[:x body] [:y body]] [(s [(c :x) (c :y)])] nil (c :y))]\n915\t      (report-fixture \"wait window #{x y}, parked K window y (parked table, slot 8, precedes frames, slot 13)\" t)\n916\t      (println \"  decode:\" (or (error #(decode* (emit* t))) :ok)))\n917\t    (println \"\\n== install children numbered by discovery order\")\n918\t    (let [child (rows/node :task (assoc (:slots (fixture-review-counterexample)) 3 :child))\n919\t          parent (rows/node :task (assoc (:slots (rt/task-node [[:x (rt/cursor-cell-body :root/s 1)]] (c :x))) 12\n920\t                                         [(rows/node :install ['a :running nil {} child])\n921\t                                          (rows/node :install ['b :running nil {} child])]))\n922\t          wire (emit* parent)]\n923\t      (println \"  parent root:\" (:yin.k/root wire) \"| task rows:\" (count (filter #(= :task (second %)) (:yin.k/rows wire)))\n924\t               \"| child numbering:\" (into (sorted-map) (:numbering (discovery-numbering child)))\n925\t               \"| decode:\" (or (error #(decode* wire)) :ok)))\n926\t    (println \"\\n== counterexample search, D5 mode (refuse the residue)\")\n927\t    (search \"random values\" gen-task (range 2000))\n928\t    (search \"frame-bearing\" gen-frame-task (range 200))\n929\t    (search \"with children\" gen-child-task (range 100))\n930\t    (println \"\\n== counterexample search, D6 mode (residue search)\")\n931\t    (binding [*numbering-opts* {:residue-search true}]\n932\t      (search \"random values\" gen-task (range 2000))\n933\t      (search \"frame-bearing\" gen-frame-task (range 200))\n934\t      (search \"with children\" gen-child-task (range 100)))))\n935\t"}]},"parent_tool_use_id":null,"session_id":"52f48666-0c9e-4ba6-9ea9-34c287559857","uuid":"8145abcf-a020-4c54-a4c4-73ceec49d8dd","timestamp":"2026-10-12T10:56:22.595Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-numbering/collab/numbering-probe/src/probe/discovery.clj","content":"(ns probe.discovery\n  \"Prototype of discovery-order cursor-cell numbering (note D1-D6, round 3 of\n   2026-10-12) over the 6a abstract task representation (yin.vm.ucf.rows).\n   Not repo code; a scratch project under collab/.\n\n   Vocabulary: UCF 7.5.3. A cursor cell is the VM box the carrier serializes;\n   its source id is the lift's local name; the procedure assigns :yin.k/cc-n.\n\n   Shape of the procedure (one algorithm, three uses):\n   - a RUN traverses an item (D1), numbers cursor cells on first meeting (D2),\n     keys every :set / :map element by a speculative local run and defers equal\n     keys to the run's worklist (D1), re-examines the worklist to a fixpoint\n     (D3), groups the surviving tied elements into components by shared\n     unnumbered cursor cells, encodes every component by a local run over its\n     component item and adopts the least encoding's components (D4). A\n     component holding two elements of one group is refused (D5) or, with\n     :residue-search, resolved by trials (D6): one local run per element of\n     the duplicated group with that element entered first, the least\n     spelling adopted.\n   - the root run assigns [:n k], k = 1, 2, ...; a LOCAL run assigns [:u j r]\n     (j from the enclosing run's local counter, r the body rank) and its\n     spelling is the key. A KEY run is speculative: it never refuses, and its\n     residue (ties or conflicts) is spelled [:tie K ...] in the key. A\n     COMPONENT run (and a D6 trial) must be complete, else D5.\n   - :work is charged per position visited or spelled and per literal byte\n     copied into a spelling; :search per D6 trial; exceeding either refuses\n     :yin.k/unsupported :resource-limit, never a canonicality verdict.\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-test :as rt]\n            [yin.vm.semantic-register.frame-test :as ft]))\n\n;; ---------------------------------------------------------------- schema\n\n(def synthetic-table\n  \"Rows that exist only inside the procedure: a :map entry as an ordered pair,\n   and a component as the ordered list of its (group-id item) pairs, where the\n   item is the group's one element or a synthetic :set of its elements.\"\n  {:entry [:V :V] :component [:pairs :D :V]})\n\n(defn descriptors [kind slots]\n  (let [schema (or (get rows/row-table kind) (get synthetic-table kind))]\n    (cond (= schema :pending) (into [:D] (get rows/pending-table (first slots)))\n          (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n          (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n          :else schema)))\n\n(defn ref? [d] (and (vector? d) (= :ref (first d))))\n(defn refs? [d] (and (vector? d) (= :refs (first d))))\n(defn v? [d] (contains? #{:V :optional-V} d))\n\n(defn bytes-key [x] (mapv #(bit-and (int %) 255) (seq (cbor/encode x))))\n\n(defn compare-bytes [a b]\n  (loop [i 0]\n    (cond (= i (count a)) (if (= i (count b)) 0 -1)\n          (= i (count b)) 1\n          (= (nth a i) (nth b i)) (recur (inc i))\n          :else (compare (nth a i) (nth b i)))))\n\n(defn by-key-bytes [f xs] (sort #(compare-bytes (f %1) (f %2)) xs))\n\n(def keyed-structural #{:bindings :store :parked-table})\n\n(defn elem-item\n  \"The item an element is entered and keyed as: a :set element is its V; a\n   :map entry [k v] is the synthetic ordered row [:entry k v], so that the\n   alias pattern across key and value is part of the key.\"\n  [kind e]\n  (if (= :map kind) [:row {:kind :entry :slots (vec e)}] e))\n\n(defn child-task? [ctx n] (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n\n;; --------------------------------------------------------------- budgets\n\n(def default-budget\n  \"6a's budget without :label-bytes; :search now counts D6 trials.\"\n  (dissoc rows/default-budget :label-bytes))\n\n(defn- spend! [ctx category amount]\n  (let [n (get (swap! (:counter ctx) update category (fnil + 0) amount) category)]\n    (when (> n (get (:budget ctx) category))\n      (throw (ex-info \"resource limit\"\n                      {:yin.k/status :yin.k/unsupported :yin.k/kind :resource-limit :yin.k/path [category]})))))\n\n(defn- literal-bytes [x] (count (cbor/encode x)))\n\n(defn item-cells\n  \"Cursor cells occurring in slot (d x); census and install children excluded.\n   Memoized per procedure on the slot value.\"\n  [ctx d x]\n  (or (get @(:cells-memo ctx) [d x])\n      (let [acc (atom #{})]\n        (letfn [(slot [d x]\n                  (cond (ref? d) (node x)\n                        (refs? d) (run! node x)\n                        (= :C d) (swap! acc conj x)\n                        (v? d) (when x (case (first x)\n                                         :cursor-cell (swap! acc conj (second x))\n                                         :row (node (second x))\n                                         nil))\n                        :else nil))\n                (node [n]\n                  (let [{:keys [kind slots]} n]\n                    (when-not (or (= :cursor-cells kind) (child-task? ctx n))\n                      (dorun (map slot (descriptors kind slots) slots)))))]\n          (slot d x)\n          (swap! (:cells-memo ctx) assoc [d x] @acc)\n          @acc))))\n\n(defn body-label [body]\n  (let [[stream position] (:slots body)]\n    [:body (into [:stream] (:slots stream)) position]))\n\n(defn body-ranks\n  \"Cursor cell -> rank of its body label among the census's distinct body\n   labels in bytewise order. Rank order equals label order, so spelling the\n   rank instead of the label changes no comparison and no numbering; it keeps\n   key bytes independent of the descriptor size.\"\n  [bodies]\n  (let [labels (into {} (map (fn [[c b]] [c (body-label b)])) bodies)\n        ranks (into {} (map-indexed (fn [i l] [l i]))\n                    (by-key-bytes bytes-key (distinct (vals labels))))]\n    (into {} (map (fn [[c l]] [c (get ranks l)])) labels)))\n\n;; ------------------------------------------------------------------ runs\n\n(def ^:dynamic *trace* false)\n\n(defn- new-run [ctx num tag next first-item]\n  {:ctx ctx :num (atom num) :tag tag :next (atom next) :first (atom first-item)\n   :groups (atom []) :gid (atom 0) :refused (atom nil)})\n\n(defn- meet!\n  \"D2. A cursor cell met for the first time receives the run's next number.\"\n  [run c]\n  (when-not (contains? @(:num run) c)\n    (let [k @(:next run)]\n      (swap! (:num run) assoc c [(:tag run) k])\n      (swap! (:next run) inc)\n      true)))\n\n(declare enter-node! enter-slot! unordered! local-run resolve! spell-slot spell-node)\n\n(defn- enter-slot! [run d x path]\n  (spend! (:ctx run) :work 1)\n  (cond (ref? d) (enter-node! run x path)\n        (refs? d) (dorun (map-indexed (fn [i n] (enter-node! run n (conj path i))) x))\n        (= :C d) (meet! run x)\n        (v? d) (when x (case (first x)\n                         :cursor-cell (meet! run (second x))\n                         :row (enter-node! run (second x) path)\n                         nil))\n        :else nil))\n\n(defn- enter-node!\n  \"D1. Canonical traversal: table order for slots; ordered repeated slots in\n   order; keyed structural rows in the Jing byte order of the key; :window in\n   ascending register order; installs and module stores by name; :set and\n   :map by local keys with ties deferred; census and children not entered.\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (= :cursor-cells kind) nil\n      (child-task? ctx n) nil\n      (= :task kind)\n      (doseq [[i d x] (map vector (range) ds slots)]\n        (if (contains? #{7 12} i)\n          (doseq [child (by-key-bytes #(bytes-key (first (:slots %))) x)]\n            (enter-node! run child (conj path i (first (:slots child)))))\n          (enter-slot! run d x (conj path i))))\n      (contains? keyed-structural kind)\n      (doseq [[k v] (by-key-bytes #(bytes-key (first %)) (partition 2 slots))]\n        (enter-slot! run (second ds) v (conj path k)))\n      (= :window kind)\n      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n      (= :set kind) (unordered! run :set (vec slots) path)\n      (= :map kind) (unordered! run :map (mapv vec (partition 2 slots)) path)\n      :else (dorun (map-indexed (fn [i [d x]] (enter-slot! run d x (conj path i))) (map vector ds slots))))))\n\n(defn- local-key [run item]\n  (let [r (local-run run item nil)] [(bytes-key (:spell r)) (:spell r)]))\n\n(defn- unordered!\n  \"D1 for an unordered container: key every element by a speculative local\n   run under the numbering at this moment; enter singletons in key order;\n   defer equal runs as one tie group (deferral order = canonical order). A D6\n   trial run enters its forced element first, when its container is keyed.\"\n  [run kind elems path]\n  (let [f @(:first run)\n        forced (when f (first (keep-indexed (fn [i e] (when (= f (elem-item kind e)) i)) elems)))]\n    (when forced\n      (reset! (:first run) nil)\n      (enter-slot! run :V (elem-item kind (nth elems forced)) (conj path forced)))\n    (let [keyed (vec (keep-indexed (fn [i e] (when (not= i forced) [(local-key run (elem-item kind e)) e i])) elems))\n          groups (partition-by (comp first first) (sort #(compare-bytes (first (first %1)) (first (first %2))) keyed))]\n      (when (and *trace* (= :n (:tag run)))\n        (println \"  [sort]\" path \"num\" @(:num run))\n        (doseq [g groups] (println \"    \" (if (= 1 (count g)) \"enter\" \"DEFER\") (mapv (fn [[[_ sp] e _]] [e sp]) g))))\n      (doseq [g groups]\n        (if (= 1 (count g))\n          (let [[_ e i] (first g)] (enter-slot! run :V (elem-item kind e) (conj path i)))\n          (swap! (:groups run) conj {:id (swap! (:gid run) inc) :kind kind :path path\n                                     :key (second (first (first g))) :elems (mapv second g)}))))))\n\n(defn- fixpoint!\n  \"D3. Re-examine every deferred group in deferral order under the current\n   numbering; repeat while a round numbers a cursor cell and groups remain.\"\n  [run]\n  (loop []\n    (let [before (count @(:num run)) groups @(:groups run)]\n      (reset! (:groups run) [])\n      (doseq [{:keys [kind elems path]} groups] (unordered! run kind elems path))\n      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n\n(defn- components\n  \"D4. Tied elements of all surviving groups, linked by shared unnumbered\n   cursor cells (union-find). A component is :conflict when it holds two\n   elements of one group; :dup-group is the least such group.\"\n  [run]\n  (let [num @(:num run) ctx (:ctx run)\n        by-id (into {} (map (juxt :id identity)) @(:groups run))\n        elems (vec (for [g @(:groups run) [i e] (map-indexed vector (:elems g))]\n                     {:group (:id g) :kind (:kind g) :elem e :idx i\n                      :cells (set (remove #(contains? num %) (item-cells ctx :V (elem-item (:kind g) e))))}))\n        parent (atom (vec (range (count elems))))\n        find (fn find [i] (let [p (@parent i)] (if (= p i) i (let [r (find p)] (swap! parent assoc i r) r))))\n        union (fn [i j] (let [ri (find i) rj (find j)] (when (not= ri rj) (swap! parent assoc ri rj))))\n        by-cell (reduce (fn [m [i el]] (reduce (fn [m c] (update m c (fnil conj []) i)) m (:cells el)))\n                        {} (map-indexed vector elems))]\n    (doseq [[_ is] by-cell] (doseq [j (rest is)] (union (first is) j)))\n    (->> (group-by find (range (count elems)))\n         (sort-by first)\n         (mapv (fn [[_ is]]\n                 (let [members (vec (sort-by (juxt :group :idx) (map elems is)))\n                       dup (first (sort (keep (fn [[g c]] (when (> c 1) g)) (frequencies (map :group members)))))]\n                   {:members members\n                    :conflict (some? dup)\n                    :dup-group dup\n                    :path (:path (get by-id (or dup (:group (first members)))))\n                    :cells (vec (sort (distinct (mapcat :cells members))))}))))))\n\n(defn- component-item\n  \"[:component g₁ i₁ g₂ i₂ …] in group order; iᵢ is the group's one element\n   in the component, or a synthetic :set of its elements when there are\n   several (the D6 case).\"\n  [comp]\n  [:row {:kind :component\n         :slots (vec (mapcat (fn [ms]\n                               [(:group (first ms))\n                                (if (= 1 (count ms))\n                                  (elem-item (:kind (first ms)) (:elem (first ms)))\n                                  [:row {:kind :set :slots (mapv #(elem-item (:kind %) (:elem %)) ms)}])])\n                             (partition-by :group (:members comp))))}])\n\n(defn- component-encoding\n  \"D4 for a certified component: a local run over its item, required to be\n   complete. D5 for a conflicting component: refuse. D6 (:residue-search): one\n   trial per element of the duplicated group, that element entered first; the\n   least complete spelling is the encoding. :permissive (diagnostic only):\n   a single trial with the host-first element.\"\n  [run comp]\n  (let [ctx (:ctx run) item (component-item comp)]\n    (cond\n      (not (:conflict comp)) (local-run run item nil)\n      (:permissive ctx)\n      (let [m (first (filter #(= (:dup-group comp) (:group %)) (:members comp)))]\n        (local-run run item (elem-item (:kind m) (:elem m))))\n      (:residue-search ctx)\n      (let [es (filter #(= (:dup-group comp) (:group %)) (:members comp))\n            trials (mapv (fn [m] (spend! ctx :search 1) (local-run run item (elem-item (:kind m) (:elem m)))) es)]\n        (when (and *trace* (= :n (:tag run)))\n          (doseq [t trials] (println \"  [trial]\" (:complete? t) (:spell t))))\n        (or (first (remove :complete? trials))\n            (first (sort-by #(bytes-key (:spell %)) compare-bytes trials))))\n      :else {:complete? false\n             :refused {:kind :unresolved-cursor-cells :path (:path comp) :cursor-cells (:cells comp)}})))\n\n(defn- adopt!\n  \"D4. Enter a component by adopting its local run: its fresh cursor cells\n   receive the enclosing run's next numbers in local-index order.\"\n  [run comp]\n  (let [fresh (->> (:num (:ce comp))\n                   (remove (fn [[c _]] (contains? @(:num run) c)))\n                   (sort-by (comp second val)))]\n    (doseq [[c _] fresh] (meet! run c))))\n\n(defn- remove-elements! [run comps]\n  (let [gone (set (for [c comps m (:members c)] [(:group m) (:idx m)]))]\n    (swap! (:groups run)\n           (fn [gs] (vec (keep (fn [g]\n                                 (let [es (vec (keep-indexed (fn [i e] (when-not (gone [(:id g) i]) e)) (:elems g)))]\n                                   (when (seq es) (assoc g :elems es))))\n                               gs))))))\n\n(defn- resolve!\n  \"D3-D6 to completion. Leaves :refused set (D5) with the worklist as of the\n   last fixpoint, or the worklist empty.\"\n  [run]\n  (loop []\n    (fixpoint! run)\n    (when (and *trace* (= :n (:tag run)))\n      (println \"  [resolve] num\" @(:num run) \"groups\" (mapv (fn [g] [(:id g) (:path g) (mapv (fn [e] (if (= :cursor-cell (first e)) (second e) e)) (:elems g))]) @(:groups run))))\n    (when (seq @(:groups run))\n      (let [comps (mapv #(assoc % :ce (component-encoding run %)) (components run))\n            bad (seq (remove #(:complete? (:ce %)) comps))]\n        (if bad\n          ;; The verdict is invariant; the diagnostic names every conflicting\n          ;; component's cells (sorted) and the least conflicting group's path,\n          ;; so it does not depend on host order either.\n          (reset! (:refused run) {:kind :unresolved-cursor-cells\n                                  :path (:path (:refused (:ce (first (sort-by #(or (:dup-group %) Long/MAX_VALUE) bad)))))\n                                  :cursor-cells (vec (sort (distinct (mapcat #(:cursor-cells (:refused (:ce %))) bad))))})\n          (let [sorted (sort #(compare-bytes (bytes-key (:spell (:ce %1))) (bytes-key (:spell (:ce %2)))) comps)\n                least (bytes-key (:spell (:ce (first sorted))))\n                least-run (take-while #(= least (bytes-key (:spell (:ce %)))) sorted)]\n            (when (and *trace* (= :n (:tag run)))\n              (doseq [c sorted] (println \"  [component]\" (mapv (fn [m] [(:group m) (:cells m)]) (:members c)) \"CE\" (:spell (:ce c))))\n              (println \"  [adopt]\" (count least-run)))\n            (doseq [c least-run] (adopt! run c))\n            (remove-elements! run least-run)\n            (recur)))))))\n\n(defn- local-run\n  \"A nested run on one item from the enclosing run's numbering, tag :u. Its\n   result is a key: the spelling under its final numbering, surviving ties\n   spelled [:tie K ...]. `first-item`, when given (D6 trial), is entered\n   before its siblings. Memoized on (item, numbering restricted to the item's\n   cursor cells, local counter, first-item).\"\n  [run item first-item]\n  (let [ctx (:ctx run)\n        cells (item-cells ctx :V item)\n        num @(:num run)\n        start (if (= :u (:tag run)) @(:next run) 0)\n        mk [item (select-keys num cells) start first-item]]\n    (or (get @(:memo ctx) mk)\n        (let [sub (new-run ctx num :u start first-item)]\n          (enter-slot! sub :V item [])\n          (resolve! sub)\n          (let [spell (spell-slot sub :V item [])\n                r {:spell spell\n                   ;; Restricted to the item's own cursor cells: the result is a\n                   ;; function of the memo key, never of the enclosing context.\n                   :num (select-keys @(:num sub) cells)\n                   :complete? (and (nil? @(:refused sub)) (empty? @(:groups sub)))\n                   :refused @(:refused sub)}]\n            (swap! (:counter ctx) update :key-bytes (fnil + 0) (count (bytes-key spell)))\n            (swap! (:counter ctx) update :local-runs (fnil + 0) 1)\n            (swap! (:memo ctx) assoc mk r)\n            r)))))\n\n;; -------------------------------------------------------------- spelling\n\n(defn- spell-cell [run c]\n  (let [[t k] (get @(:num run) c) ctx (:ctx run)]\n    (case t\n      :n [:cursor-cell [:n k]]\n      :u [:cursor-cell [:u k (if (= :label (:spell-body ctx))\n                               (body-label (get (:bodies ctx) c))\n                               (get (:ranks ctx) c))]]\n      (throw (ex-info \"spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n\n(defn- spell-slot [run d x path]\n  (spend! (:ctx run) :work 1)\n  (cond (ref? d) (spell-node run x path)\n        (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n        (= :C d) (spell-cell run x)\n        (v? d) (if (nil? x) x\n                   (case (first x)\n                     :cursor-cell (spell-cell run (second x))\n                     :row [:row (spell-node run (second x) path)]\n                     (do (spend! (:ctx run) :work (literal-bytes (second x))) x)))\n        :else (do (spend! (:ctx run) :work (literal-bytes x)) x)))\n\n(defn- spell-node\n  \"The content encoding CE of a row under the run's final numbering.\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (= :cursor-cells kind) [:cursor-cells]\n      (child-task? ctx n) [:child]\n      (= :task kind)\n      (into [kind]\n            (map-indexed (fn [i [d x]]\n                           (if (contains? #{7 12} i)\n                             (vec (by-key-bytes #(bytes-key (nth % 1))\n                                                (map #(spell-node run % (conj path i (first (:slots %)))) x)))\n                             (spell-slot run d x (conj path i))))\n                         (map vector ds slots)))\n      (contains? keyed-structural kind)\n      (into [kind] (mapcat identity (by-key-bytes #(bytes-key (first %))\n                                                  (map (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n                                                       (partition 2 slots)))))\n      (= :window kind)\n      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n      (contains? #{:set :map} kind)\n      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n            tied (filter #(= path (:path %)) @(:groups run))\n            tied-elems (set (mapcat :elems tied))\n            plain (keep-indexed (fn [i e] (when-not (tied-elems e) (spell-slot run :V (elem-item kind e) (conj path i)))) elems)\n            ties (map #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n        (into [kind] (by-key-bytes bytes-key (concat plain ties))))\n      :else (into [kind] (map-indexed (fn [i [d x]] (spell-slot run d x (conj path i))) (map vector ds slots))))))\n\n;; ------------------------------------------------------------- procedure\n\n(def ^:dynamic *numbering-opts*\n  \"Options for every run of the procedure in scope (root and install children):\n   :residue-search (D6), :permissive (diagnostic), :spell-body :label (the\n   round-2 spelling, for the byte measurement), :budget.\"\n  {})\n\n(defn discovery-numbering\n  \"Returns {:numbering {src -> :yin.k/cc-n} :used {...}} or {:refused {...}}.\n   Throws :resource-limit when the budget is exceeded, and a defect (never a\n   refusal) when the numbering is not total.\"\n  ([task] (discovery-numbering task *numbering-opts*))\n  ([task opts]\n   (let [census (nth (:slots task) 9)\n         bodies (into {} (map vec) (partition 2 (:slots census)))\n         ctx {:task task\n              :bodies bodies\n              :ranks (body-ranks bodies)\n              :memo (atom {}) :cells-memo (atom {})\n              :budget (merge default-budget (:budget opts))\n              :counter (atom {})\n              :permissive (:permissive opts)\n              :residue-search (:residue-search opts)\n              :spell-body (:spell-body opts)}\n         run (new-run ctx {} :n 1 nil)]\n     (enter-node! run task [])\n     (resolve! run)\n     (if-let [r @(:refused run)]\n       {:refused r :used @(:counter ctx)}\n       (let [numbered (set (keys @(:num run))) declared (set (keys bodies))]\n         (when (seq @(:groups run)) (throw (ex-info \"residue after resolve\" {})))\n         (when (not= numbered declared)\n           (throw (ex-info \"numbering is not total\" {:missing (vec (remove numbered declared))\n                                                      :extra (vec (remove declared numbered))})))\n         {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))\n          :used @(:counter ctx)})))))\n\n;; --------------------------------------------------------------- emission\n;; 6a's emit-node with install children numbered by discovery order and a\n;; row path threaded for the child refusal.\n\n(def ^:private ordered-slots @#'rows/ordered-slots)\n(def ^:private check-literal-markers! @#'rows/check-literal-markers!)\n(def ^:private byte-compare @#'rows/byte-compare)\n\n(declare emit-node*)\n\n(defn- refuse-unresolved! [r path]\n  (throw (ex-info \"unresolved cursor cells\"\n                  {:yin.k/status :yin.k/non-portable :yin.k/kind :unresolved-cursor-cells\n                   :yin.k/path (into path (:path r)) :yin.k/cursor-cells (:cursor-cells r)})))\n\n(defn- emit-slot* [d x numbering rows path]\n  (when-not (or (ref? d) (refs? d) (= :C d))\n    (check-literal-markers! (if (v? d) (when (= :lit (first x)) (second x)) x)))\n  (cond\n    (ref? d) (emit-node* x numbering rows path)\n    (refs? d) (reduce (fn [[out rs] [j n]]\n                        (let [p (conj path (if (= :install (:kind n)) (first (:slots n)) j))\n                              [id rs'] (emit-node* n numbering rs p)]\n                          [(conj out id) rs']))\n                      [[] rows] (map-indexed vector x))\n    (= d :C) [(get numbering x x) rows]\n    (v? d) (case (first x)\n             :row (let [[id rs] (emit-node* (second x) numbering rows path)] [[:row id] rs])\n             :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n             [x rows])\n    :else [x rows]))\n\n(defn- emit-node* [n numbering rows path]\n  (let [{:keys [kind slots]} n\n        [slots rows] (reduce (fn [[out rs] [i d x]]\n                               (if (and (ref? d) (= :task (:kind x)))\n                                 ;; An install child: its own scope, numbered by the same procedure.\n                                 (let [r (discovery-numbering x)\n                                       _ (when (:refused r) (refuse-unresolved! (:refused r) path))\n                                       [id child-rows] (emit-node* x (:numbering r) {} [])]\n                                   [(conj out id) (merge rs child-rows)])\n                                 (let [[x' rs'] (emit-slot* d x numbering rs (conj path i))] [(conj out x') rs'])))\n                             [[] rows] (map vector (range) (descriptors kind slots) slots))\n        slots (if (= kind :task)\n                (-> slots\n                    (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n                    (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n                (ordered-slots kind slots))\n        body (into [kind] slots) id (jing/segment-key body)]\n    [id (assoc rows id (into [id] body))]))\n\n(defn emit*\n  \"Lift side: number by discovery order, emit; refuses :yin.k/non-portable\n   :unresolved-cursor-cells (D5) for the root or for any install child (path\n   [12 <name> …]); a budget refusal propagates as itself.\"\n  [task]\n  (let [r (discovery-numbering task)]\n    (when (:refused r) (refuse-unresolved! (:refused r) []))\n    (let [[id rows] (emit-node* task (:numbering r) {} [])]\n      {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n\n(defn decode*\n  \"Receiver side: 6a's decode* with its own numbering check off (it still runs\n   6a's recompute, under 6a's budget), then the whole discovery recomputation\n   (root and install children) under one translation: only a lift-side\n   :yin.k/non-portable of kind :unresolved-cursor-cells becomes\n   :yin.k/undecodable :unresolved-cursor-cells with the path prefixed by the\n   carried root id; anything else (a resource refusal) propagates as itself.\n   In the real codec this check sits at carrier step 6, before\n   validate-frames; here it runs after 6a's decode* returns.\"\n  [wire]\n  (let [task (@#'rows/decode* wire (assoc rows/default-budget :check-numbering false))\n        root (:yin.k/root wire)\n        id (try (:yin.k/root (emit* task))\n                (catch clojure.lang.ExceptionInfo e\n                  (let [d (ex-data e)]\n                    (if (and (= :yin.k/non-portable (:yin.k/status d)) (= :unresolved-cursor-cells (:yin.k/kind d)))\n                      (throw (ex-info \"unresolved cursor cells\"\n                                      (assoc d :yin.k/status :yin.k/undecodable :yin.k/path (into [root] (:yin.k/path d)))))\n                      (throw e)))))]\n    (when (not= id root)\n      (throw (ex-info \"noncanonical\" {:yin.k/status :yin.k/undecodable :yin.k/kind :noncanonical-cursor-cells\n                                      :yin.k/path [root]})))\n    task))\n\n(defn error [f]\n  (try (f) nil (catch Throwable e (or (ex-data e) {:throwable (str e)}))))\n\n(defn do-root\n  \"Root id, {:refused …} for D5, or {:resource-limit path} for a budget.\"\n  [task]\n  (try (:yin.k/root (emit* task))\n       (catch clojure.lang.ExceptionInfo e\n         (let [d (ex-data e)]\n           (case (:yin.k/kind d)\n             :unresolved-cursor-cells {:refused d}\n             :resource-limit {:resource-limit (:yin.k/path d)}\n             (throw e))))))\n\n(defn safe-6a-root [task]\n  (try (:yin.k/root (rows/emit task))\n       (catch Throwable e {:refused (select-keys (ex-data e) [:yin.k/kind :yin.k/path])})))\n\n;; ------------------------------------------------------------ generators\n\n(defn rename-and-shuffle\n  \"Rename every cursor cell by `bij` and shuffle every :set, :map and the\n   census in listed order (shuffle is rebound by callers for determinism).\"\n  [n renaming]\n  (letfn [(value [v] (case (first v)\n                       :cursor-cell [:cursor-cell (bij (second v))]\n                       :row [:row (go (second v))]\n                       v))\n          (bij [x] (get renaming x x))\n          (go [n]\n            (let [{:keys [kind slots]} n]\n              (case kind\n                :set (rows/node :set (vec (shuffle (mapv value slots))))\n                :map (rows/node :map (vec (mapcat identity (shuffle (mapv (fn [[k v]] [(value k) (value v)]) (partition 2 slots))))))\n                :cursor-cells (rows/node :cursor-cells (vec (mapcat (fn [[c b]] [(bij c) (go b)]) (shuffle (mapv vec (partition 2 slots))))))\n                (rows/node kind (mapv (fn [d x]\n                                        (cond (ref? d) (go x)\n                                              (refs? d) (mapv go x)\n                                              (= :C d) (bij x)\n                                              (v? d) (if x (value x) x)\n                                              :else x))\n                                      (descriptors kind slots) slots)))))]\n    (go n)))\n\n(defn all-census-cells\n  \"Source ids of every census in the tree (root and install children).\"\n  [task]\n  (let [acc (atom [])]\n    (letfn [(node [n] (when (map? n)\n                        (when (= :cursor-cells (:kind n)) (swap! acc into (take-nth 2 (:slots n))))\n                        (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n                          (cond (ref? d) (node x) (refs? d) (run! node x)\n                                (v? d) (when (and x (= :row (first x))) (node (second x)))))))]\n      (node task) (vec @acc))))\n\n(defn seeded-shuffle [^java.util.Random r]\n  (fn [xs] (let [a (java.util.ArrayList. ^java.util.Collection (vec xs))]\n             (java.util.Collections/shuffle a r)\n             (vec a))))\n\n(defn decoded\n  \"Portable decoded equality of an abstract value (check-abstract!'s rule):\n   sets as sets, maps as maps, cursor cells by identity.\"\n  [v]\n  (case (first v)\n    :lit [:lit (second v)]\n    :cursor-cell [:identity (second v)]\n    :row (let [n (second v) ss (:slots n)]\n           (case (:kind n)\n             :vec [:seq (mapv decoded ss)]\n             :set [:set (set (map decoded ss))]\n             :map [:map (into {} (map (fn [[k x]] [(decoded k) (decoded x)])) (partition 2 ss))]\n             [:row n]))))\n\n(defn distinct-decoded [vs] (vec (vals (into (sorted-map-by #(compare (pr-str %1) (pr-str %2))) (map (fn [e] [(decoded e) e])) vs))))\n\n(defn gen-value\n  \"Random V over `cells`, depth-bounded. Shapes: literals, cursor cells,\n   vectors, sets, maps (cursor cells as keys too), sets of cursor-cell pairs\n   (edges, aliases such as [X X] included), sets of sets.\"\n  [^java.util.Random r cells depth]\n  (let [pick (fn [xs] (nth xs (.nextInt r (count xs))))\n        cc (fn [] [:cursor-cell (pick cells)])\n        k (.nextInt r (if (pos? depth) 9 3))]\n    (case k\n      0 [:lit (pick [1 2 :k \"s\" nil])]\n      1 (cc)\n      2 (cc)\n      3 (let [elems (vec (repeatedly (inc (.nextInt r 3)) #(gen-value r cells (dec depth))))]\n          (if (some #(not= :lit (first %)) elems) [:row (rows/node :vec elems)] [:lit (mapv second elems)]))\n      4 (let [elems (distinct-decoded (repeatedly (inc (.nextInt r 4)) #(gen-value r cells (dec depth))))]\n          (if (some #(not= :lit (first %)) elems) [:row (rows/node :set elems)] [:lit (set (map second elems))]))\n      5 (let [pairs (vec (vals (into (sorted-map-by #(compare (pr-str %1) (pr-str %2))) (map (fn [p] [(decoded (first p)) p]))\n                                     (repeatedly (inc (.nextInt r 3)) #(vector (gen-value r cells (dec depth)) (gen-value r cells (dec depth)))))))]\n          (if (some (fn [[a b]] (or (not= :lit (first a)) (not= :lit (first b)))) pairs)\n            [:row (rows/node :map (vec (mapcat identity pairs)))]\n            [:lit (into {} (map (fn [[a b]] [(second a) (second b)])) pairs)]))\n      (6 7) (let [edges (distinct-decoded (repeatedly (+ 2 (.nextInt r 3)) #(vector :row (rows/node :vec [(cc) (cc)]))))]\n              [:row (rows/node :set edges)])\n      8 (let [inner (distinct-decoded (repeatedly (+ 2 (.nextInt r 2))\n                                                  #(let [es (distinct-decoded (repeatedly (inc (.nextInt r 3)) cc))]\n                                                     [:row (rows/node :set es)])))]\n          [:row (rows/node :set inner)]))))\n\n(defn reached [v]\n  (let [acc (atom #{})]\n    (letfn [(w [v] (case (first v)\n                     :cursor-cell (swap! acc conj (second v))\n                     :row (doseq [s (:slots (second v))] (w s))\n                     nil))]\n      (w v) @acc)))\n\n(defn gen-task\n  \"A :halted task: 1-6 cursor cells over two bodies (ties common), 1-3 store\n   bindings and the result slot hold random values.\"\n  [seed]\n  (let [r (java.util.Random. seed)\n        k (inc (.nextInt r 6))\n        cells (mapv #(keyword \"src\" (str \"c\" %)) (range k))\n        bodies (mapv (fn [_] (rt/cursor-cell-body :s (if (zero? (.nextInt r 3)) 1 0))) cells)\n        names (vec (take (inc (.nextInt r 3)) '[a b c]))\n        vals (mapv (fn [_] (gen-value r cells 3)) names)\n        result (gen-value r cells 2)\n        used (reduce into (reached result) (map reached vals))\n        census (keep (fn [[c b]] (when (used c) [c b])) (map vector cells bodies))]\n    (if (empty? used)\n      (recur (inc seed))\n      (let [t (rt/task-node census result)]\n        (rows/node :task (assoc (:slots t) 6 (rows/node :store (vec (mapcat (fn [n v] [n v]) names vals)))))))))\n\n(defn worked-act []\n  (first (:slots (rows/decode (rows/frame->rows ft/worked-frame)))))\n\n(def park-vector [[:closure 0 [] 2] [:halt 0] [:park 0] [:return 0]])\n(def park-address (jing/segment-key park-vector))\n\n(defn frame-task\n  \"A blocked task carrying the worked code plus a park segment. The wait's\n   act holds `wait-values` in its window register 1 and in one K frame's\n   window register 1; `env-value`, when given, is bound to e0 in the free\n   environment and in every environment; the parked state (P 7) is an act\n   at the park site whose K frame holds `parked-value` in register 1.\n   Decodes under 6a's validate-frames.\"\n  [census wait-values env-value parked-value]\n  (let [base (rt/task-node (conj (vec census) [:test/cursor (rt/cursor-cell-body :s 0)]) nil)\n        [seg pc env window k rd] (:slots (worked-act))\n        [_ store-of] (:slots env)\n        bindings (rows/node :bindings (if env-value ['e0 env-value] []))\n        env (rows/node :env [bindings store-of])\n        kframe (fn [v] (rows/node :kframe [seg pc env (rows/node :window [1 v]) rd]))\n        [w1 w2] wait-values\n        wait-act (rows/node :act [seg pc env (rows/node :window [1 w1]) (rows/node :k (if w2 [(kframe w2)] [])) rd])\n        pending (second (:slots (rows/decode (rows/frame->rows ft/worked-frame))))\n        parked (rows/node :act [park-address 3 env (rows/node :window []) (rows/node :k [(kframe parked-value)]) 0])]\n    (rows/node :task (-> (:slots base) (assoc 2 :blocked) (assoc 5 bindings)\n                         (assoc 11 (merge ft/worked-code {park-address park-vector}))\n                         (assoc 8 (rows/node :parked-table (if parked-value [7 parked] [])))\n                         (assoc 13 [(rows/node :wait [wait-act pending])]) (assoc 16 {:yin.k/policy :yin.k/fork})))))\n\n(defn gen-frame-task [seed]\n  (let [r (java.util.Random. seed)\n        k (inc (.nextInt r 4))\n        cells (mapv #(keyword \"src\" (str \"f\" %)) (range k))\n        body (rt/cursor-cell-body :s 0)\n        pick (fn [] (gen-value r cells 2))\n        wait-values (vec (repeatedly (inc (.nextInt r 2)) pick))\n        env-value (when (zero? (.nextInt r 2)) (pick))\n        parked-value (when (zero? (.nextInt r 2)) (pick))\n        used (reduce into #{} (map reached (remove nil? (concat wait-values [env-value parked-value]))))]\n    (if (empty? used)\n      (recur (inc seed))\n      (frame-task (mapv #(vector % body) (filter used cells)) wait-values env-value parked-value))))\n\n(defn gen-child-task\n  \"A parent (seed) with two install children: one random child task and the\n   review counterexample as a child; the parent's own values stay random.\"\n  [seed]\n  (let [parent (gen-task seed)\n        child (rows/node :task (assoc (:slots (gen-task (+ 100000 seed))) 3 :child))]\n    (rows/node :task (assoc (:slots parent) 12 [(rows/node :install ['a :running nil {} child])\n                                                (rows/node :install ['b :running nil {} child])]))))\n\n(defn fixture-review-counterexample\n  \"'a bound to #{X Y} with equal bodies, 'b bound to X.\"\n  []\n  (let [body (rt/cursor-cell-body :s 0)\n        t (rt/task-node [[:x body] [:y body]] [:lit nil])]\n    (rows/node :task (assoc (:slots t) 6 (rows/node :store ['a [:row (rows/node :set [[:cursor-cell :x] [:cursor-cell :y]])]\n                                                             'b [:cursor-cell :x]])))))\n\n(defn with-child\n  \"`parent` with one install 'a holding `child` (slot 3 set to :child).\"\n  [parent child]\n  (rows/node :task (assoc (:slots parent) 12\n                          [(rows/node :install ['a :running nil {} (rows/node :task (assoc (:slots child) 3 :child))])])))\n\n;; ------------------------------------------------------------ diagnostics\n\n(defn permissive-roots\n  \"For a refused state: run the procedure with D5 replaced by host-first entry,\n   over `n` shuffles of every unordered container. More than one root is a\n   witness that the state is not interchangeable; one root over n shuffles is\n   not a proof.\"\n  [task n]\n  (let [r (java.util.Random. 7)]\n    (with-redefs [shuffle (seeded-shuffle r)]\n      (->> (repeatedly n #(rename-and-shuffle task identity))\n           (map (fn [t] (binding [*numbering-opts* (assoc *numbering-opts* :permissive true)]\n                          (let [d (discovery-numbering t)\n                                [id _] (emit-node* t (:numbering d) {} [])]\n                            id))))\n           distinct count))))\n\n(defn invariant-roots\n  \"Distinct roots of a state over `n` renamings plus shuffles (1 = invariant\n   under the samples).\"\n  [task n]\n  (let [r (java.util.Random. 5) cells (all-census-cells task)]\n    (with-redefs [shuffle (seeded-shuffle r)]\n      (->> (repeatedly n #(rename-and-shuffle task (zipmap cells (map (fn [i] (keyword \"r\" (str \"z\" i))) (shuffle (range (count cells)))))))\n           (map do-root)\n           distinct count))))\n\n(defn report-fixture [name task]\n  (let [d (discovery-numbering task)]\n    (println name)\n    (println \"  DO :\" (or (:refused d) (into (sorted-map) (:numbering d))) \"| work\" (:work (:used d)) \"| search\" (or (:search (:used d)) 0))\n    (println \"  DO root:\" (do-root task))\n    (println \"  6a root:\" (safe-6a-root task))))\n\n(defn invariance-check\n  \"Root of the state and of the state renamed and shuffled; decode of the\n   carrier. Returns a map of outcomes.\"\n  [task ^java.util.Random r]\n  (let [cells (all-census-cells task)\n        fresh (zipmap cells (map #(keyword \"other\" (str \"z\" %)) (shuffle (range (count cells)))))\n        task2 (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle task fresh))\n        d1 (do-root task) d2 (do-root task2)]\n    (cond\n      (and (map? d1) (:refused d1)) {:refused (:refused d1)}\n      (map? d1) {:resource-limit (:resource-limit d1)}\n      :else\n      (cond-> {:root d1 :invariant (= d1 d2)\n               :used (:used (discovery-numbering task))}\n        true (assoc :decode (let [e (error #(decode* (emit* task)))]\n                              (cond (nil? e) :ok\n                                    (= :resource-limit (:yin.k/kind e)) :sixa-recompute-limit\n                                    :else e)))))))\n\n(defn search [label gen seeds]\n  (let [r (java.util.Random. 11)\n        stats (atom {:numbered 0 :refused 0 :resource-limit 0 :invariance-fail 0 :decode-ok 0 :decode-fail 0 :decode-6a-limit 0\n                     :refused-witnessed-noninterchangeable 0 :refused-not-distinguished 0\n                     :max-work 0 :max-search 0 :max-local-runs 0})]\n    (doseq [seed seeds]\n      (let [task (gen seed) o (invariance-check task r)]\n        (cond\n          (:refused o)\n          (do (swap! stats update :refused inc)\n              (if (> (permissive-roots task 12) 1)\n                (swap! stats update :refused-witnessed-noninterchangeable inc)\n                (swap! stats update :refused-not-distinguished inc)))\n          (:resource-limit o)\n          (do (swap! stats update :resource-limit inc) (println \"RESOURCE LIMIT\" label seed (:resource-limit o)))\n          :else\n          (do (swap! stats update :numbered inc)\n              (swap! stats update :max-work max (:work (:used o) 0))\n              (swap! stats update :max-search max (:search (:used o) 0))\n              (swap! stats update :max-local-runs max (:local-runs (:used o) 0))\n              (when-not (:invariant o) (swap! stats update :invariance-fail inc) (println \"INVARIANCE FAIL\" label seed))\n              (case (:decode o)\n                :ok (swap! stats update :decode-ok inc)\n                :sixa-recompute-limit (swap! stats update :decode-6a-limit inc)\n                (do (swap! stats update :decode-fail inc) (println \"DECODE FAIL\" label seed (:decode o))))))))\n    (println label (count seeds) \"states:\" @stats)\n    @stats))\n\n(defn -main []\n  (let [body (rt/cursor-cell-body :s 0)\n        s (fn [es] [:row (rows/node :set es)])\n        v (fn [cs] [:row (rows/node :vec (mapv #(vector :cursor-cell %) cs))])\n        c (fn [x] [:cursor-cell x])\n        task (fn [ids result] (rt/task-node (mapv #(vector % body) ids) result))\n        two-cycle (task [:a :b] (s [(v [:a :b]) (v [:b :a])]))\n        three-cycle (task [:a :b :c] (s [(v [:a :b]) (v [:b :c]) (v [:c :a])]))\n        path-abc (task [:a :b :c] (s [(v [:a :b]) (v [:b :c])]))\n        loop-2cycle (task [:l :a :b] (s [(v [:l :l]) (v [:a :b]) (v [:b :a])]))\n        seven (rt/seven-cursor-cell-triangle-square)\n        ;; codex round 2: a key-building local run reaches a conflict, the root run does not.\n        local-d5-witness (task [:a :b] [:row (rows/node :vec [(s [(s [(v [:a :b]) (v [:b :a])])]) (c :a)])])\n        refused-list [[\"loop + 2-cycle\" loop-2cycle] [\"2-cycle\" two-cycle] [\"3-cycle\" three-cycle]\n                      [\"seven-cell\" seven] [\"path #{[A B] [B C]}\" path-abc]]]\n    (println \"== fixtures (D5 mode: no residue search)\")\n    (report-fixture \"fixture :s1 :s2 :x :y (pinned fab223...)\" (rt/fixture :s1 :s2 :x :y))\n    (report-fixture \"review counterexample 'a #{X Y}, 'b X\" (fixture-review-counterexample))\n    (report-fixture \"symmetric pair #{X Y}\" (task [:x :y] (s [(c :x) (c :y)])))\n    (report-fixture \"alias a: [x x y]\" (task [:x :y] (v [:x :x :y])))\n    (report-fixture \"alias b: [x y y]\" (task [:x :y] (v [:x :y :y])))\n    (report-fixture \"#{[X X] [Y Y]}\" (task [:x :y] (s [(v [:x :x]) (v [:y :y])])))\n    (report-fixture \"{X 1, Y 1}\" (task [:x :y] [:row (rows/node :map [(c :x) [:lit 1] (c :y) [:lit 1]])]))\n    (report-fixture \"codex A: #{[X X] [Y Z]}\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])])))\n    (report-fixture \"codex A reversed\" (task [:x :y :z] (s [(v [:y :z]) (v [:x :x])])))\n    (report-fixture \"codex B: {X X, Y Z}\" (task [:x :y :z] [:row (rows/node :map [(c :x) (c :x) (c :y) (c :z)])]))\n    (report-fixture \"codex B reversed\" (task [:x :y :z] [:row (rows/node :map [(c :y) (c :z) (c :x) (c :x)])]))\n    (report-fixture \"codex C: #{#{X Y} #{Z W}}\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])])))\n    (report-fixture \"codex C renamed\" (task [:q :r :s :t] (s [(s [(c :s) (c :t)]) (s [(c :q) (c :r)])])))\n    (report-fixture \"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])]))\n    (report-fixture \"[#{X Y} X]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (c :x)])]))\n    (report-fixture \"[#{#{X Y} #{Z W}} X]\" (task [:x :y :z :w] [:row (rows/node :vec [(s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]) (c :x)])]))\n    (report-fixture \"#{[#{X Y} #{X Y}] [#{P Q} #{R S}]} (equal keys would be unsound; keys differ)\"\n                    (task [:x :y :p :q :r :s] (s [[:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])]\n                                                   [:row (rows/node :vec [(s [(c :p) (c :q)]) (s [(c :r) (c :s)])])]])))\n    (report-fixture \"codex r2 witness [#{#{[A B] [B A]}} A] (speculative key conflict; root run numbers)\" local-d5-witness)\n    (println \"  invariant roots over 24 renamings+shuffles:\" (invariant-roots local-d5-witness 24)\n             \"| decode:\" (or (error #(decode* (emit* local-d5-witness))) :ok))\n    (report-fixture \"loop + 2-cycle #{[L L] [A B] [B A]} (6a pinned 55ff16...)\" loop-2cycle)\n    (report-fixture \"2-cycle #{[A B] [B A]}\" two-cycle)\n    (report-fixture \"3-cycle #{[A B] [B C] [C A]}\" three-cycle)\n    (report-fixture \"path #{[A B] [B C]}\" path-abc)\n    (report-fixture \"seven-cell triangle+square\" seven)\n    (let [ids (mapv #(keyword \"src\" (str \"x\" %)) (range 10))]\n      (report-fixture \"ten cells in a vec\" (rt/task-node (mapv (fn [id i] [id (rt/cursor-cell-body :s i)]) ids (range))\n                                                         (v ids))))\n    (println \"\\n== refused states: permissive roots over 24 shuffles (>1 = witnessed non-interchangeable)\")\n    (doseq [[name t] refused-list]\n      (println \" \" name \":\" (permissive-roots t 24) \"distinct root(s)\"))\n    (println \"\\n== D6 residue search on the refused states: root, invariance over 24 renamings+shuffles, trials, decode\")\n    (binding [*numbering-opts* {:residue-search true}]\n      (doseq [[name t] refused-list]\n        (let [d (discovery-numbering t)]\n          (println \" \" name \":\" (do-root t) \"| numbering\" (into (sorted-map) (:numbering d))\n                   \"| trials\" (:search (:used d)) \"| work\" (:work (:used d))\n                   \"| distinct roots\" (invariant-roots t 24)\n                   \"| decode:\" (or (error #(decode* (emit* t))) :ok)\n                   \"| 6a:\" (safe-6a-root t)))))\n    (println \"\\n== D6 does not move a D1-D4 pin (same roots with residue search on)\")\n    (binding [*numbering-opts* {:residue-search true}]\n      (doseq [[name t] [[\"fixture\" (rt/fixture :s1 :s2 :x :y)] [\"review\" (fixture-review-counterexample)]\n                        [\"codex A\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])]))]\n                        [\"codex C\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]))]\n                        [\"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])])]\n                        [\"witness\" local-d5-witness]]]\n        (println \" \" name \":\" (do-root t))))\n    (println \"\\n== install child refusal translates in decode (path prefixed by the root id, then [12 name ...])\")\n    (let [parent (with-child (rt/task-node [] [:lit nil]) two-cycle)]\n      (println \"  lift:\" (error #(emit* parent)))\n      (println \"  decode of a carrier built with emit-numbered