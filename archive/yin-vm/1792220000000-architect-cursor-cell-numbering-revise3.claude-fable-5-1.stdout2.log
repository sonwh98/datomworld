k instead of the label changes no comparison and no numbering; it keeps","-   key bytes independent of the descriptor size.\"","-  [bodies]","+   labels in bytewise order (rank order = label order, so keys stay","+   independent of the descriptor's size).\"","+  [ctx bodies]","   (let [labels (into {} (map (fn [[c b]] [c (body-label b)])) bodies)","-        ranks (into {} (map-indexed (fn [i l] [l i]))","-                    (by-key-bytes bytes-key (distinct (vals labels))))]","+        ranks (into {} (map-indexed (fn [i l] [l i])) (sort-by-key! ctx identity (distinct (vals labels))))]","     (into {} (map (fn [[c l]] [c (get ranks l)])) labels)))"," "," ;; ------------------------------------------------------------------ runs"," "," (def ^:dynamic *trace* false)"," ","-(defn- new-run [ctx num tag next first-item]","-  {:ctx ctx :num (atom num) :tag tag :next (atom next) :first (atom first-item)","-   :groups (atom []) :gid (atom 0) :refused (atom nil)})","+(defn- new-run [ctx num tag next]","+  {:ctx ctx :num (atom num) :tag tag :next (atom next) :groups (atom []) :gid (atom 0) :refused (atom nil)})"," "," (defn- meet!","-  \"D2. A cursor cell met for the first time receives the run's next number.\"","+  \"W2. A cursor cell met for the first time receives the run's next number.\"","   [run c]","   (when-not (contains? @(:num run) c)","     (let [k @(:next run)]"]},{"oldStart":141,"oldLines":24,"newStart":178,"newLines":26,"lines":["       (swap! (:next run) inc)","       true)))"," ","-(declare enter-node! enter-slot! unordered! local-run resolve! spell-slot spell-node)","+(declare enter-node! unordered! local-run spell-slot spell-node)"," "," (defn- enter-slot! [run d x path]","-  (spend! (:ctx run) :work 1)","-  (cond (ref? d) (enter-node! run x path)","-        (refs? d) (dorun (map-indexed (fn [i n] (enter-node! run n (conj path i))) x))","-        (= :C d) (meet! run x)","-        (v? d) (when x (case (first x)","-                         :cursor-cell (meet! 