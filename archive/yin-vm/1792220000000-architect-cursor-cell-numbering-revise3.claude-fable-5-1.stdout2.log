n.k/rows wire))\n116\t        memo (atom {})]\n117\t    (letfn [(rewrite\n118\t              [x]\n119\t              (cond\n120\t                (contains? index x)\n121\t                (or (get @memo x)\n122\t                    (let [rbody (if (= x id) body (subvec (get index x) 1))\n123\t                          b (mapv rewrite rbody) nid (jing/segment-key b)]\n124\t                      (swap! memo assoc x nid)\n125\t                      nid))\n126\t                (vector? x) (mapv rewrite x)\n127\t                :else x))]\n128\t      (let [root (rewrite (:yin.k/root wire))\n129\t            rs (mapv (fn [[old new]] (into [new] (mapv rewrite (if (= old id) body (subvec (get index old) 1))))) @memo)]\n130\t        (assoc wire :yin.k/root root :yin.k/rows rs)))))\n131\t\n132\t\n133\t(deftest window-sorted-and-unique\n134\t  (let [f (assoc ft/worked-frame :yin.k/window {1 :f 3 nil})\n135\t        wire (rows/frame->rows f) r (first (filter #(= :window (second %)) (:yin.k/rows wire)))\n136\t        id (first r)]\n137\t    (doseq [body [[:window 3 [:lit nil] 1 [:lit :f]] [:window 1 [:lit :f] 1 [:lit nil]]]]\n138\t      (let [d (error #(rows/rows->frame (replace-row wire id body)))]\n139\t        (is (= :yin.k/undecodable (:yin.k/status d)))\n140\t        (is (contains? #{:row-order :duplicate-key} (:yin.k/kind d)))))))\n141\t\n142\t\n143\t(deftest canonical-under-is-renaming-invariant\n144\t  (let [a (rows/emit (fixture :lane-a/s1 :lane-a/s2 :source/x :source/y))\n145\t        b (rows/emit (fixture :lane-b/s2 :lane-b/s1 :other/y :other/x))\n146\t        ca (rows/canonical-under a {:lane-a/s1 :s1 :lane-a/s2 :s2})\n147\t        cb (rows/canonical-under b {:lane-b/s2 :s1 :lane-b/s1 :s2})]\n148\t    (is (= (:yin.k/root ca) (:yin.k/root cb)))\n149\t    (is (= (:yin.k/root ca)\n150\t           (:yin.k/root (rows/canonical-under\n151\t                          (rows/emit-numbered (fixture :lane-a/s1 :lane-a/s2 :source/x :source/y)\n152\t                                