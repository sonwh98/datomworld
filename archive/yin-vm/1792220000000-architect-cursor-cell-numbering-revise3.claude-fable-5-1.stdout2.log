                                    (get pending-keys reason) (get pending-table reason))))])\n672\t                state)\n673\t         [id rows] (emit-node root {} {})]\n674\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n675\t\n676\t\n677\t(defn- decode-keyed\n678\t  [n decode-value]\n679\t  (into {} (map (fn [[k v]] [k (decode-value v)])) (partition 2 (:slots n))))\n680\t\n681\t\n682\t(defn- decode-env\n683\t  [n decode-value]\n684\t  (let [[bindings store-of] (:slots n)]\n685\t    (cond-> {:yin.k/bindings (decode-keyed bindings decode-value)}\n686\t      (some? store-of) (assoc :yin.k/store-of store-of))))\n687\t\n688\t\n689\t(defn- decode-kframe\n690\t  [n decode-value]\n691\t  (let [[seg pc e w rd] (:slots n)]\n692\t    {:yin.k/frame-type :return :yin.k/segment seg :yin.k/pc pc\n693\t     :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value) :yin.k/rd rd}))\n694\t\n695\t\n696\t(defn- decode-frame\n697\t  [n decode-value]\n698\t  (if (= :wait (:kind n))\n699\t    (let [[state pending] (:slots n) [reason & slots] (:slots pending)]\n700\t      (assoc (decode-frame state decode-value) :yin.k/pending\n701\t             (into {:yin.k/reason reason}\n702\t                   (map (fn [key d x] [key (if (= :V d) (decode-value x) x)])\n703\t                        (get pending-keys reason) (get pending-table reason) slots))))\n704\t    (let [act? (= :act (:kind n)) [seg pc e w k rd] (:slots n)\n705\t          k (if act? k e)]\n706\t      (cond-> {:yin.k/state (:kind n) :yin.k/segment seg\n707\t               :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd rd} {:yin.k/deliver :return})\n708\t               :yin.k/k (mapv #(decode-kframe % decode-value) (:slots k))}\n709\t        act? (assoc :yin.k/pc pc :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value))\n710\t        (not act?) (assoc :yin.k/site pc)))))\n711\t\n712\t\n713\t(defn rows->frame\n714\t  \"Validate row syntax and hashes, then reshape to the keyed frame.\n715\t   Semantic code/context rules remain frame/defect's responsibility.\n716\t   The default decoder produces in-band row/cursor-cell markers that the default\n717\t   encoder refuses. frame->rows after rows->frame is identity only when\n718\t   both sides are given a classifier for those values.\"\n719\t  ([wire] (rows->frame wire decoded-value))\n720\t  ([wire decode-value] (decode-frame (decode wire) decode-value)))\n721\t\n722\t\n723\t(defn validate-frames\n724\t  \"Carrier step 7, after decode's canonical numbering. Judge each task's\n725\t   X1 first, then waits, parked states, and all reified values. Return the\n726\t   first defect with the abstract row path, or nil.\"\n727\t  [task]\n728\t  (let [slots (:slots task) code-map (nth slots 11)\n729\t        free-env (decode-keyed (nth slots 5) decoded-value)\n730\t        waits (nth slots 13)\n731\t        ffi-ids (into #{} (keep (fn [w]\n732\t                                  (let [[_ p] (:slots w) [reason & xs] (:slots p)]\n733\t                                    (case reason :ffi (second xs) :ffi-request (first xs) nil)))) waits)\n734\t        ctx {:free-env free-env :ffi-call-ids ffi-ids}]\n735\t    (letfn [(judge\n736\t              [n context context-map path]\n737\t              (when-let [d (frame/defect (decode-frame n decoded-value) code-map context context-map)]\n738\t                (-> d (assoc :yin.k/status :yin.k/undecodable)\n739\t                    (update :yin.k/path #(into path %)))))\n740\t            (captures\n741\t              [n path]\n742\t              (if (= :reified (:kind n))\n743\t                (or (judge (first (:slots n)) :captured ctx path)\n744\t                    (captures (first (:slots n)) (conj path 0)))\n745\t                (some (fn [[i d x]]\n746\t                        (cond\n747\t                          (and (ref? d) (= :task (:kind x))) (validate-frames x)\n748\t                          (ref? d) (captures x (conj path i))\n749\t                          (refs? d) (some (fn [[j child]] (captures child (conj path i j))) (map-indexed vector x))\n750\t                          (and (contains? #{:V :optional-V} d) (= :row (first x))) (captures (second x) (conj path i))\n751\t                          :else nil))\n752\t                      (map vector (range) (descriptors (:kind n) (:slots n)) (:slots n)))))]\n753\t      (or\n754\t        (when-let [d (frame/task-defect ctx)] (assoc d :yin.k/status :yin.k/undecodable))\n755\t        (some (fn [[i w]] (judge w :wait ctx [:frames i])) (map-indexed vector waits))\n756\t        (some (fn [[p state]] (judge state :parked (assoc ctx :parked-key p) [:parked p]))\n757\t              (partition 2 (:slots (nth slots 8))))\n758\t        (captures task [])))))\n759\t"}]},"parent_tool_use_id":null,"session_id":"52f48666-0c9e-4ba6-9ea9-34c287559857","uuid":"bbc60eff-c8fa-43ac-bd75-5aa21e72e1ef","timestamp":"2026-10-12T10:56:23.543Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-numbering/collab/numbering-probe/src/yin/vm/ucf/rows.cljc","content":"(ns yin.vm.ucf.rows\n  \"Version-3 row codec. Pure row construction, graph decoding and canonical\n   cursor-cell numbering; no machine attachment, dependency scanner or transport.\n   An abstract row is {:kind keyword :slots vector}. Structural references\n   contain abstract rows; values use [:lit d], [:row abstract-row], [:cursor-cell id].\n   A task's :cursor-cells row holds alternating source identities and :cursor-cell-body\n   rows. Install children are separate tasks with separate cursor-cell scopes.\n\n   The census is ordered numerically by n (draft §3, \\\"sorted by n\\\"), so\n   :yin.k/cc-10 follows :yin.k/cc-9; its keys must spell cc-N with no leading\n   zero, else :slot-kind.\n\n   Default value markers are plain maps {:yin.k/row abstract-row} and\n   {:yin.k/cursor-cell keyword}. A guest map whose sole key is :yin.k/row or\n   :yin.k/cursor-cell collides with them and is not portable: on encode and decode\n   every literal of that shape is refused :yin.k/non-portable. Explicit\n   markers use the caller value encoder.\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.frame :as frame]))\n\n\n(def profile {:yin.code/contract \"v4\" :yin.k/version 1})\n\n\n(def pending-table\n  {:next [:C]\n   :put [[:ref :stream] :V :D]\n   :ffi [:C :D :D]\n   :ffi-request [:D :V [:ref :stream] [:ref :stream] :C :D]\n   :link-request [:D :S [:ref :stream] [:ref :stream] :C :D :D]\n   :link-response [:D :S [:ref :stream] [:ref :stream] :C]\n   :install [:S]})\n\n\n(def row-table\n  \"Slot descriptors, excluding id and kind. :repeat/:pairs are variadic;\n   :refs is an ordered vector of structural references. :pending is\n   discriminated by pending-table. Nothing in this table is executable.\"\n  {:vec [:repeat :V] :list [:repeat :V] :set [:repeat :V]\n   :map [:pairs :V :V] :bindings [:pairs :S :V] :store [:pairs :D :V]\n   :env [[:ref :bindings] :optional-D]\n   :closure [:A :N :syms [:ref :bindings] :optional-D]\n   :prim [:S] :stream [:D :D] :reified [[:ref :act]] :parked-ref [:D]\n   :act [:A :N [:ref :env] [:ref :window] [:ref :k] :N]\n   :tail [:A :N [:ref :k]]\n   :window [:pairs :N :V] :k [:repeat [:ref :kframe]]\n   :kframe [:A :N [:ref :env] [:ref :window] :N]\n   :wait [[:ref :act :tail] [:ref :pending]] :pending :pending\n   :module-store [:D [:ref :store]]\n   :parked-table [:pairs :D [:ref :act :tail]]\n   :install [:S :D :D :D [:ref :task]]\n   :cursor-cells [:pairs :C [:ref :cursor-cell-body]] :cursor-cell-body [[:ref :stream] :D]\n   :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n          [:refs :module-store] [:ref :parked-table] [:ref :cursor-cells]\n          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n\n\n(defn node\n  [kind slots]\n  {:kind kind :slots (if (= :window kind)\n                       (vec (mapcat identity (sort-by first (partition 2 slots))))\n                       (vec slots))})\n\n\n(defn- refuse!\n  [status kind path]\n  (throw (ex-info \"Row codec refused data\"\n                  {:yin.k/status status :yin.k/kind kind :yin.k/path path})))\n\n\n(defn- bad!\n  [kind path]\n  (refuse! :yin.k/undecodable kind path))\n\n\n(defn- marker-shaped?\n  [x]\n  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cursor-cell))))\n\n\n(defn- check-literal-markers!\n  [x]\n  (when (marker-shaped? x) (refuse! :yin.k/non-portable :marker []))\n  (when (coll? x)\n    (doseq [v (if (map? x) (mapcat identity x) x)] (check-literal-markers! v)))\n  (when (meta x) (check-literal-markers! (meta x))))\n\n\n(defn- bytes-key\n  [bs]\n  ;; Unsigned bytewise order, without a length-first comparison.\n  (mapv #(bit-and (int %) 255) (seq bs)))\n\n\n(defn- compare-bytes\n  [a b]\n  (loop [i 0]\n    (cond\n      (= i (count a)) (if (= i (count b)) 0 -1)\n      (= i (count b)) 1\n      (= (nth a i) (nth b i)) (recur (inc i))\n      :else (compare (nth a i) (nth b i)))))\n\n\n(defn- byte-compare\n  [a b]\n  (compare-bytes (bytes-key (cbor/encode a)) (bytes-key (cbor/encode b))))\n\n\n(defn- sorted-bytes\n  [xs]\n  (vec (sort byte-compare xs)))\n\n\n(defn- descriptors\n  [kind slots]\n  (let [schema (get row-table kind)]\n    (cond\n      (= schema :pending) (into [:D] (get pending-table (first slots)))\n      (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n      (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n      :else schema)))\n\n\n(defn- ref?\n  [d]\n  (and (vector? d) (= :ref (first d))))\n\n\n(defn- refs?\n  [d]\n  (and (vector? d) (= :refs (first d))))\n\n\n(def ^:private census-key #\"cc-([1-9][0-9]*)\")\n\n\n(defn- census-order\n  ;; Numeric order of cc-N without reading wire data: fewer digits first,\n  ;; then the