dex c69d394d..caea2b0f 100644\n--- a/src/cljc/yin/vm/ucf/authority/completion.cljc\n+++ b/src/cljc/yin/vm/ucf/authority/completion.cljc\n@@ -7,8 +7,8 @@\n    `:yin.k/resumed` naming the successor's address, then release.\n    `report!` admits the report: the reporting author must be the\n    lease's holder, the lease live, its occurrence not quarantined, and\n-   the successor's bytes must pass the inspector (yin.vm.ucf.checkpoint:\n-   the address, version 1, the root role) with an origin naming this\n+   the successor's bytes must pass the inspector (yin.vm.ucf.rows.checkpoint:\n+   the pack address, version 3, the root's custody slot) with an origin naming this\n    occurrence and lease.  A continuation must also name the same\n    arbitration identity, be an occurrence the ledger has never seen, and\n    carry a counter that continues the predecessor's (`:yin.k/next-op-seq`\n@@ -41,7 +41,7 @@\n    grantable.\"\n   (:require [dao.jing.cbor :as cbor]\n             [yin.vm.ucf.authority :as authority]\n-            [yin.vm.ucf.checkpoint :as checkpoint]\n+            [yin.vm.ucf.rows.checkpoint :as checkpoint]\n             [yin.vm.ucf.custody :as custody]\n             [yin.vm.ucf.ledger :as ledger]))\n \ndiff --git a/src/cljc/yin/vm/ucf/authority/grant.cljc b/src/cljc/yin/vm/ucf/authority/grant.cljc\nindex 149957a2..37227b9f 100644\n--- a/src/cljc/yin/vm/ucf/authority/grant.cljc\n+++ b/src/cljc/yin/vm/ucf/authority/grant.cljc\n@@ -4,9 +4,10 @@\n    docs/design/yin.vm.linker.dht.md 14.2.2 and 14.2.3).\n \n    `offer!` admits one snapshot variant of an occurrence: it inspects\n-   the bytes (yin.vm.ucf.checkpoint), stores the accepted body in a\n-   content store, and only then commits the offer fact with its\n-   operation baseline, so the ledger never references missing content.\n+   the bytes (yin.vm.ucf.rows.checkpoint, a version-3 row pack), stores\n+   the accepted pack in a content store under its pack address, and only\n+   then commits the offer fact with its operation baseline, so the ledger\n+   never references missing content.\n    An uninspectable body commits nothing and stores nothing.  An offer\n    of a recorded variant is a replay; a known occurrence offered with\n    another origin, or a variant with another baseline, is refused.\n@@ -45,7 +46,7 @@\n             [dao.stream :as stream]\n             [yin.vm.ucf.authority :as authority]\n             [yin.vm.ucf.authority.completion :as completion]\n-            [yin.vm.ucf.checkpoint :as checkpoint]\n+            [yin.vm.ucf.rows.checkpoint :as checkpoint]\n             [yin.vm.ucf.custody :as custody]\n             [yin.vm.ucf.ledger :as ledger]))\n \n","exit_code":0,"status":"completed"}}
