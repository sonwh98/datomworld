{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '700,735p;1158,1317p;1690,1759p;1899,2020p;2205,2220p' src/cljc/yin/vm/ucf/rows.cljc\"","aggregated_output":"     (if-let [refused (:refused r)] (unresolved! refused []) (:numbering r)))))\n\n\n(defn- child-numberer\n  \"Numbers an install child in its own scope under budget; a refusal's path\n   is prefixed by the install's row path [12 <name> ...].\"\n  [budget]\n  (fn [child path]\n    (let [r (discovery-numbering child budget (atom {}))]\n      (if-let [refused (:refused r)] (unresolved! refused path) (:numbering r)))))\n\n\n(defn- pack\n  \"The carrier of root id over the row map rows, sorted by row id. Ids are\n   BLAKE3 segment keywords of one length, so their printed order is their\n   byte order: one root gives one pack, and one pack address, on every\n   host (phase-7 plan §3.3).\"\n  [id rows]\n  {:yin.k/handoff true :yin.k/version 3 :yin.k/root id\n   :yin.k/rows (mapv val (sort-by #(str (key %)) rows))})\n\n\n(defn emit-numbered\n  \"Emit under a supplied numbering. Useful for canonicality probes;\n   ordinary callers use emit, which computes the canonical numbering.\n   number-child, (fn [child path] numbering), numbers install children;\n   by default canonically.\"\n  ([task numbering] (emit-numbered task numbering (child-numberer default-budget)))\n  ([task numbering number-child]\n   (let [[id rows] (emit-node task numbering {} [] number-child)]\n     (pack id rows))))\n\n\n(defn emit\n  \"Emit an abstract task as a self-contained carrier. This is a codec,\n   not lift-task: the caller supplies the complete abstract row tree.\"\n(def max-exact\n  \"2^52-1, the largest sequence or counter (7.7.8).\"\n  4503599627370495)\n\n\n(def ^:private custody-keys\n  #{:yin.k/policy :yin.k/occurrence :yin.k/arbitration :yin.k/next-op-seq :yin.k/origin})\n\n\n(def write-slots\n  \"Retained write reason -> [target payload op-id], indices into its\n   :pending row's slots (the reason at 0).\"\n  {:put [1 2 3] :ffi-request [3 2 6] :link-request [3 6 7]})\n\n\n(defn- custody-refuse!\n  [kind path]\n  (refuse! :yin.k/undecodable kind path))\n\n\n(defn- check-origin!\n  [c]\n  (let [origin (get c :yin.k/origin) p [:custody :yin.k/origin]]\n    (when-not (and (map? origin)\n                   (custody/occurrence? (get origin :yin.k/occurrence))\n                   (some? (get origin :dao.lease/lease))\n                   (some? (get origin :yin.k/emitter)))\n      (custody-refuse! :malformed-origin p))\n    (when (cbor/content= (get origin :yin.k/occurrence) (get c :yin.k/occurrence))\n      (custody-refuse! :origin-is-self (conj p :yin.k/occurrence)))))\n\n\n(defn- check-root-custody!\n  \"A non-nil root slot by kind: the version-1 header rules\n   (checkpoint.cljc's check-root-header!) on the slot's map.\"\n  [c kind]\n  (when-not (map? c) (custody-refuse! :malformed-custody [:custody]))\n  (when-some [k (first (sort-by str (remove custody-keys (keys c))))]\n    (custody-refuse! :custody-key [:custody k]))\n  (if (= :halted kind)\n    (do (doseq [k [:yin.k/policy :yin.k/occurrence :yin.k/arbitration :yin.k/next-op-seq]\n                :when (contains? c k)]\n          (custody-refuse! :halted-header [:custody k]))\n        (when-not (contains? c :yin.k/origin) (custody-refuse! :missing-header [:custody :yin.k/origin]))\n        (check-origin! c))\n    (do (doseq [k [:yin.k/policy :yin.k/occurrence :yin.k/arbitration :yin.k/next-op-seq]\n                :when (not (contains? c k))]\n          (custody-refuse! :missing-header [:custody k]))\n        (when-not (= :yin.k/exclusive (get c :yin.k/policy))\n          (custody-refuse! :policy [:custody :yin.k/policy]))\n        (when (nil? (get c :yin.k/occurrence)) (custody-refuse! :nil-occurrence [:custody :yin.k/occurrence]))\n        (when-not (custody/occurrence? (get c :yin.k/occurrence))\n          (custody-refuse! :malformed-occurrence [:custody :yin.k/occurrence]))\n        (let [arb (get c :yin.k/arbitration)]\n          (when-not (and (map? arb) (some? (get arb :dao.stream/identity)) (map? (get arb :dao.stream/descriptor)))\n            (custody-refuse! :malformed-arbitration [:custody :yin.k/arbitration])))\n        (let [n (get c :yin.k/next-op-seq)]\n          (when-not (custody/exact? n) (custody-refuse! :inexact [:custody :yin.k/next-op-seq]))\n          (when (and (not (contains? c :yin.k/origin)) (not (cbor/num= 0 n)))\n            (custody-refuse! :first-export-counter [:custody :yin.k/next-op-seq])))\n        (when (contains? c :yin.k/origin) (check-origin! c)))))\n\n\n(defn- check-op-id!\n  \"One carried id against the root context: its shape, an origin present,\n   never the root's own occurrence, below the root counter (checkpoint.cljc's\n   check-op-id!, verbatim).\"\n  [ctx op-id p]\n  (when-not (and (map? op-id) (= 2 (count op-id))\n                 (custody/occurrence? (get op-id :yin.k/occurrence))\n                 (contains? op-id :yin.k/seq))\n    (custody-refuse! :malformed-op-id p))\n  (when-not (custody/exact? (get op-id :yin.k/seq)) (custody-refuse! :inexact (conj p :yin.k/seq)))\n  (when-not (contains? ctx :yin.k/origin) (custody-refuse! :op-id-without-origin p))\n  (when (cbor/content= (get op-id :yin.k/occurrence) (get ctx :yin.k/occurrence))\n    (custody-refuse! :op-id-own-occurrence p))\n  ;; a :halted root has no counter, so no id can be below it\n  (when-not (and (contains? ctx :yin.k/next-op-seq)\n                 (neg? (cbor/num-compare (get op-id :yin.k/seq) (get ctx :yin.k/next-op-seq))))\n    (custody-refuse! :op-seq-range (conj p :yin.k/seq))))\n\n\n(defn- wire-slot\n  \"A V slot as the wire holds it: a [:row n] is [:row id].\"\n  [x]\n  (if (and (vector? x) (= :row (first x))) [:row (first (emit-node (second x) {} {}))] x))\n\n\n(defn- task-ops\n  \"[path op-id intent] of every id the waits of task carry, then of each\n   install child in carried (module-name) order, in the root's context.\n   Checks each task's kind and role, each :install pending's install row,\n   and that a child's custody slot is nil.\"\n  [ctx task role path]\n  (let [[_ _ kind role' _ _ _ _ _ _ _ _ installs waits] (:slots task)\n        names (into #{} (map #(first (:slots %))) installs)]\n    (when-not (contains? #{:blocked :parked :halted} kind) (custody-refuse! :kind (conj path :kind)))\n    (when-not (= role role') (custody-refuse! :role (conj path :role)))\n    (into (into []\n                (keep-indexed\n                  (fn [i w]\n                    (let [ss (:slots (second (:slots w)))\n                          reason (first ss)\n                          p (conj path :frames i)]\n                      (when (and (= :install reason) (not (contains? names (second ss))))\n                        (custody-refuse! :incomplete-install p))\n                      (when-let [[t payload o] (get write-slots reason)]\n                        (when-some [op-id (nth ss o)]\n                          (let [p (conj p :op-id)]\n                            (when (::fork ctx) (custody-refuse! :fork-op-id p))\n                            (check-op-id! ctx op-id p)\n                            [p op-id [:yin.k/append (first (:slots (nth ss t))) (wire-slot (nth ss payload))]]))))))\n                waits)\n          (mapcat (fn [inst]\n                    (let [[mn _ _ _ child] (:slots inst)\n                          p (conj path :installs mn)]\n                      (when (some? (nth (:slots child) 16)) (custody-refuse! :child-header (conj p :custody)))\n                      (task-ops ctx child :child p))))\n          installs)))\n\n\n(defn custody-baseline\n  \"The operation baseline of root task (decoded, or abstract before emit),\n   or the first refusal thrown as ex-data {:yin.k/status :yin.k/undecodable\n   :yin.k/kind :yin.k/path}. Answers {:yin.k/kind k :yin.k/ops {op-id\n   digest}} plus the slot's :yin.k/occurrence, :yin.k/origin,\n   :yin.k/arbitration and :yin.k/next-op-seq, or :yin.k/fork true for a nil\n   slot, whose tree carries no id. digest is the BLAKE3 hex of the canonical\n   bytes of [:yin.k/append target-identity payload], the payload as the wire\n   slot holds it ([:lit x], [:row id], or a :link-request's plain envelope).\"\n  [task]\n  (let [slots (:slots task) kind (nth slots 2) c (nth slots 16) fork? (nil? c)]\n    (when-not (contains? #{:blocked :parked :halted} kind) (custody-refuse! :kind [:kind]))\n    (when-not fork? (check-root-custody! c kind))\n    (let [ctx (cond-> (select-keys c [:yin.k/occurrence :yin.k/origin :yin.k/next-op-seq]) fork? (assoc ::fork true))\n          ops (reduce (fn [acc [p op-id in]]\n                        (let [k (cbor/content-key op-id)]\n                          (when (contains? (:seen acc) k) (custody-refuse! :duplicate-op-id p))\n                          (-> acc (update :seen conj k)\n                              (assoc-in [:ops op-id] (jing/digest-bytes :blake3 (cbor/encode in))))))\n                      {:seen #{} :ops {}}\n                      (task-ops ctx task :root []))]\n      (cond-> (merge (select-keys c [:yin.k/occurrence :yin.k/origin :yin.k/arbitration :yin.k/next-op-seq])\n                     {:yin.k/kind kind :yin.k/ops (:ops ops)})\n        fork? (assoc :yin.k/fork true)))))\n\n\n(defn pack-address\n  \"The storage identity of a carrier: the BLAKE3 segment address of its\n   canonical bytes, distinct from the semantic root id it carries (§3.3).\"\n  [wire]\n  (jing/segment-key wire))\n\n\n;; =============================================================================\n;; Task transport (continuation design §7): lift-task and lower-task\n;; =============================================================================\n;;\n;; The lift walks a quiescent semantic-register machine into the abstract\n;; task the codec above emits: waits, parked records, the store, module\n(defn- header-custody\n  \"The root's custody slot from the caller's header, by kind: blocked or\n   parked takes the occurrence, arbitration, counter and the exclusive\n   policy, and the origin when the header names one; halted the origin\n   alone (an empty map without one, which the grammar refuses). A nil\n   value is an absent key (handoff.cljc's header-of).\"\n  [header kind]\n  (into {}\n        (filter (comp some? val))\n        (if (= :halted kind)\n          (select-keys header [:yin.k/origin])\n          (assoc (select-keys header [:yin.k/occurrence :yin.k/arbitration :yin.k/next-op-seq :yin.k/origin])\n                 :yin.k/policy :yin.k/exclusive))))\n\n\n(defn- protect!\n  \"Every retained write of the tree under the header's enrolled set (UCF\n   7.4.3, 7.7.8; handoff.cljc's protected!): an enrolled target without an\n   operation id is :unprotected-pending, an id on an unenrolled target is\n   :yin.k/unsatisfied naming the stream.\"\n  [task enrolled]\n  (doseq [[t _] (task-tree task :root)\n          w (nth (:slots t) 13)]\n    (let [ss (:slots (second (:slots w)))]\n      (when-let [[ti _ oi] (get write-slots (first ss))]\n        (let [identity (first (:slots (nth ss ti)))\n              enrolled? (contains? enrolled identity)\n              carried? (some? (nth ss oi))]\n          (cond\n            (and enrolled? (not carried?))\n            (outcome! :yin.k/non-portable :unprotected-pending {:dao.stream/identity identity})\n            (and carried? (not enrolled?))\n            (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})\n            :else nil))))))\n\n\n(defn lift-task\n  \"The lift of §7.1: quiescent semantic-register machine m as a version-3\n   carrier, or a refusal thrown as ex-data {:yin.k/status :yin.k/kind}.\n   serve! is the exporter's remote-table entry (yin.vm.ucf.remote).\n   opts: :free-env, the task's initial free environment (default: the\n   kernel's retained :free-env field; the explicit value overrides it);\n   :source-index, {A #{tree-address}} the composition knows (§6.1), which\n   must cover every carried segment; :budget, the numbering budget;\n   :header, the exclusive custody header (occurrence, arbitration,\n   next-op-seq, origin when the task has a predecessor, and\n   :yin.k/enrolled, the enrolled stream identities, a lift input that\n   never travels). No header is the fork: custody nil. A header writes the\n   root's slot by kind (header-custody), refuses :op-seq-exhausted at\n   2^52-1 on a blocked or parked root, and protects every retained write\n   of the tree (protect!). Before emitting, the lift runs custody-baseline\n   over the task, so it never emits a carrier the inspector refuses.\"\n  ([m serve!] (lift-task m serve! {}))\n  ([m serve! opts]\n   (let [opts (or opts {})\n         header (:header opts)\n         task (lift-task* m serve! opts :root)\n         kind (nth (:slots task) 2)\n         task (if (nil? header)\n                task\n                (let [n (:yin.k/next-op-seq header)]\n                  (when (and (not= :halted kind) (cbor/numeric? n) (cbor/num= n max-exact))\n                    (outcome! :yin.k/non-portable :op-seq-exhausted {:yin.k/next-op-seq n}))\n                  (protect! task (or (:yin.k/enrolled header) #{}))\n                  (assoc-in task [:slots 16] (header-custody header kind))))]\n     (custody-baseline task)\n     (emit task (merge default-budget (:budget opts))))))\n\n\n(def ^:private fixed-resource-keys\n(defn- accept-grant!\n  \"The grant checks of a blocked or parked exclusive root (handoff.cljc's\n   accept-grant!, ported verbatim, keyed off the root's custody slot c and\n   the carrier's pack address): evidence, binding, lease, holder,\n   arbitration, epoch, tenure and the input prefix; then protection in both\n   directions over every stream row of the tree, and op-id presence equal\n   to enrollment on every retained write. Answers the custody state the\n   restored root holds, its counter the slot's exactly.\"\n  [task c address opts]\n  (let [grant (:grant opts)\n        evidence (:evidence grant)]\n    (when-not (and (or (nil? grant) (map? grant))\n                   (or (nil? evidence) (map? evidence)))\n      (throw (ex-info \"Malformed lower grant or evidence\" {})))\n    (when-not evidence\n      (outcome! :yin.k/awaiting-grant nil {}))\n    (when-not (= :yin.k/ready (:yin.k/status evidence))\n      (outcome! (if (= :yin.k/awaiting-grant (:yin.k/status evidence))\n                  :yin.k/awaiting-grant :yin.k/unsatisfied)\n                nil (dissoc evidence :yin.k/status)))\n    (let [binding (:yin.k/binding evidence)\n          prefix (:yin.k/prefix evidence)\n          tenure (:tenure grant)\n          occurrence (:yin.k/occurrence c)\n          lease (:dao.lease/lease grant)\n          holder (:dao.lease/holder grant)\n          frontier (:yin.k/frontier prefix)\n          records (:yin.k/inputs prefix)]\n      (when-not (and (map? binding) (map? tenure))\n        (throw (ex-info \"Malformed lower binding or tenure\" {})))\n      (when (or (nil? prefix) (:yin.k/status prefix))\n        (outcome! :yin.k/unsatisfied nil {:yin.k/reason (or (:yin.k/reason prefix) :unavailable)}))\n      (when-not (and (= (:checkpoint grant) address)\n                     (= occurrence (:yin.k/occurrence binding))\n                     (some? lease) (= lease (:dao.lease/lease binding))\n                     (some? holder) (= holder (:dao.lease/holder binding))\n                     (= (get-in c [:yin.k/arbitration :dao.stream/identity])\n                        (get-in binding [:yin.k/transaction :yin.k/arbitration]))\n                     (custody/exact? (:yin.k/epoch binding))\n                     (true? (:live tenure))\n                     (number? (:now tenure)) (number? (:bound tenure))\n                     (< (:now tenure) (:bound tenure))\n                     (= occurrence (:yin.k/occurrence prefix))\n                     (= lease (:dao.lease/lease prefix))\n                     (custody/exact? frontier) (vector? records)\n                     (= frontier (count records))\n                     (every? true? (map-indexed\n                                     (fn [index record]\n                                       (and (custody/exact? (:yin.k/input-seq record))\n                                            (= index (:yin.k/input-seq record))))\n                                     records)))\n        (outcome! :yin.k/not-holder nil {}))\n      (let [classes (:protection opts)\n            enrolled (:yin.k/enrolled evidence)]\n        (when-not (and (map? classes)\n                       (every? #{:enrolled :at-least-once :fail-stop} (vals classes))\n                       (set? enrolled))\n          (throw (ex-info \"Malformed lower protection or enrollment\" {})))\n        (doseq [s (rows-of task :stream false)]\n          (let [identity (first (:slots s))\n                class (get classes identity)]\n            (when-not (and class (= (= class :enrolled) (contains? enrolled identity)))\n              (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity}))))\n        (doseq [[t _] (task-tree task :root)\n                w (nth (:slots t) 13)\n                :let [ss (:slots (second (:slots w)))\n                      [ti _ oi] (get write-slots (first ss))]\n                :when ti]\n          (let [identity (first (:slots (nth ss ti)))]\n            (when-not (= (= :enrolled (get classes identity)) (some? (nth ss oi)))\n              (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity}))))\n        {:yin.k/occurrence occurrence\n         :dao.lease/lease lease :dao.lease/holder holder\n         :yin.k/epoch (:yin.k/epoch binding)\n         :yin.k/arbitration (:yin.k/arbitration c)\n         :yin.k/next-op-seq (:yin.k/next-op-seq c)\n         :protection classes :input {:next 0 :prefix prefix}\n         :tenure {:bound (:bound tenure)}}))))\n\n\n(defn- check-custody!\n  \"Step 10, once for the tree after the three staged checks: the custody\n   grammar (custody-baseline), then by the root's slot: a fork (nil) is\n   refused under :exclusive as :yin.k/profile-mismatch; an exclusive\n   blocked or parked root runs the grant checks unless :fenced (an\n   administrative rehydration: no grant, gate :exporting); a halted\n   exclusive root needs no grant and is gated :ended. Answers\n   {:exclusive? :fenced? :state}, which restore applies to every task.\"\n  [task wire opts]\n  (custody-baseline task)\n  (let [[_ _ kind] (:slots task) c (nth (:slots task) 16) fenced? (boolean (:fenced opts))]\n    (if (nil? c)\n      (do (when (:exclusive opts)\n            (outcome! :yin.k/profile-mismatch nil {:yin.k/policy :yin.k/exclusive}))\n          {:exclusive? false :fenced? fenced?})\n      {:exclusive? true :fenced? fenced?\n       :state (when-not (or fenced? (= :halted kind)) (accept-grant! task c (pack-address wire) opts))})))\n\n\n(defn- with-custody\n  \"Restore's custody for one task of the tree: an exclusive tree numbers\n   its retained :put waits (:yin.k/issue, :yin.k/issued, in carried\n   order) and gates :running, a halted exclusive root :ended, the root\n   holding the grant's custody state; a fenced tree gates :exporting with\n   its waits outside the scheduler (:yin.k/recovery-waits).\"\n  [m {:keys [exclusive? fenced? state]} kind root?]\n  (let [m (if exclusive?\n            (let [[entries issued] (reduce (fn [[acc i] e]\n                                             (if (= :put (:reason e))\n                                               [(conj acc (assoc e :yin.k/issue i)) (inc i)]\n                                               [(conj acc e) i]))\n                                           [[] 0] (:wait-set m))]\n              (cond-> (assoc m :wait-set entries :yin.k/issued issued\n                             :yin.k/gate (if (and root? (= :halted kind)) :ended :running))\n                (and root? (some? state)) (assoc :yin.k/custody state)))\n            m)]\n    (if fenced?\n      (assoc m :yin.k/gate :exporting :yin.k/recovery-waits (:wait-set m) :wait-set [])\n      m)))\n\n\n(defn- attach-streams!\n   required by a blocked or parked exclusive root (handoff.cljc's reader\n   contract: the grant names :checkpoint, the pack address, its lease,\n   holder, tenure and evidence; :protection maps every stream identity of\n   the tree to its class); :fenced, an administrative rehydration that\n   skips the grant.\"\n  ([recv wire attach!] (lower-task recv wire attach! {}))\n  ([recv wire attach! opts]\n   (let [task (decode wire (merge default-budget (:budget opts)))]\n     (when-not (= :task (:kind task)) (outcome! :yin.k/undecodable :root {}))\n     ;; each step over the whole tree before the next (§3.3)\n     (doseq [step [check-stores! check-pendings! check-dependencies!]\n             [t role] (task-tree task :root)]\n       (step recv t role))\n     (let [custody (check-custody! task wire opts)]\n       (restore-task recv task (attach-streams! attach! task) custody true)))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'cat test/yin/vm/ucf/rows_custody_test.cljc; cat test/yin/vm/ucf/rows_checkpoint_test.cljc'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'cat test/yin/vm/ucf/rows_custody_test.cljc; cat test/yin/vm/ucf/rows_checkpoint_test.cljc'","aggregated_output":"(ns yin.vm.ucf.rows-custody-test\n  \"Phase 7a: custody on rows (phase-7 plan §3.1). The lift under a header\n   writes the root's custody slot by kind and refuses :op-seq-exhausted,\n   :unprotected-pending and an id on an unenrolled stream; the lower's\n   custody stage runs the custody grammar, refuses a fork under\n   :exclusive, runs the version-1 grant checks on a blocked or parked\n   exclusive root, protection in both directions and op-id presence equal\n   to enrollment, restores the counter exactly, lowers a halted exclusive\n   root with no grant gated :ended, and every refusal comes before the\n   first attach (zero attachments). The version-1 rules these re-pin are\n   lift_v1_test's and handoff_v2_custody_test's, kept until phase 8.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [yin.vm :as vm]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-checkpoint-fixtures :as f]\n            [yin.vm.ucf.rows-support :as s]))\n\n\n(defn- custody-of\n  [wire]\n  (nth (:slots (rows/decode wire)) 16))\n\n\n(defn- identities\n  \"Every stream identity of the pack's tree.\"\n  [wire]\n  (into #{} (keep (fn [r] (when (= :stream (second r)) (nth r 2)))) (:yin.k/rows wire)))\n\n\n;; =============================================================================\n;; The lift under a header\n;; =============================================================================\n\n(deftest the-lift-writes-the-custody-slot-by-kind\n  (testing \"a first park: the exclusive policy, no origin\"\n    (is (= {:yin.k/policy :yin.k/exclusive :yin.k/occurrence s/occurrence\n            :yin.k/arbitration s/arbitration :yin.k/next-op-seq 0}\n           (custody-of (s/lift (s/parked-reader) (s/header 0 nil #{}))))))\n  (testing \"a successor carries its origin\"\n    (is (= {:yin.k/policy :yin.k/exclusive :yin.k/occurrence s/occurrence :yin.k/origin s/origin\n            :yin.k/arbitration s/arbitration :yin.k/next-op-seq 1}\n           (custody-of (s/lift (s/parked-explicit) (s/header 1))))))\n  (testing \"a halted root carries the origin alone\"\n    (is (= {:yin.k/origin s/origin} (custody-of (s/lift (s/halted-machine) (s/header 0 s/origin #{}))))))\n  (testing \"the enrolled set is a lift input that never travels\"\n    (let [wire (s/lift (s/with-op-id (s/parked-writer) :put (s/op-id 0)) (s/header 3 s/origin #{\"s0\"}))]\n      (is (not (contains? (custody-of wire) :yin.k/enrolled)))))\n  (testing \"no header is the fork: nil, on every kind\"\n    (doseq [m [(s/parked-reader) (s/parked-explicit) (s/halted-machine)]]\n      (is (nil? (custody-of (s/lift m nil))))))\n  (testing \"an install child's slot is nil\"\n    (let [task (rows/decode (f/base \"installs\"))]\n      (is (some? (nth (:slots task) 16)))\n      (is (nil? (nth (:slots (f/child task 'host.mod)) 16))))))\n\n\n(deftest the-lift-refuses-what-custody-forbids\n  (testing \"a counter at 2^52-1 on a blocked root\"\n    (is (= {:yin.k/status :yin.k/non-portable :yin.k/kind :op-seq-exhausted :yin.k/next-op-seq rows/max-exact}\n           (s/lift (s/parked-reader) (s/header rows/max-exact s/origin #{})))))\n  (testing \"a halted root ignores the counter\"\n    (is (nil? (:yin.k/status (s/lift (s/halted-machine) (s/header rows/max-exact s/origin #{}))))))\n  (testing \"a retained write on an enrolled stream without an id\"\n    (is (= {:yin.k/status :yin.k/non-portable :yin.k/kind :unprotected-pending :dao.stream/identity \"s0\"}\n           (s/lift (s/parked-writer) (s/header 3 s/origin #{\"s0\"})))))\n  (testing \"an id on a stream that is not enrolled\"\n    (is (= {:yin.k/status :yin.k/unsatisfied :dao.stream/identity \"s0\"}\n           (s/lift (s/with-op-id (s/parked-writer) :put (s/op-id 0)) (s/header 3 s/origin #{})))))\n  (testing \"the same rules in an install child\"\n    (let [m (assoc-in (s/parked-installer) [:installs 'host.mod :vm] (s/parked-writer))]\n      (is (= :unprotected-pending (:yin.k/kind (s/lift m (s/header 6 s/origin #{\"s0\"}))))))\n    (let [m (assoc-in (s/parked-installer) [:installs 'host.mod :vm]\n                      (s/with-op-id (s/parked-writer) :put (s/op-id 4)))]\n      (is (= {:yin.k/status :yin.k/unsatisfied :dao.stream/identity \"s0\"}\n             (s/lift m (s/header 6 s/origin #{}))))))\n  (testing \"a halted root with a header but no origin is refused, not downgraded\"\n    (is (= {:yin.k/status :yin.k/undecodable :yin.k/kind :missing-header :yin.k/path [:custody :yin.k/origin]}\n           (select-keys (s/lift (s/halted-machine) (s/header 0 nil #{})) [:yin.k/status :yin.k/kind :yin.k/path]))))\n  (testing \"the lift runs the inspector's grammar before emitting\"\n    (is (= :op-seq-range (:yin.k/kind (s/lift (s/with-op-id (s/parked-writer) :put (s/op-id 3))\n                                              (s/header 3 s/origin #{\"s0\"})))))\n    (is (= :fork-op-id (:yin.k/kind (s/lift (s/with-op-id (s/parked-writer) :put (s/op-id 0)) nil))))))\n\n\n;; =============================================================================\n;; The lower's custody stage\n;; =============================================================================\n\n(defn- grant-for\n  \"A grant whose every part agrees with wire's custody: lease-1 to\n   holder-a at epoch 0, live tenure, an empty input prefix.\"\n  [wire enrolled]\n  (let [c (custody-of wire)\n        o (:yin.k/occurrence c)]\n    {:checkpoint (rows/pack-address wire)\n     :dao.lease/lease \"lease-1\" :dao.lease/holder \"holder-a\"\n     :tenure {:live true :now 0 :bound 10}\n     :evidence {:yin.k/status :yin.k/ready\n                :yin.k/binding {:yin.k/occurrence o :dao.lease/lease \"lease-1\" :dao.lease/holder \"holder-a\"\n                                :yin.k/transaction {:yin.k/arbitration (get-in c [:yin.k/arbitration :dao.stream/identity])}\n                                :yin.k/epoch 0}\n                :yin.k/prefix {:yin.k/occurrence o :dao.lease/lease \"lease-1\" :yin.k/frontier 0 :yin.k/inputs []}\n                :yin.k/enrolled enrolled}}))\n\n\n(defn- protection-for\n  [wire enrolled]\n  (into {} (map (fn [i] [i (if (contains? enrolled i) :enrolled :at-least-once)])) (identities wire)))\n\n\n(defn- lowered\n  \"[machine-or-refusal attaches] of wire lowered into a fresh receiver.\"\n  [wire opts]\n  (let [{:keys [attach! count]} (s/attacher)\n        r (try (rows/lower-task (s/receiver) wire attach! opts)\n               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n                 (or (ex-data e) (throw e))))]\n    [r @count]))\n\n\n(defn- exclusive-opts\n  [wire enrolled]\n  {:grant (grant-for wire enrolled) :protection (protection-for wire enrolled)})\n\n\n(defn- refused\n  \"The refusal of wire lowered under opts, asserting zero attachments.\"\n  [wire opts]\n  (let [[r n] (lowered wire opts)]\n    (is (zero? n) (str \"refused before any attachment: \" (pr-str (select-keys r [:yin.k/status :yin.k/kind]))))\n    r))\n\n\n(def ^:private successor (delay (f/base \"successor\")))\n\n\n(deftest an-exclusive-root-lowers-under-its-grant\n  (let [wire @successor\n        [m n] (lowered wire (exclusive-opts wire #{\"s0\"}))]\n    (is (pos? n))\n    (is (= {:yin.k/occurrence s/occurrence :dao.lease/lease \"lease-1\" :dao.lease/holder \"holder-a\"\n            :yin.k/epoch 0 :yin.k/arbitration s/arbitration :yin.k/next-op-seq 3\n            :protection {\"s0\" :enrolled}\n            :input {:next 0 :prefix (get-in (grant-for wire #{\"s0\"}) [:evidence :yin.k/prefix])}\n            :tenure {:bound 10}}\n           (:yin.k/custody m))\n        \"custody from the evidence, the counter the slot's exactly\")\n    (is (= :running (:yin.k/gate m)))\n    (is (= 1 (:yin.k/issued m)))\n    (let [put (first (filter #(= :put (:reason %)) (:wait-set m)))]\n      (is (= 0 (:yin.k/issue put)) \"retained writes are numbered in carried order\")\n      (is (= (s/op-id 0) (:op-id put)) \"the id travels verbatim\"))\n    (testing \"the restored task relifts to the same root under the same header\"\n      (is (= (:yin.k/root wire)\n             (:yin.k/root (rows/lift-task (dissoc m :yin.k/custody :yin.k/gate :yin.k/issued) (s/serve-table)\n                                          (s/lift-opts (s/header 3 s/origin #{\"s0\"})))))))))\n\n\n(deftest the-counter-is-restored-exactly\n  (doseq [k [0 3 7 (dec rows/max-exact)]]\n    (let [wire (f/edit-custody @successor #(assoc % :yin.k/next-op-seq (inc k)))\n          wire (f/edit-task wire (fn [t] (f/update-put t #(f/set-op-id % (s/op-id k)))))\n          [m _] (lowered wire (exclusive-opts wire #{\"s0\"}))]\n      (is (= (inc k) (get-in m [:yin.k/custody :yin.k/next-op-seq])) (str k)))))\n\n\n(deftest every-grant-check-refuses-before-any-attachment\n  (let [wire @successor\n        good (exclusive-opts wire #{\"s0\"})\n        g #(update good :grant %)\n        ev #(g (fn [x] (update x :evidence %)))]\n    (doseq [[label opts status]\n            [[\"no grant\" (dissoc good :grant) :yin.k/awaiting-grant]\n             [\"no evidence\" (g #(dissoc % :evidence)) :yin.k/awaiting-grant]\n             [\"evidence still awaiting\" (ev #(assoc % :yin.k/status :yin.k/awaiting-grant)) :yin.k/awaiting-grant]\n             [\"evidence unavailable\" (ev #(assoc % :yin.k/status :yin.k/unsatisfied)) :yin.k/unsatisfied]\n             [\"no input prefix\" (ev #(dissoc % :yin.k/prefix)) :yin.k/unsatisfied]\n             [\"an unreadable prefix\" (ev #(assoc-in % [:yin.k/prefix :yin.k/status] :yin.k/unsatisfied)) :yin.k/unsatisfied]\n             [\"another checkpoint: the root id is not the pack address\"\n              (g #(assoc % :checkpoint (:yin.k/root wire))) :yin.k/not-holder]\n             [\"a binding of another occurrence\" (ev #(assoc-in % [:yin.k/binding :yin.k/occurrence] s/predecessor)) :yin.k/not-holder]\n             [\"another lease\" (g #(assoc % :dao.lease/lease \"lease-2\")) :yin.k/not-holder]\n             [\"another holder\" (g #(assoc % :dao.lease/holder \"holder-b\")) :yin.k/not-holder]\n             [\"another arbitration\" (ev #(assoc-in % [:yin.k/binding :yin.k/transaction :yin.k/arbitration] \"arb-x\")) :yin.k/not-holder]\n             [\"an inexact epoch\" (ev #(assoc-in % [:yin.k/binding :yin.k/epoch] -1)) :yin.k/not-holder]\n             [\"a lapsed tenure\" (g #(assoc-in % [:tenure :live] false)) :yin.k/not-holder]\n             [\"a tenure past its bound\" (g #(assoc-in % [:tenure :now] 10)) :yin.k/not-holder]\n             [\"a prefix of another occurrence\" (ev #(assoc-in % [:yin.k/prefix :yin.k/occurrence] s/predecessor)) :yin.k/not-holder]\n             [\"a prefix of another lease\" (ev #(assoc-in % [:yin.k/prefix :dao.lease/lease] \"lease-2\")) :yin.k/not-holder]\n             [\"a frontier beyond its records\" (ev #(assoc-in % [:yin.k/prefix :yin.k/frontier] 1)) :yin.k/not-holder]\n             [\"a misnumbered record\" (ev #(assoc % :yin.k/prefix {:yin.k/occurrence s/occurrence :dao.lease/lease \"lease-1\"\n                                                                  :yin.k/frontier 1 :yin.k/inputs [{:yin.k/input-seq 1}]}))\n              :yin.k/not-holder]]]\n      (testing label\n        (is (= status (:yin.k/status (refused wire opts))))))\n    (testing \"a malformed grant is a defect, not a refusal\"\n      (is (thrown? #?(:cljd Object :clj Throwable :cljs :default)\n            (rows/lower-task (s/receiver) wire (:attach! (s/attacher)) (assoc good :grant :x))))\n      (is (thrown? #?(:cljd Object :clj Throwable :cljs :default)\n            (rows/lower-task (s/receiver) wire (:attach! (s/attacher)) (assoc good :protection nil)))))))\n\n\n(deftest protection-is-checked-in-both-directions\n  (let [wire @successor\n        good (exclusive-opts wire #{\"s0\"})]\n    (testing \"a stream with no class\"\n      (is (= {:yin.k/status :yin.k/unsatisfied :dao.stream/identity \"s0\"}\n             (refused wire (assoc good :protection {})))))\n    (testing \"a class saying enrolled for a stream the evidence does not enroll\"\n      (is (= :yin.k/unsatisfied\n             (:yin.k/status (refused wire (assoc-in good [:grant :evidence :yin.k/enrolled] #{}))))))\n    (testing \"an enrolled stream classed otherwise\"\n      (is (= :yin.k/unsatisfied (:yin.k/status (refused wire (assoc good :protection {\"s0\" :fail-stop}))))))\n    (testing \"the same on a stream no retained write targets, so no op-id check masks it\"\n      (let [reader (f/base \"first-park\")]\n        (is (= {:yin.k/status :yin.k/unsatisfied :dao.stream/identity \"s0\"}\n               (refused reader (assoc (exclusive-opts reader #{\"s0\"}) :protection {\"s0\" :at-least-once}))))\n        (is (vm/blocked? (first (lowered reader (exclusive-opts reader #{\"s0\"}))))\n            \"and lowers when the class agrees\"))))\n  (testing \"a write carrying no id on an enrolled stream\"\n    (let [wire (s/lift (s/parked-writer) (s/header 3 s/origin #{}))]\n      (is (= {:yin.k/status :yin.k/unsatisfied :dao.stream/identity \"s0\"}\n             (refused wire (exclusive-opts wire #{\"s0\"}))))))\n  (testing \"a write carrying an id on a stream not enrolled\"\n    (let [wire @successor]\n      (is (= {:yin.k/status :yin.k/unsatisfied :dao.stream/identity \"s0\"}\n             (refused wire (assoc (exclusive-opts wire #{}) :protection {\"s0\" :at-least-once})))))))\n\n\n(deftest the-grammar-runs-before-any-attachment\n  (doseq [n [\"op-id-at-counter\" \"custody-epoch\" \"missing-policy\" \"fork-op-id\" \"child-header\"]]\n    (testing n\n      (is (= (select-keys (f/refusal n) [:yin.k/status :yin.k/kind :yin.k/path])\n             (select-keys (refused (f/pack-of n) (exclusive-opts (f/pack-of n) #{\"s0\"}))\n                          [:yin.k/status :yin.k/kind :yin.k/path]))))))\n\n\n(deftest a-halted-exclusive-root-lowers-ended-with-no-grant\n  (let [[m n] (lowered (f/base \"halted-root\") {})]\n    (is (zero? n))\n    (is (vm/halted? m))\n    (is (= 42 (vm/value m)))\n    (is (= :ended (:yin.k/gate m)))\n    (is (nil? (:yin.k/custody m)))))\n\n\n(deftest a-fork-is-refused-under-exclusive\n  (let [wire (s/lift (s/parked-reader) nil)]\n    (is (= {:yin.k/status :yin.k/profile-mismatch :yin.k/policy :yin.k/exclusive}\n           (refused wire {:exclusive true})))\n    (testing \"and lowers as a fork without it: no custody, no gate\"\n      (let [[m n] (lowered wire {})]\n        (is (pos? n))\n        (is (vm/blocked? m))\n        (is (nil? (:yin.k/custody m)))\n        (is (nil? (:yin.k/gate m)))))))\n\n\n(deftest an-exclusive-blocked-root-under-fenced-skips-the-grant\n  (let [[m _] (lowered @successor {:fenced true})]\n    (is (= :exporting (:yin.k/gate m)))\n    (is (nil? (:yin.k/custody m)))\n    (is (empty? (:wait-set m)) \"its waits are outside the scheduler\")\n    (is (= [:put] (mapv :reason (:yin.k/recovery-waits m))))))\n\n\n(deftest install-children-lower-under-their-roots-custody\n  (let [wire (f/base \"installs\")\n        [m n] (lowered wire (exclusive-opts wire #{\"s0\"}))\n        child (get-in m [:installs 'host.mod :vm])]\n    (is (pos? n) (pr-str (select-keys m [:yin.k/status :yin.k/kind])))\n    (is (= 6 (get-in m [:yin.k/custody :yin.k/next-op-seq])))\n    (is (= :running (:yin.k/gate child)))\n    (is (nil? (:yin.k/custody child)) \"the child holds no custody of its own\")\n    (is (= [(s/op-id 4)] (keep :op-id (:wait-set child))))))\n(ns yin.vm.ucf.rows-checkpoint-test\n  \"Phase 7a: the rows inspector over the shared canonical fixtures. Every\n   fixture's bytes are pinned by the pack address\n   test/resources/yin/vm/ucf/rows-checkpoint-v3.txt records for it, and\n   three anchors are read as frozen bytes, so a rule about integer kind or\n   key presence is checked on the bytes, never on a host number type. The\n   pack address (storage) and the root id (semantic) are tested apart.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.cbor-fixtures :as fx]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-checkpoint-fixtures :as f]\n            [yin.vm.ucf.rows.checkpoint :as checkpoint]))\n\n\n(defn- inspect\n  [n]\n  (let [{:keys [address bytes]} (f/fixture n)]\n    (checkpoint/inspect address bytes)))\n\n\n(defn- intent-hex\n  [target payload]\n  (jing/digest-bytes :blake3 (cbor/encode [:yin.k/append target payload])))\n\n\n(defn- root-of\n  [n]\n  (:yin.k/root (f/pack-of n)))\n\n\n(deftest the-file-holds-exactly-the-declared-bytes\n  (is (= (f/render) (fx/read-path f/path))))\n\n\n;; =============================================================================\n;; Two identities: the pack address and the root id\n;; =============================================================================\n\n(deftest the-pack-address-is-storage-and-the-root-id-is-semantic\n  (doseq [n f/base-names\n          :let [{:keys [address bytes]} (f/fixture n)\n                wire (cbor/decode bytes)]]\n    (testing n\n      (is (= address (rows/pack-address wire) (f/segment-address bytes))\n          \"the pack address is the BLAKE3 of the pack's canonical bytes\")\n      (is (jing/segment-bytes-match? address bytes) \"a content store's put verifies it\")\n      (is (not= address (:yin.k/root wire)) \"the root id is another identity\")\n      (is (= (:yin.k/root wire)\n             (jing/segment-key (vec (rest (first (filter #(= (:yin.k/root wire) (first %)) (:yin.k/rows wire)))))))\n          \"the root id is the root row's own content address\")\n      (is (= (:yin.k/root wire) (:yin.k/root (inspect n))) \"the baseline names the root id\")\n      (is (= (mapv first (:yin.k/rows wire)) (sort-by str (mapv first (:yin.k/rows wire))))\n          \"emit sorts the rows by id\")\n      (is (= (fx/bytes->hex bytes) (fx/bytes->hex (cbor/encode (rows/emit (rows/decode wire)))))\n          \"one root, one pack: re-emitting the decoded task gives the same bytes\"))))\n\n\n(deftest a-pack-variant-of-one-root-shares-its-baseline\n  (let [base (inspect \"successor\")]\n    (testing \"the same rows in another order: another address, the same root and baseline\"\n      (is (not= (:address (f/fixture \"successor\")) (:address (f/fixture \"variant-equal\"))))\n      (is (= (root-of \"successor\") (root-of \"variant-equal\")))\n      (is (= base (inspect \"variant-equal\"))))\n    (testing \"another root with the same custody and ids: the baselines differ by the root alone\"\n      (let [v (inspect \"variant-other-root\")]\n        (is (not= (root-of \"successor\") (root-of \"variant-other-root\")))\n        (is (= (dissoc base :yin.k/root) (dissoc v :yin.k/root)))\n        (is (not= base v))))))\n\n\n;; =============================================================================\n;; Accepted shapes\n;; =============================================================================\n\n(deftest a-first-park-has-an-empty-baseline-at-zero\n  (is (= {:yin.k/kind :blocked :yin.k/root (root-of \"first-park\")\n          :yin.k/occurrence f/occurrence :yin.k/arbitration f/arbitration\n          :yin.k/next-op-seq 0 :yin.k/ops {}}\n         (inspect \"first-park\"))))\n\n\n(deftest a-successor-baseline-maps-each-carried-id-to-its-intent\n  (is (= {:yin.k/kind :blocked :yin.k/root (root-of \"successor\")\n          :yin.k/occurrence f/occurrence :yin.k/origin f/origin :yin.k/arbitration f/arbitration\n          :yin.k/next-op-seq 3\n          :yin.k/ops {(f/op-id 0) (intent-hex \"s0\" [:lit \"v\"])}}\n         (inspect \"successor\"))))\n\n\n(deftest variants-compare-by-baseline\n  (let [base (inspect \"successor\")]\n    (testing \"one id kept, its payload substituted\"\n      (let [v (inspect \"variant-different-intent\")]\n        (is (= (set (keys (:yin.k/ops base))) (set (keys (:yin.k/ops v)))))\n        (is (= (intent-hex \"s0\" [:lit \"w\"]) (get-in v [:yin.k/ops (f/op-id 0)])))\n        (is (not= base v))))\n    (testing \"the same ids and intents under another counter\"\n      (let [v (inspect \"variant-counter\")]\n        (is (= (:yin.k/ops base) (:yin.k/ops v)))\n        (is (= 4 (:yin.k/next-op-seq v)))))))\n\n\n(deftest a-parked-root-carries-the-custody-and-no-id\n  (is (= {:yin.k/kind :parked :yin.k/root (root-of \"parked\")\n          :yin.k/occurrence f/occurrence :yin.k/origin f/origin :yin.k/arbitration f/arbitration\n          :yin.k/next-op-seq 1 :yin.k/ops {}}\n         (inspect \"parked\"))))\n\n\n(deftest install-children-draw-ids-in-the-roots-context\n  (let [r (inspect \"installs\")]\n    (is (= 6 (:yin.k/next-op-seq r)))\n    (is (= {(f/op-id 4) (intent-hex \"s0\" [:lit \"v\"])} (:yin.k/ops r))\n        \"the child's id joins the root's baseline\")\n    (is (nil? (nth (:slots (f/child (rows/decode (f/pack-of \"installs\")) 'host.mod)) 16))\n        \"a child's custody slot is nil\")))\n\n\n(deftest a-halted-root-carries-only-its-origin\n  (is (= {:yin.k/kind :halted :yin.k/root (root-of \"halted-root\") :yin.k/origin f/origin :yin.k/ops {}}\n         (inspect \"halted-root\"))))\n\n\n(deftest the-counter-bound-is-valid-and-its-last-id-below-it\n  (let [r (inspect \"counter-at-bound\")]\n    (is (= f/max-exact (:yin.k/next-op-seq r)))\n    (is (contains? (:yin.k/ops r) (f/op-id (dec f/max-exact))))))\n\n\n(deftest a-fork-names-no-custody\n  (let [wire (f/edit-custody (f/base \"first-park\") (constantly nil))\n        {:keys [address bytes]} (f/enc wire)]\n    (is (= {:yin.k/kind :blocked :yin.k/root (:yin.k/root wire) :yin.k/ops {} :yin.k/fork true}\n           (checkpoint/inspect address bytes)))))\n\n\n(deftest inspect-pack-agrees-with-inspect\n  (doseq [n [\"first-park\" \"successor\" \"installs\" \"op-id-at-counter\" \"custody-epoch\"]]\n    (is (= (inspect n) (checkpoint/inspect-pack (cbor/decode (:bytes (f/fixture n))))) n)))\n\n\n;; =============================================================================\n;; Refusals: one fixture per class, each data with its path\n;; =============================================================================\n\n(deftest each-mutation-is-refused-as-it-names\n  (doseq [n f/fixture-names\n          :let [expected (f/refusal n)]\n          :when expected]\n    (let [r (inspect n)]\n      (is (= expected (select-keys r (keys expected))) (str n \" \" (pr-str r))))))\n\n\n(deftest each-mutation-is-another-pack\n  (doseq [n f/fixture-names\n          :when (and (f/base-of n) (not (contains? #{\"hash-mismatch\" \"non-canonical\"} n)))]\n    (is (not= (:address (f/fixture (f/base-of n))) (:address (f/fixture n))) n)))\n\n\n(deftest bytes-must-hash-to-the-address-and-be-canonical\n  (is (= {:yin.k/status :yin.k/hash-mismatch\n          :yin.k/address (:address (f/fixture \"first-park\"))\n          :yin.k/computed (:address (f/fixture \"successor\"))}\n         (inspect \"hash-mismatch\")))\n  (testing \"the algorithm is the one the address names\"\n    (let [bs (:bytes (f/fixture \"successor\"))\n          sha (keyword \"segment\" (str \"sha256-\" (jing/digest-bytes :sha256 bs)))]\n      (is (= (inspect \"successor\") (checkpoint/inspect sha bs)))))\n  (testing \"an address that is no segment address is the same refusal\"\n    (let [{:keys [address bytes]} (f/fixture \"successor\")]\n      (doseq [a [(jing/digest-bytes :blake3 bytes) (str address) nil :segment/md5-00\n                 (root-of \"successor\")]]\n        (is (= {:yin.k/status :yin.k/hash-mismatch :yin.k/address a :yin.k/computed address}\n               (checkpoint/inspect a bytes))\n            (pr-str a)))))\n  (is (= {:yin.k/status :yin.k/undecodable :yin.k/path [] :yin.k/kind :bytes :yin.k/refusal :non-canonical}\n         (inspect \"non-canonical\"))))\n\n\n(deftest every-fixture-has-an-expectation\n  (let [refused (into #{\"hash-mismatch\" \"non-canonical\"} (filter f/refusal) f/fixture-names)]\n    (is (= (set f/fixture-names) (into f/accepted refused)))\n    (is (empty? (filter f/accepted refused)))\n    (doseq [n f/accepted]\n      (is (not (contains? (inspect n) :yin.k/status)) n))))\n\n\n(deftest refusals-are-data-on-any-input\n  (doseq [[a bs] [[nil nil] [\"x\" \"not bytes\"] [nil (fx/hex->bytes \"\")]]]\n    (is (= :yin.k/hash-mismatch (:yin.k/status (checkpoint/inspect a bs)))))\n  (testing \"bytes under their own address that are no CBOR item\"\n    (let [bs (fx/hex->bytes \"ff\")\n          r (checkpoint/inspect (f/segment-address bs) bs)]\n      (is (= :yin.k/undecodable (:yin.k/status r)))\n      (is (= :bytes (:yin.k/kind r)))))\n  (testing \"a CBOR item that is no pack\"\n    (doseq [x [1 [] {} {:yin.k/handoff true} {:yin.k/handoff true :yin.k/version 3}]]\n      (let [bs (cbor/encode x)]\n        (is (contains? #{:yin.k/undecodable :yin.k/profile-mismatch}\n                       (:yin.k/status (checkpoint/inspect (f/segment-address bs) bs)))\n            (pr-str x))))))\n","exit_code":0,"status":"completed"}}
