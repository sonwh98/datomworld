))\ntest/yin/vm/ucf/rows_custody_test.cljc:199:            (rows/lower-task (s/receiver) wire (:attach! (s/attacher)) (assoc good :grant :x))))\ntest/yin/vm/ucf/rows_custody_test.cljc:201:            (rows/lower-task (s/receiver) wire (:attach! (s/attacher)) (assoc good :protection nil)))))))\ntest/yin/vm/ucf/rows_custody_test.cljc:206:        good (exclusive-opts wire #{\"s0\"})]\ntest/yin/vm/ucf/rows_custody_test.cljc:218:               (refused reader (assoc (exclusive-opts reader #{\"s0\"}) :protection {\"s0\" :at-least-once}))))\ntest/yin/vm/ucf/rows_custody_test.cljc:219:        (is (vm/blocked? (first (lowered reader (exclusive-opts reader #{\"s0\"}))))\ntest/yin/vm/ucf/rows_custody_test.cljc:224:             (refused wire (exclusive-opts wire #{\"s0\"}))))))\ntest/yin/vm/ucf/rows_custody_test.cljc:228:             (refused wire (assoc (exclusive-opts wire #{}) :protection {\"s0\" :at-least-once})))))))\ntest/yin/vm/ucf/rows_custody_test.cljc:235:             (select-keys (refused (f/pack-of n) (exclusive-opts (f/pack-of n) #{\"s0\"}))\ntest/yin/vm/ucf/rows_custody_test.cljc:338:        [m n] (lowered wire (exclusive-opts wire #{\"s0\"}))\n\n(def receiver-custody-keys\n  [:yin.k/closes :yin.k/issued :yin.k/gate :yin.k/custody\n   :yin.k/recovery-waits :yin.k/recovery-parked :yin.k/recovery-cell-ids])\n\n\n(defn poison-receiver-custody\n  [m]\n  (assoc m :yin.k/closes [{:stream-id :yin.k/k-9 :yin.k/issue 5}]\n         :yin.k/issued 99 :yin.k/gate :ended :yin.k/custody {:receiver-only true}\n         :yin.k/recovery-waits [{:receiver-only true}]\n         :yin.k/recovery-parked (assoc {} :receiver-only :wrong)\n         :yin.k/recovery-cell-ids (assoc {} :receiver-only :wrong)))\n\n\n(deftest lowering-isolates-task-state-from-a-populated-receiver\n  (doseq [[label source path expected]\n          [[:reader (vm/run (support/load-ast\n                              (support/new-machine)\n                              (support/then\n                                (support/def! 'reader-owned (support/lit 7))\n                                (support/next-of\n                                  (support/cursor-of {:type :stream/make :buffer 4})))))\n            [] \"B\"]\n           [:install-child (support/parked-installer) [:installs 'host.mod :vm] 42]]]\n    (testing (name label)\n      (let [pack (support/lift source nil)\n            ;; Share attached handles so install records can be compared\n            ;; directly, including the child's entire VM. No constructor\n            ;; runs during either lower; the task's streams are attached.\n            handles (atom {})\n            attach! (fn [descriptor]\n                      (let [id (:dao.stream/identity descriptor)\n                            h (or (get @handles id)\n                                  (let [h (support/one-slot-stream id)]\n                                    (swap! handles assoc id h)\n36:| Closed 2026-10-16: `:try?` carried by all three UCF link pending variants; lifted try waiters retain their return contract | G1 / L-d-1b slice: row/frame and remote lift/lower; portable refusal, install and malformed-boolean tests in `semantic/safepoint_harness_test.cljc`, frame bijection in `ucf/rows_test.cljc` | UCF | L-d-1b closed | P1 |\n37:| try joiner's `:link-id` is the install's parent id; drop `:link-id` from install waiters, loss datum carries `:module` | fable L-d-1 review P3-1 | linker | L-d-1b | P3 |\n","exit_code":0,"status":"completed"}}
