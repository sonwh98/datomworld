{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '175,225p' src/cljc/yin/vm/engine.cljc; rg --files docs/design | rg 'continu|ucf'; rg -n ':optional-D|scalar-literal|module-store' src/cljc/yin/vm/ucf/rows.cljc | head -25\"","aggregated_output":";; under `:module-stores {m {sym value}}`, never into its own `:store`.\n\n(def store-of-key\n  \"The key a closure (and, for the named kernels, an environment) carries\n   the manifest address of its module store under.\"\n  :yin.k/store-of)\n\n\n(defn env-store-of\n  \"The module store a named kernel's environment `env` runs against, or\n   nil at top level.\"\n  [env]\n  (get env store-of-key))\n\n\n(defn without-store-of\n  \"`env` with no module store context: what a halt leaves, so the next\n   top-level input never routes through a stale module store.\"\n  [env]\n  (if (contains? env store-of-key) (dissoc env store-of-key) env))\n\n\n(defn store-context\n  \"The module store the running body of `state` routes to, or nil: the\n   positional kernels' `:store-of` register, else the named kernels'\n   environment.\"\n  [state]\n  (or (:store-of state) (env-store-of (:env state))))\n\n\n(defn active-store\n  \"The store free reads and `:store-get` resolve against: while a module\n   closure runs (`store-of` non-nil), its module store, with no ambient\n   fallback -- a key the module store lacks is absent; otherwise the\n   task's own store.\"\n  [state store-of]\n  (if (some? store-of)\n    (get (:module-stores state) store-of {})\n    (:store state)))\n\n\n(defn put-active\n  \"Write `key` in the active store of `state`: the module store\n   `store-of` names, or the task's own store at top level. Both go\n   through `store-put`, so a reserved key is refused either way.\"\n  [state store-of key val]\n  (if (some? store-of)\n    (update-in state [:module-stores store-of]\n               (fn [module-store] (store-put (or module-store {}) key val)))\n    (assoc state :store (store-put (:store state) key val))))\n\ndocs/design/yin.vm.universal-continuation-format.md\ndocs/design/yin.vm.ucf-revisions.md\ndocs/design/yin.vm.ucf-transport-tuples.md\ndocs/design/yin.vm.semantic-register-vm.continuation.md\ndocs/design/yin.vm.universal-continuation-format.v2-amendment.md\ndocs/design/dao.space.discrete-to-continuous.md\n54:   :env [[:ref :bindings] :optional-D]\n55:   :closure [:A :N :syms [:ref :bindings] :optional-D]\n62:   :module-store [:D [:ref :store]]\n67:          [:refs :module-store] [:ref :parked-table] [:ref :cursor-cells]\n68:          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n1204:(defn- scalar-literal?\n1297:      (scalar-literal? x) [:lit x]\n1366:(defn- module-store-nodes\n1371:      (let [stores (:module-stores (:m ctx))]\n1373:          (outcome! :yin.k/non-portable :missing-module-store {:yin.k/hint mid}))\n1374:        (recur (assoc done mid (node :module-store [mid (store-node ctx (get stores mid))]))))\n1416:                          store (if (some? store-of) (get (:module-stores m) store-of {}) (:store m))]\n1479:        module-stores (module-store-nodes ctx)\n1495:        task (node :task [3 profile kind role (or (:id-counter m) 0) free-node store module-stores parked\n1558:  (let [[_ _ _ _ _ _ store module-stores] (:slots task)]\n1559:    (doseq [s (cons store (map #(second (:slots %)) module-stores))\n1635:  (let [[_ _ _ _ _ _ _ module-stores _ _ requires code] (:slots task)]\n1643:    (let [census (into #{} (map #(first (:slots %))) module-stores)\n1698:  (let [[_ _ kind _ id-counter free-env store module-stores parked census _ code installs waits parked-id result]\n1807:                         module-stores)\n1829:            machine (assoc base :store store' :module-stores stores :parked parked' :installs installs'\n","exit_code":0,"status":"completed"}}
