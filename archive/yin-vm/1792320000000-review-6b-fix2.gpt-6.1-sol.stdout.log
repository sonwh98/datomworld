{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yin/vm/semantic_register/scan.cljc; sed -n '1,105p' src/cljc/yin/vm/semantic_register/analysis.cljc; sed -n '1220,1285p' src/cljc/yin/vm/ucf/rows.cljc; sed -n '535,565p' test/yin/vm/semantic_register/safepoint_harness_test.cljc; cat deps.edn | head -65\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yin/vm/semantic_register/scan.cljc; sed -n '1,105p' src/cljc/yin/vm/semantic_register/analysis.cljc; sed -n '1220,1285p' src/cljc/yin/vm/ucf/rows.cljc; sed -n '535,565p' test/yin/vm/semantic_register/safepoint_harness_test.cljc; cat deps.edn | head -65\"","aggregated_output":"(ns yin.vm.semantic-register.scan\n  \"Dependency facts derived from admitted semantic register vectors.\"\n  (:require [dao.space.query :as query]\n            [yin.vm :as vm]\n            [yin.vm.debruijn :as debruijn]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.ucf :as ucf]))\n\n\n(defn- bodies\n  [v]\n  (when-let [defect (code/well-formed? v)]\n    (throw (ex-info \"Cannot scan malformed semantic register vector\" defect)))\n  (code/parse v))\n\n\n(defn- chain\n  [v bs i]\n  (if-let [owner (:owner (nth bs i))]\n    (cons (nth (nth v owner) 2) (chain v bs (code/body-index bs owner)))\n    []))\n\n\n(defn free-occurrences\n  \"Free names with exact pc and closure enclosure, in emission order.\"\n  [v]\n  (let [bs (bodies v)]\n    (vec (keep-indexed\n           (fn [pc t]\n             (when (= :var (first t))\n               (let [name (nth t 2) i (code/body-index bs pc)]\n                 ;; Unreachable today: `bodies` runs `code/well-formed?`,\n                 ;; which refuses a `:var` naming a reserved name, and\n                 ;; lowering emits `:define`, never `:var yin/def`. Kept\n                 ;; so Rule R does not rest on the validator alone.\n                 (when (and (not (vm/reserved-name? name))\n                            (contains? (debruijn/resolve-name (chain v bs i) name) :free))\n                   {:name name :at pc :in-body? (pos? i)})))) v))))\n\n\n(defn free-names\n  \"The set of free names.\"\n  [v]\n  (set (map :name (free-occurrences v))))\n\n\n(defn definition-occurrences\n  \"Store writes with pc and conditional enclosure.\"\n  [v]\n  (let [bs (bodies v)\n        ranges (into #{} (mapcat (fn [[pc target]]\n                                   (range (inc (min pc target)) (max pc target))))\n                     (keep-indexed (fn [pc t]\n                                     (case (first t)\n                                       :jump [pc (nth t 1)]\n                                       :branch-false [pc (nth t 2)]\n                                       nil)) v))]\n    (vec (keep-indexed\n           (fn [pc t]\n             (when (contains? #{:store-put :define} (first t))\n               {:name (nth t 2) :at pc\n                :conditional? (or (contains? ranges pc)\n                                  (pos? (code/body-index bs pc)))})) v))))\n\n\n(defn application-sites\n  \"Call and FFI sites in pc order.\"\n  [v]\n  (bodies v)\n  (vec (keep-indexed (fn [pc t]\n                       (when (contains? #{:call :ffi-call} (first t)) {:at pc})) v)))\n\n\n(def footprint-mnemonics\n  \"Effect normalization under the current register vector table.\"\n  (dissoc (get-in vm/footprint-table [vm/semantic-contract :mnemonics]) :push))\n\n\n(defn segment-rows\n  \"Segment-qualified tuples addressed by A.\"\n  [v]\n  (bodies v)\n  (let [a (ucf/code-address v)]\n    (mapv (fn [pc t] (into [a pc] t)) (range) v)))\n\n\n(defn requirements\n  \"Datalog extraction of store, FFI, parked and effect requirements.\"\n  [v]\n  (let [db (query/relation (segment-rows v))\n        extract (fn [q] (set (map first (query/collect (query/q q db)))))\n        mnemonics (extract '[:find ?mn :in $code :where [$code _ _ ?mn & _]])]\n    {:store-keys (extract '[:find ?key :in $code\n                            :where (or [$code _ _ :store-get _ ?key]\n                                       [$code _ _ :store-put _ ?key _]\n                                       [$code _ _ :define _ ?key _])])\n     :ffi-ops (extract '[:find ?op :in $code :where [$code _ _ :ffi-call _ ?op _]])\n     :parked-ids (extract '[:find ?pid :in $code :where [$code _ _ :resume ?pid _]])\n     :effects (into #{} (mapcat footprint-mnemonics) mnemonics)}))\n(ns yin.vm.semantic-register.analysis\n  \"Static facts per pc derived from A\n   (`docs/design/yin.vm.semantic-register-vm.md` §8.1): per body, the\n   explicit control-flow graph, `def`, `use`, the live-in set `L` by\n   backward liveness to a fixed point, and the saved-window rule\n   `saved(p, rd) = L(p) − {rd}`.\n\n   Pure functions of a vector that passed\n   `yin.vm.semantic-register.code/well-formed?`. Nothing here is persisted\n   in A; a receiver recomputes it from the vector alone.\"\n  (:require [clojure.set :as set]\n            [yin.vm.semantic-register.code :as code]))\n\n\n(defn successors\n  \"§8.1's successor relation for the instruction at `pc`: none for\n   `:return`, `:halt`, `:resume` and a tail `:call` (runtime\n   terminators); the target for `:jump`; `pc+1` and the target for\n   `:branch-false`; `pc+1` otherwise. Every edge stays inside the body\n   (§3.4 item 6).\"\n  [v pc]\n  (let [t (nth v pc)]\n    (case (nth t 0)\n      (:return :halt :resume) []\n      :jump [(nth t 1)]\n      :branch-false [(inc pc) (nth t 2)]\n      :call (if (code/tail-call? t) [] [(inc pc)])\n      [(inc pc)])))\n\n\n(defn defs\n  \"`def(pc)`: `#{rd}` for an instruction with a destination slot, `#{}`\n   otherwise. A tail `:call` names its `rd` and has no successor, so its\n   `def` never reaches an `L`.\"\n  [v pc]\n  (if-let [r (code/rd (nth v pc))] #{r} #{}))\n\n\n(defn uses\n  \"`use(pc)`: the instruction's register operands, as a set.\"\n  [v pc]\n  (set (code/uses (nth v pc))))\n\n\n(defn- body-live\n  \"Backward liveness over one body `[start, end)` to a fixed point:\n   `L(p) = use(p) ∪ (⋃ L(s) for s in succ(p)) − def(p)`, swept in\n   decreasing pc order until no set changes. Returns a vector of sets\n   indexed by `pc - start`.\"\n  [v start end]\n  (let [ps (range (dec end) (dec start) -1)\n        du (mapv (fn [pc] [(uses v pc) (defs v pc) (successors v pc)])\n                 (range start end))]\n    (loop [live (vec (repeat (- end start) #{}))]\n      (let [swept (reduce (fn [live pc]\n                            (let [[u d ss] (nth du (- pc start))\n                                  out (reduce (fn [acc s]\n                                                (into acc\n                                                      (nth live (- s start))))\n                                              #{}\n                                              ss)]\n                              (assoc live\n                                     (- pc start)\n                                     (into u (set/difference out d)))))\n                          live\n                          ps)]\n        (if (= swept live) live (recur swept))))))\n\n\n(defn analyze\n  \"The §8.1 facts of a well-formed vector. Returns `{:bodies [{:start s\n   :end e} …] :successors [succ …] :def [set …] :use [set …] :live [set\n   …]}`, the last four indexed by pc, `:live` being `L` computed per\n   body over the stated edges, so instructions unreachable from a\n   terminal path (layout syntax) have an `L` like any other node.\"\n  [v]\n  (let [bodies (mapv #(select-keys % [:start :end]) (code/body-ranges v))]\n    {:bodies bodies,\n     :successors (mapv #(successors v %) (range (count v))),\n     :def (mapv #(defs v %) (range (count v))),\n     :use (mapv #(uses v %) (range (count v))),\n     :live (into [] (mapcat (fn [{:keys [start end]}] (body-live v start end)))\n                 bodies)}))\n\n\n(defn live\n  \"`L(p)` from an `analyze` result.\"\n  [analysis p]\n  (nth (:live analysis) p))\n\n\n(defn saved\n  \"The saved-window rule (§2.4, §8.1): the registers a frame, wait,\n   parked record or capture resuming at `p` with delivery `{:deliver :rd\n   :rd rd}` carries, `L(p) − {rd}`. The subtraction is explicit.\"\n  [analysis p rd]\n  (disj (live analysis p) rd))\n\n\n(defn reachable\n  \"The pcs reachable from the start of the body holding `pc`, over the\n   stated successor edges.\"\n  [v pc]\n  (let [bodies (code/body-ranges v)\n        start (:start (nth bodies (code/body-index bodies pc)))]\n\n\n(declare lift-value state-node)\n\n\n(defn- collection-value\n  \"A guest collection: a literal when no member is a reference.\"\n  [ctx kind members original]\n  (let [vs (mapv #(lift-value ctx %) members)]\n    (if (every? #(= :lit (first %)) vs) [:lit original] [:row (node kind vs)])))\n\n\n(defn- bindings-node\n  [ctx e]\n  (node :bindings (mapcat (fn [[k v]] [k (lift-value ctx v)]) e)))\n\n\n(defn- context!\n  \"Record that segment a can run from pc at under environment e: a\n   closure's entry, an :act's or a return frame's pc (§7.1's discharge).\"\n  [ctx a at e]\n  (swap! (:acc ctx) update :contexts conj {:a a :at at :env (or e {})}))\n\n\n(defn- store-of!\n  [ctx e]\n  (let [store-of (engine/env-store-of e)]\n    (when (some? store-of) (swap! (:acc ctx) update :stores conj store-of))\n    store-of))\n\n\n(defn- lift-env-node\n  [ctx e]\n  (let [e (or e {})]\n    (node :env [(bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n\n\n(defn- closure-node\n  [ctx c]\n  (let [e (or (:env c) {})\n        a (address! ctx (:segment c))]\n    (context! ctx a (:entry c) e)\n    (node :closure [a (:entry c) (vec (:params c))\n                    (bindings-node ctx (engine/without-store-of e)) (store-of! ctx e)])))\n\n\n(defn- lift-value\n  \"One machine value as a carrier value: [:lit x], [:row n] or\n   [:cursor-cell source]. A reference is authenticated before it is\n   encoded; a foreign value, a heap cell and a host object refuse.\"\n  [ctx x]\n  (let [m (:m ctx)]\n    (cond\n      (values/host-typed? x)\n      (cond\n        (not (values/owned-by? x (:owner m)))\n        (outcome! :yin.k/non-portable :foreign-value {:yin.k/hint (values/kind-of x)})\n        (values/closure? x) [:row (closure-node ctx (values/payload x))]\n        (values/continuation? x) [:row (node :reified [(state-node ctx (values/payload x))])]\n        :else (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint (values/kind-of x)}))\n      (fn? x) [:row (node :prim [(primitive-name ctx x)])]\n      (map? x)\n      (case (:type x)\n        :stream-ref (if (engine/authentic-ref? m :stream-ref x)\n                      [:row (stream-row! ctx (:id x))]\n                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :stream-ref}))\n          (testing (str \"row \" n \" \" (name label))\n            (let [ref (reference (build))]\n              (when (some? expected)\n                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n              (laws (build) ref)\n              (swap! runs inc))))\n        (is (= 89 @runs))))))\n\n\n(deftest bare-rows-match-the-reference\n  ;; The quick-tier slice of acceptance 1: every row once, bare.\n  (let [counted (atom [0 0])]\n    (doseq [[n r build] rows]\n      (testing (str \"row \" n)\n        (let [ref (reference (build identity))\n              {:keys [wire attaches]} (laws (build identity) ref)]\n          (when (some? r) (is (= r (:value ref))))\n          (swap! counted (fn [[a i]] [(+ a attaches) (+ i (count (stream-identities wire)))])))))\n    ;; outside laws, so deleting its count assertion leaves one standing\n    (is (pos? (first @counted)) \"the corpus attaches streams\")\n    (is (apply = @counted) \"attaches = distinct stream identities over the corpus\")))\n\n\n;; =============================================================================\n;; Acceptance 2-6\n;; =============================================================================\n\n(defn wait-state\n  [wire]\n  (first (:slots (first (slot (root-task wire) 13)))))\n\n{:deps {org.clojure/core.async {:mvn/version \"1.8.741\"}\n        org.clojure/tools.reader {:mvn/version \"1.5.0\"}\n        ring/ring {:mvn/version \"1.14.1\"}\n        com.cognitect/transit-clj {:mvn/version \"1.0.333\"}\n        org.replikativ/boring {:mvn/version \"0.1.30\"}\n        com.datomic/peer {:mvn/version \"1.0.7364\"}\n        org.postgresql/postgresql {:mvn/version \"42.7.3\"}\n        org.clojure/data.json {:mvn/version \"2.5.0\"}\n        http-kit/http-kit {:mvn/version \"2.8.0\"}\n        org.jsoup/jsoup {:mvn/version \"1.18.3\"}\n        instaparse/instaparse {:mvn/version \"1.5.0\"}\n        ;; yang.python.antlr: the runtime the generated Python3 parser runs\n        ;; on; pinned to the tool version in :antlr-gen (they are one release)\n        org.antlr/antlr4-runtime {:mvn/version \"4.13.2\"}\n        criterium/criterium {:mvn/version \"0.4.6\"}\n        io.github.rctcwyvrn/blake3 {:mvn/version \"1.3\"}\n        stigmergy/chp {:mvn/version \"0.1.0-SNAPSHOT\"\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\n :cljd/opts {}\n ;; build/antlr/python3/classes: the generated Python3 parser, produced by\n ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\n :paths [\"src/clj\" \"src/cljc\" \"src/cljs\" \"src/cljd\"\n         \"build/antlr/python3/classes\"]\n :aliases {:clean {:extra-paths [\"src/dev\"]\n                   :exec-fn clean/clean}\n           :profile-btree {:extra-paths [\"src/dev\"]\n                           :extra-deps {persistent-sorted-set/persistent-sorted-set\n                                        {:mvn/version \"0.3.0\"}}\n                           :main-opts [\"-m\" \"btree-bench\"]}\n           :test {:extra-paths [\"test\"]\n                  :extra-deps {io.github.cognitect-labs/test-runner\n                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}}\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           ;; The one ClojureDart pin. Compose it with the build aliases:\n           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n           :clojuredart {:extra-deps {sonwh98/clojuredart\n                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n                                      }}\n           :cljd {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n","exit_code":0,"status":"completed"}}
