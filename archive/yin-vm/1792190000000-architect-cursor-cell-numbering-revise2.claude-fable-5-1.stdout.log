{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ATNKxsHbDQDwaTpoCNxus","type":"tool_result","content":"1\t(ns yin.vm.semantic-register.frame\n2\t  \"Pure, ordered validation of decoded canonical continuation frames (§3).\"\n3\t  (:require [yin.vm :as vm]\n4\t            [yin.vm.semantic-register.code :as code]\n5\t            [yin.vm.semantic-register.analysis :as analysis]))\n6\t\n7\t\n8\t(defn- problem\n9\t  [kind path]\n10\t  {:yin.k/kind kind :yin.k/path path})\n11\t\n12\t\n13\t(defn- closed?\n14\t  [x required optional]\n15\t  (and (map? x) (every? #(contains? x %) required)\n16\t       (every? (into (set required) optional) (keys x))))\n17\t\n18\t\n19\t(defn task-defect\n20\t  \"X1, once per body, including a halted body with no frames.\"\n21\t  [task]\n22\t  (let [e (:free-env task)]\n23\t    (cond\n24\t      (not (and (map? e) (every? symbol? (keys e))))\n25\t      (problem :free-env-shape [:free-env])\n26\t      (some vm/reserved-name? (keys e))\n27\t      (problem :reserved-name [:free-env]))))\n28\t\n29\t\n30\t(defn- env?\n31\t  [e]\n32\t  (and (closed? e [:yin.k/bindings] [:yin.k/store-of])\n33\t       (or (not (contains? e :yin.k/store-of)) (some? (:yin.k/store-of e)))\n34\t       (map? (:yin.k/bindings e))\n35\t       (every? symbol? (keys (:yin.k/bindings e)))))\n36\t\n37\t\n38\t(defn- lexical-names\n39\t  [v pc]\n40\t  (let [bs (code/body-ranges v)]\n41\t    (loop [b (code/body-index bs pc) names #{}]\n42\t      (if-let [owner (:owner (nth bs b))]\n43\t        (recur (code/body-index bs owner) (into names (nth (nth v owner) 2)))\n44\t        names))))\n45\t\n46\t\n47\t(defn- window-defect\n48\t  [f v rd prefix path]\n49\t  (let [pc (:yin.k/pc f) w (:yin.k/window f)\n50\t        body (nth (code/parse v) (code/body-index (code/body-ranges v) pc))\n51\t        wanted (analysis/saved (analysis/analyze v) pc rd)\n52\t        ks (set (keys w))\n53\t        kind (fn [s] (keyword (str prefix s)))\n54\t        p (conj path :yin.k/window)]\n55\t    (cond\n56\t      (some #(>= % (:registers body)) ks) (problem (kind \"window-scope\") p)\n57\t      (contains? w rd) (problem (kind \"window-self\") p)\n58\t      (some #(not (contains? wanted %)) ks) (problem (kind \"window-extra\") p)\n59\t      (some #(not (contains? w %)) wanted) (problem (kind \"window-missing\") p))))\n60\t\n61\t\n62\t(defn defect\n63\t  \"First §3 defect, or nil. Code is already well formed; task is plain\n64\t   {:free-env map :parked-key P :ffi-call-ids set}. No engine is read.\n65\t   Values have already passed the carrier's value-domain checks.\"\n66\t  [frame code-map context task]\n67\t  (let [act? (= :act (:yin.k/state frame))\n68\t        required (if act?\n69\t                   [:yin.k/state :yin.k/segment :yin.k/pc :yin.k/env\n70\t                    :yin.k/window :yin.k/deliver :yin.k/k]\n71\t                   [:yin.k/state :yin.k/segment :yin.k/site :yin.k/deliver :yin.k/k])\n72\t        k (:yin.k/k frame)\n73\t        returns (when (vector? k) (mapv (fn [i] [(nth k i) [:yin.k/k i]]) (range (count k))))\n74\t        all (into [[frame []]] returns)\n75\t        envs (if act? all returns)]\n76\t    (or\n77\t      ;; S1-S4, globally before any dependent read.\n78\t      (when-not (and (contains? #{:act :tail} (:yin.k/state frame))\n79\t                     (closed? frame required [:yin.k/pending]))\n80\t        (problem :frame-shape []))\n81\t      (when-not (vector? k) (problem :k-shape [:yin.k/k]))\n82\t      (some (fn [[f p]]\n83\t              (when-not (and (closed? f [:yin.k/frame-type :yin.k/segment :yin.k/pc\n84\t                                         :yin.k/env :yin.k/window :yin.k/rd] [])\n85\t                             (= :return (:yin.k/frame-type f)))\n86\t                (problem :k-shape p))) returns)\n87\t      (some (fn [[f p]]\n88\t              (when-not (and (map? (:yin.k/window f))\n89\t                             (every? code/reg? (keys (:yin.k/window f))))\n90\t                (problem :window-representation (conj p :yin.k/window)))) envs)\n91\t      (some (fn [[f p]]\n92\t              (when-not (env? (:yin.k/env f))\n93\t                (problem :env-shape (conj p :yin.k/env)))) envs)\n94\t      (when-not (map? (:yin.k/deliver frame)) (problem :deliver-shape [:yin.k/deliver]))\n95\t      ;; C1-C3 across the entire continuation.\n96\t      (some (fn [[f p]]\n97\t              (when-not (contains? code-map (:yin.k/segment f))\n98\t                (problem :segment (conj p :yin.k/segment)))) all)\n99\t      (some (fn [[f p]]\n100\t              (let [slot (if (and (empty? p) (not act?)) :yin.k/site :yin.k/pc)\n101\t                    n (get f slot) v (get code-map (:yin.k/segment f))]\n102\t                (cond\n103\t                  (not (code/reg? n)) (problem :pc-kind (conj p slot))\n104\t                  (not (and (< n (count v)) (or (= slot :yin.k/site) (pos? n))))\n105\t                  (problem :pc-bounds (conj p slot))))) all)\n106\t      (some (fn [[f p]]\n107\t              (let [pc (:yin.k/pc f) bs (code/body-ranges (get code-map (:yin.k/segment f)))]\n108\t                (when-not (= (code/body-index bs (dec pc)) (code/body-index bs pc))\n109\t                  (problem :pc-body (conj p :yin.k/pc))))) envs)\n110\t      (let [v (get code-map (:yin.k/segment frame))\n111\t            site (if act? (dec (:yin.k/pc frame)) (:yin.k/site frame))\n112\t            inst (nth v site) op (first inst) rd (code/rd inst)\n113\t            d (:yin.k/deliver frame)]\n114\t        (or\n115\t          (if act?\n116\t            (or\n117\t              (when-not (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} op)\n118\t                            (and (= :call op) (not (code/tail-call? inst))))\n119\t                (problem :site [:yin.k/pc]))\n120\t              (when-not (= rd (:yin.k/rd d)) (problem :destination [:yin.k/deliver :yin.k/rd]))\n121\t              (when-not (= {:yin.k/deliver :rd :yin.k/rd rd} d) (problem :deliver [:yin.k/deliver]))\n122\t              (window-defect frame v rd \"\" []))\n123\t            (or\n124\t              (when-not (code/tail-call? inst) (problem :site [:yin.k/site]))\n125\t              (when-not (= {:yin.k/deliver :return} d) (problem :deliver [:yin.k/deliver]))))\n126\t          (some (fn [[f p]]\n127\t                  (let [fv (get code-map (:yin.k/segment f)) fi (nth fv (dec (:yin.k/pc f)))\n128\t                        frd (:yin.k/rd f)]\n129\t                    (or\n130\t                      (when-not (and (= :call (first fi)) (not (code/tail-call? fi)))\n131\t                        (problem :return-site (conj p :yin.k/pc)))\n132\t                      (when-not (= frd (code/rd fi)) (problem :return-destination (conj p :yin.k/rd)))\n133\t                      (window-defect f fv frd \"return-\" p)))) returns)\n134\t          (some (fn [[f p]]\n135\t                  (when (some vm/reserved-name? (keys (get-in f [:yin.k/env :yin.k/bindings])))\n136\t                    (problem :reserved-name (conj p :yin.k/env :yin.k/bindings)))) envs)\n137\t          (some (fn [[f p]]\n138\t                  (let [names (lexical-names (get code-map (:yin.k/segment f)) (:yin.k/pc f))\n139\t                        bindings (get-in f [:yin.k/env :yin.k/bindings])]\n140\t                    (when-not (and (every? #(contains? bindings %) names)\n141\t                                   (= (apply dissoc bindings names)\n142\t                                      (apply dissoc (:free-env task) names)))\n143\t                      (problem :free-env-mismatch (conj p :yin.k/env :yin.k/bindings))))) envs)\n144\t          (when-not (and (contains? #{:wait :captured :parked} context)\n145\t                         (= (= :wait context) (contains? frame :yin.k/pending)))\n146\t            (problem :pending-presence [:yin.k/pending]))\n147\t          (when (= :wait context)\n148\t            (let [reasons (case op\n149\t                            :stream-next #{:next}\n150\t                            :stream-put #{:put}\n151\t                            :ffi-call #{:ffi :ffi-request}\n152\t                            :call #{:next :put :ffi :ffi-request :link-request :link-response :install}\n153\t                            #{})]\n154\t              (when-not (contains? reasons (get-in frame [:yin.k/pending :yin.k/reason]))\n155\t                (problem :reason-mismatch [:yin.k/pending :yin.k/reason]))))\n156\t          (when (and (= :captured context) (not (and act? (= :current-continuation op))))\n157\t            (problem :captured-site [(if act? :yin.k/pc :yin.k/site)]))\n158\t          (when (and (= :parked context)\n159\t                     (not (or (and act? (= :park op))\n160\t                              (and (contains? (:ffi-call-ids task) (:parked-key task))\n161\t                                   (or (and act? (= :ffi-call op))\n162\t                                       (and (not act?) (code/tail-call? inst)))))))\n163\t            (problem :parked-site [(if act? :yin.k/pc :yin.k/site)])))))))\n164\t"}]},"parent_tool_use_id":null,"session_id":"7984b61f-639f-4af2-b00a-5b9b7d554f75","uuid":"796a4501-543e-4a3f-b05d-bdd9c6451c4a","timestamp":"2026-10-12T06:20:10.322Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-numbering/collab/numbering-probe/src/yin/vm/semantic_register/frame.cljc","content":"(ns yin.vm.semantic-register.frame\n  \"Pure, ordered validation of decoded canonical continuation frames (§3).\"\n  (:require [yin.vm :as vm]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.analysis :as analysis]))\n\n\n(defn- problem\n  [kind path]\n  {:yin.k/kind kind :yin.k/path path})\n\n\n(defn- closed?\n  [x required optional]\n  (and (map? x) (every? #(contains? x %) required)\n       (every? (into (set required) optional) (keys x))))\n\n\n(defn task-defect\n  \"X1, once per body, including a halted body with no frames.\"\n  [task]\n  (let [e (:free-env task)]\n    (cond\n      (not (and (map? e) (every? symbol? (keys e))))\n      (problem :free-env-shape [:free-env])\n      (some vm/reserved-name? (keys e))\n      (problem :reserved-name [:free-env]))))\n\n\n(defn- env?\n  [e]\n  (and (closed? e [:yin.k/bindings] [:yin.k/store-of])\n       (or (not (contains? e :yin.k/store-of)) (some? (:yin.k/store-of e)))\n       (map? (:yin.k/bindings e))\n       (every? symbol? (keys (:yin.k/bindings e)))))\n\n\n(defn- lexical-names\n  [v pc]\n  (let [bs (code/body-ranges v)]\n    (loop [b (code/body-index bs pc) names #{}]\n      (if-let [owner (:owner (nth bs b))]\n        (recur (code/body-index bs owner) (into names (nth (nth v owner) 2)))\n        names))))\n\n\n(defn- window-defect\n  [f v rd prefix path]\n  (let [pc (:yin.k/pc f) w (:yin.k/window f)\n        body (nth (code/parse v) (code/body-index (code/body-ranges v) pc))\n        wanted (analysis/saved (analysis/analyze v) pc rd)\n        ks (set (keys w))\n        kind (fn [s] (keyword (str prefix s)))\n        p (conj path :yin.k/window)]\n    (cond\n      (some #(>= % (:registers body)) ks) (problem (kind \"window-scope\") p)\n      (contains? w rd) (problem (kind \"window-self\") p)\n      (some #(not (contains? wanted %)) ks) (problem (kind \"window-extra\") p)\n      (some #(not (contains? w %)) wanted) (problem (kind \"window-missing\") p))))\n\n\n(defn defect\n  \"First §3 defect, or nil. Code is already well formed; task is plain\n   {:free-env map :parked-key P :ffi-call-ids set}. No engine is read.\n   Values have already passed the carrier's value-domain checks.\"\n  [frame code-map context task]\n  (let [act? (= :act (:yin.k/state frame))\n        required (if act?\n                   [:yin.k/state :yin.k/segment :yin.k/pc :yin.k/env\n                    :yin.k/window :yin.k/deliver :yin.k/k]\n                   [:yin.k/state :yin.k/segment :yin.k/site :yin.k/deliver :yin.k/k])\n        k (:yin.k/k frame)\n        returns (when (vector? k) (mapv (fn [i] [(nth k i) [:yin.k/k i]]) (range (count k))))\n        all (into [[frame []]] returns)\n        envs (if act? all returns)]\n    (or\n      ;; S1-S4, globally before any dependent read.\n      (when-not (and (contains? #{:act :tail} (:yin.k/state frame))\n                     (closed? frame required [:yin.k/pending]))\n        (problem :frame-shape []))\n      (when-not (vector? k) (problem :k-shape [:yin.k/k]))\n      (some (fn [[f p]]\n              (when-not (and (closed? f [:yin.k/frame-type :yin.k/segment :yin.k/pc\n                                         :yin.k/env :yin.k/window :yin.k/rd] [])\n                             (= :return (:yin.k/frame-type f)))\n                (problem :k-shape p))) returns)\n      (some (fn [[f p]]\n              (when-not (and (map? (:yin.k/window f))\n                             (every? code/reg? (keys (:yin.k/window f))))\n                (problem :window-representation (conj p :yin.k/window)))) envs)\n      (some (fn [[f p]]\n              (when-not (env? (:yin.k/env f))\n                (problem :env-shape (conj p :yin.k/env)))) envs)\n      (when-not (map? (:yin.k/deliver frame)) (problem :deliver-shape [:yin.k/deliver]))\n      ;; C1-C3 across the entire continuation.\n      (some (fn [[f p]]\n              (when-not (contains? code-map (:yin.k/segment f))\n                (problem :segment (conj p :yin.k/segment)))) all)\n      (some (fn [[f p]]\n              (let [slot (if (and (empty? p) (not act?)) :yin.k/site :yin.k/pc)\n                    n (get f slot) v (get code-map (:yin.k/segment f))]\n                (cond\n                  (not (code/reg? n)) (problem :pc-kind (conj p slot))\n                  (not (and (< n (count v)) (or (= slot :yin.k/site) (pos? n))))\n                  (problem :pc-bounds (conj p slot))))) all)\n      (some (fn [[f p]]\n              (let [pc (:yin.k/pc f) bs (code/body-ranges (get code-map (:yin.k/segment f)))]\n                (when-not (= (code/body-index bs (dec pc)) (code/body-index bs pc))\n                  (problem :pc-body (conj p :yin.k/pc))))) envs)\n      (let [v (get code-map (:yin.k/segment frame))\n            site (if act? (dec (:yin.k/pc frame)) (:yin.k/site frame))\n            inst (nth v site) op (first inst) rd (code/rd inst)\n            d (:yin.k/deliver frame)]\n        (or\n          (if act?\n            (or\n              (when-not (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} op)\n                            (and (= :call op) (not (code/tail-call? inst))))\n                (problem :site [:yin.k/pc]))\n              (when-not (= rd (:yin.k/rd d)) (problem :destination [:yin.k/deliver :yin.k/rd]))\n              (when-not (= {:yin.k/deliver :rd :yin.k/rd rd} d) (problem :deliver [:yin.k/deliver]))\n              (window-defect frame v rd \"\" []))\n            (or\n              (when-not (code/tail-call? inst) (problem :site [:yin.k/site]))\n              (when-not (= {:yin.k/deliver :return} d) (problem :deliver [:yin.k/deliver]))))\n          (some (fn [[f p]]\n                  (let [fv (get code-map (:yin.k/segment f)) fi (nth fv (dec (:yin.k/pc f)))\n                        frd (:yin.k/rd f)]\n                    (or\n                      (when-not (and (= :call (first fi)) (not (code/tail-call? fi)))\n                        (problem :return-site (conj p :yin.k/pc)))\n                      (when-not (= frd (code/rd fi)) (problem :return-destination (conj p :yin.k/rd)))\n                      (window-defect f fv frd \"return-\" p)))) returns)\n          (some (fn [[f p]]\n                  (when (some vm/reserved-name? (keys (get-in f [:yin.k/env :yin.k/bindings])))\n                    (problem :reserved-name (conj p :yin.k/env :yin.k/bindings)))) envs)\n          (some (fn [[f p]]\n                  (let [names (lexical-names (get code-map (:yin.k/segment f)) (:yin.k/pc f))\n                        bindings (get-in f [:yin.k/env :yin.k/bindings])]\n                    (when-not (and (every? #(contains? bindings %) names)\n                                   (= (apply dissoc bindings names)\n                                      (apply dissoc (:free-env task) names)))\n                      (problem :free-env-mismatch (conj p :yin.k/env :yin.k/bindings))))) envs)\n          (when-not (and (contains? #{:wait :captured :parked} context)\n                         (= (= :wait context) (contains? frame :yin.k/pending)))\n            (problem :pending-presence [:yin.k/pending]))\n          (when (= :wait context)\n            (let [reasons (case op\n                            :stream-next #{:next}\n                            :stream-put #{:put}\n                            :ffi-call #{:ffi :ffi-request}\n                            :call #{:next :put :ffi :ffi-request :link-request :link-response :install}\n                            #{})]\n              (when-not (contains? reasons (get-in frame [:yin.k/pending :yin.k/reason]))\n                (problem :reason-mismatch [:yin.k/pending :yin.k/reason]))))\n          (when (and (= :captured context) (not (and act? (= :current-continuation op))))\n            (problem :captured-site [(if act? :yin.k/pc :yin.k/site)]))\n          (when (and (= :parked context)\n                     (not (or (and act? (= :park op))\n                              (and (contains? (:ffi-call-ids task) (:parked-key task))\n                                   (or (and act? (= :ffi-call op))\n                                       (and (not act?) (code/tail-call? inst)))))))\n            (problem :parked-site [(if act? :yin.k/pc :yin.k/site)])))))))\n","numLines":164,"startLine":1,"totalLines":164}},"tool_result_meta":[{"id":"toolu_014ATNKxsHbDQDwaTpoCNxus","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
