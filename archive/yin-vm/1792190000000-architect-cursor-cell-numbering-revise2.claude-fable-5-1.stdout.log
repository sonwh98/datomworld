7\t        x))\n78\t    :else x))\n79\t\n80\t\n81\t(defn portable-frame\n82\t  [m f]\n83\t  (let [bindings (fn [mappings] (into {} (map (fn [[k v]] [k (portable-value m v)])) mappings))\n84\t        env #(update % :yin.k/bindings bindings)]\n85\t    (cond-> (update f :yin.k/k #(mapv (fn [k]\n86\t                                        (-> k (update :yin.k/env env)\n87\t                                            (update :yin.k/window bindings))) %))\n88\t      (= :act (:yin.k/state f)) (update :yin.k/env env)\n89\t      (= :act (:yin.k/state f)) (update :yin.k/window bindings)\n90\t      (contains? f :yin.k/pending) (update :yin.k/pending #(case (:yin.k/reason %)\n91\t                                                             :next (assoc % :yin.k/cursor-cell :test/cursor)\n92\t                                                             :put (assoc % :yin.k/stream (rows/node :stream [:fixture/w :fixture/served])\n93\t                                                                         :yin.k/value \"v\" :yin.k/op-id nil) %)))))\n94\t\n95\t\n96\t(deftest bijection\n97\t  (doseq [fixture (ft/reference-machines)\n98\t          {:keys [frame]} (ft/reference-frames fixture)]\n99\t    (let [f (portable-frame (:machine fixture) frame) wire (rows/frame->rows f encoded) back (rows/rows->frame wire)]\n100\t      (is (= f back))\n101\t      (is (= (:yin.k/root wire) (:yin.k/root (rows/frame->rows back encoded)))))))\n102\t\n103\t\n104\t(deftest row-ids-are-jing-default\n105\t  (let [wire (rows/emit (fixture :stream/a :stream/b :source/x :source/y))]\n106\t    (is (seq (:yin.k/rows wire)))\n107\t    (doseq [[id & body] (:yin.k/rows wire)]\n108\t      (is (= id (jing/segment-key (vec body))))\n109\t      (is (= :blake3 (:algorithm (jing/parse-segment-address id)))))))\n110\t\n111\t\n112\t(defn- replace-row\n113\t  \"Rehash the edited row and all ancestors, without canonicalizing slots.\"\n114\t  [wire id body]\n115\t  (let [index (into {} (map (fn [r] [(first r) r])) (:yin.k/rows wire))\n116\t        memo (atom {})]\n117\t    (letfn [(rewrite\n118\t              [x]\n119\t              (cond\n120\t                (contains? index x)\n121\t                (or (get @memo x)\n122\t                    (let [rbody (if (= x id) body (subvec (get index x) 1))\n123\t                          b (mapv rewrite rbody) nid (jing/segment-key b)]\n124\t                      (swap! memo assoc x nid)\n125\t                      nid))\n126\t                (vector? x) (mapv rewrite x)\n127\t                :else x))]\n128\t      (let [root (rewrite (:yin.k/root wire))\n129\t            rs (mapv (fn [[old new]] (into [new] (mapv rewrite (if (= old id) body (subvec (get index old) 1))))) @memo)]\n130\t        (assoc wire :yin.k/root root :yin.k/rows rs)))))\n131\t\n132\t\n133\t(deftest window-sorted-and-unique\n134\t  (let [f (assoc ft/worked-frame :yin.k/window {1 :f 3 nil})\n135\t        wire (rows/frame->rows f) r (first (filter #(= :window (second %)) (:yin.k/rows wire)))\n136\t        id (first r)]\n137\t    (doseq [body [[:window 3 [:lit nil] 1 [:lit :f]] [:window 1 [:lit :f] 1 [:lit nil]]]]\n138\t      (let [d (error #(rows/rows->frame (replace-row wire id body)))]\n139\t        (is (= :yin.k/undecodable (:yin.k/status d)))\n140\t        (is (contains? #{:row-order :duplicate-key} (:yin.k/kind d)))))))\n141\t\n142\t\n143\t(deftest canonical-under-is-renaming-invariant\n144\t  (let [a (rows/emit (fixture :lane-a/s1 :lane-a/s2 :source/x :source/y))\n145\t        b (rows/emit (fixture :lane-b/s2 :lane-b/s1 :other/y :other/x))\n146\t        ca (rows/canonical-under a {:lane-a/s1 :s1 :lane-a/s2 :s2})\n147\t        cb (rows/canonical-under b {:lane-b/s2 :s1 :lane-b/s1 :s2})]\n148\t    (is (= (:yin.k/root ca) (:yin.k/root cb)))\n149\t    (is (= (:yin.k/root ca)\n150\t           (:yin.k/root (rows/canonical-under\n151\t                          (rows/emit-numbered (fixture :lane-a/s1 :lane-a/s2 :source/x :source/y)\n152\t                                