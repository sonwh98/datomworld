{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CD4zctMxpXnEndmStH7Rhq","type":"tool_result","content":"1\t(ns probe.discovery\n2\t  \"Prototype of discovery-order cursor-cell numbering (note D1-D5 as revised\n3\t   2026-10-12 after the codex review) over the 6a abstract task representation\n4\t   (yin.vm.ucf.rows). Not repo code; a scratch project under collab/.\n5\t\n6\t   Vocabulary: UCF 7.5.3. A cursor cell is the VM box the carrier serializes;\n7\t   its source id is the lift's local name; the procedure assigns :yin.k/cc-n.\n8\t\n9\t   Shape of the procedure (one algorithm, two uses):\n10\t   - a RUN traverses an item (D1), numbers cursor cells on first meeting (D2),\n11\t     sorts each :set / :map by the local keys of its elements and defers equal\n12\t     runs to the run's worklist (D1), re-examines the worklist to a fixpoint\n13\t     (D3), groups the surviving tied elements into components by shared\n14\t     unnumbered cursor cells, refuses a component holding two elements of one\n15\t     group (D5), encodes each component by a nested local run, and adopts the\n16\t     least encoding's components (D4); repeat until the worklist is empty.\n17\t   - the root run assigns [:n k], k = 1, 2, ...; a LOCAL run (used only to\n18\t     compute the key of an element or of a component) starts from the\n19\t     enclosing run's numbering and assigns [:u j] from the enclosing run's\n20\t     local counter; its spelling with surviving ties spelled [:tie K ...] is\n21\t     the key. Local runs are memoized on (item, numbering restricted to the\n22\t     item's cursor cells, local counter).\"\n23\t  (:require [dao.jing :as jing]\n24\t            [dao.jing.cbor :as cbor]\n25\t            [yin.vm.ucf.rows :as rows]\n26\t            [yin.vm.ucf.rows-test :as rt]\n27\t            [yin.vm.semantic-register.frame-test :as ft]))\n28\t\n29\t;; ---------------------------------------------------------------- schema\n30\t\n31\t(def synthetic-table\n32\t  \"Rows that exist only inside the procedure: a :map entry as an ordered pair,\n33\t   and a component as the ordered list of its (group-id element) pairs.\"\n34\t  {:entry [:V :V] :component [:pairs :D :V]})\n35\t\n36\t(defn descriptors [kind slots]\n37\t  (let [schema (or (get rows/row-table kind) (get synthetic-table kind))]\n38\t    (cond (= schema :pending) (into [:D] (get rows/pending-table (first slots)))\n39\t          (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n40\t          (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n41\t          :else schema)))\n42\t\n43\t(defn ref? [d] (and (vector? d) (= :ref (first d))))\n44\t(defn refs? [d] (and (vector? d) (= :refs (first d))))\n45\t(defn v? [d] (contains? #{:V :optional-V} d))\n46\t\n47\t(defn bytes-key [x] (mapv #(bit-and (int %) 255) (seq (cbor/encode x))))\n48\t\n49\t(defn compare-bytes [a b]\n50\t  (loop [i 0]\n51\t    (cond (= i (count a)) (if (= i (count b)) 0 -1)\n52\t          (= i (count b)) 1\n53\t          (= (nth a i) (nth b i)) (recur (inc i))\n54\t          :else (compare (nth a i) (nth b i)))))\n55\t\n56\t(defn by-key-bytes [f xs] (sort #(compare-bytes (f %1) (f %2)) xs))\n57\t\n58\t(def keyed-structural #{:bindings :store :parked-table})\n59\t\n60\t(defn elem-item\n61\t  \"The item an element is entered and keyed as: a :set element is its V; a\n62\t   :map entry [k v] is the synthetic ordered row [:entry k v], so that the\n63\t   alias pattern across key and value is part of the key.\"\n64\t  [kind e]\n65\t  (if (= :map kind) [:row {:kind :entry :slots (vec e)}] e))\n66\t\n67\t(defn child-task? [ctx n] (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n68\t\n69\t(defn item-cells\n70\t  \"Cursor cells occurring in slot (d x); census and install children excluded.\n71\t   Memoized per procedure on the slot value.\"\n72\t  [ctx d x]\n73\t  (or (get @(:cells-memo ctx) [d x])\n74\t      (let [acc (atom #{})]\n75\t        (letfn [(slot [d x]\n76\t                  (cond (ref? d) (node x)\n77\t                        (refs? d) (run! node x)\n78\t                        (= :C d) (swap! acc conj x)\n79\t                        (v? d) (when x (case (first x)\n80\t                                         :cursor-cell (swap! acc conj (second x))\n81\t                                         :row (node (second x))\n82\t                                         nil))\n83\t                        :else nil))\n84\t                (node [n]\n85\t                  (let [{:keys [kind slots]} n]\n86\t                    (when-not (or (= :cursor-cells kind) (child-task? ctx n))\n87\t                      (dorun (map slot (descriptors kind slots) slots)))))]\n88\t          (slot d x)\n89\t          (swap! (:cells-memo ctx) assoc [d x] @acc)\n90\t          @acc))))\n91\t\n92\t(defn body-label [ctx c]\n93\t  (let [[stream position] (:slots (get (:bodies ctx) c))]\n94\t    [:body (into [:stream] (:slots stream)) position]))\n95\t\n96\t;; ------------------------------------------------------------------ runs\n97\t\n98\t(def ^:dynamic *trace* false)\n99\t\n100\t(defn- new-run [ctx num tag next]\n101\t  {:ctx ctx :num (atom num) :tag tag :next (atom next)\n102\t   :groups (atom []) :gid (atom 0) :refused (atom nil)})\n103\t\n104\t(defn- meet!\n105\t  \"D2. A cursor cell met for the first time receives the run's next number.\"\n106\t  [run c]\n107\t  (when-not (contains? @(:num run) c)\n108\t    (let [k @(:next run)]\n109\t      (swap! (:num run) assoc c [(:tag run) k])\n110\t      (swap! (:next run) inc)\n111\t      true)))\n112\t\n113\t(declare enter-node! enter-slot! unordered! local-run resolve! spell-slot spell-node)\n114\t\n115\t(defn- enter-slot! [run d x path]\n116\t  (cond (ref? d) (enter-node! run x path)\n117\t        (refs? d) (dorun (map-indexed (fn [i n] (enter-node! run n (conj path i))) x))\n118\t        (= :C d) (meet! run x)\n119\t        (v? d) (when x (case (first x)\n120\t                         :cursor-cell (meet! run (second x))\n121\t                         :row (enter-node! run (second x) path)\n122\t                         nil))\n123\t        :else nil))\n124\t\n125\t(defn- enter-node!\n126\t  \"D1. Canonical traversal: table order for slots; ordered repeated slots in\n127\t   order; keyed structural rows in the Jing byte order of the key; :window in\n128\t   ascending register order; installs and module stores by name; :set and\n129\t   :map by local keys with ties deferred; census and children not entered.\"\n130\t  [run n path]\n131\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n132\t    (cond\n133\t      (= :cursor-cells kind) nil\n134\t      (child-task? ctx n) nil\n135\t      (= :task kind)\n136\t      (doseq [[i d x] (map vector (range) ds slots)]\n137\t        (if (contains? #{7 12} i)\n138\t          (doseq [child (by-key-bytes #(bytes-key (first (:slots %))) x)]\n139\t            (enter-node! run child (conj path i (first (:slots child)))))\n140\t          (enter-slot! run d x (conj path i))))\n141\t      (contains? keyed-structural kind)\n142\t      (doseq [[k v] (by-key-bytes #(bytes-key (first %)) (partition 2 slots))]\n143\t        (enter-slot! run (second ds) v (conj path k)))\n144\t      (= :window kind)\n145\t      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n146\t      (= :set kind) (unordered! run :set (vec slots) path)\n147\t      (= :map kind) (unordered! run :map (mapv vec (partition 2 slots)) path)\n148\t      :else (dorun (map-indexed (fn [i [d x]] (enter-slot! run d x (conj path i))) (map vector ds slots))))))\n149\t\n150\t(defn- local-key [run item]\n151\t  (let [r (local-run run item)] [(bytes-key (:spell r)) (:spell r)]))\n152\t\n153\t(defn- unordered!\n154\t  \"D1 for an unordered container: key every element by a local run under the\n155\t   numbering at this moment; enter singletons in key order; defer equal runs\n156\t   as one tie group (deferral order = canonical order).\"\n157\t  [run kind elems path]\n158\t  (let [keyed (mapv (fn [[i e]] [(local-key run (elem-item kind e)) e i]) (map-indexed vector elems))\n159\t        groups (partition-by (comp first first) (sort #(compare-bytes (first (first %1)) (first (first %2))) keyed))]\n160\t    (when (and *trace* (= :n (:tag run)))\n161\t      (println \"  [sort]\" path \"num\" @(:num run))\n162\t      (doseq [g groups] (println \"    \" (if (= 1 (count g)) \"enter\" \"DEFER\") (mapv (fn [[[_ sp] e _]] [e sp]) g))))\n163\t    (doseq [g groups]\n164\t      (if (= 1 (count g))\n165\t        (let [[_ e i] (first g)] (enter-slot! run :V (elem-item kind e) (conj path i)))\n166\t        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :kind kind :path path\n167\t                                   :key (second (first (first g))) :elems (mapv second g)})))))\n168\t\n169\t(defn- fixpoint!\n170\t  \"D3. Re-examine every deferred group in deferral order under the current\n171\t   numbering; repeat while a round numbers a cursor cell and groups remain.\"\n172\t  [run]\n173\t  (loop []\n174\t    (let [before (count @(:num run)) groups @(:groups run)]\n175\t      (reset! (:groups run) [])\n176\t      (doseq [{:keys [kind elems path]} groups] (unordered! run kind elems path))\n177\t      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n178\t\n179\t(defn- components\n180\t  \"D4. Tied elements of all surviving groups, linked by shared unnumbered\n181\t   cursor cells (union-find). A component is :conflict when it holds two\n182\t   elements of one group.\"\n183\t  [run]\n184\t  (let [num @(:num run) ctx (:ctx run)\n185\t        elems (vec (for [g @(:groups run) [i e] (map-indexed vector (:elems g))]\n186\t                     {:group (:id g) :kind (:kind g) :elem e :idx i\n187\t                      :cells (set (remove #(contains? num %) (item-cells ctx :V (elem-item (:kind g) e))))}))\n188\t        parent (atom (vec (range (count elems))))\n189\t        find (fn find [i] (let [p (@parent i)] (if (= p i) i (let [r (find p)] (swap! parent assoc i r) r))))\n190\t        union (fn [i j] (let [ri (find i) rj (find j)] (when (not= ri rj) (swap! parent assoc ri rj))))\n191\t        by-cell (reduce (fn [m [i el]] (reduce (fn [m c] (update m c (fnil conj []) i)) m (:cells el)))\n192\t                        {} (map-indexed vector elems))]\n193\t    (doseq [[_ is] by-cell] (doseq [j (rest is)] (union (first is) j)))\n194\t    (->> (group-by find (range (count elems)))\n195\t         (sort-by first)\n196\t         (mapv (fn [[_ is]]\n197\t                 (let [members (vec (sort-by (juxt :group :idx) (map elems is)))\n198\t                       groups (map :group members)]\n199\t                   {:members members\n200\t                    :conflict (not= (count groups) (count (distinct groups)))\n201\t                    :group (first groups)\n202\t                    :cells (vec (sort (distinct (mapcat :cells members))))}))))))\n203\t\n204\t(defn- component-item [comp]\n205\t  [:row {:kind :component\n206\t         :slots (vec (mapcat (fn [m] [(:group m) (elem-item (:kind m) (:elem m))]) (:members comp)))}])\n207\t\n208\t(defn- adopt!\n209\t  \"D4. Enter a component by adopting its local run: its fresh cursor cells\n210\t   receive the enclosing run's next numbers in local-index order.\"\n211\t  [run comp]\n212\t  (let [fresh (->> (:num (:ce comp))\n213\t                   (remove (fn [[c _]] (contains? @(:num run) c)))\n214\t                   (sort-by (comp second val)))]\n215\t    (doseq [[c _] fresh] (meet! run c))))\n216\t\n217\t(defn- remove-elements! [run comps]\n218\t  (let [gone (set (for [c comps m (:members c)] [(:group m) (:idx m)]))]\n219\t    (swap! (:groups run)\n220\t           (fn [gs] (vec (keep (fn [g]\n221\t                                 (let [es (vec (keep-indexed (fn [i e] (when-not (gone [(:id g) i]) e)) (:elems g)))]\n222\t                                   (when (seq es) (assoc g :elems es))))\n223\t                               gs))))))\n224\t\n225\t(defn- resolve!\n226\t  \"D3-D5 to completion. Leaves :refused set (D5) with the worklist as of the\n227\t   last fixpoint, or the worklist empty.\"\n228\t  [run]\n229\t  (loop []\n230\t    (fixpoint! run)\n231\t    (when (and *trace* (= :n (:tag run)))\n232\t      (println \"  [resolve] num\" @(:num run) \"groups\" (mapv (fn [g] [(:id g) (:path g) (mapv (fn [e] (if (= :cursor-cell (first e)) (second e) e)) (:elems g))]) @(:groups run))))\n233\t    (when (seq @(:groups run))\n234\t      (let [comps (components run)\n235\t            conflict (first (filter :conflict comps))]\n236\t        (if conflict\n237\t          (if (:permissive (:ctx run))\n238\t            ;; Diagnostic only: enter the conflicting component in listed order.\n239\t            (do (doseq [m (:members conflict)] (enter-slot! run :V (elem-item (:kind m) (:elem m)) [:permissive]))\n240\t                (remove-elements! run [conflict])\n241\t                (recur))\n242\t            (reset! (:refused run) {:kind :unresolved-cursor-cells\n243\t                                    :path (:path (first (filter #(= (:group conflict) (:id %)) @(:groups run))))\n244\t                                    :cursor-cells (:cells conflict)}))\n245\t          (let [comps (mapv #(assoc % :ce (local-run run (component-item %))) comps)]\n246\t            (if-let [bad (first (filter #(not (:complete? (:ce %))) comps))]\n247\t              (reset! (:refused run) (assoc (:refused (:ce bad)) :kind :unresolved-cursor-cells :nested true))\n248\t              (let [sorted (sort #(compare-bytes (bytes-key (:spell (:ce %1))) (bytes-key (:spell (:ce %2)))) comps)\n249\t                    least (bytes-key (:spell (:ce (first sorted))))\n250\t                    least-run (take-while #(= least (bytes-key (:spell (:ce %)))) sorted)]\n251\t                (when (and *trace* (= :n (:tag run)))\n252\t                  (doseq [c sorted] (println \"  [component]\" (mapv (fn [m] [(:group m) (:cells m)]) (:members c)) \"CE\" (:spell (:ce c))))\n253\t                  (println \"  [adopt]\" (count least-run)))\n254\t                (doseq [c least-run] (adopt! run c))\n255\t                (remove-elements! run least-run)\n256\t                (recur)))))))))\n257\t\n258\t(defn- local-run\n259\t  \"A nested run on one item from the enclosing run's numbering, tag :u. Its\n260\t   result is a key: the spelling under its final numbering, surviving ties\n261\t   spelled [:tie K ...]. Memoized.\"\n262\t  [run item]\n263\t  (let [ctx (:ctx run)\n264\t        cells (item-cells ctx :V item)\n265\t        num @(:num run)\n266\t        start (if (= :u (:tag run)) @(:next run) 0)\n267\t        mk [item (select-keys num cells) start]]\n268\t    (or (get @(:memo ctx) mk)\n269\t        (let [sub (new-run ctx num :u start)]\n270\t          (enter-slot! sub :V item [])\n271\t          (resolve! sub)\n272\t          (let [r {:spell (spell-slot sub :V item [])\n273\t                   ;; Restricted to the item's own cursor cells: the result is a\n274\t                   ;; function of the memo key, never of the enclosing context.\n275\t                   :num (select-keys @(:num sub) cells)\n276\t                   :complete? (and (nil? @(:refused sub)) (empty? @(:groups sub)))\n277\t                   :refused @(:refused sub)}]\n278\t            (swap! (:memo ctx) assoc mk r)\n279\t            r)))))\n280\t\n281\t;; -------------------------------------------------------------- spelling\n282\t\n283\t(defn- spell-cell [run c]\n284\t  (let [[t k] (get @(:num run) c)]\n285\t    (case t\n286\t      :n [:cursor-cell [:n k]]\n287\t      :u [:cursor-cell [:u k (body-label (:ctx run) c)]]\n288\t      (throw (ex-info \"spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n289\t\n290\t(defn- spell-slot [run d x path]\n291\t  (cond (ref? d) (spell-node run x path)\n292\t        (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n293\t        (= :C d) (spell-cell run x)\n294\t        (v? d) (if (nil? x) x\n295\t                   (case (first x)\n296\t                     :cursor-cell (spell-cell run (second x))\n297\t                     :row [:row (spell-node run (second x) path)]\n298\t                     x))\n299\t        :else x))\n300\t\n301\t(defn- spell-node\n302\t  \"The content encoding CE of a row under the run's final numbering.\"\n303\t  [run n path]\n304\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n305\t    (cond\n306\t      (= :cursor-cells kind) [:cursor-cells]\n307\t      (child-task? ctx n) [:child]\n308\t      (= :task kind)\n309\t      (into [kind]\n310\t            (map-indexed (fn [i [d x]]\n311\t                           (if (contains? #{7 12} i)\n312\t                             (vec (by-key-bytes #(bytes-key (nth % 1))\n313\t                                                (map #(spell-node run % (conj path i (first (:slots %)))) x)))\n314\t                             (spell-slot run d x (conj path i))))\n315\t                         (map vector ds slots)))\n316\t      (contains? keyed-structural kind)\n317\t      (into [kind] (mapcat identity (by-key-bytes #(bytes-key (first %))\n318\t                                                  (map (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n319\t                                                       (partition 2 slots)))))\n320\t      (= :window kind)\n321\t      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n322\t      (contains? #{:set :map} kind)\n323\t      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n324\t            tied (filter #(= path (:path %)) @(:groups run))\n325\t            tied-elems (set (mapcat :elems tied))\n326\t            plain (keep-indexed (fn [i e] (when-not (tied-elems e) (spell-slot run :V (elem-item kind e) (conj path i)))) elems)\n327\t            ties (map #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n328\t        (into [kind] (by-key-bytes bytes-key (concat plain ties))))\n329\t      :else (into [kind] (map-indexed (fn [i [d x]] (spell-slot run d x (conj path i))) (map vector ds slots))))))\n330\t\n331\t;; ------------------------------------------------------------- procedure\n332\t\n333\t(defn discovery-numbering\n334\t  \"Returns {:numbering {src -> :yin.k/cc-n}} or {:refused {...}}. Throws when\n335\t   the numbering is not total (a defect, never a refusal).\"\n336\t  ([task] (discovery-numbering task {}))\n337\t  ([task opts]\n338\t   (let [census (nth (:slots task) 9)\n339\t         ctx {:task task\n340\t              :bodies (into {} (map vec) (partition 2 (:slots census)))\n341\t              :memo (atom {}) :cells-memo (atom {})\n342\t              :permissive (:permissive opts)}\n343\t         run (new-run ctx {} :n 1)]\n344\t     (enter-node! run task [])\n345\t     (resolve! run)\n346\t     (if-let [r @(:refused run)]\n347\t       {:refused r}\n348\t       (let [numbered (set (keys @(:num run))) declared (set (keys (:bodies ctx)))]\n349\t         (when (seq @(:groups run)) (throw (ex-info \"residue after resolve\" {})))\n350\t         (when (not= numbered declared)\n351\t           (throw (ex-info \"numbering is not total\" {:missing (vec (remove numbered declared))\n352\t                                                      :extra (vec (remove declared numbered))})))\n353\t         {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))})))))\n354\t\n355\t;; --------------------------------------------------------------- emission\n356\t;; 6a's emit-node with install children numbered by discovery order.\n357\t\n358\t(def ^:private ordered-slots @#'rows/ordered-slots)\n359\t(def ^:private check-literal-markers! @#'rows/check-literal-markers!)\n360\t(def ^:private byte-compare @#'rows/byte-compare)\n361\t\n362\t(declare emit-node*)\n363\t\n364\t(def ^:dynamic *numbering-opts* {})\n365\t\n366\t(defn- refuse-unresolved! [r path]\n367\t  (throw (ex-info \"unresolved cursor cells\"\n368\t                  {:yin.k/status :yin.k/non-portable :yin.k/kind :unresolved-cursor-cells\n369\t                   :yin.k/path (into path (:path r)) :yin.k/cursor-cells (:cursor-cells r)})))\n370\t\n371\t(defn- emit-slot* [d x numbering rows]\n372\t  (when-not (or (ref? d) (refs? d) (= :C d))\n373\t    (check-literal-markers! (if (v? d) (when (= :lit (first x)) (second x)) x)))\n374\t  (cond\n375\t    (ref? d) (emit-node* x numbering rows)\n376\t    (refs? d) (reduce (fn [[out rs] n] (let [[id rs'] (emit-node* n numbering rs)] [(conj out id) rs'])) [[] rows] x)\n377\t    (= d :C) [(get numbering x x) rows]\n378\t    (v? d) (case (first x)\n379\t             :row (let [[id rs] (emit-node* (second x) numbering rows)] [[:row id] rs])\n380\t             :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n381\t             [x rows])\n382\t    :else [x rows]))\n383\t\n384\t(defn- emit-node* [n numbering rows]\n385\t  (let [{:keys [kind slots]} n\n386\t        [slots rows] (reduce (fn [[out rs] [d x]]\n387\t                               (if (and (ref? d) (= :task (:kind x)))\n388\t                                 (let [r (discovery-numbering x *numbering-opts*)\n389\t                                       _ (when (:refused r) (refuse-unresolved! (:refused r) [:child]))\n390\t                                       [id child-rows] (emit-node* x (:numbering r) {})]\n391\t                                   [(conj out id) (merge rs child-rows)])\n392\t                                 (let [[x' rs'] (emit-slot* d x numbering rs)] [(conj out x') rs'])))\n393\t                             [[] rows] (map vector (descriptors kind slots) slots))\n394\t        slots (if (= kind :task)\n395\t                (-> slots\n396\t                    (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n397\t                    (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n398\t                (ordered-slots kind slots))\n399\t        body (into [kind] slots) id (jing/segment-key body)]\n400\t    [id (assoc rows id (into [id] body))]))\n401\t\n402\t(defn emit*\n403\t  \"Lift side: number by discovery order, emit; refuses :yin.k/non-portable\n404\t   :unresolved-cursor-cells (D5).\"\n405\t  [task]\n406\t  (let [r (discovery-numbering task)]\n407\t    (when (:refused r) (refuse-unresolved! (:refused r) []))\n408\t    (let [[id rows] (emit-node* task (:numbering r) {})]\n409\t      {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n410\t\n411\t(defn decode*\n412\t  \"Receiver side: 6a's decode* with its own numbering check off (it still runs\n413\t   6a's recompute, under a large budget), then the discovery recompute and\n414\t   compare. Only D5 translates to :yin.k/undecodable :unresolved-cursor-cells;\n415\t   a resource refusal propagates as itself. In the real codec this check sits\n416\t   at carrier step 6, before validate-frames; here it runs after decode*\n417\t   returns (a probe limitation, documented in the note).\"\n418\t  [wire]\n419\t  (let [task (@#'rows/decode* wire (assoc rows/default-budget :check-numbering false))\n420\t        r (discovery-numbering task)]\n421\t    (when (:refused r)\n422\t      (throw (ex-info \"unresolved cursor cells\"\n423\t                      {:yin.k/status :yin.k/undecodable :yin.k/kind :unresolved-cursor-cells\n424\t                       :yin.k/path (into [(:yin.k/root wire)] (:path (:refused r)))})))\n425\t    (let [[id _] (emit-node* task (:numbering r) {})]\n426\t      (when (not= id (:yin.k/root wire))\n427\t        (throw (ex-info \"noncanonical\" {:yin.k/status :yin.k/undecodable :yin.k/kind :noncanonical-cursor-cells\n428\t                                        :yin.k/path [(:yin.k/root wire)]}))))\n429\t    task))\n430\t\n431\t(defn error [f]\n432\t  (try (f) nil (catch Throwable e (or (ex-data e) {:throwable (str e)}))))\n433\t\n434\t(defn do-root [task]\n435\t  (let [r (discovery-numbering task)]\n436\t    (if (:refused r)\n437\t      r\n438\t      (try (:yin.k/root (emit* task))\n439\t           (catch clojure.lang.ExceptionInfo e\n440\t             (if (= :unresolved-cursor-cells (:yin.k/kind (ex-data e))) {:refused (ex-data e)} (throw e)))))))\n441\t\n442\t(defn safe-6a-root [task]\n443\t  (try (:yin.k/root (rows/emit task))\n444\t       (catch Throwable e {:refused (select-keys (ex-data e) [:yin.k/kind :yin.k/path])})))\n445\t\n446\t;; ------------------------------------------------------------ generators\n447\t\n448\t(defn rename-and-shuffle\n449\t  \"Rename every cursor cell by `bij` and shuffle every :set, :map and the\n450\t   census in listed order (shuffle is rebound by callers for determinism).\"\n451\t  [n renaming]\n452\t  (letfn [(value [v] (case (first v)\n453\t                       :cursor-cell [:cursor-cell (bij (second v))]\n454\t                       :row [:row (go (second v))]\n455\t                       v))\n456\t          (bij [x] (get renaming x x))\n457\t          (go [n]\n458\t            (let [{:keys [kind slots]} n]\n459\t              (case kind\n460\t                :set (rows/node :set (vec (shuffle (mapv value slots))))\n461\t                :map (rows/node :map (vec (mapcat identity (shuffle (mapv (fn [[k v]] [(value k) (value v)]) (partition 2 slots))))))\n462\t                :cursor-cells (rows/node :cursor-cells (vec (mapcat (fn [[c b]] [(bij c) (go b)]) (shuffle (mapv vec (partition 2 slots))))))\n463\t                (rows/node kind (mapv (fn [d x]\n464\t                                        (cond (ref? d) (go x)\n465\t                                              (refs? d) (mapv go x)\n466\t                                              (= :C d) (bij x)\n467\t                                              (v? d) (if x (value x) x)\n468\t                                              :else x))\n469\t                                      (descriptors kind slots) slots)))))]\n470\t    (go n)))\n471\t\n472\t(defn all-census-cells\n473\t  \"Source ids of every census in the tree (root and install children).\"\n474\t  [task]\n475\t  (let [acc (atom [])]\n476\t    (letfn [(node [n] (when (map? n)\n477\t                        (when (= :cursor-cells (:kind n)) (swap! acc into (take-nth 2 (:slots n))))\n478\t                        (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n479\t                          (cond (ref? d) (node x) (refs? d) (run! node x)\n480\t                                (v? d) (when (and x (= :row (first x))) (node (second x)))))))]\n481\t      (node task) (vec @acc))))\n482\t\n483\t(defn seeded-shuffle [^java.util.Random r]\n484\t  (fn [xs] (let [a (java.util.ArrayList. ^java.util.Collection (vec xs))]\n485\t             (java.util.Collections/shuffle a r)\n486\t             (vec a))))\n487\t\n488\t(defn decoded\n489\t  \"Portable decoded equality of an abstract value (check-abstract!'s rule):\n490\t   sets as sets, maps as maps, cursor cells by identity.\"\n491\t  [v]\n492\t  (case (first v)\n493\t    :lit [:lit (second v)]\n494\t    :cursor-cell [:identity (second v)]\n495\t    :row (let [n (second v) ss (:slots n)]\n496\t           (case (:kind n)\n497\t             :vec [:seq (mapv decoded ss)]\n498\t             :set [:set (set (map decoded ss))]\n499\t             :map [:map (into {} (map (fn [[k x]] [(decoded k) (decoded x)])) (partition 2 ss))]\n500\t             [:row n]))))\n501\t\n502\t(defn distinct-decoded [vs] (vec (vals (into (sorted-map-by #(compare (pr-str %1) (pr-str %2))) (map (fn [e] [(decoded e) e])) vs))))\n503\t\n504\t(defn gen-value\n505\t  \"Random V over `cells`, depth-bounded. Shapes: literals, cursor cells,\n506\t   vectors, sets, maps (cursor cells as keys too), sets of cursor-cell pairs\n507\t   (edges, aliases such as [X X] included), sets of sets.\"\n508\t  [^java.util.Random r cells depth]\n509\t  (let [pick (fn [xs] (nth xs (.nextInt r (count xs))))\n510\t        cc (fn [] [:cursor-cell (pick cells)])\n511\t        k (.nextInt r (if (pos? depth) 9 3))]\n512\t    (case k\n513\t      0 [:lit (pick [1 2 :k \"s\" nil])]\n514\t      1 (cc)\n515\t      2 (cc)\n516\t      3 (let [elems (vec (repeatedly (inc (.nextInt r 3)) #(gen-value r cells (dec depth))))]\n517\t          (if (some #(not= :lit (first %)) elems) [:row (rows/node :vec elems)] [:lit (mapv second elems)]))\n518\t      4 (let [elems (distinct-decoded (repeatedly (inc (.nextInt r 4)) #(gen-value r cells (dec depth))))]\n519\t          (if (some #(not= :lit (first %)) elems) [:row (rows/node :set elems)] [:lit (set (map second elems))]))\n520\t      5 (let [pairs (vec (vals (into (sorted-map-by #(compare (pr-str %1) (pr-str %2))) (map (fn [p] [(decoded (first p)) p]))\n521\t                                     (repeatedly (inc (.nextInt r 3)) #(vector (gen-value r cells (dec depth)) (gen-value r cells (dec depth)))))))]\n522\t          (if (some (fn [[a b]] (or (not= :lit (first a)) (not= :lit (first b)))) pairs)\n523\t            [:row (rows/node :map (vec (mapcat identity pairs)))]\n524\t            [:lit (into {} (map (fn [[a b]] [(second a) (second b)])) pairs)]))\n525\t      (6 7) (let [edges (distinct-decoded (repeatedly (+ 2 (.nextInt r 3)) #(vector :row (rows/node :vec [(cc) (cc)]))))]\n526\t              [:row (rows/node :set edges)])\n527\t      8 (let [inner (distinct-decoded (repeatedly (+ 2 (.nextInt r 2))\n528\t                                                  #(let [es (distinct-decoded (repeatedly (inc (.nextInt r 3)) cc))]\n529\t                                                     [:row (rows/node :set es)])))]\n530\t          [:row (rows/node :set inner)]))))\n531\t\n532\t(defn reached [v]\n533\t  (let [acc (atom #{})]\n534\t    (letfn [(w [v] (case (first v)\n535\t                     :cursor-cell (swap! acc conj (second v))\n536\t                     :row (doseq [s (:slots (second v))] (w s))\n537\t                     nil))]\n538\t      (w v) @acc)))\n539\t\n540\t(defn gen-task\n541\t  \"A :halted task: 1-6 cursor cells over two bodies (ties common), 1-3 store\n542\t   bindings and the result slot hold random values.\"\n543\t  [seed]\n544\t  (let [r (java.util.Random. seed)\n545\t        k (inc (.nextInt r 6))\n546\t        cells (mapv #(keyword \"src\" (str \"c\" %)) (range k))\n547\t        bodies (mapv (fn [_] (rt/cursor-cell-body :s (if (zero? (.nextInt r 3)) 1 0))) cells)\n548\t        names (vec (take (inc (.nextInt r 3)) '[a b c]))\n549\t        vals (mapv (fn [_] (gen-value r cells 3)) names)\n550\t        result (gen-value r cells 2)\n551\t        used (reduce into (reached result) (map reached vals))\n552\t        census (keep (fn [[c b]] (when (used c) [c b])) (map vector cells bodies))]\n553\t    (if (empty? used)\n554\t      (recur (inc seed))\n555\t      (let [t (rt/task-node census result)]\n556\t        (rows/node :task (assoc (:slots t) 6 (rows/node :store (vec (mapcat (fn [n v] [n v]) names vals)))))))))\n557\t\n558\t(defn worked-act []\n559\t  (first (:slots (rows/decode (rows/frame->rows ft/worked-frame)))))\n560\t\n561\t(def park-vector [[:closure 0 [] 2] [:halt 0] [:park 0] [:return 0]])\n562\t(def park-address (jing/segment-key park-vector))\n563\t\n564\t(defn frame-task\n565\t  \"A blocked task carrying the worked code plus a park segment. The wait's\n566\t   act holds `wait-values` in its window register 1 and in one K frame's\n567\t   window register 1; `env-value`, when given, is bound to e0 in the free\n568\t   environment and in every environment; the parked state (P 7) is an act\n569\t   at the park site whose K frame holds `parked-value` in register 1.\n570\t   Decodes under 6a's validate-frames.\"\n571\t  [census wait-values env-value parked-value]\n572\t  (let [base (rt/task-node (conj (vec census) [:test/cursor (rt/cursor-cell-body :s 0)]) nil)\n573\t        [seg pc env window k rd] (:slots (worked-act))\n574\t        [_ store-of] (:slots env)\n575\t        bindings (rows/node :bindings (if env-value ['e0 env-value] []))\n576\t        env (rows/node :env [bindings store-of])\n577\t        kframe (fn [v] (rows/node :kframe [seg pc env (rows/node :window [1 v]) rd]))\n578\t        [w1 w2] wait-values\n579\t        wait-act (rows/node :act [seg pc env (rows/node :window [1 w1]) (rows/node :k (if w2 [(kframe w2)] [])) rd])\n580\t        pending (second (:slots (rows/decode (rows/frame->rows ft/worked-frame))))\n581\t        parked (rows/node :act [park-address 3 env (rows/node :window []) (rows/node :k [(kframe parked-value)]) 0])]\n582\t    (rows/node :task (-> (:slots base) (assoc 2 :blocked) (assoc 5 bindings)\n583\t                         (assoc 11 (merge ft/worked-code {park-address park-vector}))\n584\t                         (assoc 8 (rows/node :parked-table (if parked-value [7 parked] [])))\n585\t                         (assoc 13 [(rows/node :wait [wait-act pending])]) (assoc 16 {:yin.k/policy :yin.k/fork})))))\n586\t\n587\t(defn gen-frame-task [seed]\n588\t  (let [r (java.util.Random. seed)\n589\t        k (inc (.nextInt r 4))\n590\t        cells (mapv #(keyword \"src\" (str \"f\" %)) (range k))\n591\t        body (rt/cursor-cell-body :s 0)\n592\t        pick (fn [] (gen-value r cells 2))\n593\t        wait-values (vec (repeatedly (inc (.nextInt r 2)) pick))\n594\t        env-value (when (zero? (.nextInt r 2)) (pick))\n595\t        parked-value (when (zero? (.nextInt r 2)) (pick))\n596\t        used (reduce into #{} (map reached (remove nil? (concat wait-values [env-value parked-value]))))]\n597\t    (if (empty? used)\n598\t      (recur (inc seed))\n599\t      (frame-task (mapv #(vector % body) (filter used cells)) wait-values env-value parked-value))))\n600\t\n601\t(defn gen-child-task\n602\t  \"A parent (seed) with two install children: one random child task and the\n603\t   review counterexample as a child; the parent's own values stay random.\"\n604\t  [seed]\n605\t  (let [parent (gen-task seed)\n606\t        child (rows/node :task (assoc (:slots (gen-task (+ 100000 seed))) 3 :child))]\n607\t    (rows/node :task (assoc (:slots parent) 12 [(rows/node :install ['a :running nil {} child])\n608\t                                                (rows/node :install ['b :running nil {} child])]))))\n609\t\n610\t(defn fixture-review-counterexample\n611\t  \"'a bound to #{X Y} with equal bodies, 'b bound to X.\"\n612\t  []\n613\t  (let [body (rt/cursor-cell-body :s 0)\n614\t        t (rt/task-node [[:x body] [:y body]] [:lit nil])]\n615\t    (rows/node :task (assoc (:slots t) 6 (rows/node :store ['a [:row (rows/node :set [[:cursor-cell :x] [:cursor-cell :y]])]\n616\t                                                             'b [:cursor-cell :x]])))))\n617\t\n618\t;; ------------------------------------------------------------ diagnostics\n619\t\n620\t(defn permissive-roots\n621\t  \"For a refused state: run the procedure with D5 replaced by listed-order\n622\t   entry, over `n` shuffles of every unordered container. More than one root\n623\t   is a witness that the state is not interchangeable; one root over n\n624\t   shuffles is not a proof.\"\n625\t  [task n]\n626\t  (let [r (java.util.Random. 7)]\n627\t    (with-redefs [shuffle (seeded-shuffle r)]\n628\t      (->> (repeatedly n #(rename-and-shuffle task identity))\n629\t           (map (fn [t] (binding [*numbering-opts* {:permissive true}]\n630\t                          (let [d (discovery-numbering t {:permissive true})\n631\t                                [id _] (emit-node* t (:numbering d) {})]\n632\t                            id))))\n633\t           distinct count))))\n634\t\n635\t(defn report-fixture [name task]\n636\t  (let [d (discovery-numbering task)]\n637\t    (println name)\n638\t    (println \"  DO :\" (or (:refused d) (into (sorted-map) (:numbering d))))\n639\t    (println \"  DO root:\" (do-root task))\n640\t    (println \"  6a root:\" (safe-6a-root task))))\n641\t\n642\t(defn invariance-check\n643\t  \"Root of the state and of the state renamed and shuffled; decode of the\n644\t   carrier. Returns a map of outcomes.\"\n645\t  [task ^java.util.Random r]\n646\t  (let [cells (all-census-cells task)\n647\t        fresh (zipmap cells (map #(keyword \"other\" (str \"z\" %)) (shuffle (range (count cells)))))\n648\t        task2 (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle task fresh))\n649\t        d1 (do-root task) d2 (do-root task2)]\n650\t    (if (map? d1)\n651\t      {:refused (:refused d1)}\n652\t      (cond-> {:root d1 :invariant (= d1 d2)}\n653\t        true (assoc :decode (let [e (error #(decode* (emit* task)))]\n654\t                              (cond (nil? e) :ok\n655\t                                    (= :resource-limit (:yin.k/kind e)) :sixa-recompute-limit\n656\t                                    :else e)))))))\n657\t\n658\t(defn search [label gen seeds]\n659\t  (let [r (java.util.Random. 11)\n660\t        stats (atom {:numbered 0 :refused 0 :invariance-fail 0 :decode-ok 0 :decode-fail 0 :decode-6a-limit 0\n661\t                     :refused-witnessed-noninterchangeable 0 :refused-not-distinguished 0})]\n662\t    (doseq [seed seeds]\n663\t      (let [task (gen seed) o (invariance-check task r)]\n664\t        (if (:refused o)\n665\t          (do (swap! stats update :refused inc)\n666\t              (if (> (permissive-roots task 12) 1)\n667\t                (swap! stats update :refused-witnessed-noninterchangeable inc)\n668\t                (swap! stats update :refused-not-distinguished inc)))\n669\t          (do (swap! stats update :numbered inc)\n670\t              (when-not (:invariant o) (swap! stats update :invariance-fail inc) (println \"INVARIANCE FAIL\" label seed))\n671\t              (case (:decode o)\n672\t                :ok (swap! stats update :decode-ok inc)\n673\t                :sixa-recompute-limit (swap! stats update :decode-6a-limit inc)\n674\t                (do (swap! stats update :decode-fail inc) (println \"DECODE FAIL\" label seed (:decode o))))))))\n675\t    (println label (count seeds) \"states:\" @stats)\n676\t    @stats))\n677\t\n678\t(defn -main []\n679\t  (let [body (rt/cursor-cell-body :s 0)\n680\t        s (fn [es] [:row (rows/node :set es)])\n681\t        v (fn [cs] [:row (rows/node :vec (mapv #(vector :cursor-cell %) cs))])\n682\t        c (fn [x] [:cursor-cell x])\n683\t        task (fn [ids result] (rt/task-node (mapv #(vector % body) ids) result))]\n684\t    (println \"== fixtures\")\n685\t    (report-fixture \"fixture :s1 :s2 :x :y (pinned fab223...)\" (rt/fixture :s1 :s2 :x :y))\n686\t    (report-fixture \"review counterexample 'a #{X Y}, 'b X\" (fixture-review-counterexample))\n687\t    (report-fixture \"symmetric pair #{X Y}\" (task [:x :y] (s [(c :x) (c :y)])))\n688\t    (report-fixture \"alias a: [x x y]\" (task [:x :y] (v [:x :x :y])))\n689\t    (report-fixture \"alias b: [x y y]\" (task [:x :y] (v [:x :y :y])))\n690\t    (report-fixture \"#{[X X] [Y Y]}\" (task [:x :y] (s [(v [:x :x]) (v [:y :y])])))\n691\t    (report-fixture \"{X 1, Y 1}\" (task [:x :y] [:row (rows/node :map [(c :x) [:lit 1] (c :y) [:lit 1]])]))\n692\t    (report-fixture \"codex A: #{[X X] [Y Z]}\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])])))\n693\t    (report-fixture \"codex A reversed\" (task [:x :y :z] (s [(v [:y :z]) (v [:x :x])])))\n694\t    (report-fixture \"codex B: {X X, Y Z}\" (task [:x :y :z] [:row (rows/node :map [(c :x) (c :x) (c :y) (c :z)])]))\n695\t    (report-fixture \"codex B reversed\" (task [:x :y :z] [:row (rows/node :map [(c :y) (c :z) (c :x) (c :x)])]))\n696\t    (report-fixture \"codex C: #{#{X Y} #{Z W}}\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])])))\n697\t    (report-fixture \"codex C renamed\" (task [:q :r :s :t] (s [(s [(c :s) (c :t)]) (s [(c :q) (c :r)])])))\n698\t    (report-fixture \"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])]))\n699\t    (report-fixture \"[#{X Y} X]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (c :x)])]))\n700\t    (report-fixture \"[#{#{X Y} #{Z W}} X]\" (task [:x :y :z :w] [:row (rows/node :vec [(s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]) (c :x)])]))\n701\t    (report-fixture \"#{[#{X Y} #{X Y}] [#{P Q} #{R S}]} (equal keys would be unsound; keys differ)\"\n702\t                    (task [:x :y :p :q :r :s] (s [[:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])]\n703\t                                                   [:row (rows/node :vec [(s [(c :p) (c :q)]) (s [(c :r) (c :s)])])]])))\n704\t    (report-fixture \"loop + 2-cycle #{[L L] [A B] [B A]} (6a pinned 55ff16...)\" (task [:l :a :b] (s [(v [:l :l]) (v [:a :b]) (v [:b :a])])))\n705\t    (report-fixture \"2-cycle #{[A B] [B A]}\" (task [:a :b] (s [(v [:a :b]) (v [:b :a])])))\n706\t    (report-fixture \"3-cycle #{[A B] [B C] [C A]}\" (task [:a :b :c] (s [(v [:a :b]) (v [:b :c]) (v [:c :a])])))\n707\t    (report-fixture \"seven-cell triangle+square\" (rt/seven-cursor-cell-triangle-square))\n708\t    (let [ids (mapv #(keyword \"src\" (str \"x\" %)) (range 10))]\n709\t      (report-fixture \"ten cells in a vec\" (rt/task-node (mapv (fn [id i] [id (rt/cursor-cell-body :s i)]) ids (range))\n710\t                                                         (v ids))))\n711\t    (println \"\\n== refused states: permissive roots over 24 shuffles (>1 = witnessed non-interchangeable)\")\n712\t    (doseq [[name t] [[\"loop + 2-cycle\" (task [:l :a :b] (s [(v [:l :l]) (v [:a :b]) (v [:b :a])]))]\n713\t                      [\"2-cycle\" (task [:a :b] (s [(v [:a :b]) (v [:b :a])]))]\n714\t                      [\"3-cycle\" (task [:a :b :c] (s [(v [:a :b]) (v [:b :c]) (v [:c :a])]))]\n715\t                      [\"seven-cell\" (rt/seven-cursor-cell-triangle-square)]\n716\t                      [\"path #{[A B] [B C]} (refused: A and B are not interchangeable)\" (task [:a :b :c] (s [(v [:a :b]) (v [:b :c])]))]]]\n717\t      (println \" \" name \":\" (permissive-roots t 24) \"distinct root(s)\"))\n718\t    (println \"\\n== invariance under element reversal + renaming/shuffling\")\n719\t    (let [r (java.util.Random. 3)]\n720\t      (doseq [[name t] [[\"#{[X X] [Y Y]}\" (task [:x :y] (s [(v [:x :x]) (v [:y :y])]))]\n721\t                        [\"{X 1, Y 1}\" (task [:x :y] [:row (rows/node :map [(c :x) [:lit 1] (c :y) [:lit 1]])])]\n722\t                        [\"#{X Y}\" (task [:x :y] (s [(c :x) (c :y)]))]\n723\t                        [\"review counterexample\" (fixture-review-counterexample)]\n724\t                        [\"codex A\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])]))]\n725\t                        [\"codex B\" (task [:x :y :z] [:row (rows/node :map [(c :x) (c :x) (c :y) (c :z)])])]\n726\t                        [\"codex C\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]))]\n727\t                        [\"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])])]]]\n728\t        (let [rev (with-redefs [shuffle (comp vec reverse)] (rename-and-shuffle t identity))\n729\t              ren (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle t (fn [x] (keyword \"q\" (clojure.core/name x)))))]\n730\t          (println name \"DO:\" (do-root t) \"| reversed equal:\" (= (do-root t) (do-root rev))\n731\t                   \"| renamed+shuffled equal:\" (= (do-root t) (do-root ren)) \"| decode:\" (or (error #(decode* (emit* t))) :ok)))))\n732\t    (println \"\\n== frame-bearing fixtures (act window, K frame window, environments, parked state)\")\n733\t    (let [t (frame-task [[:x body] [:y body]] [(c :x) (c :y)] (c :y) (s [(c :x) (c :y)]))]\n734\t      (report-fixture \"wait window x, K window y, env y, parked K window #{x y}\" t)\n735\t      (println \"  decode:\" (or (error #(decode* (emit* t))) :ok)))\n736\t    (let [t (frame-task [[:x body] [:y body]] [(s [(c :x) (c :y)])] nil (c :y))]\n737\t      (report-fixture \"wait window #{x y}, parked K window y (parked table, slot 8, precedes frames, slot 13)\" t)\n738\t      (println \"  decode:\" (or (error #(decode* (emit* t))) :ok)))\n739\t    (println \"\\n== install children numbered by discovery order\")\n740\t    (let [child (rows/node :task (assoc (:slots (fixture-review-counterexample)) 3 :child))\n741\t          parent (rows/node :task (assoc (:slots (rt/task-node [[:x (rt/cursor-cell-body :root/s 1)]] (c :x))) 12\n742\t                                         [(rows/node :install ['a :running nil {} child])\n743\t                                          (rows/node :install ['b :running nil {} child])]))\n744\t          wire (emit* parent)]\n745\t      (println \"  parent root:\" (:yin.k/root wire) \"| task rows:\" (count (filter #(= :task (second %)) (:yin.k/rows wire)))\n746\t               \"| child numbering:\" (into (sorted-map) (:numbering (discovery-numbering child)))\n747\t               \"| decode:\" (or (error #(decode* wire)) :ok)))\n748\t    (println \"\\n== counterexample search\")\n749\t    (search \"random values\" gen-task (range 2000))\n750\t    (search \"frame-bearing\" gen-frame-task (range 200))\n751\t    (search \"with children\" gen-child-task (range 100))))\n752\t"}]},"parent_tool_use_id":null,"session_id":"7984b61f-639f-4af2-b00a-5b9b7d554f75","uuid":"31cd393c-c88b-4516-b9b6-9c4c71abb44b","timestamp":"2026-10-12T06:20:10.103Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-numbering/collab/numbering-probe/src/probe/discovery.clj","content":"(ns probe.discovery\n  \"Prototype of discovery-order cursor-cell numbering (note D1-D5 as revised\n   2026-10-12 after the codex review) over the 6a abstract task representation\n   (yin.vm.ucf.rows). Not repo code; a scratch project under collab/.\n\n   Vocabulary: UCF 7.5.3. A cursor cell is the VM box the carrier serializes;\n   its source id is the lift's local name; the procedure assigns :yin.k/cc-n.\n\n   Shape of the procedure (one algorithm, two uses):\n   - a RUN traverses an item (D1), numbers cursor cells on first meeting (D2),\n     sorts each :set / :map by the local keys of its elements and defers equal\n     runs to the run's worklist (D1), re-examines the worklist to a fixpoint\n     (D3), groups the surviving tied elements into components by shared\n     unnumbered cursor cells, refuses a component holding two elements of one\n     group (D5), encodes each component by a nested local run, and adopts the\n     least encoding's components (D4); repeat until the worklist is empty.\n   - the root run assigns [:n k], k = 1, 2, ...; a LOCAL run (used only to\n     compute the key of an element or of a component) starts from the\n     enclosing run's numbering and assigns [:u j] from the enclosing run's\n     local counter; its spelling with surviving ties spelled [:tie K ...] is\n     the key. Local runs are memoized on (item, numbering restricted to the\n     item's cursor cells, local counter).\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-test :as rt]\n            [yin.vm.semantic-register.frame-test :as ft]))\n\n;; ---------------------------------------------------------------- schema\n\n(def synthetic-table\n  \"Rows that exist only inside the procedure: a :map entry as an ordered pair,\n   and a component as the ordered list of its (group-id element) pairs.\"\n  {:entry [:V :V] :component [:pairs :D :V]})\n\n(defn descriptors [kind slots]\n  (let [schema (or (get rows/row-table kind) (get synthetic-table kind))]\n    (cond (= schema :pending) (into [:D] (get rows/pending-table (first slots)))\n          (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n          (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n          :else schema)))\n\n(defn ref? [d] (and (vector? d) (= :ref (first d))))\n(defn refs? [d] (and (vector? d) (= :refs (first d))))\n(defn v? [d] (contains? #{:V :optional-V} d))\n\n(defn bytes-key [x] (mapv #(bit-and (int %) 255) (seq (cbor/encode x))))\n\n(defn compare-bytes [a b]\n  (loop [i 0]\n    (cond (= i (count a)) (if (= i (count b)) 0 -1)\n          (= i (count b)) 1\n          (= (nth a i) (nth b i)) (recur (inc i))\n          :else (compare (nth a i) (nth b i)))))\n\n(defn by-key-bytes [f xs] (sort #(compare-bytes (f %1) (f %2)) xs))\n\n(def keyed-structural #{:bindings :store :parked-table})\n\n(defn elem-item\n  \"The item an element is entered and keyed as: a :set element is its V; a\n   :map entry [k v] is the synthetic ordered row [:entry k v], so that the\n   alias pattern across key and value is part of the key.\"\n  [kind e]\n  (if (= :map kind) [:row {:kind :entry :slots (vec e)}] e))\n\n(defn child-task? [ctx n] (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n\n(defn item-cells\n  \"Cursor cells occurring in slot (d x); census and install children excluded.\n   Memoized per procedure on the slot value.\"\n  [ctx d x]\n  (or (get @(:cells-memo ctx) [d x])\n      (let [acc (atom #{})]\n        (letfn [(slot [d x]\n                  (cond (ref? d) (node x)\n                        (refs? d) (run! node x)\n                        (= :C d) (swap! acc conj x)\n                        (v? d) (when x (case (first x)\n                                         :cursor-cell (swap! acc conj (second x))\n                                         :row (node (second x))\n                                         nil))\n                        :else nil))\n                (node [n]\n                  (let [{:keys [kind slots]} n]\n                    (when-not (or (= :cursor-cells kind) (child-task? ctx n))\n                      (dorun (map slot (descriptors kind slots) slots)))))]\n          (slot d x)\n          (swap! (:cells-memo ctx) assoc [d x] @acc)\n          @acc))))\n\n(defn body-label [ctx c]\n  (let [[stream position] (:slots (get (:bodies ctx) c))]\n    [:body (into [:stream] (:slots stream)) position]))\n\n;; ------------------------------------------------------------------ runs\n\n(def ^:dynamic *trace* false)\n\n(defn- new-run [ctx num tag next]\n  {:ctx ctx :num (atom num) :tag tag :next (atom next)\n   :groups (atom []) :gid (atom 0) :refused (atom nil)})\n\n(defn- meet!\n  \"D2. A cursor cell met for the first time receives the run's next number.\"\n  [run c]\n  (when-not (contains? @(:num run) c)\n    (let [k @(:next run)]\n      (swap! (:num run) assoc c [(:tag run) k])\n      (swap! (:next run) inc)\n      true)))\n\n(declare enter-node! enter-slot! unordered! local-run resolve! spell-slot spell-node)\n\n(defn- enter-slot! [run d x path]\n  (cond (ref? d) (enter-node! run x path)\n        (refs? d) (dorun (map-indexed (fn [i n] (enter-node! run n (conj path i))) x))\n        (= :C d) (meet! run x)\n        (v? d) (when x (case (first x)\n                         :cursor-cell (meet! run (second x))\n                         :row (enter-node! run (second x) path)\n                         nil))\n        :else nil))\n\n(defn- enter-node!\n  \"D1. Canonical traversal: table order for slots; ordered repeated slots in\n   order; keyed structural rows in the Jing byte order of the key; :window in\n   ascending register order; installs and module stores by name; :set and\n   :map by local keys with ties deferred; census and children not entered.\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (= :cursor-cells kind) nil\n      (child-task? ctx n) nil\n      (= :task kind)\n      (doseq [[i d x] (map vector (range) ds slots)]\n        (if (contains? #{7 12} i)\n          (doseq [child (by-key-bytes #(bytes-key (first (:slots %))) x)]\n            (enter-node! run child (conj path i (first (:slots child)))))\n          (enter-slot! run d x (conj path i))))\n      (contains? keyed-structural kind)\n      (doseq [[k v] (by-key-bytes #(bytes-key (first %)) (partition 2 slots))]\n        (enter-slot! run (second ds) v (conj path k)))\n      (= :window kind)\n      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n      (= :set kind) (unordered! run :set (vec slots) path)\n      (= :map kind) (unordered! run :map (mapv vec (partition 2 slots)) path)\n      :else (dorun (map-indexed (fn [i [d x]] (enter-slot! run d x (conj path i))) (map vector ds slots))))))\n\n(defn- local-key [run item]\n  (let [r (local-run run item)] [(bytes-key (:spell r)) (:spell r)]))\n\n(defn- unordered!\n  \"D1 for an unordered container: key every element by a local run under the\n   numbering at this moment; enter singletons in key order; defer equal runs\n   as one tie group (deferral order = canonical order).\"\n  [run kind elems path]\n  (let [keyed (mapv (fn [[i e]] [(local-key run (elem-item kind e)) e i]) (map-indexed vector elems))\n        groups (partition-by (comp first first) (sort #(compare-bytes (first (first %1)) (first (first %2))) keyed))]\n    (when (and *trace* (= :n (:tag run)))\n      (println \"  [sort]\" path \"num\" @(:num run))\n      (doseq [g groups] (println \"    \" (if (= 1 (count g)) \"enter\" \"DEFER\") (mapv (fn [[[_ sp] e _]] [e sp]) g))))\n    (doseq [g groups]\n      (if (= 1 (count g))\n        (let [[_ e i] (first g)] (enter-slot! run :V (elem-item kind e) (conj path i)))\n        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :kind kind :path path\n                                   :key (second (first (first g))) :elems (mapv second g)})))))\n\n(defn- fixpoint!\n  \"D3. Re-examine every deferred group in deferral order under the current\n   numbering; repeat while a round numbers a cursor cell and groups remain.\"\n  [run]\n  (loop []\n    (let [before (count @(:num run)) groups @(:groups run)]\n      (reset! (:groups run) [])\n      (doseq [{:keys [kind elems path]} groups] (unordered! run kind elems path))\n      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n\n(defn- components\n  \"D4. Tied elements of all surviving groups, linked by shared unnumbered\n   cursor cells (union-find). A component is :conflict when it holds two\n   elements of one group.\"\n  [run]\n  (let [num @(:num run) ctx (:ctx run)\n        elems (vec (for [g @(:groups run) [i e] (map-indexed vector (:elems g))]\n                     {:group (:id g) :kind (:kind g) :elem e :idx i\n                      :cells (set (remove #(contains? num %) (item-cells ctx :V (elem-item (:kind g) e))))}))\n        parent (atom (vec (range (count elems))))\n        find (fn find [i] (let [p (@parent i)] (if (= p i) i (let [r (find p)] (swap! parent assoc i r) r))))\n        union (fn [i j] (let [ri (find i) rj (find j)] (when (not= ri rj) (swap! parent assoc ri rj))))\n        by-cell (reduce (fn [m [i el]] (reduce (fn [m c] (update m c (fnil conj []) i)) m (:cells el)))\n                        {} (map-indexed vector elems))]\n    (doseq [[_ is] by-cell] (doseq [j (rest is)] (union (first is) j)))\n    (->> (group-by find (range (count elems)))\n         (sort-by first)\n         (mapv (fn [[_ is]]\n                 (let [members (vec (sort-by (juxt :group :idx) (map elems is)))\n                       groups (map :group members)]\n                   {:members members\n                    :conflict (not= (count groups) (count (distinct groups)))\n                    :group (first groups)\n                    :cells (vec (sort (distinct (mapcat :cells members))))}))))))\n\n(defn- component-item [comp]\n  [:row {:kind :component\n         :slots (vec (mapcat (fn [m] [(:group m) (elem-item (:kind m) (:elem m))]) (:members comp)))}])\n\n(defn- adopt!\n  \"D4. Enter a component by adopting its local run: its fresh cursor cells\n   receive the enclosing run's next numbers in local-index order.\"\n  [run comp]\n  (let [fresh (->> (:num (:ce comp))\n                   (remove (fn [[c _]] (contains? @(:num run) c)))\n                   (sort-by (comp second val)))]\n    (doseq [[c _] fresh] (meet! run c))))\n\n(defn- remove-elements! [run comps]\n  (let [gone (set (for [c comps m (:members c)] [(:group m) (:idx m)]))]\n    (swap! (:groups run)\n           (fn [gs] (vec (keep (fn [g]\n                                 (let [es (vec (keep-indexed (fn [i e] (when-not (gone [(:id g) i]) e)) (:elems g)))]\n                                   (when (seq es) (assoc g :elems es))))\n                               gs))))))\n\n(defn- resolve!\n  \"D3-D5 to completion. Leaves :refused set (D5) with the worklist as of the\n   last fixpoint, or the worklist empty.\"\n  [run]\n  (loop []\n    (fixpoint! run)\n    (when (and *trace* (= :n (:tag run)))\n      (println \"  [resolve] num\" @(:num run) \"groups\" (mapv (fn [g] [(:id g) (:path g) (mapv (fn [e] (if (= :cursor-cell (first e)) (second e) e)) (:elems g))]) @(:groups run))))\n    (when (seq @(:groups run))\n      (let [comps (components run)\n            conflict (first (filter :conflict comps))]\n        (if conflict\n          (if (:permissive (:ctx run))\n            ;; Diagnostic only: enter the conflicting component in listed order.\n            (do (doseq [m (:members conflict)] (enter-slot! run :V (elem-item (:kind m) (:elem m)) [:permissive]))\n                (remove-elements! run [conflict])\n                (recur))\n            (reset! (:refused run) {:kind :unresolved-cursor-cells\n                                    :path (:path (first (filter #(= (:group conflict) (:id %)) @(:groups run))))\n                                    :cursor-cells (:cells conflict)}))\n          (let [comps (mapv #(assoc % :ce (local-run run (component-item %))) comps)]\n            (if-let [bad (first (filter #(not (:complete? (:ce %))) comps))]\n              (reset! (:refused run) (assoc (:refused (:ce bad)) :kind :unresolved-cursor-cells :nested true))\n              (let [sorted (sort #(compare-bytes (bytes-key (:spell (:ce %1))) (bytes-key (:spell (:ce %2)))) comps)\n                    least (bytes-key (:spell (:ce (first sorted))))\n                    least-run (take-while #(= least (bytes-key (:spell (:ce %)))) sorted)]\n                (when (and *trace* (= :n (:tag run)))\n                  (doseq [c sorted] (println \"  [component]\" (mapv (fn [m] [(:group m) (:cells m)]) (:members c)) \"CE\" (:spell (:ce c))))\n                  (println \"  [adopt]\" (count least-run)))\n                (doseq [c least-run] (adopt! run c))\n                (remove-elements! run least-run)\n                (recur)))))))))\n\n(defn- local-run\n  \"A nested run on one item from the enclosing run's numbering, tag :u. Its\n   result is a key: the spelling under its final numbering, surviving ties\n   spelled [:tie K ...]. Memoized.\"\n  [run item]\n  (let [ctx (:ctx run)\n        cells (item-cells ctx :V item)\n        num @(:num run)\n        start (if (= :u (:tag run)) @(:next run) 0)\n        mk [item (select-keys num cells) start]]\n    (or (get @(:memo ctx) mk)\n        (let [sub (new-run ctx num :u start)]\n          (enter-slot! sub :V item [])\n          (resolve! sub)\n          (let [r {:spell (spell-slot sub :V item [])\n                   ;; Restricted to the item's own cursor cells: the result is a\n                   ;; function of the memo key, never of the enclosing context.\n                   :num (select-keys @(:num sub) cells)\n                   :complete? (and (nil? @(:refused sub)) (empty? @(:groups sub)))\n                   :refused @(:refused sub)}]\n            (swap! (:memo ctx) assoc mk r)\n            r)))))\n\n;; -------------------------------------------------------------- spelling\n\n(defn- spell-cell [run c]\n  (let [[t k] (get @(:num run) c)]\n    (case t\n      :n [:cursor-cell [:n k]]\n      :u [:cursor-cell [:u k (body-label (:ctx run) c)]]\n      (throw (ex-info \"spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n\n(defn- spell-slot [run d x path]\n  (cond (ref? d) (spell-node run x path)\n        (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n        (= :C d) (spell-cell run x)\n        (v? d) (if (nil? x) x\n                   (case (first x)\n                     :cursor-cell (spell-cell run (second x))\n                     :row [:row (spell-node run (second x) path)]\n                     x))\n        :else x))\n\n(defn- spell-node\n  \"The content encoding CE of a row under the run's final numbering.\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (= :cursor-cells kind) [:cursor-cells]\n      (child-task? ctx n) [:child]\n      (= :task kind)\n      (into [kind]\n            (map-indexed (fn [i [d x]]\n                           (if (contains? #{7 12} i)\n                             (vec (by-key-bytes #(bytes-key (nth % 1))\n                                                (map #(spell-node run % (conj path i (first (:slots %)))) x)))\n                             (spell-slot run d x (conj path i))))\n                         (map vector ds slots)))\n      (contains? keyed-structural kind)\n      (into [kind] (mapcat identity (by-key-bytes #(bytes-key (first %))\n                                                  (map (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n                                                       (partition 2 slots)))))\n      (= :window kind)\n      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n      (contains? #{:set :map} kind)\n      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n            tied (filter #(= path (:path %)) @(:groups run))\n            tied-elems (set (mapcat :elems tied))\n            plain (keep-indexed (fn [i e] (when-not (tied-elems e) (spell-slot run :V (elem-item kind e) (conj path i)))) elems)\n            ties (map #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n        (into [kind] (by-key-bytes bytes-key (concat plain ties))))\n      :else (into [kind] (map-indexed (fn [i [d x]] (spell-slot run d x (conj path i))) (map vector ds slots))))))\n\n;; ------------------------------------------------------------- procedure\n\n(defn discovery-numbering\n  \"Returns {:numbering {src -> :yin.k/cc-n}} or {:refused {...}}. Throws when\n   the numbering is not total (a defect, never a refusal).\"\n  ([task] (discovery-numbering task {}))\n  ([task opts]\n   (let [census (nth (:slots task) 9)\n         ctx {:task task\n              :bodies (into {} (map vec) (partition 2 (:slots census)))\n              :memo (atom {}) :cells-memo (atom {})\n              :permissive (:permissive opts)}\n         run (new-run ctx {} :n 1)]\n     (enter-node! run task [])\n     (resolve! run)\n     (if-let [r @(:refused run)]\n       {:refused r}\n       (let [numbered (set (keys @(:num run))) declared (set (keys (:bodies ctx)))]\n         (when (seq @(:groups run)) (throw (ex-info \"residue after resolve\" {})))\n         (when (not= numbered declared)\n           (throw (ex-info \"numbering is not total\" {:missing (vec (remove numbered declared))\n                                                      :extra (vec (remove declared numbered))})))\n         {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))})))))\n\n;; --------------------------------------------------------------- emission\n;; 6a's emit-node with install children numbered by discovery order.\n\n(def ^:private ordered-slots @#'rows/ordered-slots)\n(def ^:private check-literal-markers! @#'rows/check-literal-markers!)\n(def ^:private byte-compare @#'rows/byte-compare)\n\n(declare emit-node*)\n\n(def ^:dynamic *numbering-opts* {})\n\n(defn- refuse-unresolved! [r path]\n  (throw (ex-info \"unresolved cursor cells\"\n                  {:yin.k/status :yin.k/non-portable :yin.k/kind :unresolved-cursor-cells\n                   :yin.k/path (into path (:path r)) :yin.k/cursor-cells (:cursor-cells r)})))\n\n(defn- emit-slot* [d x numbering rows]\n  (when-not (or (ref? d) (refs? d) (= :C d))\n    (check-literal-markers! (if (v? d) (when (= :lit (first x)) (second x)) x)))\n  (cond\n    (ref? d) (emit-node* x numbering rows)\n    (refs? d) (reduce (fn [[out rs] n] (let [[id rs'] (emit-node* n numbering rs)] [(conj out id) rs'])) [[] rows] x)\n    (= d :C) [(get numbering x x) rows]\n    (v? d) (case (first x)\n             :row (let [[id rs] (emit-node* (second x) numbering rows)] [[:row id] rs])\n             :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n             [x rows])\n    :else [x rows]))\n\n(defn- emit-node* [n numbering rows]\n  (let [{:keys [kind slots]} n\n        [slots rows] (reduce (fn [[out rs] [d x]]\n                               (if (and (ref? d) (= :task (:kind x)))\n                                 (let [r (discovery-numbering x *numbering-opts*)\n                                       _ (when (:refused r) (refuse-unresolved! (:refused r) [:child]))\n                                       [id child-rows] (emit-node* x (:numbering r) {})]\n                                   [(conj out id) (merge rs child-rows)])\n                                 (let [[x' rs'] (emit-slot* d x numbering rs)] [(conj out x') rs'])))\n                             [[] rows] (map vector (descriptors kind slots) slots))\n        slots (if (= kind :task)\n                (-> slots\n                    (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n                    (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n                (ordered-slots kind slots))\n        body (into [kind] slots) id (jing/segment-key body)]\n    [id (assoc rows id (into [id] body))]))\n\n(defn emit*\n  \"Lift side: number by discovery order, emit; refuses :yin.k/non-portable\n   :unresolved-cursor-cells (D5).\"\n  [task]\n  (let [r (discovery-numbering task)]\n    (when (:refused r) (refuse-unresolved! (:refused r) []))\n    (let [[id rows] (emit-node* task (:numbering r) {})]\n      {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n\n(defn decode*\n  \"Receiver side: 6a's decode* with its own numbering check off (it still runs\n   6a's recompute, under a large budget), then the discovery recompute and\n   compare. Only D5 translates to :yin.k/undecodable :unresolved-cursor-cells;\n   a resource refusal propagates as itself. In the real codec this check sits\n   at carrier step 6, before validate-frames; here it runs after decode*\n   returns (a probe limitation, documented in the note).\"\n  [wire]\n  (let [task (@#'rows/decode* wire (assoc rows/default-budget :check-numbering false))\n        r (discovery-numbering task)]\n    (when (:refused r)\n      (throw (ex-info \"unresolved cursor cells\"\n                      {:yin.k/status :yin.k/undecodable :yin.k/kind :unresolved-cursor-cells\n                       :yin.k/path (into [(:yin.k/root wire)] (:path (:refused r)))})))\n    (let [[id _] (emit-node* task (:numbering r) {})]\n      (when (not= id (:yin.k/root wire))\n        (throw (ex-info \"noncanonical\" {:yin.k/status :yin.k/undecodable :yin.k/kind :noncanonical-cursor-cells\n                                        :yin.k/path [(:yin.k/root wire)]}))))\n    task))\n\n(defn error [f]\n  (try (f) nil (catch Throwable e (or (ex-data e) {:throwable (str e)}))))\n\n(defn do-root [task]\n  (let [r (discovery-numbering task)]\n    (if (:refused r)\n      r\n      (try (:yin.k/root (emit* task))\n           (catch clojure.lang.ExceptionInfo e\n             (if (= :unresolved-cursor-cells (:yin.k/kind (ex-data e))) {:refused (ex-data e)} (throw e)))))))\n\n(defn safe-6a-root [task]\n  (try (:yin.k/root (rows/emit task))\n       (catch Throwable e {:refused (select-keys (ex-data e) [:yin.k/kind :yin.k/path])})))\n\n;; ------------------------------------------------------------ generators\n\n(defn rename-and-shuffle\n  \"Rename every cursor cell by `bij` and shuffle every :set, :map and the\n   census in listed order (shuffle is rebound by callers for determinism).\"\n  [n renaming]\n  (letfn [(value [v] (case (first v)\n                       :cursor-cell [:cursor-cell (bij (second v))]\n                       :row [:row (go (second v))]\n                       v))\n          (bij [x] (get renaming x x))\n          (go [n]\n            (let [{:keys [kind slots]} n]\n              (case kind\n                :set (rows/node :set (vec (shuffle (mapv value slots))))\n                :map (rows/node :map (vec (mapcat identity (shuffle (mapv (fn [[k v]] [(value k) (value v)]) (partition 2 slots))))))\n                :cursor-cells (rows/node :cursor-cells (vec (mapcat (fn [[c b]] [(bij c) (go b)]) (shuffle (mapv vec (partition 2 slots))))))\n                (rows/node kind (mapv (fn [d x]\n                                        (cond (ref? d) (go x)\n                                              (refs? d) (mapv go x)\n                                              (= :C d) (bij x)\n                                              (v? d) (if x (value x) x)\n                                              :else x))\n                                      (descriptors kind slots) slots)))))]\n    (go n)))\n\n(defn all-census-cells\n  \"Source ids of every census in the tree (root and install children).\"\n  [task]\n  (let [acc (atom [])]\n    (letfn [(node [n] (when (map? n)\n                        (when (= :cursor-cells (:kind n)) (swap! acc into (take-nth 2 (:slots n))))\n                        (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n                          (cond (ref? d) (node x) (refs? d) (run! node x)\n                                (v? d) (when (and x (= :row (first x))) (node (second x)))))))]\n      (node task) (vec @acc))))\n\n(defn seeded-shuffle [^java.util.Random r]\n  (fn [xs] (let [a (java.util.ArrayList. ^java.util.Collection (vec xs))]\n             (java.util.Collections/shuffle a r)\n             (vec a))))\n\n(defn decoded\n  \"Portable decoded equality of an abstract value (check-abstract!'s rule):\n   sets as sets, maps as maps, cursor cells by identity.\"\n  [v]\n  (case (first v)\n    :lit [:lit (second v)]\n    :cursor-cell [:identity (second v)]\n    :row (let [n (second v) ss (:slots n)]\n           (case (:kind n)\n             :vec [:seq (mapv decoded ss)]\n             :set [:set (set (map decoded ss))]\n             :map [:map (into {} (map (fn [[k x]] [(decoded k) (decoded x)])) (partition 2 ss))]\n             [:row n]))))\n\n(defn distinct-decoded [vs] (vec (vals (into (sorted-map-by #(compare (pr-str %1) (pr-str %2))) (map (fn [e] [(decoded e) e])) vs))))\n\n(defn gen-value\n  \"Random V over `cells`, depth-bounded. Shapes: literals, cursor cells,\n   vectors, sets, maps (cursor cells as keys too), sets of cursor-cell pairs\n   (edges, aliases such as [X X] included), sets of sets.\"\n  [^java.util.Random r cells depth]\n  (let [pick (fn [xs] (nth xs (.nextInt r (count xs))))\n        cc (fn [] [:cursor-cell (pick cells)])\n        k (.nextInt r (if (pos? depth) 9 3))]\n    (case k\n      0 [:lit (pick [1 2 :k \"s\" nil])]\n      1 (cc)\n      2 (cc)\n      3 (let [elems (vec (repeatedly (inc (.nextInt r 3)) #(gen-value r cells (dec depth))))]\n          (if (some #(not= :lit (first %)) elems) [:row (rows/node :vec elems)] [:lit (mapv second elems)]))\n      4 (let [elems (distinct-decoded (repeatedly (inc (.nextInt r 4)) #(gen-value r cells (dec depth))))]\n          (if (some #(not= :lit (first %)) elems) [:row (rows/node :set elems)] [:lit (set (map second elems))]))\n      5 (let [pairs (vec (vals (into (sorted-map-by #(compare (pr-str %1) (pr-str %2))) (map (fn [p] [(decoded (first p)) p]))\n                                     (repeatedly (inc (.nextInt r 3)) #(vector (gen-value r cells (dec depth)) (gen-value r cells (dec depth)))))))]\n          (if (some (fn [[a b]] (or (not= :lit (first a)) (not= :lit (first b)))) pairs)\n            [:row (rows/node :map (vec (mapcat identity pairs)))]\n            [:lit (into {} (map (fn [[a b]] [(second a) (second b)])) pairs)]))\n      (6 7) (let [edges (distinct-decoded (repeatedly (+ 2 (.nextInt r 3)) #(vector :row (rows/node :vec [(cc) (cc)]))))]\n              [:row (rows/node :set edges)])\n      8 (let [inner (distinct-decoded (repeatedly (+ 2 (.nextInt r 2))\n                                                  #(let [es (distinct-decoded (repeatedly (inc (.nextInt r 3)) cc))]\n                                                     [:row (rows/node :set es)])))]\n          [:row (rows/node :set inner)]))))\n\n(defn reached [v]\n  (let [acc (atom #{})]\n    (letfn [(w [v] (case (first v)\n                     :cursor-cell (swap! acc conj (second v))\n                     :row (doseq [s (:slots (second v))] (w s))\n                     nil))]\n      (w v) @acc)))\n\n(defn gen-task\n  \"A :halted task: 1-6 cursor cells over two bodies (ties common), 1-3 store\n   bindings and the result slot hold random values.\"\n  [seed]\n  (let [r (java.util.Random. seed)\n        k (inc (.nextInt r 6))\n        cells (mapv #(keyword \"src\" (str \"c\" %)) (range k))\n        bodies (mapv (fn [_] (rt/cursor-cell-body :s (if (zero? (.nextInt r 3)) 1 0))) cells)\n        names (vec (take (inc (.nextInt r 3)) '[a b c]))\n        vals (mapv (fn [_] (gen-value r cells 3)) names)\n        result (gen-value r cells 2)\n        used (reduce into (reached result) (map reached vals))\n        census (keep (fn [[c b]] (when (used c) [c b])) (map vector cells bodies))]\n    (if (empty? used)\n      (recur (inc seed))\n      (let [t (rt/task-node census result)]\n        (rows/node :task (assoc (:slots t) 6 (rows/node :store (vec (mapcat (fn [n v] [n v]) names vals)))))))))\n\n(defn worked-act []\n  (first (:slots (rows/decode (rows/frame->rows ft/worked-frame)))))\n\n(def park-vector [[:closure 0 [] 2] [:halt 0] [:park 0] [:return 0]])\n(def park-address (jing/segment-key park-vector))\n\n(defn frame-task\n  \"A blocked task carrying the worked code plus a park segment. The wait's\n   act holds `wait-values` in its window register 1 and in one K frame's\n   window register 1; `env-value`, when given, is bound to e0 in the free\n   environment and in every environment; the parked state (P 7) is an act\n   at the park site whose K frame holds `parked-value` in register 1.\n   Decodes under 6a's validate-frames.\"\n  [census wait-values env-value parked-value]\n  (let [base (rt/task-node (conj (vec census) [:test/cursor (rt/cursor-cell-body :s 0)]) nil)\n        [seg pc env window k rd] (:slots (worked-act))\n        [_ store-of] (:slots env)\n        bindings (rows/node :bindings (if env-value ['e0 env-value] []))\n        env (rows/node :env [bindings store-of])\n        kframe (fn [v] (rows/node :kframe [seg pc env (rows/node :window [1 v]) rd]))\n        [w1 w2] wait-values\n        wait-act (rows/node :act [seg pc env (rows/node :window [1 w1]) (rows/node :k (if w2 [(kframe w2)] [])) rd])\n        pending (second (:slots (rows/decode (rows/frame->rows ft/worked-frame))))\n        parked (rows/node :act [park-address 3 env (rows/node :window []) (rows/node :k [(kframe parked-value)]) 0])]\n    (rows/node :task (-> (:slots base) (assoc 2 :blocked) (assoc 5 bindings)\n                         (assoc 11 (merge ft/worked-code {park-address park-vector}))\n                         (assoc 8 (rows/node :parked-table (if parked-value [7 parked] [])))\n                         (assoc 13 [(rows/node :wait [wait-act pending])]) (assoc 16 {:yin.k/policy :yin.k/fork})))))\n\n(defn gen-frame-task [seed]\n  (let [r (java.util.Random. seed)\n        k (inc (.nextInt r 4))\n        cells (mapv #(keyword \"src\" (str \"f\" %)) (range k))\n        body (rt/cursor-cell-body :s 0)\n        pick (fn [] (gen-value r cells 2))\n        wait-values (vec (repeatedly (inc (.nextInt r 2)) pick))\n        env-value (when (zero? (.nextInt r 2)) (pick))\n        parked-value (when (zero? (.nextInt r 2)) (pick))\n        used (reduce into #{} (map reached (remove nil? (concat wait-values [env-value parked-value]))))]\n    (if (empty? used)\n      (recur (inc seed))\n      (frame-task (mapv #(vector % body) (filter used cells)) wait-values env-value parked-value))))\n\n(defn gen-child-task\n  \"A parent (seed) with two install children: one random child task and the\n   review counterexample as a child; the parent's own values stay random.\"\n  [seed]\n  (let [parent (gen-task seed)\n        child (rows/node :task (assoc (:slots (gen-task (+ 100000 seed))) 3 :child))]\n    (rows/node :task (assoc (:slots parent) 12 [(rows/node :install ['a :running nil {} child])\n                                                (rows/node :install ['b :running nil {} child])]))))\n\n(defn fixture-review-counterexample\n  \"'a bound to #{X Y} with equal bodies, 'b bound to X.\"\n  []\n  (let [body (rt/cursor-cell-body :s 0)\n        t (rt/task-node [[:x body] [:y body]] [:lit nil])]\n    (rows/node :task (assoc (:slots t) 6 (rows/node :store ['a [:row (rows/node :set [[:cursor-cell :x] [:cursor-cell :y]])]\n                                                             'b [:cursor-cell :x]])))))\n\n;; ------------------------------------------------------------ diagnostics\n\n(defn permissive-roots\n  \"For a refused state: run the procedure with D5 replaced by listed-order\n   entry, over `n` shuffles of every unordered container. More than one root\n   is a witness that the state is not interchangeable; one root over n\n   shuffles is not a proof.\"\n  [task n]\n  (let [r (java.util.Random. 7)]\n    (with-redefs [shuffle (seeded-shuffle r)]\n      (->> (repeatedly n #(rename-and-shuffle task identity))\n           (map (fn [t] (binding [*numbering-opts* {:permissive true}]\n                          (let [d (discovery-numbering t {:permissive true})\n                                [id _] (emit-node* t (:numbering d) {})]\n                            id))))\n           distinct count))))\n\n(defn report-fixture [name task]\n  (let [d (discovery-numbering task)]\n    (println name)\n    (println \"  DO :\" (or (:refused d) (into (sorted-map) (:numbering d))))\n    (println \"  DO root:\" (do-root task))\n    (println \"  6a root:\" (safe-6a-root task))))\n\n(defn invariance-check\n  \"Root of the state and of the state renamed and shuffled; decode of the\n   carrier. Returns a map of outcomes.\"\n  [task ^java.util.Random r]\n  (let [cells (all-census-cells task)\n        fresh (zipmap cells (map #(keyword \"other\" (str \"z\" %)) (shuffle (range (count cells)))))\n        task2 (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle task fresh))\n        d1 (do-root task) d2 (do-root task2)]\n    (if (map? d1)\n      {:refused (:refused d1)}\n      (cond-> {:root d1 :invariant (= d1 d2)}\n        true (assoc :decode (let [e (error #(decode* (emit* task)))]\n                              (cond (nil? e) :ok\n                                    (= :resource-limit (:yin.k/kind e)) :sixa-recompute-limit\n                                    :else e)))))))\n\n(defn search [label gen seeds]\n  (let [r (java.util.Random. 11)\n        stats (atom {:numbered 0 :refused 0 :invariance-fail 0 :decode-ok 0 :decode-fail 0 :decode-6a-limit 0\n                     :refused-witnessed-noninterchangeable 0 :refused-not-distinguished 0})]\n    (doseq [seed seeds]\n      (let [task (gen seed) o (invariance-check task r)]\n        (if (:refused o)\n          (do (swap! stats update :refused inc)\n              (if (> (permissive-roots task 12) 1)\n                (swap! stats update :refused-witnessed-noninterchangeable inc)\n                (swap! stats update :refused-not-distinguished inc)))\n          (do (swap! stats update :numbered inc)\n              (when-not (:invariant o) (swap! stats update :invariance-fail inc) (println \"INVARIANCE FAIL\" label seed))\n              (case (:decode o)\n                :ok (swap! stats update :decode-ok inc)\n                :sixa-recompute-limit (swap! stats update :decode-6a-limit inc)\n                (do (swap! stats update :decode-fail inc) (println \"DECODE FAIL\" label seed (:decode o))))))))\n    (println label (count seeds) \"states:\" @stats)\n    @stats))\n\n(defn -main []\n  (let [body (rt/cursor-cell-body :s 0)\n        s (fn [es] [:row (rows/node :set es)])\n        v (fn [cs] [:row (rows/node :vec (mapv #(vector :cursor-cell %) cs))])\n        c (fn [x] [:cursor-cell x])\n        task (fn [ids result] (rt/task-node (mapv #(vector % body) ids) result))]\n    (println \"== fixtures\")\n    (report-fixture \"fixture :s1 :s2 :x :y (pinned fab223...)\" (rt/fixture :s1 :s2 :x :y))\n    (report-fixture \"review counterexample 'a #{X Y}, 'b X\" (fixture-review-counterexample))\n    (report-fixture \"symmetric pair #{X Y}\" (task [:x :y] (s [(c :x) (c :y)])))\n    (report-fixture \"alias a: [x x y]\" (task [:x :y] (v [:x :x :y])))\n    (report-fixture \"alias b: [x y y]\" (task [:x :y] (v [:x :y :y])))\n    (report-fixture \"#{[X X] [Y Y]}\" (task [:x :y] (s [(v [:x :x]) (v [:y :y])])))\n    (report-fixture \"{X 1, Y 1}\" (task [:x :y] [:row (rows/node :map [(c :x) [:lit 1] (c :y) [:lit 1]])]))\n    (report-fixture \"codex A: #{[X X] [Y Z]}\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])])))\n    (report-fixture \"codex A reversed\" (task [:x :y :z] (s [(v [:y :z]) (v [:x :x])])))\n    (report-fixture \"codex B: {X X, Y Z}\" (task [:x :y :z] [:row (rows/node :map [(c :x) (c :x) (c :y) (c :z)])]))\n    (report-fixture \"codex B reversed\" (task [:x :y :z] [:row (rows/node :map [(c :y) (c :z) (c :x) (c :x)])]))\n    (report-fixture \"codex C: #{#{X Y} #{Z W}}\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])])))\n    (report-fixture \"codex C renamed\" (task [:q :r :s :t] (s [(s [(c :s) (c :t)]) (s [(c :q) (c :r)])])))\n    (report-fixture \"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])]))\n    (report-fixture \"[#{X Y} X]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (c :x)])]))\n    (report-fixture \"[#{#{X Y} #{Z W}} X]\" (task [:x :y :z :w] [:row (rows/node :vec [(s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]) (c :x)])]))\n    (report-fixture \"#{[#{X Y} #{X Y}] [#{P Q} #{R S}]} (equal keys would be unsound; keys differ)\"\n                    (task [:x :y :p :q :r :s] (s [[:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])]\n                                                   [:row (rows/node :vec [(s [(c :p) (c :q)]) (s [(c :r) (c :s)])])]])))\n    (report-fixture \"loop + 2-cycle #{[L L] [A B] [B A]} (6a pinned 55ff16...)\" (task [:l :a :b] (s [(v [:l :l]) (v [:a :b]) (v [:b :a])])))\n    (report-fixture \"2-cycle #{[A B] [B A]}\" (task [:a :b] (s [(v [:a :b]) (v [:b :a])])))\n    (report-fixture \"3-cycle #{[A B] [B C] [C A]}\" (task [:a :b :c] (s [(v [:a :b]) (v [:b :c]) (v [:c :a])])))\n    (report-fixture \"seven-cell triangle+square\" (rt/seven-cursor-cell-triangle-square))\n    (let [ids (mapv #(keyword \"src\" (str \"x\" %)) (range 10))]\n      (report-fixture \"ten cells in a vec\" (rt/task-node (mapv (fn [id i] [id (rt/cursor-cell-body :s i)]) ids (range))\n                                                         (v ids))))\n    (println \"\\n== refused states: permissive roots over 24 shuffles (>1 = witnessed non-interchangeable)\")\n    (doseq [[name t] [[\"loop + 2-cycle\" (task [:l :a :b] (s [(v [:l :l]) (v [:a :b]) (v [:b :a])]))]\n                      [\"2-cycle\" (task [:a :b] (s [(v [:a :b]) (v [:b :a])]))]\n                      [\"3-cycle\" (task [:a :b :c] (s [(v [:a :b]) (v [:b :c]) (v [:c :a])]))]\n                      [\"seven-cell\" (rt/seven-cursor-cell-triangle-square)]\n                      [\"path #{[A B] [B C]} (refused: A and B are not interchangeable)\" (task [:a :b :c] (s [(v [:a :b]) (v [:b :c])]))]]]\n      (println \" \" name \":\" (permissive-roots t 24) \"distinct root(s)\"))\n    (println \"\\n== invariance under element reversal + renaming/shuffling\")\n    (let [r (java.util.Random. 3)]\n      (doseq [[name t] [[\"#{[X X] [Y Y]}\" (task [:x :y] (s [(v [:x :x]) (v [:y :y])]))]\n                        [\"{X 1, Y 1}\" (task [:x :y] [:row (rows/node :map [(c :x) [:lit 1] (c :y) [:lit 1]])])]\n                        [\"#{X Y}\" (task [:x :y] (s [(c :x) (c :y)]))]\n                        [\"review counterexample\" (fixture-review-counterexample)]\n                        [\"codex A\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])]))]\n                        [\"codex B\" (task [:x :y :z] [:row (rows/node :map [(c :x) (c :x) (c :y) (c :z)])])]\n                        [\"codex C\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]))]\n                        [\"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])])]]]\n        (let [rev (with-redefs [shuffle (comp vec reverse)] (rename-and-shuffle t identity))\n              ren (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle t (fn [x] (keyword \"q\" (clojure.core/name x)))))]\n          (println name \"DO:\" (do-root t) \"| reversed equal:\" (= (do-root t) (do-root rev))\n                   \"| renamed+shuffled equal:\" (= (do-root t) (do-root ren)) \"| decode:\" (or (error #(decode* (emit* t))) :ok)))))\n    (println \"\\n== frame-bearing fixtures (act window, K frame window, environments, parked state)\")\n    (let [t (frame-task [[:x body] [:y body]] [(c :x) (c :y)] (c :y) (s [(c :x) (c :y)]))]\n      (report-fixture \"wait window x, K window y, env y, parked K window #{x y}\" t)\n      (println \"  decode:\" (or (error #(decode* (emit* t))) :ok)))\n    (let [t (frame-task [[:x body] [:y body]] [(s [(c :x) (c :y)])] nil (c :y))]\n      (report-fixture \"wait window #{x y}, parked K window y (parked table, slot 8, precedes frames, slot 13)\" t)\n      (println \"  decode:\" (or (error #(decode* (emit* t))) :ok)))\n    (println \"\\n== install children numbered by discovery order\")\n    (let [child (rows/node :task (assoc (:slots (fixture-review-counterexample)) 3 :child))\n          parent (rows/node :task (assoc (:slots (rt/task-node [[:x (rt/cursor-cell-body :root/s 1)]] (c :x))) 12\n                                         [(rows/node :install ['a :running nil {} child])\n                                          (rows/node :install ['b :running nil {} child])]))\n          wire (emit* parent)]\n      (println \"  parent root:\" (:yin.k/root wire) \"| task rows:\" (count (filter #(= :task (second %)) (:yin.k/rows wire)))\n               \"| child numbering:\" (into (sorted-map) (:numbering (discovery-numbering child)))\n               \"| decode:\" (or (error #(decode* wire)) :ok)))\n    (println \"\\n== counterexample search\")\n    (search \"random values\" gen-task (range 2000))\n    (search \"frame-bearing\" gen-frame-task (range 200))\n    (search \"with children\" gen-child-task (range 100))))\n","numLines":752,"startLine":1,"totalLines":752}},"tool_result_meta":[{"id":"toolu_01CD4zctMxpXnEndmStH7Rhq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
