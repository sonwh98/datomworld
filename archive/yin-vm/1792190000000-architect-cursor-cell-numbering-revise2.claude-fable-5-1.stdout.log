)]\n440\t              (when (contains? #{:map :set} kind)\n441\t                (let [vs (if (= :set kind) slots (map first (partition 2 slots)))\n442\t                      decoded (map value vs)]\n443\t                  (when-not (= (count decoded) (count (distinct decoded))) (bad! :duplicate-key path))))\n444\t              (when (and (contains? #{:vec :list :set :map} kind)\n445\t                         (not (some reference? slots))) (bad! :reference-free-row path))\n446\t              (doseq [[i d x] (map vector (range) ds slots)]\n447\t                (let [p (conj path i)]\n448\t                  (cond\n449\t                    (= :C d) (do (when-not (contains? cursor-cells x) (bad! :missing-cursor-cell p)) (swap! reached conj x))\n450\t                    (and (ref? d) (= :task (:kind x))) (check-task x p)\n451\t                    (and (ref? d) (not= :cursor-cells (:kind x))) (visit x p cursor-cells reached)\n452\t                    (refs? d) (doseq [[j child] (map-indexed vector x)]\n453\t                                (visit child (conj p j) cursor-cells reached))\n454\t                    (contains? #{:V :optional-V} d)\n455\t                    (when x\n456\t                      (case (first x)\n457\t                        :lit (when-not (literal? (second x)) (bad! :literal p))\n458\t                        :cursor-cell (do (when-not (contains? cursor-cells (second x)) (bad! :missing-cursor-cell p))\n459\t                                         (swap! reached conj (second x)))\n460\t                        :row (visit (second x) p cursor-cells reached)))\n461\t                    :else nil)))))\n462\t          (check-task\n463\t            [task path]\n464\t            (let [slots (:slots task) census (nth slots 9)\n465\t                  cursor-cells (into {} (map vec) (partition 2 (:slots census))) reached (atom #{})]\n466\t              (visit task path cursor-cells reached)\n467\t              (when-not (= (set (keys cursor-cells)) @reached) (bad! :extra-cursor-cell (conj path 9)))))]\n468\t    (when (= :task (:kind root)) (check-task root []))))\n469\t\n470\t\n471\t(defn- decode*\n472\t  \"Validate gate, local schema, finite reachable graph, hashes, canonical\n473\t   form and cursor-cell numbering, then expand structural refs. No attachment.\n474\t   Frame checks are available separately through validate-frames.\"\n475\t  ([wire] (decode* wire default-budget))\n476\t  ([wire budget]\n477\t   (let [budget (merge default-budget budget) counter (atom {})\n478\t         rs (:yin.k/rows wire)]\n479\t     (when-not (and (= true (:yin.k/handoff wire)) (= 3 (:yin.k/version wire))\n480\t                    (code/reg? (:yin.k/version wire)))\n481\t       (refuse! :yin.k/profile-mismatch :version [:yin.k/version]))\n482\t     (when-not (and (= #{:yin.k/handoff :yin.k/version :yin.k/root :yin.k/rows} (set (keys wire)))\n483\t                    (vector? rs) (every? #(and (vector? %) (<= 2 (count %))) rs))\n484\t       (bad! :row-shape [:yin.k/rows]))\n485\t     (spend! counter budget :rows (count rs))\n486\t     (spend! counter budget :bytes (count (seq (cbor/encode wire))))\n487\t     (let [index (into {} (map (fn [r] [(first r) r])) rs)\n488\t           root (:yin.k/root wire)]\n489\t       (when-not (= (count rs) (count index)) (bad! :duplicate-row [:yin.k/rows]))\n490\t       (when-not (contains? #{:task :act :tail :wait} (second (get index root))) (bad! :root [:yin.k/root]))\n491\t       ;; Gate children before schema, with an active path (DAG sharing is legal).\n492\t       (letfn [(gate\n493\t                 [id active]\n494\t                 (when (contains? active id) (bad! :cyclic [id]))\n495\t                 (let [row (get index id) slots (when row (subvec row 2))]\n496\t                   (when-not (and (= :task (second row)) (= 17 (count slots))\n497\t                                  (vector? (nth slots 12)) (every? keyword? (nth slots 12)))\n498\t                     (bad! :task-shape [id]))\n499\t                   (when-not (= 3 (nth slots 0)) (refuse! :yin.k/profile-mismatch :version [id 0]))\n500\t                   (when-not (= profile (nth slots 1)) (refuse! :yin.k/profile-mismatch :profile [id 1]))\n501\t                   (doseq [install (nth slots 12)]\n502\t                     (let [r (get index install)]\n503\t                       (when-not (and (= :install (second r)) (= 7 (count r))) (bad! :install-shape [install]))\n504\t                       (gate (nth r 6) (conj active id))))))]\n505\t         (when (= :task (second (get index root))) (gate root #{})))\n506\t       (doseq [[id kind & slots] rs]\n507\t         (let [schema (get row-table kind) ds (descriptors kind slots)]\n508\t           (when-not (and schema\n509\t                          (cond\n510\t                            (= schema :pending) (contains? pending-table (first slots))\n511\t                            (= :pairs (first schema)) (even? (count slots))\n512\t                            :else true)\n513\t                          (= (count ds) (count slots))) (bad! :row-shape [id]))\n514\t           (doseq [[i d x] (map vector (range) ds slots)]\n515\t             (when-not (structural? kind d x) (bad! :slot-kind [id i])))))\n516\t       (let [seen (atom #{})]\n517\t         (letfn [(walk\n518\t                   [id active depth]\n519\t                   (when (> depth (:depth budget)) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n520\t                   (when (contains? active id) (bad! :cyclic [id]))\n521\t                   (when-not (contains? @seen id)\n522\t                     (let [r (get index id)]\n523\t                       (when-not r (bad! :missing-row [id]))\n524\t                       (let [kind (second r) slots (subvec r 2)]\n525\t                         (doseq [[i d x] (map vector (range) (descriptors kind slots) slots)]\n526\t                           (let [targets (cond (ref? d) [x] (refs? d) x\n527\t                                               (and (contains? #{:V :optional-V} d) (= :row (first x))) [(second x)]\n528\t                                               :else [])]\n529\t                             (doseq [target targets]\n530\t                               (when (and (contains? #{:V :optional-V} d)\n531\t                                          (not (contains? value-row-kinds (second (get index target)))))\n532\t                                 (bad! :value-reference-kind [id i]))\n533\t                               (when (and (or (ref? d) (refs? d))\n534\t                                          (not (contains? (set (rest d)) (second (get index target)))))\n535\t                                 (bad! :reference-kind [id i]))\n536\t                               (walk target (conj active id) (inc depth))))))\n537\t                       (swap! seen conj id))))]\n538\t           (walk root #{} 0)\n539\t           (when-not (= @seen (set (keys index))) (bad! :unreachable-row [:yin.k/rows]))))\n540\t       (doseq [[id & body] rs]\n541\t         (when-not (and (= :blake3 (:algorithm (jing/parse-segment-address id)))\n542\t                        (= id (jing/segment-key (vec body))))\n543\t           (refuse! :yin.k/hash-mismatch :row [id])))\n544\t       (doseq [[id kind & slots] rs :when (= :task kind)]\n545\t         (doseq [[address v] (nth slots 11)]\n546\t           (when-not (= address (jing/segment-key v))\n547\t             (refuse! :yin.k/hash-mismatch :code [id 11 address]))\n548\t           (when (code/well-formed? v) (bad! :code [id 11 address]))))\n549\t       (doseq [[_ kind & slots] rs\n550\t               [d x] (map vector (descriptors kind slots) slots)]\n551\t         (when-not (or (ref? d) (refs? d) (= :C d))\n552\t           (check-literal-markers! (if (contains? #{:V :optional-V} d)\n553\t                                     (when (= :lit (first x)) (second x)) x))))\n554\t       (doseq [[id kind & slots] rs]\n555\t         (when-not (= (vec slots) (ordered-slots kind (vec slots))) (bad! :row-order [id]))\n556\t         (when (contains? #{:map :bindings :store :parked-table :window :cursor-cells :set} kind)\n557\t           (let [keys (if (= kind :set) slots (map first (partition 2 slots)))]\n558\t             (when-not (and (= (count keys) (count (distinct keys)))\n559\t                            (= (count keys) (count (distinct (map #(bytes-key (cbor/encode %)) keys)))))\n560\t               (bad! :duplicate-key [id])))))\n561\t       (letfn [(expand-slot\n562\t                 [d x]\n563\t                 (cond (ref? d) (expand x) (refs? d) (mapv expand x)\n564\t                       (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (expand (second x))]\n565\t                       :else x))\n566\t               (expand\n567\t                 [id]\n568\t                 (let [[_ kind & slots] (get index id)]\n569\t                   (node kind (mapv expand-slot (descriptors kind slots) slots))))]\n570\t         (let [task (expand root)\n571\t               _ (check-abstract! task)\n572\t               canonical (if (= :task (:kind task)) (emit task budget)\n573\t                             (let [[id _] (emit-node task {} {})] {:yin.k/root id}))]\n574\t           (when (and (not= false (:check-numbering budget)) (not= root (:yin.k/root canonical)))\n575\t             (bad! :noncanonical-cursor-cells [root]))\n576\t           (when (= :task (:kind task))\n577\t             (when-let [d (validate-frames task)]\n578\t               (throw (ex-info \"Frame validation failed\" (update d :yin.k/path #(into [root] %))))))\n579\t           task))))))\n580\t\n581\t\n582\t(defn decode\n583\t  \"Validate and expand a row pack, including canonical cursor-cell numbering.\n584\t   For task roots, run X1 and frame validation after numbering.\"\n585\t  ([wire] (decode* wire default-budget))\n586\t  ([wire budget] (decode* wire (dissoc budget :check-numbering))))\n587\t\n588\t\n589\t(defn canonical-under\n590\t  \"Test-only §5.5 re-emission under an explicit stream correspondence.\n591\t   Missing marker coverage fails; neither traversal order nor original\n592\t   cursor-cell numbering chooses a logical identity. Accepts a carrier.\"\n593\t  [wire correspondence]\n594\t  (let [task (decode* wire (assoc default-budget :check-numbering false))]\n595\t    (letfn [(rewrite-slot\n596\t              [d x]\n597\t              (cond (ref? d) (rewrite x) (refs? d) (mapv rewrite x)\n598\t                    (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (rewrite (second x))]\n599\t                    :else x))\n600\t            (rewrite\n601\t              [n]\n602\t              (let [{:keys [kind slots]} n]\n603\t                (if (= :stream kind)\n604\t                  (let [id (first slots)]\n605\t                    (when-not (contains? correspondence id) (bad! :missing-stream-correspondence [id]))\n606\t                    (node :stream [(get correspondence id) (get correspondence id)]))\n607\t                  (node kind (mapv rewrite-slot (descriptors kind slots) slots)))))]\n608\t      (emit (rewrite task)))))\n609\t\n610\t\n611\t(defn- value-node\n612\t  [x]\n613\t  (check-literal-markers! x)\n614\t  [:lit x])\n615\t\n616\t\n617\t(defn- decoded-value\n618\t  [v]\n619\t  (case (first v)\n620\t    :row {:yin.k/row (second v)}\n621\t    :cursor-cell {:yin.k/cursor-cell (second v)}\n622\t    :lit (if (marker-shaped? (second v)) (refuse! :yin.k/non-portable :marker []) (second v))))\n623\t\n624\t\n625\t(defn- keyed-node\n626\t  [kind m encode]\n627\t  (node kind (mapcat (fn [[k v]] [k (encode v)]) m)))\n628\t\n629\t\n630\t(defn- env-node\n631\t  [e encode]\n632\t  (node :env [(keyed-node :bindings (:yin.k/bindings e) encode) (:yin.k/store-of e)]))\n633\t\n634\t\n635\t(defn- kframe-node\n636\t  [f encode]\n637\t  (node :kframe [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n638\t                 (keyed-node :window (:yin.k/window f) encode) (:yin.k/rd f)]))\n639\t\n640\t\n641\t(def pending-keys\n642\t  {:next [:yin.k/cursor-cell]\n643\t   :put [:yin.k/stream :yin.k/value :yin.k/op-id]\n644\t   :ffi [:yin.k/cursor-cell :yin.k/call-id :yin.k/op]\n645\t   :ffi-request [:yin.k/call-id :yin.k/envelope :yin.k/request-stream :yin.k/response-stream :yin.k/response-cursor-cell :yin.k/op-id]\n646\t   :link-request [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell :yin.k/envelope :yin.k/op-id]\n647\t   :link-response [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell]\n648\t   :install [:yin.k/name]})\n649\t\n650\t\n651\t(defn frame->rows\n652\t  \"Encode a keyed frame to a frame-rooted version-3 row pack. Values are\n653\t   plain literals by default. An explicit value encoder classifies portable\n654\t   references as [:row abstract-row] or [:cursor-cell id], distinct from guest maps.\n655\t   This reshapes; frame/defect owns semantic validity.\"\n656\t  ([f] (frame->rows f value-node))\n657\t  ([f encode]\n658\t   (let [k (node :k (mapv #(kframe-node % encode) (:yin.k/k f)))\n659\t         state (if (= :act (:yin.k/state f))\n660\t                 (node :act [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n661\t                             (keyed-node :window (:yin.k/window f) encode) k (get-in f [:yin.k/deliver :yin.k/rd])])\n662\t                 (node :tail [(:yin.k/segment f) (:yin.k/site f) k]))\n663\t         pending (:yin.k/pending f)\n664\t         reason (:yin.k/reason pending)\n665\t         root (if (contains? f :yin.k/pending)\n666\t                (node :wait [state (node :pending\n667\t                                         (into [reason]\n668\t                                               (map (fn [key d]\n669\t                                                      (let [x (get pending key)]\n670\t                                                        (if (= :V d) (encode x) x)))\n671\t                                                    (get pending-keys reason) (get pending-table reason))))])\n672\t                state)\n673\t         [id rows] (emit-node root {} {})]\n674\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n675\t\n676\t\n677\t(defn- decode-keyed\n678\t  [n decode-value]\n679\t  (into {} (map (fn [[k v]] [k (decode-value v)])) (partition 2 (:slots n))))\n680\t\n681\t\n682\t(defn- decode-env\n683\t  [n decode-value]\n684\t  (let [[bindings store-of] (:slots n)]\n685\t    (cond-> {:yin.k/bindings (decode-keyed bindings decode-value)}\n686\t      (some? store-of) (assoc :yin.k/store-of store-of))))\n687\t\n688\t\n689\t(defn- decode-kframe\n690\t  [n decode-value]\n691\t  (let [[seg pc e w rd] (:slots n)]\n692\t    {:yin.k/frame-type :return :yin.k/segment seg :yin.k/pc pc\n693\t     :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value) :yin.k/rd rd}))\n694\t\n695\t\n696\t(defn- decode-frame\n697\t  [n decode-value]\n698\t  (if (= :wait (:kind n))\n699\t    (let [[state pending] (:slots n) [reason & slots] (:slots pending)]\n700\t      (assoc (decode-frame state decode-value) :yin.k/pending\n701\t             (into {:yin.k/reason reason}\n702\t                   (map (fn [key d x] [key (if (= :V d) (decode-value x) x)])\n703\t                        (get pending-keys reason) (get pending-table reason) slots))))\n704\t    (let [act? (= :act (:kind n)) [seg pc e w k rd] (:slots n)\n705\t          k (if act? k e)]\n706\t      (cond-> {:yin.k/state (:kind n) :yin.k/segment seg\n707\t               :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd rd} {:yin.k/deliver :return})\n708\t               :yin.k/k (mapv #(decode-kframe % decode-value) (:slots k))}\n709\t        act? (assoc :yin.k/pc pc :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value))\n710\t        (not act?) (assoc :yin.k/site pc)))))\n711\t\n712\t\n713\t(defn rows->frame\n714\t  \"Validate row syntax and hashes, then reshape to the keyed frame.\n715\t   Semantic code/context rules remain frame/defect's responsibility.\n716\t   The default decoder produces in-band row/cursor-cell markers that the default\n717\t   encoder refuses. frame->rows after rows->frame is identity only when\n718\t   both sides are given a classifier for those values.\"\n719\t  ([wire] (rows->frame wire decoded-value))\n720\t  ([wire decode-value] (decode-frame (decode wire) decode-value)))\n721\t\n722\t\n723\t(defn validate-frames\n724\t  \"Carrier step 7, after decode's canonical numbering. Judge each task's\n725\t   X1 first, then waits, parked states, and all reified values. Return the\n726\t   first defect with the abstract row path, or nil.\"\n727\t  [task]\n728\t  (let [slots (:slots task) code-map (nth slots 11)\n729\t        free-env (decode-keyed (nth slots 5) decoded-value)\n730\t        waits (nth slots 13)\n731\t        ffi-ids (into #{} (keep (fn [w]\n732\t                                  (let [[_ p] (:slots w) [reason & xs] (:slots p)]\n733\t                                    (case reason :ffi (second xs) :ffi-request (first xs) nil)))) waits)\n734\t        ctx {:free-env free-env :ffi-call-ids ffi-ids}]\n735\t    (letfn [(judge\n736\t              [n context context-map path]\n737\t              (when-let [d (frame/defect (decode-frame n decoded-value) code-map context context-map)]\n738\t                (-> d (assoc :yin.k/status :yin.k/undecodable)\n739\t                    (update :yin.k/path #(into path %)))))\n740\t            (captures\n741\t              [n path]\n742\t              (if (= :reified (:kind n))\n743\t                (or (judge (first (:slots n)) :captured ctx path)\n744\t                    (captures (first (:slots n)) (conj path 0)))\n745\t                (some (fn [[i d x]]\n746\t                        (cond\n747\t                          (and (ref? d) (= :task (:kind x))) (validate-frames x)\n748\t                          (ref? d) (captures x (conj path i))\n749\t                          (refs? d) (some (fn [[j child]] (captures child (conj path i j))) (map-indexed vector x))\n750\t                          (and (contains? #{:V :optional-V} d) (= :row (first x))) (captures (second x) (conj path i))\n751\t                          :else nil))\n752\t                      (map vector (range) (descriptors (:kind n) (:slots n)) (:slots n)))))]\n753\t      (or\n754\t        (when-let [d (frame/task-defect ctx)] (assoc d :yin.k/status :yin.k/undecodable))\n755\t        (some (fn [[i w]] (judge w :wait ctx [:frames i])) (map-indexed vector waits))\n756\t        (some (fn [[p state]] (judge state :parked (assoc ctx :parked-key p) [:parked p]))\n757\t              (partition 2 (:slots (nth slots 8))))\n758\t        (captures task [])))))\n759\t"}]},"parent_tool_use_id":null,"session_id":"7984b61f-639f-4af2-b00a-5b9b7d554f75","uuid":"a2aa84fd-f705-4049-a405-26c323200552","timestamp":"2026-10-12T06:20:08.351Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-numbering/collab/numbering-probe/src/yin/vm/ucf/rows.cljc","content":"(ns yin.vm.ucf.rows\n  \"Version-3 row codec. Pure row construction, graph decoding and canonical\n   cursor-cell numbering; no machine attachment, dependency scanner or transport.\n   An abstract row is {:kind keyword :slots vector}. Structural references\n   contain abstract rows; values use [:lit d], [:row abstract-row], [:cursor-cell id].\n   A task's :cursor-cells row holds alternating source identities and :cursor-cell-body\n   rows. Install children are separate tasks with separate cursor-cell scopes.\n\n   The census is ordered numerically by n (draft §3, \\\"sorted by n\\\"), so\n   :yin.k/cc-10 follows :yin.k/cc-9; its keys must spell cc-N with no leading\n   zero, else :slot-kind.\n\n   Default value markers are plain maps {:yin.k/row abstract-row} and\n   {:yin.k/cursor-cell keyword}. A guest map whose sole key is :yin.k/row or\n   :yin.k/cursor-cell collides with them and is not portable: on encode and decode\n   every literal of that shape is refused :yin.k/non-portable. Explicit\n   markers use the caller value encoder.\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.frame :as frame]))\n\n\n(def profile {:yin.code/contract \"v4\" :yin.k/version 1})\n\n\n(def pending-table\n  {:next [:C]\n   :put [[:ref :stream] :V :D]\n   :ffi [:C :D :D]\n   :ffi-request [:D :V [:ref :stream] [:ref :stream] :C :D]\n   :link-request [:D :S [:ref :stream] [:ref :stream] :C :D :D]\n   :link-response [:D :S [:ref :stream] [:ref :stream] :C]\n   :install [:S]})\n\n\n(def row-table\n  \"Slot descriptors, excluding id and kind. :repeat/:pairs are variadic;\n   :refs is an ordered vector of structural references. :pending is\n   discriminated by pending-table. Nothing in this table is executable.\"\n  {:vec [:repeat :V] :list [:repeat :V] :set [:repeat :V]\n   :map [:pairs :V :V] :bindings [:pairs :S :V] :store [:pairs :D :V]\n   :env [[:ref :bindings] :optional-D]\n   :closure [:A :N :syms [:ref :bindings] :optional-D]\n   :prim [:S] :stream [:D :D] :reified [[:ref :act]] :parked-ref [:D]\n   :act [:A :N [:ref :env] [:ref :window] [:ref :k] :N]\n   :tail [:A :N [:ref :k]]\n   :window [:pairs :N :V] :k [:repeat [:ref :kframe]]\n   :kframe [:A :N [:ref :env] [:ref :window] :N]\n   :wait [[:ref :act :tail] [:ref :pending]] :pending :pending\n   :module-store [:D [:ref :store]]\n   :parked-table [:pairs :D [:ref :act :tail]]\n   :install [:S :D :D :D [:ref :task]]\n   :cursor-cells [:pairs :C [:ref :cursor-cell-body]] :cursor-cell-body [[:ref :stream] :D]\n   :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n          [:refs :module-store] [:ref :parked-table] [:ref :cursor-cells]\n          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n\n\n(defn node\n  [kind slots]\n  {:kind kind :slots (if (= :window kind)\n                       (vec (mapcat identity (sort-by first (partition 2 slots))))\n                       (vec slots))})\n\n\n(defn- refuse!\n  [status kind path]\n  (throw (ex-info \"Row codec refused data\"\n                  {:yin.k/status status :yin.k/kind kind :yin.k/path path})))\n\n\n(defn- bad!\n  [kind path]\n  (refuse! :yin.k/undecodable kind path))\n\n\n(defn- marker-shaped?\n  [x]\n  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cursor-cell))))\n\n\n(defn- check-literal-markers!\n  [x]\n  (when (marker-shaped? x) (refuse! :yin.k/non-portable :marker []))\n  (when (coll? x)\n    (doseq [v (if (map? x) (mapcat identity x) x)] (check-literal-markers! v)))\n  (when (meta x) (check-literal-markers! (meta x))))\n\n\n(defn- bytes-key\n  [bs]\n  ;; Unsigned bytewise order, without a length-first comparison.\n  (mapv #(bit-and (int %) 255) (seq bs)))\n\n\n(defn- compare-bytes\n  [a b]\n  (loop [i 0]\n    (cond\n      (= i (count a)) (if (= i (count b)) 0 -1)\n      (= i (count b)) 1\n      (= (nth a i) (nth b i)) (recur (inc i))\n      :else (compare (nth a i) (nth b i)))))\n\n\n(defn- byte-compare\n  [a b]\n  (compare-bytes (bytes-key (cbor/encode a)) (bytes-key (cbor/encode b))))\n\n\n(defn- sorted-bytes\n  [xs]\n  (vec (sort byte-compare xs)))\n\n\n(defn- descriptors\n  [kind slots]\n  (let [schema (get row-table kind)]\n    (cond\n      (= schema :pending) (into [:D] (get pending-table (first slots)))\n      (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n      (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n      :else schema)))\n\n\n(defn- ref?\n  [d]\n  (and (vector? d) (= :ref (first d))))\n\n\n(defn- refs?\n  [d]\n  (and (vector? d) (= :refs (first d))))\n\n\n(def ^:private census-key #\"cc-([1-9][0-9]*)\")\n\n\n(defn- census-order\n  ;; Numeric order of cc-N without reading wire data: fewer digits first,\n  ;; then the