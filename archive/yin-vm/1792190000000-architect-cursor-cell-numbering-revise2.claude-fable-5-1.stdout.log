(error #(rows/decode (rows/emit-numbered abstract {:x :yin.k/cc-9 :y :yin.k/cc-8})))]\n212\t    (is (= :noncanonical-cursor-cells (:yin.k/kind d)))\n213\t    (is (= :reserved-name (:yin.k/kind (error #(rows/decode wire)))))))\n214\t\n215\t\n216\t(deftest schema-and-literal-canonicality\n217\t  (let [body (cursor-cell-body :s 0)]\n218\t    (is (= :missing-cursor-cell (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:cursor-cell :missing])))))))\n219\t    (is (= :extra-cursor-cell (:yin.k/kind (error #(rows/decode (rows/emit (task-node [[:x body]] [:lit nil])))))))\n220\t    (is (= :reference-free-row\n221\t           (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:row (rows/node :vec [[:lit 1]])])))))))\n222\t    (is (= :value-reference-kind\n223\t           (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:row (rows/node :window [])])))))))\n224\t    (let [wire (rows/emit (task-node [] [:lit nil]))]\n225\t      (is (= :yin.k/unsupported (:yin.k/status (error #(rows/decode wire {:rows 1}))))))\n226\t    (is (= :literal (:yin.k/kind (error #(rows/decode (rows/emit (task-node [] [:lit (cbor/encode 1)])))))))\n227\t    ;; Distinct rows whose decoded elements are equal ([x [1]] = [x (1)]).\n228\t    (is (= :duplicate-key\n229\t           (:yin.k/kind (error #(rows/decode (rows/emit (task-node [[:x body]]\n230\t                                                                   [:row (rows/node :set [[:row (rows/node :vec [[:cursor-cell :x] [:lit [1]]])]\n231\t                                                                                          [:row (rows/node :vec [[:cursor-cell :x] [:lit (list 1)]])]])])))))))\n232\t    (let [task (task-node [[:x body]] [:cursor-cell :x])\n233\t          wire (rows/emit task)\n234\t          census (first (filter #(= :cursor-cells (second %)) (:yin.k/rows wire)))]\n235\t      (doseq [k [:x :yin.k/cc-01 :yin.k/cc-0 :yin.k/cc- :yin.k/c-1 :yin.k/cur-1]]\n236\t        (is (= :slot-kind (:yin.k/kind (error #(rows/decode (replace-row wire (first census) [:cursor-cells k (nth census 3)])))))))\n237\t      (is (= :slot-kind (:yin.k/kind (error #(rows/decode (rows/emit-numbered task {})))))))))\n238\t\n239\t\n240\t(deftest child-scope-and-shared-child-dag\n241\t  (let [child (rows/node :task (assoc (:slots (task-node [[:x (cursor-cell-body :child/s 2)]] [:cursor-cell :x])) 3 :child))\n242\t        root (task-node [[:x (cursor-cell-body :root/s 1)]] [:cursor-cell :x])\n243\t        parent (rows/node :task (assoc (:slots root) 12 [(rows/node :install ['a :running nil {} child])\n244\t                                                         (rows/node :install ['b :running nil {} child])]))\n245\t        wire (rows/emit parent)]\n246\t    (is (= 2 (count (filter #(= :task (second %)) (:yin.k/rows wire)))))\n247\t    (is (= (:yin.k/root wire) (:yin.k/root (rows/emit (rows/decode wire)))))\n248\t    (is (= (:yin.k/root (rows/canonical-under wire {:child/s :child :root/s :root}))\n249\t           (:yin.k/root (rows/emit (rows/decode (rows/canonical-under wire {:child/s :child :root/s :root}))))))))\n250\t\n251\t\n252\t(deftest pending-envelope-and-nil-literal-are-preserved\n253\t  (let [stream (rows/node :stream [:s :descriptor])\n254\t        envelope {:call/id :id :arguments [nil {:extra nil}] :unknown nil}\n255\t        f (assoc ft/worked-frame :yin.k/pending\n256\t                 {:yin.k/reason :ffi-request :yin.k/call-id :id :yin.k/envelope envelope\n257\t                  :yin.k/request-stream stream :yin.k/response-stream stream\n258\t                  :yin.k/response-cursor-cell :cursor-cell :yin.k/op-id nil})\n259\t        wire (rows/frame->rows f)]\n260\t    (is (= f (rows/rows->frame wire)))\n261\t    (is (contains? (get-in (rows/rows->frame wire) [:yin.k/pending :yin.k/envelope]) :unknown))))\n262\t\n263\t\n264\t(deftest task-root-checks-carried-code-and-frame\n265\t  (let [wait (rows/decode (rows/frame->rows ft/worked-frame))\n266\t        base (task-node [[:test/cursor (cursor-cell-body :s 0)]] nil)\n267\t        task (rows/node :task (-> (:slots base) (assoc 2 :blocked) (assoc 11 ft/worked-code)\n268\t                                  (assoc 13 [wait]) (assoc 16 {:yin.k/policy :yin.k/fork})))\n269\t        wire (rows/emit task)\n270\t        bad-state (rows/node :act (assoc (:slots (first (:slots wait))) 3 (rows/node :window [])))\n271\t        bad-task (rows/node :task (assoc (:slots task) 13 [(rows/node :wait [bad-state (second (:slots wait))])]))\n272\t        bad-code [[:halt 99]]]\n273\t    (is (= (:yin.k/root wire) (:yin.k/root (rows/emit (rows/decode wire)))))\n274\t    (let [d (error #(rows/decode (rows/emit bad-task)))]\n275\t      (is (= :window-missing (:yin.k/kind d)))\n276\t      (is (= :yin.k/undecodable (:yin.k/status d)))\n277\t      (is (jing/parse-segment-address (first (:yin.k/path d)))))\n278\t    ;; X1 is judged before any wait.\n279\t    (is (= :reserved-name\n280\t           (:yin.k/kind (error #(rows/decode (rows/emit (rows/node :task (assoc (:slots bad-task) 5 (rows/node :bindings ['yin/def [:lit 1]])))))))))\n281\t    (is (= :code\n282\t           (:yin.k/kind (error #(rows/decode (rows/emit (rows/node :task (assoc (:slots task) 11 {(jing/segment-key bad-code) bad-code}))))))))))\n283\t\n284\t\n285\t(defn- reversed\n286\t  \"The same abstract task with every :set and :map listed in reverse.\"\n287\t  [n]\n288\t  (letfn [(value [v] (if (= :row (first v)) [:row (reversed (second v))] v))]\n289\t    (case (:kind n)\n290\t      :set (rows/node :set (vec (reverse (mapv value (:slots n)))))\n291\t      :map (rows/node :map (vec (mapcat (fn [[k v]] [(value k) (value v)]) (reverse (partition 2 (:slots n))))))\n292\t      :store (rows/node :store (vec (mapcat (fn [[k v]] [k (value v)]) (partition 2 (:slots n)))))\n293\t      :task (rows/node :task (assoc (:slots n) 6 (reversed (nth (:slots n) 6))))\n294\t      n)))\n295\t\n296\t\n297\t(deftest unordered-containers-are-order-free\n298\t  ;; Identity correspondence: only the listed order of :set elements\n299\t  ;; (streams and cursor cells) and :map entries differs.\n300\t  (let [a (fixture :s1 :s2 :x :y) b (reversed a) ident {:s1 :s1 :s2 :s2}]\n301\t    (is (not= a b))\n302\t    (is (= (:yin.k/root (rows/emit a)) (:yin.k/root (rows/emit b))))\n303\t    (is (= (:yin.k/root (rows/canonical-under (rows/emit a) ident))\n304\t           (:yin.k/root (rows/canonical-under (rows/emit b) ident))))))\n305\t\n306\t\n307\t(deftest canonical-roots-are-pinned\n308\t  (is (= :segment/blake3-fab223d9b3540fdce0ccf2132f8a4041917a158a32295470a4936754742d3ac4\n309\t         (:yin.k/root (rows/emit (fixture :s1 :s2 :x :y)))))\n310\t  (is (= :segment/blake3-c4a7c7e6de3b44400efec5930bc3d85d86b29153b4b2d548acba630bfbc3da7d\n311\t         (:yin.k/root (rows/frame->rows ft/worked-frame))))\n312\t  ;; The draft §6 case at its smallest: a directed loop and a directed\n313\t  ;; 2-cycle over equal-body cursor cells leave all three cursor cells in one class, and\n314\t  ;; no automorphism exchanges the loop with a 2-cycle vertex.\n315\t  (let [shape (fn [[l a b]]\n316\t                [[:row (rows/node :vec [[:cursor-cell l] [:cursor-cell l]])]\n317\t                 [:row (rows/node :vec [[:cursor-cell a] [:cursor-cell b]])]\n318\t                 [:row (rows/node :vec [[:cursor-cell b] [:cursor-cell a]])]])\n319\t        graph (fn [ids edges] (task-node (mapv #(vector % (cursor-cell-body :s 0)) ids) [:row (rows/node :set edges)]))\n320\t        task (graph [:l :a :b] (shape [:l :a :b]))\n321\t        renamed (graph [:z/b :z/a :z/l] (vec (reverse (shape [:z/l :z/a :z/b]))))\n322\t        numbering (rows/canonical-numbering task)\n323\t        root (:yin.k/root (rows/emit task))]\n324\t    (is (= :resource-limit (:yin.k/kind (error #(rows/emit task {:search 2})))))\n325\t    (is (= :segment/blake3-55ff168e6b5a37028fb5ecd99ab21dc58f6a4e2b9c95dbe570ccec65b15a63c0 root))\n326\t    (is (= root (:yin.k/root (rows/emit renamed))))\n327\t    (is (= :yin.k/cc-3 (numbering :l)))\n328\t    (is (= (:z/l (rows/canonical-numbering renamed)) (numbering :l)))))\n329\t\n330\t\n331\t(deftest census-is-numeric-from-ten-cursor-cells\n332\t  (let [ids (mapv #(keyword \"src\" (str \"x\" %)) (range 10))\n333\t        task (task-node (mapv (fn [id i] [id (cursor-cell-body :s i)]) ids (range))\n334\t                        [:row (rows/node :vec (mapv #(vector :cursor-cell %) ids))])\n335\t        wire (rows/emit task)\n336\t        census (first (filter #(= :cursor-cells (second %)) (:yin.k/rows wire)))]\n337\t    (is (= (mapv #(keyword \"yin.k\" (str \"cc-\" %)) (range 1 11)) (vec (take-nth 2 (drop 2 census)))))\n338\t    (is (= (:yin.k/root wire) (:yin.k/root (rows/emit (rows/decode wire)))))))\n339\t\n340\t\n341\t(deftest marker-shaped-guest-maps-are-not-portable\n342\t  (doseq [v [{:yin.k/row 1} {:yin.k/cursor-cell \"c\"}]]\n343\t    (is (= :yin.k/non-portable\n344\t           (:yin.k/status (error #(rows/frame->rows (assoc ft/worked-frame :yin.k/window {1 v})))))))\n345\t  (let [f (assoc ft/worked-frame :yin.k/window {1 {:yin.k/row 1 :other 2}})]\n346\t    (is (= f (rows/rows->frame (rows/frame->rows f)))))\n347\t  (let [wire (rows/frame->rows ft/worked-frame)\n348\t        window (first (first (filter #(= :window (second %)) (:yin.k/rows wire))))]\n349\t    (doseq [v [{:yin.k/row 1} {:yin.k/cursor-cell :c}]]\n350\t      (is (= :yin.k/non-portable\n351\t             (:yin.k/status (error #(rows/rows->frame (replace-row wire window [:window 1 [:lit v]])))))))))\n352\t\n353\t\n354\t(deftest well-formed-guest-markers-are-refused\n355\t  (doseq [v [{:yin.k/row (rows/node :prim ['guest/f])} {:yin.k/cursor-cell :c}]]\n356\t    (is (= :yin.k/non-portable\n357\t           (:yin.k/status (error #(rows/frame->rows (assoc ft/worked-frame :yin.k/window {1 v})))))))\n358\t  (let [f (assoc ft/worked-frame :yin.k/window {1 {:yin.k/row (rows/node :prim ['guest/f])}})]\n359\t    (is (= f (rows/rows->frame (rows/frame->rows f encoded))))))\n360\t\n361\t\n362\t(deftest every-literal-context-refuses-markers\n363\t  (doseq [v [{:yin.k/row 1} {:yin.k/cursor-cell :c}]]\n364\t    (doseq [task [(task-node [] [:lit v])\n365\t                  (task-node [] [:lit [v]])\n366\t                  (task-node [] [:lit (with-meta 'guest v)])\n367\t                  (rows/node :task (assoc (:slots (task-node [] [:lit nil])) 6\n368\t                                          (rows/node :store ['v [:lit v]])))\n369\t                  (rows/node :task (assoc (:slots (task-node [] [:lit nil])) 16 v))]]\n370\t      (is (= :yin.k/non-portable (:yin.k/status (error #(rows/emit task))))))\n371\t    (let [wire (rows/emit (task-node [] [:lit nil]))\n372\t          root (:yin.k/root wire)\n373\t          row (first (filter #(= root (first %)) (:yin.k/rows wire)))\n374\t          store (first (filter #(= :store (second %)) (:yin.k/rows wire)))]\n375\t      (doseq [[id body] [[root (assoc (subvec row 1) 16 [:lit v])]\n376\t                         [root (assoc (subvec row 1) 16 [:lit [v]])]\n377\t                         [root (assoc (subvec row 1) 16 [:lit (with-meta 'guest v)])]\n378\t                         [root (assoc (subvec row 1) 17 v)]\n379\t                         [(first store) [:store 'v [:lit v]]]]]\n380\t        (is (= :yin.k/non-portable\n381\t               (:yin.k/status (error #(rows/decode (replace-row wire id body))))))))))\n382\t\n383\t\n384\t(deftest cursor-cell-and-identity-shaped-literal-are-distinct\n385\t  (let [task (task-node [[:x (cursor-cell-body :s 0)]]\n386\t                        [:row (rows/node :set [[:cursor-cell :x] [:lit [:identity :yin.k/cc-1]]])])\n387\t        wire (rows/emit task)]\n388\t    (is (nil? (error #(rows/decode wire))))\n389\t    (is (= (:yin.k/root wire) (:yin.k/root (rows/emit (rows/decode wire)))))))\n390\t\n391\t\n392\t(defn seven-cursor-cell-triangle-square\n393\t  []\n394\t  (let [ids [:a :b :c :d :e :f :g]\n395\t        edges [[:a :b] [:b :c] [:c :a] [:d :e] [:e :f] [:f :g] [:g :d]]]\n396\t    (task-node (mapv #(vector % (cursor-cell-body :s 0)) ids)\n397\t               [:row (rows/node :set (mapv (fn [[a b]] [:row (rows/node :vec [[:cursor-cell a] [:cursor-cell b]])]) edges))])))\n398\t\n399\t\n400\t(deftest intermediate-label-bytes-are-bounded\n401\t  (let [d (error #(rows/canonical-numbering (seven-cursor-cell-triangle-square)))]\n402\t    (is (= :resource-limit (:yin.k/kind d)))\n403\t    (is (= [:label-bytes] (:yin.k/path d)))))\n404\t\n405\t\n406\t(deftest input-row-bodies-do-not-spend-label-bytes\n407\t  (let [large (vec (range 400000))\n408\t        base (task-node [[:x (cursor-cell-body :s 0)]] [:lit large])\n409\t        ;; Keep the census cursor cell reachable so decode also validates the carrier.\n410\t        reachable (rows/node :task (assoc (:slots base) 5\n411\t                                          (rows/node :bindings ['cursor [:cursor-cell :x]])))\n412\t        custody (rows/node :task (assoc (:slots reachable) 15 [:lit nil]))\n413\t        custody (rows/node :task (assoc (:slots custody) 16 large))]\n414\t    (is (nil? (error #(rows/emit base))))\n415\t    (doseq [task [reachable custody]]\n416\t      (let [wire (rows/emit task)\n417\t            expected (rows/node :task\n418\t                                (-> (:slots task)\n419\t                                    (assoc 5 (rows/node :bindings ['cursor [:cursor-cell :yin.k/cc-1]]))\n420\t                                    (assoc 9 (rows/node :cursor-cells [:yin.k/cc-1 (cursor-cell-body :s 0)]))))]\n421\t        (is (= expected (rows/decode wire)))))))\n422\t"}]},"parent_tool_use_id":null,"session_id":"7984b61f-639f-4af2-b00a-5b9b7d554f75","uuid":"8de4c986-e51d-4caa-9639-a33daac75483","timestamp":"2026-10-12T06:20:08.755Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-numbering/collab/numbering-probe/src/yin/vm/ucf/rows_test.cljc","content":"(ns yin.vm.ucf.rows-test\n  (:require [clojure.test :refer [deftest is]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yin.vm.semantic-register.frame-test :as ft]\n            [yin.vm.values :as values]\n            [yin.vm.engine :as engine]\n            [yin.vm.ucf.rows :as rows]))\n\n\n(defn error\n  [f]\n  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n\n\n(defn task-node\n  [cursor-cells result]\n  (rows/node :task [3 rows/profile :halted :root 0 (rows/node :bindings [])\n                    (rows/node :store []) [] (rows/node :parked-table [])\n                    (rows/node :cursor-cells (mapcat identity cursor-cells)) {} {} [] [] nil result nil]))\n\n\n(defn cursor-cell-body\n  [stream position]\n  (rows/node :cursor-cell-body [(rows/node :stream [stream {:peer stream}]) position]))\n\n\n(defn fixture\n  [a b x y]\n  (let [payload [:row (rows/node :map\n                                 [[:lit 'both] [:row (rows/node :set [[:cursor-cell x] [:cursor-cell y]])]\n                                  [:lit 'one] [:cursor-cell x]\n                                  [:lit 'streams] [:row (rows/node :set [[:row (rows/node :stream [a {:peer a}])]\n                                                                         [:row (rows/node :stream [b {:peer b}])]])]\n                                  [:lit 'cursors] [:row (rows/node :map [[:cursor-cell x] [:lit :x] [:cursor-cell y] [:lit :y]])]])]\n        task (task-node [[x (cursor-cell-body a 0)] [y (cursor-cell-body b 0)]] [:lit nil])]\n    (rows/node :task (assoc (:slots task) 6 (rows/node :store ['payload payload])))))\n\n\n(declare portable-frame)\n\n\n(defn- encoded\n  [x]\n  (cond (and (map? x) (contains? x :yin.k/row)) [:row (:yin.k/row x)]\n        (and (map? x) (contains? x :yin.k/cursor-cell)) [:cursor-cell (:yin.k/cursor-cell x)]\n        :else [:lit x]))\n\n\n(defn- portable-value\n  [m x]\n  ;; Classify native test values into the decoded codec domain. No seals\n  ;; travel. Captures retain their entire act and K; closures retain the\n  ;; code address, binders, lexical bindings and module context.\n  (cond\n    (values/continuation? x)\n    {:yin.k/row (rows/node :reified\n                           [(rows/decode (rows/frame->rows\n                                           (portable-frame m (ft/canonical m (values/payload x) false)) encoded))])}\n    (values/closure? x)\n    (let [p (values/payload x) e (:env p)]\n      {:yin.k/row (rows/node :closure [(get-in m [:code (:segment p) :address]) (:entry p) (:params p)\n                                       (rows/node :bindings\n                                                  (mapcat (fn [[k v]] [k (encoded (portable-value m v))])\n                                                          (sort #(cbor/encoded-compare (first %1) (first %2))\n                                                                (engine/without-store-of e))))\n                                       (engine/env-store-of e)])})\n    (fn? x) {:yin.k/row (rows/node :prim ['fixture/primitive])}\n    (and (map? x) (= :cursor-ref (:type x))) {:yin.k/cursor-cell (:id x)}\n    (and (map? x) (= :stream-ref (:type x))) {:yin.k/row (rows/node :stream [(:id x) :fixture/served])}\n    (coll? x)\n    (let [kind (cond (map? x) :map (vector? x) :vec (set? x) :set :else :list)\n          xs (if (map? x) (mapcat identity x) x)\n          vs (mapv #(encoded (portable-value m %)) xs)]\n      (if (some #(not= :lit (first %)) vs)\n        {:yin.k/row (rows/node kind vs)}\n        x))\n    :else x))\n\n\n(defn portable-frame\n  [m f]\n  (let [bindings (fn [mappings] (into {} (map (fn [[k v]] [k (portable-value m v)])) mappings))\n        env #(update % :yin.k/bindings bindings)]\n    (cond-> (update f :yin.k/k #(mapv (fn [k]\n                                        (-> k (update :yin.k/env env)\n                                            (update :yin.k/window bindings))) %))\n      (= :act (:yin.k/state f)) (update :yin.k/env env)\n      (= :act (:yin.k/state f)) (update :yin.k/window bindings)\n      (contains? f :yin.k/pending) (update :yin.k/pending #(case (:yin.k/reason %)\n                                                             :next (assoc % :yin.k/cursor-cell :test/cursor)\n                                                             :put (assoc % :yin.k/stream (rows/node :stream [:fixture/w :fixture/served])\n                                                                         :yin.k/value \"v\" :yin.k/op-id nil) %)))))\n\n\n(deftest bijection\n  (doseq [fixture (ft/reference-machines)\n          {:keys [frame]} (ft/reference-frames fixture)]\n    (let [f (portable-frame (:machine fixture) frame) wire (rows/frame->rows f encoded) back (rows/rows->frame wire)]\n      (is (= f back))\n      (is (= (:yin.k/root wire) (:yin.k/root (rows/frame->rows back encoded)))))))\n\n\n(deftest row-ids-are-jing-default\n  (let [wire (rows/emit (fixture :stream/a :stream/b :source/x :source/y))]\n    (is (seq (:yin.k/rows wire)))\n    (doseq [[id & body] (:yin.k/rows wire)]\n      (is (= id (jing/segment-key (vec body))))\n      (is (= :blake3 (:algorithm (jing/parse-segment-address id)))))))\n\n\n(defn- replace-row\n  \"Rehash the edited row and all ancestors, without canonicalizing slots.\"\n  [wire id body]\n  (let [index (into {} (map (fn [r] [(first r) r])) (:yin.k/rows wire))\n        memo (atom {})]\n    (letfn [(rewrite\n              [x]\n              (cond\n                (contains? index x)\n                (or (get @memo x)\n                    (let [rbody (if (= x id) body (subvec (get index x) 1))\n                          b (mapv rewrite rbody) nid (jing/segment-key b)]\n                      (swap! memo assoc x nid)\n                      nid))\n                (vector? x) (mapv rewrite x)\n                :else x))]\n      (let [root (rewrite (:yin.k/root wire))\n            rs (mapv (fn [[old new]] (into [new] (mapv rewrite (if (= old id) body (subvec (get index old) 1))))) @memo)]\n        (assoc wire :yin.k/root root :yin.k/rows rs)))))\n\n\n(deftest window-sorted-and-unique\n  (let [f (assoc ft/worked-frame :yin.k/window {1 :f 3 nil})\n        wire (rows/frame->rows f) r (first (filter #(= :window (second %)) (:yin.k/rows wire)))\n        id (first r)]\n    (doseq [body [[:window 3 [:lit nil] 1 [:lit :f]] [:window 1 [:lit :f] 1 [:lit nil]]]]\n      (let [d (error #(rows/rows->frame (replace-row wire id body)))]\n        (is (= :yin.k/undecodable (:yin.k/status d)))\n        (is (contains? #{:row-order :duplicate-key} (:yin.k/kind d)))))))\n\n\n(deftest canonical-under-is-renaming-invariant\n  (let [a (rows/emit (fixture :lane-a/s1 :lane-a/s2 :source/x :source/y))\n        b (rows/emit (fixture :lane-b/s2 :lane-b/s1 :other/y :other/x))\n        ca (rows/canonical-under a {:lane-a/s1 :s1 :lane-a/s2 :s2})\n        cb (rows/canonical-under b {:lane-b/s2 :s1 :lane-b/s1 :s2})]\n    (is (= (:yin.k/root ca) (:yin.k/root cb)))\n    (is (= (:yin.k/root ca)\n           (:yin.k/root (rows/canonical-under\n                          (rows/emit-numbered (fixture :lane-a/s1 :lane-a/s2 :source/x :source/y)\n                                              {:source/x :yin.k/cc-2 :source/y :yin.k/cc-1})\n                          {:lane-a/s1 :s1 :lane-a/s2 :s2}))))\n    (is (= (set (:yin.k/rows ca)) (set (:yin.k/rows cb))))\n    (is (= :missing-stream-correspondence\n           (:yin.k/kind (error #(rows/canonical-under a {:lane-a/s1 :s1})))))))\n\n\n(deftest alias-topology-and-census\n  (let [x :local/x y :local/y body (cursor-cell-body :s 0)\n        a (task-node [[x body] [y body]] [:row (rows/node :vec [[:cursor-cell x] [:cursor-cell x] [:cursor-cell y]])])\n        b (task-node [[x body] [y body]] [:row (rows/node :vec [[:cursor-cell x] [:cursor-cell y] [:cursor-cell y]])])\n        c (task-node [[x body] [y (cursor-cell-body :s 1)]] [:row (rows/node :vec [[:cursor-cell x] [:cursor-cell x] [:cursor-cell y]])])]\n    (is (not= (:yin.k/root (rows/emit a)) (:yin.k/root (rows/emit b))))\n    (is (not= (:yin.k/root (rows/emit a)) (:yin.k/root (rows/emit c))))\n    (let [wire (rows/emit a)]\n      (is (= (:yin.k/root wire) (:yin.k/root (rows/emit (rows/decode wire)))))\n      (is (= 2 (count (rows/canonical-numbering a)))))))\n\n\n(deftest refinement-search-on-symmetric-cursor-cells-is-bounded\n  (let [body (cursor-cell-body :s 0)\n        make-task (fn [a b] (task-node [[a body] [b body]] [:row (rows/node :set [[:cursor-cell a] [:cursor-cell b]])]))\n        a (rows/emit (make-task :x :y)) b (rows/emit (make-task :b :a))]\n    (is (= (:yin.k/root a) (:yin.k/root b)))\n    (is (= 2 (count (rows/canonical-numbering (make-task :x :y)))))\n    (is (= :resource-limit (:yin.k/kind (error #(rows/emit (make-task :x :y) {:search 1})))))\n    (is (= :yin.k/unsupported (:yin.k/status (error #(rows/emit (make-task :x :y) {:search 1})))))))\n\n\n(deftest gates-and-graph-before-hashes\n  (let [wire (rows/emit (task-node [] [:lit nil]))]\n    (doseq [version [0 1 2 4 3.5]]\n      (is (= :yin.k/profile-mismatch (:yin.k/status (error #(rows/decode (assoc wire :yin.k/version version)))))))\n    (is (= :duplicate-row (:yin.k/kind (error #(rows/decode (update wire :yin.k/rows conj (first (:yin.k/rows wire))))))))\n    (is (= :unreachable-row (:yin.k/kind (error #(rows/decode (update wire :yin.k/rows conj [:fake :prim 'f]))))))\n    (is (= :row-shape (:yin.k/kind (error #(rows/decode (assoc wire :extra 1))))))\n    (let [root (:yin.k/root wire)\n          root-row (first (filter #(= root (first %)) (:yin.k/rows wire)))\n          store (first (first (filter #(= :store (second %)) (:yin.k/rows wire))))\n          forge (fn [i x] (update wire :yin.k/rows (fn [rs] (mapv #(if (= root (first %)) (assoc % i x) %) rs))))]\n      ;; Slot n of the task row is at index n + 2.\n      (is (= :task-shape (:yin.k/kind (error #(rows/decode (forge 14 5))))))\n      (is (= :reference-kind (:yin.k/kind (error #(rows/decode (forge 7 store))))))\n      (is (= :yin.k/hash-mismatc