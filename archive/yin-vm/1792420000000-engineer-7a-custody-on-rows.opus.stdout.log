/yin/vm/ucf/rows/checkpoint.cljc\n     238 test/yin/vm/ucf/rows_support.cljc\n     452 test/yin/vm/ucf/rows_checkpoint_fixtures.cljc\n     203 test/yin/vm/ucf/rows_checkpoint_test.cljc\n     275 test/yin/vm/ucf/rows_custody_test.cljc\n     917 test/resources/yin/vm/ucf/rows-checkpoint-v3.txt\n      22 test/resources/yin/vm/ucf/ledger-v2.txt\n    2219 src/cljc/yin/vm/ucf/rows.cljc\n    4428 total\n src/cljc/yin/vm/ucf/authority/admission.cljc       |   4 +-\n src/cljc/yin/vm/ucf/authority/completion.cljc      |   6 +-\n src/cljc/yin/vm/ucf/authority/grant.cljc           |   9 +-\n src/cljc/yin/vm/ucf/rows.cljc                      | 411 +++++++++++++++++++--\n .../semantic_register/safepoint_harness_test.cljc  |   4 +-\n test/yin/vm/ucf/authority/admission_test.cljc      |   8 +-\n test/yin/vm/ucf/authority/completion_test.cljc     |  32 +-\n test/yin/vm/ucf/authority/front_test.cljc          |  55 ++-\n test/yin/vm/ucf/authority/grant_test.cljc          |  35 +-\n test/yin/vm/ucf/authority/inherited_test.cljc      | 120 ++----\n test/yin/vm/ucf/authority/input_test.cljc          |   8 +-\n test/yin/vm/ucf/authority/reclaim_test.cljc        |   8 +-\n test/yin/vm/ucf/holder/evidence_test.cljc          |   8 +-\n test/yin/vm/ucf/holder/reader_test.cljc            |  11 +-\n test/yin/vm/ucf/holder/writer_test.cljc            |  11 +-\n test/yin/vm/ucf/ledger_fixture_test.cljc           |   2 +-\n test/yin/vm/ucf/ledger_fixtures.cljc               |  35 +-\n 17 files changed, 553 insertions(+), 214 deletions(-)\ntest/yin/vm/ucf/rows_checkpoint_test.cljc:17\ntest/yin/vm/ucf/rows_custody_test.cljc:11","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01BKwLyafBEvSrbe38JbCDst","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
