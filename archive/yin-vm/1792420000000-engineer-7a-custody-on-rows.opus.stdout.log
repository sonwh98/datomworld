tore) address nil))))))\n660\t    (is (= before @frames))))\n661\t\n662\t\n663\t(deftest any-accepted-variant-is-the-checkpoint\n664\t  (let [{:keys [a] :as w} (world)\n665\t        variant (assoc succ-1 :yin.k/id-counter 9)\n666\t        store (mem/create-content-mem)\n667\t        {:keys [address bytes]} (enc variant)]\n668\t    (is (= :committed (offer! a store variant)) \"an equal-baseline variant\")\n669\t    (is (= #{address (:address (enc succ-1))}\n670\t           (get-in (authority/projection a)\n671\t                   [:occurrences s1 :yin.k/variants])))\n672\t    (is (cbor/bytes= bytes ((:get-bytes-fn store) address nil)))\n673\t    (is (= (committed (op r 0)) (admit! w store \"holder-b\" (env (op r 0) :v)))\n674\t        \"the store holds only the second variant\")))\n675\t"}]},"parent_tool_use_id":null,"session_id":"e6ad7c4d-4e91-4daf-807a-5f71c598506b","uuid":"7a654440-604b-4d42-93b2-29902d7c28bf","timestamp":"2026-10-13T09:33:11.938Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7a/test/yin/vm/ucf/authority/inherited_test.cljc","content":"(deftest an-inherited-id-to-a-second-target-conflicts\n  (let [{:keys [frames a store diag] :as w} (world)\n        j (:yin.k/target (authority/enroll! a))]\n    (is (= (committed (op r 0)) (admit! w (env (op r 0) :v))))\n    (is (= :intent-conflict\n           (:yin.k/admission\n             (admission/admit! a store j \"holder-b\" (env (op r 0) :v) diag))))\n    (is (= 1 (count (facts frames :yin.k/quarantined))))))\n\n\n;; =============================================================================\n;; Snapshot variants (UCF 7.7.8): the baseline includes the children\n;; =============================================================================\n\n(deftest a-variant-changing-a-child-intent-is-refused\n  (let [succ (with-installs s1 (origin r \"lease-1\"))\n        {:keys [frames a store]} (world succ)\n        before @frames\n        grand (conj foo :yin.k/install