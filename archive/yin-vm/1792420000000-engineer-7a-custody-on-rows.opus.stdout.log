tion successor and a stranger occurrence.\n44\t(def r \"0c000000-0000-4000-8000-000000000001\")\n45\t\n46\t(def s1 \"0c000000-0000-4000-8000-000000000002\")\n47\t\n48\t(def x \"0c000000-0000-4000-8000-000000000004\")\n49\t\n50\t\n51\t;; =============================================================================\n52\t;; World: the requests a holder and the composition make\n53\t;; =============================================================================\n54\t\n55\t(defn header-frame\n56\t  \"The journal header frame naming identity `i`.\"\n57\t  ([] (header-frame arb))\n58\t  ([i]\n59\t   (cbor/encode {:dao.stream.journal/header {:version 1 :identity i}})))\n60\t\n61\t\n62\t(defn origin\n63\t  [o l]\n64\t  {:yin.k/occurrence o :dao.lease/lease l :yin.k/emitter \"holder-a\"})\n65\t\n66\t\n67\t(defn park\n68\t  \"A blocked root of occurrence `o` with counter `n` and origin `org`,\n69\t   nil for a first park.\"\n70\t  ([o n] (park o n nil))\n71\t  ([o n org]\n72\t   (cond-> (assoc (get fx/fixtures \"first-park\")\n73\t                  :yin.k/occurrence o\n74\t                  :yin.k/next-op-seq n\n75\t                  :yin.k/arbitration {:dao.stream/identity arb\n76\t                                      :dao.stream/descriptor\n77\t                                      {:dao.stream/type :dao.stream/journal}})\n78\t     (some? org) (assoc :yin.k/origin org))))\n79\t\n80\t\n81\t(defn halted\n82\t  \"A halted result of occurrence `o` under lease `l`.\"\n83\t  [o l]\n84\t  (assoc (get fx/fixtures \"halted-root\") :yin.k/origin (origin o l)))\n85\t\n86\t\n87\t(defn world\n88\t  \"A fresh world: the authority's frames (an atom), its content store and\n89\t   a diagnostic stream.\"\n90\t  []\n91\t  {:frames (atom [(header-frame)])\n92\t   :store (mem/create-content-mem)\n93\t   :diag (:dao.stream/handle\n94\t           (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n95\t                                ringbuffer/capacity-key 64}))})\n96\t\n97\t\n98\t