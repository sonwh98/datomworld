{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ViNopNDqFMygENXw39ZwPk","type":"tool_result","content":"1\t(ns yin.vm.ucf.checkpoint-test\n2\t  \"M-next C slice C4: the pure checkpoint inspector over the shared\n3\t   canonical fixtures.  Every fixture's bytes are pinned by the segment\n4\t   address test/resources/yin/vm/ucf/checkpoint-v1.txt records for it on\n5\t   each host, and three anchors are read as frozen bytes, so a rule\n6\t   about integer kind or key presence is checked on the bytes, never on\n7\t   a host number type (UCF 7.11.1, clauses 1, 2, 4 and 9).\"\n8\t  (:require [clojure.test :refer [deftest is testing]]\n9\t            [dao.jing :as jing]\n10\t            [dao.jing.cbor :as cbor]\n11\t            [dao.jing.cbor-fixtures :as fx]\n12\t            [yin.vm.ucf :as ucf]\n13\t            [yin.vm.ucf.checkpoint :as checkpoint]\n14\t            [yin.vm.ucf.handoff :as handoff]\n15\t            [yin.vm.ucf.checkpoint-fixtures :as f]))\n16\t\n17\t\n18\t(defn- inspect\n19\t  [n]\n20\t  (let [{:keys [address bytes]} (f/fixture n)]\n21\t    (checkpoint/inspect address bytes)))\n22\t\n23\t\n24\t(defn- intent-hex\n25\t  \"The BLAKE3 hex of the canonical intent bytes.\"\n26\t  [target payload]\n27\t  (jing/digest-bytes :blake3 (cbor/encode [:yin.k/append target payload])))\n28\t\n29\t\n30\t(defn- write-of\n31\t  \"The target identity and payload of the first retained write of the\n32\t   body of fixture `n`, root or `in`: what its baseline intent hashes.\"\n33\t  ([n] (write-of n []))\n34\t  ([n in]\n35\t   (let [b (get-in (f/base-body n) in)\n36\t         p (some (comp #(when (= :put (:yin.k/reason %)) %)\n37\t                       :yin.k/pending)\n38\t                 (:yin.k/frames b))]\n39\t     [(get-in p [:yin.k/stream :dao.stream/identity]) (:yin.k/value p)])))\n40\t\n41\t\n42\t(deftest the-file-holds-exactly-the-declared-bytes\n43\t  (is (= (f/render) (fx/read-path f/path))))\n44\t\n45\t\n46\t;; =============================================================================\n47\t;; Accepted shapes\n48\t;; =============================================================================\n49\t\n50\t(deftest a-first-park-has-an-empty-baseline-at-zero\n51\t  (is (= {:yin.k/kind :blocked\n52\t          :yin.k/occurrence f/occurrence\n53\t          :yin.k/arbitration f/arbitration\n54\t          :yin.k/next-op-seq 0\n55\t          :yin.k/ops {}}\n56\t         (inspect \"first-park\"))))\n57\t\n58\t\n59\t(deftest a-successor-baseline-maps-each-carried-id-to-its-intent\n60\t  (is (= {:yin.k/kind :blocked\n61\t          :yin.k/occurrence f/occurrence\n62\t          :yin.k/origin f/origin\n63\t          :yin.k/arbitration f/arbitration\n64\t          :yin.k/next-op-seq 3\n65\t          :yin.k/ops\n66\t          {(f/op-id 0) (apply intent-hex (write-of \"successor\"))}}\n67\t         (inspect \"successor\"))))\n68\t\n69\t\n70\t(deftest snapshot-variants-compare-by-baseline\n71\t  (let [base (inspect \"successor\")\n72\t        [target payload] (write-of \"successor\")]\n73\t    (testing \"equal intents: a different body, the same baseline\"\n74\t      (is (not= (:address (f/fixture \"successor\"))\n75\t                (:address (f/fixture \"variant-equal\"))))\n76\t      (is (= base (inspect \"variant-equal\"))))\n77\t    (testing \"one id kept, its payload substituted\"\n78\t      (let [v (inspect \"variant-different-intent\")]\n79\t        (is (= (set (keys (:yin.k/ops base))) (set (keys (:yin.k/ops v)))))\n80\t        (is (not= (get-in base [:yin.k/ops (f/op-id 0)])\n81\t                  (get-in v [:yin.k/ops (f/op-id 0)])))\n82\t        (is (not= \"w\" payload))\n83\t        (is (= (intent-hex target \"w\")\n84\t               (get-in v [:yin.k/ops (f/op-id 0)])))\n85\t        (is (not= base v))))\n86\t    (testing \"the same ids and intents under another counter\"\n87\t      (let [v (inspect \"variant-counter\")]\n88\t        (is (= (:yin.k/ops base) (:yin.k/ops v)))\n89\t        (is (= 4 (:yin.k/next-op-seq v)))\n90\t        (is (not= base v))))))\n91\t\n92\t\n93\t(deftest a-parked-root-carries-the-header-and-no-wait\n94\t  (is (= {:yin.k/kind :parked\n95\t          :yin.k/occurrence f/occurrence\n96\t          :yin.k/origin f/origin\n97\t          :yin.k/arbitration f/arbitration\n98\t          :yin.k/next-op-seq 1\n99\t          :yin.k/ops {}}\n100\t         (inspect \"parked\"))))\n101\t\n102\t\n103\t(deftest install-children-draw-ids-in-the-roots-context\n104\t  (let [r (inspect \"installs\")]\n105\t    (is (= 6 (:yin.k/next-op-seq r)))\n106\t    (is (= {(f/op-id 4) (apply intent-hex\n107\t                               (write-of \"installs\"\n108\t                                         [:yin.k/installs 'host.mod\n109\t                                          :yin.k/child]))}\n110\t           (:yin.k/ops r))\n111\t        \"the child's id joins the root's baseline\")))\n112\t\n113\t\n114\t(deftest a-halted-root-carries-only-its-origin\n115\t  (is (= {:yin.k/kind :halted :yin.k/origin f/origin :yin.k/ops {}}\n116\t         (inspect \"halted-root\"))))\n117\t\n118\t\n119\t(deftest the-counter-bound-is-valid-and-its-last-id-below-it\n120\t  (let [r (inspect \"counter-at-bound\")]\n121\t    (is (= f/max-exact (:yin.k/next-op-seq r)))\n122\t    (is (contains? (:yin.k/ops r) (f/op-id (dec f/max-exact))))))\n123\t\n124\t\n125\t(deftest inspect-body-agrees-with-inspect\n126\t  (doseq [n [\"first-park\" \"successor\" \"installs\" \"op-id-at-counter\"]]\n127\t    (is (= (inspect n)\n128\t           (checkpoint/inspect-body (cbor/decode (:bytes (f/fixture n)))))\n129\t        n)))\n130\t\n131\t\n132\t;; =============================================================================\n133\t;; Refusals: one fixture per class, each data with its path\n134\t;; =============================================================================\n135\t\n136\t(def ^:private refused-names\n137\t  \"The fixtures whose refusal is an expectation computed from the base.\"\n138\t  (filter f/expected f/fixture-names))\n139\t\n140\t\n141\t(deftest each-grammar-breach-is-undecodable-naming-its-path\n142\t  (doseq [n refused-names\n143\t          :let [[path kind] (f/expected n)\n144\t                r (inspect n)]]\n145\t    (is (= :yin.k/undecodable (:yin.k/status r)) n)\n146\t    (is (= path (:yin.k/path r)) n)\n147\t    (is (= kind (:yin.k/kind r)) n)))\n148\t\n149\t\n150\t(deftest each-mutation-differs-from-its-base-at-the-place-it-names\n151\t  (doseq [n f/fixture-names\n152\t          :let [base (f/base-of n)]\n153\t          :when (and base (not (contains? #{\"hash-mismatch\" \"non-canonical\"}\n154\t                                          n)))]\n155\t    (let [mutated (get f/fixtures n)\n156\t          original (f/base-body base)]\n157\t      ;; content equality, not host =: Dart's num equality answers 1 =\n158\t      ;; 1.0, and version-float must differ by its kind\n159\t      (is (not (cbor/content= mutated original)) n)\n160\t      (when-some [place (f/place n)]\n161\t        (is (not (cbor/content= (get-in mutated place)\n162\t                                (get-in original place)))\n163\t            (str n \" at \" (pr-str place))))))\n164\t  (testing \"every accepted base is accepted again by the reader's grammar\"\n165\t    (doseq [n [\"first-park\" \"successor\" \"installs\" \"parked\" \"halted-root\"]]\n166\t      (is (map? (handoff/validate-body (cbor/decode (:bytes (f/fixture n)))))\n167\t          n))))\n168\t\n169\t\n170\t(deftest the-version-gate-checks-the-integer-kind\n171\t  (testing \"version 2 is the v2 grammar: a version-1 stamp is no profile\"\n172\t    (let [r (inspect \"version-2\")]\n173\t      (is (= :yin.k/profile-mismatch (:yin.k/status r)))\n174\t      (is (= [:yin.k/contract] (:yin.k/path r)))\n175\t      (is (= ucf/supported-profiles (:yin.k/supported r)))))\n176\t  (doseq [[n found] [[\"version-absent\" nil]\n177\t                     [\"version-0\" 0]]]\n178\t    (is (= {:yin.k/status :yin.k/profile-mismatch\n179\t            :yin.k/version found\n180\t            :yin.k/supported #{1}}\n181\t           (inspect n))\n182\t        n))\n183\t  (testing \"an integral float is no version, on every host\"\n184\t    (let [r (inspect \"version-float\")]\n185\t      (is (= :yin.k/profile-mismatch (:yin.k/status r)))\n186\t      (is (= #{1} (:yin.k/supported r)))\n187\t      (is (cbor/float64? (:yin.k/version r))))))\n188\t\n189\t\n190\t(deftest bytes-must-hash-to-the-address-and-be-canonical\n191\t  (is (= {:yin.k/status :yin.k/hash-mismatch\n192\t          :yin.k/address (:address (f/fixture \"first-park\"))\n193\t          :yin.k/computed (:address (f/fixture \"successor\"))}\n194\t         (inspect \"hash-mismatch\")))\n195\t  (testing \"the algorithm is the one the address names\"\n196\t    (let [bs (:bytes (f/fixture \"successor\"))\n197\t          sha (keyword \"segment\" (str \"sha256-\" (jing/digest-bytes :sha256\n198\t                                                                   bs)))]\n199\t      (is (= (inspect \"successor\") (checkpoint/inspect sha bs)))))\n200\t  (testing \"an address that is no segment address is the same refusal\"\n201\t    (let [{:keys [address bytes]} (f/fixture \"successor\")]\n202\t      (doseq [a [(jing/digest-bytes :blake3 bytes) (str address) nil\n203\t                 :segment/md5-00]]\n204\t        (is (= {:yin.k/status :yin.k/hash-mismatch\n205\t                :yin.k/address a\n206\t                :yin.k/computed address}\n207\t               (checkpoint/inspect a bytes))\n208\t            (pr-str a)))))\n209\t  (is (= {:yin.k/status :yin.k/undecodable :yin.k/path []\n210\t          :yin.k/kind :bytes :yin.k/refusal :non-canonical}\n211\t         (inspect \"non-canonical\"))))\n212\t\n213\t\n214\t(deftest every-fixture-has-an-expectation\n215\t  (let [accepted #{\"first-park\" \"successor\" \"variant-equal\"\n216\t                   \"variant-different-intent\" \"variant-counter\" \"parked\"\n217\t                   \"installs\" \"halted-root\" \"counter-at-bound\"}\n218\t        refused (into #{\"hash-mismatch\" \"non-canonical\" \"version-float\"\n219\t                        \"version-2\" \"version-absent\" \"version-0\"}\n220\t                      refused-names)]\n221\t    (is (= (set f/fixture-names) (into accepted refused)))\n222\t    (doseq [n accepted]\n223\t      (is (not (contains? (inspect n) :yin.k/status)) n))))\n224\t\n225\t\n226\t(deftest refusals-are-data-on-any-input\n227\t  (doseq [[a bs] [[nil nil] [\"x\" \"not bytes\"]\n228\t                  [nil (fx/hex->bytes \"\")]]]\n229\t    (is (= :yin.k/hash-mismatch (:yin.k/status (checkpoint/inspect a bs)))))\n230\t  (testing \"bytes under their own address that are no CBOR item\"\n231\t    (let [bs (fx/hex->bytes \"ff\")\n232\t          r (checkpoint/inspect (f/segment-address bs) bs)]\n233\t      (is (= :yin.k/undecodable (:yin.k/status r)))\n234\t      (is (= :bytes (:yin.k/kind r)))\n235\t      (is (keyword? (:yin.k/refusal r)))))\n236\t  (doseq [b [nil 1 [] {} {:yin.k/handoff true}]]\n237\t    (is (contains? #{:yin.k/undecodable :yin.k/profile-mismatch}\n238\t                   (:yin.k/status (checkpoint/inspect-body b)))\n239\t        (pr-str b))))\n240\t"}]},"parent_tool_use_id":null,"session_id":"e6ad7c4d-4e91-4daf-807a-5f71c598506b","uuid":"d12e5a5e-bc74-4349-ae0e-c681a30d6c47","timestamp":"2026-10-13T09:16:40.783Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7a/test/yin/vm/ucf/checkpoint_test.cljc","content":"(ns yin.vm.ucf.checkpoint-test\n  \"M-next C slice C4: the pure checkpoint inspector over the shared\n   canonical fixtures.  Every fixture's bytes are pinned by the segment\n   address test/resources/yin/vm/ucf/checkpoint-v1.txt records for it on\n   each host, and three anchors are read as frozen bytes, so a rule\n   about integer kind or key presence is checked on the bytes, never on\n   a host number type (UCF 7.11.1, clauses 1, 2, 4 and 9).\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.cbor-fixtures :as fx]\n            [yin.vm.ucf :as ucf]\n            [yin.vm.ucf.checkpoint :as checkpoint]\n            [yin.vm.ucf.handoff :as handoff]\n            [yin.vm.ucf.checkpoint-fixtures :as f]))\n\n\n(defn- inspect\n  [n]\n  (let [{:keys [address bytes]} (f/fixture n)]\n    (checkpoint/inspect address bytes)))\n\n\n(defn- intent-hex\n  \"The BLAKE3 hex of the canonical intent bytes.\"\n  [target payload]\n  (jing/digest-bytes :blake3 (cbor/encode [:yin.k/append target payload])))\n\n\n(defn- write-of\n  \"The target identity and payload of the first retained write of the\n   body of fixture `n`, root or `in`: what its baseline intent hashes.\"\n  ([n] (write-of n []))\n  ([n in]\n   (let [b (get-in (f/base-body n) in)\n         p (some (comp #(when (= :put (:yin.k/reason %)) %)\n                       :yin.k/pending)\n                 (:yin.k/frames b))]\n     [(get-in p [:yin.k/stream :dao.stream/identity]) (:yin.k/value p)])))\n\n\n(deftest the-file-holds-exactly-the-declared-bytes\n  (is (= (f/render) (fx/read-path f/path))))\n\n\n;; =============================================================================\n;; Accepted shapes\n;; =============================================================================\n\n(deftest a-first-park-has-an-empty-baseline-at-zero\n  (is (= {:yin.k/kind :blocked\n          :yin.k/occurrence f/occurrence\n          :yin.k/arbitration f/arbitration\n          :yin.k/next-op-seq 0\n          :yin.k/ops {}}\n         (inspect \"first-park\"))))\n\n\n(deftest a-successor-baseline-maps-each-carried-id-to-its-intent\n  (is (= {:yin.k/kind :blocked\n          :yin.k/occurrence f/occurrence\n          :yin.k/origin f/origin\n          :yin.k/arbitration f/arbitration\n          :yin.k/next-op-seq 3\n          :yin.k/ops\n          {(f/op-id 0) (apply intent-hex (write-of \"successor\"))}}\n         (inspect \"successor\"))))\n\n\n(deftest snapshot-variants-compare-by-baseline\n  (let [base (inspect \"successor\")\n        [target payload] (write-of \"successor\")]\n    (testing \"equal intents: a different body, the same baseline\"\n      (is (not= (:address (f/fixture \"successor\"))\n                (:address (f/fixture \"variant-equal\"))))\n      (is (= base (inspect \"variant-equal\"))))\n    (testing \"one id kept, its payload substituted\"\n      (let [v (inspect \"variant-different-intent\")]\n        (is (= (set (keys (:yin.k/ops base))) (set (keys (:yin.k/ops v)))))\n        (is (not= (get-in base [:yin.k/ops (f/op-id 0)])\n                  (get-in v [:yin.k/ops (f/op-id 0)])))\n        (is (not= \"w\" payload))\n        (is (= (intent-hex target \"w\")\n               (get-in v [:yin.k/ops (f/op-id 0)])))\n        (is (not= base v))))\n    (testing \"the same ids and intents under another counter\"\n      (let [v (inspect \"variant-counter\")]\n        (is (= (:yin.k/ops base) (:yin.k/ops v)))\n        (is (= 4 (:yin.k/next-op-seq v)))\n        (is (not= base v))))))\n\n\n(deftest a-parked-root-carries-the-header-and-no-wait\n  (is (= {:yin.k/kind :parked\n          :yin.k/occurrence f/occurrence\n          :yin.k/origin f/origin\n          :yin.k/arbitration f/arbitration\n          :yin.k/next-op-seq 1\n          :yin.k/ops {}}\n         (inspect \"parked\"))))\n\n\n(deftest install-children-draw-ids-in-the-roots-context\n  (let [r (inspect \"installs\")]\n    (is (= 6 (:yin.k/next-op-seq r)))\n    (is (= {(f/op-id 4) (apply intent-hex\n                               (write-of \"installs\"\n                                         [:yin.k/installs 'host.mod\n                                          :yin.k/child]))}\n           (:yin.k/ops r))\n        \"the child's id joins the root's baseline\")))\n\n\n(deftest a-halted-root-carries-only-its-origin\n  (is (= {:yin.k/kind :halted :yin.k/origin f/origin :yin.k/ops {}}\n         (inspect \"halted-root\"))))\n\n\n(deftest the-counter-bound-is-valid-and-its-last-id-below-it\n  (let [r (inspect \"counter-at-bound\")]\n    (is (= f/max-exact (:yin.k/next-op-seq r)))\n    (is (contains? (:yin.k/ops r) (f/op-id (dec f/max-exact))))))\n\n\n(deftest inspect-body-agrees-with-inspect\n  (doseq [n [\"first-park\" \"successor\" \"installs\" \"op-id-at-counter\"]]\n    (is (= (inspect n)\n           (checkpoint/inspect-body (cbor/decode (:bytes (f/fixture n)))))\n        n)))\n\n\n;; =============================================================================\n;; Refusals: one fixture per class, each data with its path\n;; =============================================================================\n\n(def ^:private refused-names\n  \"The fixtures whose refusal is an expectation computed from the base.\"\n  (filter f/expected f/fixture-names))\n\n\n(deftest each-grammar-breach-is-undecodable-naming-its-path\n  (doseq [n refused-names\n          :let [[path kind] (f/expected n)\n                r (inspect n)]]\n    (is (= :yin.k/undecodable (:yin.k/status r)) n)\n    (is (= path (:yin.k/path r)) n)\n    (is (= kind (:yin.k/kind r)) n)))\n\n\n(deftest each-mutation-differs-from-its-base-at-the-place-it-names\n  (doseq [n f/fixture-names\n          :let [base (f/base-of n)]\n          :when (and base (not (contains? #{\"hash-mismatch\" \"non-canonical\"}\n                                          n)))]\n    (let [mutated (get f/fixtures n)\n          original (f/base-body base)]\n      ;; content equality, not host =: Dart's num equality answers 1 =\n      ;; 1.0, and version-float must differ by its kind\n      (is (not (cbor/content= mutated original)) n)\n      (when-some [place (f/place n)]\n        (is (not (cbor/content= (get-in mutated place)\n                                (get-in original place)))\n            (str n \" at \" (pr-str place))))))\n  (testing \"every accepted base is accepted again by the reader's grammar\"\n    (doseq [n [\"first-park\" \"successor\" \"installs\" \"parked\" \"halted-root\"]]\n      (is (map? (handoff/validate-body (cbor/decode (:bytes (f/fixture n)))))\n          n))))\n\n\n(deftest the-version-gate-checks-the-integer-kind\n  (testing \"version 2 is the v2 grammar: a version-1 stamp is no profile\"\n    (let [r (inspect \"version-2\")]\n      (is (= :yin.k/profile-mismatch (:yin.k/status r)))\n      (is (= [:yin.k/contract] (:yin.k/path r)))\n      (is (= ucf/supported-profiles (:yin.k/supported r)))))\n  (doseq [[n found] [[\"version-absent\" nil]\n                     [\"version-0\" 0]]]\n    (is (= {:yin.k/status :yin.k/profile-mismatch\n            :yin.k/version found\n            :yin.k/supported #{1}}\n           (inspect n))\n        n))\n  (testing \"an integral float is no version, on every host\"\n    (let [r (inspect \"version-float\")]\n      (is (= :yin.k/profile-mismatch (:yin.k/status r)))\n      (is (= #{1} (:yin.k/supported r)))\n      (is (cbor/float64? (:yin.k/version r))))))\n\n\n(deftest bytes-must-hash-to-the-address-and-be-canonical\n  (is (= {:yin.k/status :yin.k/hash-mismatch\n          :yin.k/address (:address (f/fixture \"first-park\"))\n          :yin.k/computed (:address (f/fixture \"successor\"))}\n         (inspect \"hash-mismatch\")))\n  (testing \"the algorithm is the one the address names\"\n    (let [bs (:bytes (f/fixture \"successor\"))\n          sha (keyword \"segment\" (str \"sha256-\" (jing/digest-bytes :sha256\n                                                                   bs)))]\n      (is (= (inspect \"successor\") (checkpoint/inspect sha bs)))))\n  (testing \"an address that is no segment address is the same refusal\"\n    (let [{:keys [address bytes]} (f/fixture \"successor\")]\n      (doseq [a [(jing/digest-bytes :blake3 bytes) (str address) nil\n                 :segment/md5-00]]\n        (is (= {:yin.k/status :yin.k/hash-mismatch\n                :yin.k/address a\n                :yin.k/computed address}\n               (checkpoint/inspect a bytes))\n            (pr-str a)))))\n  (is (= {:yin.k/status :yin.k/undecodable :yin.k/path []\n          :yin.k/kind :bytes :yin.k/refusal :non-canonical}\n         (inspect \"non-canonical\"))))\n\n\n(deftest every-fixture-has-an-expectation\n  (let [accepted #{\"first-park\" \"successor\" \"variant-equal\"\n                   \"variant-different-intent\" \"variant-counter\" \"parked\"\n                   \"installs\" \"halted-root\" \"counter-at-bound\"}\n        refused (into #{\"hash-mismatch\" \"non-canonical\" \"version-float\"\n                        \"version-2\" \"version-absent\" \"version-0\"}\n                      refused-names)]\n    (is (= (set f/fixture-names) (into accepted refused)))\n    (doseq [n accepted]\n      (is (not (contains? (inspect n) :yin.k/status)) n))))\n\n\n(deftest refusals-are-data-on-any-input\n  (doseq [[a bs] [[nil nil] [\"x\" \"not bytes\"]\n                  [nil (fx/hex->bytes \"\")]]]\n    (is (= :yin.k/hash-mismatch (:yin.k/status (checkpoint/inspect a bs)))))\n  (testing \"bytes under their own address that are no CBOR item\"\n    (let [bs (fx/hex->bytes \"ff\")\n          r (checkpoint/inspect (f/segment-address bs) bs)]\n      (is (= :yin.k/undecodable (:yin.k/status r)))\n      (is (= :bytes (:yin.k/kind r)))\n      (is (keyword? (:yin.k/refusal r)))))\n  (doseq [b [nil 1 [] {} {:yin.k/handoff true}]]\n    (is (contains? #{:yin.k/undecodable :yin.k/profile-mismatch}\n                   (:yin.k/status (checkpoint/inspect-body b)))\n        (pr-str b))))\n","numLines":240,"startLine":1,"totalLines":240}},"tool_result_meta":[{"id":"toolu_01ViNopNDqFMygENXw39ZwPk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
