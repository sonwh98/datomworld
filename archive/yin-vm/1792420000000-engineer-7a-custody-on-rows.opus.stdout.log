{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MbLtSeuJpZVTEGmGBRV3rR","type":"tool_result","content":"1\t(ns yin.vm.ucf.authority.grant-test\n2\t  (:require [clojure.test :refer [deftest is testing]]\n3\t            [dao.jing :as jing]\n4\t            [dao.jing.cbor :as cbor]\n5\t            [dao.jing.mem :as mem]\n6\t            [dao.lease :as lease]\n7\t            [dao.stream :as stream]\n8\t            [dao.stream.journal :as journal]\n9\t            [dao.stream.memory-log :as memory-log]\n10\t            [dao.stream.remote :as remote]\n11\t            [dao.stream.ringbuffer :as ringbuffer]\n12\t            [yin.vm.ucf.authority :as authority]\n13\t            [yin.vm.ucf.authority.completion :as completion]\n14\t            [yin.vm.ucf.authority.grant :as grant]\n15\t            [yin.vm.ucf.checkpoint :as checkpoint]\n16\t            [yin.vm.ucf.checkpoint-fixtures :as fx]\n17\t            [yin.vm.ucf.custody :as custody]))\n18\t\n19\t\n20\t(def ^:private arb \"arb-c5\")\n21\t\n22\t(def ^:private occ fx/occurrence)\n23\t\n24\t(def ^:private duration {:s 30})\n25\t\n26\t\n27\t(defn- fresh-frames\n28\t  \"A journal whose header names `arb`, so bodies can name the authority\n29\t   before it opens.\"\n30\t  []\n31\t  (atom [(cbor/encode {:dao.stream.journal/header\n32\t                       {:version 1 :identity arb}})]))\n33\t\n34\t\n35\t(defn- auth\n36\t  ([frames] (auth frames nil))\n37\t  ([frames cut]\n38\t   (::authority/authority\n39\t     (authority/open! (journal/memory-backend frames cut)))))\n40\t\n41\t\n42\t(defn- body\n43\t  \"Fixture `n` naming this test's authority.\"\n44\t  ([n] (body n identity))\n45\t  ([n f]\n46\t   (f (assoc (get fx/fixtures n)\n47\t             :yin.k/arbitration {:dao.stream/identity arb\n48\t                                 :dao.stream/descriptor\n49\t                                 {:dao.stream/type :dao.stream/journal}}))))\n50\t\n51\t\n52\t(defn- bytes-of\n53\t  [b]\n54\t  (let [bs (cbor/encode b)]\n55\t    {:address (fx/segment-address bs) :bytes bs}))\n56\t\n57\t\n58\t(defn- offer!\n59\t  ([a store b] (offer! a store b \"carrier\"))\n60\t  ([a store b medium]\n61\t   (let [{:keys [address bytes]} (bytes-of b)]\n62\t     (grant/offer! a store address bytes medium))))\n63\t\n64\t\n65\t(defn- status\n66\t  [r]\n67\t  (:yin.k/status r))\n68\t\n69\t\n70\t(defn- outcome\n71\t  [r]\n72\t  (:dao.stream/outcome r))\n73\t\n74\t\n75\t(defn- records\n76\t  \"Every transaction record of the journal's frames.\"\n77\t  [frames]\n78\t  (mapv #(:dao.stream.journal/value (cbor/decode %)) (rest @frames)))\n79\t\n80\t\n81\t(defn- facts\n82\t  \"The facts of kind `k` (custody or lease status) across the records.\"\n83\t  [frames k]\n84\t  (for [r (records frames)\n85\t        :let [ds (get-in r [:dao.space/transaction :datoms])\n86\t              es (set (keep (fn [[e a v]]\n87\t                              (when (and (#{:yin.k/custody :dao.lease/status}\n88\t                                          a)\n89\t                                         (= k v))\n90\t                                e))\n91\t                            ds))]\n92\t        e (sort es)]\n93\t    (into {} (keep (fn [[e' a v]] (when (= e e') [a v]))) ds)))\n94\t\n95\t\n96\t(defn- attributed\n97\t  \"The journal's records, each attributed to the authority.\"\n98\t  [frames]\n99\t  (mapv (fn [r] [arb r]) (records frames)))\n100\t\n101\t\n102\t(defn- a-grant\n103\t  ([] (a-grant \"lease-1\" \"holder-a\"))\n104\t  ([l h]\n105\t   (lease/grant l (custody/subject occ) h duration\n106\t                {:dao.lease/proposal \"p-1\"})))\n107\t\n108\t\n109\t(defn- offered\n110\t  \"A fresh authority with the first-park fixture offered: the frames,\n111\t   the authority and the store.\"\n112\t  []\n113\t  (let [frames (fresh-frames)\n114\t        a (auth frames)\n115\t        store (mem/create-content-mem)]\n116\t    (offer! a store (body \"first-park\"))\n117\t    [frames a store]))\n118\t\n119\t\n120\t(defn- succeeded\n121\t  \"A fresh authority where the successor fixture's predecessor completed\n122\t   into it under lease-7 (slice C8), and the successor is offered: the\n123\t   frames, the authority and the store.\"\n124\t  []\n125\t  (let [frames (fresh-frames)\n126\t        a (auth frames)\n127\t        store (mem/create-content-mem)\n128\t        w (grant/writer a)\n129\t        {:keys [address bytes]} (bytes-of (body \"successor\"))]\n130\t    (offer! a store (body \"first-park\"\n131\t                          #(assoc % :yin.k/occurrence fx/predecessor)))\n132\t    (stream/append! w (lease/grant \"lease-7\" (custody/subject fx/predecessor)\n133\t                                   \"holder-p\" duration\n134\t                                   {:dao.lease/proposal \"p-7\"}))\n135\t    (completion/report! a \"holder-p\"\n136\t                        (completion/resumed fx/predecessor \"lease-7\" address)\n137\t                        bytes)\n138\t    (stream/append! w (lease/lapsed \"lease-7\" :release))\n139\t    (offer! a store (body \"successor\"))\n140\t    [frames a store]))\n141\t\n142\t\n143\t;; =============================================================================\n144\t;; Offers\n145\t;; =============================================================================\n146\t\n147\t(deftest an-offer-stores-the-body-then-records-its-baseline\n148\t  (let [frames (fresh-frames)\n149\t        a (auth frames)\n150\t        store (mem/create-content-mem)\n151\t        {:keys [address bytes]} (bytes-of (body \"first-park\"))]\n152\t    (is (= {:yin.k/status :committed :yin.k/occurrence occ :dao.space/t 0}\n153\t           (grant/offer! a store address bytes \"carrier\")))\n154\t    (is (= (body \"first-park\") (jing/get store address ::absent))\n155\t        \"the accepted body is in the content store\")\n156\t    (is (= [(custody/offer occ address \"carrier\"\n157\t                           (checkpoint/inspect address bytes))]\n158\t           (facts frames :yin.k/offered))\n159\t        \"the offer fact carries the inspector's baseline\")\n160\t    (is (= {:yin.k/baseline (checkpoint/inspect address bytes)\n161\t            :yin.k/variants #{address}\n162\t            :yin.k/epoch 0\n163\t            :dao.lease/lease nil}\n164\t           (get-in (authority/projection a) [:occurrences occ])))))\n165\t\n166\t\n167\t(deftest a-duplicate-offer-is-idempotent\n168\t  (let [[frames a store] (offered)\n169\t        before @frames]\n170\t    (is (= {:yin.k/status :replayed :yin.k/occurrence occ}\n171\t           (offer! a store (body \"first-park\"))))\n172\t    (is (= {:yin.k/status :replayed :yin.k/occurrence occ}\n173\t           (offer! a store (body \"first-park\") \"another-carrier\"))\n174\t        \"by occurrence and snapshot address, whatever the carrier\")\n175\t    (is (= {:yin.k/status :replayed :yin.k/occurrence occ}\n176\t           (offer! (auth frames) store (body \"first-park\")))\n177\t        \"after reopen too\")\n178\t    (is (= before @frames) \"nothing was written\")))\n179\t\n180\t\n181\t(deftest an-equal-baseline-variant-joins-its-occurrence\n182\t  (let [[frames a store] (succeeded)\n183\t        {:keys [address]} (bytes-of (body \"variant-equal\"))]\n184\t    (is (= :committed (status (offer! a store (body \"variant-equal\")))))\n185\t    (is (= 2 (count (filter #(= occ (:yin.k/occurrence %))\n186\t                            (facts frames :yin.k/offered)))))\n187\t    (is (contains? (get-in (authority/projection a)\n188\t                           [:occurrences occ :yin.k/variants])\n189\t                   address))\n190\t    (is (some? (jing/get store address nil)))))\n191\t\n192\t\n193\t(deftest a-conflicting-variant-is-refused\n194\t  (doseq [[n reason] [[\"variant-different-intent\" :variant-conflict]\n195\t                      [\"variant-counter\" :variant-conflict]]]\n196\t    (testing n\n197\t      (let [[frames a store] (succeeded)\n198\t            before @frames\n199\t            {:keys [address]} (bytes-of (body n))]\n200\t        (is (= {:yin.k/status :refused :yin.k/reason reason\n201\t                :yin.k/occurrence occ}\n202\t               (offer! a store (body n))))\n203\t        (is (= before @frames))\n204\t        (is (nil? (jing/get store address nil))\n205\t            \"a refused variant's body is not stored\")))))\n206\t\n207\t\n208\t(deftest a-known-occurrence-with-another-origin-is-refused\n209\t  (let [[frames a store] (offered)\n210\t        before @frames\n211\t        other (body \"successor\"\n212\t                    #(assoc-in % [:yin.k/origin :dao.lease/lease] \"lease-9\"))]\n213\t    (is (= {:yin.k/status :refused :yin.k/reason :occurrence-conflict\n214\t            :yin.k/occurrence occ}\n215\t           (offer! a store other)))\n216\t    (is (= before @frames))))\n217\t\n218\t\n219\t(deftest an-uninspectable-body-commits-nothing-and-stores-nothing\n220\t  (doseq [[label address bs]\n221\t          (let [{:keys [address bytes]} (bytes-of (body \"successor\"))\n222\t                v2 (bytes-of (body \"version-2\"))]\n223\t            [[\"undecodable version\" (:address v2) (:bytes v2)]\n224\t             [\"hash mismatch\" (fx/segment-address (cbor/encode :x)) bytes]\n225\t             [\"not bytes\" address :x]])]\n226\t    (testing label\n227\t      (let [frames (fresh-frames)\n228\t            a (auth frames)\n229\t            store (mem/create-content-mem)\n230\t            r (grant/offer! a store address bs \"carrier\")]\n231\t        (is (= :refused (status r)))\n232\t        (is (= :uninspectable (:yin.k/reason r)))\n233\t        (is (contains? #{:yin.k/undecodable :yin.k/profile-mismatch\n234\t                         :yin.k/hash-mismatch}\n235\t                       (get-in r [:yin.k/inspection :yin.k/status])))\n236\t        (is (= 1 (count @frames)) \"only the header\")\n237\t        (is (empty? (mem/entry-bytes store)))))))\n238\t\n239\t\n240\t(deftest offers-the-authority-cannot-hold-are-refused\n241\t  (doseq [[label b reason]\n242\t          [[\"a halted root\" (get fx/fixtures \"halted-root\") :not-offerable]\n243\t           [\"another authority\" (get fx/fixtures \"successor\")\n244\t            :foreign-arbitration]\n245\t           [\"an occurrence outside the form: the inspector refuses it\"\n246\t            (body \"successor\" #(assoc % :yin.k/occurrence \"O\"))\n247\t            :uninspectable]]]\n248\t    (testing label\n249\t      (let [frames (fresh-frames)\n250\t            store (mem/create-content-mem)\n251\t            r (offer! (auth frames) store b)]\n252\t        (is (= :refused (status r)))\n253\t        (is (= reason (:yin.k/reason r)))\n254\t        (is (= 1 (count @frames)))\n255\t        (is (empty? (mem/entry-bytes store)))))))\n256\t\n257\t\n258\t(deftest an-unwritable-store-suspends-the-offer\n259\t  (let [frames (fresh-frames)\n260\t        a (auth frames)\n261\t        store {:put-bytes-fn (fn [_ _] (throw (ex-info \"disk full\" {})))\n262\t               :get-bytes-fn (fn [_ nf] nf)}]\n263\t    (is (= {:yin.k/status :suspended :yin.k/reason :content-unavailable}\n264\t           (offer! a store (body \"first-park\"))))\n265\t    (is (= 1 (count @frames)) \"the ledger never references missing content\")\n266\t    (is (some? (authority/projection a)) \"nothing was poisoned\")))\n267\t\n268\t\n269\t;; =============================================================================\n270\t;; Grant and binding\n271\t;; =============================================================================\n272\t\n273\t(deftest a-grant-and-its-binding-commit-in-one-transaction\n274\t  (let [[frames a] (offered)\n275\t        w (grant/writer a)]\n276\t    (is (= {:dao.stream/outcome :dao.stream/ok}\n277\t           (stream/append! w (a-grant)))\n278\t        \"the judge's writer sees a plain stream outcome\")\n279\t    (let [[r] (drop 1 (records frames))\n280\t          ds (get-in r [:dao.space/transaction :datoms])]\n281\t      (is (= [(a-grant) (custody/bound occ \"lease-1\" \"holder-a\" 0)]\n282\t             [(first (facts frames :dao.lease/accepted))\n283\t              (first (facts frames :yin.k/bound))]))\n284\t      (is (= #{:dao.lease/accepted :yin.k/bound}\n285\t             (set (keep (fn [[_ a v]]\n286\t                          (when (#{:yin.k/custody :dao.lease/status} a) v))\n287\t                        ds)))\n288\t          \"one record holds both\"))\n289\t    (is (= {:yin.k/transaction {:yin.k/arbitration arb :dao.space/t 1}\n290\t            :yin.k/occurrence occ\n291\t            :dao.lease/lease \"lease-1\"\n292\t            :dao.lease/holder \"holder-a\"\n293\t            :yin.k/epoch 0}\n294\t           (custody/binding-evidence arb (attributed frames) \"lease-1\"))\n295\t        \"the first grant binds epoch 0\")))\n296\t\n297\t\n298\t(deftest the-writer-refuses-what-it-cannot-record\n299\t  (let [[frames a] (offered)\n300\t        w (grant/writer a)]\n301\t    (is (= :dao.stream/ok (outcome (stream/append! w (a-grant)))))\n302\t    (let [before @frames]\n303\t      (is (= {:dao.stream/outcome :dao.stream/invalid-value}\n304\t             (stream/append! w (a-grant \"lease-2\" \"holder-b\")))\n305\t          \"one live lease per occurrence\")\n306\t      (is (= {:dao.stream/outcome :dao.stream/invalid-value}\n307\t             (stream/append! w (assoc (a-grant \"lease-3\" \"holder-b\")\n308\t                                      :dao.lease/subject\n309\t                                      (custody/subject\n310\t                                        fx/predecessor))))\n311\t          \"an occurrence never offered\")\n312\t      (is (= {:dao.stream/outcome :dao.stream/invalid-value}\n313\t             (stream/append! w (lease/lapsed \"lease-9\" :policy)))\n314\t          \"a lapse of a lease never granted\")\n315\t      (is (= {:dao.stream/outcome :dao.stream/invalid-value}\n316\t             (stream/append! w (lease/refusal \"p-2\")))\n317\t          \"a refusal that names no proposer\")\n318\t      (is (= {:dao.stream/outcome :dao.stream/invalid-value}\n319\t             (stream/append! w (assoc (a-grant \"lease-4\" \"holder-b\")\n320\t                                      :yin.k/extra 1)))\n321\t          \"an attribute outside the published order\")\n322\t      (is (= {:dao.stream/outcome :dao.stream/ok}\n323\t             (stream/append! w (a-grant)))\n324\t          \"the recorded grant again is a replay\")\n325\t      (is (= before @frames) \"nothing more was written\"))\n326\t    (authority/close! a)\n327\t    (is (= {:dao.stream/outcome :dao.stream/transport-error}\n328\t           (stream/append! w (a-grant \"lease-5\" \"holder-b\"))))))\n329\t\n330\t\n331\t(defn- concurrently\n332\t  [thunks]\n333\t  #?(:cljd (mapv #(%) thunks)\n334\t     :clj (mapv deref (mapv #(future (%)) thunks))\n335\t     :cljs (mapv #(%) thunks)))\n336\t\n337\t\n338\t(deftest two-grants-race-for-one-occurrence\n339\t  (let [[frames a] (offered)\n340\t        w (grant/writer a)\n341\t        rs (concurrently\n342\t             (mapv (fn [n]\n343\t                     #(stream/append! w (a-grant (str \"lease-\" n)\n344\t                                                 (str \"holder-\" n))))\n345\t                   (range 8)))]\n346\t    (is (= {:dao.stream/ok 1 :dao.stream/invalid-value 7}\n347\t           (frequencies (map outcome rs))))\n348\t    (is (= 1 (count (facts frames :dao.lease/accepted))))\n349\t    (is (= 1 (count (facts frames :yin.k/bound))))))\n350\t\n351\t\n352\t;; =============================================================================\n353\t;; The judge\n354\t;; =============================================================================\n355\t\n356\t(defn- log\n357\t  [& vs]\n358\t  (let [h (:dao.stream/handle\n359\t            (memory-log/create! {:dao.stream/type :dao.stream/memory-log}))]\n360\t    (doseq [v vs] (stream/append! h v))\n361\t    h))\n362\t\n363\t\n364\t(defn- oldest\n365\t  [h]\n366\t  (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n367\t\n368\t\n369\t(defn- judge\n370\t  [a & proposers]\n371\t  (reduce (fn [j [who h]] (lease/wire-facts j h (oldest h) who))\n372\t          (let [ticks (log (lease/tick {:s 1}))]\n373\t            (lease/wire-tick\n374\t              (lease/initial-judge\n375\t                (merge (grant/judge-config a duration)\n376\t                       {:resolver (fn [source _] source) :self arb}))\n377\t              ticks (oldest ticks) :ticks))\n378\t          proposers))\n379\t\n380\t\n381\t(deftest two-candidates-one-grant\n382\t  (let [[frames a] (offered)\n383\t        propose #(log (lease/proposal % (custody/subject occ)))\n384\t        j (judge a [\"holder-a\" (propose \"p-a\")] [\"holder-b\" (propose \"p-b\")])\n385\t        j1 (grant/step! a j)\n386\t        [g] (facts frames :dao.lease/accepted)]\n387\t    (is (nil? (:abort j1)))\n388\t    (is (= 1 (count (facts frames :dao.lease/accepted))) \"exactly one grant\")\n389\t    (is (= \"holder-a\" (:dao.lease/holder g)))\n390\t    (is (= \"p-a\" (:dao.lease/proposal g)))\n391\t    (is (= duration (:dao.lease/duration g)))\n392\t    (is (= [(:dao.lease/lease g)] (keys (:ledger j1)))\n393\t        \"the judge seeded the one lease the ledger recorded\")\n394\t    (is (= 0 (:yin.k/epoch (custody/binding-evidence\n395\t                             arb (attributed frames) (:dao.lease/lease g)))))\n396\t    (grant/step! a j1)\n397\t    (is (= 1 (count (facts frames :dao.lease/accepted)))\n398\t        \"a later pass grants nothing more\")))\n399\t\n400\t\n401\t(deftest the-reclaim-callback-is-a-readiness-check\n402\t  (let [[frames a] (offered)\n403\t        ready? (:reclaim (grant/judge-config a duration))\n404\t        before @frames]\n405\t    (is (true? (ready? (custody/subject occ))))\n406\t    (is (= before @frames) \"it revokes nothing\")\n407\t    (authority/close! a)\n408\t    (is (false? (ready? (custody/subject occ))))))\n409\t\n410\t\n411\t(deftest a-judge-config-needs-a-valid-duration\n412\t  (let [[_ a] (offered)]\n413\t    (is (thrown? #?(:cljd Object :clj Throwable :cljs :default)\n414\t          (grant/judge-config a {:s 0})))))\n415\t\n416\t\n417\t;; =============================================================================\n418\t;; Crash cuts on the grant transition\n419\t;; =============================================================================\n420\t\n421\t(deftest crash-at-each-cut-commits-the-grant-zero-or-one-times\n422\t  (doseq [[cut persisted] [[:before-frame 0]\n423\t                           [:after-frame-before-visible 1]\n424\t                           [:torn-frame 0]]]\n425\t    (testing (name cut)\n426\t      (let [[frames a] (offered)\n427\t            _ (authority/close! a)\n428\t            a (auth frames cut)\n429\t            w (grant/writer a)]\n430\t        (is (= {:dao.stream/outcome :dao.stream/transport-error}\n431\t               (stream/append! w (a-grant))))\n432\t        (is (= {:dao.stream/outcome :dao.stream/transport-error}\n433\t               (stream/append! w (a-grant)))\n434\t            \"a poisoned authority grants nothing\")\n435\t        (let [a2 (auth frames)\n436\t              w2 (grant/writer a2)]\n437\t          (is (= persisted (count (facts frames :dao.lease/accepted)))\n438\t              \"reopen shows zero or one grant\")\n439\t          (is (= persisted (count (facts frames :yin.k/bound))))\n440\t          (is (= {:dao.stream/outcome :dao.stream/ok}\n441\t                 (stream/append! w2 (a-grant)))\n442\t              \"a retry after reopen finds the grant or commits it\")\n443\t          (is (= 1 (count (facts frames :dao.lease/accepted))))\n444\t          (is (= 0 (:yin.k/epoch (custody/binding-evidence\n445\t                                   arb (attributed frames) \"lease-1\")))\n446\t              \"never a grant without its binding in one record\"))))))\n447\t\n448\t\n449\t;; =============================================================================\n450\t;; Evidence through a dao.stream.remote reflection\n451\t;; =============================================================================\n452\t\n453\t(defn- ring\n454\t  []\n455\t  (:dao.stream/handle\n456\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n457\t                         :dao.stream.ringbuffer/capacity 64})))\n458\t\n459\t\n460\t(defn- reflect\n461\t  \"Serve journal handle `h` under identity `arb` over a toy channel of\n462\t   two ring buffers and attach a reflection of it.  Answers the\n463\t   reflection and a serve function running one mirror step.\"\n464\t  [h]\n465\t  (let [ab (ring)\n466\t        ba (ring)\n467\t        cd {:dao.stream/type :dao.stream.test/channel\n468\t            :dao.stream/identity \"toy-channel\"}\n469\t        table {arb {:handle h :surface #{:reader}}}\n470\t        mirror (atom (oldest ab))\n471\t        attach! (remote/attacher\n472\t                  {:dao.stream.remote/channels {cd {:reader ba :writer ab}}})]\n473\t    {:reflection (:dao.stream/handle\n474\t                   (attach! {:dao.stream/type :dao.stream/remote\n475\t                             :dao.stream/identity arb\n476\t                             :dao.stream/channel cd}))\n477\t     :serve! #(swap! mirror (fn [c] (remote/mirror-step table ab c ba)))}))\n478\t\n479\t\n480\t(defn- ask\n481\t  \"Ask `f` of the reflection until it answers other than blocked or a\n482\t   retryable transport error, serving between asks.\"\n483\t  [serve! f]\n484\t  (loop [n 0]\n485\t    (let [r (f)]\n486\t      (if (and (< n 16)\n487\t               (or (= :dao.stream/blocked (outcome r))\n488\t                   (:dao.stream/retry? r)))\n489\t        (do (serve!) (recur (inc n)))\n490\t        r))))\n491\t\n492\t\n493\t(deftest evidence-survives-a-remote-reflection\n494\t  (let [[frames a] (offered)\n495\t        _ (stream/append! (grant/writer a) (a-grant))\n496\t        {:keys [reflection serve!]} (reflect (:journal a))\n497\t        author (:dao.stream/identity (stream/descriptor reflection))\n498\t        read (loop [c (:dao.stream/cursor\n499\t                        (ask serve! #(stream/cursor reflection\n500\t                                                    :dao.stream/oldest)))\n501\t                    acc []]\n502\t               (let [r (ask serve! #(stream/next reflection c))]\n503\t                 (if (= :dao.stream/ok (outcome r))\n504\t                   (recur (:dao.stream/cursor r)\n505\t                          (conj acc [author (:dao.stream/value r)]))\n506\t                   acc)))\n507\t        direct (custody/binding-evidence arb (attributed frames) \"lease-1\")]\n508\t    (is (= arb author) \"the reflection carries the authority's identity\")\n509\t    (is (= (records frames) (mapv second read)))\n510\t    (is (= direct (custody/binding-evidence arb read \"lease-1\")))\n511\t    (is (= direct (custody/binding-evidence\n512\t                    arb (cbor/decode (cbor/encode read)) \"lease-1\"))\n513\t        \"and the canonical codec after it\")\n514\t    (is (= :no-binding\n515\t           (::custody/no-evidence\n516\t             (custody/binding-evidence\n517\t               arb (mapv (fn [[_ r]] [\"mallory\" r]) read) \"lease-1\")))\n518\t        \"the same records attributed to another author prove nothing\")))\n519\t"}]},"parent_tool_use_id":null,"session_id":"e6ad7c4d-4e91-4daf-807a-5f71c598506b","uuid":"03d0425a-ceca-4425-8ec0-bc78ba127cba","timestamp":"2026-10-13T09:19:40.056Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7a/test/yin/vm/ucf/authority/grant_test.cljc","content":"(ns yin.vm.ucf.authority.grant-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.mem :as mem]\n            [dao.lease :as lease]\n            [dao.stream :as stream]\n            [dao.stream.journal :as journal]\n            [dao.stream.memory-log :as memory-log]\n            [dao.stream.remote :as remote]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [yin.vm.ucf.authority :as authority]\n            [yin.vm.ucf.authority.completion :as completion]\n            [yin.vm.ucf.authority.grant :as grant]\n            [yin.vm.ucf.checkpoint :as checkpoint]\n            [yin.vm.ucf.checkpoint-fixtures :as fx]\n            [yin.vm.ucf.custody :as custody]))\n\n\n(def ^:private arb \"arb-c5\")\n\n(def ^:private occ fx/occurrence)\n\n(def ^:private duration {:s 30})\n\n\n(defn- fresh-frames\n  \"A journal whose header names `arb`, so bodies can name the authority\n   before it opens.\"\n  []\n  (atom [(cbor/encode {:dao.stream.journal/header\n                       {:version 1 :identity arb}})]))\n\n\n(defn- auth\n  ([frames] (auth frames nil))\n  ([frames cut]\n   (::authority/authority\n     (authority/open! (journal/memory-backend frames cut)))))\n\n\n(defn- body\n  \"Fixture `n` naming this test's authority.\"\n  ([n] (body n identity))\n  ([n f]\n   (f (assoc (get fx/fixtures n)\n             :yin.k/arbitration {:dao.stream/identity arb\n                                 :dao.stream/descriptor\n                                 {:dao.stream/type :dao.stream/journal}}))))\n\n\n(defn- bytes-of\n  [b]\n  (let [bs (cbor/encode b)]\n    {:address (fx/segment-address bs) :bytes bs}))\n\n\n(defn- offer!\n  ([a store b] (offer! a store b \"carrier\"))\n  ([a store b medium]\n   (let [{:keys [address bytes]} (bytes-of b)]\n     (grant/offer! a store address bytes medium))))\n\n\n(defn- status\n  [r]\n  (:yin.k/status r))\n\n\n(defn- outcome\n  [r]\n  (:dao.stream/outcome r))\n\n\n(defn- records\n  \"Every transaction record of the journal's frames.\"\n  [frames]\n  (mapv #(:dao.stream.journal/value (cbor/decode %)) (rest @frames)))\n\n\n(defn- facts\n  \"The facts of kind `k` (custody or lease status) across the records.\"\n  [frames k]\n  (for [r (records frames)\n        :let [ds (get-in r [:dao.space/transaction :datoms])\n              es (set (keep (fn [[e a v]]\n                              (when (and (#{:yin.k/custody :dao.lease/status}\n                                          a)\n                                         (= k v))\n                                e))\n                            ds))]\n        e (sort es)]\n    (into {} (keep (fn [[e' a v]] (when (= e e') [a v]))) ds)))\n\n\n(defn- attributed\n  \"The journal's records, each attributed to the authority.\"\n  [frames]\n  (mapv (fn [r] [arb r]) (records frames)))\n\n\n(defn- a-grant\n  ([] (a-grant \"lease-1\" \"holder-a\"))\n  ([l h]\n   (lease/grant l (custody/subject occ) h duration\n                {:dao.lease/proposal \"p-1\"})))\n\n\n(defn- offered\n  \"A fresh authority with the first-park fixture offered: the frames,\n   the authority and the store.\"\n  []\n  (let [frames (fresh-frames)\n        a (auth frames)\n        store (mem/create-content-mem)]\n    (offer! a store (body \"first-park\"))\n    [frames a store]))\n\n\n(defn- succeeded\n  \"A fresh authority where the successor fixture's predecessor completed\n   into it under lease-7 (slice C8), and the successor is offered: the\n   frames, the authority and the store.\"\n  []\n  (let [frames (fresh-frames)\n        a (auth frames)\n        store (mem/create-content-mem)\n        w (grant/writer a)\n        {:keys [address bytes]} (bytes-of (body \"successor\"))]\n    (offer! a store (body \"first-park\"\n                          #(assoc % :yin.k/occurrence fx/predecessor)))\n    (stream/append! w (lease/grant \"lease-7\" (custody/subject fx/predecessor)\n                                   \"holder-p\" duration\n                                   {:dao.lease/proposal \"p-7\"}))\n    (completion/report! a \"holder-p\"\n                        (completion/resumed fx/predecessor \"lease-7\" address)\n                        bytes)\n    (stream/append! w (lease/lapsed \"lease-7\" :release))\n    (offer! a store (body \"successor\"))\n    [frames a store]))\n\n\n;; =============================================================================\n;; Offers\n;; =============================================================================\n\n(deftest an-offer-stores-the-body-then-records-its-baseline\n  (let [frames (fresh-frames)\n        a (auth frames)\n        store (mem/create-content-mem)\n        {:keys [address bytes]} (bytes-of (body \"first-park\"))]\n    (is (= {:yin.k/status :committed :yin.k/occurrence occ :dao.space/t 0}\n           (grant/offer! a store address bytes \"carrier\")))\n    (is (= (body \"first-park\") (jing/get store address ::absent))\n        \"the accepted body is in the content store\")\n    (is (= [(custody/offer occ address \"carrier\"\n                           (checkpoint/inspect address bytes))]\n           (facts frames :yin.k/offered))\n        \"the offer fact carries the inspector's baseline\")\n    (is (= {:yin.k/baseline (checkpoint/inspect address bytes)\n            :yin.k/variants #{address}\n            :yin.k/epoch 0\n            :dao.lease/lease nil}\n           (get-in (authority/projection a) [:occurrences occ])))))\n\n\n(deftest a-duplicate-offer-is-idempotent\n  (let [[frames a store] (offered)\n        before @frames]\n    (is (= {:yin.k/status :replayed :yin.k/occurrence occ}\n           (offer! a store (body \"first-park\"))))\n    (is (= {:yin.k/status :replayed :yin.k/occurrence occ}\n           (offer! a store (body \"first-park\") \"another-carrier\"))\n        \"by occurrence and snapshot address, whatever the carrier\")\n    (is (= {:yin.k/status :replayed :yin.k/occurrence occ}\n           (offer! (auth frames) store (body \"first-park\")))\n        \"after reopen too\")\n    (is (= before @frames) \"nothing was written\")))\n\n\n(deftest an-equal-baseline-variant-joins-its-occurrence\n  (let [[frames a store] (succeeded)\n        {:keys [address]} (bytes-of (body \"variant-equal\"))]\n    (is (= :committed (status (offer! a store (body \"variant-equal\")))))\n    (is (= 2 (count (filter #(= occ (:yin.k/occurrence %))\n                            (facts frames :yin.k/offered)))))\n    (is (contains? (get-in (authority/projection a)\n                           [:occurrences occ :yin.k/variants])\n                   address))\n    (is (some? (jing/get store address nil)))))\n\n\n(deftest a-conflicting-variant-is-refused\n  (doseq [[n reason] [[\"variant-different-intent\" :variant-conflict]\n                      [\"variant-counter\" :variant-conflict]]]\n    (testing n\n      (let [[frames a store] (succeeded)\n            before @frames\n            {:keys [address]} (bytes-of (body n))]\n        (is (= {:yin.k/status :refused :yin.k/reason reason\n                :yin.k/occurrence occ}\n               (offer! a store (body n))))\n        (is (= before @frames))\n        (is (nil? (jing/get store address nil))\n            \"a refused variant's body is not stored\")))))\n\n\n(deftest a-known-occurrence-with-another-origin-is-refused\n  (let [[frames a store] (offered)\n        before @frames\n        other (body \"successor\"\n                    #(assoc-in % [:yin.k/origin :dao.lease/lease] \"lease-9\"))]\n    (is (= {:yin.k/status :refused :yin.k/reason :occurrence-conflict\n            :yin.k/occurrence occ}\n           (offer! a store other)))\n    (is (= before @frames))))\n\n\n(deftest an-uninspectable-body-commits-nothing-and-stores-nothing\n  (doseq [[label address bs]\n          (let [{:keys [address bytes]} (bytes-of (body \"successor\"))\n                v2 (bytes-of (body \"version-2\"))]\n            [[\"undecodable version\" (:address v2) (:bytes v2)]\n             [\"hash mismatch\" (fx/segment-address (cbor/encode :x)) bytes]\n             [\"not bytes\" address :x]])]\n    (testing label\n      (let [frames (fresh-frames)\n            a (auth frames)\n            store (mem/create-content-mem)\n            r (grant/offer! a store address bs \"carrier\")]\n        (is (= :refused (status r)))\n        (is (= :uninspectable (:yin.k/reason r)))\n        (is (contains? #{:yin.k/undecodable :yin.k/profile-mismatch\n                         :yin.k/hash-mismatch}\n                       (get-in r [:yin.k/inspection :yin.k/status])))\n        (is (= 1 (count @frames)) \"only the header\")\n        (is (empty? (mem/entry-bytes store)))))))\n\n\n(deftest offers-the-authority-cannot-hold-are-refused\n  (doseq [[label b reason]\n          [[\"a halted root\" (get fx/fixtures \"halted-root\") :not-offerable]\n           [\"another authority\" (get fx/fixtures \"successor\")\n            :foreign-arbitration]\n           [\"an occurrence outside the form: the inspector refuses it\"\n            (body \"successor\" #(assoc % :yin.k/occurrence \"O\"))\n            :uninspectable]]]\n    (testing label\n      (let [frames (fresh-frames)\n            store (mem/create-content-mem)\n            r (offer! (auth frames) store b)]\n        (is (= :refused (status r)))\n        (is (= reason (:yin.k/reason r)))\n        (is (= 1 (count @frames)))\n        (is (empty? (mem/entry-bytes store)))))))\n\n\n(deftest an-unwritable-store-suspends-the-offer\n  (let [frames (fresh-frames)\n        a (auth frames)\n        store {:put-bytes-fn (fn [_ _] (throw (ex-info \"disk full\" {})))\n               :get-bytes-fn (fn [_ nf] nf)}]\n    (is (= {:yin.k/status :suspended :yin.k/reason :content-unavailable}\n           (offer! a store (body \"first-park\"))))\n    (is (= 1 (count @frames)) \"the ledger never references missing content\")\n    (is (some? (authority/projection a)) \"nothing was poisoned\")))\n\n\n;; =============================================================================\n;; Grant and binding\n;; =============================================================================\n\n(deftest a-grant-and-its-binding-commit-in-one-transaction\n  (let [[frames a] (offered)\n        w (grant/writer a)]\n    (is (= {:dao.stream/outcome :dao.stream/ok}\n           (stream/append! w (a-grant)))\n        \"the judge's writer sees a plain stream outcome\")\n    (let [[r] (drop 1 (records frames))\n          ds (get-in r [:dao.space/transaction :datoms])]\n      (is (= [(a-grant) (custody/bound occ \"lease-1\" \"holder-a\" 0)]\n             [(first (facts frames :dao.lease/accepted))\n              (first (facts frames :yin.k/bound))]))\n      (is (= #{:dao.lease/accepted :yin.k/bound}\n             (set (keep (fn [[_ a v]]\n                          (when (#{:yin.k/custody :dao.lease/status} a) v))\n                        ds)))\n          \"one record holds both\"))\n    (is (= {:yin.k/transaction {:yin.k/arbitration arb :dao.space/t 1}\n            :yin.k/occurrence occ\n            :dao.lease/lease \"lease-1\"\n            :dao.lease/holder \"holder-a\"\n            :yin.k/epoch 0}\n           (custody/binding-evidence arb (attributed frames) \"lease-1\"))\n        \"the first grant binds epoch 0\")))\n\n\n(deftest the-writer-refuses-what-it-cannot-record\n  (let [[frames a] (offered)\n        w (grant/writer a)]\n    (is (= :dao.stream/ok (outcome (stream/append! w (a-grant)))))\n    (let [before @frames]\n      (is (= {:dao.stream/outcome :dao.stream/invalid-value}\n             (stream/append! w (a-grant \"lease-2\" \"holder-b\")))\n          \"one live lease per occurrence\")\n      (is (= {:dao.stream/outcome :dao.stream/invalid-value}\n             (stream/append! w (assoc (a-grant \"lease-3\" \"holder-b\")\n                                      :dao.lease/subject\n                                      (custody/subject\n                                        fx/predecessor))))\n          \"an occurrence never offered\")\n      (is (= {:dao.stream/outcome :dao.stream/invalid-value}\n             (stream/append! w (lease/lapsed \"lease-9\" :policy)))\n          \"a lapse of a lease never granted\")\n      (is (= {:dao.stream/outcome :dao.stream/invalid-value}\n             (stream/append! w (lease/refusal \"p-2\")))\n          \"a refusal that names no proposer\")\n      (is (= {:dao.stream/outcome :dao.stream/invalid-value}\n             (stream/append! w (assoc (a-grant \"lease-4\" \"holder-b\")\n                                      :yin.k/extra 1)))\n          \"an attribute outside the published order\")\n      (is (= {:dao.stream/outcome :dao.stream/ok}\n             (stream/append! w (a-grant)))\n          \"the recorded grant again is a replay\")\n      (is (= before @frames) \"nothing more was written\"))\n    (authority/close! a)\n    (is (= {:dao.stream/outcome :dao.stream/transport-error}\n           (stream/append! w (a-grant \"lease-5\" \"holder-b\"))))))\n\n\n(defn- concurrently\n  [thunks]\n  #?(:cljd (mapv #(%) thunks)\n     :clj (mapv deref (mapv #(future (%)) thunks))\n     :cljs (mapv #(%) thunks)))\n\n\n(deftest two-grants-race-for-one-occurrence\n  (let [[frames a] (offered)\n        w (grant/writer a)\n        rs (concurrently\n             (mapv (fn [n]\n                     #(stream/append! w (a-grant (str \"lease-\" n)\n                                                 (str \"holder-\" n))))\n                   (range 8)))]\n    (is (= {:dao.stream/ok 1 :dao.stream/invalid-value 7}\n           (frequencies (map outcome rs))))\n    (is (= 1 (count (facts frames :dao.lease/accepted))))\n    (is (= 1 (count (facts frames :yin.k/bound))))))\n\n\n;; =============================================================================\n;; The judge\n;; =============================================================================\n\n(defn- log\n  [& vs]\n  (let [h (:dao.stream/handle\n            (memory-log/create! {:dao.stream/type :dao.stream/memory-log}))]\n    (doseq [v vs] (stream/append! h v))\n    h))\n\n\n(defn- oldest\n  [h]\n  (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n\n\n(defn- judge\n  [a & proposers]\n  (reduce (fn [j [who h]] (lease/wire-facts j h (oldest h) who))\n          (let [ticks (log (lease/tick {:s 1}))]\n            (lease/wire-tick\n              (lease/initial-judge\n                (merge (grant/judge-config a duration)\n                       {:resolver (fn [source _] source) :self arb}))\n              ticks (oldest ticks) :ticks))\n          proposers))\n\n\n(deftest two-candidates-one-grant\n  (let [[frames a] (offered)\n        propose #(log (lease/proposal % (custody/subject occ)))\n        j (judge a [\"holder-a\" (propose \"p-a\")] [\"holder-b\" (propose \"p-b\")])\n        j1 (grant/step! a j)\n        [g] (facts frames :dao.lease/accepted)]\n    (is (nil? (:abort j1)))\n    (is (= 1 (count (facts frames :dao.lease/accepted))) \"exactly one grant\")\n    (is (= \"holder-a\" (:dao.lease/holder g)))\n    (is (= \"p-a\" (:dao.lease/proposal g)))\n    (is (= duration (:dao.lease/duration g)))\n    (is (= [(:dao.lease/lease g)] (keys (:ledger j1)))\n        \"the judge seeded the one lease the ledger recorded\")\n    (is (= 0 (:yin.k/epoch (custody/binding-evidence\n                             arb (attributed frames) (:dao.lease/lease g)))))\n    (grant/step! a j1)\n    (is (= 1 (count (facts frames :dao.lease/accepted)))\n        \"a later pass grants nothing more\")))\n\n\n(deftest the-reclaim-callback-is-a-readiness-check\n  (let [[frames a] (offered)\n        ready? (:reclaim (grant/judge-config a duration))\n        before @frames]\n    (is (true? (ready? (custody/subject occ))))\n    (is (= before @frames) \"it revokes nothing\")\n    (authority/close! a)\n    (is (false? (ready? (custody/subject occ))))))\n\n\n(deftest a-judge-config-needs-a-valid-duration\n  (let [[_ a] (offered)]\n    (is (thrown? #?(:cljd Object :clj Throwable :cljs :default)\n          (grant/judge-config a {:s 0})))))\n\n\n;; =============================================================================\n;; Crash cuts on the grant transition\n;; =============================================================================\n\n(deftest crash-at-each-cut-commits-the-grant-zero-or-one-times\n  (doseq [[cut persisted] [[:before-frame 0]\n                           [:after-frame-before-visible 1]\n                           [:torn-frame 0]]]\n    (testing (name cut)\n      (let [[frames a] (offered)\n            _ (authority/close! a)\n            a (auth frames cut)\n            w (grant/writer a)]\n        (is (= {:dao.stream/outcome :dao.stream/transport-error}\n               (stream/append! w (a-grant))))\n        (is (= {:dao.stream/outcome :dao.stream/transport-error}\n               (stream/append! w (a-grant)))\n            \"a poisoned authority grants nothing\")\n        (let [a2 (auth frames)\n              w2 (grant/writer a2)]\n          (is (= persisted (count (facts frames :dao.lease/accepted)))\n              \"reopen shows zero or one grant\")\n          (is (= persisted (count (facts frames :yin.k/bound))))\n          (is (= {:dao.stream/outcome :dao.stream/ok}\n                 (stream/append! w2 (a-grant)))\n              \"a retry after reopen finds the grant or commits it\")\n          (is (= 1 (count (facts frames :dao.lease/accepted))))\n          (is (= 0 (:yin.k/epoch (custody/binding-evidence\n                                   arb (attributed frames) \"lease-1\")))\n              \"never a grant without its binding in one record\"))))))\n\n\n;; =============================================================================\n;; Evidence through a dao.stream.remote reflection\n;; =============================================================================\n\n(defn- ring\n  []\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n                         :dao.stream.ringbuffer/capacity 64})))\n\n\n(defn- reflect\n  \"Serve journal handle `h` under identity `arb` over a toy channel of\n   two ring buffers and attach a reflection of it.  Answers the\n   reflection and a serve function running one mirror step.\"\n  [h]\n  (let [ab (ring)\n        ba (ring)\n        cd {:dao.stream/type :dao.stream.test/channel\n            :dao.stream/identity \"toy-channel\"}\n        table {arb {:handle h :surface #{:reader}}}\n        mirror (atom (oldest ab))\n        attach! (remote/attacher\n                  {:dao.stream.remote/channels {cd {:reader ba :writer ab}}})]\n    {:reflection (:dao.stream/handle\n                   (attach! {:dao.stream/type :dao.stream/remote\n                             :dao.stream/identity arb\n                             :dao.stream/channel cd}))\n     :serve! #(swap! mirror (fn [c] (remote/mirror-step table ab c ba)))}))\n\n\n(defn- ask\n  \"Ask `f` of the reflection until it answers other than blocked or a\n   retryable transport error, serving between asks.\"\n  [serve! f]\n  (loop [n 0]\n    (let [r (f)]\n      (if (and (< n 16)\n               (or (= :dao.stream/blocked (outcome r))\n                   (:dao.stream/retry? r)))\n        (do (serve!) (recur (inc n)))\n        r))))\n\n\n(deftest evidence-survives-a-remote-reflection\n  (let [[frames a] (offered)\n        _ (stream/append! (grant/writer a) (a-grant))\n        {:keys [reflection serve!]} (reflect (:journal a))\n        author (:dao.stream/identity (stream/descriptor reflection))\n        read (loop [c (:dao.stream/cursor\n                        (ask serve! #(stream/cursor reflection\n                                                    :dao.stream/oldest)))\n                    acc []]\n               (let [r (ask serve! #(stream/next reflection c))]\n                 (if (= :dao.stream/ok (outcome r))\n                   (recur (:dao.stream/cursor r)\n                          (conj acc [author (:dao.stream/value r)]))\n                   acc)))\n        direct (custody/binding-evidence arb (attributed frames) \"lease-1\")]\n    (is (= arb author) \"the reflection carries the authority's identity\")\n    (is (= (records frames) (mapv second read)))\n    (is (= direct (custody/binding-evidence arb read \"lease-1\")))\n    (is (= direct (custody/binding-evidence\n                    arb (cbor/decode (cbor/encode read)) \"lease-1\"))\n        \"and the canonical codec after it\")\n    (is (= :no-binding\n           (::custody/no-evidence\n             (custody/binding-evidence\n               arb (mapv (fn [[_ r]] [\"mallory\" r]) read) \"lease-1\")))\n        \"the same records attributed to another author prove nothing\")))\n","numLines":519,"startLine":1,"totalLines":519}},"tool_result_meta":[{"id":"toolu_01MbLtSeuJpZVTEGmGBRV3rR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
