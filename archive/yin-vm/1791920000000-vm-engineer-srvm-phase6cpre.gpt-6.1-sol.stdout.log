l-id call-id,\n     :error {:dao.stream.apply/code ::response-lost,\n             :dao.stream.apply/message\n             (if gap?\n               \"FFI response stream lost values to a gap before this call was answered\"\n               \"FFI response stream ended before this call was answered\"),\n             ::loss (if gap? :dao.stream/gap :dao.stream/end)}}))\n\n\n(defn throw-response-lost!\n  \"Raise `response-lost` as `call-result` raises an apply error.\"\n  [call-id status]\n  (let [data (response-lost call-id status)]\n    (throw (ex-info (str \"FFI call failed: \"\n                         (get-in data [:error :dao.stream.apply/message]))\n                    data))))\n\n\n(defn call-response-wait-entry\n  \"The polling wait entry for a sent call awaiting its correlated response.\"\n  [call-id next-k env]\n  {:k {:type :dao.stream.apply/eval-call,\n       :next next-k,\n       :env env,\n       :call-id call-id},\n   :env env,\n   :cursor-ref {:type :cursor-ref, :id vm/call-out-cursor-key},\n   :reason :next,\n   :stream-id vm/call-out-stream-key})\n\n\n(defn response-wait-entry\n  \"The polling wait entry for a sent call awaiting its correlated response,\n   for an arbitrary register payload (`yin.vm.engine.md` section 7, edit 3).\ntest/yin/vm/debruijn/stack_effects_test.cljc:140:        {:type :stream/next,\ntest/yin/vm/debruijn/stack_effects_test.cljc:443:        segment [[:load-free 'stream/next!]  ; 0: f\ntest/yin/vm/debruijn/stack_effects_test.cljc:564:      (next [_ cursor] (stream/next delegate cursor))\nsrc/cljc/yin/vm/engine.cljc:609:  (let [cursor-id (check-ref! state :stream/next :cursor-ref cursor-ref)\nsrc/cljc/yin/vm/engine.cljc:623:  \"Apply half of `:stream/next`: a read outcome `result` to the effect's\nsrc/cljc/yin/vm/engine.cljc:653:  \"Handle :stream/next. Total over the eight read outcomes, once the\nsrc/cljc/yin/vm/engine.cljc:680:                          (stream/next (:handle target) (:cursor target))))))\nsrc/cljc/yin/vm/engine.cljc:1546:                                        (stream/next reader (:cursor entry)))]\nsrc/cljc/yin/vm/engine.cljc:1768:    (let [r (stream/next handle cursor)\nsrc/cljc/yin/vm/engine.cljc:2350:(defn check-callee-effect!\nsrc/cljc/yin/vm/engine.cljc:2567:   park-entry-fns maps :stream/put and :stream/next to functions that build\nsrc/cljc/yin/vm/engine.cljc:2621:          :stream/next\nsrc/cljc/yin/vm/engine.cljc:2634:                                (get park-entry-fns :stream/next))\n                   :images (:images base)})))\n\n\n(defn- check-format!\n  \"Refuse `entry` unless it is this model's payload for a row of the offset\n   table (r6).\"\n  [base entry]\n  (when-not (and (= format-tag (:format entry))\n                 (some #(= (:image entry) (nth % 0)) (:images base)))\n    (refuse-continuation! base entry)))\n\n\n(defn- write-back\n  \"Write `entry`'s registers back and deliver `val` via `:write-result` or\n   `:return-result`. Registers only: `:segment` is kernel state.\"\n  [base entry val]\n  (if (= :return-result (:resume-mode entry))\n    (return-transition (assoc base\n                              :pc (:pc entry)\n                              :frames (:frames entry)\n                              :continuation (:continuation entry)\n                              :store-of (:store-of entry)\n                              :halted? false)\n                       val)\n    (let [pc (:pc entry)\n          body (body-of-pc (:segment base) pc)\n          reg-count (:registers body)\n          dest (:dest entry)\n          restored-regs\n          (reduce (fn [acc [r v]] (assoc acc r v))\n                  (vec (repeat reg-count nil))\n                  (:regs entry))\n          final-regs (if (some? dest)\n                       (assoc restored-regs dest val)\n                       restored-regs)]\n      (assoc base\n             :pc pc\n             :frames (:frames entry)\n             :registers final-regs\n             :continuation (:continuation entry)\n             :store-of (:store-of entry)\n             :value val\n             :halted? false))))\n\n\n(defn register-restore\n","exit_code":0,"status":"completed"}}
