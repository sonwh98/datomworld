\n86\t+\n87\t+\n88\t+(def lanes [:semantic-register :stack :register])\n89\t+\n90\t+\n91\t+(defn- composition\n92\t+  [opts]\n93\t+  (merge {:make-stream tu/make-stream :capability-secret tu/secret\n94\t+          :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n95\t+          :modules stream-modules}\n96\t+         opts))\n97\t+\n98\t+\n99\t+(defn- kernel-opts\n100\t+  \"A de Bruijn kernel's options for the same composition: the full\n101\t+   primitive table, and the initial environment as :free-env.\"\n102\t+  [opts]\n103\t+  (cond-> (assoc (dissoc (composition opts) :env) :primitives vm/primitives)\n104\t+    (contains? opts :env) (assoc :free-env (:env opts))))\n105\t+\n106\t+\n107\t (defn machine\n108\t   ([] (machine {}))\n109\t   ([opts]\n110\t-   (sr/create-vm (merge {:make-stream tu/make-stream :capability-secret tu/secret\n111\t-                         :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n112\t-                         :modules stream-modules}\n113\t-                        opts))))\n114\t+   (case *lane*\n115\t+     :semantic-register (sr/create-vm (composition opts))\n116\t+     :stack (dvm/create-vm [] (kernel-opts opts))\n117\t+     :register (rvm/create-vm (assoc {} :bodies [] :instructions []) (kernel-opts opts)))))\n118\t+\n119\t+\n120\t+(defn lane-of\n121\t+  [m]\n122\t+  (let [f (:format (module/link-format m))]\n123\t+    (cond (= dvm/format-tag f) :stack\n124\t+          (= rvm/format-tag f) :register\n125\t+          :else :semantic-register)))\n126\t+\n127\t+\n128\t+(def segment-of\n129\t+  \"layout/segment, once per A.\"\n130\t+  (memoize layout/segment))\n131\t+\n132\t+\n133\t+(defn kernel-space\n134\t+  \"The layout space of the A vectors whose images de Bruijn kernel k\n135\t+   holds, among those this world projected (`scoped`), or the file ever\n136\t+   projected (`file-wide`). Unbound, it throws: an independent world's\n137\t+   lookups never read another fixture's vectors.\"\n138\t+  [k]\n139\t+  (when-not *projected*\n140\t+    (throw (ex-info \"kernel-space outside scoped or file-wide\" {})))\n141\t+  (let [id (if (= :stack (lane-of k)) :stack-id :register-id)\n142\t+        held (into #{} (map first) (:images k))]\n143\t+    (layout/space (filter #(contains? held (id %)) (map segment-of (vals @*projected*))))))\n144\t+\n145\t+\n146\t+(defn- kernel-load\n147\t+  \"Attach v's derived image and start it at its row, beside whatever the\n148\t+   kernel already holds: parked records keep naming their own rows.\"\n149\t+  [k v]\n150\t+  (let [kind (lane-of k)\n151\t+        sg (segment-of v)\n152\t+        k (if (= :stack kind)\n153\t+            (dvm/attach-image k (:stack sg) vm/stack-contract)\n154\t+            (rvm/attach-image k (:register sg) vm/register-contract))\n155\t+        k (assoc k :pc (layout/offset kind k sg) :frames [] :continuation [] :store-of nil\n156\t+                 :halted? false :blocked? false :value nil)]\n157\t+    (if (= :stack kind)\n158\t+      (assoc k :stack [])\n159\t+      (assoc k :registers (vec (repeat (:registers (first (:bodies (:register sg)))) nil))))))\n160\t \n161\t \n162\t (defn load-program\n163\t   [m ast]\n164\t-  (sr/load-vector m (project ast) code/contract))\n165\t+  (if (= :semantic-register (lane-of m))\n166\t+    (sr/load-vector m (project ast) code/contract)\n167\t+    (kernel-load m (project ast))))\n168\t+\n169\t+\n170\t+(defn lane-closure\n171\t+  \"Canonical closure payload c, its :segment an A, as machine m's value.\"\n172\t+  [m c]\n173\t+  (if (= :semantic-register (lane-of m))\n174\t+    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))\n175\t+    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))\n176\t \n177\t \n178\t (defn lift-opts\n179\t@@ -301,16 +420,17 @@\n180\t    else reaches, named by a module closure in the task store.\"\n181\t   [wrap]\n182\t   (let [ring (s/ring 4)\n183\t-        m (vm/run (load-program (machine) (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))))\n184\t+        ast (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))\n185\t+        v (project ast)\n186\t+        m (vm/run (load-program (machine) ast))\n187\t         cursor (fn [m]\n188\t                  (let [[ref m] (engine/attach-resource m ring) [id m] (engine/gensym m \"cursor\")]\n189\t                    (engine/handle-cursor m {:stream ref} id)))\n190\t         [c1 m] (cursor m)\n191\t         [c2 m] (cursor m)\n192\t-        [seg image] (first (:code m))\n193\t-        closure (first (filter #(= :closure (first %)) (:vector image)))\n194\t-        clo (values/closure (:owner m) {:type :closure :params (nth closure 2) :entry (nth closure 3)\n195\t-                                        :segment seg :env {engine/store-of-key 'host.mod}})]\n196\t+        closure (first (filter #(= :closure (first %)) v))\n197\t+        clo (lane-closure m {:type :closure :params (nth closure 2) :entry (nth closure 3)\n198\t+                             :segment (jing/segment-key v) :env {engine/store-of-key 'host.mod}})]\n199\t     (parking (assoc m :store {'mod clo} :module-stores {'host.mod {'c c1 'd c2}}))))\n200\t \n201\t \n202\t@@ -1290,3 +1410,521 @@\n203\t       (is (= (count (stream-identities wire)) n))\n204\t       (is (zero? none) \"refused before any attachment\")\n205\t       (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])])))))\n206\t+\n207\t+\n208\t+;; =============================================================================\n209\t+;; Phase 6c: the cross-engine lanes (§5.3, §5.4 laws 4 and 5, §8.3 10-12)\n210\t+;; =============================================================================\n211\t+\n212\t+(def link-rows\n213\t+  \"Rows the de Bruijn lanes do not carry (§5.3, the shared fragment): a\n214\t+   de Bruijn kernel links a native image while module responses carry A,\n215\t+   and §4 defines no layout for install children (canonical-task refuses\n216\t+   :installs). The reference lane runs the whole matrix; these lanes are\n217\t+   removed with their kernels at phase 8.\"\n218\t+  #{7 8 9 10 11 12 17})\n219\t+\n220\t+\n221\t+(def lane-rows\n222\t+  \"The wrapped rows every lane executes: 15 of §5.2's 22.\"\n223\t+  (filterv #(not (contains? link-rows (first %))) rows))\n224\t+\n225\t+\n226\t+(defn lane-cases\n227\t+  \"§5.3's shared fragment: 15 lane rows x 4 segments, plus row 20 once:\n228\t+   [row segment expected build].\"\n229\t+  []\n230\t+  (filterv #(not (contains? link-rows (first %))) (matrix-cases)))\n231\t+\n232\t+\n233\t+(defn on-lane\n234\t+  [lane build]\n235\t+  (binding [*lane* lane] (build)))\n236\t+\n237\t+\n238\t+(defn lane-lift\n239\t+  \"The lift of §7.1 on m's own lane.\"\n240\t+  [m serve!]\n241\t+  (if (= :semantic-register (lane-of m))\n242\t+    (rows/lift-task m serve! (lift-opts))\n243\t+    (layout/lift-task m (kernel-space m) (on-lane :semantic-register machine) serve! (lift-opts))))\n244\t+\n245\t+\n246\t+(defn lane-lower\n247\t+  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n248\t+  [lane opts wire attach!]\n249\t+  (let [scratch (on-lane :semantic-register #(machine opts))]\n250\t+    (if (= :semantic-register lane)\n251\t+      (rows/lower-task scratch wire attach!)\n252\t+      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n253\t+\n254\t+\n255\t+(defn injective\n256\t+  \"names, refusing when two identities share a logical name (§5.5).\"\n257\t+  [names]\n258\t+  (when-not (= (count names) (count (distinct (vals names))))\n259\t+    (throw (ex-info \"The correspondence is not injective\" {:law-4 :injective :names names})))\n260\t+  names)\n261\t+\n262\t+\n263\t+(defn logical-names\n264\t+  \"§5.5's explicit correspondence: each served identity to the resource\n265\t+   key the lifted machine holds that handle under. The fixture builds the\n266\t+   same program on every lane, so one key names one logical stream.\"\n267\t+  [m peer]\n268\t+  (injective\n269\t+    (into {} (map (fn [[id e]]\n270\t+                    [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n271\t+                            (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n272\t+          @(:table peer))))\n273\t+\n274\t+\n275\t+(defn ring-names\n276\t+  \"{stream identity -> resource key} over every stream m holds.\"\n277\t+  [m]\n278\t+  (injective\n279\t+    (into {} (keep (fn [[k h]]\n280\t+                     (when (satisfies? stream/IDaoStreamDescriptor h)\n281\t+                       [(:dao.stream/identity (stream/descriptor h)) k])))\n282\t+          (:resources m))))\n283\t+\n284\t+\n285\t+(defn logical-positions\n286\t+  \"The task with each cursor position's embedded stream identity renamed\n287\t+   to its logical name. A ring buffer cursor carries its stream's\n288\t+   identity, which §5.5's marker substitution does not reach, so the\n289\t+   cross-lane comparison renames only that field, under the same fixture\n290\t+   correspondence; every other field, the offset included, is kept.\"\n291\t+  [task m]\n292\t+  (let [names (ring-names m)\n293\t+        k :dao.stream.ringbuffer/identity]\n294\t+    (replace-nodes task #(= :cursor-cell-body (:kind %))\n295\t+                   (fn [n]\n296\t+                     (update-in n [:slots 1]\n297\t+                                (fn [p]\n298\t+                                  (if (and (map? p) (contains? names (get p k)))\n299\t+                                    (assoc p k (get names (get p k)))\n300\t+                                    p)))))))\n301\t+\n302\t+\n303\t+(defn rename-identities\n304\t+  \"x with every :dao.stream/identity value that names maps renamed.\"\n305\t+  [x names]\n306\t+  (cond\n307\t+    (map? x) (into {} (map (fn [[k v]]\n308\t+                             [k (if (and (= :dao.stream/identity k) (contains? names v))\n309\t+                                  (get names v)\n310\t+                                  (rename-identities v names))]))\n311\t+                   x)\n312\t+    (vector? x) (mapv #(rename-identities % names) x)\n313\t+    :else x))\n314\t+\n315\t+\n316\t+(defn logical-descriptors\n317\t+  \"§5.5: {logical name -> stream descriptor, identities renamed} over every\n318\t+   stream m holds. canonical-under erases a marker's descriptor, so the\n319\t+   lanes' descriptors are shown equivalent on these, separately.\"\n320\t+  [m]\n321\t+  (let [names (ring-names m)]\n322\t+    (into {} (keep (fn [[k h]]\n323\t+                     (when (satisfies? stream/IDaoStreamDescriptor h)\n324\t+                       [k (rename-identities (stream/descriptor h) names)])))\n325\t+          (:resources m))))\n326\t+\n327\t+\n328\t+(defn descriptors-equivalent?\n329\t+  \"Each lane's logical-descriptors, one per lane: equal maps.\"\n330\t+  [ds]\n331\t+  (apply = ds))\n332\t+\n333\t+\n334\t+(defn identities-in\n335\t+  \"The members of ids anywhere in x.\"\n336\t+  [x ids]\n337\t+  (cond\n338\t+    (contains? ids x) #{x}\n339\t+    (map? x) (into #{} (mapcat #(identities-in % ids)) (concat (keys x) (vals x)))\n340\t+    (coll? x) (into #{} (mapcat #(identities-in % ids)) x)\n341\t+    :else #{}))\n342\t+\n343\t+\n344\t+(defn task-root\n345\t+  \"§5.5 over decoded task: positions renamed, re-emitted, then\n346\t+   canonical-under the served correspondence; no lane identity survives.\"\n347\t+  [task m peer]\n348\t+  (let [names (logical-names m peer)\n349\t+        canonical (rows/canonical-under (rows/emit (logical-positions task m)) names)]\n350\t+    (is (empty? (identities-in (:yin.k/rows canonical) (into (set (keys names)) (keys (ring-names m)))))\n351\t+        \"every lane identity was renamed\")\n352\t+    (:yin.k/root canonical)))\n353\t+\n354\t+\n355\t+(defn logical-root\n356\t+  \"§5.5: the lift's root id with every lane identity replaced by the\n357\t+   fixture's logical name.\"\n358\t+  [wire m peer]\n359\t+  (task-root (rows/decode wire) m peer))\n360\t+\n361\t+\n362\t+(defn lane-root\n363\t+  \"Build on lane, lift: {:root under the logical names, :reference the\n364\t+   lane's own run, :lane the kernel the world ran on, :descriptors, and\n365\t+   :task :machine :peer for the controls}. A world's :served replaces\n366\t+   `served`.\"\n367\t+  [lane build]\n368\t+  (scoped\n369\t+    (fn []\n370\t+      (let [world (on-lane lane build)\n371\t+            m (:machine world)\n372\t+            {:keys [serve! peer]} ((or (:served world) served) (or (:surfaces world) #{:reader}))\n373\t+            task (rows/decode (lane-lift m serve!))]\n374\t+        (is (nil? (rows/validate-frames task)) \"law 6 on every lane\")\n375\t+        {:root (task-root task m peer)\n376\t+         :reference (reference (on-lane lane build))\n377\t+         :lane (lane-of m) :descriptors (logical-descriptors m)\n378\t+         :task task :machine m :peer peer}))))\n379\t+\n380\t+\n381\t+(defn canonical-equality\n382\t+  \"Law 4 for one case: exactly the three distinct kernel lanes lift to one\n383\t+   root, their streams' descriptors are equivalent under the\n384\t+   correspondence (else it throws, :law-4 :descriptors), and each lane's\n385\t+   own run answers the reference.\"\n386\t+  [build expected]\n387\t+  (let [roots (mapv #(lane-root % build) lanes)]\n388\t+    (is (= 3 (count roots)))\n389\t+    (is (= [:semantic-register :stack :register] (mapv :lane roots)) \"three distinct kernel lanes\")\n390\t+    (is (apply = (map :root roots)) \"law 4: one root id on every lane\")\n391\t+    (when-not (descriptors-equivalent? (mapv :descriptors roots))\n392\t+      (throw (ex-info \"The descriptors differ under the correspondence\"\n393\t+                      {:law-4 :descriptors :descriptors (mapv :descriptors roots)})))\n394\t+    (doseq [{:keys [lane reference]} roots]\n395\t+      (is (:halted reference) (str lane \" completes\"))\n396\t+      (when (some? expected) (is (= expected (:value reference)) (str lane \" answers the reference\"))))\n397\t+    roots))\n398\t+\n399\t+\n400\t+(defn control-root\n401\t+  \"A lane's root with its decoded task changed by f first.\"\n402\t+  [{:keys [task machine peer]} f]\n403\t+  (let [task' (f task)]\n404\t+    (is (not= task task') \"the control changed the task\")\n405\t+    (task-root task' machine peer)))\n406\t+\n407\t+\n408\t+(defn first-binding\n409\t+  \"Pairs node n with the value of its first pair whose key satisfies pred\n410\t+   replaced by v.\"\n411\t+  [n pred v]\n412\t+  (let [ps (pairs-of n)\n413\t+        i (first (keep-indexed (fn [i [k _]] (when (pred k) i)) ps))]\n414\t+    (if i (rows/node (:kind n) (mapcat identity (assoc-in ps [i 1] v))) n)))\n415\t+\n416\t+\n417\t+(deftest law-4-controls\n418\t+  ;; §5.5 (D1): a changed position offset, descriptor field, saved value or\n419\t+  ;; lexical value changes what law 4 compares\n420\t+  (let [roots (canonical-equality #(bare 1) [\"A\" \"B\"])\n421\t+        [sr stack-lane register-lane] roots\n422\t+        base (:root sr)]\n423\t+    (testing \"the three lanes agree\"\n424\t+      (is (= base (:root stack-lane) (:root register-lane))))\n425\t+    (testing \"a cursor position's offset\"\n426\t+      (is (not= base (control-root stack-lane\n427\t+                                   (fn [t]\n428\t+                                     (replace-nodes t #(= :cursor-cell-body (:kind %))\n429\t+                                                    (fn [n] (update-in n [:slots 1 :dao.stream.ringbuffer/position] inc))))))))\n430\t+    (testing \"a stream only the register lane holds: one root, the descriptors differ\"\n431\t+      (let [build #(cond-> (bare 1)\n432\t+                     (= :register *lane*) (update-in [:machine :resources] assoc :control/extra (s/ring 4)))\n433\t+            d (error #(canonical-equality build [\"A\" \"B\"]))]\n434\t+        (is (= :descriptors (:law-4 d)) (pr-str d))\n435\t+        (is (= [false false true] (mapv (fn [ds] (contains? ds :control/extra)) (:descriptors d))))))\n436\t+    (testing \"two served identities under one logical name\"\n437\t+      (let [twin (fn [surfaces]\n438\t+                   (let [{:keys [peer] :as sv} (served surfaces)]\n439\t+                     (update sv :serve!\n440\t+                             (fn [serve!]\n441\t+                               (fn [h]\n442\t+                                 (let [r (serve! h)\n443\t+                                       id (:dao.stream/identity r)]\n444\t+                                   (swap! (:table peer) assoc (str id \"-twin\") (get @(:table peer) id))\n445\t+                                   r))))))\n446\t+            build #(cond-> (bare 1) (= :stack *lane*) (assoc :served twin))\n447\t+            d (error #(canonical-equality build [\"A\" \"B\"]))]\n448\t+        (is (= :injective (:law-4 d)) (pr-str d))\n449\t+        (is (< (count (distinct (vals (:names d)))) (count (:names d))))))\n450\t+    (testing \"a saved window value\"\n451\t+      (is (not= base (control-root register-lane\n452\t+                                   (fn [t]\n453\t+                                     (replace-nodes t #(= :window (:kind %))\n454\t+                                                    (fn [n] (first-binding n some? [:lit :control]))))))))\n455\t+    (testing \"a lexical value\"\n456\t+      (is (not= base (control-root sr\n457\t+                                   (fn [t]\n458\t+                                     (replace-nodes t #(= :env (:kind %))\n459\t+                                                    (fn [n] (update-in n [:slots 0] first-binding #{'a} [:lit :control]))))))))))\n460\t+\n461\t+\n462\t+(deftest cross-engine-canonical-equality-bare\n463\t+  ;; the quick-tier slice of acceptance 10: every lane row once, bare;\n464\t+  ;; §5.3's shared fragment, 16 cases over three distinct kernel lanes\n465\t+  (let [n (atom 0)]\n466\t+    (doseq [[row r build] lane-rows]\n467\t+      (testing (str \"row \" row)\n468\t+        (canonical-equality #(build identity) r)\n469\t+        (swap! n inc)))\n470\t+    (testing \"row 20\"\n471\t+      (canonical-equality tail-effect-halt \"B\")\n472\t+      (swap! n inc))\n473\t+    (is (= 16 @n))))\n474\t+\n475\t+\n476\t+(deftest ^:slow cross-engine-canonical-equality\n477\t+  ;; acceptance 10: law 4 over §5.3's shared fragment, 61 cases, each over\n478\t+  ;; exactly three distinct kernel lanes\n479\t+  (slow/guard\n480\t+    \"cross-engine-canonical-equality\"\n481\t+    (fn []\n482\t+      (let [cases (lane-cases) n (atom 0)]\n483\t+        (is (= 61 (count cases)) \"15 lane rows x 4 segments + row 20\")\n484\t+        (doseq [[row label expected build] cases]\n485\t+          (testing (str \"row \" row \" \" (name label))\n486\t+            (canonical-equality build expected)\n487\t+            (swap! n inc)))\n488\t+        (is (= 61 @n))))))\n489\t+\n490\t+\n491\t+(def ordered-pairs\n492\t+  \"Law 5's six ordered pairs of distinct lanes.\"\n493\t+  (into [] (mapcat (fn [from] (keep (fn [to] (when (not= from to) [from to])) lanes))) lanes))\n494\t+\n495\t+\n496\t+(def unlowerable\n497\t+  \"[row receiver] pairs a de Bruijn receiver cannot continue (§5.3): row\n498\t+   4 is lifted from a de Bruijn source but not lowered into a de Bruijn\n499\t+   receiver, whose re-park names its own call pair\n500\t+   (ffi/response-wait-entry), not the carried response cursor cell the\n501\t+   semantic-register kernel restores. Emptied when the retained-FFI seam\n502\t+   (§4, 6c-post-D2) lands, raising law 5 to 366 and 96.\"\n503\t+  #{[4 :stack] [4 :register]})\n504\t+\n505\t+\n506\t+(defn crossed\n507\t+  \"Lift on from, lower into a fresh receiver on to, satisfy through the\n508\t+   source's streams: the run's observables and attaches.\"\n509\t+  [from to build]\n510\t+  (scoped\n511\t+    (fn []\n512\t+      (let [world (on-lane from build)\n513\t+            {:keys [toy peer serve!]} (served (or (:surfaces world) #{:reader}))\n514\t+            wire (lane-lift (:machine world) serve!)\n515\t+            receiver ((or (:receiver world) (constantly nil)))\n516\t+            {:keys [attach!] n :count} (recording-attacher toy)\n517\t+            recv (lane-lower to (merge {:attach-stream attach!} (:opts receiver)) wire attach!)\n518\t+            _ (is (= to (lane-of recv)))\n519\t+            attaches @n\n520\t+            done (satisfy world recv #(drive-peers % [peer]))\n521\t+            _ (s/serve-mirror! peer)]\n522\t+        (when-let [f (:finish world)] (f))\n523\t+        (when-let [f (:finish receiver)] (f))\n524\t+        {:attaches attaches :wire wire\n525\t+         :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))))\n526\t+\n527\t+\n528\t+(defn cross-lowering\n529\t+  \"Law 5 for one case: every admitted ordered pair continues to the\n530\t+   reference. Answers the pairs that ran.\"\n531\t+  [row build]\n532\t+  (let [ref (reference (on-lane :semantic-register build))]\n533\t+    (is (:halted ref))\n534\t+    (reduce (fn [ran [from to]]\n535\t+              (if (contains? unlowerable [row to])\n536\t+                ran\n537\t+                (testing (str (name from) \" -> \" (name to))\n538\t+                  (let [got (crossed from to build)]\n539\t+                    (is (= (count (stream-identities (:wire got))) (:attaches got)))\n540\t+                    (is (= (select-keys ref [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n541\t+                        \"law 5: the lowered run continues to the reference\")\n542\t+                    (conj ran [from to])))))\n543\t+            []\n544\t+            ordered-pairs)))\n545\t+\n546\t+\n547\t+(deftest cross-engine-lowering-bare\n548\t+  ;; the quick-tier slice of acceptance 11: every lane row once, bare;\n549\t+  ;; §5.3's shared fragment, 92 transfers (96 once unlowerable is emptied)\n550\t+  (is (= 6 (count ordered-pairs)))\n551\t+  (let [ran (atom 0)]\n552\t+    (doseq [[row _ build] lane-rows]\n553\t+      (testing (str \"row \" row)\n554\t+        (let [pairs (cross-lowering row #(build identity))]\n555\t+          (is (= (if (= 4 row) 2 6) (count pairs)) \"every admitted ordered pair ran\")\n556\t+          (swap! ran + (count pairs)))))\n557\t+    (testing \"row 20\"\n558\t+      (is (= 6 (count (cross-lowering 20 tail-effect-halt))))\n559\t+      (swap! ran + 6))\n560\t+    (is (= 92 @ran) \"16 cases x 6 pairs, less row 4's 4 into a de Bruijn receiver\")))\n561\t+\n562\t+\n563\t+(deftest ^:slow cross-engine-lowering\n564\t+  ;; acceptance 11: law 5, six ordered pairs over §5.3's shared fragment,\n565\t+  ;; 350 transfers (366 once unlowerable is emptied)\n566\t+  (slow/guard\n567\t+    \"cross-engine-lowering\"\n568\t+    (fn []\n569\t+      (let [ran (atom 0) cases (lane-cases)]\n570\t+        (is (= 61 (count cases)))\n571\t+        (doseq [[row label _ build] cases]\n572\t+          (testing (str \"row \" row \" \" (name label))\n573\t+            (swap! ran + (count (cross-lowering row build)))))\n574\t+        (is (= 350 @ran) \"61 cases x 6 pairs, less row 4's 4 per segment\")))))\n575\t+\n576\t+\n577\t+(defn register-judge\n578\t+  \"The frame validator's verdict on register entry `entry` of m,\n579\t+   reconstructed through the layout.\"\n580\t+  [m entry]\n581\t+  (let [sp (kernel-space m)\n582\t+        p (layout/lift-state (layout/lift-context m sp (:owner m)) entry)\n583\t+        code-map (into {} (map (fn [[a sg]] [a (:vector sg)])) (:segments sp))\n584\t+        as-sr {:code (into {} (map (fn [a] [a {:address a}])) (keys code-map))}]\n585\t+    (:yin.k/kind (frame/defect (ft/canonical as-sr p true) code-map :wait {:free-env {} :ffi-call-ids #{}}))))\n586\t+\n587\t+\n588\t+(defn spare-register\n589\t+  \"A physical register of the entry's body outside its live set and its\n590\t+   destination that R gives exactly one virtual.\"\n591\t+  [m entry]\n592\t+  (let [sg (val (first (:segments (kernel-space m))))\n593\t+        site (- (:site-pc entry) (layout/offset :register m sg))\n594\t+        body (nth (:phys sg) (code/body-index (:bodies sg) site))\n595\t+        unique (keep (fn [[s xs]] (when (= 1 (count xs)) s)) (group-by body (keys body)))]\n596\t+    (first (remove (conj (set (:live entry)) (:dest entry)) (sort unique)))))\n597\t+\n598\t+\n599\t+(def layout-corpus\n600\t+  \"C, [label ast]: the B0 corpus, the phase-3 corpus, then a tail call in\n601\t+   operand position, whose dead layout syntax reads registers other than\n602\t+   the call's own (phase-5 §6.3's last golden).\"\n603\t+  (conj (into (mapv (fn [[label ast _]] [label ast]) b0/corpus) corpus/programs)\n604\t+        [:tail-operand (corpus/app (corpus/v 'f) (corpus/tail (corpus/app (corpus/v 'g) (corpus/v 'x))) (corpus/v 'y))]))\n605\t+\n606\t+\n607\t+(defn- parking-site?\n608\t+  \"Rule A1: a non-tail parking instruction.\"\n609\t+  [t]\n610\t+  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n611\t+      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n612\t+\n613\t+\n614\t+(defn ambiguous-dead-slots\n615\t+  \"[v p s] over C: a reachable parking pc p and a physical slot s of its\n616\t+   body that R gives two or more virtuals, outside live-out*(p)'s image\n617\t+   and p's destination.\"\n618\t+  []\n619\t+  (into []\n620\t+        (mapcat (fn [[_ ast]]\n621\t+                  (let [v (:vector (linearize/project ast))\n622\t+                        sg (segment-of v)\n623\t+                        reach (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v))]\n624\t+                    (mapcat (fn [p]\n625\t+                              (let [rd (code/rd (nth v p))\n626\t+                                    body (nth (:phys sg) (code/body-index (:bodies sg) p))\n627\t+                                    used (into #{} (map #(layout/phys sg p %))\n628\t+                                               (cond-> (layout/live-out sg p) (some? rd) (conj rd)))]\n629\t+                                (keep (fn [[s xs]] (when (and (< 1 (count xs)) (not (contains? used s))) [v p s]))\n630\t+                                      (sort-by key (group-by body (keys body))))))\n631\t+                            (filter #(parking-site? (nth v %)) (sort reach))))))\n632\t+        layout-corpus))\n633\t+\n634\t+\n635\t+(defn register-entry\n636\t+  \"A register kernel k's wait entry parked after pc p of v, its window the\n637\t+   live registers holding :v, plus slot extra holding :x when given.\"\n638\t+  [k v p extra]\n639\t+  (let [sg (segment-of v)\n640\t+        off (layout/offset :register k sg)\n641\t+        rd (code/rd (nth v p))\n642\t+        regs (vec (sort-by first (cond-> (mapv (fn [r] [r :v]) (layout/register-live sg p))\n643\t+                                   (some? extra) (conj [extra :x]))))]\n644\t+    {:site-pc (+ off p) :pc (+ off p 1) :regs regs :live (mapv first regs)\n645\t+     :dest (when (some? rd) (layout/phys sg p rd)) :continuation [] :resume-mode :write-result\n646\t+     :frames (mapv (fn [c] (vec (repeat (count (nth (nth v c) 2)) nil))) (layout/chain sg (inc p)))}))\n647\t+\n648\t+\n649\t+(deftest layout-refusals\n650\t+  (testing \"a kernel stepped to a non-safepoint pc\"\n651\t+    (doseq [lane [:stack :register]]\n652\t+      (testing (name lane)\n653\t+        (scoped\n654\t+          (fn []\n655\t+            (let [m (on-lane lane #(vm/step (load-program (machine) (s/app (s/lam ['p] (s/lit 42)) (s/lit 1)))))\n656\t+                  n (atom 0)\n657\t+                  {:keys [serve!]} (served #{:reader})\n658\t+                  d (error #(lane-lift m (fn [h] (swap! n inc) (serve! h))))]\n659\t+              (is (not (vm/halted? m)))\n660\t+              (is (= :yin.k/not-at-safepoint (:yin.k/status d)) (pr-str d))\n661\t+              (is (zero? @n) \"no stream was served\")\n662\t+              