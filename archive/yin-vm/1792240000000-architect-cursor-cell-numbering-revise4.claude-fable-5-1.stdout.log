{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012dwgwMk5XZcM2Z87iB5zVw","type":"tool_result","content":"82\t;; --------------------------------------------------------------- budgets\n83\t\n84\t(def default-budget\n85\t  \"6a's budget without :label-bytes and :search; :work now also counts\n86\t   representation bytes, so its default takes over :label-bytes' scale.\"\n87\t  (assoc (dissoc rows/default-budget :label-bytes :search) :work 4194304))\n88\t\n89\t(defn- limit! [ctx category]\n90\t  (throw (ex-info \"resource limit\"\n91\t                  {:yin.k/status :yin.k/unsupported :yin.k/kind :resource-limit :yin.k/path [category]\n92\t                   ;; probe-only diagnostic (counters at the refusal), not part of the contract\n93\t                   :probe/used @(:counter ctx)})))\n94\t\n95\t(defn- spend! [ctx category amount]\n96\t  (let [n (get (swap! (:counter ctx) update category (fnil + 0) amount) category)]\n97\t    (when (> n (get (:budget ctx) category)) (limit! ctx category))))\n98\t\n99\t(defn- charge-rep-bound!\n100\t  \"6a's conservative representation bound of x (check-label-bytes!'s `size`:\n101\t   128 per node or scalar, 4 per character, 16 plus the length per byte\n102\t   payload, metadata included), charged to :work. Computed with an explicit\n103\t   stack, no recursion, against the budget REMAINING at the call: the running\n104\t   total is checked after every node, so the estimator stops after at most\n105\t   remaining/16 steps on any input and never finishes reading a value it\n106\t   cannot afford. The bound is an abstract charge: an upper bound of the\n107\t   encoding's bytes and of the encoder's intermediate nodes, not a measured\n108\t   host-heap ceiling (the comparison vector and the encoder's intermediates\n109\t   use more heap than the payload length). Reading x allocates the lazy\n110\t   element sequences and `str` of names; nothing proportional to the\n111\t   encoding.\"\n112\t  [ctx x]\n113\t  (let [remaining (- (get (:budget ctx) :work) (get @(:counter ctx) :work 0))]\n114\t    (loop [stack (list (list x)) total 0 steps 0]\n115\t      (if (empty? stack)\n116\t        (do (swap! (:counter ctx) update :estimator-steps (fnil + 0) steps)\n117\t            (spend! ctx :work total))\n118\t        (let [s (first stack) stack (rest stack)]\n119\t          (if (empty? s)\n120\t            (recur stack total steps)\n121\t            (let [x (first s)\n122\t                  stack (cons (rest s) stack)\n123\t                  n (cond (cbor/byte-payload? x) (+ 16 (alength ^bytes x))\n124\t                          (string? x) (+ 128 (* 4 (count x)))\n125\t                          (or (keyword? x) (symbol? x)) (+ 128 (* 4 (count (str x))))\n126\t                          :else 128)\n127\t                  total (+ total n)]\n128\t              (when (> total remaining)\n129\t                (swap! (:counter ctx) update :estimator-steps (fnil + 0) (inc steps))\n130\t                (limit! ctx :work))\n131\t              (recur (cond->> stack\n132\t                       (coll? x) (cons (if (map? x) (mapcat identity x) (seq x)))\n133\t                       (meta x) (cons (list (meta x))))\n134\t                     total (inc steps)))))))))\n135\t\n136\t(defn- key-bytes!\n137\t  \"Charge the representation bound of x to :work, then encode x for comparison.\n138\t   Every encoding the procedure makes goes through here.\"\n139\t  [ctx x]\n140\t  (charge-rep-bound! ctx x)\n141\t  (let [bs (bytes-key x)]\n142\t    (swap! (:counter ctx) update :encoded-bytes (fnil + 0) (count bs))\n143\t    bs))\n144\t\n145\t(defn- depth-scan!\n146\t  \"The :depth gate, enforced BEFORE any recursive traversal of the task: one\n147\t   bounded pre-order scan with an explicit stack (no recursion) over rows,\n148\t   members, structural and literal data and the census; install children are\n149\t   skipped (each is gated by its own procedure). The depth of a position is\n150\t   the walk's measure, its slot steps from the task (a member step counts\n151\t   one, a map entry's key and value two), plus, inside data, its collection\n152\t   nesting (metadata counts one level). A position deeper than :depth refuses\n153\t   [:depth]; every position costs one :work unit. After the scan every\n154\t   recursive read of the task (cell scans, memo-key hashing, spelling,\n155\t   encoding, 6a's emitter) nests at most :depth levels.\"\n156\t  [ctx task]\n157\t  (let [limit (get (:budget ctx) :depth)\n158\t        node (fn [n k] [:node nil n k])\n159\t        slot (fn [d v k] [:slot d v k])\n160\t        data (fn [v k] [:data nil v k])]\n161\t    ;; The stack holds lazy sequences of entries, so pushing a container's\n162\t    ;; elements is O(1): every position is charged when it is popped, before\n163\t    ;; any work proportional to it is done.\n164\t    (loop [stack (list (list (node task 0)))]\n165\t      (when (seq stack)\n166\t        (let [s (first stack) stack (rest stack)]\n167\t          (if (empty? s)\n168\t            (recur stack)\n169\t            (let [[tag d x k] (first s) stack (cons (rest s) stack)]\n170\t              (spend! ctx :work 1)\n171\t              (when (> k limit) (limit! ctx :depth))\n172\t              (recur\n173\t               (cons\n174\t                (case tag\n175\t                  :node\n176\t                  (let [{:keys [kind slots]} x k' (inc k)]\n177\t                    (if (child-task? ctx x)\n178\t                      nil\n179\t                      (let [ds (descriptors kind slots)]\n180\t                        (cond\n181\t                          (= :task kind)\n182\t                          (mapcat (fn [i d v]\n183\t                                    (if (contains? #{7 12} i)\n184\t                                      (map (fn [child] (node child (inc k'))) v)\n185\t                                      [(slot d v k')]))\n186\t                                  (range) ds slots)\n187\t                          (contains? keyed-structural kind)\n188\t                          (mapcat (fn [[key v]] [(data key k') (slot (second ds) v k')]) (partition 2 slots))\n189\t                          (= :window kind)\n190\t                          (mapcat (fn [[r v]] [(data r k') (slot :V v k')]) (partition 2 slots))\n191\t                          (= :set kind) (map (fn [v] (slot :V v k')) slots)\n192\t                          (= :map kind)\n193\t                          (mapcat (fn [[a b]] [(slot :V a (inc k')) (slot :V b (inc k'))]) (partition 2 slots))\n194\t                          :else (map (fn [d v] (slot d v k')) ds slots)))))\n195\t                  :slot\n196\t                  (cond (ref? d) [(node x k)]\n197\t                        (refs? d) (map (fn [n] (node n (inc k))) x)\n198\t                        (= :C d) nil\n199\t                        (v? d) (when x\n200\t                                 (case (first x)\n201\t                                   :cursor-cell nil\n202\t                                   :row [(node (second x) k)]\n203\t                                   :lit [(data (second x) k)]\n204\t                                   [(data x k)]))\n205\t                        :else [(data x k)])\n206\t                  :data\n207\t                  (concat (when (coll? x) (map (fn [e] (data e (inc k))) (if (map? x) (mapcat identity x) x)))\n208\t                          (when (meta x) [(data (meta x) (inc k))])))\n209\t                stack)))))))))\n210\t\n211\t(defn- sort-by-key!\n212\t  \"xs in the bytewise order of (f x), each encoded once (stable).\"\n213\t  [ctx f xs]\n214\t  (mapv second (sort #(compare-bytes (first %1) (first %2)) (mapv (fn [x] [(key-bytes! ctx (f x)) x]) xs))))\n215\t\n216\t;; ------------------------------------------------------------ cell scans\n217\t\n218\t(defn- walk-cells\n219\t  \"Call f on every cursor cell at a position under slot (d x); census and\n220\t   install children excluded; one :work unit per position.\"\n221\t  [ctx d x f]\n222\t  (letfn [(slot [d x]\n223\t            (spend! ctx :work 1)\n224\t            (cond (ref? d) (node x)\n225\t                  (refs? d) (run! node x)\n226\t                  (= :C d) (f x)\n227\t                  (v? d) (when x (case (first x) :cursor-cell (f (second x)) :row (node (second x)) nil))\n228\t                  :else nil))\n229\t          (node [n]\n230\t            (when-not (or (= :cursor-cells (:kind n)) (child-task? ctx n))\n231\t              (dorun (map slot (descriptors (:kind n) (:slots n)) (:slots n)))))]\n232\t    (slot d x)))\n233\t\n234\t(defn item-cells\n235\t  \"The cursor cells under slot (d x), memoized per procedure on the slot value.\"\n236\t  [ctx d x]\n237\t  (or (get @(:cells-memo ctx) [d x])\n238\t      (let [acc (atom #{})]\n239\t        (walk-cells ctx d x #(swap! acc conj %))\n240\t        (swap! (:cells-memo ctx) assoc [d x] @acc)\n241\t        @acc)))\n242\t\n243\t(defn- occurrence-counts\n244\t  \"Cursor cell -> number of positions of the task holding it.\"\n245\t  [ctx task]\n246\t  (let [acc (atom {})]\n247\t    (walk-cells ctx [:ref :task] task #(swap! acc update % (fnil inc 0)))\n248\t    @acc))\n249\t\n250\t(defn body-label [body]\n251\t  (let [[stream position] (:slots body)]\n252\t    [:body (into [:stream] (:slots stream)) position]))\n253\t\n254\t(defn- body-ranks\n255\t  \"Cursor cell -> rank of its body label among the census's distinct body\n256\t   labels in bytewise order (rank order = label order, so keys stay\n257\t   independent of the descriptor's size).\"\n258\t  [ctx bodies]\n259\t  (let [labels (into {} (map (fn [[c b]] [c (body-label b)])) bodies)\n260\t        ranks (into {} (map-indexed (fn [i l] [l i])) (sort-by-key! ctx identity (distinct (vals labels))))]\n261\t    (into {} (map (fn [[c l]] [c (get ranks l)])) labels)))\n262\t\n263\t;; ------------------------------------------------------------------ runs\n264\t\n265\t(def ^:dynamic *trace* false)\n266\t\n267\t(defn- new-run [ctx num tag next]\n268\t  {:ctx ctx :num (atom num) :tag tag :next (atom next) :groups (atom []) :gid (atom 0) :refused (atom nil)})\n269\t\n270\t(defn- meet!\n271\t  \"W2. A cursor cell met for the first time receives the run's next number.\"\n272\t  [run c]\n273\t  (when-not (contains? @(:num run) c)\n274\t    (let [k @(:next run)]\n275\t      (swap! (:num run) assoc c [(:tag run) k])\n276\t      (swap! (:next run) inc)\n277\t      true)))\n278\t\n279\t(declare enter-node! unordered! local-run spell-slot spell-node)\n280\t\n281\t(defn- enter-slot! [run d x path]\n282\t  (let [ctx (:ctx run)]\n283\t    (spend! ctx :work 1)\n284\t    (when (> (count path) (get (:budget ctx) :depth)) (limit! ctx :depth))\n285\t    (cond (ref? d) (enter-node! run x path)\n286\t          (refs? d) (dorun (map-indexed (fn [i n] (enter-node! run n (conj path i))) x))\n287\t          (= :C d) (meet! run x)\n288\t          (v? d) (when x (case (first x)\n289\t                           :cursor-cell (meet! run (second x))\n290\t                           :row (enter-node! run (second x) path)\n291\t                           nil))\n292\t          :else nil)))\n293\t\n294\t(defn- enter-node!\n295\t  \"W1. Pre-order: table order for slots; ordered repeated slots in order;\n296\t   keyed structural rows in the byte order of the key; :window in register\n297\t   order; installs and module stores by name; :set and :map by keys with\n298\t   ties postponed; census and children not entered.\"\n299\t  [run n path]\n300\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n301\t    (cond\n302\t      (= :cursor-cells kind) nil\n303\t      (child-task? ctx n) nil\n304\t      (= :task kind)\n305\t      (doseq [[i d x] (map vector (range) ds slots)]\n306\t        (if (contains? #{7 12} i)\n307\t          (doseq [child (sort-by-key! ctx #(first (:slots %)) x)]\n308\t            (enter-node! run child (conj path i (first (:slots child)))))\n309\t          (enter-slot! run d x (conj path i))))\n310\t      (contains? keyed-structural kind)\n311\t      (doseq [[k v] (sort-by-key! ctx first (partition 2 slots))]\n312\t        (enter-slot! run (second ds) v (conj path k)))\n313\t      (= :window kind)\n314\t      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n315\t      (= :set kind) (unordered! run n :set (vec slots) path)\n316\t      (= :map kind) (unordered! run n :map (mapv vec (partition 2 slots)) path)\n317\t      :else (dorun (map-indexed (fn [i [d x]] (enter-slot! run d x (conj path i))) (map vector ds slots))))))\n318\t\n319\t(defn- unordered!\n320\t  \"The transformation: key every member by a local walk under the numbering\n321\t   at this moment; members with a unique key are entered in key order; a run\n322\t   of equal keys is one tie group, postponed to the run's queue (postponement\n323\t   order: containers in walk order, groups within a container in key order).\n324\t   A member's path is the container's path plus :member (there is no\n325\t   canonical index into an unordered container); a group remembers its\n326\t   container by identity.\"\n327\t  [run container kind elems path]\n328\t  (let [keyed (mapv (fn [e]\n329\t                      ;; one unit per member keyed, so the number of key walks\n330\t                      ;; (and of memo lookups, each a read of charged data) is charged\n331\t                      (spend! (:ctx run) :work 1)\n332\t                      [(local-run run (elem-item kind e) (conj path :member)) e]) elems)\n333\t        groups (partition-by (comp :bytes first) (sort #(compare-bytes (:bytes (first %1)) (:bytes (first %2))) keyed))]\n334\t    (when (and *trace* (= :n (:tag run)))\n335\t      (println \"  [sort]\" path \"num\" @(:num run))\n336\t      (doseq [g groups] (println \"    \" (if (= 1 (count g)) \"enter\" \"POSTPONE\") (mapv (fn [[r e]] [e (:spell r)]) g))))\n337\t    (doseq [g groups]\n338\t      (if (= 1 (count g))\n339\t        (enter-slot! run :V (elem-item kind (second (first g))) (conj path :member))\n340\t        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :container container :kind kind :path path\n341\t                                   :key (:spell (first (first g))) :complete? (:complete? (first (first g)))\n342\t                                   :elems (mapv second g)})))))\n343\t\n344\t(defn- fixpoint!\n345\t  \"W3. Re-examine every postponed group in order under the current numbering;\n346\t   repeat while a pass numbers a cursor cell and groups remain.\"\n347\t  [run]\n348\t  (loop []\n349\t    (let [before (count @(:num run)) groups @(:groups run)]\n350\t      (reset! (:groups run) [])\n351\t      (doseq [{:keys [container kind elems path]} groups] (unordered! run container kind elems path))\n352\t      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n353\t\n354\t(defn- unnumbered-cells [run kind e]\n355\t  (let [num @(:num run)]\n356\t    (set (remove #(contains? num %) (item-cells (:ctx run) :V (elem-item kind e))))))\n357\t\n358\t(defn- group-failure\n359\t  \"T, the tie test. nil when the group's members are interchangeable: the\n360\t   common key is complete, and the members' unnumbered cursor cells are\n361\t   pairwise disjoint and occur in no member of another remaining group.\n362\t   Otherwise the reason.\"\n363\t  [run groups g]\n364\t  (let [own (mapv #(unnumbered-cells run (:kind g) %) (:elems g))\n365\t        others (reduce into #{} (for [h groups :when (not= (:id h) (:id g)) e (:elems h)]\n366\t                                  (unnumbered-cells run (:kind h) e)))]\n367\t    (cond (not (:complete? g)) :incomplete-key\n368\t          (not= (reduce + (map count own)) (count (reduce into #{} own))) :shared-within-group\n369\t          (some #(seq (set/intersection % others)) own) :shared-across-groups\n370\t          :else nil)))\n371\t\n372\t(defn- resolve!\n373\t  \"Postponed groups to completion: fixpoint, then the tie test on every\n374\t   remaining group; all pass: enter them in listed order and repeat; any\n375\t   fails: the root run refuses, a key run leaves them as residue.\"\n376\t  [run]\n377\t  (loop []\n378\t    (fixpoint! run)\n379\t    (let [groups @(:groups run) ctx (:ctx run)]\n380\t      (when (seq groups)\n381\t        (let [failing (vec (keep (fn [g] (when-let [why (group-failure run groups g)] (assoc g :why why))) groups))]\n382\t          (when (and *trace* (= :n (:tag run)))\n383\t            (println \"  [ties]\" (mapv (fn [g] [(:id g) (:path g) (:elems g) (:why g)]) (map #(assoc % :why (group-failure run groups %)) groups))))\n384\t          (cond\n385\t            (empty? failing)\n386\t            ;; Interchangeable groups are independent of each other (their\n387\t            ;; cells are confined), so all are entered before the next pass.\n388\t            (do (reset! (:groups run) [])\n389\t                (doseq [g groups e (:elems g)] (enter-slot! run :V (elem-item (:kind g) e) (conj (:path g) :member)))\n390\t                (recur))\n391\t            (:permissive ctx)\n392\t            ;; Diagnostic only: enter the first group in listed order, then\n393\t            ;; re-key the rest (what an unsound \"equal keys, host order\" rule does).\n394\t            (do (reset! (:groups run) (vec (rest groups)))\n395\t                (doseq [e (:elems (first groups))] (enter-slot! run :V (elem-item (:kind (first groups)) e) (conj (:path (first groups)) :member)))\n396\t                (recur))\n397\t            (= :n (:tag run))\n398\t            (reset! (:refused run)\n399\t                    {:kind :unresolved-cursor-cells\n400\t                     :path (:path (first failing))\n401\t                     :why (mapv :why failing)\n402\t                     :cursor-cells (vec (sort (distinct (mapcat (fn [g] (mapcat #(unnumbered-cells run (:kind g) %) (:elems g))) failing))))})\n403\t            :else nil))))))\n404\t\n405\t(defn- local-run\n406\t  \"A key walk: the same procedure on one member from the enclosing run's\n407\t   numbering, tag :u; its result is the member's key (spelling under its\n408\t   final numbering, residue spelled [:tie K ...]) and whether it is complete.\n409\t   Memoized on (item, numbering restricted to the item's cells, counter).\"\n410\t  [run item path]\n411\t  (let [ctx (:ctx run)\n412\t        cells (item-cells ctx :V item)\n413\t        num @(:num run)\n414\t        start (if (= :u (:tag run)) @(:next run) 0)\n415\t        mk [item (select-keys num cells) start]]\n416\t    (or (get @(:memo ctx) mk)\n417\t        (let [sub (new-run ctx num :u start)]\n418\t          (spend! ctx :work (count cells))\n419\t          (enter-slot! sub :V item path)\n420\t          (resolve! sub)\n421\t          (let [spell (spell-slot sub :V item path)\n422\t                r {:spell spell :bytes (key-bytes! ctx spell) :complete? (empty? @(:groups sub))}]\n423\t            (swap! (:counter ctx) update :local-runs (fnil + 0) 1)\n424\t            (swap! (:memo ctx) assoc mk r)\n425\t            r)))))\n426\t\n427\t;; -------------------------------------------------------------- spelling\n428\t\n429\t(defn- spell-cell [run c]\n430\t  (let [[t k] (get @(:num run) c) ctx (:ctx run)]\n431\t    (case t\n432\t      :n [:cursor-cell [:n k]]\n433\t      :u [:cursor-cell (if (:count-spelling ctx)\n434\t                         [:u k (get (:ranks ctx) c) (get (:counts ctx) c)]\n435\t                         [:u k (get (:ranks ctx) c)])]\n436\t      (throw (ex-info \"spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n437\t\n438\t(defn- spell-slot [run d x path]\n439\t  (spend! (:ctx run) :work 1)\n440\t  (cond (ref? d) (spell-node run x path)\n441\t        (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n442\t        (= :C d) (spell-cell run x)\n443\t        (v? d) (if (nil? x) x\n444\t                   (case (first x)\n445\t                     :cursor-cell (spell-cell run (second x))\n446\t                     :row [:row (spell-node run (second x) path)]\n447\t                     x))\n448\t        :else x))\n449\t\n450\t(defn- spell-node\n451\t  \"The spelling of a row under the run's final numbering: literals and\n452\t   structural data as themselves (by reference), rows expanded in place,\n453\t   keyed rows in key order, a :set or :map as the sorted vector of its\n454\t   members' spellings with each surviving tie group as [:tie K ...].\"\n455\t  [run n path]\n456\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n457\t    (cond\n458\t      (= :cursor-cells kind) [:cursor-cells]\n459\t      (child-task? ctx n) [:child]\n460\t      (= :task kind)\n461\t      (into [kind]\n462\t            (map-indexed (fn [i [d x]]\n463\t                           (if (contains? #{7 12} i)\n464\t                             (sort-by-key! ctx #(nth % 1) (mapv #(spell-node run % (conj path i (first (:slots %)))) x))\n465\t                             (spell-slot run d x (conj path i))))\n466\t                         (map vector ds slots)))\n467\t      (contains? keyed-structural kind)\n468\t      (into [kind] (mapcat identity (sort-by-key! ctx first\n469\t                                                  (mapv (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n470\t                                                        (partition 2 slots)))))\n471\t      (= :window kind)\n472\t      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n473\t      (contains? #{:set :map} kind)\n474\t      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n475\t            tied (filter #(identical? n (:container %)) @(:groups run))\n476\t            tied-elems (set (mapcat :elems tied))\n477\t            plain (keep (fn [e] (when-not (tied-elems e) (spell-slot run :V (elem-item kind e) (conj path :member)))) elems)\n478\t            ties (map #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n479\t        (into [kind] (sort-by-key! ctx identity (concat plain ties))))\n480\t      :else (into [kind] (map-indexed (fn [i [d x]] (spell-slot run d x (conj path i))) (map vector ds slots))))))\n481\t\n482\t;; ------------------------------------------------------------- procedure\n483\t\n484\t(def ^:dynamic *numbering-opts*\n485\t  \"Options for every run of the procedure in scope (root and install\n486\t   children): :permissive, :count-spelling, :budget.\"\n487\t  {})\n488\t\n489\t(defn discovery-numbering\n490\t  \"Returns {:numbering {src -> :yin.k/cc-n} :used {...}} or {:refused {...}}.\n491\t   Throws :resource-limit when a budget is exceeded, and a defect (never a\n492\t   refusal) when the numbering is not total.\"\n493\t  ([task] (discovery-numbering task *numbering-opts*))\n494\t  ([task opts]\n495\t   (let [census (nth (:slots task) 9)\n496\t         ctx {:task task\n497\t              :memo (atom {}) :cells-memo (atom {})\n498\t              :budget (merge default-budget (:budget opts))\n499\t              :counter (atom {})\n500\t              :permissive (:permissive opts)\n501\t              :count-spelling (not= false (:count-spelling opts))}\n502\t         ;; gates first: the census's pair count before the bodies map is\n503\t         ;; built, the depth scan before any recursive traversal\n504\t         _ (spend! ctx :cursor-cells (quot (count (:slots census)) 2))\n505\t         _ (depth-scan! ctx task)\n506\t         bodies (into {} (map vec) (partition 2 (:slots census)))\n507\t         ctx (assoc ctx :bodies bodies)\n508\t         ctx (assoc ctx :ranks (body-ranks ctx bodies) :counts (occurrence-counts ctx task))\n509\t         run (new-run ctx {} :n 1)]\n510\t     (enter-node! run task [])\n511\t     (resolve! run)\n512\t     (if-let [r @(:refused run)]\n513\t       {:refused r :used @(:counter ctx)}\n514\t       (let [numbered (set (keys @(:num run))) declared (set (keys bodies))]\n515\t         (when (seq @(:groups run)) (throw (ex-info \"residue after resolve\" {})))\n516\t         (when (not= numbered declared)\n517\t           (throw (ex-info \"numbering is not total\" {:missing (vec (sort (remove numbered declared)))\n518\t                                                      :extra (vec (sort (remove declared numbered)))})))\n519\t         {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))\n520\t          :used @(:counter ctx)})))))\n521\t"}]},"parent_tool_use_id":null,"session_id":"704437a3-7e24-494b-ab26-b13fa72d3d40","uuid":"9b23d9a1-fd52-44b9-92e3-f3a46e2a90bd","timestamp":"2026-10-12T12:04:29.020Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-numbering/collab/numbering-probe/src/probe/discovery.clj","content":";; --------------------------------------------------------------- budgets\n\n(def default-budget\n  \"6a's budget without :label-bytes and :search; :work now also counts\n   representation bytes, so its default takes over :label-bytes' scale.\"\n  (assoc (dissoc rows/default-budget :label-bytes :search) :work 4194304))\n\n(defn- limit! [ctx category]\n  (throw (ex-info \"resource limit\"\n                  {:yin.k/status :yin.k/unsupported :yin.k/kind :resource-limit :yin.k/path [category]\n                   ;; probe-only diagnostic (counters at the refusal), not part of the contract\n                   :probe/used @(:counter ctx)})))\n\n(defn- spend! [ctx category amount]\n  (let [n (get (swap! (:counter ctx) update category (fnil + 0) amount) category)]\n    (when (> n (get (:budget ctx) category)) (limit! ctx category))))\n\n(defn- charge-rep-bound!\n  \"6a's conservative representation bound of x (check-label-bytes!'s `size`:\n   128 per node or scalar, 4 per character, 16 plus the length per byte\n   payload, metadata included), charged to :work. Computed with an explicit\n   stack, no recursion, against the budget REMAINING at the call: the running\n   total is checked after every node, so the estimator stops after at most\n   remaining/16 steps on any input and never finishes reading a value it\n   cannot afford. The bound is an abstract charge: an upper bound of the\n   encoding's bytes and of the encoder's intermediate nodes, not a measured\n   host-heap ceiling (the comparison vector and the encoder's intermediates\n   use more heap than the payload length). Reading x allocates the lazy\n   element sequences and `str` of names; nothing proportional to the\n   encoding.\"\n  [ctx x]\n  (let [remaining (- (get (:budget ctx) :work) (get @(:counter ctx) :work 0))]\n    (loop [stack (list (list x)) total 0 steps 0]\n      (if (empty? stack)\n        (do (swap! (:counter ctx) update :estimator-steps (fnil + 0) steps)\n            (spend! ctx :work total))\n        (let [s (first stack) stack (rest stack)]\n          (if (empty? s)\n            (recur stack total steps)\n            (let [x (first s)\n                  stack (cons (rest s) stack)\n                  n (cond (cbor/byte-payload? x) (+ 16 (alength ^bytes x))\n                          (string? x) (+ 128 (* 4 (count x)))\n                          (or (keyword? x) (symbol? x)) (+ 128 (* 4 (count (str x))))\n                          :else 128)\n                  total (+ total n)]\n              (when (> total remaining)\n                (swap! (:counter ctx) update :estimator-steps (fnil + 0) (inc steps))\n                (limit! ctx :work))\n              (recur (cond->> stack\n                       (coll? x) (cons (if (map? x) (mapcat identity x) (seq x)))\n                       (meta x) (cons (list (meta x))))\n                     total (inc steps)))))))))\n\n(defn- key-bytes!\n  \"Charge the representation bound of x to :work, then encode x for comparison.\n   Every encoding the procedure makes goes through here.\"\n  [ctx x]\n  (charge-rep-bound! ctx x)\n  (let [bs (bytes-key x)]\n    (swap! (:counter ctx) update :encoded-bytes (fnil + 0) (count bs))\n    bs))\n\n(defn- depth-scan!\n  \"The :depth gate, enforced BEFORE any recursive traversal of the task: one\n   bounded pre-order scan with an explicit stack (no recursion) over rows,\n   members, structural and literal data and the census; install children are\n   skipped (each is gated by its own procedure). The depth of a position is\n   the walk's measure, its slot steps from the task (a member step counts\n   one, a map entry's key and value two), plus, inside data, its collection\n   nesting (metadata counts one level). A position deeper than :depth refuses\n   [:depth]; every position costs one :work unit. After the scan every\n   recursive read of the task (cell scans, memo-key hashing, spelling,\n   encoding, 6a's emitter) nests at most :depth levels.\"\n  [ctx task]\n  (let [limit (get (:budget ctx) :depth)\n        node (fn [n k] [:node nil n k])\n        slot (fn [d v k] [:slot d v k])\n        data (fn [v k] [:data nil v k])]\n    ;; The stack holds lazy sequences of entries, so pushing a container's\n    ;; elements is O(1): every position is charged when it is popped, before\n    ;; any work proportional to it is done.\n    (loop [stack (list (list (node task 0)))]\n      (when (seq stack)\n        (let [s (first stack) stack (rest stack)]\n          (if (empty? s)\n            (recur stack)\n            (let [[tag d x k] (first s) stack (cons (rest s) stack)]\n              (spend! ctx :work 1)\n              (when (> k limit) (limit! ctx :depth))\n              (recur\n               (cons\n                (case tag\n                  :node\n                  (let [{:keys [kind slots]} x k' (inc k)]\n                    (if (child-task? ctx x)\n                      nil\n                      (let [ds (descriptors kind slots)]\n                        (cond\n                          (= :task kind)\n                          (mapcat (fn [i d v]\n                                    (if (contains? #{7 12} i)\n                                      (map (fn [child] (node child (inc k'))) v)\n                                      [(slot d v k')]))\n                                  (range) ds slots)\n                          (contains? keyed-structural kind)\n                          (mapcat (fn [[key v]] [(data key k') (slot (second ds) v k')]) (partition 2 slots))\n                          (= :window kind)\n                          (mapcat (fn [[r v]] [(data r k') (slot :V v k')]) (partition 2 slots))\n                          (= :set kind) (map (fn [v] (slot :V v k')) slots)\n                          (= :map kind)\n                          (mapcat (fn [[a b]] [(slot :V a (inc k')) (slot :V b (inc k'))]) (partition 2 slots))\n                          :else (map (fn [d v] (slot d v k')) ds slots)))))\n                  :slot\n                  (cond (ref? d) [(node x k)]\n                        (refs? d) (map (fn [n] (node n (inc k))) x)\n                        (= :C d) nil\n                        (v? d) (when x\n                                 (case (first x)\n                                   :cursor-cell nil\n                                   :row [(node (second x) k)]\n                                   :lit [(data (second x) k)]\n                                   [(data x k)]))\n                        :else [(data x k)])\n                  :data\n                  (concat (when (coll? x) (map (fn [e] (data e (inc k))) (if (map? x) (mapcat identity x) x)))\n                          (when (meta x) [(data (meta x) (inc k))])))\n                stack)))))))))\n\n(defn- sort-by-key!\n  \"xs in the bytewise order of (f x), each encoded once (stable).\"\n  [ctx f xs]\n  (mapv second (sort #(compare-bytes (first %1) (first %2)) (mapv (fn [x] [(key-bytes! ctx (f x)) x]) xs))))\n\n;; ------------------------------------------------------------ cell scans\n\n(defn- walk-cells\n  \"Call f on every cursor cell at a position under slot (d x); census and\n   install children excluded; one :work unit per position.\"\n  [ctx d x f]\n  (letfn [(slot [d x]\n            (spend! ctx :work 1)\n            (cond (ref? d) (node x)\n                  (refs? d) (run! node x)\n                  (= :C d) (f x)\n                  (v? d) (when x (case (first x) :cursor-cell (f (second x)) :row (node (second x)) nil))\n                  :else nil))\n          (node [n]\n            (when-not (or (= :cursor-cells (:kind n)) (child-task? ctx n))\n              (dorun (map slot (descriptors (:kind n) (:slots n)) (:slots n)))))]\n    (slot d x)))\n\n(defn item-cells\n  \"The cursor cells under slot (d x), memoized per procedure on the slot value.\"\n  [ctx d x]\n  (or (get @(:cells-memo ctx) [d x])\n      (let [acc (atom #{})]\n        (walk-cells ctx d x #(swap! acc conj %))\n        (swap! (:cells-memo ctx) assoc [d x] @acc)\n        @acc)))\n\n(defn- occurrence-counts\n  \"Cursor cell -> number of positions of the task holding it.\"\n  [ctx task]\n  (let [acc (atom {})]\n    (walk-cells ctx [:ref :task] task #(swap! acc update % (fnil inc 0)))\n    @acc))\n\n(defn body-label [body]\n  (let [[stream position] (:slots body)]\n    [:body (into [:stream] (:slots stream)) position]))\n\n(defn- body-ranks\n  \"Cursor cell -> rank of its body label among the census's distinct body\n   labels in bytewise order (rank order = label order, so keys stay\n   independent of the descriptor's size).\"\n  [ctx bodies]\n  (let [labels (into {} (map (fn [[c b]] [c (body-label b)])) bodies)\n        ranks (into {} (map-indexed (fn [i l] [l i])) (sort-by-key! ctx identity (distinct (vals labels))))]\n    (into {} (map (fn [[c l]] [c (get ranks l)])) labels)))\n\n;; ------------------------------------------------------------------ runs\n\n(def ^:dynamic *trace* false)\n\n(defn- new-run [ctx num tag next]\n  {:ctx ctx :num (atom num) :tag tag :next (atom next) :groups (atom []) :gid (atom 0) :refused (atom nil)})\n\n(defn- meet!\n  \"W2. A cursor cell met for the first time receives the run's next number.\"\n  [run c]\n  (when-not (contains? @(:num run) c)\n    (let [k @(:next run)]\n      (swap! (:num run) assoc c [(:tag run) k])\n      (swap! (:next run) inc)\n      true)))\n\n(declare enter-node! unordered! local-run spell-slot spell-node)\n\n(defn- enter-slot! [run d x path]\n  (let [ctx (:ctx run)]\n    (spend! ctx :work 1)\n    (when (> (count path) (get (:budget ctx) :depth)) (limit! ctx :depth))\n    (cond (ref? d) (enter-node! run x path)\n          (refs? d) (dorun (map-indexed (fn [i n] (enter-node! run n (conj path i))) x))\n          (= :C d) (meet! run x)\n          (v? d) (when x (case (first x)\n                           :cursor-cell (meet! run (second x))\n                           :row (enter-node! run (second x) path)\n                           nil))\n          :else nil)))\n\n(defn- enter-node!\n  \"W1. Pre-order: table order for slots; ordered repeated slots in order;\n   keyed structural rows in the byte order of the key; :window in register\n   order; installs and module stores by name; :set and :map by keys with\n   ties postponed; census and children not entered.\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (= :cursor-cells kind) nil\n      (child-task? ctx n) nil\n      (= :task kind)\n      (doseq [[i d x] (map vector (range) ds slots)]\n        (if (contains? #{7 12} i)\n          (doseq [child (sort-by-key! ctx #(first (:slots %)) x)]\n            (enter-node! run child (conj path i (first (:slots child)))))\n          (enter-slot! run d x (conj path i))))\n      (contains? keyed-structural kind)\n      (doseq [[k v] (sort-by-key! ctx first (partition 2 slots))]\n        (enter-slot! run (second ds) v (conj path k)))\n      (= :window kind)\n      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n      (= :set kind) (unordered! run n :set (vec slots) path)\n      (= :map kind) (unordered! run n :map (mapv vec (partition 2 slots)) path)\n      :else (dorun (map-indexed (fn [i [d x]] (enter-slot! run d x (conj path i))) (map vector ds slots))))))\n\n(defn- unordered!\n  \"The transformation: key every member by a local walk under the numbering\n   at this moment; members with a unique key are entered in key order; a run\n   of equal keys is one tie group, postponed to the run's queue (postponement\n   order: containers in walk order, groups within a container in key order).\n   A member's path is the container's path plus :member (there is no\n   canonical index into an unordered container); a group remembers its\n   container by identity.\"\n  [run container kind elems path]\n  (let [keyed (mapv (fn [e]\n                      ;; one unit per member keyed, so the number of key walks\n                      ;; (and of memo lookups, each a read of charged data) is charged\n                      (spend! (:ctx run) :work 1)\n                      [(local-run run (elem-item kind e) (conj path :member)) e]) elems)\n        groups (partition-by (comp :bytes first) (sort #(compare-bytes (:bytes (first %1)) (:bytes (first %2))) keyed))]\n    (when (and *trace* (= :n (:tag run)))\n      (println \"  [sort]\" path \"num\" @(:num run))\n      (doseq [g groups] (println \"    \" (if (= 1 (count g)) \"enter\" \"POSTPONE\") (mapv (fn [[r e]] [e (:spell r)]) g))))\n    (doseq [g groups]\n      (if (= 1 (count g))\n        (enter-slot! run :V (elem-item kind (second (first g))) (conj path :member))\n        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :container container :kind kind :path path\n                                   :key (:spell (first (first g))) :complete? (:complete? (first (first g)))\n                                   :elems (mapv second g)})))))\n\n(defn- fixpoint!\n  \"W3. Re-examine every postponed group in order under the current numbering;\n   repeat while a pass numbers a cursor cell and groups remain.\"\n  [run]\n  (loop []\n    (let [before (count @(:num run)) groups @(:groups run)]\n      (reset! (:groups run) [])\n      (doseq [{:keys [container kind elems path]} groups] (unordered! run container kind elems path))\n      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n\n(defn- unnumbered-cells [run kind e]\n  (let [num @(:num run)]\n    (set (remove #(contains? num %) (item-cells (:ctx run) :V (elem-item kind e))))))\n\n(defn- group-failure\n  \"T, the tie test. nil when the group's members are interchangeable: the\n   common key is complete, and the members' unnumbered cursor cells are\n   pairwise disjoint and occur in no member of another remaining group.\n   Otherwise the reason.\"\n  [run groups g]\n  (let [own (mapv #(unnumbered-cells run (:kind g) %) (:elems g))\n        others (reduce into #{} (for [h groups :when (not= (:id h) (:id g)) e (:elems h)]\n                                  (unnumbered-cells run (:kind h) e)))]\n    (cond (not (:complete? g)) :incomplete-key\n          (not= (reduce + (map count own)) (count (reduce into #{} own))) :shared-within-group\n          (some #(seq (set/intersection % others)) own) :shared-across-groups\n          :else nil)))\n\n(defn- resolve!\n  \"Postponed groups to completion: fixpoint, then the tie test on every\n   remaining group; all pass: enter them in listed order and repeat; any\n   fails: the root run refuses, a key run leaves them as residue.\"\n  [run]\n  (loop []\n    (fixpoint! run)\n    (let [groups @(:groups run) ctx (:ctx run)]\n      (when (seq groups)\n        (let [failing (vec (keep (fn [g] (when-let [why (group-failure run groups g)] (assoc g :why why))) groups))]\n          (when (and *trace* (= :n (:tag run)))\n            (println \"  [ties]\" (mapv (fn [g] [(:id g) (:path g) (:elems g) (:why g)]) (map #(assoc % :why (group-failure run groups %)) groups))))\n          (cond\n            (empty? failing)\n            ;; Interchangeable groups are independent of each other (their\n            ;; cells are confined), so all are entered before the next pass.\n            (do (reset! (:groups run) [])\n                (doseq [g groups e (:elems g)] (enter-slot! run :V (elem-item (:kind g) e) (conj (:path g) :member)))\n                (recur))\n            (:permissive ctx)\n            ;; Diagnostic only: enter the first group in listed order, then\n            ;; re-key the rest (what an unsound \"equal keys, host order\" rule does).\n            (do (reset! (:groups run) (vec (rest groups)))\n                (doseq [e (:elems (first groups))] (enter-slot! run :V (elem-item (:kind (first groups)) e) (conj (:path (first groups)) :member)))\n                (recur))\n            (= :n (:tag run))\n            (reset! (:refused run)\n                    {:kind :unresolved-cursor-cells\n                     :path (:path (first failing))\n                     :why (mapv :why failing)\n                     :cursor-cells (vec (sort (distinct (mapcat (fn [g] (mapcat #(unnumbered-cells run (:kind g) %) (:elems g))) failing))))})\n            :else nil))))))\n\n(defn- local-run\n  \"A key walk: the same procedure on one member from the enclosing run's\n   numbering, tag :u; its result is the member's key (spelling under its\n   final numbering, residue spelled [:tie K ...]) and whether it is complete.\n   Memoized on (item, numbering restricted to the item's cells, counter).\"\n  [run item path]\n  (let [ctx (:ctx run)\n        cells (item-cells ctx :V item)\n        num @(:num run)\n        start (if (= :u (:tag run)) @(:next run) 0)\n        mk [item (select-keys num cells) start]]\n    (or (get @(:memo ctx) mk)\n        (let [sub (new-run ctx num :u start)]\n          (spend! ctx :work (count cells))\n          (enter-slot! sub :V item path)\n          (resolve! sub)\n          (let [spell (spell-slot sub :V item path)\n                r {:spell spell :bytes (key-bytes! ctx spell) :complete? (empty? @(:groups sub))}]\n            (swap! (:counter ctx) update :local-runs (fnil + 0) 1)\n            (swap! (:memo ctx) assoc mk r)\n            r)))))\n\n;; -------------------------------------------------------------- spelling\n\n(defn- spell-cell [run c]\n  (let [[t k] (get @(:num run) c) ctx (:ctx run)]\n    (case t\n      :n [:cursor-cell [:n k]]\n      :u [:cursor-cell (if (:count-spelling ctx)\n                         [:u k (get (:ranks ctx) c) (get (:counts ctx) c)]\n                         [:u k (get (:ranks ctx) c)])]\n      (throw (ex-info \"spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n\n(defn- spell-slot [run d x path]\n  (spend! (:ctx run) :work 1)\n  (cond (ref? d) (spell-node run x path)\n        (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n        (= :C d) (spell-cell run x)\n        (v? d) (if (nil? x) x\n                   (case (first x)\n                     :cursor-cell (spell-cell run (second x))\n                     :row [:row (spell-node run (second x) path)]\n                     x))\n        :else x))\n\n(defn- spell-node\n  \"The spelling of a row under the run's final numbering: literals and\n   structural data as themselves (by reference), rows expanded in place,\n   keyed rows in key order, a :set or :map as the sorted vector of its\n   members' spellings with each surviving tie group as [:tie K ...].\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (= :cursor-cells kind) [:cursor-cells]\n      (child-task? ctx n) [:child]\n      (= :task kind)\n      (into [kind]\n            (map-indexed (fn [i [d x]]\n                           (if (contains? #{7 12} i)\n                             (sort-by-key! ctx #(nth % 1) (mapv #(spell-node run % (conj path i (first (:slots %)))) x))\n                             (spell-slot run d x (conj path i))))\n                         (map vector ds slots)))\n      (contains? keyed-structural kind)\n      (into [kind] (mapcat identity (sort-by-key! ctx first\n                                                  (mapv (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n                                                        (partition 2 slots)))))\n      (= :window kind)\n      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n      (contains? #{:set :map} kind)\n      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n            tied (filter #(identical? n (:container %)) @(:groups run))\n            tied-elems (set (mapcat :elems tied))\n            plain (keep (fn [e] (when-not (tied-elems e) (spell-slot run :V (elem-item kind e) (conj path :member)))) elems)\n            ties (map #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n        (into [kind] (sort-by-key! ctx identity (concat plain ties))))\n      :else (into [kind] (map-indexed (fn [i [d x]] (spell-slot run d x (conj path i))) (map vector ds slots))))))\n\n;; ------------------------------------------------------------- procedure\n\n(def ^:dynamic *numbering-opts*\n  \"Options for every run of the procedure in scope (root and install\n   children): :permissive, :count-spelling, :budget.\"\n  {})\n\n(defn discovery-numbering\n  \"Returns {:numbering {src -> :yin.k/cc-n} :used {...}} or {:refused {...}}.\n   Throws :resource-limit when a budget is exceeded, and a defect (never a\n   refusal) when the numbering is not total.\"\n  ([task] (discovery-numbering task *numbering-opts*))\n  ([task opts]\n   (let [census (nth (:slots task) 9)\n         ctx {:task task\n              :memo (atom {}) :cells-memo (atom {})\n              :budget (merge default-budget (:budget opts))\n              :counter (atom {})\n              :permissive (:permissive opts)\n              :count-spelling (not= false (:count-spelling opts))}\n         ;; gates first: the census's pair count before the bodies map is\n         ;; built, the depth scan before any recursive traversal\n         _ (spend! ctx :cursor-cells (quot (count (:slots census)) 2))\n         _ (depth-scan! ctx task)\n         bodies (into {} (map vec) (partition 2 (:slots census)))\n         ctx (assoc ctx :bodies bodies)\n         ctx (assoc ctx :ranks (body-ranks ctx bodies) :counts (occurrence-counts ctx task))\n         run (new-run ctx {} :n 1)]\n     (enter-node! run task [])\n     (resolve! run)\n     (if-let [r @(:refused run)]\n       {:refused r :used @(:counter ctx)}\n       (let [numbered (set (keys @(:num run))) declared (set (keys bodies))]\n         (when (seq @(:groups run)) (throw (ex-info \"residue after resolve\" {})))\n         (when (not= numbered declared)\n           (throw (ex-info \"numbering is not total\" {:missing (vec (sort (remove numbered declared)))\n                                                      :extra (vec (sort (remove declared numbered)))})))\n         {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))\n          :used @(:counter ctx)})))))\n","numLines":440,"startLine":82,"totalLines":1126}},"tool_result_meta":[{"id":"toolu_012dwgwMk5XZcM2Z87iB5zVw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
