rked census _ code installs waits parked-id result]\n        (:slots task)\n        base (reduce (fn [r [_ v]] (module/attach-module r v))\n                     (assoc (dissoc recv :yin.k/closes :yin.k/issued :yin.k/gate :yin.k/custody\n                                    :yin.k/recovery-waits :yin.k/recovery-parked :yin.k/recovery-cell-ids)\n                            :code {} :code-aliases {} :program nil)\n                     (sort-by #(str (key %)) code))\n        aliases (:code-aliases base)\n        used (atom (into fixed-resource-keys (keys (:resources base))))\n        identities (sort-by str (distinct (map #(first (:slots %)) (rows-of task :stream true))))\n        stream-keys (into {} (map (fn [identity] [identity (fresh-key! used)])) identities)\n        pairs (mapv vec (partition 2 (:slots census)))\n        cell-keys (into {} (map (fn [[c _]] [c (fresh-key! used)])) pairs)\n        bodies (into {} pairs)\n        stream-key #(get stream-keys (first (:slots %)))\n        parked-index (into {} (map vec) (partition 2 (:slots parked)))\n        cache (atom {})\n        resolving (atom #{})]\n    (letfn [(value\n              [v]\n              (case (first v)\n                :lit (second v)\n                :cursor-cell (engine/issue-ref base :cursor-ref (get cell-keys (second v)))\n                :row (row (second v))))\n            (built\n              [n coll expected]\n              (when (< (count coll) expected)\n                ;; Re-emit only on refusal to recover the decoded row's address.\n                (outcome! :yin.k/undecodable :host-collapse\n                          {:yin.k/path [(first (emit-node n {} {}))]}))\n              coll)\n            (row\n              [n]\n              (let [ss (:slots n)]\n                (case (:kind n)\n                  :vec (mapv value ss)\n                  :list (apply list (map value ss))\n                  :set (built n (into #{} (map value) ss) (count ss))\n                  :map (built n (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))\n                              (quot (count ss) 2))\n                  :prim (vm/primitive-function (get (:primitives base) (first ss)))\n                  :stream (engine/issue-ref base :stream-ref (stream-key n))\n                  :closure (let [[a entry params bindings store-of] ss]\n                             (module/lower-closure base\n                                                   (cond-> {:yin.k/binding :named\n                                                            :yin.k/format :yin.semantic/code\n                                                            :yin.k/segment a :yin.k/entry entry :yin.k/params params\n                                                            :yin.k/env (keyed bindings)}\n                                                     (some? store-of) (assoc :yin.k/store-of store-of))\n                                                   identity))\n                  :reified (values/continuation (:owner base) (assoc (payload (first ss)) :type :reified-continuation))\n                  :parked-ref (parked-record (first ss)))))\n            (keyed\n              [n]\n              (into {} (map (fn [[k x]] [k (value x)])) (partition 2 (:slots n))))\n            (env\n              [n]\n              (let [[b store-of] (:slots n)]\n                (cond-> (keyed b) (some? store-of) (assoc engine/store-of-key store-of))))\n            (k-of\n              [n]\n              (mapv (fn [f]\n                      (let [[a pc e w rd] (:slots f)]\n                        {:type :return :segment (get aliases a) :pc pc :env (env e) :window (keyed w) :rd rd}))\n                    (:slots n)))\n            (payload\n              [n]\n              (if (= :tail (:kind n))\n                (let [[a site k] (:slots n)]\n                  {:segment (get aliases a) :site site :k (k-of k) :deliver {:deliver :return}})\n                             (into {} (map (fn [[identity k]] [k (get handles identity)])) stream-keys)\n                             (into {} (map (fn [[c body]]\n                                             [(get cell-keys c) {:stream-id (stream-key (first (:slots body)))\n                                                                 :cursor (second (:slots body))}]))\n                                   pairs)\n                             (when-let [[req resp] link]\n                               {module/link-request-resource (get handles (first (:slots req)))\n                                module/link-response-resource (get handles (first (:slots resp)))}))\n            ;; a fenced rehydration carries the counter exactly, so the\n            ;; relift reproduces the published root; a resumption adopts\n            ;; max(local, carried)\n            machine (cond-> (assoc base :store store' :module-stores stores :parked parked' :installs installs'\n                                   :resources resources :env fe :free-env fe :window {} :k nil :control nil\n                                   :ready-queue []\n                                   :id-counter (if (:fenced? custody)\n                                                 id-counter\n                                                 (max (or (:id-counter base) 0) id-counter)))\n                      ;; resource key -> the carrier's cursor cell, so one\n                      ;; cell is one key and two cells two (UCF 7.7.4)\n                      (:fenced? custody)\n                      (assoc :yin.k/recovery-cell-ids (into {} (map (fn [[c k]] [k c])) cell-keys)))]\n        (with-custody\n          (case kind\n            :halted (assoc machine :halted? true :blocked? false :value (value result) :wait-set [])\n            :parked (assoc machine :halted? true :blocked? false :value (get parked' parked-id) :wait-set entries)\n            (assoc machine :halted? false :blocked? true :value :yin/blocked :wait-set entries))\n          custody kind root?)))))\n\n\n  [machine original]\n  (reduce (fn [root [path task]]\n            (reduce (fn [root [resource handle]]\n                      (if (satisfies? stream/IDaoStreamDescriptor handle)\n                        (assoc-in root (into path [:resources resource]) handle)\n                        root)) root (:resources task)))\n          machine (machines original)))\n\n\n(defn- run-cycle\n  \"One program cycle of the run, after tenure: the machine's internal\n   computation, replay below the frontier, the writer's emit, the\n   reader's live step.  The unsatisfied answers of the writer and the\n   reader ride the state as :step-unsatisfied; a run end anywhere\n   rides it as :run-end.\"\n  [state]\n  (let [_ (require-tenure! state)\n        m0 (:machine state)\n        m1 (if (and (= :running (vm/gate-mode m0)) (not (:halted? m0)))\n             (vm/run m0)\n             m0)\n        _ (require-tenure! state)\n        replay (reader/replay m1 {:control-outstanding?\n                                  (control-outstanding? state)})\n        m2 (:machine replay)\n        _ (require-tenure! state)\n        request! (fn [request] (require-tenure! state) (append-request! state request))\n        emit (writer/emit (guard-writes state m2) request!\n                          (fn [diagnostic]\n                            (require-tenure! state)\n                            (append-diagnostic! state diagnostic)))\n        m3 (restore-handles (:machine emit) m2)\n        live (reader/step m3 request!\n                          (fn [h op arg]\n                            (require-tenure! state)\n                            (observe! state h op arg)))\n        m4 (:machine live)]\n    (assoc state\n           :machine m4\n                    state (assoc renewed :holder holder)\n                    armed? (some? (:exit state))\n                    preparing? (nil? (get-in state [:exit :address]))]\n                (cond\n                  (:inbox-unavailable? state)\n                  (if (and armed? (not preparing?) (not= :program mode))\n                    (let [progressed (drain (step-exit-body state projection) mode)]\n                      (if (and (:inbox-unavailable? progressed) (= :yin.k/ok (:status progressed)))\n                        (with-status progressed (:status state) (:detail state))\n                        progressed))\n                    state)\n                  (and armed?\n                       (or (and (= :control mode) preparing?)\n                           (and (= :program mode) (not preparing?)))) state\n                  armed? (drain (step-exit-body state projection) mode)\n                  (or (= :control mode) (= :activating (:phase state)))\n                  (with-status state :yin.k/ok\n                    {:yin.k/occurrence (:occurrence state) :dao.lease/lease (:lease state)})\n                  :else (cycle-result (drain (run-cycle state) mode)))))))))))\n\n\n(defn- step-active\n  \"The held step under the catch: every seam the cycle runs through\n   answers an outcome and never throws (the seam contract of\n   `initial`), so a throw here is the cycle's own -- a tenure guard or\n   a program effect -- and it ends the run.  An uncertain journal\n   append is none of these: it unwinds untouched, and `step` stalls\n   everything on it.\"\n  [state mode]\n  (try (step-active-held state mode)\n       (catch #?(:cljd Object :clj Throwable :cljs :default) failure\n         (if (or (::journal-uncertain (ex-data failure)) (::inbox/refusal (ex-data failure)))\n           (throw failure)\n           (if (= :lease-bound (::cause (ex-data failure)))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '90,170p' src/cljc/yin/vm/semantic/frame.cljc; sed -n '90,135p' src/cljc/yin/vm/semantic/layout.cljc; sed -n '490,510p' src/cljc/yin/vm/semantic/layout.cljc; sed -n '850,875p' src/cljc/yin/vm/semantic/layout.cljc; sed -n '916,955p' src/cljc/yin/vm/semantic/layout.cljc; sed -n '105,150p' src/cljc/yin/vm/ucf/holder/export.cljc; sed -n '274,283p' src/cljc/yin/vm/ucf/holder/export.cljc; sed -n '603,625p' src/cljc/yin/vm/ucf/holder/export.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '90,170p' src/cljc/yin/vm/semantic/frame.cljc; sed -n '90,135p' src/cljc/yin/vm/semantic/layout.cljc; sed -n '490,510p' src/cljc/yin/vm/semantic/layout.cljc; sed -n '850,875p' src/cljc/yin/vm/semantic/layout.cljc; sed -n '916,955p' src/cljc/yin/vm/semantic/layout.cljc; sed -n '105,150p' src/cljc/yin/vm/ucf/holder/export.cljc; sed -n '274,283p' src/cljc/yin/vm/ucf/holder/export.cljc; sed -n '603,625p' src/cljc/yin/vm/ucf/holder/export.cljc\"","aggregated_output":"        k (:yin.k/k frame)\n        returns (when (vector? k) (mapv (fn [i] [(nth k i) [:yin.k/k i]]) (range (count k))))\n        all (into [[frame []]] returns)\n        envs (if act? all returns)]\n    (or\n      ;; S1-S4, globally before any dependent read.\n      (when-not (and (contains? #{:act :tail} (:yin.k/state frame))\n                     (closed? frame required [:yin.k/pending]))\n        (problem :frame-shape []))\n      (when-not (vector? k) (problem :k-shape [:yin.k/k]))\n      (some (fn [[f p]]\n              (when-not (and (closed? f [:yin.k/frame-type :yin.k/segment :yin.k/pc\n                                         :yin.k/env :yin.k/window :yin.k/rd] [])\n                             (= :return (:yin.k/frame-type f)))\n                (problem :k-shape p))) returns)\n      (some (fn [[f p]]\n              (when-not (and (map? (:yin.k/window f))\n                             (every? code/reg? (keys (:yin.k/window f))))\n                (problem :window-representation (conj p :yin.k/window)))) envs)\n      (some (fn [[f p]]\n              (when-not (env? (:yin.k/env f))\n                (problem :env-shape (conj p :yin.k/env)))) envs)\n      (when-not (map? (:yin.k/deliver frame)) (problem :deliver-shape [:yin.k/deliver]))\n      ;; C1-C3 across the entire continuation.\n      (some (fn [[f p]]\n              (when-not (contains? code-map (:yin.k/segment f))\n                (problem :segment (conj p :yin.k/segment)))) all)\n      (some (fn [[f p]]\n              (let [slot (if (and (empty? p) (not act?)) :yin.k/site :yin.k/pc)\n                    n (get f slot) v (get code-map (:yin.k/segment f))]\n                (cond\n                  (not (code/reg? n)) (problem :pc-kind (conj p slot))\n                  (not (and (< n (count v)) (or (= slot :yin.k/site) (pos? n))))\n                  (problem :pc-bounds (conj p slot))))) all)\n      (some (fn [[f p]]\n              (let [pc (:yin.k/pc f) bs (code/body-ranges (get code-map (:yin.k/segment f)))]\n                (when-not (= (code/body-index bs (dec pc)) (code/body-index bs pc))\n                  (problem :pc-body (conj p :yin.k/pc))))) envs)\n      (let [v (get code-map (:yin.k/segment frame))\n            site (if act? (dec (:yin.k/pc frame)) (:yin.k/site frame))\n            inst (nth v site) op (first inst) rd (code/rd inst)\n            d (:yin.k/deliver frame)]\n        (or\n          (if act?\n            (or\n              (when-not (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} op)\n                            (and (= :call op) (not (code/tail-call? inst))))\n                (problem :site [:yin.k/pc]))\n              (when-not (= rd (:yin.k/rd d)) (problem :destination [:yin.k/deliver :yin.k/rd]))\n              (when-not (= {:yin.k/deliver :rd :yin.k/rd rd} d) (problem :deliver [:yin.k/deliver]))\n              (window-defect frame v rd \"\" []))\n            (or\n              (when-not (code/tail-call? inst) (problem :site [:yin.k/site]))\n              (when-not (= {:yin.k/deliver :return} d) (problem :deliver [:yin.k/deliver]))))\n          (some (fn [[f p]]\n                  (let [fv (get code-map (:yin.k/segment f)) fi (nth fv (dec (:yin.k/pc f)))\n                        frd (:yin.k/rd f)]\n                    (or\n                      (when-not (and (= :call (first fi)) (not (code/tail-call? fi)))\n                        (problem :return-site (conj p :yin.k/pc)))\n                      (when-not (= frd (code/rd fi)) (problem :return-destination (conj p :yin.k/rd)))\n                      (window-defect f fv frd \"return-\" p)))) returns)\n          (some (fn [[f p]]\n                  (when (some vm/reserved-name? (keys (get-in f [:yin.k/env :yin.k/bindings])))\n                    (problem :reserved-name (conj p :yin.k/env :yin.k/bindings)))) envs)\n          (some (fn [[f p]]\n                  (let [names (lexical-names (get code-map (:yin.k/segment f)) (:yin.k/pc f))\n                        bindings (get-in f [:yin.k/env :yin.k/bindings])]\n                    (when-not (and (every? #(contains? bindings %) names)\n                                   (bindings= (apply dissoc bindings names)\n                                              (apply dissoc (:free-env task) names)))\n                      (problem :free-env-mismatch (conj p :yin.k/env :yin.k/bindings))))) envs)\n          (when-not (and (contains? #{:wait :captured :parked} context)\n                         (= (= :wait context) (contains? frame :yin.k/pending)))\n            (problem :pending-presence [:yin.k/pending]))\n          (when (= :wait context)\n            (let [reasons (case op\n                            :stream-next #{:next}\n                            :stream-put #{:put}\n                            :ffi-call #{:ffi :ffi-request}\n                            :call #{:next :put :ffi :ffi-request :link-request :link-response :install}\n  (reduce (fn [acc [pc x s]]\n            (let [b (code/body-index bodies pc)]\n              (if (contains? (nth acc b) x) acc (assoc-in acc [b x] s))))\n          (vec (repeat (count bodies) {}))\n          pairs))\n\n\n(defn correspondence\n  \"§4.3 static item 1: H with every `:push` removed corresponds one to one,\n   in order, with A. Answers `{:a->h [h-pc …] :h->a {h-pc a-pc}}`.\"\n  [h]\n  (reduce (fn [acc hpc]\n            (if (= :push (nth (nth h hpc) 0))\n              acc\n              (-> acc\n                  (update :a->h conj hpc)\n                  (assoc-in [:h->a hpc] (count (:a->h acc))))))\n          {:a->h [] :h->a {}}\n          (range (count h))))\n\n\n(def ^:private pushing-ops\n  \"The parse nodes whose children before the current one are pushed:\n   `:call` (the operator and earlier operands), `:ffi-call` (earlier\n   operands) and `:stream-put` (the target, while the value runs).\"\n  #{:call :ffi-call :stream-put})\n\n\n(defn- stack-layouts\n  \"§4.3 static item 2 for every pc of every body: `{pc [virtual …]}`,\n   bottom to top, over the parse tree's ancestors outermost first.\"\n  [v bodies]\n  (letfn [(walk\n            [out node pending]\n            (let [out (assoc out (:pc node) pending)\n                  pushes? (contains? pushing-ops (:op node))\n                  uses (when pushes? (code/uses (nth v (:pc node))))]\n              (reduce (fn [out [i child]]\n                        (walk out child (if pushes? (into pending (take i uses)) pending)))\n                      out\n                      (map-indexed vector (:children node)))))]\n    (reduce (fn [out body] (walk out (:expr body) [])) {} bodies)))\n\n\n(defn segment\n  \"The static facts of one admitted A vector `v`, for both kernels.\"\n\n(defn slices\n  \"§4.3's K slices of operand stack `st` under return frames whose bases\n   are `bases`, outermost first: `St[b(i-1), b(i))` per frame with\n   `b(-1) = 0`, then the current activation's `St[b(m-1), n)`.\"\n  [st bases]\n  (let [bounds (into [0] bases)]\n    (conj (mapv (fn [lo hi] (subvec st lo hi)) bounds (rest bounds))\n          (subvec st (peek bounds) (count st)))))\n\n\n(defn- slice-window\n  \"`(zipmap (stack-layout (dec pc)) slice)`; the two have equal length.\"\n  [cx seg pc slice]\n  (let [layout (stack-layout seg (dec pc))]\n    (when-not (= (count layout) (count slice))\n      (refuse! :yin.k/non-portable :stack-layout {:yin.k/pc pc :yin.k/layout layout :yin.k/slice (count slice)}))\n    (zipmap layout (map #(canonical-value cx %) slice))))\n\n\n(defn- stack-site\n        nil))))\n\n\n(defn- frame-prim\n  \"A frame's window and lexical bindings (§4.4: the free part is the\n   kernel's :free-env, never payload data).\"\n  [code a pc e w path]\n  (let [names (lexical-names (get code a) pc)]\n    (or (some (fn [[r y]] (value-prim code y (conj path :window r))) (partition 2 (:slots w)))\n        (some (fn [[sym y]] (when (contains? names sym) (value-prim code y (conj path :env sym))))\n              (partition 2 (:slots (first (:slots e))))))))\n\n\n(defn- state-prim\n  [code n path]\n  (let [kframes (fn [k]\n                  (some (fn [[i f]]\n                          (let [[a pc e w] (:slots f)]\n                            (frame-prim code a pc e w (conj path :k i))))\n                        (map-indexed vector (:slots k))))\n        [a pc e w k] (:slots n)]\n    (case (:kind n)\n      :act (or (frame-prim code a pc e w path) (kframes k))\n      :tail (kframes e)\n      nil)))\n\n(defn lower-defect\n  \"What a kernel of `kind` cannot hold, judged on decoded task `task`\n   before anything is attached: two carried A of one image (§4.1), install\n   children (not carried by this phase's layouts), a closure or\n   continuation in the free environment (§6.3), a retained FFI request\n   whose response pair the backend's re-park cannot preserve, and for the register\n   kernel a primitive function in the payload data of a wait or parked\n   state (a window, a lexical binding, or reached through them), which\n   its restore refuses as `:continuation-registers` (`vm/machine-data?`).\n   nil when it can.\"\n  [task kind]\n  (let [slots (:slots task)\n        code (nth slots 11)\n        collision (image-collision code kind)\n        free (free-env-procedure task)]\n    (cond\n      collision\n      (assoc {} :yin.k/status :yin.k/unsupported :yin.k/kind :ambiguous-image\n             :yin.k/image (first collision) :yin.k/segments (second collision))\n\n      (seq (nth slots 12))\n      (assoc {} :yin.k/status :yin.k/unsupported :yin.k/kind :installs)\n\n      free\n      (assoc {} :yin.k/status :yin.k/unsupported :yin.k/kind :free-env-value :yin.k/path free)\n\n      (some (fn [w] (= :ffi-request (first (:slots (second (:slots w))))))\n            (nth slots 13))\n      (assoc {} :yin.k/status :yin.k/unsupported :yin.k/kind :retained-ffi)\n\n      (= :register kind)\n      (when-let [path (or (some (fn [[i w]] (state-prim code (first (:slots w)) [:frames i]))\n                                (map-indexed vector (nth slots 13)))\n                          (some (fn [[p st]] (state-prim code st [:parked p]))\n                                (partition 2 (:slots (nth slots 8)))))]\n        (assoc {} :yin.k/status :yin.k/unsupported :yin.k/kind :continuation-registers :yin.k/path path))\n\n      :else nil)))\n\n\n\n\n(defn- first-refusal\n  [vm]\n  (some (fn [[path m]]\n          (when (seq (:ready-queue m))\n            {:yin.k/status :yin.k/not-quiescent\n             :yin.k/path path\n             :yin.k/ready (count (:ready-queue m))}))\n        (machines [] vm)))\n\n\n;; =============================================================================\n;; Entering exporting\n;; =============================================================================\n\n(defn enter\n  \"Enter exporting from `machine`.  Answers\n   `{:status :ok :machine m :record r}`: `m` is `machine` with the gate\n   `:exporting`, an empty wait set and no parked record, and `r` the\n   export record, holding the wait set in order, every parked record\n   (the row carrier carries them all, continuation §2.5), and the gate\n   to return to.  Otherwise answers the data outcome of the first\n   refusal, leaving `machine` as it was: `:yin.k/not-quiescent` for\n   queued work in the root or a child, a `:yin.k/non-portable` of kind\n   `:reason-mismatch` (naming the hold and the task path), or\n   `:yin.k/refused` for a machine that is already exporting or ended.\"\n  [machine]\n  (cond\n    (contains? #{:exporting :ended} (vm/gate-mode machine))\n    (refused :not-running)\n\n    :else\n    (or (first-refusal machine)\n        (some (fn [[path m]]\n                (when-some [h (refusal-at m)]\n                  (non-portable (assoc h :yin.k/path path))))\n              (machines [] machine))\n        {:status :ok\n         :machine (cond-> (assoc machine :yin.k/gate :exporting :wait-set [])\n                    (contains? machine :parked) (assoc :parked {}))\n         :record {:wait-set (vec (:wait-set machine))\n                  :parked (:parked machine)\n                  :gate (vm/gate-mode machine)\n                  :served {}}})))\n\n(defn- kind-of\n  \"The lifted task's kind, by the lift's own rule.\"\n  [m]\n  (let [value (:value m)]\n    (cond\n      (and (map? value) (= :parked-continuation (:type value))\n           (contains? (:parked m) (:id value))) :parked\n      (seq (:wait-set m)) :blocked\n      :else :halted)))\n\n    (:recovered? record)\n    (refused :restarted)\n\n    (not= :exporting (vm/gate-mode machine))\n    (refused :not-exporting)\n\n    (and (contains? machine :yin.k/custody)\n         (some? (:now tenure))\n         (some? (:bound tenure))\n         (>= (:now tenure) (:bound tenure)))\n    (refused :tenure-ended)\n\n    (and (contains? machine :yin.k/custody)\n         (not (and (some? (:now tenure))\n                   (some? (:bound tenure))\n                   (true? (:live tenure)))))\n    (refused :tenure-unconfirmed)\n\n    (not (every? (comp not-appended? :append) attempts))\n    (refused :offer-possibly-accepted)\n\n    :else\n    (let [m (reinstated machine record)\n","exit_code":0,"status":"completed"}}
