n\n(deftest the-old-inspector-distinguishes-fork-and-exclusive-baselines\n  (doseq [engine s/engines]\n    (testing (name engine)\n      (let [t (s/toy)\n            peer (s/served-peer t)\n            [parked _] (s/parked-reader engine)\n            fork (s/lift parked t peer)\n            exclusive (s/lift parked t peer (s/header 0 nil #{}))\n            bf (checkpoint/inspect (:address fork) (:bytes fork))\n            be (checkpoint/inspect (:address exclusive) (:bytes exclusive))]\n        (is (= :ok (:status fork)) (pr-str fork))\n        (is (= :ok (:status exclusive)) (pr-str exclusive))\n        (is (true? (:yin.k/fork bf)) \"the baseline names the role\")\n        (is (empty? (:yin.k/ops bf)) \"a fork carries no operation id\")\n        (is (not (contains? bf :yin.k/occurrence)))\n        (is (not (contains? be :yin.k/fork)))\n        (is (= s/occurrence (:yin.k/occurrence be)))))))\n\n\n(deftest the-old-inspector-preserves-a-halted-results-origin\n  (doseq [engine s/engines]\n    (testing (name engine)\n      (let [t (s/toy)\n            peer (s/served-peer t)\n            fork (s/lift (s/halted-with engine (s/lit 42)) t peer)\n            exclusive (s/lift (s/halted-with engine (s/lit 42)) t peer\n                              {:yin.k/origin s/origin\n                               :yin.k/occurrence s/occurrence\n                               :yin.k/arbitration s/arbitration\n                               :yin.k/next-op-seq 3\n                               :yin.k/enrolled #{}})\n            bf (checkpoint/inspect (:address fork) (:bytes fork))\n            be (checkpoint/inspect (:address exclusive) (:bytes exclusive))]\n        (is (= :halted (:yin.k/kind bf)))\n        (is (true? (:yin.k/fork bf)))\n        (is (= :halted (:yin.k/kind be)))\n        (is (= s/origin (:yin.k/origin be)))))))\n1929:            (if (seq grants)\n1930:              (accept state records defect (peek grants))\n1935:                    (if (or (:dao.lease/lease entry) (never-granted-again? entry))\n2159:   and the release has been carried, so the closure is the grantor's\n2279:              (with-status :yin.k/awaiting-grant\n2296:      ;; a valid blocked or parked root answers awaiting-grant at\n2298:      (= :yin.k/awaiting-grant (:yin.k/status r))\n2373:   renew, reconcile grants, and finish established control brackets. Never lower,\n2517:  \"The recovery of a holder: a journaled grant never restores\n2523:        {:keys [occurrence lease]} (:grant folded)\n2528:        _ (check! (some? bytes) \"the checkpoint of the granted occurrence\"\n2635:  \"The recovery of a candidate whose journal holds no grant and no\n2673:   journaled grant (never one that restores execution) releases and\n2685:                     (or (nil? (:grant folded))\n2686:                         (> (:index mint) (get-in folded [:grant :index])))\n2693:                             (if (and (:grant folded)\n2705:                            (or (= :yin.k/first (:role mint)) (nil? (:grant folded))))\n2713:                       (some? (:grant folded))\n2845:                                        (some? (:granted-at holder)))\n2846:                               (let [granted (base (:granted-at holder))\n2847:                                     renewed (base (or (:last-renewal-at holder) (:granted-at holder)))\n2848:                                     duration-bound (+ (max granted renewed)\n2849:                                                       (base (:dao.lease/duration (:grant holder))))]\n2850:                                 (if-some [cap (get-in holder [:grant :dao.lease/max])]\n2851:                                   (min duration-bound (+ granted (base cap)))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('test/yin/vm/ucf/fencing_rows_test.cljc');s=p.read_text();s=s.replace('(is (= id (nth (:slots pending) 3)) \\\"the id rides the bytes unchanged\\\")','(is (= id (nth (:slots pending) (case reason :put 3 :ffi-request 6 :link-request 7)))\\\\n            \\\"the id rides the bytes unchanged\\\")');p.write_text(s)\np=Path('test/yin/vm/ucf/compose_test.cljc');s=p.read_text();s+='''\n\n(deftest the-source-index-is-read-from-the-composition-test\n  (let [calls (atom 0)\n        c (assoc (get (fork-world) ::compose/composition)\n                 :source-index (fn [] (swap\"'! calls inc) {}))\n        c (compose/source c \"h1\"\n                          (merge (holder-seams \"prog-index\" {})\n                                 {:machine (parked-reader-over (int-stream \"prog-index\"))}))\n        c (reduce (fn [c _] (compose/step c)) c (range 8))\n        st (get-in c [:holders \"h1\"])]\n    (is (pos? @calls) \"the driver'\"'s source index comes from the composition\\\")\n    (is (= :yin.k/unsatisfied (:status st)))\n    (is (= :incomplete (get-in st [:detail :yin.k/discovery])))\n    (is (nil? (:machine st)))\n    (is (empty? (inbound-requests (get-in c [:inbounds \\\"h1\\\"]) :yin.k/offer)))\n    (compose/close\"'! c)))\n'\"''';p.write_text(s)\nPY\nclojure -M:test -e :slow -n yin.vm.ucf.compose-test -n yin.vm.ucf.compose-rows-test -n yin.vm.ucf.fencing-rows-test -n yin.vm.ucf.handoff-v2-authority-test > target/7c-rebase3.log 2>&1\"","aggregated_output":"","exit_code":1,"status":"failed"}}
