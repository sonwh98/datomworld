/vm/ucf/ledger_test.cljc\ntest/yin/vm/ucf/rows_test.cljc\ntest/yin/vm/ucf/handoff_v2_walker_test.cljc\ntest/yin/vm/ucf/compose_test.cljc\ntest/yin/vm/ucf/checkpoint_fixtures.cljc\ntest/yin/vm/ucf/handoff_v2_authority_test.cljc\ntest/yin/vm/ucf/authority_test.cljc\ntest/yin/vm/ucf/remote_test.cljc\ntest/yin/vm/ucf/safepoint_harness_test.cljc\ntest/yin/vm/ucf/ledger_fixture_test.cljc\ntest/yin/vm/ucf/stage_e_process_test.clj\ntest/yin/vm/ucf/durability_test.cljc\ntest/yin/vm/ucf/handoff_v2_gates_test.cljc\ntest/yin/vm/ucf/stage_e_scenarios.cljc\ntest/yin/vm/ucf/handoff_v2_values_test.cljc\ntest/yin/vm/ucf/compose_rows_test.cljc\ntest/yin/vm/ucf/handoff_v2_layout_test.cljc\ntest/yin/vm/ucf/handoff_test.cljc\ntest/yin/vm/ucf/v2_support.cljc\ntest/yin/vm/ucf/scalar_round_trip_test.cljc\ntest/yin/vm/ucf/checkpoint_test.cljc\ntest/yin/vm/ucf/fencing_rows_test.cljc\ntest/yin/vm/ucf/rows_support.cljc\ntest/yin/vm/ucf/stage_e_peer.cljc\ntest/yin/vm/ucf/handoff_v1_test.cljc\ntest/yin/vm/ucf/handoff_v2_holder_test.cljc\ntest/yin/vm/ucf/handoff_v2_validity_test.cljc\ntest/yin/vm/ucf/ledger_fixtures.cljc\ntest/yin/vm/ucf_test.cljc\ntest/yin/vm/ucf/custody_test.cljc\ntest/yin/vm/ucf/holder/export_test.cljc\ntest/yin/vm/ucf/holder/evidence_test.cljc\ntest/yin/vm/ucf/holder/writer_test.cljc\ntest/yin/vm/ucf/holder/driver_test.cljc\ntest/yin/vm/ucf/holder/reader_test.cljc\ntest/yin/vm/ucf/authority/input_test.cljc\ntest/yin/vm/ucf/authority/completion_test.cljc\ntest/yin/vm/ucf/authority/completion_fold_test.cljc\ntest/yin/vm/ucf/authority/inherited_test.cljc\ntest/yin/vm/ucf/authority/grant_test.cljc\ntest/yin/vm/ucf/authority/admission_test.cljc\ntest/yin/vm/ucf/authority/front_test.cljc\ntest/yin/vm/ucf/authority/reclaim_test.cljc\n","exit_code":0,"status":"completed"}}
