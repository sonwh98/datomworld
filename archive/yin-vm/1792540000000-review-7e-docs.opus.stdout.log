:yin.k/origin]))\n1202\t        (check-origin! c))\n1203\t    (do (doseq [k [:yin.k/policy :yin.k/occurrence :yin.k/arbitration :yin.k/next-op-seq]\n1204\t                :when (not (contains? c k))]\n1205\t          (custody-refuse! :missing-header [:custody k]))\n1206\t        (when-not (= :yin.k/exclusive (get c :yin.k/policy))\n1207\t          (custody-refuse! :policy [:custody :yin.k/policy]))\n1208\t        (when (nil? (get c :yin.k/occurrence)) (custody-refuse! :nil-occurrence [:custody :yin.k/occurrence]))\n1209\t        (when-not (custody/occurrence? (get c :yin.k/occurrence))\n1210\t          (custody-refuse! :malformed-occurrence [:custody :yin.k/occurrence]))\n1211\t        (let [arb (get c :yin.k/arbitration)]\n1212\t          (when-not (and (map? arb) (some? (get arb :dao.stream/identity)) (map? (get arb :dao.stream/descriptor)))\n1213\t            (custody-refuse! :malformed-arbitration [:custody :yin.k/arbitration])))\n1214\t        (let [n (get c :yin.k/next-op-seq)]\n1215\t          (when-not (custody/exact? n) (custody-refuse! :inexact [:custody :yin.k/next-op-seq]))\n1216\t          (when (and (not (contains? c :yin.k/origin)) (not (cbor/num= 0 n)))\n1217\t            (custody-refuse! :first-export-counter [:custody :yin.k/next-op-seq])))\n1218\t        (when (contains? c :yin.k/origin) (check-origin! c)))))\n1219\t\n1220\t\n1221\t(defn- check-op-id!\n1222\t  \"One carried id against the root context: its shape, an origin present,\n1223\t   never the root's own occurrence, below the root counter (checkpoint.cljc's\n1224\t   check-op-id!, verbatim).\"\n1225\t  [ctx op-id p]\n1226\t  (when-not (and (map? op-id) (= 2 (count op-id))\n1227\t                 (custody/occurrence? (get op-id :yin.k/occurrence))\n1228\t                 (contains? op-id :yin.k/seq))\n1229\t    (custody-refuse! :malformed-op-id p))\n1230\t  (when-not (custody/exact? (get op-id :yin.k/seq)) (custody-refuse! :inexact (conj p :yin.k/seq)))\n1231\t  (when-not (contains? ctx :yin.k/origin) (custody-refuse! :op-id-without-origin p))\n1232\t  (when (cbor/content= (get op-id :yin.k/occurrence) (get ctx :yin.k/occurrence))\n1233\t    (custody-refuse! :op-id-own-occurrence p))\n1234\t  ;; a :halted root has no counter, so no id can be below it\n1235\t  (when-not (and (contains? ctx :yin.k/next-op-seq)\n1236\t                 (neg? (cbor/num-compare (get op-id :yin.k/seq) (get ctx :yin.k/next-op-seq))))\n1237\t    (custody-refuse! :op-seq-range (conj p :yin.k/seq))))\n1238\t\n1239\t\n1240\t(defn- wire-slot\n1241\t  \"A V slot as the wire holds it: a [:row n] is [:row id].\"\n1242\t  [x]\n1243\t  (if (and (vector? x) (= :row (first x))) [:row (first (emit-node (second x) {} {}))] x))\n1244\t\n1245\t\n1246\t(defn- task-ops\n1247\t  \"[path op-id intent] of every id the waits of task carry, then of each\n1248\t   install child in carried (module-name) order, in the root's context.\n1249\t   Checks each task's kind and role, each :install pending's install row,\n1250\t   and that a child's custody slot is nil.\"\n1251\t  [ctx task role path]\n1252\t  (let [[_ _ kind role' _ _ _ _ _ _ _ _ installs waits] (:slots task)\n1253\t        names (into #{} (map #(first (:slots %))) installs)]\n1254\t    (when-not (contains? #{:blocked :parked :halted} kind) (custody-refuse! :kind (conj path :kind)))\n1255\t    (when-not (= role role') (custody-refuse! :role (conj path :role)))\n1256\t    (into (into []\n1257\t                (keep-indexed\n1258\t                  (fn [i w]\n1259\t                    (let [ss (:slots (second (:slots w)))\n1260\t                          reason (first ss)\n1261\t                          p (conj path :frames i)]\n1262\t                      (when (and (= :install reason) (not (contains? names (second ss))))\n1263\t                        (custody-refuse! :incomplete-install p))\n1264\t                      (when-let [[t payload o] (get write-slots reason)]\n1265\t                        (when-some [op-id (nth ss o)]\n1266\t                          (let [p (conj p :op-id)]\n1267\t                            (when (::fork ctx) (custody-refuse! :fork-op-id p))\n1268\t                            (check-op-id! ctx op-id p)\n1269\t                            [p op-id [:yin.k/append (first (:slots (nth ss t))) (wire-slot (nth ss payload))]]))))))\n1270\t                waits)\n1271\t          (mapcat (fn [inst]\n1272\t                    (let [[mn _ _ _ child] (:slots inst)\n1273\t                          p (conj path :installs mn)]\n1274\t                      (when (some? (nth (:slots child) 16)) (custody-refuse! :child-header (conj p :custody)))\n1275\t                      (task-ops ctx child :child p))))\n1276\t          installs)))\n1277\t\n1278\t\n1279\t(defn custody-baseline\n1280\t  \"The operation baseline of root task (decoded, or abstract before emit),\n1281\t   or the first refusal thrown as ex-data {:yin.k/status :yin.k/undecodable\n1282\t   :yin.k/kind :yin.k/path}. Answers {:yin.k/kind k :yin.k/ops {op-id\n1283\t   digest}} plus the slot's :yin.k/occurrence, :yin.k/origin,\n1284\t   :yin.k/arbitration and :yin.k/next-op-seq, or :yin.k/fork true for a nil\n1285\t   slot, whose tree carries no id. digest is the BLAKE3 hex of the canonical\n1286\t   bytes of [:yin.k/append target-identity payload], the payload as the wire\n1287\t   slot holds it ([:lit x], [:row id], or a :link-request's plain envelope).\"\n1288\t  [task]\n1289\t  (let [slots (:slots task) kind (nth slots 2) c (nth slots 16) fork? (nil? c)]\n1290\t    (when-not (contains? #{:blocked :parked :halted} kind) (custody-refuse! :kind [:kind]))\n1291\t    (when-not fork? (check-root-custody! c kind))\n1292\t    (let [ctx (cond-> (select-keys c [:yin.k/occurrence :yin.k/origin :yin.k/next-op-seq]) fork? (assoc ::fork true))\n1293\t          ops (reduce (fn [acc [p op-id in]]\n1294\t                        (let [k (cbor/content-key op-id)]\n1295\t                          (when (contains? (:seen acc) k) (custody-refuse! :duplicate-op-id p))\n1296\t                          (-> acc (update :seen conj k)\n1297\t                              (assoc-in [:ops op-id] (jing/digest-bytes :blake3 (cbor/encode in))))))\n1298\t                      {:seen #{} :ops {}}\n1299\t                      (task-ops ctx task :root []))]\n1300\t      (cond-> (merge (select-keys c [:yin.k/occurrence :yin.k/origin :yin.k/arbitration :yin.k/next-op-seq])\n1301\t                     {:yin.k/kind kind :yin.k/ops (:ops ops)})\n1302\t        fork? (assoc :yin.k/fork true)))))\n1303\t\n1304\t\n1305\t(defn pack-address\n1306\t  \"The storage identity of a carrier: the BLAKE3 segment address of its\n1307\t   canonical bytes, distinct from the semantic root id it carries (§3.3).\"\n1308\t  [wire]\n1309\t  (jing/segment-key wire))\n1310\t\n1311\t\n1312\t;; =============================================================================\n1313\t;; Task transport (continuation design §7): lift-task and lower-task\n1314\t;; =============================================================================\n1315\t;;\n1316\t;; The lift walks a quiescent semantic-register machine into the abstract\n1317\t;; task the codec above emits: waits, parked records, the store, module\n1318\t;; stores, the free environment, the result and install children, every\n1319\t;; value classified as [:lit x], [:row n] or [:cursor-cell source]. A\n1320\t;; cursor cell's source is the resource id of a cursor reference, or\n1321\t;; [response-resource position] for a link wait's kept response cursor,\n1322\t;; so one resource reached twice is one cursor cell. The lower decodes the\n1323\t;; carrier (gate to frames, §3.3), checks pendings, dependencies and\n1324\t;; custody for every task of the tree, and only then attaches streams and\n1325\t;; restores state. Restoration delivers nothing, runs nothing.\n1326\t\n1327\t(defn- outcome!\n1328\t  [status kind data]\n1329\t  (throw (ex-info \"Task transport refused\"\n1330\t                  (merge data (c