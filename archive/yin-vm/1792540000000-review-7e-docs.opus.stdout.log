{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SARcTL1L5C5PSiQfxwyRAW","type":"tool_result","content":"1640\t(defn- lift-task*\n1641\t  [m serve! opts role]\n1642\t  (when (seq (:ready-queue m))\n1643\t    (outcome! :yin.k/not-quiescent nil {:yin.k/ready (count (:ready-queue m))}))\n1644\t  (when-some [h (unliftable-hold m)]\n1645\t    (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/hold h}))\n1646\t  (when (some? (:control m))\n1647\t    (outcome! :yin.k/not-at-safepoint nil {:yin.k/pc (get-in m [:control :pc])}))\n1648\t  (let [value (:value m)\n1649\t        active? (and (map? value) (= :parked-continuation (:type value)) (contains? (:parked m) (:id value)))\n1650\t        kind (cond active? :parked\n1651\t                   (seq (:wait-set m)) :blocked\n1652\t                   (engine/halted-with-empty-queue? m) :halted\n1653\t                   :else (outcome! :yin.k/not-at-safepoint nil {}))\n1654\t        ;; §6.3: the explicit argument overrides the kernel's retained field\n1655\t        free-env (cond (some? (:free-env opts)) (:free-env opts)\n1656\t                       (some? (:free-env m)) (:free-env m)\n1657\t                       :else (outcome! :yin.k/non-portable :missing-free-env {}))\n1658\t        ctx {:m m :serve! serve! :serve-keyed (:serve-keyed opts) :path (or (:path opts) [])\n1659\t             :acc (atom {:streams {} :cells {} :stores #{} :segments #{} :contexts #{}})}\n1660\t        free-node (bindings-node ctx free-env)\n1661\t        waits (mapv (fn [e] (node :wait [(state-node ctx e) (pending-node ctx e)])) (:wait-set m))\n1662\t        parked (node :parked-table (mapcat (fn [[p rec]] [p (state-node ctx rec)]) (:parked m)))\n1663\t        store (store-node ctx (:store m))\n1664\t        result (when (= :halted kind) (lift-value ctx value))\n1665\t        installs (mapv (fn [[mn inst]] (install-node ctx mn inst opts)) (sort-by #(str (key %)) (:installs m)))\n1666\t        module-stores (module-store-nodes ctx)\n1667\t        acc @(:acc ctx)\n1668\t        segments (:segments acc)\n1669\t        code (into {} (map (fn [a]\n1670\t                             (if-some [v (get-in m [:code (get (:code-aliases m) a) :vector])]\n1671\t                               [a v]\n1672\t                               (outcome! :yin.k/unsatisfied nil {:yin.k/segment a}))))\n1673\t                   segments)\n1674\t        _ (discharge! ctx code)\n1675\t        index (or (:source-index opts) {})\n1676\t        missing-trees (into #{} (remove #(seq (get index %))) segments)\n1677\t        _ (when (seq missing-trees)\n1678\t            (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing-trees}}))\n1679\t        requires {:yin.k/cursor-profiles (if (seq (:cells acc)) remote/cursor-profiles #{})\n1680\t                  :yin.k/segments segments\n1681\t                  :yin.k/trees (select-keys index segments)}\n1682\t        task (node :task [3 profile kind role (or (:id-counter m) 0) free-node store module-stores parked\n1683\t                          (node :cursor-cells (mapcat identity (:cells acc))) requires code installs waits\n1684\t                          (when (= :parked kind) (:id value)) result nil])]\n1685\t    ;; §3.3: a frame the evaluator itself minted that fails is inconsistent\n1686\t    (when-let [d (validate-frames task)]\n1687\t      (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/defect d}))\n1688\t    task))\n1689\t\n1690\t\n1691\t(declare task-tree)\n1692\t\n1693\t\n1694\t(defn- header-custody\n1695\t  \"The root's custody slot from the caller's header, by kind: blocked or\n1696\t   parked takes the occurrence, arbitration, counter and the exclusive\n1697\t   policy, and the origin when the header names one; halted the origin\n1698\t   alone (an empty map without one, which the grammar refuses). A nil\n1699\t   value is an absent key (handoff.cljc's header-of).\"\n1700\t  [header kind]\n1701\t  (into {}\n1702\t        (filter (comp some? val))\n1703\t        (if (= :halted kind)\n1704\t          (select-keys header [:yin.k/origin])\n1705\t          (assoc (select-keys header [:yin.k/occurrence :yin.k/arbitration :yin.k/next-op-seq :yin.k/origin])\n1706\t                 :yin.k/policy :yin.k/exclusive))))\n1707\t\n1708\t\n1709\t(defn- protect!\n1710\t  \"Every retained write of the tree under the header's enrolled set (UCF\n1711\t   7.4.3, 7.7.8; handoff.cljc's protected!): an enrolled target without an\n1712\t   operation id is :unprotected-pending, an id on an unenrolled target is\n1713\t   :yin.k/unsatisfied naming the stream.\"\n1714\t  [task enrolled]\n1715\t  (doseq [[t _] (task-tree task :root)\n1716\t          w (nth (:slots t) 13)]\n1717\t    (let [ss (:slots (second (:slots w)))]\n1718\t      (when-let [[ti _ oi] (get write-slots (first ss))]\n1719\t        (let [identity (first (:slots (nth ss ti)))\n1720\t              enrolled? (contains? enrolled identity)\n1721\t              carried? (some? (nth ss oi))]\n1722\t          (cond\n1723\t            (and enrolled? (not carried?))\n1724\t            (outcome! :yin.k/non-portable :unprotected-pending {:dao.stream/identity identity})\n1725\t            (and carried? (not enrolled?))\n1726\t            (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})\n1727\t            :else nil))))))\n1728\t\n1729\t\n1730\t(defn lift-task\n1731\t  \"The lift of §7.1: quiescent semantic-register machine m as a version-3\n1732\t   carrier, or a refusal thrown as ex-data {:yin.k/status :yin.k/kind}.\n1733\t   serve! is the exporter's remote-table entry (yin.vm.ucf.remote).\n1734\t   opts: :free-env, the task's initial free environment (default: the\n1735\t   kernel's retained :free-env field; the explicit value overrides it);\n1736\t   :source-index, {A #{tree-address}} the composition knows (§6.1), which\n1737\t   must cover every carried segment; :budget, the numbering budget;\n1738\t   :header, the exclusive custody header (occurrence, arbitration,\n1739\t   next-op-seq, origin when the task has a predecessor, and\n1740\t   :yin.k/enrolled, the enrolled stream identities, a lift input that\n1741\t   never travels); :serve-keyed, (f [task-path resource-id] handle), which\n1742\t   replaces serve! and is asked once per resource of each task, the task\n1743\t   path being the install names from the root ([] for the root itself),\n1744\t   so a caller can retain each answer under its key (holder.export's\n1745\t   record). No header is the fork: custody nil. A header writes the\n1746\t   root's slot by kind (header-custody), refuses :op-seq-exhausted at\n1747\t   2^52-1 on a blocked or parked root, and protects every retained write\n1748\t   of the tree (protect!). Before emitting, the lift runs custody-baseline\n1749\t   over the task, so it never emits a carrier the inspector refuses.\"\n1750\t  ([m serve!] (lift-task m serve! {}))\n1751\t  ([m serve! opts]\n1752\t   (let [opts (or opts {})\n1753\t         header (:header opts)\n1754\t         task (lift-task* m serve! opts :root)\n1755\t         kind (nth (:slots task) 2)\n1756\t         task (if (nil? header)\n1757\t                task\n1758\t                (let [n (:yin.k/next-op-seq header)]\n1759\t                  (when (and (not= :halted kind) (cbor/numeric? n) (cbor/num= n max-exact))\n1760\t                    (outcome! :yin.k/non-portable :op-seq-exhausted {:yin.k/next-op-seq n}))\n1761\t                  (protect! task (or (:yin.k/enrolled header) #{}))\n1762\t                  (assoc-in task [:slots 16] (header-custody header kind))))]\n1763\t     (custody-baseline task)\n1764\t     (emit task (merge default-budget (:budget opts))))))\n1765\t\n1766\t\n1767\t(def ^:private fixed-resource-keys\n1768\t  #{vm/call-in-stream-key vm/call-out-stream-key vm/call-out-cursor-key\n1769\t    module/link-request-resource module/link-response-resource})\n1770\t\n1771\t\n1772\t(defn- fresh-key!\n1773\t  [used]\n1774\t  (loop [n (inc (count @used))]\n1775\t    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n1776\t      (if (contains? @used k) (recur (inc n)) (do (swap! used conj k) k)))))\n1777\t\n1778\t\n1779\t(defn- rows-of\n1780\t  \"Every row of kind under n; install children too unless own-only.\"\n1781\t  [n kind own-only?]\n1782\t  (let [out (atom [])]\n1783\t    (letfn [(visit\n1784\t              [n]\n1785\t              (when (= kind (:kind n)) (swap! out conj n))\n1786\t              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n1787\t                (cond\n1788\t                  (and (ref? d) (= :task (:kind x))) (when-not own-only? (visit x))\n1789\t                  (ref? d) (visit x)\n1790\t                  (refs? d) (run! visit x)\n1791\t                  (and (value-slot? d) (vector? x) (= :row (first x))) (visit (second x))\n1792\t                  :else nil)))]\n1793\t      (visit n)\n1794\t      @out)))\n1795\t\n1796\t\n1797\t(defn- task-tree\n1798\t  \"[task role] for the root and every install child, pre-order.\"\n1799\t  [task role]\n1800\t  (into [[task role]] (mapcat #(task-tree (nth (:slots %) 4) :child)) (nth (:slots task) 12)))\n1801\t\n1802\t\n1803\t(defn- check-stores!\n1804\t  \"Step 7's task context, beside X1: no root or module store key is a\n1805\t   reserved name (Rule R), refused here rather than by restore's store-put.\"\n1806\t  [_recv task _role]\n1807\t  (let [[_ _ _ _ _ _ store module-stores] (:slots task)]\n1808\t    (doseq [s (cons store (map #(second (:slots %)) module-stores))\n1809\t            k (take-nth 2 (:slots s))]\n1810\t      (when (vm/reserved-name? k)\n1811\t        (outcome! :yin.k/undecodable :reserved-name {:yin.k/role :store-key :yin.k/name k})))))\n1812\t\n1813\t\n1814\t(defn- attaches?\n1815\t  \"The receiving kernel admits vector v (its loader's validation), under\n1816\t   address a when a is given.\"\n1817\t  [recv v a]\n1818\t  (try (let [r (module/attach-module recv v)] (or (nil? a) (contains? (:code-aliases r) a)))\n1819\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _e false)))\n1820\t\n1821\t\n1822\t(defn- check-install!\n1823\t  \"One install record: a phase the engine holds a carried child in, the\n1824\t   retained response link-install reads (status, manifest naming this\n1825\t   module, exports) with the image spawn-child loads, the response's link\n1826\t   id equal to the row's parent (the engine settles only the response of\n1827\t   its own link), the image the manifest names (continuation §11 Q3: the\n1828\t   manifest's :yin.semantic/code derivation record is the response's\n1829\t   :derivation, from the manifest's tree to the image's A), and a child\n1830\t   that is blocked: the engine links a halted child in the sweep it\n1831\t   halts in.\"\n1832\t  [recv inst]\n1833\t  (let [[mn phase parent response child] (:slots inst)\n1834\t        manifest (when (map? response) (:manifest response))\n1835\t        child-kind (nth (:slots child) 2)]\n1836\t    (when-not (contains? #{:running :parked} phase)\n1837\t      (outcome! :yin.k/undecodable :install-phase {:yin.k/name mn :yin.k/phase phase}))\n1838\t    (when-not (and (map? response) (= :ok (:status response)) (map? manifest)\n1839\t                   (= mn (:yin.module/name manifest))\n1840\t                   (coll? (:yin.module/exports manifest)) (every? symbol? (:yin.module/exports manifest))\n1841\t                   (map? (:image response)) (attaches? recv (:value (:image response)) nil))\n1842\t      (outcome! :yin.k/undecodable :install-response {:yin.k/name mn}))\n1843\t    (when-not (and (some? parent) (= parent (:yin.link/id response)))\n1844\t      (outcome! :yin.k/undecodable :install-link-id {:yin.k/name mn}))\n1845\t    (let [record (:derivation response)]\n1846\t      (when-not (and (map? record)\n1847\t                     (= (jing/segment-key record) (get-in manifest [:yin.module/derivations :yin.semantic/code]))\n1848\t                     (= (:yin.ledger/input record) (:yin.module/tree manifest))\n1849\t                     (= (:yin.ledger/output record) (jing/segment-key (:value (:image response)))))\n1850\t        (outcome! :yin.k/undecodable :install-image {:yin.k/name mn})))\n1851\t    (when-not (= :blocked child-kind)\n1852\t      (outcome! :yin.k/undecodable :install-child {:yin.k/name mn :yin.k/task-kind child-kind}))))\n1853\t\n1854\t\n1855\t(defn- check-pendings!\n1856\t  \"Step 8, pending and operations: role, kind, parked id, every :install\n1857\t   pending names a carried install, every install record.\"\n1858\t  [recv task role]\n1859\t  (let [[_ _ kind role' _ _ _ _ parked _ _ _ installs waits parked-id] (:slots task)]\n1860\t    (when-not (= role role') (outcome! :yin.k/undecodable :role {:yin.k/role role'}))\n1861\t    (let [names (into #{} (map #(first (:slots %))) installs)]\n1862\t      (doseq [w waits]\n1863\t        (let [[reason n] (:slots (second (:slots w)))]\n1864\t          (when (and (= :install reason) (not (contains? names n)))\n1865\t            (outcome! :yin.k/undecodable :incomplete-install {:yin.k/name n})))))\n1866\t    (case kind\n1867\t      :halted (when (seq waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n1868\t      :blocked (when (empty? waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n1869\t      :parked (when-not (some #(= parked-id %) (take-nth 2 (:slots parked)))\n1870\t                (outcome! :yin.k/undecodable :parked-id {}))\n1871\t      (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n1872\t    (run! #(check-install! recv %) installs)))\n1873\t\n1874\t\n1875\t(defn- check-closure!\n1876\t  \"A closure row names a :closure tuple of its carried vector: the entry\n1877\t   (:closure-origin) and that tuple's binders (:closure-binders), as\n1878\t   lower-closure will demand.\"\n1879\t  [code c]\n1880\t  (let [[a entry params] (:slots c)\n1881\t        v (get code a)\n1882\t        _ (when (nil? v) (outcome! :yin.k/undecodable :segment {:yin.k/segment a}))\n1883\t        tuple (first (filter #(and (= :closure (nth % 0)) (= entry (nth % 3))) v))]\n1884\t    (cond\n1885\t      (nil? tuple) (outcome! :yin.k/undecodable :closure-origin {:yin.k/segment a :yin.k/entry entry})\n1886\t      (not= params (nth tuple 2)) (outcome! :yin.k/undecodable :closure-binders {:yin.k/segment a :yin.k/entry entry})\n1887\t      :else nil)))\n1888\t\n1889\t\n1890\t(defn- check-dependencies!\n1891\t  \"Step 9, dependency closure: requires and code agree, every segment has\n1892\t   its trees (§6.1), every closure's and frame's store-of names a module\n1893\t   store of this task (not a parent's or sibling's of the same key), every\n1894\t   segment is a vector the receiver's kernel admits under its A, every\n1895\t   closure names a closure of its code, every :prim is the receiver's.\"\n1896\t  [recv task _role]\n1897\t  (let [[_ _ _ _ _ _ _ module-stores _ _ requires code] (:slots task)]\n1898\t    (when-not (and (map? requires) (= (set (:yin.k/segments requires)) (set (keys code))))\n1899\t      (outcome! :yin.k/undecodable :requires {}))\n1900\t    (let [trees (:yin.k/trees requires)\n1901\t          missing (into #{} (remove #(seq (get trees %))) (keys code))]\n1902\t      (when (seq missing)\n1903\t        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing}})))\n1904\t    ;; §2.6: every store-of resolves to a module store this task carries\n1905\t    (let [census (into #{} (map #(first (:slots %))) module-stores)\n1906\t          missing (into #{} (comp (keep #(nth (:slots %) (if (= :closure (:kind %)) 4 1)))\n1907\t                                  (remove census))\n1908\t                        (concat (rows-of task :closure true) (rows-of task :env true)))]\n1909\t      (when (seq missing)\n1910\t        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/stores missing}})))\n1911\t    (doseq [[a v] (sort-by #(str (key %)) code)]\n1912\t      (when-not (attaches? recv v a)\n1913\t        (outcome! :yin.k/undecodable :segment {:yin.k/segment a})))\n1914\t    (run! #(check-closure! code %) (rows-of task :closure true))\n1915\t    (doseq [p (rows-of task :prim true)]\n1916\t      (when-not (contains? (:primitives recv) (first (:slots p)))\n1917\t        (outcome! :yin.k/unsatisfied nil {:yin.k/name (first (:slots p))})))))\n1918\t\n1919\t\n1920\t(defn- accept-grant!\n1921\t  \"The grant checks of a blocked or parked exclusive root (handoff.cljc's\n1922\t   accept-grant!, ported verbatim, keyed off the root's custody slot c and\n1923\t   the carrier's pack address): evidence, binding, lease, holder,\n1924\t   arbitration, epoch, tenure and the input prefix; then protection in both\n1925\t   directions over every stream row of the tree, and op-id presence equal\n1926\t   to enrollment on every retained write. Answers the custody state the\n1927\t   restored root holds, its counter the slot's exactly.\"\n1928\t  [task c address opts]\n1929\t  (let [grant (:grant opts)\n1930\t        evidence (:evidence grant)]\n1931\t    (when-not (and (or (nil? grant) (map? grant))\n1932\t                   (or (nil? evidence) (map? evidence)))\n1933\t      (throw (ex-info \"Malformed lower grant or evidence\" {})))\n1934\t    (when-not evidence\n1935\t      (outcome! :yin.k/awaiting-grant nil {}))\n1936\t    (when-not (= :yin.k/ready (:yin.k/status evidence))\n1937\t      (outcome! (if (= :yin.k/awaiting-grant (:yin.k/status evidence))\n1938\t                  :yin.k/awaiting-grant :yin.k/unsatisfied)\n1939\t                nil (dissoc evidence :yin.k/status)))\n1940\t    (let [binding (:yin.k/binding evidence)\n1941\t          prefix (:yin.k/prefix evidence)\n1942\t          tenure (:tenure grant)\n1943\t          occurrence (:yin.k/occurrence c)\n1944\t          lease (:dao.lease/lease grant)\n1945\t          holder (:dao.lease/holder grant)\n1946\t          frontier (:yin.k/frontier prefix)\n1947\t          records (:yin.k/inputs prefix)]\n1948\t      (when-not (and (map? binding) (map? tenure))\n1949\t        (throw (ex-info \"Malformed lower binding or tenure\" {})))\n1950\t      (when (or (nil? prefix) (:yin.k/status prefix))\n1951\t        (outcome! :yin.k/unsatisfied nil {:yin.k/reason (or (:yin.k/reason prefix) :unavailable)}))\n1952\t      (when-not (and (= (:checkpoint grant) address)\n1953\t                     (= occurrence (:yin.k/occurrence binding))\n1954\t                     (some? lease) (= lease (:dao.lease/lease binding))\n1955\t                     (some? holder) (= holder (:dao.lease/holder binding))\n1956\t                     (= (get-in c [:yin.k/arbitration :dao.stream/identity])\n1957\t                        (get-in binding [:yin.k/transaction :yin.k/arbitration]))\n1958\t                     (custody/exact? (:yin.k/epoch binding))\n1959\t                     (true? (:live tenure))\n1960\t                     (number? (:now tenure)) (number? (:bound tenure))\n1961\t                     (< (:now tenure) (:bound tenure))\n1962\t                     (= occurrence (:yin.k/occurrence prefix))\n1963\t                     (= lease (:dao.lease/lease prefix))\n1964\t                     (custody/exact? frontier) (vector? records)\n1965\t                     (= frontier (count records))\n1966\t                     (every? true? (map-indexed\n1967\t                                     (fn [index record]\n1968\t                                       (and (custody/exact? (:yin.k/input-seq record))\n1969\t                                            (= index (:yin.k/input-seq record))))\n1970\t                                     records)))\n1971\t        (outcome! :yin.k/not-holder nil {}))\n1972\t      (let [classes (:protection opts)\n1973\t            enrolled (:yin.k/enrolled evidence)]\n1974\t        (when-not (and (map? classes)\n1975\t                       (every? #{:enrolled :at-least-once :fail-stop} (vals classes))\n1976\t                       (set? enrolled))\n1977\t          (throw (ex-info \"Malformed lower protection or enrollment\" {})))\n1978\t        (doseq [s (rows-of task :stream false)]\n1979\t          (let [identity (first (:slots s))\n1980\t                class (get classes identity)]\n1981\t            (when-not (and class (= (= class :enrolled) (contains? enrolled identity)))\n1982\t              (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity}))))\n1983\t        (doseq [[t _] (task-tree task :root)\n1984\t                w (nth (:slots t) 13)\n1985\t                :let [ss (:slots (second (:slots w)))\n1986\t                      [ti _ oi] (get write-slots (first ss))]\n1987\t                :when ti]\n1988\t          (let [identity (first (:slots (nth ss ti)))]\n1989\t            (when-not (= (= :enrolled (get classes identity)) (some? (nth ss oi)))\n1990\t              (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity}))))\n1991\t        {:yin.k/occurrence occurrence\n1992\t         :dao.lease/lease lease :dao.lease/holder holder\n1993\t         :yin.k/epoch (:yin.k/epoch binding)\n1994\t         :yin.k/arbitration (:yin.k/arbitration c)\n1995\t         :yin.k/next-op-seq (:yin.k/next-op-seq c)\n1996\t         :protection classes :input {:next 0 :prefix prefix}\n1997\t         :tenure {:bound (:bound tenure)}}))))\n1998\t\n1999\t\n2000\t(defn- check-custody!\n2001\t  \"Step 10, once for the tree after the three staged checks: the custody\n2002\t   grammar (custody-baseline), then by the root's slot: a fork (nil) is\n2003\t   refused under :exclusive as :yin.k/profile-mismatch; an exclusive\n2004\t   blocked or parked root runs the grant checks unless :fenced (an\n2005\t   administrative rehydration: no grant, gate :exporting); a halted\n2006\t   exclusive root needs no grant and is gated :ended. Answers\n2007\t   {:exclusive? :fenced? :state}, which restore applies to every task.\"\n2008\t  [task wire opts]\n2009\t  (custody-baseline task)\n2010\t  (let [[_ _ kind] (:slots task) c (nth (:slots task) 16) fenced? (boolean (:fenced opts))]\n2011\t    (if (nil? c)\n2012\t      (do (when (:exclusive opts)\n2013\t            (outcome! :yin.k/profile-mismatch nil {:yin.k/policy :yin.k/exclusive}))\n2014\t          {:exclusive? false :fenced? fenced?})\n2015\t      {:exclusive? true :fenced? fenced?\n2016\t       :state (when-not (or fenced? (= :halted kind)) (accept-grant! task c (pack-address wire) opts))})))\n2017\t\n2018\t\n2019\t(defn- with-custody\n2020\t  \"Restore's custody for one task of the tree: an exclusive tree numbers\n2021\t   its retained :put waits (:yin.k/issue, :yin.k/issued, in carried\n2022\t   order) and gates :running, a halted exclusive root :ended, the root\n2023\t   holding the grant's custody state; a fenced tree gates :exporting with\n2024\t   its waits and every parked record outside the scheduler\n2025\t   (:yin.k/recovery-waits, :yin.k/recovery-parked), the shape\n2026\t   holder.export's exporting machine has.\"\n2027\t  [m {:keys [exclusive? fenced? state]} kind root?]\n2028\t  (let [m (if exclusive?\n2029\t            (let [[entries issued] (reduce (fn [[acc i] e]\n2030\t                                             (if (= :put (:reason e))\n2031\t                                               [(conj acc (assoc e :yin.k/issue i)) (inc i)]\n2032\t                                               [(conj acc e) i]))\n2033\t                                           [[] 0] (:wait-set m))]\n2034\t              (cond-> (assoc m :wait-set entries :yin.k/issued issued\n2035\t                             :yin.k/gate (if (and root? (= :halted kind)) :ended :running))\n2036\t                (and root? (some? state)) (assoc :yin.k/custody state)))\n2037\t            m)]\n2038\t    (if fenced?\n2039\t      (assoc m :yin.k/gate :exporting :yin.k/recovery-waits (:wait-set m) :wait-set []\n2040\t             :yin.k/recovery-parked (:parked m) :parked {})\n2041\t      m)))\n2042\t\n2043\t\n2044\t(defn- attach-streams!\n2045\t  \"Step 11: one attach per distinct stream identity of the whole tree.\"\n2046\t  [attach! task]\n2047\t  (reduce (fn [acc s]\n2048\t            (let [[identity descriptor] (:slots s)]\n2049\t              (if (contains? acc identity)\n2050\t                acc\n2051\t                (if-some [h (remote/lower-marker attach! {:dao.stream/descriptor descriptor})]\n2052\t                  (assoc acc identity h)\n2053\t                  (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})))))\n2054\t          {} (rows-of task :stream false)))\n2055\t\n2056\t\n2057\t(defn- spawn-child\n2058\t  \"A fresh install child of recv's composition (the engine's spawn\n2059\t   discipline): answers [child recv']. A fenced rehydration spawns it\n2060\t   without the stream constructor, so the child's construction creates no\n2061\t   stream (its default call pair): rehydration initializes nothing. The\n2062\t   constructor is the child's again afterwards.\"\n2063\t  [recv response mn fenced?]\n2064\t  (let [n (or (:origins recv) 0)\n2065\t        origin (keyword (str (name (or (:origin recv) :t0)) \".\" n))\n2066\t        registry (reduce (fn [r [m e]] (module/assoc-module r m (dissoc e :bindings)))\n2067\t                         (:modules recv) (module/module-entries (:modules recv)))\n2068\t        source (:secret-source recv)\n2069\t        child (module/spawn-module (cond-> recv fenced? (assoc :make-stream nil))\n2070\t                                   (:value (:image response))\n2071\t                                   {:modules registry :origin origin\n2072\t                                    :ancestry (conj (vec (:ancestry recv)) mn)\n2073\t                                    :capability-secret (when (fn? source) (source origin))})]\n2074\t    [(cond-> child fenced? (assoc :make-stream (:make-stream recv)))\n2075\t     (assoc recv :origins (inc n))]))\n2076\t\n2077\t\n2078\t(defn- restore-task\n2079\t  \"Step 12 for one task: code by A, fresh resource keys, values re-sealed\n2080\t   under recv, waits as engine entries, parked records, installs, and the\n2081\t   custody check-custody! answered (with-custody).\"\n2082\t  [recv task handles custody root?]\n2083\t  (let [[_ _ kind _ id-counter free-env store module-stores parked census _ code installs waits parked-id result]\n2084\t        (:slots task)\n2085\t        base (reduce (fn [r [_ v]] (module/attach-module r v))\n2086\t                     (assoc recv :code {} :code-aliases {} :program nil)\n2087\t                     (sort-by #(str (key %)) code))\n2088\t        aliases (:code-aliases base)\n2089\t        used (atom (into fixed-resource-keys (keys (:resources base))))\n2090\t        identities (sort-by str (distinct (map #(first (:slots %)) (rows-of task :stream true))))\n2091\t        stream-keys (into {} (map (fn [identity] [identity (fresh-key! used)])) identities)\n2092\t        pairs (mapv vec (partition 2 (:slots census)))\n2093\t        cell-keys (into {} (map (fn [[c _]] [c (fresh-key! used)])) pairs)\n2094\t        bodies (into {} pairs)\n2095\t        stream-key #(get stream-keys (first (:slots %)))\n2096\t        parked-index (into {} (map vec) (partition 2 (:slots parked)))\n2097\t        cache (atom {})\n2098\t        resolving (atom #{})]\n2099\t    (letfn [(value\n2100\t              [v]\n2101\t              (case (first v)\n2102\t                :lit (second v)\n2103\t                :cursor-cell (engine/issue-ref base :cursor-ref (get cell-keys (second v)))\n2104\t                :row (row (second v))))\n2105\t            (row\n2106\t              [n]\n2107\t              (let [ss (:slots n)]\n2108\t                (case (:kind n)\n2109\t                  :vec (mapv value ss)\n2110\t                  :list (apply list (map value ss))\n2111\t                  :set (into #{} (map value) ss)\n2112\t                  :map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))\n2113\t                  :prim (vm/primitive-function (get (:primitives base) (first ss)))\n2114\t                  :stream (engine/issue-ref base :stream-ref (stream-key n))\n2115\t                  :closure (let [[a entry params bindings store-of] ss]\n2116\t                             (module/lower-closure base\n2117\t                                                   (cond-> {:yin.k/binding :named\n2118\t                                                            :yin.k/format :yin.semantic-register/code\n2119\t                                                            :yin.k/segment a :yin.k/entry entry :yin.k/params params\n2120\t                                                            :yin.k/env (keyed bindings)}\n2121\t                                                     (some? store-of) (assoc :yin.k/store-of store-of))\n2122\t                                                   identity))\n2123\t                  :reified (values/continuation (:owner base) (assoc (payload (first ss)) :type :reified-continuation))\n2124\t                  :parked-ref (parked-record (first ss)))))\n2125\t            (keyed\n2126\t              [n]\n2127\t              (into {} (map (fn [[k x]] [k (value x)])) (partition 2 (:slots n))))\n2128\t            (env\n2129\t              [n]\n2130\t              (let [[b store-of] (:slots n)]\n2131\t                (cond-> (keyed b) (some? store-of) (assoc engine/store-of-key store-of))))\n2132\t            (k-of\n2133\t              [n]\n2134\t              (mapv (fn [f]\n2135\t                      (let [[a pc e w rd] (:slots f)]\n2136\t                        {:type :return :segment (get aliases a) :pc pc :env (env e) :window (keyed w) :rd rd}))\n2137\t                    (:slots n)))\n2138\t            (payload\n2139\t              [n]\n2140\t              (if (= :tail (:kind n))\n2141\t                (let [[a site k] (:slots n)]\n2142\t                  {:segment (get aliases a) :site site :k (k-of k) :deliver {:deliver :return}})\n2143\t                (let [[a pc e w k rd] (:slots n)]\n2144\t                  {:segment (get aliases a) :pc pc :env (env e) :window (keyed w) :k (k-of k)\n2145\t                   :deliver {:deliver :rd :rd rd}})))\n2146\t            (parked-record\n2147\t              [p]\n2148\t              (or (get @cache p)\n2149\t                  (do (when (contains? @resolving p)\n2150\t                        (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint :parked-cycle}))\n2151\t                      (swap! resolving conj p)\n2152\t                      (let [r (assoc (payload (get parked-index p)) :type :parked-continuation :id p)]\n2153\t                        (swap! cache assoc p r)\n2154\t                        (swap! resolving disj p)\n2155\t                        r))))\n2156\t            (cell-stream\n2157\t              [c]\n2158\t              (stream-key (first (:slots (get bodies c)))))\n2159\t            (entry\n2160\t              [w]\n2161\t              (let [[state pending] (:slots w)\n2162\t                    [reason & xs] (:slots pending)\n2163\t                    p (payload state)]\n2164\t                (case reason\n2165\t                  :next (assoc p :reason :next :stream-id (cell-stream (first xs))\n2166\t                               :cursor-ref {:type :cursor-ref :id (get cell-keys (first xs))})\n2167\t                  :ffi (let [[c call-id op] xs]\n2168\t                         (cond-> (assoc p :reason :next :stream-id (cell-stream c) :call-id call-id\n2169\t                                        :cursor-ref {:type :cursor-ref :id (get cell-keys c)})\n2170\t                           (some? op) (assoc :op op)))\n2171\t                  :put (let [[s v op-id] xs]\n2172\t                         (cond-> (assoc p :reason :put :stream-id (stream-key s) :datom (value v))\n2173\t                           (some? op-id) (assoc :op-id op-id)))\n2174\t                  :ffi-request (let [[call-id envelope req resp c op-id] xs\n2175\t                                     datom (value envelope)]\n2176\t                                 (cond-> (assoc p :reason :put :stream-id (stream-key req) :datom datom\n2177\t                                                :request-sent true :call-id call-id :op (apply2/request-op datom)\n2178\t                                                :response-cursor (get cell-keys c) :response-stream (stream-key resp))\n2179\t                                   (some? op-id) (assoc :op-id op-id)))\n2180\t                  (:link-request :link-response)\n2181\t                  (let [[link-id mn _ _ c envelope op-id] xs]\n2182\t                    (cond-> (assoc p :reason reason :link-id link-id :name mn\n2183\t                                   :request module/link-request-resource :response module/link-response-resource\n2184\t                                   :cursor (second (:slots (get bodies c))))\n2185\t                      (= :link-request reason) (assoc :envelope envelope)\n2186\t                      (some? op-id) (assoc :op-id op-id)))\n2187\t                  :install (assoc p :reason :install :name (first xs)))))]\n2188\t      (let [store' (reduce (fn [s [k v]] (engine/store-put s k (value v))) {} (partition 2 (:slots store)))\n2189\t            stores (into {} (map (fn [ms]\n2190\t                                   (let [[mid s] (:slots ms)]\n2191\t                                     [mid (into {} (map (fn [[k v]] [k (value v)])) (partition 2 (:slots s)))])))\n2192\t                         module-stores)\n2193\t            parked' (into {} (map (fn [[p _]] [p (parked-record p)])) parked-index)\n2194\t            entries (mapv entry waits)\n2195\t            link (some #(let [[reason _ _ req resp] (:slots (second (:slots %)))]\n2196\t                          (when (contains? #{:link-request :link-response} reason) [req resp]))\n2197\t                       waits)\n2198\t            [base installs'] (reduce (fn [[r acc] inst]\n2199\t                                       (let [[mn phase parent response child] (:slots inst)\n2200\t                                             [spawned r'] (spawn-child r response mn (:fenced? custody))]\n2201\t                                         [r' (assoc acc mn {:phase phase :parent parent :response response\n2202\t                                                            :vm (restore-task spawned child handles custody false)})]))\n2203\t                                     [base {}] installs)\n2204\t            fe (keyed free-env)\n2205\t            resources (merge (:resources base)\n2206\t                             (into {} (map (fn [[identity k]] [k (get handles identity)])) stream-keys)\n2207\t                             (into {} (map (fn [[c body]]\n2208\t                                             [(get cell-keys c) {:stream-id (stream-key (first (:slots body)))\n2209\t                                                                 :cursor (second (:slots body))}]))\n2210\t                                   pairs)\n2211\t                             (when-let [[req resp] link]\n2212\t                               {module/link-request-resource (get handles (first (:slots req)))\n2213\t                                module/link-response-resource (get handles (first (:slots resp)))}))\n2214\t            ;; a fenced rehydration carries the counter exactly, so the\n2215\t            ;; relift reproduces the published root; a resumption adopts\n2216\t            ;; max(local, carried)\n2217\t            machine (cond-> (assoc base :store store' :module-stores stores :parked parked' :installs installs'\n2218\t                                   :resources resources :env fe :free-env fe :window {} :k nil :control nil\n2219\t                                   :ready-queue []\n2220\t                                   :id-counter (if (:fenced? custody)\n2221\t                                                 id-counter\n2222\t                                                 (max (or (:id-counter base) 0) id-counter)))\n2223\t                      ;; resource key -> the carrier's cursor cell, so one\n2224\t                      ;; cell is one key and two cells two (UCF 7.7.4)\n2225\t                      (:fenced? custody)\n2226\t                      (assoc :yin.k/recovery-cell-ids (into {} (map (fn [[c k]] [k c])) cell-keys)))]\n2227\t        (with-custody\n2228\t          (case kind\n2229\t            :halted (assoc machine :halted? true :blocked? false :value (value result) :wait-set [])\n2230\t            :parked (assoc machine :halted? true :blocked? false :value (get parked' parked-id) :wait-set entries)\n2231\t            (assoc machine :halted? false :blocked? true :value :yin/blocked :wait-set entries))\n2232\t          custody kind root?)))))\n2233\t\n2234\t\n2235\t(defn lower-task\n2236\t  \"The lower of §7.2 into recv, a fresh semantic-register machine of the\n2237\t   receiver's composition: gate to frames (decode) and the store keys,\n2238\t   then pendings and install records, dependency closure (code, closures,\n2239\t   primitives), each step over the whole tree before the next, then\n2240\t   custody (check-custody!), all before the first attach! (step 11); then\n2241\t   restore (step 12), which therefore meets no carrier defect. Answers the\n2242\t   restored machine, or throws the first refusal as ex-data.\n2243\t   opts: :budget; :exclusive, refuse a fork root; :grant and :protection,\n2244\t   required by a blocked or parked exclusive root (handoff.cljc's reader\n2245\t   contract: the grant names :checkpoint, the pack address, its lease,\n2246\t   holder, tenure and evidence; :protection maps every stream identity of\n2247\t   the tree to its class); :fenced, an administrative rehydration that\n2248\t   skips the grant and restores every task of the tree gated :exporting,\n2249\t   its waits in :yin.k/recovery-waits and its parked records in\n2250\t   :yin.k/recovery-parked (none in the scheduler), its id counter the\n2251\t   carried one exactly and :yin.k/recovery-cell-ids mapping each cursor\n2252\t   cell's resource key to its carried cell id.\"\n2253\t  ([recv wire attach!] (lower-task recv wire attach! {}))\n2254\t  ([recv wire attach! opts]\n2255\t   (let [task (decode wire (merge default-budget (:budget opts)))]\n2256\t     (when-not (= :task (:kind task)) (outcome! :yin.k/undecodable :root {}))\n2257\t     ;; each step over the whole tree before the next (§3.3)\n2258\t     (doseq [step [check-stores! check-pendings! check-dependencies!]\n2259\t             [t role] (task-tree task :root)]\n2260\t       (step recv t role))\n2261\t     (let [custody (check-custody! task wire opts)]\n2262\t       (restore-task recv task (attach-streams! attach! task) custody true)))))"}]},"parent_tool_use_id":null,"session_id":"24e59ef2-1e11-40bc-bf74-9b03c65bd1ca","uuid":"f800fe04-b46c-4bf7-9d37-a31e7cbafc02","timestamp":"2026-10-13T18:46:10.853Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7e/src/cljc/yin/vm/ucf/rows.cljc","content":"(defn- lift-task*\n  [m serve! opts role]\n  (when (seq (:ready-queue m))\n    (outcome! :yin.k/not-quiescent nil {:yin.k/ready (count (:ready-queue m))}))\n  (when-some [h (unliftable-hold m)]\n    (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/hold h}))\n  (when (some? (:control m))\n    (outcome! :yin.k/not-at-safepoint nil {:yin.k/pc (get-in m [:control :pc])}))\n  (let [value (:value m)\n        active? (and (map? value) (= :parked-continuation (:type value)) (contains? (:parked m) (:id value)))\n        kind (cond active? :parked\n                   (seq (:wait-set m)) :blocked\n                   (engine/halted-with-empty-queue? m) :halted\n                   :else (outcome! :yin.k/not-at-safepoint nil {}))\n        ;; §6.3: the explicit argument overrides the kernel's retained field\n        free-env (cond (some? (:free-env opts)) (:free-env opts)\n                       (some? (:free-env m)) (:free-env m)\n                       :else (outcome! :yin.k/non-portable :missing-free-env {}))\n        ctx {:m m :serve! serve! :serve-keyed (:serve-keyed opts) :path (or (:path opts) [])\n             :acc (atom {:streams {} :cells {} :stores #{} :segments #{} :contexts #{}})}\n        free-node (bindings-node ctx free-env)\n        waits (mapv (fn [e] (node :wait [(state-node ctx e) (pending-node ctx e)])) (:wait-set m))\n        parked (node :parked-table (mapcat (fn [[p rec]] [p (state-node ctx rec)]) (:parked m)))\n        store (store-node ctx (:store m))\n        result (when (= :halted kind) (lift-value ctx value))\n        installs (mapv (fn [[mn inst]] (install-node ctx mn inst opts)) (sort-by #(str (key %)) (:installs m)))\n        module-stores (module-store-nodes ctx)\n        acc @(:acc ctx)\n        segments (:segments acc)\n        code (into {} (map (fn [a]\n                             (if-some [v (get-in m [:code (get (:code-aliases m) a) :vector])]\n                               [a v]\n                               (outcome! :yin.k/unsatisfied nil {:yin.k/segment a}))))\n                   segments)\n        _ (discharge! ctx code)\n        index (or (:source-index opts) {})\n        missing-trees (into #{} (remove #(seq (get index %))) segments)\n        _ (when (seq missing-trees)\n            (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing-trees}}))\n        requires {:yin.k/cursor-profiles (if (seq (:cells acc)) remote/cursor-profiles #{})\n                  :yin.k/segments segments\n                  :yin.k/trees (select-keys index segments)}\n        task (node :task [3 profile kind role (or (:id-counter m) 0) free-node store module-stores parked\n                          (node :cursor-cells (mapcat identity (:cells acc))) requires code installs waits\n                          (when (= :parked kind) (:id value)) result nil])]\n    ;; §3.3: a frame the evaluator itself minted that fails is inconsistent\n    (when-let [d (validate-frames task)]\n      (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/defect d}))\n    task))\n\n\n(declare task-tree)\n\n\n(defn- header-custody\n  \"The root's custody slot from the caller's header, by kind: blocked or\n   parked takes the occurrence, arbitration, counter and the exclusive\n   policy, and the origin when the header names one; halted the origin\n   alone (an empty map without one, which the grammar refuses). A nil\n   value is an absent key (handoff.cljc's header-of).\"\n  [header kind]\n  (into {}\n        (filter (comp some? val))\n        (if (= :halted kind)\n          (select-keys header [:yin.k/origin])\n          (assoc (select-keys header [:yin.k/occurrence :yin.k/arbitration :yin.k/next-op-seq :yin.k/origin])\n                 :yin.k/policy :yin.k/exclusive))))\n\n\n(defn- protect!\n  \"Every retained write of the tree under the header's enrolled set (UCF\n   7.4.3, 7.7.8; handoff.cljc's protected!): an enrolled target without an\n   operation id is :unprotected-pending, an id on an unenrolled target is\n   :yin.k/unsatisfied naming the stream.\"\n  [task enrolled]\n  (doseq [[t _] (task-tree task :root)\n          w (nth (:slots t) 13)]\n    (let [ss (:slots (second (:slots w)))]\n      (when-let [[ti _ oi] (get write-slots (first ss))]\n        (let [identity (first (:slots (nth ss ti)))\n              enrolled? (contains? enrolled identity)\n              carried? (some? (nth ss oi))]\n          (cond\n            (and enrolled? (not carried?))\n            (outcome! :yin.k/non-portable :unprotected-pending {:dao.stream/identity identity})\n            (and carried? (not enrolled?))\n            (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})\n            :else nil))))))\n\n\n(defn lift-task\n  \"The lift of §7.1: quiescent semantic-register machine m as a version-3\n   carrier, or a refusal thrown as ex-data {:yin.k/status :yin.k/kind}.\n   serve! is the exporter's remote-table entry (yin.vm.ucf.remote).\n   opts: :free-env, the task's initial free environment (default: the\n   kernel's retained :free-env field; the explicit value overrides it);\n   :source-index, {A #{tree-address}} the composition knows (§6.1), which\n   must cover every carried segment; :budget, the numbering budget;\n   :header, the exclusive custody header (occurrence, arbitration,\n   next-op-seq, origin when the task has a predecessor, and\n   :yin.k/enrolled, the enrolled stream identities, a lift input that\n   never travels); :serve-keyed, (f [task-path resource-id] handle), which\n   replaces serve! and is asked once per resource of each task, the task\n   path being the install names from the root ([] for the root itself),\n   so a caller can retain each answer under its key (holder.export's\n   record). No header is the fork: custody nil. A header writes the\n   root's slot by kind (header-custody), refuses :op-seq-exhausted at\n   2^52-1 on a blocked or parked root, and protects every retained write\n   of the tree (protect!). Before emitting, the lift runs custody-baseline\n   over the task, so it never emits a carrier the inspector refuses.\"\n  ([m serve!] (lift-task m serve! {}))\n  ([m serve! opts]\n   (let [opts (or opts {})\n         header (:header opts)\n         task (lift-task* m serve! opts :root)\n         kind (nth (:slots task) 2)\n         task (if (nil? header)\n                task\n                (let [n (:yin.k/next-op-seq header)]\n                  (when (and (not= :halted kind) (cbor/numeric? n) (cbor/num= n max-exact))\n                    (outcome! :yin.k/non-portable :op-seq-exhausted {:yin.k/next-op-seq n}))\n                  (protect! task (or (:yin.k/enrolled header) #{}))\n                  (assoc-in task [:slots 16] (header-custody header kind))))]\n     (custody-baseline task)\n     (emit task (merge default-budget (:budget opts))))))\n\n\n(def ^:private fixed-resource-keys\n  #{vm/call-in-stream-key vm/call-out-stream-key vm/call-out-cursor-key\n    module/link-request-resource module/link-response-resource})\n\n\n(defn- fresh-key!\n  [used]\n  (loop [n (inc (count @used))]\n    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n      (if (contains? @used k) (recur (inc n)) (do (swap! used conj k) k)))))\n\n\n(defn- rows-of\n  \"Every row of kind under n; install children too unless own-only.\"\n  [n kind own-only?]\n  (let [out (atom [])]\n    (letfn [(visit\n              [n]\n              (when (= kind (:kind n)) (swap! out conj n))\n              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n                (cond\n                  (and (ref? d) (= :task (:kind x))) (when-not own-only? (visit x))\n                  (ref? d) (visit x)\n                  (refs? d) (run! visit x)\n                  (and (value-slot? d) (vector? x) (= :row (first x))) (visit (second x))\n                  :else nil)))]\n      (visit n)\n      @out)))\n\n\n(defn- task-tree\n  \"[task role] for the root and every install child, pre-order.\"\n  [task role]\n  (into [[task role]] (mapcat #(task-tree (nth (:slots %) 4) :child)) (nth (:slots task) 12)))\n\n\n(defn- check-stores!\n  \"Step 7's task context, beside X1: no root or module store key is a\n   reserved name (Rule R), refused here rather than by restore's store-put.\"\n  [_recv task _role]\n  (let [[_ _ _ _ _ _ store module-stores] (:slots task)]\n    (doseq [s (cons store (map #(second (:slots %)) module-stores))\n            k (take-nth 2 (:slots s))]\n      (when (vm/reserved-name? k)\n        (outcome! :yin.k/undecodable :reserved-name {:yin.k/role :store-key :yin.k/name k})))))\n\n\n(defn- attaches?\n  \"The receiving kernel admits vector v (its loader's validation), under\n   address a when a is given.\"\n  [recv v a]\n  (try (let [r (module/attach-module recv v)] (or (nil? a) (contains? (:code-aliases r) a)))\n       (catch #?(:cljd Object :clj Throwable :cljs :default) _e false)))\n\n\n(defn- check-install!\n  \"One install record: a phase the engine holds a carried child in, the\n   retained response link-install reads (status, manifest naming this\n   module, exports) with the image spawn-child loads, the response's link\n   id equal to the row's parent (the engine settles only the response of\n   its own link), the image the manifest names (continuation §11 Q3: the\n   manifest's :yin.semantic/code derivation record is the response's\n   :derivation, from the manifest's tree to the image's A), and a child\n   that is blocked: the engine links a halted child in the sweep it\n   halts in.\"\n  [recv inst]\n  (let [[mn phase parent response child] (:slots inst)\n        manifest (when (map? response) (:manifest response))\n        child-kind (nth (:slots child) 2)]\n    (when-not (contains? #{:running :parked} phase)\n      (outcome! :yin.k/undecodable :install-phase {:yin.k/name mn :yin.k/phase phase}))\n    (when-not (and (map? response) (= :ok (:status response)) (map? manifest)\n                   (= mn (:yin.module/name manifest))\n                   (coll? (:yin.module/exports manifest)) (every? symbol? (:yin.module/exports manifest))\n                   (map? (:image response)) (attaches? recv (:value (:image response)) nil))\n      (outcome! :yin.k/undecodable :install-response {:yin.k/name mn}))\n    (when-not (and (some? parent) (= parent (:yin.link/id response)))\n      (outcome! :yin.k/undecodable :install-link-id {:yin.k/name mn}))\n    (let [record (:derivation response)]\n      (when-not (and (map? record)\n                     (= (jing/segment-key record) (get-in manifest [:yin.module/derivations :yin.semantic/code]))\n                     (= (:yin.ledger/input record) (:yin.module/tree manifest))\n                     (= (:yin.ledger/output record) (jing/segment-key (:value (:image response)))))\n        (outcome! :yin.k/undecodable :install-image {:yin.k/name mn})))\n    (when-not (= :blocked child-kind)\n      (outcome! :yin.k/undecodable :install-child {:yin.k/name mn :yin.k/task-kind child-kind}))))\n\n\n(defn- check-pendings!\n  \"Step 8, pending and operations: role, kind, parked id, every :install\n   pending names a carried install, every install record.\"\n  [recv task role]\n  (let [[_ _ kind role' _ _ _ _ parked _ _ _ installs waits parked-id] (:slots task)]\n    (when-not (= role role') (outcome! :yin.k/undecodable :role {:yin.k/role role'}))\n    (let [names (into #{} (map #(first (:slots %))) installs)]\n      (doseq [w waits]\n        (let [[reason n] (:slots (second (:slots w)))]\n          (when (and (= :install reason) (not (contains? names n)))\n            (outcome! :yin.k/undecodable :incomplete-install {:yin.k/name n})))))\n    (case kind\n      :halted (when (seq waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n      :blocked (when (empty? waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n      :parked (when-not (some #(= parked-id %) (take-nth 2 (:slots parked)))\n                (outcome! :yin.k/undecodable :parked-id {}))\n      (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n    (run! #(check-install! recv %) installs)))\n\n\n(defn- check-closure!\n  \"A closure row names a :closure tuple of its carried vector: the entry\n   (:closure-origin) and that tuple's binders (:closure-binders), as\n   lower-closure will demand.\"\n  [code c]\n  (let [[a entry params] (:slots c)\n        v (get code a)\n        _ (when (nil? v) (outcome! :yin.k/undecodable :segment {:yin.k/segment a}))\n        tuple (first (filter #(and (= :closure (nth % 0)) (= entry (nth % 3))) v))]\n    (cond\n      (nil? tuple) (outcome! :yin.k/undecodable :closure-origin {:yin.k/segment a :yin.k/entry entry})\n      (not= params (nth tuple 2)) (outcome! :yin.k/undecodable :closure-binders {:yin.k/segment a :yin.k/entry entry})\n      :else nil)))\n\n\n(defn- check-dependencies!\n  \"Step 9, dependency closure: requires and code agree, every segment has\n   its trees (§6.1), every closure's and frame's store-of names a module\n   store of this task (not a parent's or sibling's of the same key), every\n   segment is a vector the receiver's kernel admits under its A, every\n   closure names a closure of its code, every :prim is the receiver's.\"\n  [recv task _role]\n  (let [[_ _ _ _ _ _ _ module-stores _ _ requires code] (:slots task)]\n    (when-not (and (map? requires) (= (set (:yin.k/segments requires)) (set (keys code))))\n      (outcome! :yin.k/undecodable :requires {}))\n    (let [trees (:yin.k/trees requires)\n          missing (into #{} (remove #(seq (get trees %))) (keys code))]\n      (when (seq missing)\n        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing}})))\n    ;; §2.6: every store-of resolves to a module store this task carries\n    (let [census (into #{} (map #(first (:slots %))) module-stores)\n          missing (into #{} (comp (keep #(nth (:slots %) (if (= :closure (:kind %)) 4 1)))\n                                  (remove census))\n                        (concat (rows-of task :closure true) (rows-of task :env true)))]\n      (when (seq missing)\n        (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/stores missing}})))\n    (doseq [[a v] (sort-by #(str (key %)) code)]\n      (when-not (attaches? recv v a)\n        (outcome! :yin.k/undecodable :segment {:yin.k/segment a})))\n    (run! #(check-closure! code %) (rows-of task :closure true))\n    (doseq [p (rows-of task :prim true)]\n      (when-not (contains? (:primitives recv) (first (:slots p)))\n        (outcome! :yin.k/unsatisfied nil {:yin.k/name (first (:slots p))})))))\n\n\n(defn- accept-grant!\n  \"The grant checks of a blocked or parked exclusive root (handoff.cljc's\n   accept-grant!, ported verbatim, keyed off the root's custody slot c and\n   the carrier's pack address): evidence, binding, lease, holder,\n   arbitration, epoch, tenure and the input prefix; then protection in both\n   directions over every stream row of the tree, and op-id presence equal\n   to enrollment on every retained write. Answers the custody state the\n   restored root holds, its counter the slot's exactly.\"\n  [task c address opts]\n  (let [grant (:grant opts)\n        evidence (:evidence grant)]\n    (when-not (and (or (nil? grant) (map? grant))\n                   (or (nil? evidence) (map? evidence)))\n      (throw (ex-info \"Malformed lower grant or evidence\" {})))\n    (when-not evidence\n      (outcome! :yin.k/awaiting-grant nil {}))\n    (when-not (= :yin.k/ready (:yin.k/status evidence))\n      (outcome! (if (= :yin.k/awaiting-grant (:yin.k/status evidence))\n                  :yin.k/awaiting-grant :yin.k/unsatisfied)\n                nil (dissoc evidence :yin.k/status)))\n    (let [binding (:yin.k/binding evidence)\n          prefix (:yin.k/prefix evidence)\n          tenure (:tenure grant)\n          occurrence (:yin.k/occurrence c)\n          lease (:dao.lease/lease grant)\n          holder (:dao.lease/holder grant)\n          frontier (:yin.k/frontier prefix)\n          records (:yin.k/inputs prefix)]\n      (when-not (and (map? binding) (map? tenure))\n        (throw (ex-info \"Malformed lower binding or tenure\" {})))\n      (when (or (nil? prefix) (:yin.k/status prefix))\n        (outcome! :yin.k/unsatisfied nil {:yin.k/reason (or (:yin.k/reason prefix) :unavailable)}))\n      (when-not (and (= (:checkpoint grant) address)\n                     (= occurrence (:yin.k/occurrence binding))\n                     (some? lease) (= lease (:dao.lease/lease binding))\n                     (some? holder) (= holder (:dao.lease/holder binding))\n                     (= (get-in c [:yin.k/arbitration :dao.stream/identity])\n                        (get-in binding [:yin.k/transaction :yin.k/arbitration]))\n                     (custody/exact? (:yin.k/epoch binding))\n                     (true? (:live tenure))\n                     (number? (:now tenure)) (number? (:bound tenure))\n                     (< (:now tenure) (:bound tenure))\n                     (= occurrence (:yin.k/occurrence prefix))\n                     (= lease (:dao.lease/lease prefix))\n                     (custody/exact? frontier) (vector? records)\n                     (= frontier (count records))\n                     (every? true? (map-indexed\n                                     (fn [index record]\n                                       (and (custody/exact? (:yin.k/input-seq record))\n                                            (= index (:yin.k/input-seq record))))\n                                     records)))\n        (outcome! :yin.k/not-holder nil {}))\n      (let [classes (:protection opts)\n            enrolled (:yin.k/enrolled evidence)]\n        (when-not (and (map? classes)\n                       (every? #{:enrolled :at-least-once :fail-stop} (vals classes))\n                       (set? enrolled))\n          (throw (ex-info \"Malformed lower protection or enrollment\" {})))\n        (doseq [s (rows-of task :stream false)]\n          (let [identity (first (:slots s))\n                class (get classes identity)]\n            (when-not (and class (= (= class :enrolled) (contains? enrolled identity)))\n              (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity}))))\n        (doseq [[t _] (task-tree task :root)\n                w (nth (:slots t) 13)\n                :let [ss (:slots (second (:slots w)))\n                      [ti _ oi] (get write-slots (first ss))]\n                :when ti]\n          (let [identity (first (:slots (nth ss ti)))]\n            (when-not (= (= :enrolled (get classes identity)) (some? (nth ss oi)))\n              (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity}))))\n        {:yin.k/occurrence occurrence\n         :dao.lease/lease lease :dao.lease/holder holder\n         :yin.k/epoch (:yin.k/epoch binding)\n         :yin.k/arbitration (:yin.k/arbitration c)\n         :yin.k/next-op-seq (:yin.k/next-op-seq c)\n         :protection classes :input {:next 0 :prefix prefix}\n         :tenure {:bound (:bound tenure)}}))))\n\n\n(defn- check-custody!\n  \"Step 10, once for the tree after the three staged checks: the custody\n   grammar (custody-baseline), then by the root's slot: a fork (nil) is\n   refused under :exclusive as :yin.k/profile-mismatch; an exclusive\n   blocked or parked root runs the grant checks unless :fenced (an\n   administrative rehydration: no grant, gate :exporting); a halted\n   exclusive root needs no grant and is gated :ended. Answers\n   {:exclusive? :fenced? :state}, which restore applies to every task.\"\n  [task wire opts]\n  (custody-baseline task)\n  (let [[_ _ kind] (:slots task) c (nth (:slots task) 16) fenced? (boolean (:fenced opts))]\n    (if (nil? c)\n      (do (when (:exclusive opts)\n            (outcome! :yin.k/profile-mismatch nil {:yin.k/policy :yin.k/exclusive}))\n          {:exclusive? false :fenced? fenced?})\n      {:exclusive? true :fenced? fenced?\n       :state (when-not (or fenced? (= :halted kind)) (accept-grant! task c (pack-address wire) opts))})))\n\n\n(defn- with-custody\n  \"Restore's custody for one task of the tree: an exclusive tree numbers\n   its retained :put waits (:yin.k/issue, :yin.k/issued, in carried\n   order) and gates :running, a halted exclusive root :ended, the root\n   holding the grant's custody state; a fenced tree gates :exporting with\n   its waits and every parked record outside the scheduler\n   (:yin.k/recovery-waits, :yin.k/recovery-parked), the shape\n   holder.export's exporting machine has.\"\n  [m {:keys [exclusive? fenced? state]} kind root?]\n  (let [m (if exclusive?\n            (let [[entries issued] (reduce (fn [[acc i] e]\n                                             (if (= :put (:reason e))\n                                               [(conj acc (assoc e :yin.k/issue i)) (inc i)]\n                                               [(conj acc e) i]))\n                                           [[] 0] (:wait-set m))]\n              (cond-> (assoc m :wait-set entries :yin.k/issued issued\n                             :yin.k/gate (if (and root? (= :halted kind)) :ended :running))\n                (and root? (some? state)) (assoc :yin.k/custody state)))\n            m)]\n    (if fenced?\n      (assoc m :yin.k/gate :exporting :yin.k/recovery-waits (:wait-set m) :wait-set []\n             :yin.k/recovery-parked (:parked m) :parked {})\n      m)))\n\n\n(defn- attach-streams!\n  \"Step 11: one attach per distinct stream identity of the whole tree.\"\n  [attach! task]\n  (reduce (fn [acc s]\n            (let [[identity descriptor] (:slots s)]\n              (if (contains? acc identity)\n                acc\n                (if-some [h (remote/lower-marker attach! {:dao.stream/descriptor descriptor})]\n                  (assoc acc identity h)\n                  (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})))))\n          {} (rows-of task :stream false)))\n\n\n(defn- spawn-child\n  \"A fresh install child of recv's composition (the engine's spawn\n   discipline): answers [child recv']. A fenced rehydration spawns it\n   without the stream constructor, so the child's construction creates no\n   stream (its default call pair): rehydration initializes nothing. The\n   constructor is the child's again afterwards.\"\n  [recv response mn fenced?]\n  (let [n (or (:origins recv) 0)\n        origin (keyword (str (name (or (:origin recv) :t0)) \".\" n))\n        registry (reduce (fn [r [m e]] (module/assoc-module r m (dissoc e :bindings)))\n                         (:modules recv) (module/module-entries (:modules recv)))\n        source (:secret-source recv)\n        child (module/spawn-module (cond-> recv fenced? (assoc :make-stream nil))\n                                   (:value (:image response))\n                                   {:modules registry :origin origin\n                                    :ancestry (conj (vec (:ancestry recv)) mn)\n                                    :capability-secret (when (fn? source) (source origin))})]\n    [(cond-> child fenced? (assoc :make-stream (:make-stream recv)))\n     (assoc recv :origins (inc n))]))\n\n\n(defn- restore-task\n  \"Step 12 for one task: code by A, fresh resource keys, values re-sealed\n   under recv, waits as engine entries, parked records, installs, and the\n   custody check-custody! answered (with-custody).\"\n  [recv task handles custody root?]\n  (let [[_ _ kind _ id-counter free-env store module-stores parked census _ code installs waits parked-id result]\n        (:slots task)\n        base (reduce (fn [r [_ v]] (module/attach-module r v))\n                     (assoc recv :code {} :code-aliases {} :program nil)\n                     (sort-by #(str (key %)) code))\n        aliases (:code-aliases base)\n        used (atom (into fixed-resource-keys (keys (:resources base))))\n        identities (sort-by str (distinct (map #(first (:slots %)) (rows-of task :stream true))))\n        stream-keys (into {} (map (fn [identity] [identity (fresh-key! used)])) identities)\n        pairs (mapv vec (partition 2 (:slots census)))\n        cell-keys (into {} (map (fn [[c _]] [c (fresh-key! used)])) pairs)\n        bodies (into {} pairs)\n        stream-key #(get stream-keys (first (:slots %)))\n        parked-index (into {} (map vec) (partition 2 (:slots parked)))\n        cache (atom {})\n        resolving (atom #{})]\n    (letfn [(value\n              [v]\n              (case (first v)\n                :lit (second v)\n                :cursor-cell (engine/issue-ref base :cursor-ref (get cell-keys (second v)))\n                :row (row (second v))))\n            (row\n              [n]\n              (let [ss (:slots n)]\n                (case (:kind n)\n                  :vec (mapv value ss)\n                  :list (apply list (map value ss))\n                  :set (into #{} (map value) ss)\n                  :map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))\n                  :prim (vm/primitive-function (get (:primitives base) (first ss)))\n                  :stream (engine/issue-ref base :stream-ref (stream-key n))\n                  :closure (let [[a entry params bindings store-of] ss]\n                             (module/lower-closure base\n                                                   (cond-> {:yin.k/binding :named\n                                                            :yin.k/format :yin.semantic-register/code\n                                                            :yin.k/segment a :yin.k/entry entry :yin.k/params params\n                                                            :yin.k/env (keyed bindings)}\n                                                     (some? store-of) (assoc :yin.k/store-of store-of))\n                                                   identity))\n                  :reified (values/continuation (:owner base) (assoc (payload (first ss)) :type :reified-continuation))\n                  :parked-ref (parked-record (first ss)))))\n            (keyed\n              [n]\n              (into {} (map (fn [[k x]] [k (value x)])) (partition 2 (:slots n))))\n            (env\n              [n]\n              (let [[b store-of] (:slots n)]\n                (cond-> (keyed b) (some? store-of) (assoc engine/store-of-key store-of))))\n            (k-of\n              [n]\n              (mapv (fn [f]\n                      (let [[a pc e w rd] (:slots f)]\n                        {:type :return :segment (get aliases a) :pc pc :env (env e) :window (keyed w) :rd rd}))\n                    (:slots n)))\n            (payload\n              [n]\n              (if (= :tail (:kind n))\n                (let [[a site k] (:slots n)]\n                  {:segment (get aliases a) :site site :k (k-of k) :deliver {:deliver :return}})\n                (let [[a pc e w k rd] (:slots n)]\n                  {:segment (get aliases a) :pc pc :env (env e) :window (keyed w) :k (k-of k)\n                   :deliver {:deliver :rd :rd rd}})))\n            (parked-record\n              [p]\n              (or (get @cache p)\n                  (do (when (contains? @resolving p)\n                        (outcome! :yin.k/non-portable :non-canonicalizable {:yin.k/hint :parked-cycle}))\n                      (swap! resolving conj p)\n                      (let [r (assoc (payload (get parked-index p)) :type :parked-continuation :id p)]\n                        (swap! cache assoc p r)\n                        (swap! resolving disj p)\n                        r))))\n            (cell-stream\n              [c]\n              (stream-key (first (:slots (get bodies c)))))\n            (entry\n              [w]\n              (let [[state pending] (:slots w)\n                    [reason & xs] (:slots pending)\n                    p (payload state)]\n                (case reason\n                  :next (assoc p :reason :next :stream-id (cell-stream (first xs))\n                               :cursor-ref {:type :cursor-ref :id (get cell-keys (first xs))})\n                  :ffi (let [[c call-id op] xs]\n                         (cond-> (assoc p :reason :next :stream-id (cell-stream c) :call-id call-id\n                                        :cursor-ref {:type :cursor-ref :id (get cell-keys c)})\n                           (some? op) (assoc :op op)))\n                  :put (let [[s v op-id] xs]\n                         (cond-> (assoc p :reason :put :stream-id (stream-key s) :datom (value v))\n                           (some? op-id) (assoc :op-id op-id)))\n                  :ffi-request (let [[call-id envelope req resp c op-id] xs\n                                     datom (value envelope)]\n                                 (cond-> (assoc p :reason :put :stream-id (stream-key req) :datom datom\n                                                :request-sent true :call-id call-id :op (apply2/request-op datom)\n                                                :response-cursor (get cell-keys c) :response-stream (stream-key resp))\n                                   (some? op-id) (assoc :op-id op-id)))\n                  (:link-request :link-response)\n                  (let [[link-id mn _ _ c envelope op-id] xs]\n                    (cond-> (assoc p :reason reason :link-id link-id :name mn\n                                   :request module/link-request-resource :response module/link-response-resource\n                                   :cursor (second (:slots (get bodies c))))\n                      (= :link-request reason) (assoc :envelope envelope)\n                      (some? op-id) (assoc :op-id op-id)))\n                  :install (assoc p :reason :install :name (first xs)))))]\n      (let [store' (reduce (fn [s [k v]] (engine/store-put s k (value v))) {} (partition 2 (:slots store)))\n            stores (into {} (map (fn [ms]\n                                   (let [[mid s] (:slots ms)]\n                                     [mid (into {} (map (fn [[k v]] [k (value v)])) (partition 2 (:slots s)))])))\n                         module-stores)\n            parked' (into {} (map (fn [[p _]] [p (parked-record p)])) parked-index)\n            entries (mapv entry waits)\n            link (some #(let [[reason _ _ req resp] (:slots (second (:slots %)))]\n                          (when (contains? #{:link-request :link-response} reason) [req resp]))\n                       waits)\n            [base installs'] (reduce (fn [[r acc] inst]\n                                       (let [[mn phase parent response child] (:slots inst)\n                                             [spawned r'] (spawn-child r response mn (:fenced? custody))]\n                                         [r' (assoc acc mn {:phase phase :parent parent :response response\n                                                            :vm (restore-task spawned child handles custody false)})]))\n                                     [base {}] installs)\n            fe (keyed free-env)\n            resources (merge (:resources base)\n                             (into {} (map (fn [[identity k]] [k (get handles identity)])) stream-keys)\n                             (into {} (map (fn [[c body]]\n                                             [(get cell-keys c) {:stream-id (stream-key (first (:slots body)))\n                                                                 :cursor (second (:slots body))}]))\n                                   pairs)\n                             (when-let [[req resp] link]\n                               {module/link-request-resource (get handles (first (:slots req)))\n                                module/link-response-resource (get handles (first (:slots resp)))}))\n            ;; a fenced rehydration carries the counter exactly, so the\n            ;; relift reproduces the published root; a resumption adopts\n            ;; max(local, carried)\n            machine (cond-> (assoc base :store store' :module-stores stores :parked parked' :installs installs'\n                                   :resources resources :env fe :free-env fe :window {} :k nil :control nil\n                                   :ready-queue []\n                                   :id-counter (if (:fenced? custody)\n                                                 id-counter\n                                                 (max (or (:id-counter base) 0) id-counter)))\n                      ;; resource key -> the carrier's cursor cell, so one\n                      ;; cell is one key and two cells two (UCF 7.7.4)\n                      (:fenced? custody)\n                      (assoc :yin.k/recovery-cell-ids (into {} (map (fn [[c k]] [k c])) cell-keys)))]\n        (with-custody\n          (case kind\n            :halted (assoc machine :halted? true :blocked? false :value (value result) :wait-set [])\n            :parked (assoc machine :halted? true :blocked? false :