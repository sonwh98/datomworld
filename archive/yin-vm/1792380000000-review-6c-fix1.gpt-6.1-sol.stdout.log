      [yin.vm.semantic-register.frame :as frame]\n             [yin.vm.semantic-register.frame-test :as ft]\n             [yin.vm.semantic-register.layout :as layout]\n@@ -57,15 +60,29 @@\n   (atom {}))\n \n \n+(def ^:dynamic *projected*\n+  \"When bound, an atom {A v} of the vectors one world projected: the\n+   layouts' spaces read it instead of the whole file's code-index, so an\n+   alpha-equivalent A an unrelated fixture projected widens no lookup.\"\n+  nil)\n+\n+\n (defn project\n   [ast]\n   (let [v (:vector (linearize/project ast))\n         a (jing/segment-key v)]\n     (swap! source-index update a (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n     (swap! code-index assoc a v)\n+    (when *projected* (swap! *projected* assoc a v))\n     v))\n \n \n+(defn scoped\n+  \"f's result, every vector it projects recorded in a fresh *projected*.\"\n+  [f]\n+  (binding [*projected* (atom {})] (f)))\n+\n+\n (def stream-modules (module/register-stream-module (module/default-registry)))\n \n \n@@ -118,11 +135,14 @@\n \n \n (defn kernel-space\n-  \"The layout space of the A vectors whose images de Bruijn kernel k holds.\"\n+  \"The layout space of the A vectors whose images de Bruijn kernel k\n+   holds, among those this world projected (*projected*, when bound) or\n+   the file ever projected.\"\n   [k]\n   (let [id (if (= :stack (lane-of k)) :stack-id :register-id)\n         held (into #{} (map first) (:images k))]\n-    (layout/space (filter #(contains? held (id %)) (map segment-of (vals @code-index))))))\n+    (layout/space (filter #(contains? held (id %))\n+                          (map segment-of (vals (if *projected* @*projected* @code-index)))))))\n \n \n (defn- kernel-load\n@@ -1388,10 +1408,11 @@\n ;; =============================================================================\n \n (def link-rows\n-  \"Rows the de Bruijn lanes do not carry: a require installs a child and\n-   attaches a module image in the kernel's own format, and the layouts\n-   of §4 reconstruct no install child (canonical-task refuses\n-   :installs).\"\n+  \"Rows the de Bruijn lanes do not carry (§5.3, the shared fragment): a\n+   de Bruijn kernel links a native image while module responses carry A,\n+   and §4 defines no layout for install children (canonical-task refuses\n+   :installs). The reference lane runs the whole matrix; these lanes are\n+   removed with their kernels at phase 8.\"\n   #{7 8 9 10 11 12 17})\n \n \n@@ -1401,7 +1422,8 @@\n \n \n(ns yin.vm.semantic-register.safepoint-harness-test\n  \"Phase 6b: the safepoint harness on the :semantic-register lane\n   (docs/design/yin.vm.semantic-register-vm.continuation.md §5, §8.2).\n\n   Each row of the §5.2 matrix is built twice under each of the four\n   segment wrappers: the reference build is satisfied and run on its own\n   machine; the handoff build is lifted with rows/lift-task, lowered with\n   rows/lower-task into a fresh receiver over the toy channel, relifted at\n   once, then satisfied through the source's streams. Result and effect\n   trace equal the reference (law 1); the relift equals the lift by root\n   id under rows/canonical-under (law 2); the pending's reason is the\n   observed wait's (law 3); every lifted frame passes the validator\n   (law 6). Row 20 runs once, outside the wrappers.\n\n   Phase 6c adds the two de Bruijn lanes (§5.3): a world built under\n   *lane* :stack or :register runs A's derived image on that kernel and\n   lifts and lowers through yin.vm.semantic-register.layout. Law 4 (one\n   root id on all three lanes under canonical-under), law 5 (six ordered\n   lowering pairs, each continuing to the reference result) and the\n   layout refusals close the file.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.stream :as stream]\n            [dao.stream.apply :as apply2]\n            [dao.test-slow :as slow]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ffi :as ffi]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.semantic-register :as sr]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.parity-test :as b0]\n            [yin.vm.semantic-register.analysis :as analysis]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.corpus :as corpus]\n            [yin.vm.semantic-register.frame :as frame]\n            [yin.vm.semantic-register.frame-test :as ft]\n            [yin.vm.semantic-register.layout :as layout]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.ucf.lift-support :as support]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n;; =============================================================================\n;; The composition: code by A, the source index, one machine builder\n;; =============================================================================\n\n(def source-index\n  \"The composition's {A #{tree-address}} (§6.1): every vector this\n   harness projects is recorded beside the address of its AST.\"\n  (atom {}))\n\n\n(def code-index\n  \"{A v}: every vector this harness projects, for the layouts' spaces.\"\n  (atom {}))\n\n\n(def ^:dynamic *projected*\n  \"When bound, an atom {A v} of the vectors one world projected: the\n   layouts' spaces read it instead of the whole file's code-index, so an\n   alpha-equivalent A an unrelated fixture projected widens no lookup.\"\n  nil)\n\n\n(defn project\n  [ast]\n  (let [v (:vector (linearize/project ast))\n        a (jing/segment-key v)]\n    (swap! source-index update a (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n    (swap! code-index assoc a v)\n    (when *projected* (swap! *projected* assoc a v))\n    v))\n\n\n(defn scoped\n  \"f's result, every vector it projects recorded in a fresh *projected*.\"\n  [f]\n  (binding [*projected* (atom {})] (f)))\n\n\n(def stream-modules (module/register-stream-module (module/default-registry)))\n\n\n(def ^:dynamic *lane*\n  \"The kernel a world is built on: :semantic-register (the reference\n   lane), or :stack or :register, which run A's derived image and lift\n   and lower through the layouts (§5.3).\"\n  :semantic-register)\n\n\n(def lanes [:semantic-register :stack :register])\n\n\n(defn- composition\n  [opts]\n  (merge {:make-stream tu/make-stream :capability-secret tu/secret\n          :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n          :modules stream-modules}\n         opts))\n\n\n(defn- kernel-opts\n  \"A de Bruijn kernel's options for the same composition: the full\n   primitive table, and the initial environment as :free-env.\"\n  [opts]\n  (cond-> (assoc (dissoc (composition opts) :env) :primitives vm/primitives)\n    (contains? opts :env) (assoc :free-env (:env opts))))\n\n\n(defn machine\n  ([] (machine {}))\n  ([opts]\n   (case *lane*\n     :semantic-register (sr/create-vm (composition opts))\n     :stack (dvm/create-vm [] (kernel-opts opts))\n     :register (rvm/create-vm (assoc {} :bodies [] :instructions []) (kernel-opts opts)))))\n\n\n(defn lane-of\n  [m]\n  (let [f (:format (module/link-format m))]\n    (cond (= dvm/format-tag f) :stack\n          (= rvm/format-tag f) :register\n          :else :semantic-register)))\n\n\n(def segment-of\n  \"layout/segment, once per A.\"\n  (memoize layout/segment))\n\n\n(defn kernel-space\n  \"The layout space of the A vectors whose images de Bruijn kernel k\n   holds, among those this world projected (*projected*, when bound) or\n   the file ever projected.\"\n  [k]\n  (let [id (if (= :stack (lane-of k)) :stack-id :register-id)\n        held (into #{} (map first) (:images k))]\n    (layout/space (filter #(contains? held (id %))\n                          (map segment-of (vals (if *projected* @*projected* @code-index)))))))\n\n\n(defn- kernel-load\n  \"Attach v's derived image and start it at its row, beside whatever the\n   kernel already holds: parked records keep naming their own rows.\"\n  [k v]\n  (let [kind (lane-of k)\n        sg (segment-of v)\n        k (if (= :stack kind)\n            (dvm/attach-image k (:stack sg) vm/stack-contract)\n            (rvm/attach-image k (:register sg) vm/register-contract))\n        k (assoc k :pc (layout/offset kind k sg) :frames [] :continuation [] :store-of nil\n                 :halted? false :blocked? false :value nil)]\n    (if (= :stack kind)\n      (assoc k :stack [])\n      (assoc k :registers (vec (repeat (:registers (first (:bodies (:register sg)))) nil))))))\n\n\n(defn load-program\n  [m ast]\n  (if (= :semantic-register (lane-of m))\n    (sr/load-vector m (project ast) code/contract)\n    (kernel-load m (project ast))))\n\n\n(defn lane-closure\n  \"Canonical closure payload c, its :segment an A, as machine m's value.\"\n  [m c]\n  (if (= :semantic-register (lane-of m))\n    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))\n    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))\n\n\n(defn lift-opts\n  []\n  {:source-index @source-index})\n\n\n(defn error\n  [f]\n  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n\n\n;; =============================================================================\n;; The corpus: four segments around one parking expression\n(defn- image-collision\n  \"§4.1: `[ident #{A …}]` for the first image of kind `kind` two carried A\n   derive, or nil. A de Bruijn kernel attaches one image once, so it\n   cannot hold both segments; no enumeration order selects an A. A\n   vector that derives no image is left to the carrier's own checks.\"\n  [code kind]\n  (let [ident (fn [a v]\n                (try\n                  (if (= :stack kind)\n                    (dcode/image-hash (:image (derive/stack-image v)))\n                    (rcode/register-hash (derive/register-image v)))\n                  (catch #?(:cljd Object :clj Throwable :cljs :default) _ [::underivable a])))\n        by-image (reduce (fn [acc [a v]] (update acc (ident a v) (fnil conj #{}) a)) {} code)]\n    (some (fn [[i as]] (when (< 1 (count as)) [i as])) (sort-by (comp str key) by-image))))\n\n\n(defn lower-defect\n  \"What a kernel of `kind` cannot hold, judged on decoded task `task`\n   before anything is attached: two carried A of one image (§4.1), install\n   children (not carried by this phase's layouts), a closure or\n   continuation in the free environment (§6.3), and for the register\n   kernel a primitive function in the payload data of a wait or parked\n   state (a window, a lexical binding, or reached through them), which\n   its restore refuses as `:continuation-registers` (`vm/machine-data?`).\n   nil when it can.\"\n  [task kind]\n  (let [slots (:slots task)\n        code (nth slots 11)\n        collision (image-collision code kind)\n        free (free-env-procedure task)]\n    (cond\n      collision\n      (assoc {} :yin.k/status :yin.k/unsupported :yin.k/kind :ambiguous-image\n             :yin.k/image (first collision) :yin.k/segments (second collision))\n\n      (seq (nth slots 12))\n      (assoc {} :yin.k/status :yin.k/unsupported :yin.k/kind :installs)\n\n      free\n      (assoc {} :yin.k/status :yin.k/unsupported :yin.k/kind :free-env-value :yin.k/path free)\n\n      (= :register kind)\n      (when-let [path (or (some (fn [[i w]] (state-prim code (first (:slots w)) [:frames i]))\n                                (map-indexed vector (nth slots 13)))\n                          (some (fn [[p st]] (state-prim code st [:parked p]))\n                                (partition 2 (:slots (nth slots 8)))))]\n        (assoc {} :yin.k/status :yin.k/unsupported :yin.k/kind :continuation-registers :yin.k/path path))\n\n      :else nil)))\n\n\n(defn lower-task\n  \"§7.2 into a de Bruijn kernel: decode `wire`, refuse what kernel `k`\n   cannot hold (`lower-defect`) before any attach, then `rows/lower-task`\n   into `scratch` (a fresh semantic-register machine of the same\n   composition: the carrier's steps 1-11 and restore) and `kernel-task`\n   into `k`. Throws the first refusal as ex-data.\"\n  ([scratch k wire attach!] (lower-task scratch k wire attach! {}))\n  ([scratch k wire attach! opts]\n   (let [task (rows/decode wire (merge rows/default-budget (:budget opts)))]\n     (when (= :task (:kind task))\n       (when-let [d (lower-defect task (kernel-kind k))]\n         (throw (ex-info \"Layout refused\" d))))\n     (kernel-task (rows/lower-task scratch wire attach! opts) k))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'clojure -M:test -e :slow -n yin.vm.semantic-register.layout-test -n yin.vm.semantic-register.safepoint-harness-test -n yin.vm.ucf.rows-test -n yin.vm.store-write-audit-test > /tmp/6c-quick.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1430,1615p' test/yin/vm/semantic_register/safepoint_harness_test.cljc\nsed -n '210,245p' src/cljc/yin/vm/semantic_register/layout.cljc\nrg -n 'kernel-space|defn envs|defn lifted-waits|defn stack-frames|closures-round-trip' test/yin/vm/semantic_register/layout_test.cljc\nrg -n 'scan-test|goldens|slow' test/yin/vm/semantic_register/scan_test.cljc\n git rev-parse master\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1430,1615p' test/yin/vm/semantic_register/safepoint_harness_test.cljc\nsed -n '210,245p' src/cljc/yin/vm/semantic_register/layout.cljc\nrg -n 'kernel-space|defn envs|defn lifted-waits|defn stack-frames|closures-round-trip' test/yin/vm/semantic_register/layout_test.cljc\nrg -n 'scan-test|goldens|slow' test/yin/vm/semantic_register/scan_test.cljc\n git rev-parse master\"","aggregated_output":"\n(defn on-lane\n  [lane build]\n  (binding [*lane* lane] (build)))\n\n\n(defn lane-lift\n  \"The lift of §7.1 on m's own lane.\"\n  [m serve!]\n  (if (= :semantic-register (lane-of m))\n    (rows/lift-task m serve! (lift-opts))\n    (layout/lift-task m (kernel-space m) (on-lane :semantic-register machine) serve! (lift-opts))))\n\n\n(defn lane-lower\n  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n  [lane opts wire attach!]\n  (let [scratch (on-lane :semantic-register #(machine opts))]\n    (if (= :semantic-register lane)\n      (rows/lower-task scratch wire attach!)\n      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n\n\n(defn injective\n  \"names, asserting no two identities share a logical name (§5.5).\"\n  [names]\n  (is (= (count names) (count (distinct (vals names)))) \"the correspondence is injective\")\n  names)\n\n\n(defn logical-names\n  \"§5.5's explicit correspondence: each served identity to the resource\n   key the lifted machine holds that handle under. The fixture builds the\n   same program on every lane, so one key names one logical stream.\"\n  [m peer]\n  (injective\n    (into {} (map (fn [[id e]]\n                    [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n                            (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n          @(:table peer))))\n\n\n(defn ring-names\n  \"{stream identity -> resource key} over every stream m holds.\"\n  [m]\n  (injective\n    (into {} (keep (fn [[k h]]\n                     (when (satisfies? stream/IDaoStreamDescriptor h)\n                       [(:dao.stream/identity (stream/descriptor h)) k])))\n          (:resources m))))\n\n\n(defn logical-positions\n  \"The task with each cursor position's embedded stream identity renamed\n   to its logical name. A ring buffer cursor carries its stream's\n   identity, which §5.5's marker substitution does not reach, so the\n   cross-lane comparison renames only that field, under the same fixture\n   correspondence; every other field, the offset included, is kept.\"\n  [task m]\n  (let [names (ring-names m)\n        k :dao.stream.ringbuffer/identity]\n    (replace-nodes task #(= :cursor-cell-body (:kind %))\n                   (fn [n]\n                     (update-in n [:slots 1]\n                                (fn [p]\n                                  (if (and (map? p) (contains? names (get p k)))\n                                    (assoc p k (get names (get p k)))\n                                    p)))))))\n\n\n(defn rename-identities\n  \"x with every :dao.stream/identity value that names maps renamed.\"\n  [x names]\n  (cond\n    (map? x) (into {} (map (fn [[k v]]\n                             [k (if (and (= :dao.stream/identity k) (contains? names v))\n                                  (get names v)\n                                  (rename-identities v names))]))\n                   x)\n    (vector? x) (mapv #(rename-identities % names) x)\n    :else x))\n\n\n(defn logical-descriptors\n  \"§5.5: {logical name -> stream descriptor, identities renamed} over every\n   stream m holds. canonical-under erases a marker's descriptor, so the\n   lanes' descriptors are shown equivalent on these, separately.\"\n  [m]\n  (let [names (ring-names m)]\n    (into {} (keep (fn [[k h]]\n                     (when (satisfies? stream/IDaoStreamDescriptor h)\n                       [k (rename-identities (stream/descriptor h) names)])))\n          (:resources m))))\n\n\n(defn descriptors-equivalent?\n  \"Each lane's logical-descriptors, one per lane: equal maps.\"\n  [ds]\n  (apply = ds))\n\n\n(defn identities-in\n  \"The members of ids anywhere in x.\"\n  [x ids]\n  (cond\n    (contains? ids x) #{x}\n    (map? x) (into #{} (mapcat #(identities-in % ids)) (concat (keys x) (vals x)))\n    (coll? x) (into #{} (mapcat #(identities-in % ids)) x)\n    :else #{}))\n\n\n(defn task-root\n  \"§5.5 over decoded task: positions renamed, re-emitted, then\n   canonical-under the served correspondence; no lane identity survives.\"\n  [task m peer]\n  (let [names (logical-names m peer)\n        canonical (rows/canonical-under (rows/emit (logical-positions task m)) names)]\n    (is (empty? (identities-in (:yin.k/rows canonical) (into (set (keys names)) (keys (ring-names m)))))\n        \"every lane identity was renamed\")\n    (:yin.k/root canonical)))\n\n\n(defn logical-root\n  \"§5.5: the lift's root id with every lane identity replaced by the\n   fixture's logical name.\"\n  [wire m peer]\n  (task-root (rows/decode wire) m peer))\n\n\n(defn lane-root\n  \"Build on lane, lift: {:root under the logical names, :reference the\n   lane's own run, :lane the kernel the world ran on, :descriptors, and\n   :task :machine :peer for the controls}.\"\n  [lane build]\n  (scoped\n    (fn []\n      (let [world (on-lane lane build)\n            m (:machine world)\n            {:keys [serve! peer]} (served (or (:surfaces world) #{:reader}))\n            task (rows/decode (lane-lift m serve!))]\n        (is (nil? (rows/validate-frames task)) \"law 6 on every lane\")\n        {:root (task-root task m peer)\n         :reference (reference (on-lane lane build))\n         :lane (lane-of m) :descriptors (logical-descriptors m)\n         :task task :machine m :peer peer}))))\n\n\n(defn canonical-equality\n  \"Law 4 for one case: exactly the three distinct kernel lanes lift to one\n   root, their streams' descriptors are equivalent under the\n   correspondence, and each lane's own run answers the reference.\"\n  [build expected]\n  (let [roots (mapv #(lane-root % build) lanes)]\n    (is (= 3 (count roots)))\n    (is (= [:semantic-register :stack :register] (mapv :lane roots)) \"three distinct kernel lanes\")\n    (is (apply = (map :root roots)) \"law 4: one root id on every lane\")\n    (is (descriptors-equivalent? (mapv :descriptors roots)) \"descriptors equivalent under the correspondence\")\n    (doseq [{:keys [lane reference]} roots]\n      (is (:halted reference) (str lane \" completes\"))\n      (when (some? expected) (is (= expected (:value reference)) (str lane \" answers the reference\"))))\n    roots))\n\n\n(defn control-root\n  \"A lane's root with its decoded task changed by f first.\"\n  [{:keys [task machine peer]} f]\n  (let [task' (f task)]\n    (is (not= task task') \"the control changed the task\")\n    (task-root task' machine peer)))\n\n\n(defn first-binding\n  \"Pairs node n with the value of its first pair whose key satisfies pred\n   replaced by v.\"\n  [n pred v]\n  (let [ps (pairs-of n)\n        i (first (keep-indexed (fn [i [k _]] (when (pred k) i)) ps))]\n    (if i (rows/node (:kind n) (mapcat identity (assoc-in ps [i 1] v))) n)))\n\n\n(deftest law-4-controls\n  ;; §5.5 (D1): a changed position offset, descriptor field, saved value or\n  ;; lexical value changes what law 4 compares\n  (let [roots (canonical-equality #(bare 1) [\"A\" \"B\"])\n        [sr stack-lane register-lane] roots\n        base (:root sr)]\n  [seg p]\n  (reduce (fn [acc q] (into acc (analysis/live (:analysis seg) q)))\n          #{}\n          (analysis/successors (:vector seg) p)))\n\n\n(defn register-live\n  \"§5.6 item 3: the `live` operand R must carry at boundary `p`,\n   `(sort (map phys (disj live-out*(p) rd)))`, the destination removed as\n   a virtual id before mapping; `[]` at a tail call.\"\n  [seg p]\n  (vec (sort (map #(phys seg p %) (disj (live-out seg p) (code/rd (inst seg p)))))))\n\n\n(defn virt\n  \"The restricted inverse of `phys` at boundary `p`: the virtual of\n   `live-out*(p)` held in physical `s`. A slot outside that image (only a\n   tampered entry names one) reads as the one virtual of the body R maps\n   there, so the frame validator judges the window; an ambiguous slot is\n   refused.\"\n  [seg p s]\n  (let [m (nth (:phys seg) (body-of seg p))\n        live (filterv #(= s (get m %)) (sort (live-out seg p)))\n        named (filterv #(= s (get m %)) (sort (keys m)))]\n    (cond\n      (= 1 (count live)) (first live)\n      (and (empty? live) (= 1 (count named))) (first named)\n      :else (refuse! :yin.k/non-portable :register-layout {:yin.k/pc p :yin.k/register s}))))\n\n\n(defn stack-layout\n  \"§4.3: the virtual registers pushed and not yet consumed while control\n   is inside the expression at A pc `p`, bottom to top.\"\n  [seg p]\n  (get (:layouts seg) p))\n\n108:(defn lifted-waits\n114:    (:wait-set (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))\n199:(defn stack-frames\n203:  (let [sp (h/kernel-space k)\n250:      (let [sp (h/kernel-space k)\n280:(defn envs\n287:                 (vals (:parked (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))]\n350:(deftest closures-round-trip\n357:              sp (h/kernel-space k)\n429:;; widen that test's unscoped kernel-space.\n488:                            (is (= #{(:address ax)} (set (keys (:segments (h/kernel-space m))))))\n1:(ns yin.vm.semantic-register.scan-test\n6:            [dao.test-slow :as slow]\n17:            [yin.vm.semantic-register.scanner-goldens :as goldens]\n205:      (is (= (get-in goldens/scanner-goldens [group n]) old new)))))\n210:  (:vector (get corpus/goldens n)))\n291:(deftest ^:slow scanners-agree-on-the-c4-modules\n292:  (slow/guard \"scanners-agree-on-the-c4-modules\"\n315:(deftest ^:slow goldens-match\n316:  (slow/guard \"goldens-match\"\n321:                    (is (= (get-in goldens/scanner-goldens [group n]) (old-answer ast) (new-answer ast))))))))\n324:(deftest ^:slow verify-outcomes-agree\n325:  (slow/guard \"verify-outcomes-agree\"\n336:   :clj (defn print-goldens\n3de53c6956bc223bead59c175a15dee03a0e2f84\n","exit_code":0,"status":"completed"}}
