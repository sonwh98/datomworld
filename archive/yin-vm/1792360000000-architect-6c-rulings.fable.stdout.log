   m0 (vm/run (load-program (machine {:link-request request :link-response response})\n346\t                                 (with-cat (wrap (require-op tail?)))))\n347\t        id (:link-id (first (:wait-set m0)))\n348\t        _ (stream/append! response (assoc (module-response blocking-body #{'f}) :yin.link/id id))\n349\t        m1 (vm/run m0)\n350\t        m (if phase (assoc-in m1 [:installs 'host.mod :phase] phase) m1)\n351\t        child (get-in m [:installs 'host.mod :vm])\n352\t        child-stream (s/stream-of child)]\n353\t    {:machine m :kind :blocked :reason :install :trace trace\n354\t     :steps [#(stream/append! child-stream :fed)]\n355\t     :finish #(swap! trace into (tu/drain request))\n356\t     :receiver (link-receiver trace)}))\n357\t\n358\t\n359\t(defn module-context\n360\t  \"Blocked inside host.mod's exported closure, whose E names store-of host.mod.\"\n361\t  [wrap]\n362\t  (let [request (s/ring 64) response (s/ring 64)\n363\t        body (s/def! 'f (s/lam ['c] (s/app (s/v 'stream/next!) (s/v 'c))))\n364\t        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n365\t                                 (with-stream (with-cat (wrap (s/then (s/app (s/v 'require) (s/lit 'host.mod))\n366\t                                                                      (s/app (s/v 'host.mod/f) (s/v 'c))))))))\n367\t        id (:link-id (first (:wait-set m0)))\n368\t        _ (stream/append! response (assoc (module-response body #{'f}) :yin.link/id id))\n369\t        m (vm/run m0)\n370\t        src (s/stream-of m)]\n371\t    ;; The carrier holds module stores, not registry entries: the receiver's\n372\t    ;; composition links host.mod itself, so its relift discharges host.mod/f.\n373\t    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])\n374\t     :receiver (constantly {:opts {:modules (:modules m)}})}))\n375\t\n376\t\n377\t(defn run-beside\n378\t  [m ast]\n379\t  (vm/run (load-program m ast)))\n380\t\n381\t\n382\t(defn parking\n383\t  [m]\n384\t  (let [pid (:id (vm/value m))]\n385\t    {:machine m :kind :parked :pid pid :trace (atom [])\n386\t     :resume #(run-beside % {:type :vm/resume :parked-id pid :val (s/lit \"back\")})}))\n387\t\n388\t\n389\t(defn module-store-cursors\n390\t  \"An explicit park whose module store holds two cursor references nothing\n391\t   else reaches, named by a module closure in the task store.\"\n392\t  [wrap]\n393\t  (let [ring (s/ring 4)\n394\t        ast (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))\n395\t        v (project ast)\n396\t        m (vm/run (load-program (machine) ast))\n397\t        cursor (fn [m]\n398\t                 (let [[ref m] (engine/attach-resource m ring) [id m] (engine/gensym m \"cursor\")]\n399\t                   (engine/handle-cursor m {:stream ref} id)))\n400\t        [c1 m] (cursor m)\n401\t        [c2 m] (cursor m)\n402\t        closure (first (filter #(= :closure (first %)) v))\n403\t        clo (lane-closure m {:type :closure :params (nth closure 2) :entry (nth closure 3)\n404\t                             :segment (jing/segment-key v) :env {engine/store-of-key 'host.mod}})]\n405\t    (parking (assoc m :store {'mod clo} :module-stores {'host.mod {'c c1 'd c2}}))))\n406\t\n407\t\n408\t(defn free-env-world\n409\t  [wrap env]\n410\t  (reader wrap (s/let1 'f (s/lam [] (s/v 'x)) (s/app (s/lam ['x] (s/app (s/v 'f) (s/next-of (s/v 'c)))) (s/lit 1)))\n411\t          [] \"B\" {:env env}))\n412\t\n413\t\n414\t(def read-op (s/next-of (s/v 'c)))\n415\t\n416\t\n417\t(def capture {:type :vm/current-continuation})\n418\t\n419\t\n420\t(def rows\n421\t  \"[row bare-result build]: rows 1-19, 21, 22, 24 of §5.2. A nil result\n422\t   compares with the reference only.\"\n423\t  [[1 [\"A\" \"B\"] #(reader % (s/let1 'a read-op (cat-of (cat-of (s/lit []) (s/v 'a)) read-op)) [\"A\"] \"B\" {})]\n424\t   [2 nil writer]\n425\t   [3 \"echo!\" sent-ffi]\n426\t   [4 \"echo!\" retained-ffi]\n427\t   [5 [:ordinary \"B\"] #(reader % (cat-of (s/lit [:ordinary]) (s/app (s/v 'stream/next!) (s/v 'c))))]\n428\t   [6 \"B\" #(reader % (s/app (s/lam ['u] (tail (s/app (s/v 'stream/next!) (s/v 'c)))) (s/lit 0)))]\n429\t   [7 'host.mod #(linking % false true)]\n430\t   [8 'host.mod #(linking % false false)]\n431\t   [9 'host.mod #(linking % true false)]\n432\t   [10 'host.mod #(installing % false nil)]\n433\t   [11 'host.mod #(installing % false :running)]\n434\t   [12 'host.mod #(installing % true nil)]\n435\t   [13 \"back\" #(parking (vm/run (load-program (machine) (with-cat (% {:type :vm/park})))))]\n436\t   [14 [:continuation \"B\"] #(reader % (s/let1 'k capture (cat-of (cat-of (s/lit []) (s/v 'k)) read-op)))]\n437\t   [15 :done #(reader % (s/let1 'k capture {:type :if :test (s/app (s/v '=) (s/v 'k) (s/lit :second))\n438\t                                            :consequent (s/lit :done)\n439\t                                            :alternate (s/let1 'r read-op (s/app (s/v 'k) (s/lit :second)))})\n440\t                      [] \"x\" {})]\n441\t   [16 [:continuation :continuation \"B\"]\n442\t    #(reader % (s/let1 'k1 capture (s/let1 'k2 capture (cat-of (cat-of (cat-of (s/lit []) (s/v 'k1)) (s/v 'k2)) read-op))))]\n443\t   [17 \"B\" module-context]\n444\t   [18 \"back\" module-store-cursors]\n445\t   [19 42 #(let [m (vm/run (load-program (machine) (with-cat (% (s/lit 42)))))]\n446\t             {:machine m :kind :halted :trace (atom [])})]\n447\t   [21 99 #(free-env-world % {'x 99})]\n448\t   [22 [nil \"B\"] #(reader % (s/let1 'pair (s/lam ['p 'q] (cat-of (cat-of (s/lit []) (s/v 'p)) (s/v 'q)))\n449\t                                    (s/app (s/v 'pair) (s/lit nil) read-op)))]\n450\t   [24 \"echo!\" sent-ffi]])\n451\t\n452\t\n453\t(defn tail-effect-halt\n454\t  \"Row 20, outside the wrappers: a setup batch to halt, then the root tail\n455\t   call (stream/next! c) with an empty K.\"\n456\t  []\n457\t  (let [setup (vm/run (load-program (machine) (s/then (s/def! 's {:type :stream/make :buffer 4})\n458\t                                                      (s/def! 'c (s/cursor-of (s/v 's))))))\n459\t        m (run-beside setup (tail (s/app (s/v 'stream/next!) (s/v 'c))))\n460\t        src (s/stream-of m)]\n461\t    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n462\t\n463\t\n464\t;; =============================================================================\n465\t;; The two runs\n466\t;; =============================================================================\n467\t\n468\t(defn drive-local\n469\t  [m]\n470\t  (loop [m (vm/run m) n 12]\n471\t    (if (or (not (vm/blocked? m)) (zero? n)) m (recur (vm/run m) (dec n)))))\n472\t\n473\t\n474\t(defn drive-peers\n475\t  [m peers]\n476\t  (loop [m (vm/run m) n 12]\n477\t    (if (or (not (vm/blocked? m)) (zero? n))\n478\t      m\n479\t      (do (run! s/serve-mirror! peers) (recur (vm/run m) (dec n))))))\n480\t\n481\t\n482\t(defn satisfy\n483\t  [world m drive]\n484\t  (if-let [resume (:resume world)]\n485\t    (resume m)\n486\t    (reduce (fn [m step] (step) (drive m)) m (:steps world))))\n487\t\n488\t\n489\t(defn reference\n490\t  [world]\n491\t  (let [done (satisfy world (:machine world) drive-local)]\n492\t    (when-let [f (:finish world)] (f))\n493\t    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n494\t\n495\t\n496\t(defn served\n497\t  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n498\t  [surfaces]\n499\t  (let [t (s/toy) peer (s/served-peer t)]\n500\t    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n501\t\n502\t\n503\t(defn recording-attacher\n504\t  \"The receiver's attach!, counting attaches and recording each\n505\t   reflection's source identity.\"\n506\t  [t]\n507\t  (let [base (s/attacher t) origin (atom {}) n (atom 0)]\n508\t    {:attach! (fn [d]\n509\t                (swap! n inc)\n510\t                (let [r (base d)]\n511\t                  (when-let [h (:dao.stream/handle r)] (swap! origin assoc h (:dao.stream/identity d)))\n512\t                  r))\n513\t     :origin origin :count n}))\n514\t\n515\t\n516\t(defn handed-off\n517\t  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n518\t   the source's streams.\"\n519\t  [world]\n520\t  (let [surfaces (or (:surfaces world) #{:reader})\n521\t        {:keys [toy peer serve!]} (served surfaces)\n522\t        wire (rows/lift-task (:machine world) serve! (lift-opts))\n523\t        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n524\t        receiver ((or (:receiver world) (constantly nil)))\n525\t        {:keys [attach! origin] n :count} (recording-attacher toy)\n526\t        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n527\t        attaches @n\n528\t        again (served surfaces)\n529\t        relift (rows/lift-task recv (:serve! again) (lift-opts))\n530\t        corr2 (into {} (map (fn [[id e]] [id (get @origin (:handle e))])) @(:table (:peer again)))\n531\t        done (satisfy world recv #(drive-peers % [peer]))\n532\t        _ (s/serve-mirror! peer)]\n533\t    (when-let [f (:finish world)] (f))\n534\t    (when-let [f (:finish receiver)] (f))\n535\t    {:wire wire :recv recv :relift relift :corr corr :corr2 corr2 :attaches attaches\n536\t     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n537\t\n538\t\n539\t(defn root-task\n540\t  [wire]\n541\t  (rows/decode wire))\n542\t\n543\t\n544\t(defn stream-identities\n545\t  \"The distinct stream identities of the whole carrier, install children\n546\t   included: one row table serves the tree.\"\n547\t  [wire]\n548\t  (into #{} (keep (fn [r] (when (= :stream (second r)) (nth r 2)))) (:yin.k/rows wire)))\n549\t\n550\t\n551\t(defn rows-in\n552\t  \"Every row node the decoded tree x reaches, once per path.\"\n553\t  [x]\n554\t  (cond\n555\t    (and (map? x) (contains? x :kind) (contains? x :slots)) (cons x (rows-in (:slots x)))\n556\t    (sequential? x) (mapcat rows-in x)\n557\t    :else nil))\n558\t\n559\t\n560\t(defn stream-occurrences\n561\t  \"How many times the decoded tree reaches a :stream row.\"\n562\t  [x]\n563\t  (count (filter #(= :stream (:kind %)) (rows-in x))))\n564\t\n565\t\n566\t(defn slot\n567\t  [task i]\n568\t  (nth (:slots task) i))\n569\t\n570\t\n571\t(defn first-pending\n572\t  [task]\n573\t  (second (:slots (first (slot task 13)))))\n574\t\n575\t\n576\t(defn laws\n577\t  \"Laws 1, 2, 3 and 6 for one world; answers the run.\"\n578\t  [world expected]\n579\t  (let [{:keys [wire relift corr corr2 attaches] :as got} (handed-off world)\n580\t        task (root-task wire)]\n581\t    (is (= (:kind world) (slot task 2)))\n582\t    (is (= (count (stream-identities wire)) attaches) \"one attach per distinct stream identity\")\n583\t    (when (= :blocked (:kind world))\n584\t      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n585\t    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n586\t    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n587\t        \"law 2: lift(lower(S)) = S by root id\")\n588\t    (is (:halted expected) \"the reference run completes\")\n589\t    (is (= (select-keys expected [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n590\t        \"law 1: result and effect trace equal the reference\")\n591\t    got))\n592\t\n593\t\n594\t(defn matrix-cases\n595\t  \"22 wrapped rows x 4 segments, plus row 20 once: [row segment expected build].\"\n596\t  []\n597\t  (conj (into [] (mapcat (fn [[n r build]]\n598\t                           (mapv (fn [[label wrap expected-of]]\n599\t                                   ;; nest's own parameter is x: under :depth-3,\n600\t                                   ;; row 21's (fn [] x) closes over the wrapper's\n601\t                                   ;; x = 1, not the free x = 99 (§5.2 assumes 99)\n602\t                                   (let [r (if (and (= 21 n) (= :depth-3 label)) 1 r)]\n603\t                                     [n label (when (some? r) (expected-of r)) #(build wrap)]))\n604\t                                 segments)))\n605\t              rows)\n606\t        [20 :unwrapped \"B\" tail-effect-halt]))\n607\t\n608\t\n609\t(defn bare\n610\t  [n]\n611\t  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n612\t    (build identity)))\n613\t\n614\t\n615\t;; =============================================================================\n616\t;; Acceptance 1: 89 runs\n617\t;; =============================================================================\n618\t\n619\t(deftest ^:slow every-row-every-segment-matches-the-reference\n620\t  (slow/guard\n621\t    \"every-row-every-segment-matches-the-reference\"\n622\t    (fn []\n623\t      (let [cases (matrix-cases) runs (atom 0)]\n624\t        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n625\t        (doseq [[n label expected build] cases]\n626\t          (testing (str \"row \" n \" \" (name label))\n627\t            (let [ref (reference (build))]\n628\t              (when (some? expected)\n629\t                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n630\t              (laws (build) ref)\n631\t              (swap! runs inc))))\n632\t        (is (= 89 @runs))))))\n633\t\n634\t\n635\t(deftest bare-rows-match-the-reference\n636\t  ;; The quick-tier slice of acceptance 1: every row once, bare.\n637\t  (let [counted (atom [0 0])]\n638\t    (doseq [[n r build] rows]\n639\t      (testing (str \"row \" n)\n640\t        (let [ref (reference (build identity))\n641\t              {:keys [wire attaches]} (laws (build identity) ref)]\n642\t          (when (some? r) (is (= r (:value ref))))\n643\t          (swap! counted (fn [[a i]] [(+ a attaches) (+ i (count (stream-identities wire)))])))))\n644\t    ;; outside laws, so deleting its count assertion leaves one standing\n645\t    (is (pos? (first @counted)) \"the corpus attaches streams\")\n646\t    (is (apply = @counted) \"attaches = distinct stream identities over the corpus\")))\n647\t\n648\t\n649\t;; =============================================================================\n650\t;; Acceptance 2-6\n651\t;; =============================================================================\n652\t\n653\t(defn wait-state\n654\t  [wire]\n655\t  (first (:slots (first (slot (root-task wire) 13)))))\n656\t\n657\t\n658\t(deftest tail-states-carry-no-window\n659\t  (doseq [[label world] [[6 (bare 6)] [9 (bare 9)] [12 (bare 12)] [20 (tail-effect-halt)]]]\n660\t    (testing (str \"row \" label)\n661\t      (let [{:keys [serve!]} (served #{:reader :writer})\n662\t            wire (rows/lift-task (:machine world) serve! (lift-opts))\n663\t            state (wait-state wire)\n664\t            row (first (filter #(= :tail (second %)) (:yin.k/rows wire)))]\n665\t        (is (= :tail (:kind state)))\n666\t        (is (= 3 (count (:slots state))) \"segment, site, K: no env, window or pc\")\n667\t        (is (= 5 (count row)) \"[id :tail A site k]\")\n668\t        (is (not-any? #(= :window (second %))\n669\t                      (filter #(= (first %) (second (:slots state))) (:yin.k/rows wire))))\n670\t        (let [entry (first (:wait-set (:machine world)))]\n671\t          (is (= {:deliver :return} (:deliver entry)))\n672\t          (is (not-any? #(contains? entry %) [:window :env :pc])))))))\n673\t\n674\t\n675\t(deftest tail-states-lower-to-through-k-delivery\n676\t  (doseq [n [6 9 12]]\n677\t    (testing (str \"row \" n)\n678\t      (let [ref (reference (bare n))\n679\t            {:keys [recv] :as got} (laws (bare n) ref)"}]},"parent_tool_use_id":null,"session_id":"0da6a8ed-da80-4f95-b938-953b362e5554","uuid":"d35e4b42-01ae-4a7a-bada-f02e2d1a4d30","timestamp":"2026-10-12T18:26:43.013Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"  [wrap call-in call-out]\n  (vm/run (load-program (machine {:call-in call-in :call-out call-out\n                                  :call-out-cursor (vm/mint-oldest call-out :test)})\n                        (with-cat (wrap (s/call-node :op/echo \"hello\"))))))\n\n\n(defn sent-ffi\n  [wrap]\n  (let [trace (atom []) call-in (s/ring 8) call-out (s/ring 8)\n        m (caller wrap call-in call-out)\n        id (ffi/response-call-id (first (:wait-set m)))]\n    {:machine m :kind :blocked :reason :ffi :call-id id\n     :steps [#(stream/append! call-out (apply2/success-response id \"echo!\"))]\n     :finish #(swap! trace into (tu/drain call-in))\n     :receiver #(own-call-pair trace) :trace trace}))\n\n\n(defn retained-ffi\n  [wrap]\n  (let [trace (atom []) call-in (support/one-slot-stream \"call-in\") call-out (s/ring 8)\n        _ (stream/append! call-in :warmed)\n        m (caller wrap call-in call-out)\n        id (ffi/request-call-id (first (:wait-set m)))]\n    {:machine m :kind :blocked :reason :ffi-request :surfaces #{:reader :writer}\n     :steps [#(stream/next call-in 0)\n             (fn []\n               (swap! trace conj (:dao.stream/value (stream/next call-in 0)))\n               (stream/append! call-out (apply2/success-response id \"echo!\")))]\n     :receiver #(own-call-pair trace) :trace trace}))\n\n\n(defn module-response\n  [body exports]\n  {:status :ok :image {:value (project body)}\n   :manifest {:yin.module/name 'host.mod :yin.module/exports exports} :obligations []})\n\n\n(def plain-body (s/def! 'f (s/lam [] (s/lit 42))))\n\n\n(def blocking-body\n  \"host.mod's body reads a stream nothing feeds yet, then defines f. No\n   binding holds the stream, so f's E does not capture it.\"\n  (s/then (s/next-of (s/cursor-of {:type :stream/make :buffer 4})) (s/def! 'f (s/lam [] (s/lit 42)))))\n\n\n(defn require-op\n  [tail?]\n  (let [call (s/app (s/v 'require) (s/lit 'host.mod))]\n    (if tail? (s/app (s/lam ['u] (tail call)) (s/lit 0)) call)))\n\n\n(defn link-receiver\n  [trace]\n  (fn []\n    (let [rq (s/ring 64)]\n      {:opts {:link-request rq :link-response (s/ring 64)} :finish #(swap! trace into (tu/drain rq))})))\n\n\n(defn linking\n  \"A require parked in :link-response (or :link-request behind a full,\n   warmed request stream when retained?).\"\n  [wrap tail? retained?]\n  (let [trace (atom [])\n        request (if retained? (support/one-slot-stream \"link-request\") (s/ring 64))\n        response (s/ring 64)\n        _ (when retained? (stream/append! request :warmed))\n        m (vm/run (load-program (machine {:link-request request :link-response response})\n                                (with-cat (wrap (require-op tail?)))))\n        id (:link-id (first (:wait-set m)))\n        answer! #(stream/append! response (assoc (module-response plain-body #{'f}) :yin.link/id id))]\n    {:machine m :kind :blocked :reason (if retained? :link-request :link-response)\n     :surfaces #{:reader :writer} :trace trace\n     :steps (if retained? [#(stream/next request 0) answer!] [answer!])\n     :finish (if retained?\n               #(swap! trace conj (:dao.stream/value (stream/next request 0)))\n               #(swap! trace into (tu/drain request)))\n     :receiver (link-receiver trace)}))\n\n\n(defn installing\n  \"A require parked on :install beside its blocked child.\"\n  [wrap tail? phase]\n  (let [trace (atom [])\n        request (s/ring 64) response (s/ring 64)\n        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n                                 (with-cat (wrap (require-op tail?)))))\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! response (assoc (module-response blocking-body #{'f}) :yin.link/id id))\n        m1 (vm/run m0)\n        m (if phase (assoc-in m1 [:installs 'host.mod :phase] phase) m1)\n        child (get-in m [:installs 'host.mod :vm])\n        child-stream (s/stream-of child)]\n    {:machine m :kind :blocked :reason :install :trace trace\n     :steps [#(stream/append! child-stream :fed)]\n     :finish #(swap! trace into (tu/drain request))\n     :receiver (link-receiver trace)}))\n\n\n(defn module-context\n  \"Blocked inside host.mod's exported closure, whose E names store-of host.mod.\"\n  [wrap]\n  (let [request (s/ring 64) response (s/ring 64)\n        body (s/def! 'f (s/lam ['c] (s/app (s/v 'stream/next!) (s/v 'c))))\n        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n                                 (with-stream (with-cat (wrap (s/then (s/app (s/v 'require) (s/lit 'host.mod))\n                                                                      (s/app (s/v 'host.mod/f) (s/v 'c))))))))\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! response (assoc (module-response body #{'f}) :yin.link/id id))\n        m (vm/run m0)\n        src (s/stream-of m)]\n    ;; The carrier holds module stores, not registry entries: the receiver's\n    ;; composition links host.mod itself, so its relift discharges host.mod/f.\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])\n     :receiver (constantly {:opts {:modules (:modules m)}})}))\n\n\n(defn run-beside\n  [m ast]\n  (vm/run (load-program m ast)))\n\n\n(defn parking\n  [m]\n  (let [pid (:id (vm/value m))]\n    {:machine m :kind :parked :pid pid :trace (atom [])\n     :resume #(run-beside % {:type :vm/resume :parked-id pid :val (s/lit \"back\")})}))\n\n\n(defn module-store-cursors\n  \"An explicit park whose module store holds two cursor references nothing\n   else reaches, named by a module closure in the task store.\"\n  [wrap]\n  (let [ring (s/ring 4)\n        ast (with-cat (wrap (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))))\n        v (project ast)\n        m (vm/run (load-program (machine) ast))\n        cursor (fn [m]\n                 (let [[ref m] (engine/attach-resource m ring) [id m] (engine/gensym m \"cursor\")]\n                   (engine/handle-cursor m {:stream ref} id)))\n        [c1 m] (cursor m)\n        [c2 m] (cursor m)\n        closure (first (filter #(= :closure (first %)) v))\n        clo (lane-closure m {:type :closure :params (nth closure 2) :entry (nth closure 3)\n                             :segment (jing/segment-key v) :env {engine/store-of-key 'host.mod}})]\n    (parking (assoc m :store {'mod clo} :module-stores {'host.mod {'c c1 'd c2}}))))\n\n\n(defn free-env-world\n  [wrap env]\n  (reader wrap (s/let1 'f (s/lam [] (s/v 'x)) (s/app (s/lam ['x] (s/app (s/v 'f) (s/next-of (s/v 'c)))) (s/lit 1)))\n          [] \"B\" {:env env}))\n\n\n(def read-op (s/next-of (s/v 'c)))\n\n\n(def capture {:type :vm/current-continuation})\n\n\n(def rows\n  \"[row bare-result build]: rows 1-19, 21, 22, 24 of §5.2. A nil result\n   compares with the reference only.\"\n  [[1 [\"A\" \"B\"] #(reader % (s/let1 'a read-op (cat-of (cat-of (s/lit []) (s/v 'a)) read-op)) [\"A\"] \"B\" {})]\n   [2 nil writer]\n   [3 \"echo!\" sent-ffi]\n   [4 \"echo!\" retained-ffi]\n   [5 [:ordinary \"B\"] #(reader % (cat-of (s/lit [:ordinary]) (s/app (s/v 'stream/next!) (s/v 'c))))]\n   [6 \"B\" #(reader % (s/app (s/lam ['u] (tail (s/app (s/v 'stream/next!) (s/v 'c)))) (s/lit 0)))]\n   [7 'host.mod #(linking % false true)]\n   [8 'host.mod #(linking % false false)]\n   [9 'host.mod #(linking % true false)]\n   [10 'host.mod #(installing % false nil)]\n   [11 'host.mod #(installing % false :running)]\n   [12 'host.mod #(installing % true nil)]\n   [13 \"back\" #(parking (vm/run (load-program (machine) (with-cat (% {:type :vm/park})))))]\n   [14 [:continuation \"B\"] #(reader % (s/let1 'k capture (cat-of (cat-of (s/lit []) (s/v 'k)) read-op)))]\n   [15 :done #(reader % (s/let1 'k capture {:type :if :test (s/app (s/v '=) (s/v 'k) (s/lit :second))\n                                            :consequent (s/lit :done)\n                                            :alternate (s/let1 'r read-op (s/app (s/v 'k) (s/lit :second)))})\n                      [] \"x\" {})]\n   [16 [:continuation :continuation \"B\"]\n    #(reader % (s/let1 'k1 capture (s/let1 'k2 capture (cat-of (cat-of (cat-of (s/lit []) (s/v 'k1)) (s/v 'k2)) read-op))))]\n   [17 \"B\" module-context]\n   [18 \"back\" module-store-cursors]\n   [19 42 #(let [m (vm/run (load-program (machine) (with-cat (% (s/lit 42)))))]\n             {:machine m :kind :halted :trace (atom [])})]\n   [21 99 #(free-env-world % {'x 99})]\n   [22 [nil \"B\"] #(reader % (s/let1 'pair (s/lam ['p 'q] (cat-of (cat-of (s/lit []) (s/v 'p)) (s/v 'q)))\n                                    (s/app (s/v 'pair) (s/lit nil) read-op)))]\n   [24 \"echo!\" sent-ffi]])\n\n\n(defn tail-effect-halt\n  \"Row 20, outside the wrappers: a setup batch to halt, then the root tail\n   call (stream/next! c) with an empty K.\"\n  []\n  (let [setup (vm/run (load-program (machine) (s/then (s/def! 's {:type :stream/make :buffer 4})\n                                                      (s/def! 'c (s/cursor-of (s/v 's))))))\n        m (run-beside setup (tail (s/app (s/v 'stream/next!) (s/v 'c))))\n        src (s/stream-of m)]\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n\n\n;; =============================================================================\n;; The two runs\n;; =============================================================================\n\n(defn drive-local\n  [m]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n)) m (recur (vm/run m) (dec n)))))\n\n\n(defn drive-peers\n  [m peers]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n))\n      m\n      (do (run! s/serve-mirror! peers) (recur (vm/run m) (dec n))))))\n\n\n(defn satisfy\n  [world m drive]\n  (if-let [resume (:resume world)]\n    (resume m)\n    (reduce (fn [m step] (step) (drive m)) m (:steps world))))\n\n\n(defn reference\n  [world]\n  (let [done (satisfy world (:machine world) drive-local)]\n    (when-let [f (:finish world)] (f))\n    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn served\n  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n  [surfaces]\n  (let [t (s/toy) peer (s/served-peer t)]\n    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n\n\n(defn recording-attacher\n  \"The receiver's attach!, counting attaches and recording each\n   reflection's source identity.\"\n  [t]\n  (let [base (s/attacher t) origin (atom {}) n (atom 0)]\n    {:attach! (fn [d]\n                (swap! n inc)\n                (let [r (base d)]\n                  (when-let [h (:dao.stream/handle r)] (swap! origin assoc h (:dao.stream/identity d)))\n                  r))\n     :origin origin :count n}))\n\n\n(defn handed-off\n  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n   the source's streams.\"\n  [world]\n  (let [surfaces (or (:surfaces world) #{:reader})\n        {:keys [toy peer serve!]} (served surfaces)\n        wire (rows/lift-task (:machine world) serve! (lift-opts))\n        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n        receiver ((or (:receiver world) (constantly nil)))\n        {:keys [attach! origin] n :count} (recording-attacher toy)\n        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n        attaches @n\n        again (served surfaces)\n        relift (rows/lift-task recv (:serve! again) (lift-opts))\n        corr2 (into {} (map (fn [[id e]] [id (get @origin (:handle e))])) @(:table (:peer again)))\n        done (satisfy world recv #(drive-peers % [peer]))\n        _ (s/serve-mirror! peer)]\n    (when-let [f (:finish world)] (f))\n    (when-let [f (:finish receiver)] (f))\n    {:wire wire :recv recv :relift relift :corr corr :corr2 corr2 :attaches attaches\n     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn root-task\n  [wire]\n  (rows/decode wire))\n\n\n(defn stream-identities\n  \"The distinct stream identities of the whole carrier, install children\n   included: one row table serves the tree.\"\n  [wire]\n  (into #{} (keep (fn [r] (when (= :stream (second r)) (nth r 2)))) (:yin.k/rows wire)))\n\n\n(defn rows-in\n  \"Every row node the decoded tree x reaches, once per path.\"\n  [x]\n  (cond\n    (and (map? x) (contains? x :kind) (contains? x :slots)) (cons x (rows-in (:slots x)))\n    (sequential? x) (mapcat rows-in x)\n    :else nil))\n\n\n(defn stream-occurrences\n  \"How many times the decoded tree reaches a :stream row.\"\n  [x]\n  (count (filter #(= :stream (:kind %)) (rows-in x))))\n\n\n(defn slot\n  [task i]\n  (nth (:slots task) i))\n\n\n(defn first-pending\n  [task]\n  (second (:slots (first (slot task 13)))))\n\n\n(defn laws\n  \"Laws 1, 2, 3 and 6 for one world; answers the run.\"\n  [world expected]\n  (let [{:keys [wire relift corr corr2 attaches] :as got} (handed-off world)\n        task (root-task wire)]\n    (is (= (:kind world) (slot task 2)))\n    (is (= (count (stream-identities wire)) attaches) \"one attach per distinct stream identity\")\n    (when (= :blocked (:kind world))\n      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n        \"law 2: lift(lower(S)) = S by root id\")\n    (is (:halted expected) \"the reference run completes\")\n    (is (= (select-keys expected [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n        \"law 1: result and effect trace equal the reference\")\n    got))\n\n\n(defn matrix-cases\n  \"22 wrapped rows x 4 segments, plus row 20 once: [row segment expected build].\"\n  []\n  (conj (into [] (mapcat (fn [[n r build]]\n                           (mapv (fn [[label wrap expected-of]]\n                                   ;; nest's own parameter is x: under :depth-3,\n                                   ;; row 21's (fn [] x) closes over the wrapper's\n                                   ;; x = 1, not the free x = 99 (§5.2 assumes 99)\n                                   (let [r (if (and (= 21 n) (= :depth-3 label)) 1 r)]\n                                     [n label (when (some? r) (expected-of r)) #(build wrap)]))\n                                 segments)))\n              rows)\n        [20 :unwrapped \"B\" tail-effect-halt]))\n\n\n(defn bare\n  [n]\n  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n    (build identity)))\n\n\n;; =============================================================================\n;; Acceptance 1: 89 runs\n;; =============================================================================\n\n(deftest ^:slow every-row-every-segment-matches-the-reference\n  (slow/guard\n    \"every-row-every-segment-matches-the-reference\"\n    (fn []\n      (let [cases (matrix-cases) runs (atom 0)]\n        (is (= 89 (count cases)) \"22 wrapped rows x 4 segments + row 20\")\n        (doseq [[n label expected build] cases]\n          (testing (str \"row \" n \" \" (name label))\n            (let [ref (reference (build))]\n              (when (some? expected)\n                (is (= expected (:value ref)) \"the reference answers §5.2's result\"))\n              (laws (build) ref)\n              (swap! runs inc))))\n        (is (= 89 @runs))))))\n\n\n(deftest bare-rows-match-the-reference\n  ;; The quick-tier slice of acceptance 1: every row once, bare.\n  (let [counted (atom [0 0])]\n    (doseq [[n r build] rows]\n      (testing (str \"row \" n)\n        (let [ref (reference (build identity))\n              {:keys [wire attaches]} (laws (build identity) ref)]\n          (when (some? r) (is (= r (:value ref))))\n          (swap! counted (fn [[a i]] [(+ a attaches) (+ i (count (stream-identities wire)))])))))\n    ;; outside laws, so deleting its count assertion leaves one standing\n    (is (pos? (first @counted)) \"the corpus attaches streams\")\n    (is (apply = @counted) \"attaches = distinct stream identities over the corpus\")))\n\n\n;; =============================================================================\n;; Acceptance 2-6\n;; =============================================================================\n\n(defn wait-state\n  [wire]\n  (first (:slots (first (slot (root-task wire) 13)))))\n\n\n(deftest tail-states-carry-no-window\n  (doseq [[label world] [[6 (bare 6)] [9 (bare 9)] [12 (bare 12)] [20 (tail-effect-halt)]]]\n    (testing (str \"row \" label)\n      (let [{:keys [serve!]} (served #{:reader :writer})\n            wire (rows/lift-task (:machine world) serve! (lift-opts))\n            state (wait-state wire)\n            row (first (filter #(= :tail (second %)) (:yin.k/rows wire)))]\n        (is (= :tail (:kind state)))\n        (is (= 3 (count (:slots state))) \"segment, site, K: no env, window or pc\")\n        (is (= 5 (count row)) \"[id :tail A site k]\")\n        (is (not-any? #(= :window (second %))\n                      (filter #(= (first %) (second (:slots state))) (:yin.k/rows wire))))\n        (let [entry (first (:wait-set (:machine world)))]\n          (is (= {:deliver :return} (:deliver entry)))\n          (is (not-any? #(contains? entry %) [:window :env :pc])))))))\n\n\n(deftest tail-states-lower-to-through-k-delivery\n  (doseq [n [6 9 12]]\n    (testing (str \"row \" n)\n      (let [ref (reference (bare n))\n            {:keys [recv] :as got} (laws (bare n) ref)","numLines":420,"startLine":260,"totalLines":1672}},"tool_result_meta":[{"id":"toolu_01Sp1R18PHyqzbEGw6THimVb","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
