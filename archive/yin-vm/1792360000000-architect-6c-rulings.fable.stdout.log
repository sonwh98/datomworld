{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E3WKVYCep1yoLveGR2U3rM","type":"tool_result","content":"1280\t  (let [{:keys [serve! toy peer]} (served #{:reader})\n1281\t        wire (rows/lift-task m serve! (lift-opts))\n1282\t        [recv attaches] (lowered toy wire)]\n1283\t    (stream/append! (s/stream-of m) 73)\n1284\t    {:source (vm/value (vm/run m)) :receiver (vm/value (drive-peers recv [peer])) :attaches attaches}))\n1285\t\n1286\t\n1287\t(deftest discharge-follows-control-flow-from-the-resume-pc\n1288\t  (let [past (fn [consequent]\n1289\t               (halted-on {:type :if :test (s/lit false) :consequent consequent :alternate fresh-read}))]\n1290\t    (testing \"a free read behind the resume pc is no obligation\"\n1291\t      (doseq [m [(past (s/v 'ghost))\n1292\t                 (assoc (past (s/v 'ghost)) :module-stores {'unrelated {'ghost 42}})\n1293\t                 (past ghost-fn)]]\n1294\t        (is (= {:source 73 :receiver 73 :attaches 1} (fed-73 m))))))\n1295\t  (testing \"a free read after the resume pc is an obligation\"\n1296\t    (is (= #{'ghost} (missing-obligations (halted-on (s/app (s/lam ['p 'q] (s/lit 1)) fresh-read (s/v 'ghost)))))))\n1297\t  (testing \"a closure reachable code can still construct is an obligation\"\n1298\t    (is (= #{'ghost} (missing-obligations (halted-on (s/app (s/lam ['p 'q] (s/lit 1)) fresh-read ghost-fn))))))\n1299\t  (testing \"a backward jump makes earlier code live\"\n1300\t    ;; §3.1 admits no backward jump, so no carried vector has one; live-pcs\n1301\t    ;; follows the stated edges, never pc order\n1302\t    (let [v [[:const 1 false] [:branch-false 1 4] [:var 0 'ghost] [:jump 6] [:const 0 1] [:jump 2] [:halt 0]]]\n1303\t      (is (contains? (rows/live-pcs v 4) 2))\n1304\t      (is (not (contains? (rows/live-pcs v 3) 2))))))\n1305\t\n1306\t\n1307\t;; =============================================================================\n1308\t;; Every store-of names a module store of its own task (§2.6)\n1309\t;; =============================================================================\n1310\t\n1311\t(defn routed-beside-stream\n1312\t  \"ast's closure routed to module store scoped, with an authentic stream\n1313\t   in the root store so that an attachment is observable.\"\n1314\t  [ast stores]\n1315\t  (let [m0 (halted-on ast)\n1316\t        [ref m] (engine/attach-resource m0 (s/ring 4))]\n1317\t    (assoc m :value (routed m (vm/value m) 'scoped) :module-stores stores :store {'stream ref})))\n1318\t\n1319\t\n1320\t(defn without-module-stores\n1321\t  [path]\n1322\t  (fn [task] (update-at task path (constantly []))))\n1323\t\n1324\t\n1325\t(defn module-store-ids\n1326\t  [task]\n1327\t  (mapv #(first (:slots %)) (slot task 7)))\n1328\t\n1329\t\n1330\t(deftest every-store-of-names-a-module-store-of-its-own-task\n1331\t  (doseq [[label ast stores value] [[\"a scoped store\" ghost-fn {'scoped {'ghost 42}} 42]\n1332\t                                    [\"a present empty store\" (s/lam [] (s/lit 7)) {'scoped {}} 7]]]\n1333\t    (testing label\n1334\t      (let [{:keys [serve! toy]} (served #{:reader})\n1335\t            wire (rows/lift-task (routed-beside-stream ast stores) serve! (lift-opts))\n1336\t            [recv attaches] (lowered toy wire)\n1337\t            [r none] (lowered toy (rows/emit ((without-module-stores [7]) (root-task wire))))]\n1338\t        (is (= ['scoped] (module-store-ids (root-task wire))))\n1339\t        (is (= 1 attaches))\n1340\t        (is (= value (vm/value (run-beside (assoc recv :store {'f (vm/value recv)}) (s/app (s/v 'f))))))\n1341\t        (testing \", its rows removed\"\n1342\t          (is (zero? none) \"refused before any attachment\")\n1343\t          (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])]))))))\n1344\t  (testing \"a closure inside a module store's value naming another module store\"\n1345\t    ;; k lives only in outer's value and is routed to inner; stripping inner\n1346\t    ;; alone must refuse, else k attaches and fails reading ghost\n1347\t    (let [m0 (halted-on ghost-fn)\n1348\t          g (vm/value m0)\n1349\t          [ref m] (engine/attach-resource m0 (s/ring 4))\n1350\t          m (assoc m :value (routed m g 'outer) :store {'stream ref}\n1351\t                   :module-stores {'outer {'ghost 1 'k (routed m g 'inner)} 'inner {'ghost 42}})\n1352\t          {:keys [serve! toy]} (served #{:reader})\n1353\t          wire (rows/lift-task m serve! (lift-opts))\n1354\t          strip (fn [task] (update-at task [7] (fn [ns] (vec (remove #(= 'inner (first (:slots %))) ns)))))\n1355\t          [recv attaches] (lowered toy wire)\n1356\t          [r none] (lowered toy (rows/emit (strip (root-task wire))))]\n1357\t      (is (= #{'outer 'inner} (set (module-store-ids (root-task wire)))))\n1358\t      (is (= 1 attaches))\n1359\t      (is (= 42 (vm/value (run-beside (assoc recv :store {'f (get-in recv [:module-stores 'outer 'k])}) (s/app (s/v 'f))))))\n1360\t      (is (zero? none) \"refused before any attachment\")\n1361\t      (is (= [:yin.k/unsatisfied #{'inner}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])]))))\n1362\t  (testing \"a frame's E naming a store its task does not carry\"\n1363\t    (let [[status _ r] (refused-before-attach 17 (without-module-stores [7]))]\n1364\t      (is (= :yin.k/unsatisfied status))\n1365\t      (is (= 1 (count (get-in r [:yin.k/missing :yin.k/stores]))))))\n1366\t  (testing \"a child does not read its parent's store of the same key\"\n1367\t    (let [scope (fn [x]\n1368\t                  (-> x\n1369\t                      (update-in [:wait-set 0 :env] assoc engine/store-of-key 'scoped)\n1370\t                      (assoc :module-stores {'scoped {}})))\n1371\t          m (:machine (bare 10))\n1372\t          m (-> (scope m) (update-in [:installs 'host.mod :vm] scope))\n1373\t          {:keys [serve! toy]} (served #{:reader :writer})\n1374\t          wire (rows/lift-task m serve! (lift-opts))\n1375\t          child-path (conj install-path 4)\n1376\t          [ok n] (lowered toy wire)\n1377\t          [r none] (lowered toy (rows/emit ((without-module-stores (conj child-path 7)) (root-task wire))))]\n1378\t      (is (= ['scoped] (module-store-ids (root-task wire))) \"the parent carries scoped\")\n1379\t      (is (= ['scoped] (module-store-ids (slot (first (slot (root-task wire) 12)) 4))) \"and so does the child\")\n1380\t      (is (vm/blocked? ok) (pr-str (when (map? ok) (select-keys ok [:yin.k/status :yin.k/kind]))))\n1381\t      (is (= (count (stream-identities wire)) n))\n1382\t      (is (zero? none) \"refused before any attachment\")\n1383\t      (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])])))))\n1384\t\n1385\t\n1386\t;; =============================================================================\n1387\t;; Phase 6c: the cross-engine lanes (§5.3, §5.4 laws 4 and 5, §8.3 10-12)\n1388\t;; =============================================================================\n1389\t\n1390\t(def link-rows\n1391\t  \"Rows the de Bruijn lanes do not carry: a require installs a child and\n1392\t   attaches a module image in the kernel's own format, and the layouts\n1393\t   of §4 reconstruct no install child (canonical-task refuses\n1394\t   :installs).\"\n1395\t  #{7 8 9 10 11 12 17})\n1396\t\n1397\t\n1398\t(def lane-rows\n1399\t  \"The wrapped rows every lane executes: 15 of §5.2's 22.\"\n1400\t  (filterv #(not (contains? link-rows (first %))) rows))\n1401\t\n1402\t\n1403\t(defn lane-cases\n1404\t  \"15 lane rows x 4 segments, plus row 20 once: [row segment expected build].\"\n1405\t  []\n1406\t  (filterv #(not (contains? link-rows (first %))) (matrix-cases)))\n1407\t\n1408\t\n1409\t(defn on-lane\n1410\t  [lane build]\n1411\t  (binding [*lane* lane] (build)))\n1412\t\n1413\t\n1414\t(defn lane-lift\n1415\t  \"The lift of §7.1 on m's own lane.\"\n1416\t  [m serve!]\n1417\t  (if (= :semantic-register (lane-of m))\n1418\t    (rows/lift-task m serve! (lift-opts))\n1419\t    (layout/lift-task m (kernel-space m) (on-lane :semantic-register machine) serve! (lift-opts))))\n1420\t\n1421\t\n1422\t(defn lane-lower\n1423\t  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n1424\t  [lane opts wire attach!]\n1425\t  (let [scratch (on-lane :semantic-register #(machine opts))]\n1426\t    (if (= :semantic-register lane)\n1427\t      (rows/lower-task scratch wire attach!)\n1428\t      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n1429\t\n1430\t\n1431\t(defn logical-names\n1432\t  \"§5.5's explicit correspondence: each served identity to the resource\n1433\t   key the lifted machine holds that handle under. The fixture builds the\n1434\t   same program on every lane, so one key names one logical stream.\"\n1435\t  [m peer]\n1436\t  (into {} (map (fn [[id e]]\n1437\t                  [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n1438\t                          (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n1439\t        @(:table peer)))\n1440\t\n1441\t\n1442\t(defn ring-names\n1443\t  \"{stream identity -> resource key} over every stream m holds.\"\n1444\t  [m]\n1445\t  (into {} (keep (fn [[k h]]\n1446\t                   (when (satisfies? stream/IDaoStreamDescriptor h)\n1447\t                     [(:dao.stream/identity (stream/descriptor h)) k])))\n1448\t        (:resources m)))\n1449\t\n1450\t\n1451\t(defn logical-positions\n1452\t  \"The task with each cursor position's embedded stream identity renamed\n1453\t   to its logical name. A ring buffer cursor carries its stream's\n1454\t   identity, which §5.5's marker substitution does not reach (reported\n1455\t   as a design defect), so the cross-lane comparison renames it under\n1456\t   the same fixture correspondence.\"\n1457\t  [task m]\n1458\t  (let [names (ring-names m)\n1459\t        k :dao.stream.ringbuffer/identity]\n1460\t    (replace-nodes task #(= :cursor-cell-body (:kind %))\n1461\t                   (fn [n]\n1462\t                     (update-in n [:slots 1]\n1463\t                                (fn [p]\n1464\t                                  (if (and (map? p) (contains? names (get p k)))\n1465\t                                    (assoc p k (get names (get p k)))\n1466\t                                    p)))))))\n1467\t\n1468\t\n1469\t(defn logical-root\n1470\t  \"§5.5: the lift's root id with every lane identity replaced by the\n1471\t   fixture's logical name.\"\n1472\t  [wire m peer]\n1473\t  (:yin.k/root (rows/canonical-under (rows/emit (logical-positions (rows/decode wire) m))\n1474\t                                     (logical-names m peer))))\n1475\t\n1476\t\n1477\t(defn lane-root\n1478\t  \"Build on lane, lift: [root under the logical names, the lane's own\n1479\t   reference run].\"\n1480\t  [lane build]\n1481\t  (let [world (on-lane lane build)\n1482\t        {:keys [serve! peer]} (served (or (:surfaces world) #{:reader}))\n1483\t        wire (lane-lift (:machine world) serve!)]\n1484\t    (is (nil? (rows/validate-frames (rows/decode wire))) \"law 6 on every lane\")\n1485\t    [(logical-root wire (:machine world) peer)\n1486\t     (reference (on-lane lane build))]))\n1487\t\n1488\t\n1489\t(defn canonical-equality\n1490\t  \"Law 4 for one case: the three lanes lift to one root, and each lane's\n1491\t   own run answers the reference.\"\n1492\t  [build expected]\n1493\t  (let [roots (mapv #(lane-root % build) lanes)]\n1494\t    (is (apply = (map first roots)) \"law 4: one root id on every lane\")\n1495\t    (doseq [[lane [_ ref]] (map vector lanes roots)]\n1496\t      (is (:halted ref) (str lane \" completes\"))\n1497\t      (when (some? expected) (is (= expected (:value ref)) (str lane \" answers the reference\"))))\n1498\t    roots))\n1499\t\n1500\t\n1501\t(deftest cross-engine-canonical-equality-bare\n1502\t  ;; the quick-tier slice of acceptance 10: every lane row once, bare\n1503\t  (let [n (atom 0)]\n1504\t    (doseq [[row r build] lane-rows]\n1505\t      (testing (str \"row \" row)\n1506\t        (canonical-equality #(build identity) r)\n1507\t        (swap! n inc)))\n1508\t    (testing \"row 20\"\n1509\t      (canonical-equality tail-effect-halt \"B\")\n1510\t      (swap! n inc))\n1511\t    (is (= 16 @n))))\n1512\t\n1513\t\n1514\t(deftest ^:slow cross-engine-canonical-equality\n1515\t  (slow/guard\n1516\t    \"cross-engine-canonical-equality\"\n1517\t    (fn []\n1518\t      (let [cases (lane-cases) n (atom 0)]\n1519\t        (is (= 61 (count cases)) \"15 lane rows x 4 segments + row 20\")\n1520\t        (doseq [[row label expected build] cases]\n1521\t          (testing (str \"row \" row \" \" (name label))\n1522\t            (canonical-equality build expected)\n1523\t            (swap! n inc)))\n1524\t        (is (= 61 @n))))))\n1525\t\n1526\t\n1527\t(def ordered-pairs\n1528\t  \"Law 5's six ordered pairs of distinct lanes.\"\n1529\t  (into [] (mapcat (fn [from] (keep (fn [to] (when (not= from to) [from to])) lanes))) lanes))\n1530\t\n1531\t\n1532\t(def unlowerable\n1533\t  \"[row receiver] pairs a de Bruijn receiver cannot continue: row 4's\n1534\t   retained FFI re-parks through the kernel's own call-out pair\n1535\t   (ffi/response-wait-entry), not the carried response cursor cell the\n1536\t   semantic-register kernel restores. A kernel seam, reported.\"\n1537\t  #{[4 :stack] [4 :register]})\n1538\t\n1539\t\n1540\t(defn crossed\n1541\t  \"Lift on from, lower into a fresh receiver on to, satisfy through the\n1542\t   source's streams: the run's observables and attaches.\"\n1543\t  [from to build]\n1544\t  (let [world (on-lane from build)\n1545\t        {:keys [toy peer serve!]} (served (or (:surfaces world) #{:reader}))\n1546\t        wire (lane-lift (:machine world) serve!)\n1547\t        receiver ((or (:receiver world) (constantly nil)))\n1548\t        {:keys [attach!] n :count} (recording-attacher toy)\n1549\t        recv (lane-lower to (merge {:attach-stream attach!} (:opts receiver)) wire attach!)\n1550\t        _ (is (= to (lane-of recv)))\n1551\t        attaches @n\n1552\t        done (satisfy world recv #(drive-peers % [peer]))\n1553\t        _ (s/serve-mirror! peer)]\n1554\t    (when-let [f (:finish world)] (f))\n1555\t    (when-let [f (:finish receiver)] (f))\n1556\t    {:attaches attaches :wire wire\n1557\t     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n1558\t\n1559\t\n1560\t(defn cross-lowering\n1561\t  \"Law 5 for one case: every admitted ordered pair continues to the\n1562\t   reference. Answers the pairs that ran.\"\n1563\t  [row build]\n1564\t  (let [ref (reference (on-lane :semantic-register build))]\n1565\t    (is (:halted ref))\n1566\t    (reduce (fn [ran [from to]]\n1567\t              (if (contains? unlowerable [row to])\n1568\t                ran\n1569\t                (testing (str (name from) \" -> \" (name to))\n1570\t                  (let [got (crossed from to build)]\n1571\t                    (is (= (count (stream-identities (:wire got))) (:attaches got)))\n1572\t                    (is (= (select-keys ref [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n1573\t                        \"law 5: the lowered run continues to the reference\")\n1574\t                    (conj ran [from to])))))\n1575\t            []\n1576\t            ordered-pairs)))\n1577\t\n1578\t\n1579\t(deftest cross-engine-lowering-bare\n1580\t  ;; the quick-tier slice of acceptance 11: every lane row once, bare\n1581\t  (is (= 6 (count ordered-pairs)))\n1582\t  (let [ran (atom 0)]\n1583\t    (doseq [[row _ build] lane-rows]\n1584\t      (testing (str \"row \" row)\n1585\t        (let [pairs (cross-lowering row #(build identity))]\n1586\t          (is (= (if (= 4 row) 2 6) (count pairs)) \"every admitted ordered pair ran\")\n1587\t          (swap! ran + (count pairs)))))\n1588\t    (testing \"row 20\"\n1589\t      (is (= 6 (count (cross-lowering 20 tail-effect-halt))))\n1590\t      (swap! ran + 6))\n1591\t    (is (= 92 @ran) \"16 cases x 6 pairs, less row 4's 4 into a de Bruijn receiver\")))\n1592\t\n1593\t\n1594\t(deftest ^:slow cross-engine-lowering\n1595\t  (slow/guard\n1596\t    \"cross-engine-lowering\"\n1597\t    (fn []\n1598\t      (let [ran (atom 0) cases (lane-cases)]\n1599\t        (is (= 61 (count cases)))\n1600\t        (doseq [[row label _ build] cases]\n1601\t          (testing (str \"row \" row \" \" (name label))\n1602\t            (swap! ran + (count (cross-lowering row build)))))\n1603\t        (is (= 350 @ran) \"61 cases x 6 pairs, less row 4's 4 per segment\")))))\n1604\t\n1605\t\n1606\t(defn register-judge\n1607\t  \"The frame validator's verdict on register entry `entry` of m,\n1608\t   reconstructed through the layout.\"\n1609\t  [m entry]\n1610\t  (let [sp (kernel-space m)\n1611\t        p (layout/lift-state (layout/lift-context m sp (:owner m)) entry)\n1612\t        code-map (into {} (map (fn [[a sg]] [a (:vector sg)])) (:segments sp))\n1613\t        as-sr {:code (into {} (map (fn [a] [a {:address a}])) (keys code-map))}]\n1614\t    (:yin.k/kind (frame/defect (ft/canonical as-sr p true) code-map :wait {:free-env {} :ffi-call-ids #{}}))))\n1615\t\n1616\t\n1617\t(defn spare-register\n1618\t  \"A physical register of the entry's body outside its live set and its\n1619\t   destination that R gives exactly one virtual.\"\n1620\t  [m entry]\n1621\t  (let [sg (val (first (:segments (kernel-space m))))\n1622\t        site (- (:site-pc entry) (layout/offset :register m sg))\n1623\t        body (nth (:phys sg) (code/body-index (:bodies sg) site))\n1624\t        unique (keep (fn [[s xs]] (when (= 1 (count xs)) s)) (group-by body (keys body)))]\n1625\t    (first (remove (conj (set (:live entry)) (:dest entry)) (sort unique)))))\n1626\t\n1627\t\n1628\t(deftest layout-refusals\n1629\t  (testing \"a kernel stepped to a non-safepoint pc\"\n1630\t    (doseq [lane [:stack :register]]\n1631\t      (testing (name lane)\n1632\t        (let [m (on-lane lane #(vm/step (load-program (machine) (s/app (s/lam ['p] (s/lit 42)) (s/lit 1)))))\n1633\t              n (atom 0)\n1634\t              {:keys [serve!]} (served #{:reader})\n1635\t              d (error #(lane-lift m (fn [h] (swap! n inc) (serve! h))))]\n1636\t          (is (not (vm/halted? m)))\n1637\t          (is (= :yin.k/not-at-safepoint (:yin.k/status d)) (pr-str d))\n1638\t          (is (zero? @n) \"no stream was served\")\n1639\t          (testing \", its registers read as a payload\"\n1640\t            (let [entry (if (= :stack lane)\n1641\t                          (select-keys m [:pc :frames :stack :continuation])\n1642\t                          (assoc (select-keys m [:pc :frames :continuation]) :regs [] :resume-mode :write-result))\n1643\t                  cx (layout/lift-context m (kernel-space m) (:owner m))]\n1644\t              (is (= :yin.k/not-at-safepoint (:yin.k/status (error #(layout/lift-state cx entry)))))))))))\n1645\t  (testing \"a register entry whose live was tampered\"\n1646\t    (let [m (:machine (on-lane :register #(bare 1)))\n1647\t          entry (first (:wait-set m))\n1648\t          live (:live entry)\n1649\t          spare (spare-register m entry)]\n1650\t      (is (nil? (register-judge m entry)) \"the untampered entry reconstructs a valid frame\")\n1651\t      (is (seq live))\n1652\t      (is (= :window-missing (register-judge m (assoc entry :live (vec (rest live)) :regs (vec (rest (:regs entry))))))\n1653\t          \"a live register dropped\")\n1654\t      (is (some? spare))\n1655\t      (is (= :window-extra (register-judge m (assoc entry :live (vec (sort (conj live spare)))\n1656\t                                                    :regs (vec (sort-by first (conj (:regs entry) [spare :x]))))))\n1657\t          \"a dead register added\")))\n1658\t  (testing \"a primitive in a window: the register kernel cannot hold it, refused before any attach\"\n1659\t    (let [build #(reader % (s/app (s/v 'conj) (s/lit []) read-op))\n1660\t          world (build identity)\n1661\t          {:keys [serve! toy]} (served #{:reader})\n1662\t          wire (rows/lift-task (:machine world) serve! (lift-opts))\n1663\t          {:keys [attach!] n :count} (recording-attacher toy)\n1664\t          d (error #(lane-lower :register {:attach-stream attach!} wire attach!))]\n1665\t      (is (= [:yin.k/unsupported :continuation-registers] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n1666\t      (is (zero? @n) \"refused before any attachment\")\n1667\t      (testing \", the stack kernel holds it\"\n1668\t        (let [ref (reference (build identity))\n1669\t              got (crossed :semantic-register :stack #(build identity))]\n1670\t          (is (= [\"B\"] (:value ref)))\n1671\t          (is (= (:value ref) (:value got))))))))\n1672\t"}]},"parent_tool_use_id":null,"session_id":"0da6a8ed-da80-4f95-b938-953b362e5554","uuid":"4b47b548-ddab-4a2b-b3ab-4ce422eecb68","timestamp":"2026-10-12T18:26:30.376Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"  (let [{:keys [serve! toy peer]} (served #{:reader})\n        wire (rows/lift-task m serve! (lift-opts))\n        [recv attaches] (lowered toy wire)]\n    (stream/append! (s/stream-of m) 73)\n    {:source (vm/value (vm/run m)) :receiver (vm/value (drive-peers recv [peer])) :attaches attaches}))\n\n\n(deftest discharge-follows-control-flow-from-the-resume-pc\n  (let [past (fn [consequent]\n               (halted-on {:type :if :test (s/lit false) :consequent consequent :alternate fresh-read}))]\n    (testing \"a free read behind the resume pc is no obligation\"\n      (doseq [m [(past (s/v 'ghost))\n                 (assoc (past (s/v 'ghost)) :module-stores {'unrelated {'ghost 42}})\n                 (past ghost-fn)]]\n        (is (= {:source 73 :receiver 73 :attaches 1} (fed-73 m))))))\n  (testing \"a free read after the resume pc is an obligation\"\n    (is (= #{'ghost} (missing-obligations (halted-on (s/app (s/lam ['p 'q] (s/lit 1)) fresh-read (s/v 'ghost)))))))\n  (testing \"a closure reachable code can still construct is an obligation\"\n    (is (= #{'ghost} (missing-obligations (halted-on (s/app (s/lam ['p 'q] (s/lit 1)) fresh-read ghost-fn))))))\n  (testing \"a backward jump makes earlier code live\"\n    ;; §3.1 admits no backward jump, so no carried vector has one; live-pcs\n    ;; follows the stated edges, never pc order\n    (let [v [[:const 1 false] [:branch-false 1 4] [:var 0 'ghost] [:jump 6] [:const 0 1] [:jump 2] [:halt 0]]]\n      (is (contains? (rows/live-pcs v 4) 2))\n      (is (not (contains? (rows/live-pcs v 3) 2))))))\n\n\n;; =============================================================================\n;; Every store-of names a module store of its own task (§2.6)\n;; =============================================================================\n\n(defn routed-beside-stream\n  \"ast's closure routed to module store scoped, with an authentic stream\n   in the root store so that an attachment is observable.\"\n  [ast stores]\n  (let [m0 (halted-on ast)\n        [ref m] (engine/attach-resource m0 (s/ring 4))]\n    (assoc m :value (routed m (vm/value m) 'scoped) :module-stores stores :store {'stream ref})))\n\n\n(defn without-module-stores\n  [path]\n  (fn [task] (update-at task path (constantly []))))\n\n\n(defn module-store-ids\n  [task]\n  (mapv #(first (:slots %)) (slot task 7)))\n\n\n(deftest every-store-of-names-a-module-store-of-its-own-task\n  (doseq [[label ast stores value] [[\"a scoped store\" ghost-fn {'scoped {'ghost 42}} 42]\n                                    [\"a present empty store\" (s/lam [] (s/lit 7)) {'scoped {}} 7]]]\n    (testing label\n      (let [{:keys [serve! toy]} (served #{:reader})\n            wire (rows/lift-task (routed-beside-stream ast stores) serve! (lift-opts))\n            [recv attaches] (lowered toy wire)\n            [r none] (lowered toy (rows/emit ((without-module-stores [7]) (root-task wire))))]\n        (is (= ['scoped] (module-store-ids (root-task wire))))\n        (is (= 1 attaches))\n        (is (= value (vm/value (run-beside (assoc recv :store {'f (vm/value recv)}) (s/app (s/v 'f))))))\n        (testing \", its rows removed\"\n          (is (zero? none) \"refused before any attachment\")\n          (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])]))))))\n  (testing \"a closure inside a module store's value naming another module store\"\n    ;; k lives only in outer's value and is routed to inner; stripping inner\n    ;; alone must refuse, else k attaches and fails reading ghost\n    (let [m0 (halted-on ghost-fn)\n          g (vm/value m0)\n          [ref m] (engine/attach-resource m0 (s/ring 4))\n          m (assoc m :value (routed m g 'outer) :store {'stream ref}\n                   :module-stores {'outer {'ghost 1 'k (routed m g 'inner)} 'inner {'ghost 42}})\n          {:keys [serve! toy]} (served #{:reader})\n          wire (rows/lift-task m serve! (lift-opts))\n          strip (fn [task] (update-at task [7] (fn [ns] (vec (remove #(= 'inner (first (:slots %))) ns)))))\n          [recv attaches] (lowered toy wire)\n          [r none] (lowered toy (rows/emit (strip (root-task wire))))]\n      (is (= #{'outer 'inner} (set (module-store-ids (root-task wire)))))\n      (is (= 1 attaches))\n      (is (= 42 (vm/value (run-beside (assoc recv :store {'f (get-in recv [:module-stores 'outer 'k])}) (s/app (s/v 'f))))))\n      (is (zero? none) \"refused before any attachment\")\n      (is (= [:yin.k/unsatisfied #{'inner}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])]))))\n  (testing \"a frame's E naming a store its task does not carry\"\n    (let [[status _ r] (refused-before-attach 17 (without-module-stores [7]))]\n      (is (= :yin.k/unsatisfied status))\n      (is (= 1 (count (get-in r [:yin.k/missing :yin.k/stores]))))))\n  (testing \"a child does not read its parent's store of the same key\"\n    (let [scope (fn [x]\n                  (-> x\n                      (update-in [:wait-set 0 :env] assoc engine/store-of-key 'scoped)\n                      (assoc :module-stores {'scoped {}})))\n          m (:machine (bare 10))\n          m (-> (scope m) (update-in [:installs 'host.mod :vm] scope))\n          {:keys [serve! toy]} (served #{:reader :writer})\n          wire (rows/lift-task m serve! (lift-opts))\n          child-path (conj install-path 4)\n          [ok n] (lowered toy wire)\n          [r none] (lowered toy (rows/emit ((without-module-stores (conj child-path 7)) (root-task wire))))]\n      (is (= ['scoped] (module-store-ids (root-task wire))) \"the parent carries scoped\")\n      (is (= ['scoped] (module-store-ids (slot (first (slot (root-task wire) 12)) 4))) \"and so does the child\")\n      (is (vm/blocked? ok) (pr-str (when (map? ok) (select-keys ok [:yin.k/status :yin.k/kind]))))\n      (is (= (count (stream-identities wire)) n))\n      (is (zero? none) \"refused before any attachment\")\n      (is (= [:yin.k/unsatisfied #{'scoped}] [(:yin.k/status r) (get-in r [:yin.k/missing :yin.k/stores])])))))\n\n\n;; =============================================================================\n;; Phase 6c: the cross-engine lanes (§5.3, §5.4 laws 4 and 5, §8.3 10-12)\n;; =============================================================================\n\n(def link-rows\n  \"Rows the de Bruijn lanes do not carry: a require installs a child and\n   attaches a module image in the kernel's own format, and the layouts\n   of §4 reconstruct no install child (canonical-task refuses\n   :installs).\"\n  #{7 8 9 10 11 12 17})\n\n\n(def lane-rows\n  \"The wrapped rows every lane executes: 15 of §5.2's 22.\"\n  (filterv #(not (contains? link-rows (first %))) rows))\n\n\n(defn lane-cases\n  \"15 lane rows x 4 segments, plus row 20 once: [row segment expected build].\"\n  []\n  (filterv #(not (contains? link-rows (first %))) (matrix-cases)))\n\n\n(defn on-lane\n  [lane build]\n  (binding [*lane* lane] (build)))\n\n\n(defn lane-lift\n  \"The lift of §7.1 on m's own lane.\"\n  [m serve!]\n  (if (= :semantic-register (lane-of m))\n    (rows/lift-task m serve! (lift-opts))\n    (layout/lift-task m (kernel-space m) (on-lane :semantic-register machine) serve! (lift-opts))))\n\n\n(defn lane-lower\n  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n  [lane opts wire attach!]\n  (let [scratch (on-lane :semantic-register #(machine opts))]\n    (if (= :semantic-register lane)\n      (rows/lower-task scratch wire attach!)\n      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n\n\n(defn logical-names\n  \"§5.5's explicit correspondence: each served identity to the resource\n   key the lifted machine holds that handle under. The fixture builds the\n   same program on every lane, so one key names one logical stream.\"\n  [m peer]\n  (into {} (map (fn [[id e]]\n                  [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n                          (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n        @(:table peer)))\n\n\n(defn ring-names\n  \"{stream identity -> resource key} over every stream m holds.\"\n  [m]\n  (into {} (keep (fn [[k h]]\n                   (when (satisfies? stream/IDaoStreamDescriptor h)\n                     [(:dao.stream/identity (stream/descriptor h)) k])))\n        (:resources m)))\n\n\n(defn logical-positions\n  \"The task with each cursor position's embedded stream identity renamed\n   to its logical name. A ring buffer cursor carries its stream's\n   identity, which §5.5's marker substitution does not reach (reported\n   as a design defect), so the cross-lane comparison renames it under\n   the same fixture correspondence.\"\n  [task m]\n  (let [names (ring-names m)\n        k :dao.stream.ringbuffer/identity]\n    (replace-nodes task #(= :cursor-cell-body (:kind %))\n                   (fn [n]\n                     (update-in n [:slots 1]\n                                (fn [p]\n                                  (if (and (map? p) (contains? names (get p k)))\n                                    (assoc p k (get names (get p k)))\n                                    p)))))))\n\n\n(defn logical-root\n  \"§5.5: the lift's root id with every lane identity replaced by the\n   fixture's logical name.\"\n  [wire m peer]\n  (:yin.k/root (rows/canonical-under (rows/emit (logical-positions (rows/decode wire) m))\n                                     (logical-names m peer))))\n\n\n(defn lane-root\n  \"Build on lane, lift: [root under the logical names, the lane's own\n   reference run].\"\n  [lane build]\n  (let [world (on-lane lane build)\n        {:keys [serve! peer]} (served (or (:surfaces world) #{:reader}))\n        wire (lane-lift (:machine world) serve!)]\n    (is (nil? (rows/validate-frames (rows/decode wire))) \"law 6 on every lane\")\n    [(logical-root wire (:machine world) peer)\n     (reference (on-lane lane build))]))\n\n\n(defn canonical-equality\n  \"Law 4 for one case: the three lanes lift to one root, and each lane's\n   own run answers the reference.\"\n  [build expected]\n  (let [roots (mapv #(lane-root % build) lanes)]\n    (is (apply = (map first roots)) \"law 4: one root id on every lane\")\n    (doseq [[lane [_ ref]] (map vector lanes roots)]\n      (is (:halted ref) (str lane \" completes\"))\n      (when (some? expected) (is (= expected (:value ref)) (str lane \" answers the reference\"))))\n    roots))\n\n\n(deftest cross-engine-canonical-equality-bare\n  ;; the quick-tier slice of acceptance 10: every lane row once, bare\n  (let [n (atom 0)]\n    (doseq [[row r build] lane-rows]\n      (testing (str \"row \" row)\n        (canonical-equality #(build identity) r)\n        (swap! n inc)))\n    (testing \"row 20\"\n      (canonical-equality tail-effect-halt \"B\")\n      (swap! n inc))\n    (is (= 16 @n))))\n\n\n(deftest ^:slow cross-engine-canonical-equality\n  (slow/guard\n    \"cross-engine-canonical-equality\"\n    (fn []\n      (let [cases (lane-cases) n (atom 0)]\n        (is (= 61 (count cases)) \"15 lane rows x 4 segments + row 20\")\n        (doseq [[row label expected build] cases]\n          (testing (str \"row \" row \" \" (name label))\n            (canonical-equality build expected)\n            (swap! n inc)))\n        (is (= 61 @n))))))\n\n\n(def ordered-pairs\n  \"Law 5's six ordered pairs of distinct lanes.\"\n  (into [] (mapcat (fn [from] (keep (fn [to] (when (not= from to) [from to])) lanes))) lanes))\n\n\n(def unlowerable\n  \"[row receiver] pairs a de Bruijn receiver cannot continue: row 4's\n   retained FFI re-parks through the kernel's own call-out pair\n   (ffi/response-wait-entry), not the carried response cursor cell the\n   semantic-register kernel restores. A kernel seam, reported.\"\n  #{[4 :stack] [4 :register]})\n\n\n(defn crossed\n  \"Lift on from, lower into a fresh receiver on to, satisfy through the\n   source's streams: the run's observables and attaches.\"\n  [from to build]\n  (let [world (on-lane from build)\n        {:keys [toy peer serve!]} (served (or (:surfaces world) #{:reader}))\n        wire (lane-lift (:machine world) serve!)\n        receiver ((or (:receiver world) (constantly nil)))\n        {:keys [attach!] n :count} (recording-attacher toy)\n        recv (lane-lower to (merge {:attach-stream attach!} (:opts receiver)) wire attach!)\n        _ (is (= to (lane-of recv)))\n        attaches @n\n        done (satisfy world recv #(drive-peers % [peer]))\n        _ (s/serve-mirror! peer)]\n    (when-let [f (:finish world)] (f))\n    (when-let [f (:finish receiver)] (f))\n    {:attaches attaches :wire wire\n     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn cross-lowering\n  \"Law 5 for one case: every admitted ordered pair continues to the\n   reference. Answers the pairs that ran.\"\n  [row build]\n  (let [ref (reference (on-lane :semantic-register build))]\n    (is (:halted ref))\n    (reduce (fn [ran [from to]]\n              (if (contains? unlowerable [row to])\n                ran\n                (testing (str (name from) \" -> \" (name to))\n                  (let [got (crossed from to build)]\n                    (is (= (count (stream-identities (:wire got))) (:attaches got)))\n                    (is (= (select-keys ref [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n                        \"law 5: the lowered run continues to the reference\")\n                    (conj ran [from to])))))\n            []\n            ordered-pairs)))\n\n\n(deftest cross-engine-lowering-bare\n  ;; the quick-tier slice of acceptance 11: every lane row once, bare\n  (is (= 6 (count ordered-pairs)))\n  (let [ran (atom 0)]\n    (doseq [[row _ build] lane-rows]\n      (testing (str \"row \" row)\n        (let [pairs (cross-lowering row #(build identity))]\n          (is (= (if (= 4 row) 2 6) (count pairs)) \"every admitted ordered pair ran\")\n          (swap! ran + (count pairs)))))\n    (testing \"row 20\"\n      (is (= 6 (count (cross-lowering 20 tail-effect-halt))))\n      (swap! ran + 6))\n    (is (= 92 @ran) \"16 cases x 6 pairs, less row 4's 4 into a de Bruijn receiver\")))\n\n\n(deftest ^:slow cross-engine-lowering\n  (slow/guard\n    \"cross-engine-lowering\"\n    (fn []\n      (let [ran (atom 0) cases (lane-cases)]\n        (is (= 61 (count cases)))\n        (doseq [[row label _ build] cases]\n          (testing (str \"row \" row \" \" (name label))\n            (swap! ran + (count (cross-lowering row build)))))\n        (is (= 350 @ran) \"61 cases x 6 pairs, less row 4's 4 per segment\")))))\n\n\n(defn register-judge\n  \"The frame validator's verdict on register entry `entry` of m,\n   reconstructed through the layout.\"\n  [m entry]\n  (let [sp (kernel-space m)\n        p (layout/lift-state (layout/lift-context m sp (:owner m)) entry)\n        code-map (into {} (map (fn [[a sg]] [a (:vector sg)])) (:segments sp))\n        as-sr {:code (into {} (map (fn [a] [a {:address a}])) (keys code-map))}]\n    (:yin.k/kind (frame/defect (ft/canonical as-sr p true) code-map :wait {:free-env {} :ffi-call-ids #{}}))))\n\n\n(defn spare-register\n  \"A physical register of the entry's body outside its live set and its\n   destination that R gives exactly one virtual.\"\n  [m entry]\n  (let [sg (val (first (:segments (kernel-space m))))\n        site (- (:site-pc entry) (layout/offset :register m sg))\n        body (nth (:phys sg) (code/body-index (:bodies sg) site))\n        unique (keep (fn [[s xs]] (when (= 1 (count xs)) s)) (group-by body (keys body)))]\n    (first (remove (conj (set (:live entry)) (:dest entry)) (sort unique)))))\n\n\n(deftest layout-refusals\n  (testing \"a kernel stepped to a non-safepoint pc\"\n    (doseq [lane [:stack :register]]\n      (testing (name lane)\n        (let [m (on-lane lane #(vm/step (load-program (machine) (s/app (s/lam ['p] (s/lit 42)) (s/lit 1)))))\n              n (atom 0)\n              {:keys [serve!]} (served #{:reader})\n              d (error #(lane-lift m (fn [h] (swap! n inc) (serve! h))))]\n          (is (not (vm/halted? m)))\n          (is (= :yin.k/not-at-safepoint (:yin.k/status d)) (pr-str d))\n          (is (zero? @n) \"no stream was served\")\n          (testing \", its registers read as a payload\"\n            (let [entry (if (= :stack lane)\n                          (select-keys m [:pc :frames :stack :continuation])\n                          (assoc (select-keys m [:pc :frames :continuation]) :regs [] :resume-mode :write-result))\n                  cx (layout/lift-context m (kernel-space m) (:owner m))]\n              (is (= :yin.k/not-at-safepoint (:yin.k/status (error #(layout/lift-state cx entry)))))))))))\n  (testing \"a register entry whose live was tampered\"\n    (let [m (:machine (on-lane :register #(bare 1)))\n          entry (first (:wait-set m))\n          live (:live entry)\n          spare (spare-register m entry)]\n      (is (nil? (register-judge m entry)) \"the untampered entry reconstructs a valid frame\")\n      (is (seq live))\n      (is (= :window-missing (register-judge m (assoc entry :live (vec (rest live)) :regs (vec (rest (:regs entry))))))\n          \"a live register dropped\")\n      (is (some? spare))\n      (is (= :window-extra (register-judge m (assoc entry :live (vec (sort (conj live spare)))\n                                                    :regs (vec (sort-by first (conj (:regs entry) [spare :x]))))))\n          \"a dead register added\")))\n  (testing \"a primitive in a window: the register kernel cannot hold it, refused before any attach\"\n    (let [build #(reader % (s/app (s/v 'conj) (s/lit []) read-op))\n          world (build identity)\n          {:keys [serve! toy]} (served #{:reader})\n          wire (rows/lift-task (:machine world) serve! (lift-opts))\n          {:keys [attach!] n :count} (recording-attacher toy)\n          d (error #(lane-lower :register {:attach-stream attach!} wire attach!))]\n      (is (= [:yin.k/unsupported :continuation-registers] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n      (is (zero? @n) \"refused before any attachment\")\n      (testing \", the stack kernel holds it\"\n        (let [ref (reference (build identity))\n              got (crossed :semantic-register :stack #(build identity))]\n          (is (= [\"B\"] (:value ref)))\n          (is (= (:value ref) (:value got))))))))\n","numLines":393,"startLine":1280,"totalLines":1672}},"tool_result_meta":[{"id":"toolu_01E3WKVYCep1yoLveGR2U3rM","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
