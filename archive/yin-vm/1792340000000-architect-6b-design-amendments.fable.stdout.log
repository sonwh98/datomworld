                    (mapcat (fn [[m inst]]\n                                        (map (fn [x]\n                                               (symbol (str (name m) \"/\"\n                                                            (name x))))\n                                             (get-in inst\n                                                     [:response :manifest\n                                                      :yin.module/exports])))\n                                      (:installs vm)))\n             missing (update (:yin.k/missing walked) :obligations","numLines":16,"startLine":1474,"totalLines":3784}},"tool_result_meta":[{"id":"toolu_01V7B6TUkyRQGLtsV3nJyEEz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
