m-ref (if (engine/authentic-ref? m :stream-ref x)\n1284\t                      [:row (stream-row! ctx (:id x))]\n1285\t                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :stream-ref}))\n1286\t        :cursor-ref (if (engine/authentic-ref? m :cursor-ref x)\n1287\t                      [:cursor-cell (cell-for! ctx (:id x))]\n1288\t                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :cursor-ref}))\n1289\t        :parked-continuation (if (contains? (:parked m) (:id x))\n1290\t                               [:row (node :parked-ref [(:id x)])]\n1291\t                               (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/hint :parked-reference}))\n1292\t        :cell-ref (outcome! :yin.k/non-portable :cell {:yin.k/hint (:id x)})\n1293\t        (collection-value ctx :map (mapcat identity x) x))\n1294\t      (vector? x) (collection-value ctx :vec x x)\n1295\t      (set? x) (collection-value ctx :set (vec x) x)\n1296\t      (seq? x) (collection-value ctx :list (vec x) x)\n1297\t      (scalar-literal? x) [:lit x]\n1298\t      :else (outcome! :yin.k/non-portable :host-object {}))))\n1299\t\n1300\t\n1301\t(defn- window-node\n1302\t  [ctx w]\n1303\t  (node :window (mapcat (fn [[r v]] [r (lift-value ctx v)]) w)))\n1304\t\n1305\t\n1306\t(defn- k-node\n1307\t  [ctx k]\n1308\t  (node :k (mapv (fn [f]\n1309\t                   (let [a (address! ctx (:segment f))]\n1310\t                     (context! ctx a (:pc f) (:env f))\n1311\t                     (node :kframe [a (:pc f) (lift-env-node ctx (:env f))\n1312\t                                    (window-node ctx (:window f)) (:rd f)])))\n1313\t                 (or k []))))\n1314\t\n1315\t\n1316\t(defn- state-node\n1317\t  \"An evaluator payload (wait entry, parked record, reified payload) as\n1318\t   its :act or :tail row; engine fields are the pending's.\"\n1319\t  [ctx p]\n1320\t  (if (contains? p :site)\n1321\t    ;; a tail state re