{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CTevGHc8Sz3gTDpfxrftkM","type":"tool_result","content":"1142\t;; restores state. Restoration delivers nothing, runs nothing.\n1143\t\n1144\t(defn- outcome!\n1145\t  [status kind data]\n1146\t  (throw (ex-info \"Task transport refused\"\n1147\t                  (merge data (cond-> {:yin.k/status status}\n1148\t                                (some? kind) (assoc :yin.k/kind kind))))))\n1149\t\n1150\t\n1151\t(defn- unliftable-hold\n1152\t  \"The first hold of m with no wire pending (UCF 7.4.1, 7.4.3), or nil.\"\n1153\t  [m]\n1154\t  (let [waits (:wait-set m)\n1155\t        cells (filter map? (vals (:resources m)))\n1156\t        held? #(and (map? %) (contains? % :yin.k/held))]\n1157\t    (cond\n1158\t      (some #(= :observe (:reason %)) waits) :observe\n1159\t      (or (some held? waits) (some held? cells)) :held\n1160\t      (some :yin.k/unminted cells) :unminted-cursor\n1161\t      (seq (:yin.k/closes m)) :pending-close\n1162\t      (some #(and (= :link-request (:reason %)) (not (contains? % :cursor))) waits)\n1163\t      :link-cursor-not-installed\n1164\t      :else nil)))\n1165\t\n1166\t\n1167\t(defn- stream-row!\n1168\t  \"The :stream row of resource sid, served once per resource.\"\n1169\t  [ctx sid]\n1170\t  (or (get-in @(:acc ctx) [:streams sid])\n1171\t      (let [h (get (:resources (:m ctx)) sid)]\n1172\t        (when (nil? h)\n1173\t          (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint sid}))\n1174\t        (let [marker (remote/lift-marker (:serve! ctx) h)]\n1175\t          (when (nil? marker) (outcome! :yin.k/unsatisfied nil {}))\n1176\t          (let [n (node :stream [(:dao.stream/identity marker) (:dao.stream/descriptor marker)])]\n1177\t            (swap! (:acc ctx) assoc-in [:streams sid] n)\n1178\t            n)))))\n1179\t\n1180\t\n1181\t(defn- cell!\n1182\t  [ctx source sid position]\n1183\t  (when-not (contains? (:cells @(:acc ctx)) source)\n1184\t    (let [stream (stream-row! ctx sid)]\n1185\t      (swap! (:acc ctx) assoc-in [:cells source] (node :cursor-cell-body [stream position]))))\n1186\t  source)\n1187\t\n1188\t\n1189\t(defn- cell-for!\n1190\t  [ctx cid]\n1191\t  (let [cell (get (:resources (:m ctx)) cid)]\n1192\t    (when-not (and (map? cell) (contains? cell :stream-id))\n1193\t      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint cid}))\n1194\t    (cell! ctx cid (:stream-id cell) (:cursor cell))))\n1195\t\n1196\t\n1197\t(defn- address!\n1198\t  [ctx seg]\n1199\t  (if-some [a (get-in (:m ctx) [:code seg :address])]\n1200\t    (do (swap! (:acc ctx) update :segments conj a) a)\n1201\t    (outcome! :yin.k/non-portable :unaddressed-segment {:yin.k/hint seg})))\n1202\t\n1203\t\n1204\t(defn- scalar-literal?\n1205\t  [x]\n1206\t  (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x) (number? x)\n1207\t      (and (not (cbor/byte-payload? x)) (cbor/numeric? x))))\n1208\t\n1209\t\n1210\t(defn- primitive-name\n1211\t  [ctx f]\n1212\t  (let [m (:m ctx)\n1213\t        n (vm/name-of (:primitives m) (or (:primitive-canonical-names m) {}) f)\n1214\t        profile (when (symbol? n) (vm/profile-of (:primitives m) n))]\n1215\t    (cond\n1216\t      (nil? n) (outcome! :yin.k/non-portable :unnamed-function {})\n1217\t      (not (symbol? n)) (outcome! :yin.k/non-portable :ambiguous-primitive {})\n1218\t      (= :host (:yin.k/class profile)) (outcome! :yin.k/non-portable :host-state-primitive {:yin.k/name n})\n1219\t      :else n)))\n1220\t\n1221\t\n1222\t(declare lift-value state-node)\n1223\t\n1224\t\n1225\t(defn- collection-value\n1226\t  \"A guest collection: a literal when no member is a reference.\"\n1227\t  [ctx kind members original]\n1228\t  (let [vs (mapv #(lift-value ctx %) members)]\n1229\t    (if (every? #(= :lit (first %)) vs) [:lit original] [:row (node kind vs)])))\n1230\t\n1231\t\n1232\t(defn- bindings-node\n1233\t  [ctx e]\n1234\t  (node :bindings (mapcat (fn [[k v]] [k (lift