{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HfaD4QbRmPivj5X2BR2kzZ","type":"tool_result","content":"2488\t\n2489\t\n2490\t(defn- cut-store\n2491\t  \"Content store `base` whose `position`-th put suffers a cut: `:before`\n2492\t  stores nothing and throws, `:after` stores the bytes and throws\n2493\t  anyway.  `fired` (an atom) takes the cut address: the process dies\n2494\t  there.\"\n2495\t  [base position cut fired]\n2496\t  (let [n (atom 0)\n2497\t        put! (:put-bytes-fn base)]\n2498\t    (assoc base :put-bytes-fn\n2499\t           (fn [address bytes]\n2500\t             (if (= position (swap! n inc))\n2501\t               (do (when (= :after cut) (put! address bytes))\n2502\t                   (reset! fired address)\n2503\t                   (throw (ex-info \"the store cut\" {:position position})))\n2504\t               (put! address bytes))))))\n2505\t\n2506\t\n2507\t(defn- store-records\n2508\t  \"Holder `h`'s journaled store bracket records of `kind`.\"\n2509\t  [c h kind]\n2510\t  (filterv #(and (= :yin.k/store (:yin.k/action %)) (= kind (:yin.k/journal %)))\n2511\t           (ct/journal-records-of c h)))\n2512\t\n2513\t\n2514\t(deftest the-wired-compositions-content-store-cuts-test\n2515\t  (doseq [position [1 2]\n2516\t          cut [:before :after]]\n2517\t    (testing (pr-str [position cut])\n2518\t      (let [base (mem/create-content-mem)\n2519\t            fired (atom nil)\n2520\t            w (ct/exclusive-world :store (cut-store base position cut fired))\n2521\t            get-bytes (:get-bytes-fn base)]\n2522\t        (try\n2523\t          (let [c (loop [c (:c w) k 0]\n2524\t                    (let [c' (try (compose/step c)\n2525\t                                  (catch #?(:cljd Object :clj Throwable :cljs :default) _ c))]\n2526\t                      (if (or (some? @fired) (>= k 12)) c' (recur c' (inc k)))))\n2527\t                cut-address @fired]\n2528\t            (is (some? cut-address) \"the cut fired on a freeze put\")\n2529\t            (let [cell (get-in c [:holders \"h1\" :export])\n2530\t                  frozen (export/freeze (:m cell) (:record cell))\n2531\t                  recovery (:address frozen)\n2532\t                  pack (:pack-address frozen)]\n2533\t              (is (= (if (= position 1) recovery pack) cut-address)\n2534\t                  \"the first put is recovery v2; the second is the pack\")\n2535\t              (when (= :after cut)\n2536\t                (let [wire (cbor/decode (get-bytes cut-address ::absent))]\n2537\t                  (if (= position 1)\n2538\t                    (do (is (= 2 (:yin.k/version wire)))\n2539\t                        (is (= pack (:yin.k/pack-address wire))))\n2540\t                    (do (is (= cut-address (rows/pack-address wire)))\n2541\t                        (is (= (:yin.k/root wire)\n2542\t                               (:yin.k/root (checkpoint/inspect cut-address\n2543\t                                                                (get-bytes cut-address ::absent))))))))))\n2544\t            (is (= position (count (store-records c \"h1\" :yin.k/intent)))\n2545\t                \"each object's intent is durable before its put\")\n2546\t            (is (= (dec position) (count (store-records c \"h1\" :yin.k/ack)))\n2547\t                \"the cut object was never acknowledged\")\n2548\t            (is (= (= :after cut) (not= ::absent (get-bytes cut-address ::absent))))\n2549\t            (is (not (journal-has? c \"h1\" #(= :yin.k/fenced (:yin.k/journal %))))\n2550\t                \"nothing is fenced across the cut\")\n2551\t            (is (empty? (inbound-of c \"h1\" :yin.k/offer)) \"nothing was offered\")\n2552\t            (compose/close! c)\n2553\t            (file-journal/close! (:backend w))\n2554\t            (let [rebuilt (ct/reopened-world (assoc (select-keys w [:dir :clock :journals :source-config])\n2555\t                                                    :store base))]\n2556\t              (try\n2557\t                (let [o (:yin.k/occurrence (first (store-records c \"h1\" :yin.k/intent)))\n2558\t                      c2 (reduce (fn [c _] (compose/step c)) (:c rebuilt) (range 12))\n2559\t                      st (get-in c2 [:holders \"h1\"])\n2560\t                      frames (ct/journal-records-of c2 \"h1\")]\n2561\t                  (is (= :stalled (:phase st)))\n2562\t                  (is (= {:yin.k/status :yin.k/unsatisfied\n2563\t                          :yin.k/detail {:yin.k/reason :incomplete-preparation\n2564\t                                         :yin.k/occurrence o}}\n2565\t                         {:yin.k/status (:status st) :yin.k/detail (:detail st)})\n2566\t                      \"an interrupted freeze recovers stalled, naming its occurrence\")\n2567\t                  (is (nil? (:machine st)) \"never runnable\")\n2568\t                  (is (= 1 (count (filter #(= :yin.k/minted (:yin.k/journal %)) frames)))\n2569\t                      \"the recovery never re-minted\")\n2570\t                  (is (not-any? #(= :yin.k/fenced (:yin.k/journal %)) frames)\n2571\t                      \"and never fenced over the incomplete objects\")\n2572\t                  (is (empty? (inbound-of c2 \"h1\" :yin.k/offer)) \"nothing was offered\")\n2573\t                  (is (nil? (get-in (authority/projection (:authority c2)) [:occurrences o]))\n2574\t                      \"the authority never heard of the occurrence\")\n2575\t                  (is (zero? @(:attaches w)) \"no program IO through the cut or the recovery\")\n2576\t                  (is (vm/blocked? (get-in w [:source-config :machine]))))\n2577\t                (finally (ct/close-reconstruction! rebuilt)))))\n2578\t          (finally\n2579\t            (ct/cleanup-dir! (:dir w))\n2580\t            (ct/cleanup-dir! (:jroot w))))))))\n2581\t\n2582\t\n2583\t(deftest a-composed-authority-refuses-an-unfenced-result-report-test\n2584\t  (exclusive-row\n2585\t    (fn [w]\n2586\t      (let [c (step-until (:c w) #(= :running (get-in % [:holders \"h1\" :phase])) 60)\n2587\t            st (get-in c [:holders \"h1\"])\n2588\t            wire (s/lift (s/halted-machine) nil)\n2589\t            bytes (cbor/encode wire)\n2590\t            address (rows/pack-address wire)\n2591\t            before (authority/projection (:authority c))\n2592\t            r (completion/report! (:authority c) \"h1\"\n2593\t                                  (completion/resumed (:occurrence st) (:lease st) address)\n2594\t                                  bytes)]\n2595\t        (is (= {:yin.k/status :refused :yin.k/reason :wrong-origin} r))\n2596\t        (is (= before (authority/projection (:authority c)))\n2597\t            \"an unfenced fork result establishes no completion\")))))\n2598\t"}]},"parent_tool_use_id":null,"session_id":"b306c61e-3078-4fbf-aeb8-718be5db0962","uuid":"6aa398ed-e46b-4aad-8345-d44ff1fc8004","timestamp":"2026-10-13T14:29:01.638Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7c/test/yin/vm/ucf/compose_rows_test.cljc","content":"\n\n(defn- cut-store\n  \"Content store `base` whose `position`-th put suffers a cut: `:before`\n  stores nothing and throws, `:after` stores the bytes and throws\n  anyway.  `fired` (an atom) takes the cut address: the process dies\n  there.\"\n  [base position cut fired]\n  (let [n (atom 0)\n        put! (:put-bytes-fn base)]\n    (assoc base :put-bytes-fn\n           (fn [address bytes]\n             (if (= position (swap! n inc))\n               (do (when (= :after cut) (put! address bytes))\n                   (reset! fired address)\n                   (throw (ex-info \"the store cut\" {:position position})))\n               (put! address bytes))))))\n\n\n(defn- store-records\n  \"Holder `h`'s journaled store bracket records of `kind`.\"\n  [c h kind]\n  (filterv #(and (= :yin.k/store (:yin.k/action %)) (= kind (:yin.k/journal %)))\n           (ct/journal-records-of c h)))\n\n\n(deftest the-wired-compositions-content-store-cuts-test\n  (doseq [position [1 2]\n          cut [:before :after]]\n    (testing (pr-str [position cut])\n      (let [base (mem/create-content-mem)\n            fired (atom nil)\n            w (ct/exclusive-world :store (cut-store base position cut fired))\n            get-bytes (:get-bytes-fn base)]\n        (try\n          (let [c (loop [c (:c w) k 0]\n                    (let [c' (try (compose/step c)\n                                  (catch #?(:cljd Object :clj Throwable :cljs :default) _ c))]\n                      (if (or (some? @fired) (>= k 12)) c' (recur c' (inc k)))))\n                cut-address @fired]\n            (is (some? cut-address) \"the cut fired on a freeze put\")\n            (let [cell (get-in c [:holders \"h1\" :export])\n                  frozen (export/freeze (:m cell) (:record cell))\n                  recovery (:address frozen)\n                  pack (:pack-address frozen)]\n              (is (= (if (= position 1) recovery pack) cut-address)\n                  \"the first put is recovery v2; the second is the pack\")\n              (when (= :after cut)\n                (let [wire (cbor/decode (get-bytes cut-address ::absent))]\n                  (if (= position 1)\n                    (do (is (= 2 (:yin.k/version wire)))\n                        (is (= pack (:yin.k/pack-address wire))))\n                    (do (is (= cut-address (rows/pack-address wire)))\n                        (is (= (:yin.k/root wire)\n                               (:yin.k/root (checkpoint/inspect cut-address\n                                                                (get-bytes cut-address ::absent))))))))))\n            (is (= position (count (store-records c \"h1\" :yin.k/intent)))\n                \"each object's intent is durable before its put\")\n            (is (= (dec position) (count (store-records c \"h1\" :yin.k/ack)))\n                \"the cut object was never acknowledged\")\n            (is (= (= :after cut) (not= ::absent (get-bytes cut-address ::absent))))\n            (is (not (journal-has? c \"h1\" #(= :yin.k/fenced (:yin.k/journal %))))\n                \"nothing is fenced across the cut\")\n            (is (empty? (inbound-of c \"h1\" :yin.k/offer)) \"nothing was offered\")\n            (compose/close! c)\n            (file-journal/close! (:backend w))\n            (let [rebuilt (ct/reopened-world (assoc (select-keys w [:dir :clock :journals :source-config])\n                                                    :store base))]\n              (try\n                (let [o (:yin.k/occurrence (first (store-records c \"h1\" :yin.k/intent)))\n                      c2 (reduce (fn [c _] (compose/step c)) (:c rebuilt) (range 12))\n                      st (get-in c2 [:holders \"h1\"])\n                      frames (ct/journal-records-of c2 \"h1\")]\n                  (is (= :stalled (:phase st)))\n                  (is (= {:yin.k/status :yin.k/unsatisfied\n                          :yin.k/detail {:yin.k/reason :incomplete-preparation\n                                         :yin.k/occurrence o}}\n                         {:yin.k/status (:status st) :yin.k/detail (:detail st)})\n                      \"an interrupted freeze recovers stalled, naming its occurrence\")\n                  (is (nil? (:machine st)) \"never runnable\")\n                  (is (= 1 (count (filter #(= :yin.k/minted (:yin.k/journal %)) frames)))\n                      \"the recovery never re-minted\")\n                  (is (not-any? #(= :yin.k/fenced (:yin.k/journal %)) frames)\n                      \"and never fenced over the incomplete objects\")\n                  (is (empty? (inbound-of c2 \"h1\" :yin.k/offer)) \"nothing was offered\")\n                  (is (nil? (get-in (authority/projection (:authority c2)) [:occurrences o]))\n                      \"the authority never heard of the occurrence\")\n                  (is (zero? @(:attaches w)) \"no program IO through the cut or the recovery\")\n                  (is (vm/blocked? (get-in w [:source-config :machine]))))\n                (finally (ct/close-reconstruction! rebuilt)))))\n          (finally\n            (ct/cleanup-dir! (:dir w))\n            (ct/cleanup-dir! (:jroot w))))))))\n\n\n(deftest a-composed-authority-refuses-an-unfenced-result-report-test\n  (exclusive-row\n    (fn [w]\n      (let [c (step-until (:c w) #(= :running (get-in % [:holders \"h1\" :phase])) 60)\n            st (get-in c [:holders \"h1\"])\n            wire (s/lift (s/halted-machine) nil)\n            bytes (cbor/encode wire)\n            address (rows/pack-address wire)\n            before (authority/projection (:authority c))\n            r (completion/report! (:authority c) \"h1\"\n                                  (completion/resumed (:occurrence st) (:lease st) address)\n                                  bytes)]\n        (is (= {:yin.k/status :refused :yin.k/reason :wrong-origin} r))\n        (is (= before (authority/projection (:authority c)))\n            \"an unfenced fork result establishes no completion\")))))\n","numLines":111,"startLine":2488,"totalLines":2598}},"tool_result_meta":[{"id":"toolu_01HfaD4QbRmPivj5X2BR2kzZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
