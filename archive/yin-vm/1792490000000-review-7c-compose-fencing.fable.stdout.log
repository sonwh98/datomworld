{"type":"assistant","message":{"model":"claude-fable-5-1","id":"msg_011CfzPnRdVrG25pBFZoVF7T","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01F3FCDR5XphTyxFDm1dRcHh","name":"Read","input":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7c/test/yin/vm/ucf/handoff_v2_authority_test.cljc"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":32,"cache_creation_input_tokens":14840,"cache_read_input_tokens":65783,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14840},"output_tokens":5,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":{"cache_miss_reason":{"type":"unavailable"}},"context_management":null},"parent_tool_use_id":null,"session_id":"b306c61e-3078-4fbf-aeb8-718be5db0962","uuid":"cf27db49-83a3-4b97-a2ef-b4bf9e24c3c0","timestamp":"2026-10-13T14:28:33.529Z","request_id":"req_011CfzPnRJtNaskh5s9cBcfG","wire_tool_inputs":{"toolu_01F3FCDR5XphTyxFDm1dRcHh":{"file_path":"/Users/sto/workspace/datomworld-srvm-p7c/test/yin/vm/ucf/handoff_v2_authority_test.cljc"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F3FCDR5XphTyxFDm1dRcHh","type":"tool_result","content":"1\t(ns yin.vm.ucf.handoff-v2-authority-test\n2\t  \"Direct version-2 inspector coverage: fork operation ids are refused.\n3\t   Authority paths use row packs and are covered by rows-custody-test.\"\n4\t  (:require [clojure.test :refer [deftest is testing]]\n5\t            [dao.jing.cbor :as jing.cbor]\n6\t            [yin.vm.ucf.checkpoint :as checkpoint]\n7\t            [yin.vm.ucf.v2-support :as s]))\n8\t\n9\t\n10\t(deftest a-fork-tree-refuses-a-carried-operation-id\n11\t  (doseq [engine s/engines]\n12\t    (testing (name engine)\n13\t      (let [t (s/toy)\n14\t            peer (s/served-peer t)\n15\t            [parked _] (s/parked-writer engine)\n16\t            export (s/lift parked t peer nil #{:reader :writer})\n17\t            body (s/decoded export)\n18\t            with-id (assoc-in body [:yin.k/frames 0 :yin.k/pending\n19\t                                    :yin.k/op-id]\n20\t                              {:yin.k/occurrence s/predecessor\n21\t                               :yin.k/seq 0})\n22\t            bytes (jing.cbor/encode with-id)\n23\t            r (checkpoint/inspect (s/segment-address bytes) bytes)]\n24\t        (is (= :ok (:status export)) (pr-str export))\n25\t        (is (= :yin.k/undecodable (:yin.k/status r)) (pr-str r))\n26\t        (is (= :fork-op-id (:yin.k/kind r)))))))\n27\t\n28\t\n29\t(deftest the-old-inspector-distinguishes-fork-and-exclusive-baselines\n30\t  (doseq [engine s/engines]\n31\t    (testing (name engine)\n32\t      (let [t (s/toy)\n33\t            peer (s/served-peer t)\n34\t            [parked _] (s/parked-reader engine)\n35\t            fork (s/lift parked t peer)\n36\t            exclusive (s/lift parked t peer (s/header 0 nil #{}))\n37\t            bf (checkpoint/inspect (:address fork) (:bytes fork))\n38\t            be (checkpoint/inspect (:address exclusive) (:bytes exclusive))]\n39\t        (is (= :ok (:status fork)) (pr-str fork))\n40\t        (is (= :ok (:status exclusive)) (pr-str exclusive))\n41\t        (is (true? (:yin.k/fork bf)) \"the baseline names the role\")\n42\t        (is (empty? (:yin.k/ops bf)) \"a fork carries no operation id\")\n43\t        (is (not (contains? bf :yin.k/occurrence)))\n44\t        (is (not (contains? be :yin.k/fork)))\n45\t        (is (= s/occurrence (:yin.k/occurrence be)))))))\n46\t\n47\t\n48\t(deftest the-old-inspector-preserves-a-halted-results-origin\n49\t  (doseq [engine s/engines]\n50\t    (testing (name engine)\n51\t      (let [t (s/toy)\n52\t            peer (s/served-peer t)\n53\t            fork (s/lift (s/halted-with engine (s/lit 42)) t peer)\n54\t            exclusive (s/lift (s/halted-with engine (s/lit 42)) t peer\n55\t                              {:yin.k/origin s/origin\n56\t                               :yin.k/occurrence s/occurrence\n57\t                               :yin.k/arbitration s/arbitration\n58\t                               :yin.k/next-op-seq 3\n59\t                               :yin.k/enrolled #{}})\n60\t            bf (checkpoint/inspect (:address fork) (:bytes fork))\n61\t            be (checkpoint/inspect (:address exclusive) (:bytes exclusive))]\n62\t        (is (= :halted (:yin.k/kind bf)))\n63\t        (is (true? (:yin.k/fork bf)))\n64\t        (is (= :halted (:yin.k/kind be)))\n65\t        (is (= s/origin (:yin.k/origin be)))))))\n66\t"}]},"parent_tool_use_id":null,"session_id":"b306c61e-3078-4fbf-aeb8-718be5db0962","uuid":"07a0a406-d306-4e34-9265-c26a091cb7e5","timestamp":"2026-10-13T14:28:33.535Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7c/test/yin/vm/ucf/handoff_v2_authority_test.cljc","content":"(ns yin.vm.ucf.handoff-v2-authority-test\n  \"Direct version-2 inspector coverage: fork operation ids are refused.\n   Authority paths use row packs and are covered by rows-custody-test.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing.cbor :as jing.cbor]\n            [yin.vm.ucf.checkpoint :as checkpoint]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n(deftest a-fork-tree-refuses-a-carried-operation-id\n  (doseq [engine s/engines]\n    (testing (name engine)\n      (let [t (s/toy)\n            peer (s/served-peer t)\n            [parked _] (s/parked-writer engine)\n            export (s/lift parked t peer nil #{:reader :writer})\n            body (s/decoded export)\n            with-id (assoc-in body [:yin.k/frames 0 :yin.k/pending\n                                    :yin.k/op-id]\n                              {:yin.k/occurrence s/predecessor\n                               :yin.k/seq 0})\n            bytes (jing.cbor/encode with-id)\n            r (checkpoint/inspect (s/segment-address bytes) bytes)]\n        (is (= :ok (:status export)) (pr-str export))\n        (is (= :yin.k/undecodable (:yin.k/status r)) (pr-str r))\n        (is (= :fork-op-id (:yin.k/kind r)))))))\n\n\n(deftest the-old-inspector-distinguishes-fork-and-exclusive-baselines\n  (doseq [engine s/engines]\n    (testing (name engine)\n      (let [t (s/toy)\n            peer (s/served-peer t)\n            [parked _] (s/parked-reader engine)\n            fork (s/lift parked t peer)\n            exclusive (s/lift parked t peer (s/header 0 nil #{}))\n            bf (checkpoint/inspect (:address fork) (:bytes fork))\n            be (checkpoint/inspect (:address exclusive) (:bytes exclusive))]\n        (is (= :ok (:status fork)) (pr-str fork))\n        (is (= :ok (:status exclusive)) (pr-str exclusive))\n        (is (true? (:yin.k/fork bf)) \"the baseline names the role\")\n        (is (empty? (:yin.k/ops bf)) \"a fork carries no operation id\")\n        (is (not (contains? bf :yin.k/occurrence)))\n        (is (not (contains? be :yin.k/fork)))\n        (is (= s/occurrence (:yin.k/occurrence be)))))))\n\n\n(deftest the-old-inspector-preserves-a-halted-results-origin\n  (doseq [engine s/engines]\n    (testing (name engine)\n      (let [t (s/toy)\n            peer (s/served-peer t)\n            fork (s/lift (s/halted-with engine (s/lit 42)) t peer)\n            exclusive (s/lift (s/halted-with engine (s/lit 42)) t peer\n                              {:yin.k/origin s/origin\n                               :yin.k/occurrence s/occurrence\n                               :yin.k/arbitration s/arbitration\n                               :yin.k/next-op-seq 3\n                               :yin.k/enrolled #{}})\n            bf (checkpoint/inspect (:address fork) (:bytes fork))\n            be (checkpoint/inspect (:address exclusive) (:bytes exclusive))]\n        (is (= :halted (:yin.k/kind bf)))\n        (is (true? (:yin.k/fork bf)))\n        (is (= :halted (:yin.k/kind be)))\n        (is (= s/origin (:yin.k/origin be)))))))\n","numLines":66,"startLine":1,"totalLines":66}},"tool_result_meta":[{"id":"toolu_01F3FCDR5XphTyxFDm1dRcHh","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016aLBb1wCKwEfBEDpMbbbEB","type":"tool_result","content":"1\t(ns yin.vm.ucf.fencing-rows-test\n2\t  \"D16-prep: the stage-D rows of linker-dht 14.2.4 that need no\n3\t   composition, through a real lift and lower and the landed fenced\n4\t   writer (D11) and recorded reader (D12) -- not through\n5\t   `yin.vm.ucf.compose`.\n6\t\n7\t   One checkpoint serves every tenure: a real gated machine parked on a\n8\t   read of a string-backed source whose continuation writes the value it\n9\t   read to the authority's enrolled target.  It is lifted once to\n10\t   row-pack bytes, offered to the real authority, and every tenure --\n11\t   first grant and each regrant -- lowers those bytes into a fresh\n12\t   machine over the toy channel, so the cursor and the write the holder\n13\t   performs are the lowered ones, reached through reflections.\n14\t\n15\t   Row 2's fencing half: an id assigned before an unknown append survives\n16\t   entering exporting -- the writer and reader append nothing there --\n17\t   and rides the successor's bytes unchanged however often the carrier\n18\t   is retried.  Row 4's fencing half: a crash before the commit, after\n19\t   it, and before the result is delivered; the regrant replays its\n20\t   durable input and retries the same id, committing once or replaying\n21\t   the stored result.  Row 5: the kept-cursor value is evicted after the\n22\t   crash; the regrant recovers with durable inputs and reproduces the old\n23\t   intent, fails closed without them, and a divergent re-read at the same\n24\t   id is an intent conflict that commits nothing.\"\n25\t  (:require [clojure.test :refer [deftest is testing]]\n26\t            [dao.jing.cbor :as cbor]\n27\t            [dao.jing.mem :as mem]\n28\t            [dao.lease :as lease]\n29\t            [dao.stream :as stream]\n30\t            [dao.stream.journal :as journal]\n31\t            [dao.stream.memory-log :as memory-log]\n32\t            [yin.vm :as vm]\n33\t            [yin.vm.engine :as engine]\n34\t            [yin.vm.ucf.authority :as authority]\n35\t            [yin.vm.ucf.authority.front :as front]\n36\t            [yin.vm.ucf.authority.grant :as grant]\n37\t            [yin.vm.ucf.custody :as custody]\n38\t            [yin.vm.ucf.rows :as rows]\n39\t            [yin.vm.ucf.rows-checkpoint-fixtures :as f]\n40\t            [yin.vm.ucf.rows-support :as rs]\n41\t            [yin.vm.ucf.holder.export :as export]\n42\t            [yin.vm.ucf.holder.reader :as reader]\n43\t            [yin.vm.ucf.holder.writer :as writer]\n44\t            [yin.vm.ucf.ledger :as ledger]\n45\t            [yin.vm.ucf.v2-support :as s]))\n46\t\n47\t\n48\t(def ^:private arb \"arb-d16\")\n49\t(def ^:private occ \"0c000000-0000-4000-8000-000000000016\")\n50\t(def ^:private successor \"0c000000-0000-4000-8000-000000000017\")\n51\t(def ^:private duration {:s 30})\n52\t\n53\t\n54\t;; =============================================================================\n55\t;; The world: a real authority, its front, one enrolled target\n56\t;; =============================================================================\n57\t\n58\t(defn- log\n59\t  []\n60\t  (:dao.stream/handle\n61\t    (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n62\t\n63\t\n64\t(defn- identity-of\n65\t  [h]\n66\t  (:dao.stream/identity (stream/descriptor h)))\n67\t\n68\t\n69\t(defn- read-all\n70\t  [h]\n71\t  (loop [c (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)) vs []]\n72\t    (let [r (stream/next h c)]\n73\t      (if (and (= :dao.stream/ok (:dao.stream/outcome r)) (< (count vs) 1000))\n74\t        (recur (:dao.stream/cursor r) (conj vs (:dao.stream/value r)))\n75\t        vs))))\n76\t\n77\t\n78\t(defn- reader-over\n79\t  \"The composition's reader over `h`, attributing it to `author`: the\n80\t   next [author record] until the tail.\"\n81\t  [h author]\n82\t  (let [c (atom (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))]\n83\t    (fn []\n84\t      (let [r (stream/next h @c)]\n85\t        (when (= :dao.stream/ok (:dao.stream/outcome r))\n86\t          (reset! c (:dao.stream/cursor r))\n87\t          [author (:dao.stream/value r)])))))\n88\t\n89\t\n90\t(defn- world\n91\t  \"An authority over fresh frames with one enrolled target, and the\n92\t   holder's front over rings, attributing its inbound to holder-a.\"\n93\t  []\n94\t  (let [frames (atom [(cbor/encode {:dao.stream.journal/header\n95\t                                    {:version 1 :identity arb}})])\n96\t        a (::authority/authority (authority/open! (journal/memory-backend\n97\t                                                    frames nil)\n98\t                                                  nil))\n99\t        store (mem/create-content-mem)\n100\t        in (s/ring 16)\n101\t        out (s/ring 16)\n102\t        i (:yin.k/target (authority/enroll! a))]\n103\t    {:a a\n104\t     :store store\n105\t     :in in\n106\t     :out out\n107\t     :target i\n108\t     :reader (authority/target-reader a i)\n109\t     :replies (reader-over out arb)\n110\t     :front (atom (front/front {:authority a\n111\t                                :inbound in\n112\t                                :reply out\n113\t                                :diagnostics (s/ring 16)\n114\t                                :resolver (fn [id _]\n115\t                                            (when (= id (identity-of in))\n116\t                                              \"holder-a\"))\n117\t                                :store store\n118\t                                :lease-media {\"holder-a\" (log)}}))}))\n119\t\n120\t\n121\t(defn- appender\n122\t  [w]\n123\t  (fn [request] (stream/append! (:in w) request)))\n124\t\n125\t\n126\t(defn- answer!\n127\t  [w]\n128\t  (swap! (:front w) front/step 8)\n129\t  w)\n130\t\n131\t\n132\t(defn- grant!\n133\t  [w lease-id]\n134\t  (stream/append! (grant/writer (:a w))\n135\t                  (lease/grant lease-id (custody/subject occ) \"holder-a\" duration\n136\t                               {:dao.lease/proposal (str \"p-\" lease-id)})))\n137\t\n138\t\n139\t(defn- reclaim!\n140\t  [w lease-id]\n141\t  (stream/append! (grant/writer (:a w)) (lease/lapsed lease-id :silence)))\n142\t\n143\t\n144\t;; =============================================================================\n145\t;; The checkpoint: lifted once, offered, lowered by every tenure\n146\t;; =============================================================================\n147\t\n148\t(defn- same-id-server\n149\t  \"The exporter's `serve!`, entering each handle under its own identity,\n150\t   so a lowered write targets the enrolled identity itself.\"\n151\t  [peer chan]\n152\t  (fn [h]\n153\t    (let [id (identity-of h)]\n154\t      (swap! (:table peer) assoc id {:handle h, :surface #{:reader :writer}})\n155\t      {:dao.stream/identity id, :dao.stream/channel chan})))\n156\t\n157\t\n158\t(defn- reading-writer\n159\t  \"A real gated machine parked on one read of `source`, whose\n160\t   continuation writes the value it read to `target`.\"\n161\t  [source target]\n162\t  (let [m0 (rs/load-ast (rs/new-machine)\n163\t                        (s/let1 'v (s/next-of (s/v 'c))\n164\t                                {:type :stream/put, :target (s/v 'w), :val (s/v 'v)}))\n165\t        [sref m1] (engine/attach-resource m0 source)\n166\t        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n167\t        [wref m3] (engine/attach-resource m2 target)]\n168\t    (vm/run (assoc m3 :store {'c cref, 'w wref} :yin.k/gate :running))))\n169\t\n170\t\n171\t(def ^:private arbitration\n172\t  {:dao.stream/identity arb\n173\t   :dao.stream/descriptor {:dao.stream/type :dao.stream/journal}})\n174\t\n175\t\n176\t(defn- checkpoint!\n177\t  \"A source holding A, the checkpoint's bytes over a fresh toy, offered\n178\t   to the world's authority.  Answers {:source :export :t :peer}.\"\n179\t  [w]\n180\t  (let [source (s/ring 8)\n181\t        _ (stream/append! source \"A\")\n182\t        t (s/toy)\n183\t        peer (s/served-peer t)\n184\t        wire (rows/lift-task\n185\t               (reading-writer source (:reader w))\n186\t               (same-id-server peer (:channel t))\n187\t               {:source-index @rs/source-index\n188\t                :header {:yin.k/occurrence occ\n189\t                         :yin.k/arbitration arbitration\n190\t                         :yin.k/next-op-seq 0\n191\t                         :yin.k/enrolled #{(:target w)}}})\n192\t        export {:status :ok :bytes (cbor/encode wire) :address (rows/pack-address wire)}]\n193\t    (grant/offer! (:a w) (:store w) (:address export) (:bytes export) \"carrier\")\n194\t    {:source source :export export :t t :peer peer}))\n195\t\n196\t\n197\t(defn- prefix\n198\t  [lease-id records]\n199\t  {:yin.k/occurrence occ\n200\t   :dao.lease/lease lease-id\n201\t   :yin.k/frontier (count records)\n202\t   :yin.k/inputs records})\n203\t\n204\t\n205\t(defn- lower\n206\t  \"The checkpoint lowered for tenure `lease-id` at `epoch` with input\n207\t   prefix `p`.  Answers [outcome attaches].\"\n208\t  [w cp lease-id epoch p]\n209\t  (let [attaches (atom 0)\n210\t        base (s/attacher (:t cp))\n211\t        attach! (fn [d] (swap! attaches inc) (base d))\n212\t        address (:address (:export cp))\n213\t        r (try\n214\t            {:vm (rows/lower-task\n215\t                   (rs/new-machine {:attach-stream attach!})\n216\t                   (cbor/decode (:bytes (:export cp))) attach!\n217\t                   {:exclusive true\n218\t                    :protection {(:target w) :enrolled\n219\t                                 (identity-of (:source cp)) :at-least-once}\n220\t                    :grant {:checkpoint address\n221\t                            :dao.lease/lease lease-id\n222\t                            :dao.lease/holder \"holder-a\"\n223\t                            :tenure {:now 10 :bound 20 :live true}\n224\t                            :evidence {:yin.k/status :yin.k/ready\n225\t                                       :yin.k/binding {:yin.k/occurrence occ\n226\t                                                       :dao.lease/lease lease-id\n227\t                                                       :dao.lease/holder \"holder-a\"\n228\t                                                       :yin.k/epoch epoch\n229\t                                                       :yin.k/transaction\n230\t                                                       {:yin.k/arbitration arb}}\n231\t                                       :yin.k/enrolled #{(:target w)}\n232\t                                       :yin.k/prefix p}}})\n233\t             :status :ok}\n234\t            (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))]\n235\t    [r @attaches]))\n236\t\n237\t\n238\t(defn- observer\n239\t  \"The composition's handle observer over reflections: the mirror is\n240\t   stepped until the source answers, so one observation is the source's\n241\t   own outcome.\"\n242\t  [peer]\n243\t  (fn [h op arg]\n244\t    (loop [n 6]\n245\t      (s/serve-mirror! peer)\n246\t      (let [r (case op\n247\t                :next (stream/next h arg)\n248\t                :cursor (stream/cursor h arg))]\n249\t        (if (and (= :dao.stream/blocked (:dao.stream/outcome r)) (pos? n))\n250\t          (recur (dec n))\n251\t          r)))))\n252\t\n253\t\n254\t(defn- read-live\n255\t  \"One recorded live read of the lowered tenure `m`: observe, record,\n256\t   settle.  Answers [machine recorded-input].\"\n257\t  [w cp m]\n258\t  (let [stepped (reader/step m (appender w) (observer (:peer cp)))\n259\t        _ (answer! w)\n260\t        drained (reader/drain (:machine stepped) (:replies w))]\n261\t    (is (= 1 (count (:applied drained))) (pr-str (dissoc drained :machine)))\n262\t    [(vm/run (:machine drained))\n263\t     (get-in (first (:appended stepped)) [:request :yin.k/input])]))\n264\t\n265\t\n266\t(defn- record-of\n267\t  \"The prefix record of the input request `input`.\"\n268\t  [input]\n269\t  {:yin.k/input-seq (:yin.k/input-seq input)\n270\t   :yin.k/source (:yin.k/source input)\n271\t   :yin.k/observed (:yin.k/observed input)})\n272\t\n273\t\n274\t(defn- write-entry\n275\t  [m]\n276\t  (first (filter #(= :put (:reason %)) (:wait-set m))))\n277\t\n278\t\n279\t;; =============================================================================\n280\t;; The appenders that cut\n281\t;; =============================================================================\n282\t\n283\t(defn- dropping\n284\t  \"Cut before the request: nothing lands; the writer learns unknown.\"\n285\t  [_w]\n286\t  (fn [_r] {:dao.stream/outcome :dao.stream/transport-error}))\n287\t\n288\t\n289\t(defn- cutting\n290\t  \"Cut after the commit: the request lands and the front answers it, but\n291\t   the writer learns only unknown.\"\n292\t  [w]\n293\t  (fn [request]\n294\t    (let [r (stream/append! (:in w) request)]\n295\t      (answer! w)\n296\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n297\t        {:dao.stream/outcome :dao.stream/transport-error}\n298\t        r))))\n299\t\n300\t\n301\t(defn- undelivered\n302\t  \"The commit and its reply both happen; the holder crashes before it\n303\t   reads the result.\"\n304\t  [w]\n305\t  (fn [request]\n306\t    (let [r (stream/append! (:in w) request)]\n307\t      (answer! w)\n308\t      r)))\n309\t\n310\t\n311\t;; =============================================================================\n312\t;; Row 4's fencing half: crashes around the commit, through the lower\n313\t;; =============================================================================\n314\t\n315\t(deftest a-regranted-lower-retries-the-same-id-and-commits-once\n316\t  (doseq [[cut appender-of second-admission]\n317\t          [[:before-commit dropping :committed]\n318\t           [:after-commit cutting :replayed]\n319\t           [:before-result undelivered :replayed]]]\n320\t    (testing (name cut)\n321\t      (let [w (world)\n322\t            cp (checkpoint! w)\n323\t            _ (grant! w \"lease-1\")\n324\t            [r1 n1] (lower w cp \"lease-1\" 0 (prefix \"lease-1\" []))\n325\t            _ (is (= :ok (:status r1)) (pr-str r1))\n326\t            _ (is (pos? n1))\n327\t            [run1 input] (read-live w cp (:vm r1))\n328\t            _ (is (= \"A\" (get-in input [:yin.k/observed :dao.stream/value]))\n329\t                  \"tenure 1 read A through the reflection and recorded it\")\n330\t            e1 (writer/emit run1 (appender-of w))\n331\t            id1 (:op-id (write-entry (:machine e1)))\n332\t            ;; the crash: tenure 1's machine is gone; the lease lapses\n333\t            _ (reclaim! w \"lease-1\")\n334\t            _ (grant! w \"lease-2\")\n335\t            [r2 _] (lower w cp \"lease-2\" 1 (prefix \"lease-2\" [(record-of input)]))\n336\t            _ (is (= :ok (:status r2)) (pr-str r2))\n337\t            replayed (reader/replay (:vm r2))\n338\t            run2 (vm/run (:machine replayed))\n339\t            e2 (writer/emit run2 (appender w))\n340\t            id2 (get-in (first (:appended e2))\n341\t                        [:request :yin.k/fenced-envelope :yin.k/op-id])\n342\t            _ (answer! w)\n343\t            d2 (writer/drain (:machine e2) (:replies w))]\n344\t        (is (= {:yin.k/occurrence occ :yin.k/seq 0} id1)\n345\t            \"tenure 1 assigned the first id of the checkpoint's counter\")\n346\t        (is (= id1 id2) \"the regrant's retry carries the same id\")\n347\t        (is (= [0] (mapv :input-seq (:applied replayed)))\n348\t            \"the regrant replayed the durable input, observing nothing live\")\n349\t        (is (= 1 (count (:appended e2))))\n350\t        (is (= 1 (get-in (first (:appended e2))\n351\t                         [:request :yin.k/fenced-envelope :yin.k/epoch]))\n352\t            \"the retry is fenced under the new binding's epoch\")\n353\t        (is (= [second-admission] (mapv :admission (:discharged d2)))\n354\t            (pr-str (dissoc d2 :machine)))\n355\t        (is (= [ledger/ok-result] (mapv :effect-result (:discharged d2)))\n356\t            \"the stored result is delivered\")\n357\t        (is (= [\"A\"] (read-all (:reader w)))\n358\t            \"one commit in total: never a duplicate side effect\")\n359\t        (is (empty? (:wait-set (:machine d2))))))))\n360\t\n361\t\n362\t;; =============================================================================\n363\t;; Row 5: an evicted kept-cursor value, recovered with inputs and without\n364\t;; =============================================================================\n365\t\n366\t(deftest an-evicted-kept-cursor-value-recovers-with-inputs-and-fails-closed-without\n367\t  (let [w (world)\n368\t        cp (checkpoint! w)\n369\t        p0 (:dao.stream/cursor (stream/cursor (:source cp) :dao.stream/oldest))\n370\t        _ (grant! w \"lease-1\")\n371\t        [r1 _] (lower w cp \"lease-1\" 0 (prefix \"lease-1\" []))\n372\t        [run1 input] (read-live w cp (:vm r1))\n373\t        e1 (writer/emit run1 (appender w))\n374\t        _ (answer! w)\n375\t        d1 (writer/drain (:machine e1) (:replies w))\n376\t        _ (is (= [:committed] (mapv :admission (:discharged d1))))\n377\t        ;; the crash, then the eviction of everything tenure 1 read\n378\t        _ (dotimes [_ 9] (stream/append! (:source cp) :junk))\n379\t        _ (is (= :dao.stream/gap\n380\t                 (:dao.stream/outcome (stream/next (:source cp) p0)))\n381\t              \"the kept position was evicted at the source\")\n382\t        _ (reclaim! w \"lease-1\")\n383\t        _ (grant! w \"lease-2\")]\n384\t    (testing \"with durable inputs, the lowered regrant reproduces the old intent\"\n385\t      (let [[r2 _] (lower w cp \"lease-2\" 1 (prefix \"lease-2\" [(record-of input)]))\n386\t            replayed (reader/replay (:vm r2))\n387\t            run2 (vm/run (:machine replayed))\n388\t            e2 (writer/emit run2 (appender w))\n389\t            _ (answer! w)\n390\t            d2 (writer/drain (:machine e2) (:replies w))]\n391\t        (is (= :ok (:status r2)) (pr-str r2))\n392\t        (is (nil? (:unmatched replayed)))\n393\t        (is (= \"A\" (:datom (write-entry run2)))\n394\t            \"replay delivered the recorded value, not the live gap\")\n395\t        (is (= [:replayed] (mapv :admission (:discharged d2)))\n396\t            \"the same id with the same intent replays the stored result\")\n397\t        (is (= [\"A\"] (read-all (:reader w))))))\n398\t    (testing \"without durable inputs, the lower fails closed\"\n399\t      (let [[r3 n3] (lower w cp \"lease-2\" 1 {:yin.k/status :suspended\n400\t                                             :yin.k/reason :unavailable})]\n401\t        (is (= :yin.k/unsatisfied (:yin.k/status r3)) (pr-str r3))\n402\t        (is (= :unavailable (:yin.k/reason r3)))\n403\t        (is (not (contains? r3 :vm)) \"no machine is restored\")\n404\t        (is (zero? n3) \"nothing is attached\")))\n405\t    (testing \"a divergent re-read at the same id is intent-conflict, no commit\"\n406\t      ;; a holder recovering without its records re-reads live and sees\n407\t      ;; the gap; the test authors that re-read on the lowered machine,\n408\t      ;; and the real authority judges the write it produces\n409\t      (let [[r4 _] (lower w cp \"lease-2\" 1 (prefix \"lease-2\" [(record-of input)]))\n410\t            m4 (:vm r4)\n411\t            entry (first (:wait-set m4))\n412\t            cell (get-in entry [:cursor-ref :id])\n413\t            handle (get (:resources m4) (:stream-id (get (:resources m4) cell)))\n414\t            gap ((observer (:peer cp)) handle :next\n415\t                                       (get-in m4 [:resources cell :cursor]))\n416\t            _ (is (= :dao.stream/gap (:dao.stream/outcome gap))\n417\t                  \"the reflection answers the source's gap\")\n418\t            run4 (vm/run (engine/apply-next m4 entry gap))\n419\t            e4 (writer/emit run4 (appender w))\n420\t            _ (answer! w)\n421\t            d4 (writer/drain (:machine e4) (:replies w))]\n422\t        (is (= {:cause :intent-conflict\n423\t                :op-id {:yin.k/occurrence occ :yin.k/seq 0}}\n424\t               (:run-end d4)))\n425\t        (is (true? (get-in (authority/projection (:a w))\n426\t                           [:occurrences occ :yin.k/quarantined]))\n427\t            \"the authoritative conflict quarantined the occurrence\")\n428\t        (is (= [\"A\"] (read-all (:reader w)))\n429\t            \"the divergent write committed nothing\")))))\n430\t\n431\t\n432\t;; =============================================================================\n433\t;; Clause 4: an id crosses park, bytes and lower on all three variants\n434\t;; =============================================================================\n435\t\n436\t(defn- recording\n437\t  \"An inbound appender whose acceptance is unknown, keeping each request.\"\n438\t  [sent]\n439\t  (fn [request]\n440\t    (swap! sent conj request)\n441\t    {:dao.stream/outcome :dao.stream/transport-error}))\n442\t\n443\t\n444\t(defn- retained-caller\n445\t  []\n446\t  (let [in (rs/one-slot-stream \"call-in\")\n447\t        out (s/ring 8)\n448\t        _ (stream/append! in :warmed)]\n449\t    (vm/run (rs/load-ast\n450\t              (rs/new-machine {:call-in in :call-out out\n451\t                               :call-out-cursor (vm/mint-oldest out :test)})\n452\t              (s/then (s/call-node :op/echo \"hello\")\n453\t                      (s/call-node :op/echo \"world\"))))))\n454\t\n455\t\n456\t(defn- retained-linker\n457\t  []\n458\t  (let [request (rs/one-slot-stream \"link-request\")\n459\t        response (s/ring 64)\n460\t        _ (stream/append! request :warmed)]\n461\t    (vm/run (rs/load-ast\n462\t              (rs/new-machine {:link-request request :link-response response})\n463\t              (s/app (s/v 'require) (s/lit 'host.the-module))))))\n464\t\n465\t\n466\t(def ^:private retained-writes\n467\t  \"[reason parked-machine-builder enrolled-identity] on the reference kernel.\"\n468\t  [[:put rs/parked-writer \"w\"]\n469\t   [:ffi-request retained-caller \"call-in\"]\n470\t   [:link-request retained-linker \"link-request\"]])\n471\t\n472\t\n473\t(defn- markers\n474\t  \"Every stream identity a pack names.\"\n475\t  [wire]\n476\t  (into #{} (keep (fn [[_ kind & slots]] (when (= :stream kind) (first slots))))\n477\t        (:yin.k/rows wire)))\n478\t\n479\t\n480\t(defn- custody-of\n481\t  [enrolled]\n482\t  {:yin.k/occurrence occ\n483\t   :dao.lease/lease \"lease-1\"\n484\t   :dao.lease/holder \"holder-a\"\n485\t   :yin.k/epoch 0\n486\t   :yin.k/arbitration arbitration\n487\t   :yin.k/next-op-seq 0\n488\t   :protection {enrolled :enrolled}\n489\t   :input {:next 0 :prefix (prefix \"lease-1\" [])}\n490\t   :tenure {:bound 100}})\n491\t\n492\t\n493\t(deftest a-carried-id-crosses-park-bytes-and-lower-and-retries-fenced\n494\t  (doseq [[reason parked enrolled] retained-writes]\n495\t    (testing (name reason)\n496\t      (let [sent (atom [])\n497\t            m (assoc (parked) :yin.k/custody (custody-of enrolled)\n498\t                     :yin.k/gate :running)\n499\t            ;; park: the writer assigns the id; its append's fate is unknown\n500\t            emitted (writer/emit m (recording sent))\n501\t            held (:machine emitted)\n502\t            id (:op-id (first (:wait-set held)))\n503\t            entered (export/enter held)\n504\t            t (s/toy)\n505\t            peer (s/served-peer t)\n506\t            header {:yin.k/occurrence successor\n507\t                    :yin.k/arbitration arbitration\n508\t                    :yin.k/next-op-seq 1\n509\t                    :yin.k/enrolled #{enrolled}\n510\t                    :yin.k/origin {:yin.k/occurrence occ\n511\t                                   :dao.lease/lease \"lease-1\"\n512\t                                   :yin.k/emitter \"holder-a\"}}\n513\t            prepared (export/prepare (:machine entered) (:record entered)\n514\t                                     (same-id-server peer (:channel t)) header @rs/source-index)\n515\t            ;; bytes\n516\t            export (export/encode (:machine entered) (:record prepared))\n517\t            body (cbor/decode (:bytes export))\n518\t            pending (f/pending-of (first (f/waits (rows/decode body))))\n519\t            classes (assoc (zipmap (markers body) (repeat :at-least-once))\n520\t                           enrolled :enrolled)\n521\t            ;; lower: the successor's first grant\n522\t            r (try\n523\t                {:status :ok\n524\t                 :vm (rows/lower-task\n525\t                       (rs/new-machine {:attach-stream (s/attacher t)})\n526\t                       body (s/attacher t)\n527\t                       {:exclusive true\n528\t                        :protection classes\n529\t                        :grant {:checkpoint (:address export)\n530\t                                :dao.lease/lease \"lease-2\"\n531\t                                :dao.lease/holder \"holder-b\"\n532\t                                :tenure {:now 10 :bound 20 :live true}\n533\t                                :evidence {:yin.k/status :yin.k/ready\n534\t                                           :yin.k/binding {:yin.k/occurrence successor\n535\t                                                           :dao.lease/lease \"lease-2\"\n536\t                                                           :dao.lease/holder \"holder-b\"\n537\t                                                           :yin.k/epoch 0\n538\t                                                           :yin.k/transaction\n539\t                                                           {:yin.k/arbitration arb}}\n540\t                                           :yin.k/enrolled #{enrolled}\n541\t                                           :yin.k/prefix {:yin.k/occurrence successor\n542\t                                                          :dao.lease/lease \"lease-2\"\n543\t                                                          :yin.k/frontier 0\n544\t                                                          :yin.k/inputs []}}}})}\n545\t                (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))\n546\t            lowered (:vm r)\n547\t            retry (writer/emit lowered (recording sent))\n548\t            [first-send resend] @sent]\n549\t        (is (= {:yin.k/occurrence occ :yin.k/seq 0} id)\n550\t            \"the writer assigned the id at the park\")\n551\t        (is (= 1 (count (:appended emitted))))\n552\t        (is (= :ok (:status export)) (pr-str export))\n553\t        (is (= reason (first (:slots pending))))\n554\t        (is (= id (nth (:slots pending) (case reason :put 3 :ffi-request 6 :link-request 7)))\n555\t            \"the id rides the bytes unchanged\")\n556\t        (is (= :ok (:status r)) (pr-str r))\n557\t        (is (= id (:op-id (first (:wait-set lowered))))\n558\t            \"the lower restores the id on the retained write\")\n559\t        (is (= 1 (get-in lowered [:yin.k/custody :yin.k/next-op-seq]))\n560\t            \"the counter is restored exactly\")\n561\t        (is (= 1 (count (:appended retry))))\n562\t        (is (= 1 (get-in (:machine retry) [:yin.k/custody :yin.k/next-op-seq]))\n563\t            \"a carried id takes no new sequence\")\n564\t        (testing \"the retry is fenced: the same id and value under the new tenure\"\n565\t          (is (= :yin.k/admit (:yin.k/request resend)))\n566\t          (is (= enrolled (:yin.k/target resend)))\n567\t          (is (= id (get-in resend [:yin.k/fenced-envelope :yin.k/op-id])))\n568\t          (is (= \"lease-2\" (get-in resend [:yin.k/fenced-envelope\n569\t                                           :yin.k/incarnation])))\n570\t          (is (= 0 (get-in resend [:yin.k/fenced-envelope :yin.k/epoch])))\n571\t          (is (= (get-in first-send [:yin.k/fenced-envelope :yin.k/value])\n572\t                 (get-in resend [:yin.k/fenced-envelope :yin.k/value]))\n573\t              \"the write itself is the one the park retained\"))))))\n574\t\n575\t\n576\t;; =============================================================================\n577\t;; Row 2's fencing half: a retained id across exporting and the carrier\n578\t;; =============================================================================\n579\t\n580\t(deftest an-id-retained-before-export-rides-the-successor-unchanged\n581\t  (let [w (world)\n582\t        cp (checkpoint! w)\n583\t        _ (grant! w \"lease-1\")\n584\t        [r1 _] (lower w cp \"lease-1\" 0 (prefix \"lease-1\" []))\n585\t        [run1 _] (read-live w cp (:vm r1))\n586\t        ;; the first append's acceptance is unknown: the id is retained\n587\t        e1 (writer/emit run1 (dropping w))\n588\t        held (:machine e1)\n589\t        id (:op-id (write-entry held))\n590\t        entered (export/enter held)\n591\t        exporting (:machine entered)\n592\t        sent (atom 0)\n593\t        counting (fn [r] (swap! sent inc) ((appender w) r))\n594\t        after-emit (writer/emit exporting counting)\n595\t        after-read (reader/step exporting counting (observer (:peer cp)))\n596\t        t2 (s/toy)\n597\t        header {:yin.k/occurrence successor\n598\t                :yin.k/arbitration arbitration\n599\t                :yin.k/next-op-seq (get-in held [:yin.k/custody :yin.k/next-op-seq])\n600\t                :yin.k/enrolled #{(:target w)}\n601\t                :yin.k/origin {:yin.k/occurrence occ\n602\t                               :dao.lease/lease \"lease-1\"\n603\t                               :yin.k/emitter \"holder-a\"}}\n604\t        prepared (export/prepare exporting (:record entered)\n605\t                                 (same-id-server (s/served-peer t2) (:channel t2))\n606\t                                 header @rs/source-index)\n607\t        ;; a failed carrier append retries from the retained record\n608\t        first-try (export/encode exporting (:record prepared))\n609\t        retry (export/encode exporting (:record prepared))\n610\t        wire (cbor/decode (:bytes first-try))\n611\t        task (rows/decode wire)\n612\t        pending (f/pending-of (first (f/waits task)))]\n613\t    (is (= {:yin.k/occurrence occ :yin.k/seq 0} id))\n614\t    (is (= 1 (:yin.k/next-op-seq header)) \"the counter moved once, past the id\")\n615\t    (is (= :ok (:status entered)) (pr-str entered))\n616\t    (testing \"exporting: neither the writer nor the reader appends\"\n617\t      (is (empty? (:appended after-emit)))\n618\t      (is (empty? (:appended after-read)))\n619\t      (is (zero? @sent))\n620\t      (is (empty? (read-all (:reader w))) \"no source effect reached the target\"))\n621\t    (testing \"the successor carries the id across every carrier retry\"\n622\t      (is (= :ok (:status prepared)) (pr-str prepared))\n623\t      (is (= :ok (:status first-try)) (pr-str first-try))\n624\t      (is (= (:address first-try) (:address retry))\n625\t          \"one record, one occurrence, equal bytes: the address is their digest\")\n626\t      (is (= successor (:yin.k/occurrence (f/custody wire))))\n627\t      (is (= :put (first (:slots pending))))\n628\t      (is (= id (nth (:slots pending) 3)) \"the retained id, unchanged\")\n629\t      (is (= 1 (:yin.k/next-op-seq (f/custody wire)))))))\n630\t"}]},"parent_tool_use_id":null,"session_id":"b306c61e-3078-4fbf-aeb8-718be5db0962","uuid":"60df5546-fcd1-4c16-8e68-c01f5ceb0c3f","timestamp":"2026-10-13T14:28:33.887Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7c/test/yin/vm/ucf/fencing_rows_test.cljc","content":"(ns yin.vm.ucf.fencing-rows-test\n  \"D16-prep: the stage-D rows of linker-dht 14.2.4 that need no\n   composition, through a real lift and lower and the landed fenced\n   writer (D11) and recorded reader (D12) -- not through\n   `yin.vm.ucf.compose`.\n\n   One checkpoint serves every tenure: a real gated machine parked on a\n   read of a string-backed source whose continuation writes the value it\n   read to the authority's enrolled target.  It is lifted once to\n   row-pack bytes, offered to the real authority, and every tenure --\n   first grant and each regrant -- lowers those bytes into a fresh\n   machine over the toy channel, so the cursor and the write the holder\n   performs are the lowered ones, reached through reflections.\n\n   Row 2's fencing half: an id assigned before an unknown append survives\n   entering exporting -- the writer and reader append nothing there --\n   and rides the successor's bytes unchanged however often the carrier\n   is retried.  Row 4's fencing half: a crash before the commit, after\n   it, and before the result is delivered; the regrant replays its\n   durable input and retries the same id, committing once or replaying\n   the stored result.  Row 5: the kept-cursor value is evicted after the\n   crash; the regrant recovers with durable inputs and reproduces the old\n   intent, fails closed without them, and a divergent re-read at the same\n   id is an intent conflict that commits nothing.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.mem :as mem]\n            [dao.lease :as lease]\n            [dao.stream :as stream]\n            [dao.stream.journal :as journal]\n            [dao.stream.memory-log :as memory-log]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ucf.authority :as authority]\n            [yin.vm.ucf.authority.front :as front]\n            [yin.vm.ucf.authority.grant :as grant]\n            [yin.vm.ucf.custody :as custody]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-checkpoint-fixtures :as f]\n            [yin.vm.ucf.rows-support :as rs]\n            [yin.vm.ucf.holder.export :as export]\n            [yin.vm.ucf.holder.reader :as reader]\n            [yin.vm.ucf.holder.writer :as writer]\n            [yin.vm.ucf.ledger :as ledger]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n(def ^:private arb \"arb-d16\")\n(def ^:private occ \"0c000000-0000-4000-8000-000000000016\")\n(def ^:private successor \"0c000000-0000-4000-8000-000000000017\")\n(def ^:private duration {:s 30})\n\n\n;; =============================================================================\n;; The world: a real authority, its front, one enrolled target\n;; =============================================================================\n\n(defn- log\n  []\n  (:dao.stream/handle\n    (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n\n\n(defn- identity-of\n  [h]\n  (:dao.stream/identity (stream/descriptor h)))\n\n\n(defn- read-all\n  [h]\n  (loop [c (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)) vs []]\n    (let [r (stream/next h c)]\n      (if (and (= :dao.stream/ok (:dao.stream/outcome r)) (< (count vs) 1000))\n        (recur (:dao.stream/cursor r) (conj vs (:dao.stream/value r)))\n        vs))))\n\n\n(defn- reader-over\n  \"The composition's reader over `h`, attributing it to `author`: the\n   next [author record] until the tail.\"\n  [h author]\n  (let [c (atom (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))]\n    (fn []\n      (let [r (stream/next h @c)]\n        (when (= :dao.stream/ok (:dao.stream/outcome r))\n          (reset! c (:dao.stream/cursor r))\n          [author (:dao.stream/value r)])))))\n\n\n(defn- world\n  \"An authority over fresh frames with one enrolled target, and the\n   holder's front over rings, attributing its inbound to holder-a.\"\n  []\n  (let [frames (atom [(cbor/encode {:dao.stream.journal/header\n                                    {:version 1 :identity arb}})])\n        a (::authority/authority (authority/open! (journal/memory-backend\n                                                    frames nil)\n                                                  nil))\n        store (mem/create-content-mem)\n        in (s/ring 16)\n        out (s/ring 16)\n        i (:yin.k/target (authority/enroll! a))]\n    {:a a\n     :store store\n     :in in\n     :out out\n     :target i\n     :reader (authority/target-reader a i)\n     :replies (reader-over out arb)\n     :front (atom (front/front {:authority a\n                                :inbound in\n                                :reply out\n                                :diagnostics (s/ring 16)\n                                :resolver (fn [id _]\n                                            (when (= id (identity-of in))\n                                              \"holder-a\"))\n                                :store store\n                                :lease-media {\"holder-a\" (log)}}))}))\n\n\n(defn- appender\n  [w]\n  (fn [request] (stream/append! (:in w) request)))\n\n\n(defn- answer!\n  [w]\n  (swap! (:front w) front/step 8)\n  w)\n\n\n(defn- grant!\n  [w lease-id]\n  (stream/append! (grant/writer (:a w))\n                  (lease/grant lease-id (custody/subject occ) \"holder-a\" duration\n                               {:dao.lease/proposal (str \"p-\" lease-id)})))\n\n\n(defn- reclaim!\n  [w lease-id]\n  (stream/append! (grant/writer (:a w)) (lease/lapsed lease-id :silence)))\n\n\n;; =============================================================================\n;; The checkpoint: lifted once, offered, lowered by every tenure\n;; =============================================================================\n\n(defn- same-id-server\n  \"The exporter's `serve!`, entering each handle under its own identity,\n   so a lowered write targets the enrolled identity itself.\"\n  [peer chan]\n  (fn [h]\n    (let [id (identity-of h)]\n      (swap! (:table peer) assoc id {:handle h, :surface #{:reader :writer}})\n      {:dao.stream/identity id, :dao.stream/channel chan})))\n\n\n(defn- reading-writer\n  \"A real gated machine parked on one read of `source`, whose\n   continuation writes the value it read to `target`.\"\n  [source target]\n  (let [m0 (rs/load-ast (rs/new-machine)\n                        (s/let1 'v (s/next-of (s/v 'c))\n                                {:type :stream/put, :target (s/v 'w), :val (s/v 'v)}))\n        [sref m1] (engine/attach-resource m0 source)\n        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n        [wref m3] (engine/attach-resource m2 target)]\n    (vm/run (assoc m3 :store {'c cref, 'w wref} :yin.k/gate :running))))\n\n\n(def ^:private arbitration\n  {:dao.stream/identity arb\n   :dao.stream/descriptor {:dao.stream/type :dao.stream/journal}})\n\n\n(defn- checkpoint!\n  \"A source holding A, the checkpoint's bytes over a fresh toy, offered\n   to the world's authority.  Answers {:source :export :t :peer}.\"\n  [w]\n  (let [source (s/ring 8)\n        _ (stream/append! source \"A\")\n        t (s/toy)\n        peer (s/served-peer t)\n        wire (rows/lift-task\n               (reading-writer source (:reader w))\n               (same-id-server peer (:channel t))\n               {:source-index @rs/source-index\n                :header {:yin.k/occurrence occ\n                         :yin.k/arbitration arbitration\n                         :yin.k/next-op-seq 0\n                         :yin.k/enrolled #{(:target w)}}})\n        export {:status :ok :bytes (cbor/encode wire) :address (rows/pack-address wire)}]\n    (grant/offer! (:a w) (:store w) (:address export) (:bytes export) \"carrier\")\n    {:source source :export export :t t :peer peer}))\n\n\n(defn- prefix\n  [lease-id records]\n  {:yin.k/occurrence occ\n   :dao.lease/lease lease-id\n   :yin.k/frontier (count records)\n   :yin.k/inputs records})\n\n\n(defn- lower\n  \"The checkpoint lowered for tenure `lease-id` at `epoch` with input\n   prefix `p`.  Answers [outcome attaches].\"\n  [w cp lease-id epoch p]\n  (let [attaches (atom 0)\n        base (s/attacher (:t cp))\n        attach! (fn [d] (swap! attaches inc) (base d))\n        address (:address (:export cp))\n        r (try\n            {:vm (rows/lower-task\n                   (rs/new-machine {:attach-stream attach!})\n                   (cbor/decode (:bytes (:export cp))) attach!\n                   {:exclusive true\n                    :protection {(:target w) :enrolled\n                                 (identity-of (:source cp)) :at-least-once}\n                    :grant {:checkpoint address\n                            :dao.lease/lease lease-id\n                            :dao.lease/holder \"holder-a\"\n                            :tenure {:now 10 :bound 20 :live true}\n                            :evidence {:yin.k/status :yin.k/ready\n                                       :yin.k/binding {:yin.k/occurrence occ\n                                                       :dao.lease/lease lease-id\n                                                       :dao.lease/holder \"holder-a\"\n                                                       :yin.k/epoch epoch\n                                                       :yin.k/transaction\n                                                       {:yin.k/arbitration arb}}\n                                       :yin.k/enrolled #{(:target w)}\n                                       :yin.k/prefix p}}})\n             :status :ok}\n            (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))]\n    [r @attaches]))\n\n\n(defn- observer\n  \"The composition's handle observer over reflections: the mirror is\n   stepped until the source answers, so one observation is the source's\n   own outcome.\"\n  [peer]\n  (fn [h op arg]\n    (loop [n 6]\n      (s/serve-mirror! peer)\n      (let [r (case op\n                :next (stream/next h arg)\n                :cursor (stream/cursor h arg))]\n        (if (and (= :dao.stream/blocked (:dao.stream/outcome r)) (pos? n))\n          (recur (dec n))\n          r)))))\n\n\n(defn- read-live\n  \"One recorded live read of the lowered tenure `m`: observe, record,\n   settle.  Answers [machine recorded-input].\"\n  [w cp m]\n  (let [stepped (reader/step m (appender w) (observer (:peer cp)))\n        _ (answer! w)\n        drained (reader/drain (:machine stepped) (:replies w))]\n    (is (= 1 (count (:applied drained))) (pr-str (dissoc drained :machine)))\n    [(vm/run (:machine drained))\n     (get-in (first (:appended stepped)) [:request :yin.k/input])]))\n\n\n(defn- record-of\n  \"The prefix record of the input request `input`.\"\n  [input]\n  {:yin.k/input-seq (:yin.k/input-seq input)\n   :yin.k/source (:yin.k/source input)\n   :yin.k/observed (:yin.k/observed input)})\n\n\n(defn- write-entry\n  [m]\n  (first (filter #(= :put (:reason %)) (:wait-set m))))\n\n\n;; =============================================================================\n;; The appenders that cut\n;; =============================================================================\n\n(defn- dropping\n  \"Cut before the request: nothing lands; the writer learns unknown.\"\n  [_w]\n  (fn [_r] {:dao.stream/outcome :dao.stream/transport-error}))\n\n\n(defn- cutting\n  \"Cut after the commit: the request lands and the front answers it, but\n   the writer learns only unknown.\"\n  [w]\n  (fn [request]\n    (let [r (stream/append! (:in w) request)]\n      (answer! w)\n      (if (= :dao.stream/ok (:dao.stream/outcome r))\n        {:dao.stream/outcome :dao.stream/transport-error}\n        r))))\n\n\n(defn- undelivered\n  \"The commit and its reply both happen; the holder crashes before it\n   reads the result.\"\n  [w]\n  (fn [request]\n    (let [r (stream/append! (:in w) request)]\n      (answer! w)\n      r)))\n\n\n;; =============================================================================\n;; Row 4's fencing half: crashes around the commit, through the lower\n;; =============================================================================\n\n(deftest a-regranted-lower-retries-the-same-id-and-commits-once\n  (doseq [[cut appender-of second-admission]\n          [[:before-commit dropping :committed]\n           [:after-commit cutting :replayed]\n           [:before-result undelivered :replayed]]]\n    (testing (name cut)\n      (let [w (world)\n            cp (checkpoint! w)\n            _ (grant! w \"lease-1\")\n            [r1 n1] (lower w cp \"lease-1\" 0 (prefix \"lease-1\" []))\n            _ (is (= :ok (:status r1)) (pr-str r1))\n            _ (is (pos? n1))\n            [run1 input] (read-live w cp (:vm r1))\n            _ (is (= \"A\" (get-in input [:yin.k/observed :dao.stream/value]))\n                  \"tenure 1 read A through the reflection and recorded it\")\n            e1 (writer/emit run1 (appender-of w))\n            id1 (:op-id (write-entry (:machine e1)))\n            ;; the crash: tenure 1's machine is gone; the lease lapses\n            _ (reclaim! w \"lease-1\")\n            _ (grant! w \"lease-2\")\n            [r2 _] (lower w cp \"lease-2\" 1 (prefix \"lease-2\" [(record-of input)]))\n            _ (is (= :ok (:status r2)) (pr-str r2))\n            replayed (reader/replay (:vm r2))\n            run2 (vm/run (:machine replayed))\n            e2 (writer/emit run2 (appender w))\n            id2 (get-in (first (:appended e2))\n                        [:request :yin.k/fenced-envelope :yin.k/op-id])\n            _ (answer! w)\n            d2 (writer/drain (:machine e2) (:replies w))]\n        (is (= {:yin.k/occurrence occ :yin.k/seq 0} id1)\n            \"tenure 1 assigned the first id of the checkpoint's counter\")\n        (is (= id1 id2) \"the regrant's retry carries the same id\")\n        (is (= [0] (mapv :input-seq (:applied replayed)))\n            \"the regrant replayed the durable input, observing nothing live\")\n        (is (= 1 (count (:appended e2))))\n        (is (= 1 (get-in (first (:appended e2))\n                         [:request :yin.k/fenced-envelope :yin.k/epoch]))\n            \"the retry is fenced under the new binding's epoch\")\n        (is (= [second-admission] (mapv :admission (:discharged d2)))\n            (pr-str (dissoc d2 :machine)))\n        (is (= [ledger/ok-result] (mapv :effect-result (:discharged d2)))\n            \"the stored result is delivered\")\n        (is (= [\"A\"] (read-all (:reader w)))\n            \"one commit in total: never a duplicate side effect\")\n        (is (empty? (:wait-set (:machine d2))))))))\n\n\n;; =============================================================================\n;; Row 5: an evicted kept-cursor value, recovered with inputs and without\n;; =============================================================================\n\n(deftest an-evicted-kept-cursor-value-recovers-with-inputs-and-fails-closed-without\n  (let [w (world)\n        cp (checkpoint! w)\n        p0 (:dao.stream/cursor (stream/cursor (:source cp) :dao.stream/oldest))\n        _ (grant! w \"lease-1\")\n        [r1 _] (lower w cp \"lease-1\" 0 (prefix \"lease-1\" []))\n        [run1 input] (read-live w cp (:vm r1))\n        e1 (writer/emit run1 (appender w))\n        _ (answer! w)\n        d1 (writer/drain (:machine e1) (:replies w))\n        _ (is (= [:committed] (mapv :admission (:discharged d1))))\n        ;; the crash, then the eviction of everything tenure 1 read\n        _ (dotimes [_ 9] (stream/append! (:source cp) :junk))\n        _ (is (= :dao.stream/gap\n                 (:dao.stream/outcome (stream/next (:source cp) p0)))\n              \"the kept position was evicted at the source\")\n        _ (reclaim! w \"lease-1\")\n        _ (grant! w \"lease-2\")]\n    (testing \"with durable inputs, the lowered regrant reproduces the old intent\"\n      (let [[r2 _] (lower w cp \"lease-2\" 1 (prefix \"lease-2\" [(record-of input)]))\n            replayed (reader/replay (:vm r2))\n            run2 (vm/run (:machine replayed))\n            e2 (writer/emit run2 (appender w))\n            _ (answer! w)\n            d2 (writer/drain (:machine e2) (:replies w))]\n        (is (= :ok (:status r2)) (pr-str r2))\n        (is (nil? (:unmatched replayed)))\n        (is (= \"A\" (:datom (write-entry run2)))\n            \"replay delivered the recorded value, not the live gap\")\n        (is (= [:replayed] (mapv :admission (:discharged d2)))\n            \"the same id with the same intent replays the stored result\")\n        (is (= [\"A\"] (read-all (:reader w))))))\n    (testing \"without durable inputs, the lower fails closed\"\n      (let [[r3 n3] (lower w cp \"lease-2\" 1 {:yin.k/status :suspended\n                                             :yin.k/reason :unavailable})]\n        (is (= :yin.k/unsatisfied (:yin.k/status r3)) (pr-str r3))\n        (is (= :unavailable (:yin.k/reason r3)))\n        (is (not (contains? r3 :vm)) \"no machine is restored\")\n        (is (zero? n3) \"nothing is attached\")))\n    (testing \"a divergent re-read at the same id is intent-conflict, no commit\"\n      ;; a holder recovering without its records re-reads live and sees\n      ;; the gap; the test authors that re-read on the lowered machine,\n      ;; and the real authority judges the write it produces\n      (let [[r4 _] (lower w cp \"lease-2\" 1 (prefix \"lease-2\" [(record-of input)]))\n            m4 (:vm r4)\n            entry (first (:wait-set m4))\n            cell (get-in entry [:cursor-ref :id])\n            handle (get (:resources m4) (:stream-id (get (:resources m4) cell)))\n            gap ((observer (:peer cp)) handle :next\n                                       (get-in m4 [:resources cell :cursor]))\n            _ (is (= :dao.stream/gap (:dao.stream/outcome gap))\n                  \"the reflection answers the source's gap\")\n            run4 (vm/run (engine/apply-next m4 entry gap))\n            e4 (writer/emit run4 (appender w))\n            _ (answer! w)\n            d4 (writer/drain (:machine e4) (:replies w))]\n        (is (= {:cause :intent-conflict\n                :op-id {:yin.k/occurrence occ :yin.k/seq 0}}\n               (:run-end d4)))\n        (is (true? (get-in (authority/projection (:a w))\n                           [:occurrences occ :yin.k/quarantined]))\n            \"the authoritative conflict quarantined the occurrence\")\n        (is (= [\"A\"] (read-all (:reader w)))\n            \"the divergent write committed nothing\")))))\n\n\n;; =============================================================================\n;; Clause 4: an id crosses park, bytes and lower on all three variants\n;; =============================================================================\n\n(defn- recording\n  \"An inbound appender whose acceptance is unknown, keeping each request.\"\n  [sent]\n  (fn [request]\n    (swap! sent conj request)\n    {:dao.stream/outcome :dao.stream/transport-error}))\n\n\n(defn- retained-caller\n  []\n  (let [in (rs/one-slot-stream \"call-in\")\n        out (s/ring 8)\n        _ (stream/append! in :warmed)]\n    (vm/run (rs/load-ast\n              (rs/new-machine {:call-in in :call-out out\n                               :call-out-cursor (vm/mint-oldest out :test)})\n              (s/then (s/call-node :op/echo \"hello\")\n                      (s/call-node :op/echo \"world\"))))))\n\n\n(defn- retained-linker\n  []\n  (let [request (rs/one-slot-stream \"link-request\")\n        response (s/ring 64)\n        _ (stream/append! request :warmed)]\n    (vm/run (rs/load-ast\n              (rs/new-machine {:link-request request :link-response response})\n              (s/app (s/v 'require) (s/lit 'host.the-module))))))\n\n\n(def ^:private retained-writes\n  \"[reason parked-machine-builder enrolled-identity] on the reference kernel.\"\n  [[:put rs/parked-writer \"w\"]\n   [:ffi-request retained-caller \"call-in\"]\n   [:link-request retained-linker \"link-request\"]])\n\n\n(defn- markers\n  \"Every stream identity a pack names.\"\n  [wire]\n  (into #{} (keep (fn [[_ kind & slots]] (when (= :stream kind) (first slots))))\n        (:yin.k/rows wire)))\n\n\n(defn- custody-of\n  [enrolled]\n  {:yin.k/occurrence occ\n   :dao.lease/lease \"lease-1\"\n   :dao.lease/holder \"holder-a\"\n   :yin.k/epoch 0\n   :yin.k/arbitration arbitration\n   :yin.k/next-op-seq 0\n   :protection {enrolled :enrolled}\n   :input {:next 0 :prefix (prefix \"lease-1\" [])}\n   :tenure {:bound 100}})\n\n\n(deftest a-carried-id-crosses-park-bytes-and-lower-and-retries-fenced\n  (doseq [[reason parked enrolled] retained-writes]\n    (testing (name reason)\n      (let [sent (atom [])\n            m (assoc (parked) :yin.k/custody (custody-of enrolled)\n                     :yin.k/gate :running)\n            ;; park: the writer assigns the id; its append's fate is unknown\n            emitted (writer/emit m (recording sent))\n            held (:machine emitted)\n            id (:op-id (first (:wait-set held)))\n            entered (export/enter held)\n            t (s/toy)\n            peer (s/served-peer t)\n            header {:yin.k/occurrence successor\n                    :yin.k/arbitration arbitration\n                    :yin.k/next-op-seq 1\n                    :yin.k/enrolled #{enrolled}\n                    :yin.k/origin {:yin.k/occurrence occ\n                                   :dao.lease/lease \"lease-1\"\n                                   :yin.k/emitter \"holder-a\"}}\n            prepared (export/prepare (:machine entered) (:record entered)\n                                     (same-id-server peer (:channel t)) header @rs/source-index)\n            ;; bytes\n            export (export/encode (:machine entered) (:record prepared))\n            body (cbor/decode (:bytes export))\n            pending (f/pending-of (first (f/waits (rows/decode body))))\n            classes (assoc (zipmap (markers body) (repeat :at-least-once))\n                           enrolled :enrolled)\n            ;; lower: the successor's first grant\n            r (try\n                {:status :ok\n                 :vm (rows/lower-task\n                       (rs/new-machine {:attach-stream (s/attacher t)})\n                       body (s/attacher t)\n                       {:exclusive true\n                        :protection classes\n                        :grant {:checkpoint (:address export)\n                                :dao.lease/lease \"lease-2\"\n                                :dao.lease/holder \"holder-b\"\n                                :tenure {:now 10 :bound 20 :live true}\n                                :evidence {:yin.k/status :yin.k/ready\n                                           :yin.k/binding {:yin.k/occurrence successor\n                                                           :dao.lease/lease \"lease-2\"\n                                                           :dao.lease/holder \"holder-b\"\n                                                           :yin.k/epoch 0\n                                                           :yin.k/transaction\n                                                           {:yin.k/arbitration arb}}\n                                           :yin.k/enrolled #{enrolled}\n                                           :yin.k/prefix {:yin.k/occurrence successor\n                                                          :dao.lease/lease \"lease-2\"\n                                                          :yin.k/frontier 0\n                                                          :yin.k/inputs []}}}})}\n                (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))\n            lowered (:vm r)\n            retry (writer/emit lowered (recording sent))\n            [first-send resend] @sent]\n        (is (= {:yin.k/occurrence occ :yin.k/seq 0} id)\n            \"the writer assigned the id at the park\")\n        (is (= 1 (count (:appended emitted))))\n        (is (= :ok (:status export)) (pr-str export))\n        (is (= reason (first (:slots pending))))\n        (is (= id (nth (:slots pending) (case reason :put 3 :ffi-request 6 :link-request 7)))\n            \"the id rides the bytes unchanged\")\n        (is (= :ok (:status r)) (pr-str r))\n        (is (= id (:op-id (first (:wait-set lowered))))\n            \"the lower restores the id on the retained write\")\n        (is (= 1 (get-in lowered [:yin.k/custody :yin.k/next-op-seq]))\n            \"the counter is restored exactly\")\n        (is (= 1 (count (:appended retry))))\n        (is (= 1 (get-in (:machine retry) [:yin.k/custody :yin.k/next-op-seq]))\n            \"a carried id takes no new sequence\")\n        (testing \"the retry is fenced: the same id and value under the new tenure\"\n          (is (= :yin.k/admit (:yin.k/request resend)))\n          (is (= enrolled (:yin.k/target resend)))\n          (is (= id (get-in resend [:yin.k/fenced-envelope :yin.k/op-id])))\n          (is (= \"lease-2\" (get-in resend [:yin.k/fenced-envelope\n                                           :yin.k/incarnation])))\n          (is (= 0 (get-in resend [:yin.k/fenced-envelope :yin.k/epoch])))\n          (is (= (get-in first-send [:yin.k/fenced-envelope :yin.k/value])\n                 (get-in resend [:yin.k/fenced-envelope :yin.k/value]))\n              \"the write itself is the one the park retained\"))))))\n\n\n;; =============================================================================\n;; Row 2's fencing half: a retained id across exporting and the carrier\n;; =============================================================================\n\n(deftest an-id-retained-before-export-rides-the-successor-unchanged\n  (let [w (world)\n        cp (checkpoint! w)\n        _ (grant! w \"lease-1\")\n        [r1 _] (lower w cp \"lease-1\" 0 (prefix \"lease-1\" []))\n        [run1 _] (read-live w cp (:vm r1))\n        ;; the first append's acceptance is unknown: the id is retained\n        e1 (writer/emit run1 (dropping w))\n        held (:machine e1)\n        id (:op-id (write-entry held))\n        entered (export/enter held)\n        exporting (:machine entered)\n        sent (atom 0)\n        counting (fn [r] (swap! sent inc) ((appender w) r))\n        after-emit (writer/emit exporting counting)\n        after-read (reader/step exporting counting (observer (:peer cp)))\n        t2 (s/toy)\n        header {:yin.k/occurrence successor\n                :yin.k/arbitration arbitration\n                :yin.k/next-op-seq (get-in held [:yin.k/custody :yin.k/next-op-seq])\n                :yin.k/enrolled #{(:target w)}\n                :yin.k/origin {:yin.k/occurrence occ\n                               :dao.lease/lease \"lease-1\"\n                               :yin.k/emitter \"holder-a\"}}\n        prepared (export/prepare exporting (:record entered)\n                                 (same-id-server (s/served-peer t2) (:channel t2))\n                                 header @rs/source-index)\n        ;; a failed carrier append retries from the retained record\n        first-try (export/encode exporting (:record prepared))\n        retry (export/encode exporting (:record prepared))\n        wire (cbor/decode (:bytes first-try))\n        task (rows/decode wire)\n        pending (f/pending-of (first (f/waits task)))]\n    (is (= {:yin.k/occurrence occ :yin.k/seq 0} id))\n    (is (= 1 (:yin.k/next-op-seq header)) \"the counter moved once, past the id\")\n    (is (= :ok (:status entered)) (pr-str entered))\n    (testing \"exporting: neither the writer nor the reader appends\"\n      (is (empty? (:appended after-emit)))\n      (is (empty? (:appended after-read)))\n      (is (zero? @sent))\n      (is (empty? (read-all (:reader w))) \"no source effect reached the target\"))\n    (testing \"the successor carries the id across every carrier retry\"\n      (is (= :ok (:status prepared)) (pr-str prepared))\n      (is (= :ok (:status first-try)) (pr-str first-try))\n      (is (= (:address first-try) (:address retry))\n          \"one record, one occurrence, equal bytes: the address is their digest\")\n      (is (= successor (:yin.k/occurrence (f/custody wire))))\n      (is (= :put (first (:slots pending))))\n      (is (= id (nth (:slots pending) 3)) \"the retained id, unchanged\")\n      (is (= 1 (:yin.k/next-op-seq (f/custody wire)))))))\n","numLines":630,"startLine":1,"totalLines":630}},"tool_result_meta":[{"id":"toolu_016aLBb1wCKwEfBEDpMbbbEB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
