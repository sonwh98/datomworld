 (select-keys config (disj (set holder-config-keys) :inbound))\n         (when-some [enroll! (:enroll! media)]\n           {:enroll! enroll!})))\n\n\n(defn- front-of\n  \"The holder's front over its media: the resolver names this holder","numLines":60,"startLine":655,"totalLines":1010}},"tool_result_meta":[{"id":"toolu_01Y2qNiuiSDkwD95YYCxr4CB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
