{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BfbTXKsf38VsxSivVydkCq","type":"tool_result","content":"1\t(ns dao.test-slow\n2\t  \"Opt-in switch for the ^:slow tests on hosts whose runner has no tag\n3\t   filter. The JVM runner excludes ^:slow itself (`bb test:clj`), so there\n4\t   `enabled?` is always true and a test runs whenever the runner selects it.\n5\t   Node and Dart have no tag filter: a slow test is registered but its body\n6\t   runs only when DATOM_SLOW_TESTS=1, otherwise it prints a skip notice.\"\n7\t  #?@(:cljd [(:require [\"dart:io\" :as dart-io])]))\n8\t\n9\t\n10\t(def env-name \"DATOM_SLOW_TESTS\")\n11\t\n12\t\n13\t(defn enabled?\n14\t  \"True when this host should run the slow tests.\"\n15\t  []\n16\t  #?(:cljd (= \"1\" (get (.-environment dart-io/Platform) env-name))\n17\t     :clj true\n18\t     :cljs (boolean (and (exists? js/process)\n19\t                         (= \"1\" (aget (.-env js/process) env-name))))))\n20\t\n21\t\n22\t(defn guard\n23\t  \"Run `thunk` when slow tests are enabled on this host, else say that\n24\t   `test-name` was skipped.\"\n25\t  [test-name thunk]\n26\t  (if (enabled?)\n27\t    (thunk)\n28\t    (println \"SKIP slow test\" test-name \"(set DATOM_SLOW_TESTS=1 to run)\")))\n29\t"}]},"parent_tool_use_id":null,"session_id":"b306c61e-3078-4fbf-aeb8-718be5db0962","uuid":"afa14aa4-412d-4c66-90ee-e373654059f4","timestamp":"2026-10-13T14:30:39.433Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7c/test/dao/test_slow.cljc","content":"(ns dao.test-slow\n  \"Opt-in switch for the ^:slow tests on hosts whose runner has no tag\n   filter. The JVM runner excludes ^:slow itself (`bb test:clj`), so there\n   `enabled?` is always true and a test runs whenever the runner selects it.\n   Node and Dart have no tag filter: a slow test is registered but its body\n   runs only when DATOM_SLOW_TESTS=1, otherwise it prints a skip notice.\"\n  #?@(:cljd [(:require [\"dart:io\" :as dart-io])]))\n\n\n(def env-name \"DATOM_SLOW_TESTS\")\n\n\n(defn enabled?\n  \"True when this host should run the slow tests.\"\n  []\n  #?(:cljd (= \"1\" (get (.-environment dart-io/Platform) env-name))\n     :clj true\n     :cljs (boolean (and (exists? js/process)\n                         (= \"1\" (aget (.-env js/process) env-name))))))\n\n\n(defn guard\n  \"Run `thunk` when slow tests are enabled on this host, else say that\n   `test-name` was skipped.\"\n  [test-name thunk]\n  (if (enabled?)\n    (thunk)\n    (println \"SKIP slow test\" test-name \"(set DATOM_SLOW_TESTS=1 to run)\")))\n","numLines":29,"startLine":1,"totalLines":29}},"tool_result_meta":[{"id":"toolu_01BfbTXKsf38VsxSivVydkCq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
