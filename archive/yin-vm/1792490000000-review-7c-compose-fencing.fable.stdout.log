f]\n  (edit-task wire #(update-in % [:slots 16] f)))\n\n\n(defn custody\n  \"The custody slot of wire's root.\"\n  [wire]\n  (nth (:slots (rows/decode wire)) 16))\n\n\n(defn waits\n  [task]\n  (nth (:slots task) 13))\n\n\n(defn with-waits\n  [task ws]\n  (assoc-in task [:slots 13] (vec ws)))\n\n\n(defn pending-of\n  [wait]\n  (second (:slots wait)))\n\n\n(defn reason-of\n  [wait]\n  (first (:slots (pending-of wait))))\n\n\n(defn wait-index\n  \"The index of task's first wait whose pending reason is reason.\"","numLines":45,"startLine":85,"totalLines":457}},"tool_result_meta":[{"id":"toolu_01Y2fsYfjcG9J9xgtTAVvpn6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
