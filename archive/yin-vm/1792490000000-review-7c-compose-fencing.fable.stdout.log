store\",\n     [\"crt\", \"drv\"]),\n    (\"R06b-test-cut-meaning-swapped\", CRT,\n     \"(do (when (= :after cut) (put! address bytes))\",\n     \"(do (when (= :before cut) (put! address bytes))\",\n     [\"crt\"]),\n    (\"R07a-compose-source-index-ignored\", COMP,\n     \":source-index (:source-index c)\",\n     \":source-index (fn [] {})\",\n     [\"ct\", \"crt\"]),\n    (\"R07b-open-source-index-check-removed\", COMP,\n     \"(check! (fn? (:source-index config))\\n          \\\"a source index: (fn [] {A #{tree-address}})\\\" {}))\",\n     \"nil)\",\n     [\"ct\", \"crt\"]),\n    (\"R08a-wrong-origin-never\", CPL,\n     \"(not (and (= o (get-in b [:yin.k/origin :yin.k/occurrence]))\\n                (= l (get-in b [:yin.k/origin :dao.lease/lease]))))\\n      :wrong-origin\\n      (= :halted (:yin.k/kind b)) nil\",\n     \"false\\n      :wrong-origin\\n      (= :halted (:yin.k/kind b)) nil\",\n     [\"crt\", \"cpl\"]),\n    (\"R08b-halted-skips-origin\", CPL,\n     \"(not (and (= o (get-in b [:yin.k/origin :yin.k/occurrence]))\\n                (= l (get-in b [:yin.k/origin :dao.lease/lease]))))\\n      :wrong-origin\\n      (= :halted (:yin.k/kind b)) nil\",\n     \"(= :halted (:yin.k/kind b)) nil\\n      (not (and (= o (get-in b [:yin.k/origin :yin.k/occurrence]))\\n                (= l (get-in b [:yin.k/origin :dao.lease/lease]))))\\n      :wrong-origin\",\n     [\"crt\", \"cpl\"]),\n    (\"R09a-fence-record-not-journaled\", DRV,\n     \"(journal! state\\n                      {:yin.k/journal :yin.k/fenced\\n                       :yin.k/occurrence (:occurrence cell)\\n                       :yin.k/address address\\n                       :yin.k/record record-address})\",\n     \"nil\",\n     [\"drv\", \"crt\"]),\n    (\"R09b-fence-without-storing\", DRV,\n     \"(if-not (and (store-object [record-address record-bytes])\\n                     (store-object [address bytes]))\",\n     \"(if-not (or true (and (store-object [record-address record-bytes])\\n                     (store-object [address bytes])))\",\n     [\"drv\", \"crt\", \"ct\"]),\n    (\"R10-q3-record-address-contains\", ROWS,\n     \"(= (jing/segment-key record) (get-in manifest [:yin.module/derivations :yin.semantic/code]))\",\n     \"(contains? manifest :yin.module/derivations)\",\n     [\"rc\"]),\n    (\"R11-lift-missing-trees-not-refused\", ROWS,\n     \"_ (when (seq missing-trees)\\n            (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing-trees}}))\",\n     \"_ (when false\\n            (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing-trees}}))\",\n     [\"ct\", \"ex\"]),\n    (\"R12-baseline-root-dropped\", CKP,\n     \"(assoc (rows/custody-baseline task) :yin.k/root (:yin.k/root wire))\",\n     \"(assoc (rows/custody-baseline task) :yin.k/root nil)\",\n     [\"crt\", \"gr\"]),\n]\n\nonly = set(sys.argv[1:])\nresults = []\nfor name, rel, old, new, nss in MUTANTS:\n    if only and name not in only:\n        continue\n    path = os.path.join(ROOT, rel)\n    backup = os.path.join(OUT, name + \".backup\")\n    shutil.copy2(path, backup)\n    src = open(path, encoding=\"utf-8\").read()\n    n = src.count(old)\n    if n != 1:\n        results.append({\"mutant\": name, \"applied\": False, \"occurrences\": n})\n        print(f\"{name}: NOT APPLIED ({n} occurrences)\", flush=True)\n        continue\n    try:\n        open(path, \"w\", encoding=\"utf-8\").write(src.replace(old, new))\n        subprocess.run([\"git\", \"diff\", \"--\", rel], cwd=ROOT,\n                       stdout=open(os.path.join(OUT, name + \".diff\"), \"w\"))\n        cmd = [\"clojure\", \"-M:test\", \"-e\", \":slow\"]\n        for k in nss:\n            cmd += [\"-n\", NS[k]]\n        with open(os.path.join(OUT, name + \".log\"), \"w\") as log:\n            r = subprocess.run(cmd, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)\n        text = open(os.path.join(OUT, name + \".log\"), encoding=\"utf-8\", errors=\"replace\").read()\n        tail = [l for l in text.splitlines() if l.startswith(\"Ran \") or l.endswith(\"errors.\")]\n        failing = sorted(set(l.split(\"(\")[1].split(\")\")[0]\n                             for l in text.splitlines()\n                             if l.startswith(\"FAIL in (\") or l.startswith(\"ERROR in (\")))\n        results.append({\"mutant\": name, \"applied\": True, \"exit\": r.returncode,\n                        \"summary\": tail, \"failing\": failing})\n        print(f\"{name}: exit={r.returncode} {tail} {failing}\", flush=True)\n    finally:\n        shutil.copy2(backup, path)\n        same = filecmp.cmp(backup, path, shallow=False)\n        clean = subprocess.run([\"git\", \"diff\", \"--quiet\", \"--\", rel], cwd=ROOT).returncode == 0\n        print(f\"  restored byte-equal={same} git-clean={clean}\", flush=True)\n        if not (same and clean):\n            results.append({\"mutant\": name, \"RESTORE_FAILED\": True})\n\njson.dump(results, open(os.path.join(OUT, \"summary.json\"), \"w\"), indent=1)\nprint(json.dumps(results, indent=1))\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01E2XPBEHvSX3sYAoVWdJ14T","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
