{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Th6sfYfw4kwZRrXLSpjz67","type":"tool_result","content":"240\t    (case op\n241\t      :next (stream/next h arg)\n242\t      :cursor (stream/cursor h arg))))\n243\t\n244\t\n245\t(defn- same-id-server\n246\t  \"The exporter's serve! over a world of fixed handles: each handle is\n247\t  entered under its own identity, so a lowered read or write targets\n248\t  the identity itself (the fencing rows' server).\"\n249\t  []\n250\t  (fn [h]\n251\t    (let [id (identity-of h)]\n252\t      {:dao.stream/identity id\n253\t       :dao.stream/channel {:dao.stream/type :dao.stream.test/channel\n254\t                            :dao.stream/identity id}})))\n255\t\n256\t\n257\t(defn- candidate-seams\n258\t  \"A candidate holder's seams over the exclusive world's program\n259\t  stream, its attaches counted by the world's own counter.\"\n260\t  [w]\n261\t  (let [p (:source-id w)\n262\t        base (attach-over {p (:prog w)})]\n263\t    {:protection {p :at-least-once}\n264\t     :receiver (s/new-machine)\n265\t     :attach! (counting-attach (:attaches w) base)\n266\t     :observe! (counting-observe (atom 0))\n267\t     :serve! (same-id-server)}))\n268\t\n269\t\n270\t;; =============================================================================\n271\t;; The rows world: an enrolled target, a reading-writer source\n272\t;; =============================================================================\n273\t\n274\t\n275\t(defn- reading-writer\n276\t  \"A real gated machine over `source`, parked on its first read: the\n277\t  value it reads is written to the enrolled `target`, then :side to\n278\t  `side`, then it halts with :done.\"\n279\t  [source target side]\n280\t  (let [m0 (s/load-ast (s/new-machine)\n281\t                       (s/let1 'v (s/next-of (s/v 'c))\n282\t                               (s/then {:type :stream/put, :target (s/v 'w),\n283\t                                        :val (s/v 'v)}\n284\t                                       (s/then {:type :stream/put,\n285\t                                                :target (s/v 'x),\n286\t                                                :val (s/lit :side)}\n287\t                                               (s/lit :done)))))\n288\t        [sref m1] (engine/attach-resource m0 source)\n289\t        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n290\t        [wref m3] (engine/attach-resource m2 target)\n291\t        [xref m4] (engine/attach-resource m3 side)]\n292\t    (vm/run (assoc m4 :store {'c cref, 'w wref, 'x xref}\n293\t                   :yin.k/gate :running))))\n294\t\n295\t\n296\t(defn- rows-config\n297\t  \"The source holder's config over the world's `table` (identity to\n298\t  handle) and `protection`: the receiver and the counting attach and\n299\t  observe seams beside the machine.\"\n300\t  [w table protection]\n301\t  {:protection protection\n302\t   :receiver (s/new-machine)\n303\t   :attach! (counting-attach (:attaches w) (attach-over table))\n304\t   :observe! (counting-observe (:observes w))\n305\t   :serve! (same-id-server)\n306\t   :machine (reading-writer (get table (:source-id w))\n307\t                            (get table (:target w))\n308\t                            (get table (:side-id w)))})\n309\t\n310\t\n311\t(defn- open-rows\n312\t  \"Open the rows world's composition over the world's stable pieces and\n313\t  `backend`.\"\n314\t  [w backend]\n315\t  (let [opened (compose/open! {:source-index (fn [] @s/source-index)\n316\t                               :mode :exclusive\n317\t                               :failure-model :process-crash\n318\t                               :backend backend\n319\t                               :duration {:s 30}\n320\t                               :renewal-interval {:s 10}\n321\t                               :store (:store w)\n322\t                               :diagnostics (:diagnostics w)\n323\t                               :medium \"compose-rows\"\n324\t                               :clock (fn [] @(:clock w))\n325\t                               :journals (:journals w)})\n326\t        c (get opened ::compose/composition)]\n327\t    (is (= :open (:yin.k/status opened)) (pr-str opened))\n328\t    c))\n329\t\n330\t\n331\t(defn rows-world\n332\t  \"An exclusive composition over a file-backed authority with one\n333\t  enrolled target and one source holder whose machine reads the source\n334\t  ring (holding \\\"A\\\" at its origin), writes the value it read to the\n335\t  enrolled target, then :side to the side log: the shape of 14.2.4\n336\t  rows 3, 4, 5 and 8.  `:inbound` overrides the source's inbound (the\n337\t  held medium the delay rows supply, a [handle sent-atom] pair);\n338\t  `:journals` overrides the substrate; `:backend` overrides the\n339\t  authority backend (the poisonable backend of row 8's first check);\n340\t  `:wrap-backend` wraps the file backend over the world's own directory\n341\t  (a cut the crash rows reopen past); `:source` overrides the source\n342\t  stream, which must already hold its origin value.\"\n343\t  [& {:keys [inbound journals backend wrap-backend source]}]\n344\t  (let [dir (ct/temp-dir)\n345\t        jroot (ct/temp-dir)\n346\t        journals (or journals (compose/file-journals jroot))\n347\t        authority-backend (or backend\n348\t                              ((or wrap-backend identity)\n349\t                               (get (file-journal/backend! dir)\n350\t                                    ::file-journal/backend)))\n351\t        source (or source\n352\t                   (doto (s2/ring 8) (stream/append! \"A\")))\n353\t        side (:dao.stream/handle\n354\t               (memory-log/create! {:dao.stream/type :dao.stream/memory-log}))\n355\t        w {:dir dir\n356\t           :jroot jroot\n357\t           :journals journals\n358\t           :backend authority-backend\n359\t           :clock (atom {:s 1})\n360\t           :store (mem/create-content-mem)\n361\t           :diagnostics (ct/log-writer)\n362\t           :attaches (atom 0)\n363\t           :observes (atom 0)\n364\t           :source source\n365\t           :side side\n366\t           :source-id (identity-of source)\n367\t           :side-id (identity-of side)}\n368\t        c (open-rows w authority-backend)\n369\t        enrolled (compose/enroll! c)\n370\t        i (:yin.k/target enrolled)\n371\t        _ (is (some? i) \"the composition enrolled the boundary target\")\n372\t        reader (compose/target-reader c i)\n373\t        table {(:source-id w) source\n374\t               i reader\n375\t               (:side-id w) side}\n376\t        protection {(:source-id w) :at-least-once\n377\t                    i :enrolled\n378\t                    (:side-id w) :at-least-once}\n379\t        ;; the world the source's config reads, its target known\n380\t        w (assoc w :target i :reader reader :table table\n381\t                 :protection protection)\n382\t        config (rows-config w table protection)\n383\t        c (compose/source c \"h1\"\n384\t                          (cond-> config\n385\t                            inbound (assoc :inbound (nth inbound 0))))]\n386\t    (assoc w\n387\t           :target i\n388\t           :reader reader\n389\t           :protection protection\n390\t           :table table\n391\t           :sent (when inbound (nth inbound 1))\n392\t           :source-config config\n393\t           :c c)))\n394\t\n395\t\n396\t(defn- rebuild-rows\n397\t  \"A fresh composition over the rows world's stable configuration --\n398\t  the same authority directory, journal substrate, store, clock and\n399\t  streams -- the reconstruction a restarted process performs.  The\n400\t  source holder is recovered by reopen at its addition (its journal\n401\t  already stands); nothing of the crashed composition survives.\"\n402\t  [w]\n403\t  (let [backend (get (file-journal/backend! (:dir w)) ::file-journal/backend)\n404\t        c (open-rows w backend)\n405\t        reader (compose/target-reader c (:target w))\n406\t        table (assoc (:table w) (:target w) reader)\n407\t        c (compose/source c \"h1\" (rows-config w table (:protection w)))]\n408\t    (assoc w :backend backend :reader reader :table table :c c)))\n409\t\n410\t\n411\t(defn- candidate-over\n412\t  \"Holder `h` added over the world's current table and the checkpoint\n413\t  `cp` -- a second candidate over the same occurrence.\"\n414\t  [w c cp h]\n415\t  (compose/holder c h (assoc (rows-config w (:table w) (:protection w))\n416\t                             :bytes (:bytes cp)\n417\t                             :address (:address cp))))\n418\t\n419\t\n420\t(defn- candidate-over-seams\n421\t  \"A candidate's config over the rows world's seams and checkpoint\n422\t  `cp` (the config `candidate-over` adds, without the holder).\"\n423\t  [w cp]\n424\t  (assoc (rows-config w (:table w) (:protection w))\n425\t         :bytes (:bytes cp)\n426\t         :address (:address cp)))\n427\t\n428\t\n429\t(defn- variant-of\n430\t  \"A second encoding of the pack at `address`: reverse its row order,\n431\t  retaining the root id and baseline while changing the pack address.\n432\t  A changed task is a conflicting baseline, because the root travels in it.\"\n433\t  [store address]\n434\t  (let [body (cbor/decode ((:get-bytes-fn store) address ::absent))\n435\t        bytes (cbor/encode (update body :yin.k/rows #(vec (reverse %))))\n436\t        v-address (keyword \"segment\"\n437\t                           (str \"blake3-\" (jing/digest-bytes :blake3 bytes)))]\n438\t    (is (not= address v-address) \"the second encoding is different bytes\")\n439\t    ((:put-bytes-fn store) v-address bytes)\n440\t    {:bytes bytes :address v-address}))\n441\t\n442\t\n443\t(defn- run-to-write\n444\t  \"Drive the rows world's source holder from its export to the moment\n445\t  its enrolled write has left the machine: running, the read recorded,\n446\t  the admit request standing in the inbound -- carried by nobody, for\n447\t  the emit rides the program half and the front reads only on the next\n448\t  control tick.  Answers the composition at that cut.\"\n449\t  [c]\n450\t  (let [c (step-until c #(= :running (get-in % [:holders \"h1\" :phase])) 60)]\n451\t    (step-until c #(seq (inbound-of % \"h1\" :yin.k/admit)) 40)))\n452\t\n453\t\n454\t(defn- admit-request\n455\t  \"The front's closed :yin.k/admit request shape, in the writer's\n456\t  envelope grammar, for the authored admissions of rows 3, 5 and 8.\"\n457\t  [rid target envelope]\n458\t  {:yin.k/request :yin.k/admit\n459\t   :yin.k/request-id rid\n460\t   :yin.k/target target\n461\t   :yin.k/fenced-envelope envelope})\n462\t\n463\t\n464\t(defn- envelope-of\n465\t  \"The fenced envelope of a write of `value` at op id `op-id` under\n466\t  `lease` at `epoch`.\"\n467\t  [lease epoch op-id value]\n468\t  {:yin.k/envelope :yin.k/fenced-v1\n469\t   :yin.k/incarnation lease\n470\t   :yin.k/epoch epoch\n471\t   :yin.k/op-id op-id\n472\t   :yin.k/value value})\n473\t\n474\t\n475\t(defn- last-admit-reply\n476\t  \"The answer of holder `h`'s latest :yin.k/admit reply.\"\n477\t  [c h]\n478\t  (-> (replies-of c h :yin.k/admit) peek :yin.k/answer))\n479\t\n480\t\n481\t(defn- admissions-of\n482\t  \"The admission family answers of holder `h`'s :yin.k/admit replies.\"\n483\t  [c h]\n484\t  (mapv (comp :yin.k/admission :yin.k/answer) (replies-of c h :yin.k/admit)))\n485\t\n486\t\n487\t;; =============================================================================\n488\t;; The row harnesses: one world, one teardown\n489\t;; =============================================================================\n490\t\n491\t\n492\t(defn- safe\n493\t  \"Run `f`, swallowing a failure: teardown must never block.\"\n494\t  [f]\n495\t  (try\n496\t    (f)\n497\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil)))\n498\t\n499\t\n500\t(defn- exclusive-row\n501\t  \"Run `f` over a fresh exclusive world (the parked-reader source of\n502\t  rows 1, 2, 6 and 7), retiring whatever stands at the end.  `make`\n503\t  builds the world (the default exclusive world; row 6 passes its own,\n504\t  over the held inbound).\"\n505\t  ([f] (exclusive-row f (fn [] (ct/exclusive-world))))\n506\t  ([f make]\n507\t   (let [w (assoc (make) :source-id \"prog-c\")]\n508\t     (try\n509\t       (f w)\n510\t       (finally\n511\t         (safe #(compose/close! (:c w)))\n512\t         (safe #(file-journal/close! (:backend w)))\n513\t         (ct/cleanup-dir! (:dir w))\n514\t         (ct/cleanup-dir! (:jroot w)))))))\n515\t\n516\t\n517\t(defn- rows-row\n518\t  \"Run `f` over an atom holding a fresh rows world, retiring whatever\n519\t  composition stands in it at the end -- the crash rows swap the atom's\n520\t  world for its rebuild.  `make` builds the world (rows-world by\n521\t  default; the delay rows pass their own).\"\n522\t  ([f] (rows-row f rows-world))\n523\t  ([f make]\n524\t   (let [w (atom (make))]\n525\t     (try\n526\t       (f w)\n527\t       (finally\n528\t         (safe #(compose/close! (:c @w)))\n529\t         (safe #(file-journal/close! (:backend @w)))\n530\t         (ct/cleanup-dir! (:dir @w))\n531\t         (ct/cleanup-dir! (:jroot @w)))))))\n532\t\n533\t\n534\t(defn- crash-rows!\n535\t  \"The rows world's process dies; the atom takes the rebuild.\"\n536\t  [w c]\n537\t  (crash! @w c)\n538\t  (reset! w (rebuild-rows @w)))\n539\t\n540\t\n541\t(defn- rebuilt-exclusive\n542\t  \"The exclusive world's reconstruction after a crash: a fresh\n543\t  composition over the same authority directory, journal substrate,\n544\t  store, clock and source config.\"\n545\t  [w]\n546\t  (ct/reopened-world (select-keys w\n547\t                                  [:dir :store :clock :journals\n548\t                                   :source-config])))\n549\t\n550\t\n551\t(defn- crash-exclusive!\n552\t  \"The process dies with the exclusive world's composition.\"\n553\t  [w c]\n554\t  (compose/close! c)\n555\t  (file-journal/close! (:backend w)))\n556\t\n557\t\n558\t;; =============================================================================\n559\t;; Row 1: two encodings of one occurrence, two candidates\n560\t;; =============================================================================\n561\t\n562\t\n563\t(deftest row-1-one-admitted-holder-over-two-encodings-test\n564\t  (exclusive-row\n565\t    (fn [w]\n566\t      (let [c0 (step-until (:c w)\n567\t                           #(seq (inbound-of % \"h1\" :yin.k/offer)) 30)\n568\t            cp (checkpoint-of c0 (:store w) \"h1\")\n569\t            _ (is (some? (:occurrence cp)) \"the source minted and fenced\")\n570\t            v (variant-of (:store w) (:address cp))\n571\t            _ (stream/append! (get-in c0 [:inbounds \"h1\"])\n572\t                              {:yin.k/request :yin.k/offer\n573\t                               :yin.k/request-id\n574\t                               [:compose-rows/variant (:occurrence cp)]\n575\t                               :yin.k/id (:address v)\n576\t                               :yin.k/bytes (:bytes v)\n577\t                               :yin.k/medium \"compose-test\"})\n578\t            c0 (compose/holder c0 \"h2\"\n579\t                               (assoc (candidate-seams w)\n580\t                                      :bytes (:bytes v)\n581\t                                      :address (:address v)))\n582\t            c (step-until c0 #(= :running (get-in % [:holders \"h1\" :phase]))\n583\t                          60)\n584\t            projection (authority/projection (:authority c))]\n585\t        (is (= #{(:address cp) (:address v)}\n586\t               (get-in projection [:occurrences (:occurrence cp)\n587\t                                   :yin.k/variants]))\n588\t            \"both encodings of the one occurrence are admitted variants\")\n589\t        (let [loser (get-in c [:holders \"h2\"])]\n590\t          (is (= :yin.k/not-holder (:status loser))\n591\t              (pr-str (select-keys loser [:phase :status :detail])))\n592\t          (is (= \"h1\" (:dao.lease/holder (:detail loser)))\n593\t              \"the refusal names the holder that won\")\n594\t          (is (nil? (:machine loser))\n595\t              \"no machine was ever exposed to the refused candidate\")\n596\t          (is (= 1 (count (distinct (map :dao.lease/proposal\n597\t                                         (inbound-of c \"h2\"\n598\t                                                     :yin.k/proposal)))))\n599\t              \"it proposes no further while the occurrence is held\")\n600\t          (is (empty? (inbound-of c \"h2\" :yin.k/release))\n601\t              \"the loser acquired nothing and released nothing\"))\n602\t        (is (= 1 (count (filter some? (map :dao.lease/lease\n603\t                                           (vals (:occurrences\n604\t                                                   projection))))))\n605\t            \"the occurrence is held by exactly one lease\")\n606\t        (reset! (:clock w) {:s 100})\n607\t        (let [c' (step-until c #(= :running (get-in % [:holders \"h2\" :phase]))\n608\t                             90)\n609\t              winner (get-in c' [:holders \"h2\"])]\n610\t          (is (= :running (:phase winner)))\n611\t          (is (= (:occurrence cp) (:occurrence winner))\n612\t              \"the second encoding holds the same occurrence\")\n613\t          (is (= 2 (count (distinct (map :dao.lease/proposal\n614\t                                         (inbound-of c' \"h2\"\n615\t                                                     :yin.k/proposal)))))\n616\t              \"the fresh step proposed a fresh id, never the answered\n617\t               one\"))))))\n618\t\n619\t\n620\t;; =============================================================================\n621\t;; Row 2: the source emits nothing until its own grant\n622\t;; =============================================================================\n623\t\n624\t\n625\t(deftest row-2-the-source-emits-nothing-until-its-own-grant-test\n626\t  (exclusive-row\n627\t    (fn [w]\n628\t      (let [c0 (loop [c (:c w) k 0]\n629\t                 (if (or (seq (inbound-of c \"h1\" :yin.k/offer)) (>= k 8))"}]},"parent_tool_use_id":null,"session_id":"b306c61e-3078-4fbf-aeb8-718be5db0962","uuid":"09fa7e1c-aae0-4043-bdb3-5f0fe39385d5","timestamp":"2026-10-13T14:28:59.215Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7c/test/yin/vm/ucf/compose_rows_test.cljc","content":"    (case op\n      :next (stream/next h arg)\n      :cursor (stream/cursor h arg))))\n\n\n(defn- same-id-server\n  \"The exporter's serve! over a world of fixed handles: each handle is\n  entered under its own identity, so a lowered read or write targets\n  the identity itself (the fencing rows' server).\"\n  []\n  (fn [h]\n    (let [id (identity-of h)]\n      {:dao.stream/identity id\n       :dao.stream/channel {:dao.stream/type :dao.stream.test/channel\n                            :dao.stream/identity id}})))\n\n\n(defn- candidate-seams\n  \"A candidate holder's seams over the exclusive world's program\n  stream, its attaches counted by the world's own counter.\"\n  [w]\n  (let [p (:source-id w)\n        base (attach-over {p (:prog w)})]\n    {:protection {p :at-least-once}\n     :receiver (s/new-machine)\n     :attach! (counting-attach (:attaches w) base)\n     :observe! (counting-observe (atom 0))\n     :serve! (same-id-server)}))\n\n\n;; =============================================================================\n;; The rows world: an enrolled target, a reading-writer source\n;; =============================================================================\n\n\n(defn- reading-writer\n  \"A real gated machine over `source`, parked on its first read: the\n  value it reads is written to the enrolled `target`, then :side to\n  `side`, then it halts with :done.\"\n  [source target side]\n  (let [m0 (s/load-ast (s/new-machine)\n                       (s/let1 'v (s/next-of (s/v 'c))\n                               (s/then {:type :stream/put, :target (s/v 'w),\n                                        :val (s/v 'v)}\n                                       (s/then {:type :stream/put,\n                                                :target (s/v 'x),\n                                                :val (s/lit :side)}\n                                               (s/lit :done)))))\n        [sref m1] (engine/attach-resource m0 source)\n        [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n        [wref m3] (engine/attach-resource m2 target)\n        [xref m4] (engine/attach-resource m3 side)]\n    (vm/run (assoc m4 :store {'c cref, 'w wref, 'x xref}\n                   :yin.k/gate :running))))\n\n\n(defn- rows-config\n  \"The source holder's config over the world's `table` (identity to\n  handle) and `protection`: the receiver and the counting attach and\n  observe seams beside the machine.\"\n  [w table protection]\n  {:protection protection\n   :receiver (s/new-machine)\n   :attach! (counting-attach (:attaches w) (attach-over table))\n   :observe! (counting-observe (:observes w))\n   :serve! (same-id-server)\n   :machine (reading-writer (get table (:source-id w))\n                            (get table (:target w))\n                            (get table (:side-id w)))})\n\n\n(defn- open-rows\n  \"Open the rows world's composition over the world's stable pieces and\n  `backend`.\"\n  [w backend]\n  (let [opened (compose/open! {:source-index (fn [] @s/source-index)\n                               :mode :exclusive\n                               :failure-model :process-crash\n                               :backend backend\n                               :duration {:s 30}\n                               :renewal-interval {:s 10}\n                               :store (:store w)\n                               :diagnostics (:diagnostics w)\n                               :medium \"compose-rows\"\n                               :clock (fn [] @(:clock w))\n                               :journals (:journals w)})\n        c (get opened ::compose/composition)]\n    (is (= :open (:yin.k/status opened)) (pr-str opened))\n    c))\n\n\n(defn rows-world\n  \"An exclusive composition over a file-backed authority with one\n  enrolled target and one source holder whose machine reads the source\n  ring (holding \\\"A\\\" at its origin), writes the value it read to the\n  enrolled target, then :side to the side log: the shape of 14.2.4\n  rows 3, 4, 5 and 8.  `:inbound` overrides the source's inbound (the\n  held medium the delay rows supply, a [handle sent-atom] pair);\n  `:journals` overrides the substrate; `:backend` overrides the\n  authority backend (the poisonable backend of row 8's first check);\n  `:wrap-backend` wraps the file backend over the world's own directory\n  (a cut the crash rows reopen past); `:source` overrides the source\n  stream, which must already hold its origin value.\"\n  [& {:keys [inbound journals backend wrap-backend source]}]\n  (let [dir (ct/temp-dir)\n        jroot (ct/temp-dir)\n        journals (or journals (compose/file-journals jroot))\n        authority-backend (or backend\n                              ((or wrap-backend identity)\n                               (get (file-journal/backend! dir)\n                                    ::file-journal/backend)))\n        source (or source\n                   (doto (s2/ring 8) (stream/append! \"A\")))\n        side (:dao.stream/handle\n               (memory-log/create! {:dao.stream/type :dao.stream/memory-log}))\n        w {:dir dir\n           :jroot jroot\n           :journals journals\n           :backend authority-backend\n           :clock (atom {:s 1})\n           :store (mem/create-content-mem)\n           :diagnostics (ct/log-writer)\n           :attaches (atom 0)\n           :observes (atom 0)\n           :source source\n           :side side\n           :source-id (identity-of source)\n           :side-id (identity-of side)}\n        c (open-rows w authority-backend)\n        enrolled (compose/enroll! c)\n        i (:yin.k/target enrolled)\n        _ (is (some? i) \"the composition enrolled the boundary target\")\n        reader (compose/target-reader c i)\n        table {(:source-id w) source\n               i reader\n               (:side-id w) side}\n        protection {(:source-id w) :at-least-once\n                    i :enrolled\n                    (:side-id w) :at-least-once}\n        ;; the world the source's config reads, its target known\n        w (assoc w :target i :reader reader :table table\n                 :protection protection)\n        config (rows-config w table protection)\n        c (compose/source c \"h1\"\n                          (cond-> config\n                            inbound (assoc :inbound (nth inbound 0))))]\n    (assoc w\n           :target i\n           :reader reader\n           :protection protection\n           :table table\n           :sent (when inbound (nth inbound 1))\n           :source-config config\n           :c c)))\n\n\n(defn- rebuild-rows\n  \"A fresh composition over the rows world's stable configuration --\n  the same authority directory, journal substrate, store, clock and\n  streams -- the reconstruction a restarted process performs.  The\n  source holder is recovered by reopen at its addition (its journal\n  already stands); nothing of the crashed composition survives.\"\n  [w]\n  (let [backend (get (file-journal/backend! (:dir w)) ::file-journal/backend)\n        c (open-rows w backend)\n        reader (compose/target-reader c (:target w))\n        table (assoc (:table w) (:target w) reader)\n        c (compose/source c \"h1\" (rows-config w table (:protection w)))]\n    (assoc w :backend backend :reader reader :table table :c c)))\n\n\n(defn- candidate-over\n  \"Holder `h` added over the world's current table and the checkpoint\n  `cp` -- a second candidate over the same occurrence.\"\n  [w c cp h]\n  (compose/holder c h (assoc (rows-config w (:table w) (:protection w))\n                             :bytes (:bytes cp)\n                             :address (:address cp))))\n\n\n(defn- candidate-over-seams\n  \"A candidate's config over the rows world's seams and checkpoint\n  `cp` (the config `candidate-over` adds, without the holder).\"\n  [w cp]\n  (assoc (rows-config w (:table w) (:protection w))\n         :bytes (:bytes cp)\n         :address (:address cp)))\n\n\n(defn- variant-of\n  \"A second encoding of the pack at `address`: reverse its row order,\n  retaining the root id and baseline while changing the pack address.\n  A changed task is a conflicting baseline, because the root travels in it.\"\n  [store address]\n  (let [body (cbor/decode ((:get-bytes-fn store) address ::absent))\n        bytes (cbor/encode (update body :yin.k/rows #(vec (reverse %))))\n        v-address (keyword \"segment\"\n                           (str \"blake3-\" (jing/digest-bytes :blake3 bytes)))]\n    (is (not= address v-address) \"the second encoding is different bytes\")\n    ((:put-bytes-fn store) v-address bytes)\n    {:bytes bytes :address v-address}))\n\n\n(defn- run-to-write\n  \"Drive the rows world's source holder from its export to the moment\n  its enrolled write has left the machine: running, the read recorded,\n  the admit request standing in the inbound -- carried by nobody, for\n  the emit rides the program half and the front reads only on the next\n  control tick.  Answers the composition at that cut.\"\n  [c]\n  (let [c (step-until c #(= :running (get-in % [:holders \"h1\" :phase])) 60)]\n    (step-until c #(seq (inbound-of % \"h1\" :yin.k/admit)) 40)))\n\n\n(defn- admit-request\n  \"The front's closed :yin.k/admit request shape, in the writer's\n  envelope grammar, for the authored admissions of rows 3, 5 and 8.\"\n  [rid target envelope]\n  {:yin.k/request :yin.k/admit\n   :yin.k/request-id rid\n   :yin.k/target target\n   :yin.k/fenced-envelope envelope})\n\n\n(defn- envelope-of\n  \"The fenced envelope of a write of `value` at op id `op-id` under\n  `lease` at `epoch`.\"\n  [lease epoch op-id value]\n  {:yin.k/envelope :yin.k/fenced-v1\n   :yin.k/incarnation lease\n   :yin.k/epoch epoch\n   :yin.k/op-id op-id\n   :yin.k/value value})\n\n\n(defn- last-admit-reply\n  \"The answer of holder `h`'s latest :yin.k/admit reply.\"\n  [c h]\n  (-> (replies-of c h :yin.k/admit) peek :yin.k/answer))\n\n\n(defn- admissions-of\n  \"The admission family answers of holder `h`'s :yin.k/admit replies.\"\n  [c h]\n  (mapv (comp :yin.k/admission :yin.k/answer) (replies-of c h :yin.k/admit)))\n\n\n;; =============================================================================\n;; The row harnesses: one world, one teardown\n;; =============================================================================\n\n\n(defn- safe\n  \"Run `f`, swallowing a failure: teardown must never block.\"\n  [f]\n  (try\n    (f)\n    (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil)))\n\n\n(defn- exclusive-row\n  \"Run `f` over a fresh exclusive world (the parked-reader source of\n  rows 1, 2, 6 and 7), retiring whatever stands at the end.  `make`\n  builds the world (the default exclusive world; row 6 passes its own,\n  over the held inbound).\"\n  ([f] (exclusive-row f (fn [] (ct/exclusive-world))))\n  ([f make]\n   (let [w (assoc (make) :source-id \"prog-c\")]\n     (try\n       (f w)\n       (finally\n         (safe #(compose/close! (:c w)))\n         (safe #(file-journal/close! (:backend w)))\n         (ct/cleanup-dir! (:dir w))\n         (ct/cleanup-dir! (:jroot w)))))))\n\n\n(defn- rows-row\n  \"Run `f` over an atom holding a fresh rows world, retiring whatever\n  composition stands in it at the end -- the crash rows swap the atom's\n  world for its rebuild.  `make` builds the world (rows-world by\n  default; the delay rows pass their own).\"\n  ([f] (rows-row f rows-world))\n  ([f make]\n   (let [w (atom (make))]\n     (try\n       (f w)\n       (finally\n         (safe #(compose/close! (:c @w)))\n         (safe #(file-journal/close! (:backend @w)))\n         (ct/cleanup-dir! (:dir @w))\n         (ct/cleanup-dir! (:jroot @w)))))))\n\n\n(defn- crash-rows!\n  \"The rows world's process dies; the atom takes the rebuild.\"\n  [w c]\n  (crash! @w c)\n  (reset! w (rebuild-rows @w)))\n\n\n(defn- rebuilt-exclusive\n  \"The exclusive world's reconstruction after a crash: a fresh\n  composition over the same authority directory, journal substrate,\n  store, clock and source config.\"\n  [w]\n  (ct/reopened-world (select-keys w\n                                  [:dir :store :clock :journals\n                                   :source-config])))\n\n\n(defn- crash-exclusive!\n  \"The process dies with the exclusive world's composition.\"\n  [w c]\n  (compose/close! c)\n  (file-journal/close! (:backend w)))\n\n\n;; =============================================================================\n;; Row 1: two encodings of one occurrence, two candidates\n;; =============================================================================\n\n\n(deftest row-1-one-admitted-holder-over-two-encodings-test\n  (exclusive-row\n    (fn [w]\n      (let [c0 (step-until (:c w)\n                           #(seq (inbound-of % \"h1\" :yin.k/offer)) 30)\n            cp (checkpoint-of c0 (:store w) \"h1\")\n            _ (is (some? (:occurrence cp)) \"the source minted and fenced\")\n            v (variant-of (:store w) (:address cp))\n            _ (stream/append! (get-in c0 [:inbounds \"h1\"])\n                              {:yin.k/request :yin.k/offer\n                               :yin.k/request-id\n                               [:compose-rows/variant (:occurrence cp)]\n                               :yin.k/id (:address v)\n                               :yin.k/bytes (:bytes v)\n                               :yin.k/medium \"compose-test\"})\n            c0 (compose/holder c0 \"h2\"\n                               (assoc (candidate-seams w)\n                                      :bytes (:bytes v)\n                                      :address (:address v)))\n            c (step-until c0 #(= :running (get-in % [:holders \"h1\" :phase]))\n                          60)\n            projection (authority/projection (:authority c))]\n        (is (= #{(:address cp) (:address v)}\n               (get-in projection [:occurrences (:occurrence cp)\n                                   :yin.k/variants]))\n            \"both encodings of the one occurrence are admitted variants\")\n        (let [loser (get-in c [:holders \"h2\"])]\n          (is (= :yin.k/not-holder (:status loser))\n              (pr-str (select-keys loser [:phase :status :detail])))\n          (is (= \"h1\" (:dao.lease/holder (:detail loser)))\n              \"the refusal names the holder that won\")\n          (is (nil? (:machine loser))\n              \"no machine was ever exposed to the refused candidate\")\n          (is (= 1 (count (distinct (map :dao.lease/proposal\n                                         (inbound-of c \"h2\"\n                                                     :yin.k/proposal)))))\n              \"it proposes no further while the occurrence is held\")\n          (is (empty? (inbound-of c \"h2\" :yin.k/release))\n              \"the loser acquired nothing and released nothing\"))\n        (is (= 1 (count (filter some? (map :dao.lease/lease\n                                           (vals (:occurrences\n                                                   projection))))))\n            \"the occurrence is held by exactly one lease\")\n        (reset! (:clock w) {:s 100})\n        (let [c' (step-until c #(= :running (get-in % [:holders \"h2\" :phase]))\n                             90)\n              winner (get-in c' [:holders \"h2\"])]\n          (is (= :running (:phase winner)))\n          (is (= (:occurrence cp) (:occurrence winner))\n              \"the second encoding holds the same occurrence\")\n          (is (= 2 (count (distinct (map :dao.lease/proposal\n                                         (inbound-of c' \"h2\"\n                                                     :yin.k/proposal)))))\n              \"the fresh step proposed a fresh id, never the answered\n               one\"))))))\n\n\n;; =============================================================================\n;; Row 2: the source emits nothing until its own grant\n;; =============================================================================\n\n\n(deftest row-2-the-source-emits-nothing-until-its-own-grant-test\n  (exclusive-row\n    (fn [w]\n      (let [c0 (loop [c (:c w) k 0]\n                 (if (or (seq (inbound-of c \"h1\" :yin.k/offer)) (>= k 8))","numLines":390,"startLine":240,"totalLines":2598}},"tool_result_meta":[{"id":"toolu_01Th6sfYfw4kwZRrXLSpjz67","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
