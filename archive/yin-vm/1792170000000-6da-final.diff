+        t (root-task wire)
+        bad (assoc-in t [:slots 18 0 :slots 1] (rows/node :completion [:install 'retired false]))
+        {:keys [attach!] n :count} (s/attacher)
+        d (error #(rows/lower-task (machine) (rows/emit bad) attach!))]
+    (is (= :blocked (slot t 2)))
+    (is (nil? (slot t 15)))
