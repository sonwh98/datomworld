+          wanted (if (= phase :running) :running :blocked)]
+      (doseq [wrong (disj #{:running :blocked :parked :halted} wanted)]
+        (let [bad (assoc-in t [:slots 12 0 :slots 4 :slots 2] wrong)
+              attaches (atom 0)
