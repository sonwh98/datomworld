         opts))\n105\t\n106\t\n107\t(defn- kernel-opts\n108\t  \"A de Bruijn kernel's options for the same composition: the full\n109\t   primitive table, and the initial environment as :free-env.\"\n110\t  [opts]\n111\t  (cond-> (assoc (dissoc (composition opts) :env) :primitives vm/primitives)\n112\t    (contains? opts :env) (assoc :free-env (:env opts))))\n113\t\n114\t\n115\t(defn machine\n116\t  ([] (machine {}))\n117\t  ([opts]\n118\t   (case *lane*\n119\t     :semantic-register (sr/create-vm (composition opts))\n120\t     :stack (dvm/create-vm [] (kernel-opts opts))\n121\t     :register (rvm/create-vm (assoc {} :bodies [] :instructions []) (kernel-opts opts)))))\n122\t\n123\t\n124\t(defn lane-of\n125\t  [m]\n126\t  (let [f (:format (module/link-format m))]\n127\t    (cond (= dvm/format-tag f) :stack\n128\t          (= rvm/format-tag f) :register\n129\t          :else :semantic-register)))\n130\t\n131\t\n132\t(def segment-of\n133\t  \"layout/segment, once per A.\"\n134\t  (memoize layout/segment))\n135\t\n136\t\n137\t(defn kernel-space\n138\t  \"The layout space of the A vectors whose images de Bruijn kernel k\n139\t   holds, among those this world projected (*projected*, when bound) or\n140\t   the file ever projected.\"\n141\t  [k]\n142\t  (let [id (if (= :stack (lane-of k)) :stack-id :register-id)\n143\t        held (into #{} (map first) (:images k))]\n144\t    (layout/space (filter #(contains? held (id %))\n145\t                          (map segment-of (vals (if *projected* @*projected* @code-index)))))))\n146\t\n147\t\n148\t(defn- kernel-load\n149\t  \"Attach v's derived image and start it at its row, beside whatever the\n150\t   kernel already holds: parked records keep naming their own rows.\"\n151\t  [k v]\n152\t  (let [kind (lane-of k)\n153\t        sg (segment-of v)\n154\t        k (if (= :stack kind)\n155\t            (dvm/attach-image k (:stack sg) vm/stack-contract)\n156\t            (rvm/attach-image k (:register sg) vm/register-contract))\n157\t        k (assoc k :pc (layout/offset kind k sg) :frames [] :continuation [] :store-of nil\n158\t                 :halted? false :blocked? false :value nil)]\n159\t    (if (= :stack kind)\n160\t      (assoc k :stack [])\n161\t      (assoc k :registers (vec (repeat (:registers (first (:bodies (:register sg)))) nil))))))\n162\t\n163\t\n164\t(defn load-program\n165\t  [m ast]\n166\t  (if (= :semantic-register (lane-of m))\n167\t    (sr/load-vector m (project ast) code/contract)\n168\t    (kernel-load m (project ast))))\n169\t\n170\t\n171\t(defn lane-closure\n172\t  \"Canonical closure payload c, its :segment an A, as machine m's value.\"\n173\t  [m c]\n174\t  (if (= :semantic-register (lane-of m))\n175\t    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))\n176\t    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))\n177\t\n178\t\n179\t(defn lift-opts\n180\t  []\n181\t  {:source-index @source-index})\n182\t\n183\t\n184\t(defn error"}]},"parent_tool_use_id":null,"session_id":"1571a1be-fcf5-41b6-a2c4-f2a5582b2e60","uuid":"4d64fa1b-50cc-4e4a-a7f7-0d4b30c1e20d","timestamp":"2026-10-12T20:04:05.443Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":";; =============================================================================\n\n(def source-index\n  \"The composition's {A #{tree-address}} (§6.1): every vector this\n   harness projects is recorded beside the address of its AST.\"\n  (atom {}))\n\n\n(def code-index\n  \"{A v}: every vector this harness projects, for the layouts' spaces.\"\n  (atom {}))\n\n\n(def ^:dynamic *projected*\n  \"When bound, an atom {A v} of the vectors one world projected: the\n   layouts' spaces read it instead of the whole file's code-index, so an\n   alpha-equivalent A an unrelated fixture projected widens no lookup.\"\n  nil)\n\n\n(defn project\n  [ast]\n  (let [v (:vector (linearize/project ast))\n        a (jing/segment-key v)]\n    (swap! source-index update a (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n    (swap! code-index assoc a v)\n    (when *projected* (swap! *projected* assoc a v))\n    v))\n\n\n(defn scoped\n  \"f's result, every vector it projects recorded in a fresh *projected*.\"\n  [f]\n  (binding [*projected* (atom {})] (f)))\n\n\n(def stream-modules (module/register-stream-module (module/default-registry)))\n\n\n(def ^:dynamic *lane*\n  \"The kernel a world is built on: :semantic-register (the reference\n   lane), or :stack or :register, which run A's derived image and lift\n   and lower through the layouts (§5.3).\"\n  :semantic-register)\n\n\n(def lanes [:semantic-register :stack :register])\n\n\n(defn- composition\n  [opts]\n  (merge {:make-stream tu/make-stream :capability-secret tu/secret\n          :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n          :modules stream-modules}\n         opts))\n\n\n(defn- kernel-opts\n  \"A de Bruijn kernel's options for the same composition: the full\n   primitive table, and the initial environment as :free-env.\"\n  [opts]\n  (cond-> (assoc (dissoc (composition opts) :env) :primitives vm/primitives)\n    (contains? opts :env) (assoc :free-env (:env opts))))\n\n\n(defn machine\n  ([] (machine {}))\n  ([opts]\n   (case *lane*\n     :semantic-register (sr/create-vm (composition opts))\n     :stack (dvm/create-vm [] (kernel-opts opts))\n     :register (rvm/create-vm (assoc {} :bodies [] :instructions []) (kernel-opts opts)))))\n\n\n(defn lane-of\n  [m]\n  (let [f (:format (module/link-format m))]\n    (cond (= dvm/format-tag f) :stack\n          (= rvm/format-tag f) :register\n          :else :semantic-register)))\n\n\n(def segment-of\n  \"layout/segment, once per A.\"\n  (memoize layout/segment))\n\n\n(defn kernel-space\n  \"The layout space of the A vectors whose images de Bruijn kernel k\n   holds, among those this world projected (*projected*, when bound) or\n   the file ever projected.\"\n  [k]\n  (let [id (if (= :stack (lane-of k)) :stack-id :register-id)\n        held (into #{} (map first) (:images k))]\n    (layout/space (filter #(contains? held (id %))\n                          (map segment-of (vals (if *projected* @*projected* @code-index)))))))\n\n\n(defn- kernel-load\n  \"Attach v's derived image and start it at its row, beside whatever the\n   kernel already holds: parked records keep naming their own rows.\"\n  [k v]\n  (let [kind (lane-of k)\n        sg (segment-of v)\n        k (if (= :stack kind)\n            (dvm/attach-image k (:stack sg) vm/stack-contract)\n            (rvm/attach-image k (:register sg) vm/register-contract))\n        k (assoc k :pc (layout/offset kind k sg) :frames [] :continuation [] :store-of nil\n                 :halted? false :blocked? false :value nil)]\n    (if (= :stack kind)\n      (assoc k :stack [])\n      (assoc k :registers (vec (repeat (:registers (first (:bodies (:register sg)))) nil))))))\n\n\n(defn load-program\n  [m ast]\n  (if (= :semantic-register (lane-of m))\n    (sr/load-vector m (project ast) code/contract)\n    (kernel-load m (project ast))))\n\n\n(defn lane-closure\n  \"Canonical closure payload c, its :segment an A, as machine m's value.\"\n  [m c]\n  (if (= :semantic-register (lane-of m))\n    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))\n    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))\n\n\n(defn lift-opts\n  []\n  {:source-index @source-index})\n\n\n(defn error","numLines":135,"startLine":50,"totalLines":1899}},"tool_result_meta":[{"id":"toolu_011F6oxCfm8JxGKpyzLEZc9N","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
