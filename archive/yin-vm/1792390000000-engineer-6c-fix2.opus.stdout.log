ails = sorted(set(re.findall(r'^(?:FAIL|ERROR) in \\((\\S+)\\)', out, re.M)))\n    print(name, '|', ' '.join(ran).replace('\\n', ' '), '|', fails, '| restored:', same,\n          '| git-diff-quiet:', 'clean' if clean == 0 else 'tracked-changes')\n"}}}
