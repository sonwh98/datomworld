ld) 1)))))\n856\t                     @memo)]\n857\t        (assoc wire :yin.k/root root :yin.k/rows rs)))))\n858\t\n859\t\n860\t(defn pairs-of\n861\t  [n]\n862\t  (mapv vec (partition 2 (:slots n))))\n863\t\n864\t\n865\t(defn rebuild\n866\t  [n f]\n867\t  (rows/node (:kind n) (mapcat identity (f (pairs-of n)))))\n868\t\n869\t\n870\t(defn lowered\n871\t  \"Lower wire into a fresh receiver: [outcome attaches].\"\n872\t  [toy wire]\n873\t  (let [{:keys [attach!] n :count} (recording-attacher toy)\n874\t        r (try (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n875\t               (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))]\n876\t    [r @n]))\n877\t\n878\t\n879\t(defn free-register\n880\t  \"A register of the act's body that is neither in its window nor its rd.\"\n881\t  [task act]\n882\t  (let [[a pc _ w _ rd] (:slots act)\n883\t        v (get (slot task 11) a)\n884\t        bodies (code/parse v)\n885\t        k (:registers (nth bodies (code/body-index bodies pc)))\n886\t        taken (into #{rd} (map first) (pairs-of w))]\n887\t    (first (remove taken (range k)))))\n888\t\n889\t\n890\t(def wait-act [13 0 0])\n891\t\n892\t\n893\t(defn tamper-cases\n894\t  []\n895\t  (let [act-of (fn [task] (get-in task [:slots 13 0 :slots 0]))]\n896\t    [[\"window with an extra live key\" 1 :window-extra\n897\t      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (conj ps [(free-register task (act-of task)) [:lit :x]])))))]\n898\t     [\"a live key removed\" 1 :window-missing\n899\t      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (rest ps))))))]\n900\t     [\"rd added\" 1 :window-self\n901\t      (fn [task]\n902\t        (update-at task (conj wait-act 3)\n903\t                   #(rebuild % (fn [ps] (conj ps [(nth (:slots (act-of task)) 5) [:lit :x]])))))]\n904\t     [\"rd replaced by another register\" 1 :destination\n905\t      (fn [task] (update-at task (conj wait-act 5) inc))]\n906\t     [\"a reason the site does not admit\" 1 :reason-mismatch\n907\t      (fn [task] (update-at task [13 0 1] (constantly (rows/node :pending [:install 'bogus]))))]\n908\t     [\"the [:lit nil] of row 22 dropped\" 22 :window-missing\n909\t      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (remove (fn [[_ v]] (= [:lit nil] v)) ps))))))]\n910\t     [\"a :reified act whose pc-1 is not a capture\" 14 :captured-site\n911\t      (fn [task]\n912\t        (let [act (act-of task)]\n913\t          (replace-nodes task #(= :reified (:kind %)) (constantly (rows/node :reified [act])))))]\n914\t     [\"a parked act whose pc-1 is not :park\" 1 :parked-site\n915\t      (fn [task] (update-at task [8] (constantly (rows/node :parked-table [:bogus (act-of task)]))))]\n916\t     [\"the root free-env row given a reserved key\" 1 :reserved-name\n917\t      (fn [task] (update-at task [5] #(rebuild % (fn [ps] (conj ps ['yin/def [:lit 1]])))))]]))\n918\t\n919\t\n920\t(defn return-site-case\n921\t  \"A return frame's pc moved after a tail call (K1); falls back to a pc\n922\t   after any non-call when no tail call has a successor in its body.\"\n923\t  [task]\n924\t  (let [kpath [13 0 0 2 0]\n925\t        kf (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0])\n926\t        [a] (:slots kf)\n927\t        v (get (slot task 11) a)\n928\t        bodies (code/parse v)\n929\t        same-body? (fn [p] (= (code/body-index bodies (dec p)) (code/body-index bodies p)))\n930\t        tail-call? (fn [t] (and (= :call (first t)) (true? (nth t 4))))\n931\t        after-tail (first (filter #(and (tail-call? (nth v (dec %))) (same-body? %)) (range 1 (count v))))\n932\t        after-other (first (filter #(and (not= :call (first (nth v (dec %)))) (same-body? %)) (range 1 (count v))))]\n933\t    [(if after-tail :after-tail-call :after-non-call)\n934\t     (update-at task (conj kpath 1) (constantly (or after-tail after-other)))]))\n935\t\n936\t"}]},"parent_tool_use_id":null,"session_id":"1571a1be-fcf5-41b6-a2c4-f2a5582b2e60","uuid":"330b2c07-3679-49d6-b66d-e0c53f7ab1c8","timestamp":"2026-10-12T20:12:04.273Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"\n;; =============================================================================\n;; Acceptance 7: refusals, before any attachment\n;; =============================================================================\n\n(defn update-at\n  [x path f]\n  (if (empty? path)\n    (f x)\n    (if (map? x)\n      (update-in x [:slots (first path)] update-at (rest path) f)\n      (update x (first path) update-at (rest path) f))))\n\n\n(defn replace-nodes\n  \"Every row node matching pred, anywhere under x, replaced by (f node).\"\n  [x pred f]\n  (cond\n    (and (map? x) (contains? x :kind) (contains? x :slots))\n    (if (pred x) (f x) (update x :slots (fn [ss] (mapv #(replace-nodes % pred f) ss))))\n    (vector? x) (mapv #(replace-nodes % pred f) x)\n    :else x))\n\n\n(defn replace-row\n  \"The wire with row id's body replaced and every ancestor rehashed,\n   without canonicalizing slots: a tamper below the abstract emitter.\"\n  [wire id body]\n  (let [index (into {} (map (fn [r] [(first r) r])) (:yin.k/rows wire))\n        memo (atom {})]\n    (letfn [(rewrite\n              [x]\n              (cond\n                (contains? index x)\n                (or (get @memo x)\n                    (let [b (mapv rewrite (if (= x id) body (subvec (get index x) 1)))\n                          nid (jing/segment-key b)]\n                      (swap! memo assoc x nid)\n                      nid))\n                (vector? x) (mapv rewrite x)\n                :else x))]\n      (let [root (rewrite (:yin.k/root wire))\n            rs (mapv (fn [[old nid]]\n                       (into [nid] (mapv rewrite (if (= old id) body (subvec (get index old) 1)))))\n                     @memo)]\n        (assoc wire :yin.k/root root :yin.k/rows rs)))))\n\n\n(defn pairs-of\n  [n]\n  (mapv vec (partition 2 (:slots n))))\n\n\n(defn rebuild\n  [n f]\n  (rows/node (:kind n) (mapcat identity (f (pairs-of n)))))\n\n\n(defn lowered\n  \"Lower wire into a fresh receiver: [outcome attaches].\"\n  [toy wire]\n  (let [{:keys [attach!] n :count} (recording-attacher toy)\n        r (try (rows/lower-task (machine {:attach-stream attach!}) wire attach!)\n               (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e)))]\n    [r @n]))\n\n\n(defn free-register\n  \"A register of the act's body that is neither in its window nor its rd.\"\n  [task act]\n  (let [[a pc _ w _ rd] (:slots act)\n        v (get (slot task 11) a)\n        bodies (code/parse v)\n        k (:registers (nth bodies (code/body-index bodies pc)))\n        taken (into #{rd} (map first) (pairs-of w))]\n    (first (remove taken (range k)))))\n\n\n(def wait-act [13 0 0])\n\n\n(defn tamper-cases\n  []\n  (let [act-of (fn [task] (get-in task [:slots 13 0 :slots 0]))]\n    [[\"window with an extra live key\" 1 :window-extra\n      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (conj ps [(free-register task (act-of task)) [:lit :x]])))))]\n     [\"a live key removed\" 1 :window-missing\n      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (rest ps))))))]\n     [\"rd added\" 1 :window-self\n      (fn [task]\n        (update-at task (conj wait-act 3)\n                   #(rebuild % (fn [ps] (conj ps [(nth (:slots (act-of task)) 5) [:lit :x]])))))]\n     [\"rd replaced by another register\" 1 :destination\n      (fn [task] (update-at task (conj wait-act 5) inc))]\n     [\"a reason the site does not admit\" 1 :reason-mismatch\n      (fn [task] (update-at task [13 0 1] (constantly (rows/node :pending [:install 'bogus]))))]\n     [\"the [:lit nil] of row 22 dropped\" 22 :window-missing\n      (fn [task] (update-at task (conj wait-act 3) #(rebuild % (fn [ps] (vec (remove (fn [[_ v]] (= [:lit nil] v)) ps))))))]\n     [\"a :reified act whose pc-1 is not a capture\" 14 :captured-site\n      (fn [task]\n        (let [act (act-of task)]\n          (replace-nodes task #(= :reified (:kind %)) (constantly (rows/node :reified [act])))))]\n     [\"a parked act whose pc-1 is not :park\" 1 :parked-site\n      (fn [task] (update-at task [8] (constantly (rows/node :parked-table [:bogus (act-of task)]))))]\n     [\"the root free-env row given a reserved key\" 1 :reserved-name\n      (fn [task] (update-at task [5] #(rebuild % (fn [ps] (conj ps ['yin/def [:lit 1]])))))]]))\n\n\n(defn return-site-case\n  \"A return frame's pc moved after a tail call (K1); falls back to a pc\n   after any non-call when no tail call has a successor in its body.\"\n  [task]\n  (let [kpath [13 0 0 2 0]\n        kf (get-in task [:slots 13 0 :slots 0 :slots 2 :slots 0])\n        [a] (:slots kf)\n        v (get (slot task 11) a)\n        bodies (code/parse v)\n        same-body? (fn [p] (= (code/body-index bodies (dec p)) (code/body-index bodies p)))\n        tail-call? (fn [t] (and (= :call (first t)) (true? (nth t 4))))\n        after-tail (first (filter #(and (tail-call? (nth v (dec %))) (same-body? %)) (range 1 (count v))))\n        after-other (first (filter #(and (not= :call (first (nth v (dec %)))) (same-body? %)) (range 1 (count v))))]\n    [(if after-tail :after-tail-call :after-non-call)\n     (update-at task (conj kpath 1) (constantly (or after-tail after-other)))]))\n\n","numLines":125,"startLine":812,"totalLines":1931}},"tool_result_meta":[{"id":"toolu_01SuhDVSm2mWobaiXwNBRzVm","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
