{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XBeVauGYm5qwfUof3ZoyJb","type":"tool_result","content":"1\t(ns yin.vm.semantic-register.layout-test\n2\t  \"Phase 6c acceptance 1-9 (docs/design/yin.vm.semantic-register-vm.continuation.md\n3\t   §8.3): the register pairing and live sets, the register destination from\n4\t   A, the stack correspondence, operand layout and K slices, E\n5\t   reconstruction, closures both ways, and the unobservable fill of a\n6\t   lowered tail. The static items run over C, the B0 corpus and the\n7\t   phase-3 corpus (derive-test's wider C requires the Python ANTLR lane);\n8\t   the dynamic items run the harness's worlds on the de Bruijn lanes.\"\n9\t  (:require [clojure.test :refer [deftest is testing]]\n10\t            [dao.stream :as stream]\n11\t            [yin.vm :as vm]\n12\t            [yin.vm.debruijn-register-code :as rcode]\n13\t            [yin.vm.debruijn.stack :as dvm]\n14\t            [yin.vm.engine :as engine]\n15\t            [yin.vm.values :as values]\n16\t            [yin.vm.semantic-register.analysis :as analysis]\n17\t            [yin.vm.semantic-register.code :as code]\n18\t            [yin.vm.semantic-register.corpus :as corpus]\n19\t            [yin.vm.semantic-register.layout :as layout]\n20\t            [yin.vm.semantic-register.linearize :as linearize]\n21\t            [yin.vm.semantic-register.safepoint-harness-test :as h]\n22\t            [yin.vm.ucf.v2-support :as s]))\n23\t\n24\t\n25\t(def C\n26\t  \"[label ast]: the harness's layout corpus.\"\n27\t  h/layout-corpus)\n28\t\n29\t\n30\t(defn projected\n31\t  [ast]\n32\t  (:vector (linearize/project ast)))\n33\t\n34\t\n35\t(defn reachable-pcs\n36\t  \"Every pc reachable from its body's start.\"\n37\t  [v]\n38\t  (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v)))\n39\t\n40\t\n41\t(defn boundary?\n42\t  [t]\n43\t  (contains? rcode/boundary-opcodes (nth t 0)))\n44\t\n45\t\n46\t(defn parking?\n47\t  \"A non-tail parking instruction (rule A1).\"\n48\t  [t]\n49\t  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n50\t      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n51\t\n52\t\n53\t;; =============================================================================\n54\t;; 1-2: the register kernel's static layout\n55\t;; =============================================================================\n56\t\n57\t(deftest register-pairing\n58\t  (let [checked (atom [0 0])]\n59\t    (doseq [[label ast] C]\n60\t      (testing (str label)\n61\t        (let [v (projected ast)\n62\t              sg (layout/segment v)\n63\t              bodies (:bodies sg)]\n64\t          ;; phys is total on every body's named virtuals and single-valued\n65\t          (doseq [[pc x s] (:pairs sg)]\n66\t            (is (= s (layout/phys sg pc x)) (str \"pc \" pc \" virtual \" x)))\n67\t          (doseq [b (range (count bodies))]\n68\t            (let [named (into #{} (keep (fn [[pc x]] (when (= b (code/body-index bodies pc)) x))) (:pairs sg))]\n69\t              (is (= named (set (keys (nth (:phys sg) b)))))))\n70\t          ;; virt is single-valued on live-out's physical image\n71\t          (doseq [p (sort (reachable-pcs v))\n72\t                  :when (boundary? (nth v p))]\n73\t            (let [lo (layout/live-out sg p)]\n74\t              (is (= (count lo) (count (set (map #(layout/phys sg p %) lo))))\n75\t                  (str \"distinct live virtuals hold distinct slots at pc \" p))\n76\t              (doseq [x lo]\n77\t                (is (= x (layout/virt sg p (layout/phys sg p x))))))\n78\t            (swap! checked update 1 inc))\n79\t          (swap! checked update 0 inc))))\n80\t    (is (= (count C) (first @checked)))\n81\t    (is (< 50 (second @checked)) \"reachable boundaries checked\")))\n82\t\n83\t\n84\t(deftest register-live-is-live-out\n85\t  (let [tails (atom 0)]\n86\t    (doseq [[label ast] C]\n87\t      (testing (str label)\n88\t        (let [v (projected ast)\n89\t              sg (layout/segment v)]\n90\t          (doseq [p (sort (reachable-pcs v))\n91\t                  :let [t (nth v p)]\n92\t                  :when (boundary? t)]\n93\t            (let [live (nth (nth (:instructions (:register sg)) p) (rcode/live-slot-index (nth t 0)))]\n94\t              (is (= (layout/register-live sg p) live) (str \"pc \" p))\n95\t              (when (code/tail-call? t)\n96\t                (swap! tails inc)\n97\t                (is (= [] live (layout/register-live sg p)) \"a tail boundary's live is []\")))))))\n98\t    (is (pos? @tails))))\n99\t\n100\t\n101\t;; =============================================================================\n102\t;; 3: rd from A, never the physical destination\n103\t;; =============================================================================\n104\t\n105\t(def worked-ast (second (first (filter #(= :worked-example (first %)) corpus/programs))))\n106\t\n107\t\n108\t(defn lifted-waits\n109\t  \"The canonical wait entries of world machine m: the evaluator's own, or a\n110\t   de Bruijn kernel's through the layout.\"\n111\t  [m]\n112\t  (if (= :semantic-register (h/lane-of m))\n113\t    (:wait-set m)\n114\t    (:wait-set (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))\n115\t\n116\t\n117\t(deftest register-rd-from-a\n118\t  (testing \"the worked example parked at its inner call\"\n119\t    (let [m0 (h/on-lane :register h/machine)\n120\t          [sref m1] (engine/attach-resource m0 (s/ring 4))\n121\t          [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n122\t          next! (engine/resolve-var {} {} vm/primitives h/stream-modules 'stream/next!)\n123\t          m (vm/run (h/load-program (assoc m2 :free-env {'f (get vm/primitives 'conj) 'g next! 'x cref 'y 2})\n124\t                                    worked-ast))\n125\t          entry (first (:wait-set m))\n126\t          [p] (lifted-waits m)\n127\t          v (projected worked-ast)]\n128\t      (is (vm/blocked? m))\n129\t      (is (= [:call 2 3 [4] false] (nth v 3)) \"the inner call\")\n130\t      (is (= 4 (:pc p)))\n131\t      (is (= {:deliver :rd :rd 2} (:deliver p)) \"the canonical rd is A's 2\")\n132\t      (is (= 3 (:dest entry)) \"the kernel's dest is the physical 3\")\n133\t      (is (= #{1} (set (keys (:window p)))) \"saved(4, 2)\")))\n134\t  (testing \"the K frames of :depth-3 take rd from A\"\n135\t    (let [[_ wrap] (nth h/segments 2)\n136\t          build #(h/reader wrap h/read-op)\n137\t          reference (first (:wait-set (:machine (h/on-lane :semantic-register build))))\n138\t          m (:machine (h/on-lane :register build))\n139\t          entry (first (:wait-set m))\n140\t          [p] (lifted-waits m)]\n141\t      (is (= :depth-3 (first (nth h/segments 2))))\n142\t      (is (= 6 (count (:k p))) \"three bindings, three nest applications\")\n143\t      (is (= (mapv :rd (:k reference)) (mapv :rd (:k p))) \"the evaluator's return destinations\")\n144\t      (is (some (fn [[f kf]] (not= (:rd f) (:dest kf))) (map vector (:k p) (:continuation entry)))\n145\t          \"some physical dest differs from its virtual rd\"))))\n146\t\n147\t\n148\t;; =============================================================================\n149\t;; 4-5: the stack correspondence and operand layout\n150\t;; =============================================================================\n151\t\n152\t(defn family\n153\t  [op]\n154\t  (case op (:load-bound :load-free) :var op))\n155\t\n156\t\n157\t(deftest stack-correspondence\n158\t  (doseq [[label ast] C]\n159\t    (testing (str label)\n160\t      (let [v (projected ast)\n161\t            sg (layout/segment v)\n162\t            h (:stack sg)]\n163\t        (is (= (count v) (count (:a->h sg))) \"one non-push H instruction per A pc\")\n164\t        (is (= (count h) (+ (count v) (count (filter #(= :push (first %)) h)))))\n165\t        (doseq [k (range (count v))]\n166\t          (is (= (nth (nth v k) 0) (family (nth (nth h (nth (:a->h sg) k)) 0)))\n167\t              (str \"the k-th non-push instruction, k = \" k))\n168\t          (is (= k (get (:h->a sg) (nth (:a->h sg) k)))))))))\n169\t\n170\t\n171\t(deftest stack-layout-is-the-saved-set\n172\t  (let [checked (atom 0)]\n173\t    (doseq [[label ast] C]\n174\t      (testing (str label)\n175\t        (let [v (projected ast)\n176\t              sg (layout/segment v)\n177\t              a (:analysis sg)]\n178\t          (doseq [p (sort (reachable-pcs v))\n179\t                  :let [t (nth v p)]\n180\t                  :when (parking? t)]\n181\t            (is (= (analysis/saved a (inc p) (code/rd t)) (set (layout/stack-layout sg p))) (str \"pc \" p))\n182\t            (is (apply distinct? (cons ::bottom (layout/stack-layout sg p))))\n183\t            (swap! checked inc)))))\n184\t    (is (< 20 @checked)))\n185\t  (testing \"the worked cases\"\n186\t    (let [first-call (fn [v] (first (keep-indexed (fn [pc t] (when (= :call (first t)) pc)) v)))]\n187\t      (doseq [ast [worked-ast\n188\t                   (corpus/app (corpus/v 'f) (corpus/if-node (corpus/v 'c) (corpus/app (corpus/v 'g)) (corpus/lit 2))\n189\t                               (corpus/v 'y))]]\n190\t        (let [v (projected ast)\n191\t              sg (layout/segment v)]\n192\t          (is (= [1] (layout/stack-layout sg (first-call v))) \"[f], f in register 1\"))))))\n193\t\n194\t\n195\t;; =============================================================================\n196\t;; 6: K slices partition the operand stack\n197\t;; =============================================================================\n198\t\n199\t(defn stack-frames\n200\t  \"[[A-pc slice] …] for return frames then the current activation of\n201\t   stack entry e of kernel k, reading the kernel's own offset table.\"\n202\t  [k e]\n203\t  (let [sp (h/kernel-space k)\n204\t        a-pc (fn [abs]\n205\t               (let [[ident rel] (dvm/image-pc k abs)\n206\t                     sg (some #(when (= ident (:stack-id %)) %) (vals (:segments sp)))]\n207\t                 [sg (inc (get (:h->a sg) (dec rel)))]))\n208\t        parts (layout/slices (vec (:stack e)) (mapv :stack-base (:continuation e)))]\n209\t    (mapv (fn [abs slice] (conj (a-pc abs) slice))\n210\t          (conj (mapv :return-pc (:continuation e)) (:pc e))\n211\t          parts)))\n212\t\n213\t\n214\t(defn non-tail?\n215\t  \"6c-pre marks a tail call's park :return-result.\"\n216\t  [e]\n217\t  (not= :return-result (:resume-mode e)))\n218\t\n219\t\n220\t(deftest stack-slices-partition\n221\t  (let [checked (atom 0)]\n222\t    (doseq [[row label _ build] (h/lane-cases)\n223\t            :when (contains? #{:bare :depth-3 :unwrapped} label)]\n224\t      (testing (str \"row \" row \" \" (name label))\n225\t        (let [k (:machine (h/on-lane :stack build))]\n226\t          (doseq [e (concat (:wait-set k) (vals (:parked k)))\n227\t                  :when (non-tail? e)]\n228\t            (let [frames (stack-frames k e)]\n229\t              (is (= (vec (:stack e)) (into [] (mapcat #(nth % 2)) frames)) \"the slices partition the stack\")\n230\t              (doseq [[sg pc slice] frames]\n231\t                (is (= (count (layout/stack-layout sg (dec pc))) (count slice))))\n232\t              (swap! checked inc))))))\n233\t    (is (< 20 @checked)))\n234\t  (testing \"the multi-frame fixture\"\n235\t    (let [expr (h/cat-of (s/lit [1])\n236\t                         (s/app (s/lam ['x] (h/cat-of (s/lit [2])\n237\t                                                      (s/app (s/lam ['y] (h/cat-of (s/lit [3]) h/read-op))\n238\t                                                             (s/lit 2))))\n239\t                                (s/lit 1)))\n240\t          world (h/on-lane :stack #(h/reader identity expr))\n241\t          k (:machine world)\n242\t          e (first (:wait-set k))\n243\t          st (:stack e)]\n244\t      (is (= [0 0 0 2 4] (mapv :stack-base (:continuation e))) \"the bases, pinned from the kernel\")\n245\t      (is (= 6 (count st)))\n246\t      (is (= [[] [] [] 2 2 2] (mapv #(if (empty? %) [] (count %)) (layout/slices (vec st) [0 0 0 2 4]))))\n247\t      (is (= [[1] [2] [3]] (mapv #(nth st %) [1 3 5])) \"each slice holds its activation's cat and literal\")\n248\t      (is (every? values/closure? (map #(nth st %) [0 2 4])))\n249\t      (is (= (vec st) (into [] cat (layout/slices (vec st) [0 0 0 2 4]))))\n250\t      (let [sp (h/kernel-space k)\n251\t            p (layout/lift-state (layout/lift-context k sp (:owner k)) e)\n252\t            fresh (layout/attach-space (h/on-lane :stack h/machine) sp)\n253\t            lowered (layout/lower-state (layout/lower-context fresh sp) p)]\n254\t        (is (= 5 (count (:k p))))\n255\t        (is (= [0 0 0 2 4] (mapv :stack-base (:continuation lowered))) \"the lowering emits the same bases\")\n256\t        (is (= 6 (count (:stack lowered))))\n257\t        (is (= (h/normalize (:stack e)) (h/normalize (:stack lowered))))\n258\t        (stream/append! (s/stream-of k) \"B\")\n259\t        (is (= [1 [2 [3 \"B\"]]] (h/normalize (vm/value (h/drive-local (assoc fresh :wait-set [lowered] :blocked? true\n260\t                                                                            :halted? false :value :yin/blocked\n261\t                                                                            :resources (:resources k))))))\n262\t            \"and it continues\")))))\n263\t\n264\t\n265\t;; =============================================================================\n266\t;; 7: E reconstruction\n267\t;; =============================================================================\n268\t\n269\t(def env-programs\n270\t  \"The B2 duplicate-parameter, nested-closure and nested-lambdas shapes,\n271\t   each blocked on a read inside its innermost body.\"\n272\t  (let [read-into (fn [& xs] (reduce (fn [acc x] (h/cat-of acc x)) (s/lit []) (concat xs [h/read-op])))]\n273\t    [[:duplicate-param (s/app (s/lam ['x 'x] (read-into (s/v 'x))) (s/lit 1) (s/lit 2)) [2 \"B\"]]\n274\t     [:nested-closure (s/app (s/app (s/lam ['a 'a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n275\t      [nil 2 \"B\"]]\n276\t     [:nested-lambdas (s/app (s/app (s/lam ['a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n277\t      [1 2 \"B\"]]]))\n278\t\n279\t\n280\t(defn envs\n281\t  \"Every E of a machine's canonical waits and parked records, outermost\n282\t   K frame first, values normalised.\"\n283\t  [m]\n284\t  (let [waits (lifted-waits m)\n285\t        parked (if (= :semantic-register (h/lane-of m))\n286\t                 (vals (:parked m))\n287\t                 (vals (:parked (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))]\n288\t    (h/normalize (mapv (fn [p] (conj (mapv :env (:k p)) (:env p))) (concat waits (sort-by :id parked))))))\n289\t\n290\t\n291\t(deftest env-reconstruction\n292\t  (let [checked (atom 0)\n293\t        cases (into (mapv (fn [[row label _ build]] [(str \"row \" row \" \" (name label)) build]) (h/lane-cases))\n294\t                    (map (fn [[label ast]] [(name label) #(h/reader identity ast)]))\n295\t                    env-programs)]\n296\t    (doseq [[label build] cases]\n297\t      (testing label\n298\t        (let [expected (envs (:machine (h/on-lane :semantic-register build)))]\n299\t          (doseq [lane [:stack :register]]\n300\t            (is (= expected (envs (:machine (h/on-lane lane build)))) (str (name lane) \"'s E is the evaluator's\"))\n301\t            (swap! checked inc)))))\n302\t    (is (= (* 2 (+ 61 3)) @checked)))\n303\t  (testing \"row 21: the read's E binds x to 1, the free environment keeps 99\"\n304\t    (let [build #(h/free-env-world identity {'x 99})]\n305\t      (doseq [lane h/lanes]\n306\t        (let [m (:machine (h/on-lane lane build))\n307\t              [p] (lifted-waits m)]\n308\t          (is (= 1 (get-in p [:env 'x])))\n309\t          (is (= {'x 99} (:free-env m)))))))\n310\t  (testing \"the env programs answer\"\n311\t    (doseq [[label ast expected] env-programs\n312\t            lane h/lanes]\n313\t      (is (= expected (:value (h/reference (h/on-lane lane #(h/reader identity ast))))) (str label \" \" lane)))))\n314\t\n315\t\n316\t;; =============================================================================\n317\t;; 8: closures, canonical and positional, both ways\n318\t;; =============================================================================\n319\t\n320\t(def closure-programs\n321\t  \"\\\"closure value\\\", \\\"higher order\\\" (its closure held across a read)\n322\t   and :duplicate-param, as halted values or lexical bindings.\"\n323\t  [[:closure-value (s/lam ['x] (s/v 'x))]\n324\t   [:higher-order (s/app (s/lam ['f] (h/cat-of (s/app (s/v 'f) (s/lit 5)) h/read-op)) (s/lam ['x] (s/v 'x)))]\n325\t   [:duplicate-param (s/app (s/lam ['x 'x] (s/lam ['y] (s/v 'x))) (s/lit 1) (s/lit 2))]])\n326\t\n327\t\n328\t(defn closures-in\n329\t  [x]\n330\t  (cond\n331\t    (values/closure? x) [x]\n332\t    (map? x) (mapcat closures-in (concat (keys x) (vals x)))\n333\t    (coll? x) (mapcat closures-in x)\n334\t    :else nil))\n335\t\n336\t\n337\t(defn kernel-closures\n338\t  \"Every positional closure of de Bruijn kernel k's value and its waits'\n339\t   frames.\"\n340\t  [k]\n341\t  (closures-in [(:value k) (mapv :frames (:wait-set k))]))\n342\t\n343\t\n344\t(defn canonical-shape\n345\t  \"A canonical closure payload with its segment named by A.\"\n346\t  [address c]\n347\t  (h/normalize (assoc (select-keys c [:params :entry :env]) :segment (address (:segment c)))))\n348\t\n349\t\n350\t(deftest closures-round-trip\n351\t  (let [checked (atom 0)]\n352\t    (doseq [[label ast] closure-programs\n353\t            lane [:stack :register]]\n354\t      (testing (str (name label) \" \" (name lane))\n355\t        (let [sr (:machine (h/on-lane :semantic-register #(h/reader identity ast)))\n356\t              k (:machine (h/on-lane lane #(h/reader identity ast)))\n357\t              sp (h/kernel-space k)\n358\t              cx (layout/lift-context k sp (:owner k))\n359\t              lx (layout/lower-context k sp)\n360\t              expected (mapv #(canonical-shape (fn [seg] (get-in sr [:code seg :address])) (values/payload %))\n361\t                             (closures-in [(:value sr) (mapv :env (:wait-set sr))]))\n362\t              positional (kernel-closures k)\n363\t              canonical (mapv #(layout/canonical-value cx %) positional)]\n364\t          (is (seq positional))\n365\t          (is (= (set expected) (set (map #(canonical-shape identity (values/payload %)) canonical)))\n366\t              \"positional -> canonical is the evaluator's closure\")\n367\t          (doseq [[p c] (map vector positional canonical)]\n368\t            (let [back (values/payload (layout/positional-value lx c))]\n369\t              (is (= (select-keys (values/payload p) [:arity :body-pc :store-of]) (select-keys back [:arity :body-pc :store-of])))\n370\t              (is (= (h/normalize (values/payload c))\n371\t                     (h/normalize (values/payload (layout/canonical-value cx (layout/positional-value lx c)))))\n372\t                  \"canonical -> positional -> canonical is the identity\")\n373\t              (if (and (= :duplicate-param label) (= [1 2] (peek (:frames (values/payload p)))))\n374\t                (is (= [2 2] (peek (:frames back))) \"the shadowed position reads as the visible x\")\n375\t                (is (= (h/normalize (:frames (values/payload p))) (h/normalize (:frames back)))\n376\t                    \"positional -> canonical -> positional keeps every frame\"))\n377\t              (swap! checked inc))))))\n378\t    (is (<= 6 @checked)))\n379\t  (testing \"the duplicate binder's visible value survives\"\n380\t    (let [k (:machine (h/on-lane :stack #(h/reader identity (s/app (second (nth closure-programs 2)) (s/lit 7)))))]\n381\t      (is (= 2 (vm/value k))))))\n382\t\n383\t\n384\t;; =============================================================================\n385\t;; 9: a lowered tail's frames and store-of are unobservable\n386\t;; =============================================================================\n387\t\n388\t(defn tail-lowered\n389\t  \"Row n lifted on the reference lane and lowered into lane, its tail\n390\t   entries' :frames and :store-of replaced by fill when given: the run's\n391\t   observables and the entries as lowered.\"\n392\t  [build lane fill]\n393\t  (let [world (h/on-lane :semantic-register build)\n394\t        {:keys [toy peer serve!]} (h/served #{:reader})\n395\t        wire (h/lane-lift (:machine world) serve!)\n396\t        {:keys [attach!]} (h/recording-attacher toy)\n397\t        recv (h/lane-lower lane {:attach-stream attach!} wire attach!)\n398\t        entries (:wait-set recv)\n399\t        recv (if fill\n400\t               (assoc recv :wait-set (mapv #(if (= :return-result (:resume-mode %)) (merge % fill) %) entries))\n401\t               recv)\n402\t        done (h/satisfy world recv #(h/drive-peers % [peer]))]\n403\t    {:entries entries :observed [(vm/halted? done) (h/normalize (vm/value done)) (h/normalize (vm/store done))]}))\n404\t\n405\t\n406\t(deftest tail-lowering-is-unobservable\n407\t  (let [checked (atom 0)]\n408\t    (doseq [[n build] [[6 #(h/bare 6)] [20 h/tail-effect-halt]]\n409\t            lane [:stack :register]]\n410\t      (testing (str \"row \" n \" \" (name lane))\n411\t        (let [plain (tail-lowered build lane nil)\n412\t              junk (tail-lowered build lane {:frames [[:junk 1] [:junk 2]] :store-of 'junk.mod})\n413\t              [entry] (:entries plain)]\n414\t          (is (= :return-result (:resume-mode entry)))\n415\t          (is (= [] (:frames entry)) \"lowered with []\")\n416\t          (is (nil? (:store-of entry)) \"and no store-of\")\n417\t          (is (= (:observed plain) (:observed junk)) \"arbitrary values change nothing\")\n418\t          (is (= \"B\" (second (:observed plain))))\n419\t          (swap! checked inc))))\n420\t    (is (= 4 @checked) \"rows 6 and 20 on both de Bruijn lanes; 9 and 12 are link rows\")))\n421\t\n422\t\n423\t;; =============================================================================\n424\t;; §4.1: alpha-equivalent segments, one native image, two A\n425\t;; =============================================================================\n426\t;;\n427\t;; The fixtures' shapes are this test's own: the harness's code-index is\n428\t;; file-wide, and an alpha-equivalent A of another test's vector would\n429\t;; widen that test's unscoped kernel-space.\n430\t\n431\t(defn binder-program\n432\t  \"A reader parked inside ((fn [sym] (then :alpha (next-of c))) 0).\"\n433\t  [sym]\n434\t  (h/with-stream (h/with-cat (s/app (s/lam [sym] (s/then (s/lit :alpha) h/read-op)) (s/lit 0)))))\n435\t\n436\t\n437\t(defn binder-world\n438\t  [sym]\n439\t  (h/reader (fn [_] (s/app (s/lam [sym] (s/then (s/lit :alpha) h/read-op)) (s/lit 0))) h/read-op))\n440\t\n441\t\n442\t(defn alpha-closure\n443\t  [sym]\n444\t  (s/lam [sym] (s/then (s/lit :alpha) (s/v sym))))\n445\t\n446\t\n447\t(defn alpha-world\n448\t  \"Two alpha-equivalent closures in the store, then (b (a \\\"B\\\")) after a read.\"\n449\t  []\n450\t  (let [m1 (vm/run (h/load-program (h/machine) (alpha-closure 'x)))\n451\t        m2 (vm/run (h/load-program m1 (alpha-closure 'y)))\n452\t        m3 (assoc m2 :store {'a (vm/value m1) 'b (vm/value m2)})\n453\t        m (vm/run (h/load-program m3 (h/with-stream (s/then h/read-op (s/app (s/v 'b) (s/app (s/v 'a) (s/lit \"B\")))))))\n454\t        src (s/stream-of m)]\n455\t    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n456\t\n457\t\n458\t(deftest alpha-equivalent-segments\n459\t  (testing \"distinct A, one register image, one stack image\"\n460\t    (let [sx (layout/segment (projected (s/lam ['x] (s/v 'x))))\n461\t          sy (layout/segment (projected (s/lam ['y] (s/v 'y))))]\n462\t      (is (not= (:address sx) (:address sy)))\n463\t      (is (= (:register-id sx) (:register-id sy)))\n464\t      (is (= (:stack-id sx) (:stack-id sy)))))\n465\t  (testing \"a de Bruijn source whose space resolves one image to two A refuses the lift before serving\"\n466\t    (let [ax (layout/segment (h/project (binder-program 'x)))\n467\t          ay (layout/segment (h/project (binder-program 'y)))]\n468\t      (is (not= (:address ax) (:address ay)))\n469\t      (is (= [(:register-id ax) (:stack-id ax)] [(:register-id ay) (:stack-id ay)]))\n470\t      (doseq [lane [:stack :register]]\n471\t        (testing (name lane)\n472\t          (let [m (:machine (h/on-lane lane #(binder-world 'x)))\n473\t                n (atom 0)\n474\t                {:keys [serve!]} (h/served #{:reader})\n475\t                counting #(do (swap! n inc) (serve! %))\n476\t                template (h/on-lane :semantic-register h/machine)\n477\t                d (h/error #(layout/lift-task m (layout/space [ax ay]) template counting (h/lift-opts)))]\n478\t            (is (vm/blocked? m))\n479\t            (is (contains? (set (map first (:images m))) (if (= :stack lane) (:stack-id ax) (:register-id ax)))\n480\t                \"the kernel holds the one image\")\n481\t            (is (= [:yin.k/non-portable :ambiguous-image] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n482\t            (is (zero? @n) \"no stream was served\")\n483\t            (testing \", the file-wide code-index widens the space; the world's own does not\"\n484\t              (is (= :ambiguous-image (:yin.k/kind (h/error #(h/lane-lift m counting)))))\n485\t              (is (zero? @n))\n486\t              (h/scoped (fn []\n487\t                          (let [m (:machine (h/on-lane lane #(binder-world 'x)))]\n488\t                            (is (= #{(:address ax)} (set (keys (:segments (h/kernel-space m))))))\n489\t                            (is (map? (h/lane-lift m serve!)) \"the world's own space lifts\"))))))))))\n490\t  (testing \"a de Bruijn receiver of two A of one image refuses before any attach\"\n491\t    (let [world (alpha-world)\n492\t          addresses (into #{} (map #(:address (layout/segment (projected (alpha-closure %))))) '[x y])]\n493\t      (is (= 2 (count addresses)))\n494\t      (doseq [lane [:stack :register]]\n495\t        (testing (name lane)\n496\t          (let [{:keys [serve! toy]} (h/served #{:reader})\n497\t                wire (h/lane-lift (:machine world) serve!)\n498\t                {:keys [attach!] n :count} (h/recording-attacher toy)\n499\t                d (h/error #(h/lane-lower lane {:attach-stream attach!} wire attach!))]\n500\t            (is (= [:yin.k/unsupported :ambiguous-image] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n501\t            (is (= addresses (:yin.k/segments d)))\n502\t            (is (zero? @n) \"refused before any attachment\"))))))\n503\t  (testing \"the reference lane holds both: laws 1 and 2\"\n504\t    (let [expected (h/reference (alpha-world))]\n505\t      (is (= \"B\" (:value expected)))\n506\t      (is (= \"B\" (:value (h/laws (alpha-world) expected)))))))\n507\t\n508\t\n509\t;; =============================================================================\n510\t;; §6.3: a closure in the free environment, refused on the de Bruijn lanes\n511\t;; =============================================================================\n512\t\n513\t(defn free-closure-world\n514\t  \"An identity closure f the machine's own lane made, held in the free\n515\t   environment, then (then (next-of c) (f \\\"B\\\")) parked on the read.\"\n516\t  []\n517\t  (let [m0 (vm/run (h/load-program (h/machine) (s/lam ['arg] (s/v 'arg))))\n518\t        f (vm/value m0)\n519\t        m1 (cond-> (update m0 :free-env assoc 'f f)\n520\t             (= :semantic-register (h/lane-of m0)) (update :env assoc 'f f))\n521\t        m (vm/run (h/load-program m1 (h/with-stream (s/then h/read-op (s/app (s/v 'f) (s/lit \"B\"))))))\n522\t        src (s/stream-of m)]\n523\t    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n524\t\n525\t\n526\t(deftest free-env-values\n527\t  (testing \"the reference lane and the carrier admit it\"\n528\t    (let [world (h/on-lane :semantic-register free-closure-world)]\n529\t      (is (values/closure? (get-in world [:machine :free-env 'f])))\n530\t      (is (= \"B\" (:value (h/reference (h/on-lane :semantic-register free-closure-world)))))\n531\t      (is (= \"B\" (:value (h/handed-off world))))))\n532\t  (testing \"a de Bruijn receiver refuses it before any attach\"\n533\t    (doseq [lane [:stack :register]]\n534\t      (testing (name lane)\n535\t        (let [world (h/on-lane :semantic-register free-closure-world)\n536\t              {:keys [serve! toy]} (h/served #{:reader})\n537\t              wire (h/lane-lift (:machine world) serve!)\n538\t              {:keys [attach!] n :count} (h/recording-attacher toy)\n539\t              d (h/error #(h/lane-lower lane {:attach-stream attach!} wire attach!))]\n540\t          (is (= [:yin.k/unsupported :free-env-value] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n541\t          (is (= '[:free-env f] (:yin.k/path d)))\n542\t          (is (zero? @n) \"refused before any attachment\")))))\n543\t  (testing \"a de Bruijn source refuses it before anything is served\"\n544\t    (doseq [lane [:stack :register]]\n545\t      (testing (name lane)\n546\t        (let [world (h/on-lane lane free-closure-world)\n547\t              m (:machine world)\n548\t              n (atom 0)\n549\t              {:keys [serve!]} (h/served #{:reader})\n550\t              d (h/error #(h/lane-lift m (fn [x] (swap! n inc) (serve! x))))]\n551\t          (is (= lane (h/lane-of m)))\n552\t          (is (vm/blocked? m))\n553\t          (is (values/closure? (get-in m [:free-env 'f])))\n554\t          (is (= [:yin.k/non-portable :free-env-value] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n555\t          (is (= 'f (:yin.k/key d)))\n556\t          (is (zero? @n) \"no stream was served\"))))))\n557\t"}]},"parent_tool_use_id":null,"session_id":"1571a1be-fcf5-41b6-a2c4-f2a5582b2e60","uuid":"33b31e10-b7b8-4d13-9d74-b4c302f08542","timestamp":"2026-10-12T20:03:59.835Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/layout_test.cljc","content":"(ns yin.vm.semantic-register.layout-test\n  \"Phase 6c acceptance 1-9 (docs/design/yin.vm.semantic-register-vm.continuation.md\n   §8.3): the register pairing and live sets, the register destination from\n   A, the stack correspondence, operand layout and K slices, E\n   reconstruction, closures both ways, and the unobservable fill of a\n   lowered tail. The static items run over C, the B0 corpus and the\n   phase-3 corpus (derive-test's wider C requires the Python ANTLR lane);\n   the dynamic items run the harness's worlds on the de Bruijn lanes.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.engine :as engine]\n            [yin.vm.values :as values]\n            [yin.vm.semantic-register.analysis :as analysis]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.corpus :as corpus]\n            [yin.vm.semantic-register.layout :as layout]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.semantic-register.safepoint-harness-test :as h]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n(def C\n  \"[label ast]: the harness's layout corpus.\"\n  h/layout-corpus)\n\n\n(defn projected\n  [ast]\n  (:vector (linearize/project ast)))\n\n\n(defn reachable-pcs\n  \"Every pc reachable from its body's start.\"\n  [v]\n  (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v)))\n\n\n(defn boundary?\n  [t]\n  (contains? rcode/boundary-opcodes (nth t 0)))\n\n\n(defn parking?\n  \"A non-tail parking instruction (rule A1).\"\n  [t]\n  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n\n\n;; =============================================================================\n;; 1-2: the register kernel's static layout\n;; =============================================================================\n\n(deftest register-pairing\n  (let [checked (atom [0 0])]\n    (doseq [[label ast] C]\n      (testing (str label)\n        (let [v (projected ast)\n              sg (layout/segment v)\n              bodies (:bodies sg)]\n          ;; phys is total on every body's named virtuals and single-valued\n          (doseq [[pc x s] (:pairs sg)]\n            (is (= s (layout/phys sg pc x)) (str \"pc \" pc \" virtual \" x)))\n          (doseq [b (range (count bodies))]\n            (let [named (into #{} (keep (fn [[pc x]] (when (= b (code/body-index bodies pc)) x))) (:pairs sg))]\n              (is (= named (set (keys (nth (:phys sg) b)))))))\n          ;; virt is single-valued on live-out's physical image\n          (doseq [p (sort (reachable-pcs v))\n                  :when (boundary? (nth v p))]\n            (let [lo (layout/live-out sg p)]\n              (is (= (count lo) (count (set (map #(layout/phys sg p %) lo))))\n                  (str \"distinct live virtuals hold distinct slots at pc \" p))\n              (doseq [x lo]\n                (is (= x (layout/virt sg p (layout/phys sg p x))))))\n            (swap! checked update 1 inc))\n          (swap! checked update 0 inc))))\n    (is (= (count C) (first @checked)))\n    (is (< 50 (second @checked)) \"reachable boundaries checked\")))\n\n\n(deftest register-live-is-live-out\n  (let [tails (atom 0)]\n    (doseq [[label ast] C]\n      (testing (str label)\n        (let [v (projected ast)\n              sg (layout/segment v)]\n          (doseq [p (sort (reachable-pcs v))\n                  :let [t (nth v p)]\n                  :when (boundary? t)]\n            (let [live (nth (nth (:instructions (:register sg)) p) (rcode/live-slot-index (nth t 0)))]\n              (is (= (layout/register-live sg p) live) (str \"pc \" p))\n              (when (code/tail-call? t)\n                (swap! tails inc)\n                (is (= [] live (layout/register-live sg p)) \"a tail boundary's live is []\")))))))\n    (is (pos? @tails))))\n\n\n;; =============================================================================\n;; 3: rd from A, never the physical destination\n;; =============================================================================\n\n(def worked-ast (second (first (filter #(= :worked-example (first %)) corpus/programs))))\n\n\n(defn lifted-waits\n  \"The canonical wait entries of world machine m: the evaluator's own, or a\n   de Bruijn kernel's through the layout.\"\n  [m]\n  (if (= :semantic-register (h/lane-of m))\n    (:wait-set m)\n    (:wait-set (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))\n\n\n(deftest register-rd-from-a\n  (testing \"the worked example parked at its inner call\"\n    (let [m0 (h/on-lane :register h/machine)\n          [sref m1] (engine/attach-resource m0 (s/ring 4))\n          [cref m2] (engine/handle-cursor m1 {:stream sref} :k1)\n          next! (engine/resolve-var {} {} vm/primitives h/stream-modules 'stream/next!)\n          m (vm/run (h/load-program (assoc m2 :free-env {'f (get vm/primitives 'conj) 'g next! 'x cref 'y 2})\n                                    worked-ast))\n          entry (first (:wait-set m))\n          [p] (lifted-waits m)\n          v (projected worked-ast)]\n      (is (vm/blocked? m))\n      (is (= [:call 2 3 [4] false] (nth v 3)) \"the inner call\")\n      (is (= 4 (:pc p)))\n      (is (= {:deliver :rd :rd 2} (:deliver p)) \"the canonical rd is A's 2\")\n      (is (= 3 (:dest entry)) \"the kernel's dest is the physical 3\")\n      (is (= #{1} (set (keys (:window p)))) \"saved(4, 2)\")))\n  (testing \"the K frames of :depth-3 take rd from A\"\n    (let [[_ wrap] (nth h/segments 2)\n          build #(h/reader wrap h/read-op)\n          reference (first (:wait-set (:machine (h/on-lane :semantic-register build))))\n          m (:machine (h/on-lane :register build))\n          entry (first (:wait-set m))\n          [p] (lifted-waits m)]\n      (is (= :depth-3 (first (nth h/segments 2))))\n      (is (= 6 (count (:k p))) \"three bindings, three nest applications\")\n      (is (= (mapv :rd (:k reference)) (mapv :rd (:k p))) \"the evaluator's return destinations\")\n      (is (some (fn [[f kf]] (not= (:rd f) (:dest kf))) (map vector (:k p) (:continuation entry)))\n          \"some physical dest differs from its virtual rd\"))))\n\n\n;; =============================================================================\n;; 4-5: the stack correspondence and operand layout\n;; =============================================================================\n\n(defn family\n  [op]\n  (case op (:load-bound :load-free) :var op))\n\n\n(deftest stack-correspondence\n  (doseq [[label ast] C]\n    (testing (str label)\n      (let [v (projected ast)\n            sg (layout/segment v)\n            h (:stack sg)]\n        (is (= (count v) (count (:a->h sg))) \"one non-push H instruction per A pc\")\n        (is (= (count h) (+ (count v) (count (filter #(= :push (first %)) h)))))\n        (doseq [k (range (count v))]\n          (is (= (nth (nth v k) 0) (family (nth (nth h (nth (:a->h sg) k)) 0)))\n              (str \"the k-th non-push instruction, k = \" k))\n          (is (= k (get (:h->a sg) (nth (:a->h sg) k)))))))))\n\n\n(deftest stack-layout-is-the-saved-set\n  (let [checked (atom 0)]\n    (doseq [[label ast] C]\n      (testing (str label)\n        (let [v (projected ast)\n              sg (layout/segment v)\n              a (:analysis sg)]\n          (doseq [p (sort (reachable-pcs v))\n                  :let [t (nth v p)]\n                  :when (parking? t)]\n            (is (= (analysis/saved a (inc p) (code/rd t)) (set (layout/stack-layout sg p))) (str \"pc \" p))\n            (is (apply distinct? (cons ::bottom (layout/stack-layout sg p))))\n            (swap! checked inc)))))\n    (is (< 20 @checked)))\n  (testing \"the worked cases\"\n    (let [first-call (fn [v] (first (keep-indexed (fn [pc t] (when (= :call (first t)) pc)) v)))]\n      (doseq [ast [worked-ast\n                   (corpus/app (corpus/v 'f) (corpus/if-node (corpus/v 'c) (corpus/app (corpus/v 'g)) (corpus/lit 2))\n                               (corpus/v 'y))]]\n        (let [v (projected ast)\n              sg (layout/segment v)]\n          (is (= [1] (layout/stack-layout sg (first-call v))) \"[f], f in register 1\"))))))\n\n\n;; =============================================================================\n;; 6: K slices partition the operand stack\n;; =============================================================================\n\n(defn stack-frames\n  \"[[A-pc slice] …] for return frames then the current activation of\n   stack entry e of kernel k, reading the kernel's own offset table.\"\n  [k e]\n  (let [sp (h/kernel-space k)\n        a-pc (fn [abs]\n               (let [[ident rel] (dvm/image-pc k abs)\n                     sg (some #(when (= ident (:stack-id %)) %) (vals (:segments sp)))]\n                 [sg (inc (get (:h->a sg) (dec rel)))]))\n        parts (layout/slices (vec (:stack e)) (mapv :stack-base (:continuation e)))]\n    (mapv (fn [abs slice] (conj (a-pc abs) slice))\n          (conj (mapv :return-pc (:continuation e)) (:pc e))\n          parts)))\n\n\n(defn non-tail?\n  \"6c-pre marks a tail call's park :return-result.\"\n  [e]\n  (not= :return-result (:resume-mode e)))\n\n\n(deftest stack-slices-partition\n  (let [checked (atom 0)]\n    (doseq [[row label _ build] (h/lane-cases)\n            :when (contains? #{:bare :depth-3 :unwrapped} label)]\n      (testing (str \"row \" row \" \" (name label))\n        (let [k (:machine (h/on-lane :stack build))]\n          (doseq [e (concat (:wait-set k) (vals (:parked k)))\n                  :when (non-tail? e)]\n            (let [frames (stack-frames k e)]\n              (is (= (vec (:stack e)) (into [] (mapcat #(nth % 2)) frames)) \"the slices partition the stack\")\n              (doseq [[sg pc slice] frames]\n                (is (= (count (layout/stack-layout sg (dec pc))) (count slice))))\n              (swap! checked inc))))))\n    (is (< 20 @checked)))\n  (testing \"the multi-frame fixture\"\n    (let [expr (h/cat-of (s/lit [1])\n                         (s/app (s/lam ['x] (h/cat-of (s/lit [2])\n                                                      (s/app (s/lam ['y] (h/cat-of (s/lit [3]) h/read-op))\n                                                             (s/lit 2))))\n                                (s/lit 1)))\n          world (h/on-lane :stack #(h/reader identity expr))\n          k (:machine world)\n          e (first (:wait-set k))\n          st (:stack e)]\n      (is (= [0 0 0 2 4] (mapv :stack-base (:continuation e))) \"the bases, pinned from the kernel\")\n      (is (= 6 (count st)))\n      (is (= [[] [] [] 2 2 2] (mapv #(if (empty? %) [] (count %)) (layout/slices (vec st) [0 0 0 2 4]))))\n      (is (= [[1] [2] [3]] (mapv #(nth st %) [1 3 5])) \"each slice holds its activation's cat and literal\")\n      (is (every? values/closure? (map #(nth st %) [0 2 4])))\n      (is (= (vec st) (into [] cat (layout/slices (vec st) [0 0 0 2 4]))))\n      (let [sp (h/kernel-space k)\n            p (layout/lift-state (layout/lift-context k sp (:owner k)) e)\n            fresh (layout/attach-space (h/on-lane :stack h/machine) sp)\n            lowered (layout/lower-state (layout/lower-context fresh sp) p)]\n        (is (= 5 (count (:k p))))\n        (is (= [0 0 0 2 4] (mapv :stack-base (:continuation lowered))) \"the lowering emits the same bases\")\n        (is (= 6 (count (:stack lowered))))\n        (is (= (h/normalize (:stack e)) (h/normalize (:stack lowered))))\n        (stream/append! (s/stream-of k) \"B\")\n        (is (= [1 [2 [3 \"B\"]]] (h/normalize (vm/value (h/drive-local (assoc fresh :wait-set [lowered] :blocked? true\n                                                                            :halted? false :value :yin/blocked\n                                                                            :resources (:resources k))))))\n            \"and it continues\")))))\n\n\n;; =============================================================================\n;; 7: E reconstruction\n;; =============================================================================\n\n(def env-programs\n  \"The B2 duplicate-parameter, nested-closure and nested-lambdas shapes,\n   each blocked on a read inside its innermost body.\"\n  (let [read-into (fn [& xs] (reduce (fn [acc x] (h/cat-of acc x)) (s/lit []) (concat xs [h/read-op])))]\n    [[:duplicate-param (s/app (s/lam ['x 'x] (read-into (s/v 'x))) (s/lit 1) (s/lit 2)) [2 \"B\"]]\n     [:nested-closure (s/app (s/app (s/lam ['a 'a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n      [nil 2 \"B\"]]\n     [:nested-lambdas (s/app (s/app (s/lam ['a] (s/lam ['b] (read-into (s/v 'a) (s/v 'b)))) (s/lit 1)) (s/lit 2))\n      [1 2 \"B\"]]]))\n\n\n(defn envs\n  \"Every E of a machine's canonical waits and parked records, outermost\n   K frame first, values normalised.\"\n  [m]\n  (let [waits (lifted-waits m)\n        parked (if (= :semantic-register (h/lane-of m))\n                 (vals (:parked m))\n                 (vals (:parked (layout/canonical-task m (h/kernel-space m) (h/on-lane :semantic-register h/machine)))))]\n    (h/normalize (mapv (fn [p] (conj (mapv :env (:k p)) (:env p))) (concat waits (sort-by :id parked))))))\n\n\n(deftest env-reconstruction\n  (let [checked (atom 0)\n        cases (into (mapv (fn [[row label _ build]] [(str \"row \" row \" \" (name label)) build]) (h/lane-cases))\n                    (map (fn [[label ast]] [(name label) #(h/reader identity ast)]))\n                    env-programs)]\n    (doseq [[label build] cases]\n      (testing label\n        (let [expected (envs (:machine (h/on-lane :semantic-register build)))]\n          (doseq [lane [:stack :register]]\n            (is (= expected (envs (:machine (h/on-lane lane build)))) (str (name lane) \"'s E is the evaluator's\"))\n            (swap! checked inc)))))\n    (is (= (* 2 (+ 61 3)) @checked)))\n  (testing \"row 21: the read's E binds x to 1, the free environment keeps 99\"\n    (let [build #(h/free-env-world identity {'x 99})]\n      (doseq [lane h/lanes]\n        (let [m (:machine (h/on-lane lane build))\n              [p] (lifted-waits m)]\n          (is (= 1 (get-in p [:env 'x])))\n          (is (= {'x 99} (:free-env m)))))))\n  (testing \"the env programs answer\"\n    (doseq [[label ast expected] env-programs\n            lane h/lanes]\n      (is (= expected (:value (h/reference (h/on-lane lane #(h/reader identity ast))))) (str label \" \" lane)))))\n\n\n;; =============================================================================\n;; 8: closures, canonical and positional, both ways\n;; =============================================================================\n\n(def closure-programs\n  \"\\\"closure value\\\", \\\"higher order\\\" (its closure held across a read)\n   and :duplicate-param, as halted values or lexical bindings.\"\n  [[:closure-value (s/lam ['x] (s/v 'x))]\n   [:higher-order (s/app (s/lam ['f] (h/cat-of (s/app (s/v 'f) (s/lit 5)) h/read-op)) (s/lam ['x] (s/v 'x)))]\n   [:duplicate-param (s/app (s/lam ['x 'x] (s/lam ['y] (s/v 'x))) (s/lit 1) (s/lit 2))]])\n\n\n(defn closures-in\n  [x]\n  (cond\n    (values/closure? x) [x]\n    (map? x) (mapcat closures-in (concat (keys x) (vals x)))\n    (coll? x) (mapcat closures-in x)\n    :else nil))\n\n\n(defn kernel-closures\n  \"Every positional closure of de Bruijn kernel k's value and its waits'\n   frames.\"\n  [k]\n  (closures-in [(:value k) (mapv :frames (:wait-set k))]))\n\n\n(defn canonical-shape\n  \"A canonical closure payload with its segment named by A.\"\n  [address c]\n  (h/normalize (assoc (select-keys c [:params :entry :env]) :segment (address (:segment c)))))\n\n\n(deftest closures-round-trip\n  (let [checked (atom 0)]\n    (doseq [[label ast] closure-programs\n            lane [:stack :register]]\n      (testing (str (name label) \" \" (name lane))\n        (let [sr (:machine (h/on-lane :semantic-register #(h/reader identity ast)))\n              k (:machine (h/on-lane lane #(h/reader identity ast)))\n              sp (h/kernel-space k)\n              cx (layout/lift-context k sp (:owner k))\n              lx (layout/lower-context k sp)\n              expected (mapv #(canonical-shape (fn [seg] (get-in sr [:code seg :address])) (values/payload %))\n                             (closures-in [(:value sr) (mapv :env (:wait-set sr))]))\n              positional (kernel-closures k)\n              canonical (mapv #(layout/canonical-value cx %) positional)]\n          (is (seq positional))\n          (is (= (set expected) (set (map #(canonical-shape identity (values/payload %)) canonical)))\n              \"positional -> canonical is the evaluator's closure\")\n          (doseq [[p c] (map vector positional canonical)]\n            (let [back (values/payload (layout/positional-value lx c))]\n              (is (= (select-keys (values/payload p) [:arity :body-pc :store-of]) (select-keys back [:arity :body-pc :store-of])))\n              (is (= (h/normalize (values/payload c))\n                     (h/normalize (values/payload (layout/canonical-value cx (layout/positional-value lx c)))))\n                  \"canonical -> positional -> canonical is the identity\")\n              (if (and (= :duplicate-param label) (= [1 2] (peek (:frames (values/payload p)))))\n                (is (= [2 2] (peek (:frames back))) \"the shadowed position reads as the visible x\")\n                (is (= (h/normalize (:frames (values/payload p))) (h/normalize (:frames back)))\n                    \"positional -> canonical -> positional keeps every frame\"))\n              (swap! checked inc))))))\n    (is (<= 6 @checked)))\n  (testing \"the duplicate binder's visible value survives\"\n    (let [k (:machine (h/on-lane :stack #(h/reader identity (s/app (second (nth closure-programs 2)) (s/lit 7)))))]\n      (is (= 2 (vm/value k))))))\n\n\n;; =============================================================================\n;; 9: a lowered tail's frames and store-of are unobservable\n;; =============================================================================\n\n(defn tail-lowered\n  \"Row n lifted on the reference lane and lowered into lane, its tail\n   entries' :frames and :store-of replaced by fill when given: the run's\n   observables and the entries as lowered.\"\n  [build lane fill]\n  (let [world (h/on-lane :semantic-register build)\n        {:keys [toy peer serve!]} (h/served #{:reader})\n        wire (h/lane-lift (:machine world) serve!)\n        {:keys [attach!]} (h/recording-attacher toy)\n        recv (h/lane-lower lane {:attach-stream attach!} wire attach!)\n        entries (:wait-set recv)\n        recv (if fill\n               (assoc recv :wait-set (mapv #(if (= :return-result (:resume-mode %)) (merge % fill) %) entries))\n               recv)\n        done (h/satisfy world recv #(h/drive-peers % [peer]))]\n    {:entries entries :observed [(vm/halted? done) (h/normalize (vm/value done)) (h/normalize (vm/store done))]}))\n\n\n(deftest tail-lowering-is-unobservable\n  (let [checked (atom 0)]\n    (doseq [[n build] [[6 #(h/bare 6)] [20 h/tail-effect-halt]]\n            lane [:stack :register]]\n      (testing (str \"row \" n \" \" (name lane))\n        (let [plain (tail-lowered build lane nil)\n              junk (tail-lowered build lane {:frames [[:junk 1] [:junk 2]] :store-of 'junk.mod})\n              [entry] (:entries plain)]\n          (is (= :return-result (:resume-mode entry)))\n          (is (= [] (:frames entry)) \"lowered with []\")\n          (is (nil? (:store-of entry)) \"and no store-of\")\n          (is (= (:observed plain) (:observed junk)) \"arbitrary values change nothing\")\n          (is (= \"B\" (second (:observed plain))))\n          (swap! checked inc))))\n    (is (= 4 @checked) \"rows 6 and 20 on both de Bruijn lanes; 9 and 12 are link rows\")))\n\n\n;; =============================================================================\n;; §4.1: alpha-equivalent segments, one native image, two A\n;; =============================================================================\n;;\n;; The fixtures' shapes are this test's own: the harness's code-index is\n;; file-wide, and an alpha-equivalent A of another test's vector would\n;; widen that test's unscoped kernel-space.\n\n(defn binder-program\n  \"A reader parked inside ((fn [sym] (then :alpha (next-of c))) 0).\"\n  [sym]\n  (h/with-stream (h/with-cat (s/app (s/lam [sym] (s/then (s/lit :alpha) h/read-op)) (s/lit 0)))))\n\n\n(defn binder-world\n  [sym]\n  (h/reader (fn [_] (s/app (s/lam [sym] (s/then (s/lit :alpha) h/read-op)) (s/lit 0))) h/read-op))\n\n\n(defn alpha-closure\n  [sym]\n  (s/lam [sym] (s/then (s/lit :alpha) (s/v sym))))\n\n\n(defn alpha-world\n  \"Two alpha-equivalent closures in the store, then (b (a \\\"B\\\")) after a read.\"\n  []\n  (let [m1 (vm/run (h/load-program (h/machine) (alpha-closure 'x)))\n        m2 (vm/run (h/load-program m1 (alpha-closure 'y)))\n        m3 (assoc m2 :store {'a (vm/value m1) 'b (vm/value m2)})\n        m (vm/run (h/load-program m3 (h/with-stream (s/then h/read-op (s/app (s/v 'b) (s/app (s/v 'a) (s/lit \"B\")))))))\n        src (s/stream-of m)]\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])}))\n\n\n(deftest alpha-equivalent-segments\n  (testing \"dis