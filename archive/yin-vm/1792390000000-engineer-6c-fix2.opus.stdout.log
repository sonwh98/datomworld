{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vx5sBLX2SfWiDYb8L5XAz6","type":"tool_result","content":"1405\t\n1406\t;; =============================================================================\n1407\t;; Phase 6c: the cross-engine lanes (§5.3, §5.4 laws 4 and 5, §8.3 10-12)\n1408\t;; =============================================================================\n1409\t\n1410\t(def link-rows\n1411\t  \"Rows the de Bruijn lanes do not carry (§5.3, the shared fragment): a\n1412\t   de Bruijn kernel links a native image while module responses carry A,\n1413\t   and §4 defines no layout for install children (canonical-task refuses\n1414\t   :installs). The reference lane runs the whole matrix; these lanes are\n1415\t   removed with their kernels at phase 8.\"\n1416\t  #{7 8 9 10 11 12 17})\n1417\t\n1418\t\n1419\t(def lane-rows\n1420\t  \"The wrapped rows every lane executes: 15 of §5.2's 22.\"\n1421\t  (filterv #(not (contains? link-rows (first %))) rows))\n1422\t\n1423\t\n1424\t(defn lane-cases\n1425\t  \"§5.3's shared fragment: 15 lane rows x 4 segments, plus row 20 once:\n1426\t   [row segment expected build].\"\n1427\t  []\n1428\t  (filterv #(not (contains? link-rows (first %))) (matrix-cases)))\n1429\t\n1430\t\n1431\t(defn on-lane\n1432\t  [lane build]\n1433\t  (binding [*lane* lane] (build)))\n1434\t\n1435\t\n1436\t(defn lane-lift\n1437\t  \"The lift of §7.1 on m's own lane.\"\n1438\t  [m serve!]\n1439\t  (if (= :semantic-register (lane-of m))\n1440\t    (rows/lift-task m serve! (lift-opts))\n1441\t    (layout/lift-task m (kernel-space m) (on-lane :semantic-register machine) serve! (lift-opts))))\n1442\t\n1443\t\n1444\t(defn lane-lower\n1445\t  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n1446\t  [lane opts wire attach!]\n1447\t  (let [scratch (on-lane :semantic-register #(machine opts))]\n1448\t    (if (= :semantic-register lane)\n1449\t      (rows/lower-task scratch wire attach!)\n1450\t      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n1451\t\n1452\t\n1453\t(defn injective\n1454\t  \"names, asserting no two identities share a logical name (§5.5).\"\n1455\t  [names]\n1456\t  (is (= (count names) (count (distinct (vals names)))) \"the correspondence is injective\")\n1457\t  names)\n1458\t\n1459\t\n1460\t(defn logical-names\n1461\t  \"§5.5's explicit correspondence: each served identity to the resource\n1462\t   key the lifted machine holds that handle under. The fixture builds the\n1463\t   same program on every lane, so one key names one logical stream.\"\n1464\t  [m peer]\n1465\t  (injective\n1466\t    (into {} (map (fn [[id e]]\n1467\t                    [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n1468\t                            (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n1469\t          @(:table peer))))\n1470\t\n1471\t\n1472\t(defn ring-names\n1473\t  \"{stream identity -> resource key} over every stream m holds.\"\n1474\t  [m]\n1475\t  (injective\n1476\t    (into {} (keep (fn [[k h]]\n1477\t                     (when (satisfies? stream/IDaoStreamDescriptor h)\n1478\t                       [(:dao.stream/identity (stream/descriptor h)) k])))\n1479\t          (:resources m))))\n1480\t\n1481\t\n1482\t(defn logical-positions\n1483\t  \"The task with each cursor position's embedded stream identity renamed\n1484\t   to its logical name. A ring buffer cursor carries its stream's\n1485\t   identity, which §5.5's marker substitution does not reach, so the\n1486\t   cross-lane comparison renames only that field, under the same fixture\n1487\t   correspondence; every other field, the offset included, is kept.\"\n1488\t  [task m]\n1489\t  (let [names (ring-names m)\n1490\t        k :dao.stream.ringbuffer/identity]\n1491\t    (replace-nodes task #(= :cursor-cell-body (:kind %))\n1492\t                   (fn [n]\n1493\t                     (update-in n [:slots 1]\n1494\t                                (fn [p]\n1495\t                                  (if (and (map? p) (contains? names (get p k)))\n1496\t                                    (assoc p k (get names (get p k)))\n1497\t                                    p)))))))\n1498\t\n1499\t\n1500\t(defn rename-identities\n1501\t  \"x with every :dao.stream/identity value that names maps renamed.\"\n1502\t  [x names]\n1503\t  (cond\n1504\t    (map? x) (into {} (map (fn [[k v]]\n1505\t                             [k (if (and (= :dao.stream/identity k) (contains? names v))\n1506\t                                  (get names v)\n1507\t                                  (rename-identities v names))]))\n1508\t                   x)\n1509\t    (vector? x) (mapv #(rename-identities % names) x)\n1510\t    :else x))\n1511\t\n1512\t\n1513\t(defn logical-descriptors\n1514\t  \"§5.5: {logical name -> stream descriptor, identities renamed} over every\n1515\t   stream m holds. canonical-under erases a marker's descriptor, so the\n1516\t   lanes' descriptors are shown equivalent on these, separately.\"\n1517\t  [m]\n1518\t  (let [names (ring-names m)]\n1519\t    (into {} (keep (fn [[k h]]\n1520\t                     (when (satisfies? stream/IDaoStreamDescriptor h)\n1521\t                       [k (rename-identities (stream/descriptor h) names)])))\n1522\t          (:resources m))))\n1523\t\n1524\t\n1525\t(defn descriptors-equivalent?\n1526\t  \"Each lane's logical-descriptors, one per lane: equal maps.\"\n1527\t  [ds]\n1528\t  (apply = ds))\n1529\t\n1530\t\n1531\t(defn identities-in\n1532\t  \"The members of ids anywhere in x.\"\n1533\t  [x ids]\n1534\t  (cond\n1535\t    (contains? ids x) #{x}\n1536\t    (map? x) (into #{} (mapcat #(identities-in % ids)) (concat (keys x) (vals x)))\n1537\t    (coll? x) (into #{} (mapcat #(identities-in % ids)) x)\n1538\t    :else #{}))\n1539\t\n1540\t\n1541\t(defn task-root\n1542\t  \"§5.5 over decoded task: positions renamed, re-emitted, then\n1543\t   canonical-under the served correspondence; no lane identity survives.\"\n1544\t  [task m peer]\n1545\t  (let [names (logical-names m peer)\n1546\t        canonical (rows/canonical-under (rows/emit (logical-positions task m)) names)]\n1547\t    (is (empty? (identities-in (:yin.k/rows canonical) (into (set (keys names)) (keys (ring-names m)))))\n1548\t        \"every lane identity was renamed\")\n1549\t    (:yin.k/root canonical)))\n1550\t\n1551\t\n1552\t(defn logical-root\n1553\t  \"§5.5: the lift's root id with every lane identity replaced by the\n1554\t   fixture's logical name.\"\n1555\t  [wire m peer]\n1556\t  (task-root (rows/decode wire) m peer))\n1557\t\n1558\t\n1559\t(defn lane-root\n1560\t  \"Build on lane, lift: {:root under the logical names, :reference the\n1561\t   lane's own run, :lane the kernel the world ran on, :descriptors, and\n1562\t   :task :machine :peer for the controls}.\"\n1563\t  [lane build]\n1564\t  (scoped\n1565\t    (fn []\n1566\t      (let [world (on-lane lane build)\n1567\t            m (:machine world)\n1568\t            {:keys [serve! peer]} (served (or (:surfaces world) #{:reader}))\n1569\t            task (rows/decode (lane-lift m serve!))]\n1570\t        (is (nil? (rows/validate-frames task)) \"law 6 on every lane\")\n1571\t        {:root (task-root task m peer)\n1572\t         :reference (reference (on-lane lane build))\n1573\t         :lane (lane-of m) :descriptors (logical-descriptors m)\n1574\t         :task task :machine m :peer peer}))))\n1575\t\n1576\t\n1577\t(defn canonical-equality\n1578\t  \"Law 4 for one case: exactly the three distinct kernel lanes lift to one\n1579\t   root, their streams' descriptors are equivalent under the\n1580\t   correspondence, and each lane's own run answers the reference.\"\n1581\t  [build expected]\n1582\t  (let [roots (mapv #(lane-root % build) lanes)]\n1583\t    (is (= 3 (count roots)))\n1584\t    (is (= [:semantic-register :stack :register] (mapv :lane roots)) \"three distinct kernel lanes\")\n1585\t    (is (apply = (map :root roots)) \"law 4: one root id on every lane\")\n1586\t    (is (descriptors-equivalent? (mapv :descriptors roots)) \"descriptors equivalent under the correspondence\")\n1587\t    (doseq [{:keys [lane reference]} roots]\n1588\t      (is (:halted reference) (str lane \" completes\"))\n1589\t      (when (some? expected) (is (= expected (:value reference)) (str lane \" answers the reference\"))))\n1590\t    roots))\n1591\t\n1592\t\n1593\t(defn control-root\n1594\t  \"A lane's root with its decoded task changed by f first.\"\n1595\t  [{:keys [task machine peer]} f]\n1596\t  (let [task' (f task)]\n1597\t    (is (not= task task') \"the control changed the task\")\n1598\t    (task-root task' machine peer)))\n1599\t\n1600\t\n1601\t(defn first-binding\n1602\t  \"Pairs node n with the value of its first pair whose key satisfies pred\n1603\t   replaced by v.\"\n1604\t  [n pred v]\n1605\t  (let [ps (pairs-of n)\n1606\t        i (first (keep-indexed (fn [i [k _]] (when (pred k) i)) ps))]\n1607\t    (if i (rows/node (:kind n) (mapcat identity (assoc-in ps [i 1] v))) n)))\n1608\t\n1609\t\n1610\t(deftest law-4-controls\n1611\t  ;; §5.5 (D1): a changed position offset, descriptor field, saved value or\n1612\t  ;; lexical value changes what law 4 compares\n1613\t  (let [roots (canonical-equality #(bare 1) [\"A\" \"B\"])\n1614\t        [sr stack-lane register-lane] roots\n1615\t        base (:root sr)]\n1616\t    (testing \"the three lanes agree\"\n1617\t      (is (= base (:root stack-lane) (:root register-lane))))\n1618\t    (testing \"a cursor position's offset\"\n1619\t      (is (not= base (control-root stack-lane\n1620\t                                   (fn [t]\n1621\t                                     (replace-nodes t #(= :cursor-cell-body (:kind %))\n1622\t                                                    (fn [n] (update-in n [:slots 1 :dao.stream.ringbuffer/position] inc))))))))\n1623\t    (testing \"a stream descriptor's nonidentity field\"\n1624\t      (let [ds (mapv :descriptors roots)\n1625\t            k (first (keys (first ds)))]\n1626\t        (is (some? k))\n1627\t        (is (descriptors-equivalent? ds))\n1628\t        (is (not (descriptors-equivalent? (update-in ds [2 k :dao.stream/descriptor] assoc :review/extra :different))))))\n1629\t    (testing \"a saved window value\"\n1630\t      (is (not= base (control-root register-lane\n1631\t                                   (fn [t]\n1632\t                                     (replace-nodes t #(= :window (:kind %))\n1633\t                                                    (fn [n] (first-binding n some? [:lit :control]))))))))\n1634\t    (testing \"a lexical value\"\n1635\t      (is (not= base (control-root sr\n1636\t                                   (fn [t]\n1637\t                                     (replace-nodes t #(= :env (:kind %))\n1638\t                                                    (fn [n] (update-in n [:slots 0] first-binding #{'a} [:lit :control]))))))))))\n1639\t\n1640\t\n1641\t(deftest cross-engine-canonical-equality-bare\n1642\t  ;; the quick-tier slice of acceptance 10: every lane row once, bare;\n1643\t  ;; §5.3's shared fragment, 16 cases over three distinct kernel lanes\n1644\t  (let [n (atom 0)]\n1645\t    (doseq [[row r build] lane-rows]\n1646\t      (testing (str \"row \" row)\n1647\t        (canonical-equality #(build identity) r)\n1648\t        (swap! n inc)))\n1649\t    (testing \"row 20\"\n1650\t      (canonical-equality tail-effect-halt \"B\")\n1651\t      (swap! n inc))\n1652\t    (is (= 16 @n))))\n1653\t\n1654\t\n1655\t(deftest ^:slow cross-engine-canonical-equality\n1656\t  ;; acceptance 10: law 4 over §5.3's shared fragment, 61 cases, each over\n1657\t  ;; exactly three distinct kernel lanes\n1658\t  (slow/guard\n1659\t    \"cross-engine-canonical-equality\"\n1660\t    (fn []\n1661\t      (let [cases (lane-cases) n (atom 0)]\n1662\t        (is (= 61 (count cases)) \"15 lane rows x 4 segments + row 20\")\n1663\t        (doseq [[row label expected build] cases]\n1664\t          (testing (str \"row \" row \" \" (name label))\n1665\t            (canonical-equality build expected)\n1666\t            (swap! n inc)))\n1667\t        (is (= 61 @n))))))\n1668\t\n1669\t\n1670\t(def ordered-pairs\n1671\t  \"Law 5's six ordered pairs of distinct lanes.\"\n1672\t  (into [] (mapcat (fn [from] (keep (fn [to] (when (not= from to) [from to])) lanes))) lanes))\n1673\t\n1674\t\n1675\t(def unlowerable\n1676\t  \"[row receiver] pairs a de Bruijn receiver cannot continue (§5.3): row\n1677\t   4 is lifted from a de Bruijn source but not lowered into a de Bruijn\n1678\t   receiver, whose re-park names its own call pair\n1679\t   (ffi/response-wait-entry), not the carried response cursor cell the\n1680\t   semantic-register kernel restores. Emptied when the retained-FFI seam\n1681\t   (§4, 6c-post-D2) lands, raising law 5 to 366 and 96.\"\n1682\t  #{[4 :stack] [4 :register]})\n1683\t\n1684\t\n1685\t(defn crossed\n1686\t  \"Lift on from, lower into a fresh receiver on to, satisfy through the\n1687\t   source's streams: the run's observables and attaches.\"\n1688\t  [from to build]\n1689\t  (scoped\n1690\t    (fn []\n1691\t      (let [world (on-lane from build)\n1692\t            {:keys [toy peer serve!]} (served (or (:surfaces world) #{:reader}))\n1693\t            wire (lane-lift (:machine world) serve!)\n1694\t            receiver ((or (:receiver world) (constantly nil)))\n1695\t            {:keys [attach!] n :count} (recording-attacher toy)\n1696\t            recv (lane-lower to (merge {:attach-stream attach!} (:opts receiver)) wire attach!)\n1697\t            _ (is (= to (lane-of recv)))\n1698\t            attaches @n\n1699\t            done (satisfy world recv #(drive-peers % [peer]))\n1700\t            _ (s/serve-mirror! peer)]\n1701\t        (when-let [f (:finish world)] (f))\n1702\t        (when-let [f (:finish receiver)] (f))\n1703\t        {:attaches attaches :wire wire\n1704\t         :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))))\n1705\t\n1706\t\n1707\t(defn cross-lowering\n1708\t  \"Law 5 for one case: every admitted ordered pair continues to the\n1709\t   reference. Answers the pairs that ran.\"\n1710\t  [row build]\n1711\t  (let [ref (reference (on-lane :semantic-register build))]\n1712\t    (is (:halted ref))\n1713\t    (reduce (fn [ran [from to]]\n1714\t              (if (contains? unlowerable [row to])\n1715\t                ran\n1716\t                (testing (str (name from) \" -> \" (name to))\n1717\t                  (let [got (crossed from to build)]\n1718\t                    (is (= (count (stream-identities (:wire got))) (:attaches got)))\n1719\t                    (is (= (select-keys ref [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n1720\t                        \"law 5: the lowered run continues to the reference\")\n1721\t                    (conj ran [from to])))))\n1722\t            []\n1723\t            ordered-pairs)))\n1724\t\n1725\t\n1726\t(deftest cross-engine-lowering-bare\n1727\t  ;; the quick-tier slice of acceptance 11: every lane row once, bare;\n1728\t  ;; §5.3's shared fragment, 92 transfers (96 once unlowerable is emptied)\n1729\t  (is (= 6 (count ordered-pairs)))\n1730\t  (let [ran (atom 0)]\n1731\t    (doseq [[row _ build] lane-rows]\n1732\t      (testing (str \"row \" row)\n1733\t        (let [pairs (cross-lowering row #(build identity))]\n1734\t          (is (= (if (= 4 row) 2 6) (count pairs)) \"every admitted ordered pair ran\")\n1735\t          (swap! ran + (count pairs)))))\n1736\t    (testing \"row 20\"\n1737\t      (is (= 6 (count (cross-lowering 20 tail-effect-halt))))\n1738\t      (swap! ran + 6))\n1739\t    (is (= 92 @ran) \"16 cases x 6 pairs, less row 4's 4 into a de Bruijn receiver\")))\n1740\t\n1741\t\n1742\t(deftest ^:slow cross-engine-lowering\n1743\t  ;; acceptance 11: law 5, six ordered pairs over §5.3's shared fragment,\n1744\t  ;; 350 transfers (366 once unlowerable is emptied)\n1745\t  (slow/guard\n1746\t    \"cross-engine-lowering\"\n1747\t    (fn []\n1748\t      (let [ran (atom 0) cases (lane-cases)]\n1749\t        (is (= 61 (count cases)))\n1750\t        (doseq [[row label _ build] cases]\n1751\t          (testing (str \"row \" row \" \" (name label))\n1752\t            (swap! ran + (count (cross-lowering row build)))))\n1753\t        (is (= 350 @ran) \"61 cases x 6 pairs, less row 4's 4 per segment\")))))\n1754\t\n1755\t\n1756\t(defn register-judge\n1757\t  \"The frame validator's verdict on register entry `entry` of m,\n1758\t   reconstructed through the layout.\"\n1759\t  [m entry]\n1760\t  (let [sp (kernel-space m)\n1761\t        p (layout/lift-state (layout/lift-context m sp (:owner m)) entry)\n1762\t        code-map (into {} (map (fn [[a sg]] [a (:vector sg)])) (:segments sp))\n1763\t        as-sr {:code (into {} (map (fn [a] [a {:address a}])) (keys code-map))}]\n1764\t    (:yin.k/kind (frame/defect (ft/canonical as-sr p true) code-map :wait {:free-env {} :ffi-call-ids #{}}))))\n1765\t\n1766\t\n1767\t(defn spare-register\n1768\t  \"A physical register of the entry's body outside its live set and its\n1769\t   destination that R gives exactly one virtual.\"\n1770\t  [m entry]\n1771\t  (let [sg (val (first (:segments (kernel-space m))))\n1772\t        site (- (:site-pc entry) (layout/offset :register m sg))\n1773\t        body (nth (:phys sg) (code/body-index (:bodies sg) site))\n1774\t        unique (keep (fn [[s xs]] (when (= 1 (count xs)) s)) (group-by body (keys body)))]\n1775\t    (first (remove (conj (set (:live entry)) (:dest entry)) (sort unique)))))\n1776\t\n1777\t\n1778\t(def layout-corpus\n1779\t  \"C, [label ast]: the B0 corpus, the phase-3 corpus, then a tail call in\n1780\t   operand position, whose dead layout syntax reads registers other than\n1781\t   the call's own (phase-5 §6.3's last golden).\"\n1782\t  (conj (into (mapv (fn [[label ast _]] [label ast]) b0/corpus) corpus/programs)\n1783\t        [:tail-operand (corpus/app (corpus/v 'f) (corpus/tail (corpus/app (corpus/v 'g) (corpus/v 'x))) (corpus/v 'y))]))\n1784\t\n1785\t\n1786\t(defn- parking-site?\n1787\t  \"Rule A1: a non-tail parking instruction.\"\n1788\t  [t]\n1789\t  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n1790\t      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n1791\t\n1792\t\n1793\t(defn ambiguous-dead-slots\n1794\t  \"[v p s] over C: a reachable parking pc p and a physical slot s of its\n1795\t   body that R gives two or more virtuals, outside live-out*(p)'s image\n1796\t   and p's destination.\"\n1797\t  []\n1798\t  (into []\n1799\t        (mapcat (fn [[_ ast]]\n1800\t                  (let [v (:vector (linearize/project ast))\n1801\t                        sg (segment-of v)\n1802\t                        reach (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v))]\n1803\t                    (mapcat (fn [p]\n1804\t                              (let [rd (code/rd (nth v p))\n1805\t                                    body (nth (:phys sg) (code/body-index (:bodies sg) p))\n1806\t                                    used (into #{} (map #(layout/phys sg p %))\n1807\t                                               (cond-> (layout/live-out sg p) (some? rd) (conj rd)))]\n1808\t                                (keep (fn [[s xs]] (when (and (< 1 (count xs)) (not (contains? used s))) [v p s]))\n1809\t                                      (sort-by key (group-by body (keys body))))))\n1810\t                            (filter #(parking-site? (nth v %)) (sort reach))))))\n1811\t        layout-corpus))\n1812\t\n1813\t\n1814\t(defn register-entry\n1815\t  \"A register kernel k's wait entry parked after pc p of v, its window the\n1816\t   live registers holding :v, plus slot extra holding :x when given.\"\n1817\t  [k v p extra]\n1818\t  (let [sg (segment-of v)\n1819\t        off (layout/offset :register k sg)\n1820\t        rd (code/rd (nth v p))\n1821\t        regs (vec (sort-by first (cond-> (mapv (fn [r] [r :v]) (layout/register-live sg p))\n1822\t                                   (some? extra) (conj [extra :x]))))]\n1823\t    {:site-pc (+ off p) :pc (+ off p 1) :regs regs :live (mapv first regs)\n1824\t     :dest (when (some? rd) (layout/phys sg p rd)) :continuation [] :resume-mode :write-result\n1825\t     :frames (mapv (fn [c] (vec (repeat (count (nth (nth v c) 2)) nil))) (layout/chain sg (inc p)))}))\n1826\t\n1827\t\n1828\t(deftest layout-refusals\n1829\t  (testing \"a kernel stepped to a non-safepoint pc\"\n1830\t    (doseq [lane [:stack :register]]\n1831\t      (testing (name lane)\n1832\t        (let [m (on-lane lane #(vm/step (load-program (machine) (s/app (s/lam ['p] (s/lit 42)) (s/lit 1)))))\n1833\t              n (atom 0)\n1834\t              {:keys [serve!]} (served #{:reader})\n1835\t              d (error #(lane-lift m (fn [h] (swap! n inc) (serve! h))))]\n1836\t          (is (not (vm/halted? m)))\n1837\t          (is (= :yin.k/not-at-safepoint (:yin.k/status d)) (pr-str d))\n1838\t          (is (zero? @n) \"no stream was served\")\n1839\t          (testing \", its registers read as a payload\"\n1840\t            (let [entry (if (= :stack lane)\n1841\t                          (select-keys m [:pc :frames :stack :continuation])\n1842\t                          (assoc (select-keys m [:pc :frames :continuation]) :regs [] :resume-mode :write-result))\n1843\t                  cx (layout/lift-context m (kernel-space m) (:owner m))]\n1844\t              (is (= :yin.k/not-at-safepoint (:yin.k/status (error #(layout/lift-state cx entry)))))))))))\n1845\t  (testing \"a register entry whose live was tampered\"\n1846\t    (let [m (:machine (on-lane :register #(bare 1)))\n1847\t          entry (first (:wait-set m))\n1848\t          live (:live entry)\n1849\t          spare (spare-register m entry)]\n1850\t      (is (nil? (register-judge m entry)) \"the untampered entry reconstructs a valid frame\")\n1851\t      (is (seq live))\n1852\t      (is (= :window-missing (register-judge m (assoc entry :live (vec (rest live)) :regs (vec (rest (:regs entry))))))\n1853\t          \"a live register dropped\")\n1854\t      (is (some? spare))\n1855\t      (is (= :window-extra (register-judge m (assoc entry :live (vec (sort (conj live spare)))\n1856\t                                                    :regs (vec (sort-by first (conj (:regs entry) [spare :x]))))))\n1857\t          \"a dead register added\")))\n1858\t  (testing \"a register entry tampered with an ambiguous dead preimage: the layout refuses\"\n1859\t    (let [fixtures (ambiguous-dead-slots)]\n1860\t      (is (seq fixtures) \"C holds one: the allocator reuses slots\")\n1861\t      (doseq [[v p s] fixtures]\n1862\t        (let [sp (layout/space [v])\n1863\t              k (layout/attach-space (on-lane :register machine) sp)\n1864\t              cx (layout/lift-context k sp (:owner k))\n1865\t              d (error #(layout/lift-state cx (register-entry k v p s)))]\n1866\t          (is (map? (layout/lift-state cx (register-entry k v p nil))) \"untampered, the entry lifts\")\n1867\t          (is (= [:yin.k/non-portable :register-layout] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n1868\t          (is (= {:yin.k/pc p :yin.k/register s} (select-keys d [:yin.k/pc :yin.k/register])))))))\n1869\t  (testing \"a primitive in a window, a lexical binding, a closure's capture or a window's guest collection: the register kernel cannot hold it, refused before any attach\"\n1870\t    (doseq [[label op expected path?]\n1871\t            [[:window (s/app (s/v 'conj) (s/lit []) read-op) [\"B\"]\n1872\t              #(= [:frames 0 :window] (subvec % 0 3))]\n1873\t             ;; the read under cat, whose closure captures no primitive: s/then\n1874\t             ;; would save its own closure, which captures the binding too\n1875\t             [:lexical (s/app (s/lam ['q] (cat-of (cat-of (s/lit []) read-op) (s/app (s/v 'q) (s/lit []) (s/lit 1))))\n1876\t                              (s/v 'conj))\n1877\t              [\"B\" [1]] #(= '[:frames 0 :env q] %)]\n1878\t             [:captured (s/let1 'g (s/lam ['h] (s/lam ['x] (s/app (s/v 'h) (s/lit []) (s/v 'x))))\n1879\t                                (s/let1 'k (s/app (s/v 'g) (s/v 'conj))\n1880\t                                        (cat-of (cat-of (s/lit []) read-op) (s/app (s/v 'k) (s/lit 2)))))\n1881\t              [\"B\" [2]] #(= '[:frames 0 :env k h] %)]\n1882\t             [:nested (s/app (s/lam ['w 'r] (s/v 'r)) (cat-of (s/lit []) (s/v 'conj)) read-op) \"B\"\n1883\t              #(and (= 5 (count %)) (= [:frames 0 :window] (subvec % 0 3)) (= 0 (peek %)))]]]\n1884\t      (testing (str \" \" (name label))\n1885\t        (let [build #(reader % op)\n1886\t              world (build identity)\n1887\t              {:keys [serve! toy]} (served #{:reader})\n1888\t              wire (rows/lift-task (:machine world) serve! (lift-opts))\n1889\t              {:keys [attach!] n :count} (recording-attacher toy)\n1890\t              d (error #(lane-lower :register {:attach-stream attach!} wire attach!))]\n1891\t          (is (= [:yin.k/unsupported :continuation-registers] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n1892\t          (is (path? (:yin.k/path d)) (pr-str (:yin.k/path d)))\n1893\t          (is (zero? @n) \"refused before any attachment\")\n1894\t          (testing \", the stack kernel holds it\"\n1895\t            (let [ref (reference (build identity))\n1896\t                  got (crossed :semantic-register :stack #(build identity))]\n1897\t              (is (= expected (:value ref)))\n1898\t              (is (= (:value ref) (:value got))))))))))"}]},"parent_tool_use_id":null,"session_id":"1571a1be-fcf5-41b6-a2c4-f2a5582b2e60","uuid":"df516dcf-8a03-4c05-abae-6e86977cd814","timestamp":"2026-10-12T20:04:06.184Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6c/test/yin/vm/semantic_register/safepoint_harness_test.cljc","content":"\n;; =============================================================================\n;; Phase 6c: the cross-engine lanes (§5.3, §5.4 laws 4 and 5, §8.3 10-12)\n;; =============================================================================\n\n(def link-rows\n  \"Rows the de Bruijn lanes do not carry (§5.3, the shared fragment): a\n   de Bruijn kernel links a native image while module responses carry A,\n   and §4 defines no layout for install children (canonical-task refuses\n   :installs). The reference lane runs the whole matrix; these lanes are\n   removed with their kernels at phase 8.\"\n  #{7 8 9 10 11 12 17})\n\n\n(def lane-rows\n  \"The wrapped rows every lane executes: 15 of §5.2's 22.\"\n  (filterv #(not (contains? link-rows (first %))) rows))\n\n\n(defn lane-cases\n  \"§5.3's shared fragment: 15 lane rows x 4 segments, plus row 20 once:\n   [row segment expected build].\"\n  []\n  (filterv #(not (contains? link-rows (first %))) (matrix-cases)))\n\n\n(defn on-lane\n  [lane build]\n  (binding [*lane* lane] (build)))\n\n\n(defn lane-lift\n  \"The lift of §7.1 on m's own lane.\"\n  [m serve!]\n  (if (= :semantic-register (lane-of m))\n    (rows/lift-task m serve! (lift-opts))\n    (layout/lift-task m (kernel-space m) (on-lane :semantic-register machine) serve! (lift-opts))))\n\n\n(defn lane-lower\n  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n  [lane opts wire attach!]\n  (let [scratch (on-lane :semantic-register #(machine opts))]\n    (if (= :semantic-register lane)\n      (rows/lower-task scratch wire attach!)\n      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n\n\n(defn injective\n  \"names, asserting no two identities share a logical name (§5.5).\"\n  [names]\n  (is (= (count names) (count (distinct (vals names)))) \"the correspondence is injective\")\n  names)\n\n\n(defn logical-names\n  \"§5.5's explicit correspondence: each served identity to the resource\n   key the lifted machine holds that handle under. The fixture builds the\n   same program on every lane, so one key names one logical stream.\"\n  [m peer]\n  (injective\n    (into {} (map (fn [[id e]]\n                    [id (or (some (fn [[k h]] (when (identical? h (:handle e)) k)) (:resources m))\n                            (throw (ex-info \"A served handle the machine does not hold\" {:id id})))]))\n          @(:table peer))))\n\n\n(defn ring-names\n  \"{stream identity -> resource key} over every stream m holds.\"\n  [m]\n  (injective\n    (into {} (keep (fn [[k h]]\n                     (when (satisfies? stream/IDaoStreamDescriptor h)\n                       [(:dao.stream/identity (stream/descriptor h)) k])))\n          (:resources m))))\n\n\n(defn logical-positions\n  \"The task with each cursor position's embedded stream identity renamed\n   to its logical name. A ring buffer cursor carries its stream's\n   identity, which §5.5's marker substitution does not reach, so the\n   cross-lane comparison renames only that field, under the same fixture\n   correspondence; every other field, the offset included, is kept.\"\n  [task m]\n  (let [names (ring-names m)\n        k :dao.stream.ringbuffer/identity]\n    (replace-nodes task #(= :cursor-cell-body (:kind %))\n                   (fn [n]\n                     (update-in n [:slots 1]\n                                (fn [p]\n                                  (if (and (map? p) (contains? names (get p k)))\n                                    (assoc p k (get names (get p k)))\n                                    p)))))))\n\n\n(defn rename-identities\n  \"x with every :dao.stream/identity value that names maps renamed.\"\n  [x names]\n  (cond\n    (map? x) (into {} (map (fn [[k v]]\n                             [k (if (and (= :dao.stream/identity k) (contains? names v))\n                                  (get names v)\n                                  (rename-identities v names))]))\n                   x)\n    (vector? x) (mapv #(rename-identities % names) x)\n    :else x))\n\n\n(defn logical-descriptors\n  \"§5.5: {logical name -> stream descriptor, identities renamed} over every\n   stream m holds. canonical-under erases a marker's descriptor, so the\n   lanes' descriptors are shown equivalent on these, separately.\"\n  [m]\n  (let [names (ring-names m)]\n    (into {} (keep (fn [[k h]]\n                     (when (satisfies? stream/IDaoStreamDescriptor h)\n                       [k (rename-identities (stream/descriptor h) names)])))\n          (:resources m))))\n\n\n(defn descriptors-equivalent?\n  \"Each lane's logical-descriptors, one per lane: equal maps.\"\n  [ds]\n  (apply = ds))\n\n\n(defn identities-in\n  \"The members of ids anywhere in x.\"\n  [x ids]\n  (cond\n    (contains? ids x) #{x}\n    (map? x) (into #{} (mapcat #(identities-in % ids)) (concat (keys x) (vals x)))\n    (coll? x) (into #{} (mapcat #(identities-in % ids)) x)\n    :else #{}))\n\n\n(defn task-root\n  \"§5.5 over decoded task: positions renamed, re-emitted, then\n   canonical-under the served correspondence; no lane identity survives.\"\n  [task m peer]\n  (let [names (logical-names m peer)\n        canonical (rows/canonical-under (rows/emit (logical-positions task m)) names)]\n    (is (empty? (identities-in (:yin.k/rows canonical) (into (set (keys names)) (keys (ring-names m)))))\n        \"every lane identity was renamed\")\n    (:yin.k/root canonical)))\n\n\n(defn logical-root\n  \"§5.5: the lift's root id with every lane identity replaced by the\n   fixture's logical name.\"\n  [wire m peer]\n  (task-root (rows/decode wire) m peer))\n\n\n(defn lane-root\n  \"Build on lane, lift: {:root under the logical names, :reference the\n   lane's own run, :lane the kernel the world ran on, :descriptors, and\n   :task :machine :peer for the controls}.\"\n  [lane build]\n  (scoped\n    (fn []\n      (let [world (on-lane lane build)\n            m (:machine world)\n            {:keys [serve! peer]} (served (or (:surfaces world) #{:reader}))\n            task (rows/decode (lane-lift m serve!))]\n        (is (nil? (rows/validate-frames task)) \"law 6 on every lane\")\n        {:root (task-root task m peer)\n         :reference (reference (on-lane lane build))\n         :lane (lane-of m) :descriptors (logical-descriptors m)\n         :task task :machine m :peer peer}))))\n\n\n(defn canonical-equality\n  \"Law 4 for one case: exactly the three distinct kernel lanes lift to one\n   root, their streams' descriptors are equivalent under the\n   correspondence, and each lane's own run answers the reference.\"\n  [build expected]\n  (let [roots (mapv #(lane-root % build) lanes)]\n    (is (= 3 (count roots)))\n    (is (= [:semantic-register :stack :register] (mapv :lane roots)) \"three distinct kernel lanes\")\n    (is (apply = (map :root roots)) \"law 4: one root id on every lane\")\n    (is (descriptors-equivalent? (mapv :descriptors roots)) \"descriptors equivalent under the correspondence\")\n    (doseq [{:keys [lane reference]} roots]\n      (is (:halted reference) (str lane \" completes\"))\n      (when (some? expected) (is (= expected (:value reference)) (str lane \" answers the reference\"))))\n    roots))\n\n\n(defn control-root\n  \"A lane's root with its decoded task changed by f first.\"\n  [{:keys [task machine peer]} f]\n  (let [task' (f task)]\n    (is (not= task task') \"the control changed the task\")\n    (task-root task' machine peer)))\n\n\n(defn first-binding\n  \"Pairs node n with the value of its first pair whose key satisfies pred\n   replaced by v.\"\n  [n pred v]\n  (let [ps (pairs-of n)\n        i (first (keep-indexed (fn [i [k _]] (when (pred k) i)) ps))]\n    (if i (rows/node (:kind n) (mapcat identity (assoc-in ps [i 1] v))) n)))\n\n\n(deftest law-4-controls\n  ;; §5.5 (D1): a changed position offset, descriptor field, saved value or\n  ;; lexical value changes what law 4 compares\n  (let [roots (canonical-equality #(bare 1) [\"A\" \"B\"])\n        [sr stack-lane register-lane] roots\n        base (:root sr)]\n    (testing \"the three lanes agree\"\n      (is (= base (:root stack-lane) (:root register-lane))))\n    (testing \"a cursor position's offset\"\n      (is (not= base (control-root stack-lane\n                                   (fn [t]\n                                     (replace-nodes t #(= :cursor-cell-body (:kind %))\n                                                    (fn [n] (update-in n [:slots 1 :dao.stream.ringbuffer/position] inc))))))))\n    (testing \"a stream descriptor's nonidentity field\"\n      (let [ds (mapv :descriptors roots)\n            k (first (keys (first ds)))]\n        (is (some? k))\n        (is (descriptors-equivalent? ds))\n        (is (not (descriptors-equivalent? (update-in ds [2 k :dao.stream/descriptor] assoc :review/extra :different))))))\n    (testing \"a saved window value\"\n      (is (not= base (control-root register-lane\n                                   (fn [t]\n                                     (replace-nodes t #(= :window (:kind %))\n                                                    (fn [n] (first-binding n some? [:lit :control]))))))))\n    (testing \"a lexical value\"\n      (is (not= base (control-root sr\n                                   (fn [t]\n                                     (replace-nodes t #(= :env (:kind %))\n                                                    (fn [n] (update-in n [:slots 0] first-binding #{'a} [:lit :control]))))))))))\n\n\n(deftest cross-engine-canonical-equality-bare\n  ;; the quick-tier slice of acceptance 10: every lane row once, bare;\n  ;; §5.3's shared fragment, 16 cases over three distinct kernel lanes\n  (let [n (atom 0)]\n    (doseq [[row r build] lane-rows]\n      (testing (str \"row \" row)\n        (canonical-equality #(build identity) r)\n        (swap! n inc)))\n    (testing \"row 20\"\n      (canonical-equality tail-effect-halt \"B\")\n      (swap! n inc))\n    (is (= 16 @n))))\n\n\n(deftest ^:slow cross-engine-canonical-equality\n  ;; acceptance 10: law 4 over §5.3's shared fragment, 61 cases, each over\n  ;; exactly three distinct kernel lanes\n  (slow/guard\n    \"cross-engine-canonical-equality\"\n    (fn []\n      (let [cases (lane-cases) n (atom 0)]\n        (is (= 61 (count cases)) \"15 lane rows x 4 segments + row 20\")\n        (doseq [[row label expected build] cases]\n          (testing (str \"row \" row \" \" (name label))\n            (canonical-equality build expected)\n            (swap! n inc)))\n        (is (= 61 @n))))))\n\n\n(def ordered-pairs\n  \"Law 5's six ordered pairs of distinct lanes.\"\n  (into [] (mapcat (fn [from] (keep (fn [to] (when (not= from to) [from to])) lanes))) lanes))\n\n\n(def unlowerable\n  \"[row receiver] pairs a de Bruijn receiver cannot continue (§5.3): row\n   4 is lifted from a de Bruijn source but not lowered into a de Bruijn\n   receiver, whose re-park names its own call pair\n   (ffi/response-wait-entry), not the carried response cursor cell the\n   semantic-register kernel restores. Emptied when the retained-FFI seam\n   (§4, 6c-post-D2) lands, raising law 5 to 366 and 96.\"\n  #{[4 :stack] [4 :register]})\n\n\n(defn crossed\n  \"Lift on from, lower into a fresh receiver on to, satisfy through the\n   source's streams: the run's observables and attaches.\"\n  [from to build]\n  (scoped\n    (fn []\n      (let [world (on-lane from build)\n            {:keys [toy peer serve!]} (served (or (:surfaces world) #{:reader}))\n            wire (lane-lift (:machine world) serve!)\n            receiver ((or (:receiver world) (constantly nil)))\n            {:keys [attach!] n :count} (recording-attacher toy)\n            recv (lane-lower to (merge {:attach-stream attach!} (:opts receiver)) wire attach!)\n            _ (is (= to (lane-of recv)))\n            attaches @n\n            done (satisfy world recv #(drive-peers % [peer]))\n            _ (s/serve-mirror! peer)]\n        (when-let [f (:finish world)] (f))\n        (when-let [f (:finish receiver)] (f))\n        {:attaches attaches :wire wire\n         :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))))\n\n\n(defn cross-lowering\n  \"Law 5 for one case: every admitted ordered pair continues to the\n   reference. Answers the pairs that ran.\"\n  [row build]\n  (let [ref (reference (on-lane :semantic-register build))]\n    (is (:halted ref))\n    (reduce (fn [ran [from to]]\n              (if (contains? unlowerable [row to])\n                ran\n                (testing (str (name from) \" -> \" (name to))\n                  (let [got (crossed from to build)]\n                    (is (= (count (stream-identities (:wire got))) (:attaches got)))\n                    (is (= (select-keys ref [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n                        \"law 5: the lowered run continues to the reference\")\n                    (conj ran [from to])))))\n            []\n            ordered-pairs)))\n\n\n(deftest cross-engine-lowering-bare\n  ;; the quick-tier slice of acceptance 11: every lane row once, bare;\n  ;; §5.3's shared fragment, 92 transfers (96 once unlowerable is emptied)\n  (is (= 6 (count ordered-pairs)))\n  (let [ran (atom 0)]\n    (doseq [[row _ build] lane-rows]\n      (testing (str \"row \" row)\n        (let [pairs (cross-lowering row #(build identity))]\n          (is (= (if (= 4 row) 2 6) (count pairs)) \"every admitted ordered pair ran\")\n          (swap! ran + (count pairs)))))\n    (testing \"row 20\"\n      (is (= 6 (count (cross-lowering 20 tail-effect-halt))))\n      (swap! ran + 6))\n    (is (= 92 @ran) \"16 cases x 6 pairs, less row 4's 4 into a de Bruijn receiver\")))\n\n\n(deftest ^:slow cross-engine-lowering\n  ;; acceptance 11: law 5, six ordered pairs over §5.3's shared fragment,\n  ;; 350 transfers (366 once unlowerable is emptied)\n  (slow/guard\n    \"cross-engine-lowering\"\n    (fn []\n      (let [ran (atom 0) cases (lane-cases)]\n        (is (= 61 (count cases)))\n        (doseq [[row label _ build] cases]\n          (testing (str \"row \" row \" \" (name label))\n            (swap! ran + (count (cross-lowering row build)))))\n        (is (= 350 @ran) \"61 cases x 6 pairs, less row 4's 4 per segment\")))))\n\n\n(defn register-judge\n  \"The frame validator's verdict on register entry `entry` of m,\n   reconstructed through the layout.\"\n  [m entry]\n  (let [sp (kernel-space m)\n        p (layout/lift-state (layout/lift-context m sp (:owner m)) entry)\n        code-map (into {} (map (fn [[a sg]] [a (:vector sg)])) (:segments sp))\n        as-sr {:code (into {} (map (fn [a] [a {:address a}])) (keys code-map))}]\n    (:yin.k/kind (frame/defect (ft/canonical as-sr p true) code-map :wait {:free-env {} :ffi-call-ids #{}}))))\n\n\n(defn spare-register\n  \"A physical register of the entry's body outside its live set and its\n   destination that R gives exactly one virtual.\"\n  [m entry]\n  (let [sg (val (first (:segments (kernel-space m))))\n        site (- (:site-pc entry) (layout/offset :register m sg))\n        body (nth (:phys sg) (code/body-index (:bodies sg) site))\n        unique (keep (fn [[s xs]] (when (= 1 (count xs)) s)) (group-by body (keys body)))]\n    (first (remove (conj (set (:live entry)) (:dest entry)) (sort unique)))))\n\n\n(def layout-corpus\n  \"C, [label ast]: the B0 corpus, the phase-3 corpus, then a tail call in\n   operand position, whose dead layout syntax reads registers other than\n   the call's own (phase-5 §6.3's last golden).\"\n  (conj (into (mapv (fn [[label ast _]] [label ast]) b0/corpus) corpus/programs)\n        [:tail-operand (corpus/app (corpus/v 'f) (corpus/tail (corpus/app (corpus/v 'g) (corpus/v 'x))) (corpus/v 'y))]))\n\n\n(defn- parking-site?\n  \"Rule A1: a non-tail parking instruction.\"\n  [t]\n  (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} (nth t 0))\n      (and (= :call (nth t 0)) (not (code/tail-call? t)))))\n\n\n(defn ambiguous-dead-slots\n  \"[v p s] over C: a reachable parking pc p and a physical slot s of its\n   body that R gives two or more virtuals, outside live-out*(p)'s image\n   and p's destination.\"\n  []\n  (into []\n        (mapcat (fn [[_ ast]]\n                  (let [v (:vector (linearize/project ast))\n                        sg (segment-of v)\n                        reach (into #{} (mapcat #(analysis/reachable v (:start %))) (code/body-ranges v))]\n                    (mapcat (fn [p]\n                              (let [rd (code/rd (nth v p))\n                                    body (nth (:phys sg) (code/body-index (:bodies sg) p))\n                                    used (into #{} (map #(layout/phys sg p %))\n                                               (cond-> (layout/live-out sg p) (some? rd) (conj rd)))]\n                                (keep (fn [[s xs]] (when (and (< 1 (count xs)) (not (contains? used s))) [v p s]))\n                                      (sort-by key (group-by body (keys body))))))\n                            (filter #(parking-site? (nth v %)) (sort reach))))))\n        layout-corpus))\n\n\n(defn register-entry\n  \"A register kernel k's wait entry parked after pc p of v, its window the\n   live registers holding :v, plus slot extra holding :x when given.\"\n  [k v p extra]\n  (let [sg (segment-of v)\n        off (layout/offset :register k sg)\n        rd (code/rd (nth v p))\n        regs (vec (sort-by first (cond-> (mapv (fn [r] [r :v]) (layout/register-live sg p))\n                                   (some? extra) (conj [extra :x]))))]\n    {:site-pc (+ off p) :pc (+ off p 1) :regs regs :live (mapv first regs)\n     :dest (when (some? rd) (layout/phys sg p rd)) :continuation [] :resume-mode :write-result\n     :frames (mapv (fn [c] (vec (repeat (count (nth (nth v c) 2)) nil))) (layout/chain sg (inc p)))}))\n\n\n(deftest layout-refusals\n  (testing \"a kernel stepped to a non-safepoint pc\"\n    (doseq [lane [:stack :register]]\n      (testing (name lane)\n        (let [m (on-lane lane #(vm/step (load-program (machine) (s/app (s/lam ['p] (s/lit 42)) (s/lit 1)))))\n              n (atom 0)\n              {:keys [serve!]} (served #{:reader})\n              d (error #(lane-lift m (fn [h] (swap! n inc) (serve! h))))]\n          (is (not (vm/halted? m)))\n          (is (= :yin.k/not-at-safepoint (:yin.k/status d)) (pr-str d))\n          (is (zero? @n) \"no stream was served\")\n          (testing \", its registers read as a payload\"\n            (let [entry (if (= :stack lane)\n                          (select-keys m [:pc :frames :stack :continuation])\n                          (assoc (select-keys m [:pc :frames :continuation]) :regs [] :resume-mode :write-result))\n                  cx (layout/lift-context m (kernel-space m) (:owner m))]\n              (is (= :yin.k/not-at-safepoint (:yin.k/status (error #(layout/lift-state cx entry)))))))))))\n  (testing \"a register entry whose live was tampered\"\n    (let [m (:machine (on-lane :register #(bare 1)))\n          entry (first (:wait-set m))\n          live (:live entry)\n          spare (spare-register m entry)]\n      (is (nil? (register-judge m entry)) \"the untampered entry reconstructs a valid frame\")\n      (is (seq live))\n      (is (= :window-missing (register-judge m (assoc entry :live (vec (rest live)) :regs (vec (rest (:regs entry))))))\n          \"a live register dropped\")\n      (is (some? spare))\n      (is (= :window-extra (register-judge m (assoc entry :live (vec (sort (conj live spare)))\n                                                    :regs (vec (sort-by first (conj (:regs entry) [spare :x]))))))\n          \"a dead register added\")))\n  (testing \"a register entry tampered with an ambiguous dead preimage: the layout refuses\"\n    (let [fixtures (ambiguous-dead-slots)]\n      (is (seq fixtures) \"C holds one: the allocator reuses slots\")\n      (doseq [[v p s] fixtures]\n        (let [sp (layout/space [v])\n              k (layout/attach-space (on-lane :register machine) sp)\n              cx (layout/lift-context k sp (:owner k))\n              d (error #(layout/lift-state cx (register-entry k v p s)))]\n          (is (map? (layout/lift-state cx (register-entry k v p nil))) \"untampered, the entry lifts\")\n          (is (= [:yin.k/non-portable :register-layout] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n          (is (= {:yin.k/pc p :yin.k/register s} (select-keys d [:yin.k/pc :yin.k/register])))))))\n  (testing \"a primitive in a window, a lexical binding, a closure's capture or a window's guest collection: the register kernel cannot hold it, refused before any attach\"\n    (doseq [[label op expected path?]\n            [[:window (s/app (s/v 'conj) (s/lit []) read-op) [\"B\"]\n              #(= [:frames 0 :window] (subvec % 0 3))]\n             ;; the read under cat, whose closure captures no primitive: s/then\n             ;; would save its own closure, which captures the binding too\n             [:lexical (s/app (s/lam ['q] (cat-of (cat-of (s/lit []) read-op) (s/app (s/v 'q) (s/lit []) (s/lit 1))))\n                              (s/v 'conj))\n              [\"B\" [1]] #(= '[:frames 0 :env q] %)]\n             [:captured (s/let1 'g (s/lam ['h] (s/lam ['x] (s/app (s/v 'h) (s/lit []) (s/v 'x))))\n                                (s/let1 'k (s/app (s/v 'g) (s/v 'conj))\n                                        (cat-of (cat-of (s/lit []) read-op) (s/app (s/v 'k) (s/lit 2)))))\n              [\"B\" [2]] #(= '[:frames 0 :env k h] %)]\n             [:nested (s/app (s/lam ['w 'r] (s/v 'r)) (cat-of (s/lit []) (s/v 'conj)) read-op) \"B\"\n              #(and (= 5 (count %)) (= [:frames 0 :window] (subvec % 0 3)) (= 0 (peek %)))]]]\n      (testing (str \" \" (name label))\n        (let [build #(reader % op)\n              world (build identity)\n              {:keys [serve! toy]} (served #{:reader})\n              wire (rows/lift-task (:machine world) serve! (lift-opts))\n              {:keys [attach!] n :count} (recording-attacher toy)\n              d (error #(lane-lower :register {:attach-stream attach!} wire attach!))]\n          (is (= [:yin.k/unsupported :continuation-registers] [(:yin.k/status d) (:yin.k/kind d)]) (pr-str d))\n          (is (path? (:yin.k/path d)) (pr-str (:yin.k/path d)))\n          (is (zero? @n) \"refused before any attachment\")\n          (testing \", the stack kernel holds it\"\n            (let [ref (reference (build identity))\n                  got (crossed :semantic-register :stack #(build identity))]\n              (is (= expected (:value ref)))\n              (is (= (:value ref) (:value got))))))))))","numLines":494,"startLine":1405,"totalLines":1899}},"tool_result_meta":[{"id":"toolu_01Vx5sBLX2SfWiDYb8L5XAz6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
