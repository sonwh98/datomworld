\"cljd compile failed, exit\" exit)\n      (System/exit exit))))\n\n\n(defn shard\n  \"Greedy balanced partition of `files` into `n` groups by file size.\n   Deterministic: ties are broken by path.\"\n  [files n]\n  (let [sized (sort-by (juxt (comp - fs/size) identity) files)\n        init  (vec (repeat n {:size 0 :files []}))]\n    (->> sized\n         (reduce (fn [shards f]\n                   (let [i (first (first (sort-by\n                                           (juxt (comp :size second) first)\n                                           (map-indexed vector shards))))]\n                     (-> shards\n                         (update-in [i :size] + (fs/size f))\n                         (update-in [i :files] conj f))))\n                 init)\n         (map (comp sort :files))\n         (remove empty?))))\n\n\n(defn- shard-source\n  \"Dart source of an aggregator importing `files` and calling each main.\"\n  [files]\n  (let [rel (fn [f]\n              (str (fs/relativize (fs/absolutize shard-dir)\n","exit_code":0,"status":"completed"}}
