s u]\n    [yin.vm :as vm]\n    [yin.vm.data :as data]\n    [yin.vm.module :as module]))\n\n\n;; =============================================================================\nsrc/cljc/yang/python/antlr/safepoint.cljc:41:   the hooks name base keys only inside their bodies. `module-uast` is the\nsrc/cljc/yang/python/antlr/safepoint.cljc:249:(def module-uast\nsrc/cljc/yang/python/antlr/safepoint.cljc:274:                (remove (conj (prelude/defined-keys module-uast) 'yin/def)\nsrc/cljc/yang/python/antlr/safepoint.cljc:275:                        (prelude/free-names module-uast)))))\nsrc/cljc/yang/python/antlr/safepoint.cljc:278:(defn module-spec\nsrc/cljc/yang/python/antlr/safepoint.cljc:292:   :ast module-uast,\nsrc/cljc/yang/python/antlr/lower.cljc:1850:(defn module-spec\nsrc/cljc/yang/python/antlr/lower.cljc:1870:     :ast ast,\nsrc/cljc/yang/python/antlr/prelude.cljc:162:   ahead of its body; `module-uast` is the same list as the linker\nsrc/cljc/yang/python/antlr/prelude.cljc:3375:(def module-uast\nsrc/cljc/yang/python/antlr/prelude.cljc:3432:                (remove (conj (defined-keys module-uast) 'yin/def)\nsrc/cljc/yang/python/antlr/prelude.cljc:3433:                        (free-names module-uast)))))\nsrc/cljc/yang/python/antlr/prelude.cljc:3436:(defn module-spec\nsrc/cljc/yang/python/antlr/prelude.cljc:3447:   :ast module-uast,\ncat: src/cljc/dao/test_slow.cljc: No such file or directory\n    {:vector\n     (mapv (fn [pc]\n             (let [[op rd x y :as t] (nth v pc)]\n               (case op\n                 :var (let [{:keys [bound free]}\n                            (db/resolve-name (nth frames (code/body-index bodies pc)) x)]\n                        (if bound\n                          (do (vswap! names assoc pc x)\n                              (into [:load-bound rd] bound))\n                          [:load-free rd free]))\n                 :closure [:closure rd (count x) y]\n                 t)))\n           (range (count v)))\n     :bodies bodies\n     :names @names}))\n\n\n(defn addresses\n  \"Lexical references in pc order, from A, a resolved vector or a native\n   instruction vector (register or stack). Returns a vector, no identity.\"\n  [v]\n  (let [v (if (map? v) (or (:vector v) (:instructions v)) v)\n        v (if (some #(= :var (first %)) v) (:vector (resolve v)) v)]\n    (into []\n          (keep (fn [t]\n                  (case (first t)\n                    :load-bound (into [:bound] (subvec t (- (count t) 2)))\n                    :load-free [:free (peek t)]\n                    nil)))\n          v)))\n\n\n(defn resolved-addresses\n  \"Read lexical references from the old resolver's occurrence tuples.\n   Walk main then queued lambda bodies; definitions visit only their value.\n   This diagnostic reader never lowers or assigns an identity.\"\n  [{:keys [tuples]}]\n  (let [attrs (reduce (fn [m [e a v]] (assoc-in m [e a] v)) {} tuples)\n","exit_code":0,"status":"completed"}}
