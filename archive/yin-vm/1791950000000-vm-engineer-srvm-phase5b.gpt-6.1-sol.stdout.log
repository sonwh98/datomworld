{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '260,280p' src/cljc/yin/vm/debruijn_register_code.cljc; rg -n 'defn lower-packet' src/cljc/yang/python/antlr/lower.cljc; sed -n '1020,1032p' src/cljc/yang/python/antlr/lower.cljc; clojure -M -e \\\"(require '[yin.vm.semantic-register.derive-test :as t] '[yin.vm.debruijn-register-code :as r]) (prn (mapv r/register-hash t/register-golden-images))\\\"\"","aggregated_output":"\n(defn register-hash\n  \"The ONE function that computes R (design section 3): `R = sha256\n   (register-descriptor-hash || canonical-register-vector)`. Received\n   register bytes must be hashed before decoding, as B1's wire rule\n   requires -- no receive path exists in this phase, but this function's\n   own shape (bytes in, hash out, no host-value peeking) already supports\n   that later use.\"\n  [register-image]\n  (jing/sha256 (str descriptor-hash (encode-register-image register-image))))\n\n\n;; =============================================================================\n;; body-liveness (design section 4.5)\n;; =============================================================================\n;; A standard backward dataflow, one pure function of the instruction\n;; vector and the body ranges: per pc, use/def from the section 4.4\n;; table, successors from the control-flow rule (a tail `:call` has none,\n;; a non-tail `:call` falls through like any other instruction), then\n;; `live-in(p) = use(p) + (live-out(p) - def(p))`, `live-out(p) = union\n;; of live-in(s) over successors s`, iterated to a fixpoint. The fixpoint\n1748:(defn lower-packet\n                  (fn [i e]\n                    (assign-target ctx\n                                   (if (p/rule? e \"star_expr\") (last (kids ctx e)) e)\n                                   (app* 'py/arg (u/v u) (u/lit i))))\n                  elems))))))\n\n\n(defn- assign-target\n  \"Store `value` (a node, evaluated once here) into target `t`.\"\n  [ctx t value]\n  (if-let [nm (scope/simple-name (:pk ctx) t)]\n    (assign-name ctx nm value)\n    (if-let [elems (target-elements ctx t)]\nLoading initial Timbre config from: :default\nExecution error (FileNotFoundException) at user/eval4422 (REPL:1).\nCould not locate yin/vm/semantic_register/derive_test__init.class, yin/vm/semantic_register/derive_test.clj or yin/vm/semantic_register/derive_test.cljc on classpath. Please check that namespaces with dashes use underscores in the Clojure file name.\n\nFull report at:\n/var/folders/n0/xl3_1xkn0yd5trpq843l81840000gn/T/clojure-168229209605016977.edn\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\np='test/yin/vm/semantic_register/derive_test.cljc';s=open(p).read().replace('[clojure.edn :as edn]','''[clojure.edn :as edn]\n            [dao.test-slow :as slow]\n            [yang.python.antlr.import-programs :as programs]\n            [yang.python.antlr.linked-harness :as h]\n            [yang.python.antlr.lower :as lower]\n            [yang.python.antlr.prelude :as prelude]\n            [yang.python.antlr.safepoint :as safepoint]\n            [yang.python.antlr.render :as render]\n            [yang.python.antlr.uast :as u]\n            [yin.repl.link :as link]''')\ns+='''\n\n(def c4-root-rows\n  [[\\\"o\\\" programs/o-packet [\\\"a\\\" \\\"m-body\\\" \\\"b\\\"]]\n   [\\\"q\\\" programs/q-packet [\\\"m-body\\\" \\\"done\\\"]]\n   [\\\"d\\\" programs/d-packet [\\\"m-body\\\" \\\"7\\\"]]\n   [\\\"c\\\" programs/c-packet [\\\"m-body\\\" \\\"5\\\" \\\"absent\\\" \\\"('gone', 5)\\\"]]\n   [\\\"r\\\" programs/r-packet [\\\"w-once\\\" \\\"cleaned\\\" \\\"w-once\\\" \\\"again\\\"]]\n   [\\\"x\\\" programs/x-packet [\\\"caught-e\\\"]]\n   [\\\"nn\\\" programs/nn-packet [\\\"n\\\"]]\n   [\\\"main\\\" nil [\\\"__main__\\\"]]\n   [\\\"s\\\" programs/s-packet [\\\"m-body\\\" \\\"True\\\" \\\"True\\\"]]\n   [\\\"tt\\\" programs/tt-packet [\\\"k-body\\\" \\\"t-sees 3\\\" \\\"t-done\\\"]]])\n\n\n(defn c4-task\n  [family pipeline ast source]\n  (let [pair (link/make-pair)\n        opts (h/composition (h/registry) pair)\n        task (case family\n               :stack (dvm/create-vm (:image (if (= pipeline :old)\n                                              (dl/adapt (vm/ast->datoms ast))\n                                              (derive/stack-image (projected ast))))\n                                     (assoc opts :contract vm/stack-contract))\n               :register (rvm/create-vm (if (= pipeline :old)\n                                         (:image (rc/adapt (vm/ast->datoms ast)))\n                                         (derive/register-image (projected ast)))\n                                        (assoc opts :contract vm/register-contract)))]\n    (first (h/drive task pair source))))\n\n\n(deftest \"'^:slow c4-execution-oracle\n  (slow/guard\n    \"c4-execution-oracle\"\n    (fn []\n      (let [reg (h/registry) py (:address @h/published)\n            guests (reduce (fn [out [name packet deps]]\n                             (let [spec (lower/module-spec reg packet\n                                                           {:name name :py-address py\n                                                            :deps (into {} (map (fn [n] [n (:address (get out n))])) deps)})\n                                   result (h/publish-guest-module! spec)]\n                               (assoc out name {:address (:address result) :ast (:ast spec)})))\n                           {} [[\"k\" programs/k-packet []] [\"m\" programs/m-packet []]\n                               [\"t\" programs/t-packet [\"k\"]] [\"w\" programs/w-packet []]\n                               [\"e\" programs/e-packet []] [\"n\" programs/n-packet []]])\n            source (h/source (into {'\"'py py} (map (fn [[n x]] [(lower/module-symbol n) (:address x)])) guests))\n            modules (into [[\\\"py\\\" prelude/module-uast]\n                           [\\\"pysp\\\" (:ast (safepoint/module-spec reg py))]]\n                          (map (fn [n] [n (:ast (get guests n))])) [\\\"k\\\" \\\"m\\\" \\\"t\\\" \\\"w\\\" \\\"e\\\" \\\"n\\\"])\n            main (u/mark-tails (u/seq-nodes\n                                [(u/sexp->uast '(require (quote py)))\n                                 (u/sexp->uast '(require (quote pym.n)))\n                                 (u/sexp->uast '(py/init\"'!))\n                                 (u/app (u/v '\"'py/run-main) (u/v 'pym.n/body))]))]\n        (is (= 10 (count c4-root-rows)))\n        (is (= 8 (count modules)))\n        (doseq [[label packet output] c4-root-rows]\n          (let [ast (if packet (lower/lower-packet packet {:prelude :linked}) main)]\n            (doseq [family [:stack :register]]\n              (println \\\"C4 root\\\" label family)\n              (testing (str \\\"root \\\" label \\\" \\\" family)\n                (let [observe (fn [pipeline]\n                                (let [task (c4-task family pipeline ast source)]\n                                  [(vm/halted? task) (vm/blocked? task) (render/output (vm/value task))]))\n                      old (observe :old) new (observe :new)]\n                  (is (= old new))\n                  (is (= [true false {:py/out output :py/exception nil}] old new)))))))\n        (doseq [[label ast] modules family [:stack :register]]\n          (println \\\"C4 module\\\" label family)\n          (testing (str \\\"module \\\" label \\\" \\\" family)\n            (let [old (c4-task family :old ast source) new (c4-task family :new ast source)\n                  observe (fn [task] [(vm/halted? task) (vm/blocked? task) (native-normalize (vm/store task))])]\n              (is (= (observe old) (observe new)))\n              (is (= [true false] [(vm/halted? new) (vm/blocked? new)]))\n              (is (= (prelude/defined-keys ast) (set (keys (vm/store old))) (set (keys (vm/store new))))))))\n        (println \\\"C4 completed: 10 root programs; 8 module bodies; both kernel families\\\")\n        ;; Install-child execution over newly published images is phase 8.\n        ))))\n'''\nopen(p,'w').write(s)\nPY\nclojure -M:test -n yin.vm.semantic-register.derive-test -e :slow -n yin.vm.debruijn-register-code-test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
