             :exit (.exitValue process)})\n182\t                  :done (do (.waitFor process 60 TimeUnit/SECONDS)\n183\t                            {:spec spec :events events :killed? false\n184\t                             :report (:report e)\n185\t                             :host host :pid (:pid (first events))})\n186\t                  :error (throw (ex-info (str \"stage E: a peer failed: \" (:message e))\n187\t                                         {:host host :spec spec :event e\n188\t                                          :stderr (slurp err-file)}))\n189\t                  (recur events)))))))\n190\t      (finally\n191\t        (when (.isAlive process) (destroy! process))))))\n192\t\n193\t\n194\t;; =============================================================================\n195\t;; The durability record\n196\t;; =============================================================================\n197\t\n198\t\n199\t(def ^:private record-file \"target/stage-e-durability.edn\")\n200\t\n201\t\n202\t(defn- record!\n203\t  [scenario [src rcv] results]\n204\t  (let [line {:scenario (:id scenario)\n205\t              :transport :separate-processes\n206\t              :pair [src rcv]\n207\t              :lives (mapv (fn [r]\n208\t                             {:host (:host r)\n209\t                              :role (get-in r [:spec :on])\n210\t                              :pid (:pid r)\n211\t                              :cut (get-in r [:spec :cut])\n212\t                              :killed? (:killed? r)\n213\t                              :exit (:exit r)})\n214\t                           results)}]\n215\t    (io/make-parents record-file)\n216\t    (spit record-file (str (pr-str line) \"\\n\") :append true)\n217\t    line))\n218\t\n219\t\n220\t(defn run-pair!\n221\t  \"Run `scenario` over ordered host pair [src rcv]: each life on the host\n222\t   its :on names, the inspection and the check here.\"\n223\t  [scenario [src rcv :as pair]]\n224\t  (let [results (