{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"cat > /private/tmp/srvm-stage1-mutants.py <<'PY'\nfrom pathlib import Path\nimport subprocess,hashlib,json\np=Path('src/cljc/yin/vm/semantic_register.cljc');original=p.read_bytes();text=original.decode()\nmutants=[\n ('wrong-rd','(get-in entry [:deliver :rd]) value)','999 value)'),\n ('save-too-much',':window (select-keys W (analysis/saved facts (inc pc) rd))',':window W'),\n ('save-too-little',':window (select-keys W (analysis/saved facts (inc pc) rd))',':window {}'),\n ('tail-restores-window','{:segment seg :site pc :k K :deliver {:deliver :return}}','{:segment seg :site pc :pc (inc pc) :env {} :window {} :k K :deliver {:deliver :rd :rd 0}}'),\n ('deliver-extra-register','(assoc (:window entry) (get-in entry [:deliver :rd]) value)','(assoc (:window entry) (get-in entry [:deliver :rd]) value 999 value)'),\n ('non-abortive-invoke','(recur restored (:segment control) (:pc control) (:window restored)\\\\n                                 (:env restored) (or (:k restored) []) remaining))))','(recur machine seg (inc pc) (assoc W rd value) E K remaining))))'),\n ('window-not-root',':values [(:env machine) (:window machine) (:value machine)]',':values [(:env machine) (:value machine)]'),\n ('tail-pop-extra-key','(assoc frame :window (assoc (:window frame) (:rd frame) value))','(assoc frame :window (assoc (:window frame) (:rd frame) value 0 value))')]\nresults=[]\nfor name,needle,replacement in mutants:\n assert text.count(needle)==1,(name,text.count(needle))\n try:\n  p.write_text(text.replace(needle,replacement,1))\n  r=subprocess.run(['clojure','-M:test','-n','yin.vm.semantic-register.effects-test'],capture_output=True,text=True,timeout=120)\n  out=r.stdout+r.stderr\n  Path('/private/tmp/srvm-stage1-mutant-'+name+'.log').write_text(out)\n  lines=out.splitlines(); failures=[x for x in lines if x.startswith(('FAIL in','ERROR in','Ran ','expected:')) or 'failures,' in x]\n  result={'mutant':name,'exit':r.returncode,'evidence':failures}\n  results.append(result);print(json.dumps(result),flush=True)\n finally:\n  p.write_bytes(original)\n  assert p.read_bytes()==original\nprint('Restored SHA256 '+hashlib.sha256(original).hexdigest(),flush=True)\nPath('/private/tmp/srvm-stage1-mutants.json').write_text(json.dumps(results,indent=2))\nPY\npython3 /private/tmp/srvm-stage1-mutants.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
