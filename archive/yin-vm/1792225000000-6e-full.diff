+(defn- crr
+  "`{:register {:continuation-registers n}}`, the register receiver's
+   primitive refusals, beside any other per-lane refusals."
+  ([n] (crr n {}))
+  ([n other] (assoc-in other [:register :continuation-registers] n)))
+
