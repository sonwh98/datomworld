\t      ;; straight onto `:stack`. By the time control reaches a `:push`,\n   408\t      ;; the value it would push is already there -- so here it is a no-op\n   409\t      ;; that only advances `pc`. Every value-producing opcode below\n   410\t      ;; (:stream-*, :gensym, :current-continuation, :resume, and the\n   411\t      ;; restore after :ffi-call) honours this, or a `:push` immediately\n   412\t      ;; after it would silently drop the value -- there is no `val`\n   413\t      ;; register to recover it from.\n   414\t      :push\n   415\t      (assoc vm :pc (inc pc))\n   416\t\n   417\t      :call\n   418\t      (let [argc (nth inst 1), tail? (nth inst 2)\n   419\t            total (count stack)\n   420\t            f-pos (- total argc 1)\n   421\t            f (nth stack f-pos)\n   422\t            args (subvec stack (inc f-pos) total)\n   423\t            stack' (subvec stack 0 f-pos)]\n   424\t        (cond\n   425\t          (and (map? f) (= :closure (:type f)))\n   426\t          (let [locals (bind-positional (:arity f) args)\n   427\t                body-frames (conj (:frames f) locals)\n   428\t                continuation' (if tail?\n   429\t                                continuation\n   430\t                                (conj continuation\n   431\t                                      {:return-pc (inc pc), :frames frames,\n   432\t                                       :stack-base (count stack')}))]\n   433\t            (assoc vm\n   434\t                   :pc (:body-pc f)\n   435\t                   :frames body-frames\n   436\t                   :stack stack'\n   437\t                   :continuation continuation'))\n   438\t\n   439\t          ;; A primitive host function, resolved by :load-free. The same\n   440\t          ;; path the named engine's `apply-call` uses for a `fn?` callee:\n   441\t          ;; a plain result lands on the stack; an effect descriptor (a\n   442\t          ;; `yin/def`, a `require`, a `stream` module call) is d