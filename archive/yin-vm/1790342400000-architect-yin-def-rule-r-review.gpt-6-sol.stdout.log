val ctx) bounded-row-evaluator)\n   793\t            {:keys [value error]} (run {:macro-tree macro-tree,\n   794\t                                        :env env,\n   795\t                                        :prelude (prelude gensym),\n   796\t                                        :max-steps (get-in ctx [:guards :max-steps])})]\n   797\t        (if error\n   798\t          {:error (assoc error :macro macro-root)}\n   799\t          {:tree value})))))\n   800\t\n   801\t\n   802\t(def default-guards\n   803\t  {:max-depth 100,\n   804\t   :max-rows-per-expansion 10000,\n   805\t   :max-rows-per-batch nil,\n   806\t   :max-steps 100000})\n   807\t\n   808\t\n   809\t(defn invoke\n   810\t  \"Run `macro-tree` (a self-contained lambda packet) on `operand-trees` and\n   811\t   return its result tree packet, unvalidated. Gensyms use `(:attempt ctx)`\n   812\t   as the attempt counter. Throws `ex-info` carrying the error data on an\n   813\t   arity, guard, suspension, or body failure.\"\n   814\t  [macro-tree operand-trees ctx]\n   815\t  (let [ctx (update ctx :guards #(merge default-guards %))\n   816\t        {:keys [tree error]} (invoke* macro-tree (vec operand-trees) ctx (:attempt ctx))]\n   817\t    (when error\n   818\t      (throw (ex-info \"Macro invocation failed\" error)))\n   819\t    tree))\n   820\t\n   995\t\n   996\t(defn- merge-output\n   997\t  \"Merge a validated result packet into the working index; an address whose\n   998\t   working body differs is an `:address-conflict`.\"\n   999\t  [st [_ rows]]\n  1000\t  (reduce (fn [st row]\n  1001\t            (let [prior (get (:index st) (first row))]\n  1002\t              (cond (nil? prior) (assoc-in st [:index (first row)] row)\n  1003\t                    (same-value? prior row) st\n  1004\t                    :else (reduced (assoc st ::conflict (first row))))))\n  1005\t          st\n  1006\t          rows))\n  1007\t\n  1008\t\n  1009\t(declare expand-node)\n  1010\t\n  1011\t\n  1012\t(defn- expand-call\n  1013\t  \"One recognized call: allocate an attempt, begin its event before any\n  1014\t   guard or invocation, run the transformer on the operand packets, validate\n  1015\t   and merge the result, finish the event, and reconsider the result at the\n  1016\t   same occurrence with depth + 1.\"\n  1017\t  [st address macro-tree {:keys [path rel frame shadow depth]}]\n  1018\t  (let [[st counter] (allocate-attempt st)\n  1019\t        ctx (:ctx st)\n  1020\t        macro-root (first macro-tree)\n  1021\t        begin (fn [output error]\n  1022\t                (event-row (attempt-id ctx counter)\n  1023\t                           (:source-batch st)\n  1024\t                           (when-not (:parent frame)\n  1025\t                             (source-origin ctx (:source-batch st) (:tree-index frame)))\n  1026\t                           (:parent frame)\n  1027\t                           (:root frame)\n  1028\t                           rel\n  1029\t                           macro-root\n  1030\t                           output\n  1031\t                           error))\n  1032\t        failed (fn [st error]\n  1033\t                 (-> st (record-event (begin nil error)) (fail error)))\n  1034\t        guards (:guards ctx)]\n  1035\t    (if (>= depth (:max-depth guards))\n  1036\t      [(failed st {:kind :depth-guard, :depth depth, :path path}) address]\n  1037\t      (let [row (get (:index st) address)\n  1038\t            operands (mapv #(packet-of (:index st) %) (nth row 3))\n  1039\t            {:keys [tree error]} (invoke* macro-tree operands ctx counter)\n  1040\t            invalid (fn [reason]\n  1041\t                      {:kind :invalid-output, :macro macro-root, :path path,\n  1042\t                       :reason reason})]\n  1043\t        (if error\n  1044\t          [(failed st error) address]\n  1146\t(defn expand-batch\n  1147\t  \"Expand one input batch against `ctx` (§3.2). Returns\n  1148\t   `{:status :ok :tree packet :log log :ctx ctx'}` or\n  1149\t   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\n  1150\t   consumed the batch (`:t` + 1) and every attempt it allocated; only\n  1151\t   success changes the store, to the post-harvest store.\"\n  1152\t  [batch ctx]\n  1153\t  (let [ctx (with-default-guards ctx)\n  1154\t        source-batch (:t ctx)\n  1155\t        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\n  1156\t        finish (fn [st]\n  1157\t                 (let [ctx' (update (:ctx st) :t inc)]\n  1158\t                   (if-let [e (:error st)]\n  1159\t                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\n  1160\t                     {:status :ok, :tree (:tree st), :log (log-packet st),\n  1161\t                      :ctx (assoc ctx' :store (:next-store st))})))\n  1162\t        {:keys [admitted error]} (admit batch)]\n  1163\t    (if error\n  1164\t      (let [[st counter] (allocate-attempt base)]\n  1165\t        (finish (-> st\n  1166\t                    (record-event (event-row (attempt-id ctx counter) source-batch\n  1167\t                                             (source-origin ctx source-batch nil)\n  1168\t                                             nil nil nil nil nil error))\n  1169\t                    (fail error))))\n  1170\t      (let [{:keys [trees indexes index run-index definitions]} admitted\n  1171\t            store0 (or (:store ctx) {})\n  1172\t            store (harvest store0 #(nth indexes %) definitions)\n  1173\t            catalogue (into []\n  1174\t                            (comp (filter :declared?)\n  1175\t                                  (map (fn [{:keys [name tree path value]}]\n  1176\t                                         {:name name,\n  1177\t                                          :macro-tree (packet-of (nth indexes tree) value),\n  1178\t                                          :source [tree path]})))\n  1179\t                            definitions)\n  1180\t            ;; only the run tree is expanded, so only its declarations are\n  1181\t            ;; replaced; every catalogue entry still resolves by index\n  1182\t            [index standins]\n  1183\t            (reduce (fn [[index acc] [k {:keys [name source]}]]\n  1184\t                      (if (= run-index (first source))\n  1185\t                        (let [[index s] (intern-body index [standin-tag name k])]\n   185\t\n   186\t### 2.2 Definition shape\n   187\t\n   188\tA harvested path must resolve to an `:application` equivalent to:\n   189\t\n   190\t```clojure\n   191\t(yin/def <literal-symbol> value)\n   192\t```\n   193\t\n   194\tIt has an operator `[:variable yin/def]`, exactly two operands, a first operand\n   195\t`[:literal sym]` where `sym` is a symbol, and a value subtree rooted at the\n   196\tsecond operand. A declared occurrence additionally requires a `:lambda` value\n   197\troot. No `:macro?` slot exists.\n   198\t\n   199\tEvery definition path must be harvested, including definitions in unexecuted\n   200\tbranches and non-running trees. Every harvest entry must resolve to this shape.\n   201\tMissing, duplicate, out-of-range, or non-definition entries fail with\n   202\t`:harvest-catalogue`; a declaration outside the catalogue or on a non-lambda\n   203\tdefinition fails with `:stray-macro-declaration`.\n   204\t\n   205\t### 2.3 Call site\n   334\t\n   335\tInitial harvest controls all calls in the current batch. Post-harvest controls\n   336\tthe next batch; there is no mid-batch mutation.\n   337\t\n   338\tPost-harvest starts from the store before initial harvest and walks the final\n   339\toccurrence tree.\n   340\tIt walks only the expanded run tree, so declarations and plain definitions in\n   341\tthe batch's other trees are batch-local: they take part in initial harvest and\n   342\tdo not persist into the next batch's store. A plain `(yin/def <literal sym> value)` removes `sym`; a valid\n   343\tstand-in installs its catalogue entry; later occurrences win.\n   344\t\n   345\tDeclaration order is:\n   346\t\n   347\t- for an application whose operator is a lambda, operands left to right and\n   348\t  then the lambda body; and\n   349\t- otherwise, child slots in grammar order and `nodes` children left to right.\n   350\t\n   351\tThis recovers source order for the immediately-applied-lambda lowering used by\n   352\t`do`, `let`, and the reference frontend suites. A new lowering must state how\n","exit_code":0,"status":"completed"}}
