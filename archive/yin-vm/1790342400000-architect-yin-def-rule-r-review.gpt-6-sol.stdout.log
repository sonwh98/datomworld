call-capacity` (the FFI pair,\n   126\t   built by `yin.vm/empty-state` exactly as the semantic VM's is), and\n   127\t   `:bridge` (host FFI handlers, attached by `yin.vm.ffi/attach`).\n   128\t\n   129\t   An empty segment starts halted with an empty program, as the semantic\n   130\t   VM's `create-vm` does; `load-image` loads work into it.\n   131\t\n   132\t   Always fresh: never resume or mutate a VM that has already run, per the\n   133\t   design's D4 fixture restriction (the named VM's environment-leak defect\n   134\t   is out of scope here and must not be reproduced by accident).\"\n   135\t  ([segment] (create-vm segment {}))\n   136\t  ([segment opts]\n   137\t   (let [base (vm/empty-state\n   138\t                (assoc (select-keys opts [:modules :make-stream :call-in\n   139\t                                          :call-out :call-capacity])\n   140\t                       :primitives (or (:primitives opts) {})))]\n   141\t     (-> (map->DebruijnVM\n   142\t           {:segment [],\n   143\t            :hash nil,\n   144\t            :pc 0,\n   145\t            :frames [],\n   146\t            :free-env (or (:free-env opts) {}),\n   147\t            :stack [],\n   148\t            :continuation [],\n   149\t            :store (merge (:store base) (:store opts)),\n   150\t            :blocked? false,\n   151\t            :halted? true,\n   136\t                 :hash (rcode/register-hash segment)\n   137\t                 :pc 0\n   138\t                 :frames []\n   139\t                 :registers (vec (repeat reg-count nil))\n   140\t                 :continuation []\n   141\t                 :halted? false\n   142\t                 :blocked? false\n   143\t                 :value nil))))))\n   144\t\n   145\t\n   146\t(defn create-vm\n   147\t  \"Build a fresh `DebruijnRegisterVM` over `segment`.\n   148\t   Options: `:free-env`, `:store`, `:primitives`, `:modules`, `:make-stream`,\n   149\t   `:call-in`/`:call-out`/`:call-capacity`, and `:bridge`.\"\n   150\t  ([segment] (create-vm segment {}))\n   151\t  ([segment opts]\n   152\t   (let [base (vm/empty-state\n   153\t                (assoc (select-keys opts [:modules :make-stream :call-in\n   154\t                                          :call-out :call-capacity])\n   155\t                       :primitives (or (:primitives opts) {})))]\n   156\t     (-> (map->DebruijnRegisterVM\n   157\t           {:segment {:bodies [], :instructions []},\n   158\t            :hash nil,\n   159\t            :pc 0,\n   160\t            :frames [],\n   161\t            :free-env (or (:free-env opts) {}),\n   162\t            :registers [],\n   163\t            :continuation [],\n   164\t            :store (merge (:store base) (:store opts)),\n   812\t     :modules       module registry value (see `yin.vm.module`)\n   813\t     :make-stream   (fn [capacity] -> create outcome); no default\n   814\t     :call-in       explicit inbound request handle\n   815\t     :call-out      explicit outbound response handle\n   816\t     :call-capacity capacity for a constructed FFI pair\n   817\t     :bridge        host FFI handlers\n   818\t\n   819\t   As for the walker: there is no `:in-stream` (program observation belongs\n   820\t   to `dao.stream.observer`), and construction is all-or-nothing — the FFI\n   821\t   pair and its call-out cursor are stream operations whose failure fails\n   822\t   here.\"\n   823\t  ([] (create-vm {}))\n   824\t  ([opts]\n   825\t   (when (contains? opts :in-stream)\n   826\t     (throw (ex-info\n   827\t              \"Program observation moved to dao.stream.observer: a VM no longer accepts :in-stream\"\n   828\t              {:in-stream (:in-stream opts)})))\n   829\t   (let [env (or (:env opts) {})\n   830\t         base (vm/empty-state\n   831\t                (assoc (select-keys opts\n   832\t                                    [:primitives :primitive-profiles\n   833\t                                     :primitive-canonical-names :modules\n   834\t                                     :make-stream :call-in :call-out\n   835\t                                     :call-capacity])\n   836\t                       :telemetry (:telemetry opts)\n   837\t                       :vm-model :semantic))]\n   838\t     (-> (map->SemanticVM (merge base\n   839\t                                 {:bridge nil,\n   840\t                                  :program nil,\n   841\t                                  :control nil,\n   842\t                                  :env env,\n   843\t                                  :stack [],\n   844\t                                  :k nil,\n   845\t                                  :value nil,\n   846\t                                  :code {},\n   847\t                                  :code-aliases {},\n   848\t                                  :halted? true,\n   849\t                                  :blocked? false}))\n   850\t         (telemetry/install :semantic)\n   851\t         (ffi/attach (:bridge opts))\n   852\t         (telemetry/emit-snapshot :init)))))\nsrc/cljc/yin/vm/debruijn/register.cljc:164:            :store (merge (:store base) (:store opts)),\nsrc/cljc/yin/vm/debruijn/stack.cljc:149:            :store (merge (:store base) (:store opts)),\nsrc/cljc/yin/vm/semantic.cljc:303:              11 (let [vm' (assoc vm :store (assoc (:store vm)\nsrc/cljc/yin/vm/ast_walker.cljc:145:  (let [{:keys [call-in]} (ffi/require-call-pair! (:store state) op)\n","exit_code":0,"status":"completed"}}
