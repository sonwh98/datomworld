c binding\"\n    50\t  [registry sym]\n    51\t  (get-in (:modules registry) (symbol->path sym)))\n    52\t\n    53\t\n    54\t(defn register-effect-handler\n    55\t  \"Return registry with handler-fn installed for effect keyword kw.\n    56\t   Handler: (fn [state effect opts] -> {:state s :value v :blocked? bool})\"\n    57\t  [registry kw handler-fn]\n    58\t  (assoc-in (or registry (empty-registry)) [:effect-handlers kw] handler-fn))\n    59\t\n    60\t\n    61\t(defn get-effect-handler\n    62\t  \"Get the handler function for an effect keyword.\"\n    63\t  [registry kw]\n    64\t  (get (:effect-handlers registry) kw))\n    65\t\n    66\t\n    67\t(defn list-modules\n    68\t  \"List the top-level module names in a registry value.\"\n    69\t  [registry]\n    70\t  (keys (:modules registry)))\n    71\t\n    72\t\n    73\t;; =============================================================================\n    74\t;; Effect descriptors\n    75\t;; =============================================================================\n  1620\t   composes beside the VM rather than inside it.\"\n  1621\t  ([] (empty-state {}))\n  1622\t  ([opts]\n  1623\t   (let [installed-primitives (or (:primitives opts) primitives)\n  1624\t         installed-profiles (or (:primitive-profiles opts)\n  1625\t                                (into {} (keep (fn [[name _]]\n  1626\t                                                 (when-let [profile\n  1627\t                                                            (profile-of\n  1628\t                                                              installed-primitives\n  1629\t                                                              name)]\n  1630\t                                                   [name profile])))\n  1631\t                                      installed-primitives))\n  1632\t         standard-aliases (into {}\n  1633\t                                (filter\n  1634\t                                  (fn [[alias canonical]]\n  1635\t                                    (and (identical?\n  1636\t                                           (primitive-function\n  1637\t                                             (get installed-primitives alias))\n  1638\t                                           (primitive-function\n  1639\t                                             (get primitives alias)))\n  1640\t                                         (identical?\n  1641\t                                           (primitive-function\n  1642\t                                             (get installed-primitives canonical))\n  1643\t                                           (primitive-function\n  1644\t                                             (get primitives canonical))))))\n  1645\t                                primitive-canonical-names)\n  1646\t         canonical-names (merge standard-aliases\n  1647\t                                (:primitive-canonical-names opts))\n  1648\t         _ (assert-primitive-reverse-lookup-unique! installed-primitives\n  1649\t                                                    canonical-names)\n  1650\t         make-stream (:make-stream opts)\n  1651\t         capacity (or (:call-capacity opts) default-call-capacity)\n  1652\t         supplied-in (:call-in opts)\n  1653\t         supplied-out (:call-out opts)]\n  1654\t     (when (and (not= (some? supplied-in) (some? supplied-out))\n  1655\t                (not (fn? make-stream)))\n  1656\t       (throw (ex-info \"Half a call pair is not a call pair: supply both :call-in and :call-out, or :make-stream, or neither\"\n  1657\t                       {:call-in? (some? supplied-in),\n  1658\t                        :call-out? (some? supplied-out)})))\n  1659\t     (let [pair? (or (and supplied-in supplied-out) (fn? make-stream))\n  1660\t           close-quietly\n  1661\t           (fn [handle]\n  1662\t             (try (stream/close! handle)\n  1663\t                  (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil)))\n  1690\t                 (catch #?(:cljd Object :clj Throwable :cljs :default) e\n  1691\t                   (doseq [h @created] (close-quietly h))\n  1692\t                   (throw e)))))]\n  1693\t       {:store (or pair-store {}),\n  1694\t        :parked {},\n  1695\t        :id-counter 0,\n  1696\t        :ready-queue [],\n  1697\t        :wait-set [],\n  1698\t        :primitives installed-primitives,\n  1699\t        :primitive-profiles installed-profiles,\n  1700\t        :primitive-canonical-names canonical-names,\n  1701\t        :modules (:modules opts),\n  1702\t        :make-stream make-stream,\n  1703\t        :call-capacity capacity,\n  1704\t        :telemetry (:telemetry opts),\n  1705\t        :telemetry-step 0,\n  1706\t        :telemetry-t 0,\n  1707\t        :telemetry-eid datom/first-user-id,\n  1708\t        :vm-model (:vm-model opts)}))))\n   409\t\n   410\t**Quiescence.** The migration unit is one task: the whole blocked machine\n   411\t(§7.6.3). Lifting additionally requires the machine's ready-queue to be\n   412\tempty — a machine with runnable work queued is mid-scheduling, its next\n   413\tconfiguration is not the parked one, and lift answers `:yin.k/not-quiescent`.\n   414\t\n   415\t### 7.4.2 Safepoint maps for foreign engines: static facts only\n   416\t\n   417\tThe reference machine needs no metadata because its registers *are* the\n   418\tcanonical configuration. A foreign engine — a register allocator over the\n   419\timage, a WebAssembly lowering, a JIT — keeps its state in physical locations\n   420\tof its own choosing, and the first draft promised it reconstruction data\n   421\tthat is not a function of the code: absolute stack depth and environment\n   422\tkey sets at a pc depend on the *activation* — a closure enters with the\n   423\tcaller's residual operand stack and an environment formed from its captured\n   424\tenvironment plus arguments (`apply-call`), and §2.6 enforces no equal stack\n   425\theights at joins, so the same pc is legitimately reached at many depths.\n   426\tNone of that is derivable, and none of it needs to be: **the frame carries\n   427\tit.** E, St, and every K frame's `:stack-base` and env travel in the value;\n   428\ta foreign engine lowers the canonical frame directly.\n   429\t\n   430\tWhat *is* a function of the canonical vector alone, and what such an engine\n   431\tmust publish — **per segment and per engine profile**, derived from the\n   432\tcanonical stream at its own load time — is the static half:\n   433\t\n   434\t```clojure\n   435\t[[sp :yin.safepoint/segment      :segment/sha256-3f1a…]  ; the code, by address\n   436\t [sp :yin.safepoint/engine       :wasm32/v1]             ; the engine profile that produced this layout\n   437\t [sp :yin.safepoint/pc           5]                      ; canonical resume pc\n   438\t [sp :yin.safepoint/stack-effect -1]                     ; Δ|St| across the parking instruction (static)\n   439\t [sp :yin.safepoint/lexically-required [x conn]]         ; names this pc can read from E (static)\n   440\t [sp :yin.safepoint/layout       {…}]]                   ; engine-owned: physical slot → canonical slot\n   441\t```\n   442\t\n   443\tRules:\n   444\t\n   445\t- `stack-effect` and `lexically-required` are **derived from the canonical\n   446\t  vector alone**, by the same static walk the linearizer performs (§5.3).\n   447\t  They are identical for every engine and checkable against the reference\n   448\t  machine by a conformance test that runs the segment to each safepoint and\n   449\t  compares the observed deltas and E-reads. Absolute depth, activation\n   450\t  bases, captured environments, and physical layouts are **not** claimed,\n   451\t  not derived, and not in this table; they are the frame's business.\n   595\tdecode. No rule asks whether a map \"looks like\" data; no decoder decision\n   596\tdepends on program content. Scalar and collection values pass through only\n   597\tbecause no marker is ever a non-map, which the closed tag table fixes.\n   598\t\n   599\tMap keys are values and are encoded as such — inside `:yin.k/entries`\n   600\talternately with their values, and nowhere else; the frame's own `:yin.k/env`\n   601\tkeys are the program's symbols and are structural, not encoded values.\n   602\t\n   603\t**Decoding validates, independent of hashing.** A hash check confirms what\n   604\twas encoded; it does not confirm the encoding is well formed. The decoder\n   605\twalks the grammar and rejects, as `:yin.k/undecodable` naming the path: a map\n   606\twith no `:yin.k/tag` at an encoded-value position (impossible from a\n   607\tconforming encoder); a tag outside the closed set; a marker missing its\n   608\trequired keys; a `:yin.k/ref` whose address is absent from the value table; a\n   609\tref graph that is cyclic *through ref data* (content-addressed table entries\n   610\tcannot mint such a cycle — a cycle can only be written by hand, and it is\n   611\trejected); and a value table entry not referenced by anything reachable.\n   612\tMalformed-but-correctly-hashed input fails here, before any lowering.\n   613\t\n   614\t### 7.5.2 Primitives: a name is a binding, not a meaning\n   615\t\n   616\t§1.1 admits host functions into the environment because `:var` resolves a\n   617\tprimitive symbol to the function value and a program may then bind it\n   618\t(`(def f +)`). At lift time the emitter recognizes such a value by reverse\n   619\tlookup in its own `:primitives` map — identity on the function object. The\n   620\tfirst draft treated the recovered symbol as the whole story. It is not:\n   621\t\n   622\t- one function object may sit under **several names**, making reverse lookup\n   623\t  ambiguous;\n   624\t- two composition-supplied primitive maps may bind the **same symbol to\n   625\t  different functions** — name presence at the resumer proves nothing about\n   626\t  behavior;\n   627\t- identity stability says nothing about **purity or captured host state**.\n   628\t\n   629\tUCF therefore binds every portable function to a **primitive profile**,\n   630\tpublished data, and the binding is checked on both ends:\n   631\t\n   632\t```clojure\n   633\t;; in :yin.k/requires — computed, not hand-written (§7.6.1)\n   634\t:yin.k/primitives {+\n   635\t                   {:yin.k/profile :yin.k.pp/sha256-…   ; content address of the profile record\n   636\t                    :yin.k/class    :pure               ; :pure | :effectful | :host\n   637\t                    :yin.k/arities  [2]\n   638\t                    :yin.k/effects  #{}                 ; for :effectful — declared effect kinds\n   639\t                    :yin.k/host-state :none}}           ; :none, or refused\n   640\t```\n   641\t\n   642\tThe profile record — `{name class arities effects host-state}` under a\n   643\tcontent address — is what a name must be *checked against*, not merely\n   644\tpresent as. Rules:\n   645\t\n   646\t- **Ambiguity refuses the lift.** A function object that reverse-lookups to\n   647\t  more than one name in the emitter's `:primitives` is refused\n   648\t  (`:yin.k/non-portable`, kind `:ambiguous-primitive`) unless the\n   649\t  composition declares a canonical-name table resolving it to exactly one.\n   900\t  refuses the lift (`:yin.k/non-portable`, kind `:foreign-parked-ref`),\n   901\t  as it represents corrupted state. Parked records not named by the\n   902\t  reachable graph do not travel.\n   903\t\n   904\t### 7.6.4 Modules\n   905\t\n   906\t`:yin.k/modules` names each module by the content address of its published\n   907\tmanifest, on the model of `dao.space.index/publish-index!` (`dao.jing.md`,\n   908\t*Publication from an agent*). A module is satisfied when the resumer holds a\n   909\tmodule registry entry (`yin.vm.module` — a value, supplied by the\n   910\tcomposition) whose manifest address is equal; it is not satisfied by a\n   911\tsame-named module of different content. Module *code* is segments and is\n   912\tcovered by `:yin.k/segments` and the manifest's own addressing; the manifest\n   913\tpins the effect handlers, the exported primitive profiles (§7.5.2), and —\n   914\tper §7.6.1 — the store footprint the fixed point needs to claim\n   915\t`:complete`.\n   916\t\n   917\t### 7.6.5 The satisfaction check\n   918\t\n   919\tBefore lowering, the resumer evaluates `:yin.k/requires` against what it\n   920\tholds and answers with one outcome:\n   921\t\n   922\t```clojure\n   923\t{:yin.k/status    :yin.k/unsatisfied\n   924\t :yin.k/discovery :incomplete                    ; or :blocked, §7.6.1 — the computed status of the closure itself\n   925\t :yin.k/missing   {:yin.k/segments       #{:segment/sha256-9c02…}\n   926\t                   :yin.k/primitives     {println <expected profile>}\n   927\t                   :yin.k/modules        {my.mod …}\n   928\t                   :yin.k/streams        #{<identity>}\n   929\t                   :yin.k/cursor-profiles #{:dao.stream/file-v1}}}  ; keys present only where something is missing\n   930\t```\n   931\t\n   932\tThe check reports everything missing in one pass *that the fixed point could\n   933\tsee*, and says which kind of pass it was: `:complete` (the closure is fully\n   934\tcomputed; the missing list is exhaustive), `:incomplete` (a module footprint\n   935\twas undeclared; the missing list is a lower bound), or `:blocked` (a missing\n   936\tsegment stopped discovery; satisfying `:yin.k/segments` and re-running the\n   937\tcheck is the only way forward). A missing segment may be resolved by\n   938\t`dao.jing` fetch (§7.3.4); a missing primitive, module, or cursor profile\n   939\tcannot be resolved by the resumer and is a routing decision for whoever\n   940\tchose this resumer. A resumer never lowers a partially satisfied value; a\n   941\thost with no implementation for something answers with the qualified\n   942\tunsupported outcome, which `datom.world.md` calls a correct outcome, not a\n   943\tgap to be filled.\n   944\t\n   945\t## §7.7 Ownership arbitration — custody as a lease over datoms (blocker 4)\n   946\t\n   947\t### 7.7.1 The race, named\n   948\t\n   949\tThe emitter parks, lifts, appends the UCF value to a medium, and keeps its\n   950\tlocal `:parked` record. Three readers see the value. The emitter's own wait\n","exit_code":0,"status":"completed"}}
