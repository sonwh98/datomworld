ved`'s independent\n    45\t;; check walk, so the two can never silently disagree about which entities\n    46\t;; are children of which. `:literal`, `:variable`, `:stream/make`,\n    47\t;; `:vm/gensym`, `:vm/store-get`, `:vm/store-put`, `:vm/park`, and\n    48\t;; `:vm/current-continuation` have no child slots and are leaves; `:lambda`\n    49\t;; is handled specially by every walk below because it also carries scope\n    50\t;; (a parameter vector, or its resolved arity), not only a child.\n    51\t\n    52\t(def ^:private child-slots\n    53\t  \"Node type -> ordered `[attr kind]` child slots, `kind` one of `:child`\n    54\t   (one entity ref) or `:children` (an ordered vector of entity refs).\n    55\t   Mirrors `yin.vm.linearize/flatten-program`'s own case dispatch, read\n    56\t   from the same `:yin/*` attributes, but as data instead of code.\"\n    57\t  {:application [[:yin/operator :child] [:yin/operands :children]]\n    58\t   :dao.stream.apply/call [[:yin/operands :children]]\n    59\t   :if [[:yin/test :child] [:yin/consequent :child] [:yin/alternate :child]]\n    60\t   :stream/put [[:yin/target :child] [:yin/val-node :child]]\n    61\t   :stream/cursor [[:yin/source :child]]\n    62\t   :stream/next [[:yin/source :child]]\n    63\t   :stream/close [[:yin/source :child]]\n    64\t   :vm/resume [[:yin/val-node :child]]})\n    65\t\n    66\t\n    67\t(def ^:private unsupported-types\n    68\t  \"Node types outside both evaluators' supported corpus, matching\n    69\t   `yin.vm.linearize/unsupported` exactly -- read here, not required\n    70\t   from there, since that namespace stays untouched.\"\n    71\t  #{:yin/macro-expand :vm/store-update})\n    72\t\n    73\t\n    74\t;; =============================================================================\n    75\t;; resolve: named datoms -> resolved tuples + provenance side table\n    76\t;; =============================================================================\n    77\t\n    78\t(defn- reject-host-value!\n   150\t        (swap! (:params ctx) assoc rid params)\n   151\t        (let [body-rid (child! (get-attr e :yin/body) (into [params] stack))]\n   152\t          (emit! :yin/body body-rid)))\n   153\t\n   154\t      :application\n   155\t      (do (emit! :yin/type :application)\n   156\t          (let [op-rid (child! (get-attr e :yin/operator) stack)\n   157\t                operand-rids (mapv #(child! % stack) (get-attr e :yin/operands))]\n   158\t            (emit! :yin/operator op-rid)\n   159\t            (emit! :yin/operands operand-rids)))\n   160\t\n   161\t      :dao.stream.apply/call\n   162\t      (let [op (get-attr e :yin/op)]\n   163\t        (reject-host-value! e :yin/op op)\n   164\t        (emit! :yin/type :dao.stream.apply/call)\n   165\t        (emit! :yin/op op)\n   166\t        (emit! :yin/operands (mapv #(child! % stack) (get-attr e :yin/operands))))\n   167\t\n   168\t      :if\n   169\t      (do (emit! :yin/type :if)\n   170\t          (let [test-rid (child! (get-attr e :yin/test) stack)\n   171\t                cons-rid (child! (get-attr e :yin/consequent) stack)\n   172\t                alt-rid (child! (get-attr e :yin/alternate) stack)]\n   173\t            (emit! :yin/test test-rid)\n   174\t            (emit! :yin/consequent cons-rid)\n   175\t            (emit! :yin/alternate alt-rid)))\n   176\t\n   177\t      :vm/gensym\n   178\t      (let [prefix (get-attr e :yin/prefix)]\n   179\t        (reject-host-value! e :yin/prefix prefix)\n   180\t        (emit! :yin/type :vm/gensym)\n   181\t        (emit! :yin/prefix prefix))\n   182\t\n   183\t      :vm/store-get\n   184\t      (let [key (get-attr e :yin/key)]\n   185\t        (reject-host-value! e :yin/key key)\n   186\t        (emit! :yin/type :vm/store-get)\n   187\t        (emit! :yin/key key))\n   188\t\n   189\t      :vm/store-put\n   190\t      (let [key (get-attr e :yin/key)\n   191\t            val (get-attr e :yin/value)]\n   192\t        (reject-host-value! e :yin/key key)\n   193\t        (reject-host-value! e :yin/value val)\n   194\t        (emit! :yin/type :vm/store-put)\n   195\t        (emit! :yin/key key)\n   196\t        (emit! :yin/value val))\n   197\t\n   198\t      :stream/make\n   199\t      (let [buffer (get-attr e :yin/buffer)]\n   165\t                        (get-attr e :yin.resolved/position)])))\n   166\t\n   167\t      :lambda\n   168\t      (let [arity (get-attr e :yin.resolved/arity)\n   169\t            body-e (get-attr e :yin/body)\n   170\t            idx (do (swap! bodies-queue conj\n   171\t                           {:source e, :body-entity body-e, :arity arity})\n   172\t                    (dec (count @bodies-queue)))]\n   173\t        (emit! ctx e [:closure target-reg arity idx]))\n   174\t\n   175\t      :application\n   176\t      (let [op-e (get-attr e :yin/operator)\n   177\t            operand-es (get-attr e :yin/operands)\n   178\t            fn-temp (allocate-temp! ctx)\n   179\t            fn-reg (reg-of ctx fn-temp)\n   180\t            _ (lower-node! get-attr bodies-queue ctx op-e fn-reg)\n   181\t            arg-temps (mapv (fn [oe]\n   182\t                              (let [t (allocate-temp! ctx), r (reg-of ctx t)]\n   183\t                                (lower-node! get-attr bodies-queue ctx oe r)\n   184\t                                t))\n   185\t                            operand-es)\n   186\t            arg-regs (mapv #(reg-of ctx %) arg-temps)\n   187\t            tail? (boolean (get-attr e :yin/tail?))]\n   188\t        ;; `live` (design section 4.5) is filled in a separate backward\n   189\t        ;; pass over the whole assembled body, not here: `[]` is a\n   190\t        ;; placeholder only, giving the tuple its final six-element arity\n   191\t        ;; immediately so nothing downstream has to special-case it.\n   192\t        ;; `lower-register` overwrites every `:call` tuple's live operand\n   193\t        ;; with `yin.vm.debruijn-register-code/body-liveness`'s answer\