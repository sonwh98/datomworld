{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/macro.cljc | sed -n '340,380p;450,506p;825,864p;907,935p;1082,1121p;1136,1165p'\nnl -ba src/cljc/yin/vm/encoder.cljc | sed -n '168,250p'\nnl -ba src/cljc/yang/clojure.cljc | sed -n '295,325p;392,445p'\"","aggregated_output":"   340\t(defn- definition-at\n   341\t  \"`{:name sym :value address}` when the row at `address` is the §2.2 shape\n   342\t   `(yin/def <literal-symbol> value)`, else nil.\"\n   343\t  [index address]\n   344\t  (let [row (get index address)]\n   345\t    (when (= :application (row-tag row))\n   346\t      (let [op (get index (nth row 2))\n   347\t            operands (nth row 3)]\n   348\t        (when (and (= [:variable 'yin/def] (subvec op 1))\n   349\t                   (= 2 (count operands)))\n   350\t          (let [name-row (get index (first operands))]\n   351\t            (when (and (= :literal (row-tag name-row))\n   352\t                       (symbol? (nth name-row 2)))\n   353\t              {:name (nth name-row 2), :value (second operands)})))))))\n   354\t\n   355\t\n   356\t(defn- definition-paths\n   357\t  \"Every definition occurrence path of one tree, in preorder. Paths, not\n   358\t   addresses: a shared definition row at two places is two occurrences.\"\n   359\t  [index root]\n   360\t  (letfn [(walk\n   361\t            [a path]\n   362\t            (concat (when (definition-at index a) [path])\n   363\t                    (mapcat (fn [[coord c]] (walk c (conj path coord)))\n   364\t                            (child-places (get index a)))))]\n   365\t    (vec (walk root []))))\n   366\t\n   367\t\n   368\t;; =============================================================================\n   369\t;; Admission (§2.1, §7.1)\n   370\t;; =============================================================================\n   371\t\n   372\t(defn- malformed\n   373\t  [reason & kvs]\n   374\t  (merge {:kind :malformed-input, :reason reason} (apply hash-map kvs)))\n   375\t\n   376\t\n   377\t(defn- batch-shape-ok?\n   378\t  [batch]\n   379\t  (and (vector? batch)\n   380\t       (= 5 (count batch))\n   450\t            (:error merged) merged\n   451\t\n   452\t            (:error entries) entries\n   453\t\n   454\t            :else\n   455\t            (let [{:keys [seen entries]} entries]\n   456\t              (or\n   457\t                (some (fn [j]\n   458\t                        (some (fn [p]\n   459\t                                (when-not (contains? seen [j p])\n   460\t                                  (catalogue-error nil :tree j :path p)))\n   461\t                              (definition-paths (nth indexes j) (nth roots j))))\n   462\t                      (range (count trees)))\n   463\t                (let [by-occurrence (into {} (map (fn [e] [[(:tree e) (:path e)] e])) entries)]\n   464\t                  (or\n   465\t                    (some (fn [[_ j path]]\n   466\t                            (let [e (get by-occurrence [j path])]\n   467\t                              (when-not (and e (= :lambda (row-tag (get (nth indexes j)\n   468\t                                                                        (:value e)))))\n   469\t                                {:error (malformed :stray-macro-declaration :tree j :path path)})))\n   470\t                          decls)\n   471\t                    (let [declared (set (map (fn [[_ j path]] [j path]) decls))]\n   472\t                      {:admitted\n   473\t                       {:trees trees,\n   474\t                        :indexes indexes,\n   475\t                        :index (:index merged),\n   476\t                        :run-index run-index,\n   477\t                        :definitions (mapv #(assoc % :declared?\n   478\t                                                   (contains? declared [(:tree %) (:path %)]))\n   479\t                                           entries)}})))))))))))\n   480\t\n   481\t\n   482\t(defn definitions\n   483\t  \"The ordered definition records of a batch, in harvest order:\n   484\t   `{:ordinal h :tree j :path p :address a :name sym :value v :declared? b}`.\n   485\t   Throws `ex-info` carrying the admission error when the batch is invalid.\"\n   486\t  [batch]\n   487\t  (let [{:keys [admitted error]} (admit batch)]\n   488\t    (when error\n   489\t      (throw (ex-info \"Invalid macro input batch\" error)))\n   490\t    (:definitions admitted)))\n   491\t\n   492\t\n   493\t;; =============================================================================\n   494\t;; Workspace: interning and immutable path rebuilding (§3.3)\n   495\t;; =============================================================================\n   496\t\n   497\t(defn- intern-body\n   498\t  \"Intern `body` into the working index: `[index' address]`. An address\n   499\t   already holding a different body is a defect of the encoder, not input.\"\n   500\t  [index body]\n   501\t  (let [row (intern-row body)\n   502\t        a (first row)\n   503\t        prior (get index a)]\n   504\t    (when (and prior (not (same-value? prior row)))\n   505\t      (throw (ex-info \"Working index address conflict\" {:address a})))\n   506\t    [(if prior index (assoc index a row)) a]))\n   825\t\n   826\t(defn- retail\n   827\t  \"Recompute every `tail?` slot below `root`, in context `tail?`, over a\n   828\t   working index; `[index' root']`. Tail-ness is contextual, so one shared\n   829\t   row in two contexts becomes two rows.\"\n   830\t  [index root]\n   831\t  (let [memo (volatile! {})]\n   832\t    (letfn [(go\n   833\t              [index a tail?]\n   834\t              (if-let [hit (get @memo [a tail?])]\n   835\t                [index hit]\n   836\t                (let [row (get index a)\n   837\t                      tag (row-tag row)\n   838\t                      ctxs (case tag\n   839\t                             :lambda [true]\n   840\t                             :if [false tail? tail?]\n   841\t                             (repeat false))\n   842\t                      [index children']\n   843\t                      (reduce (fn [[index acc] [[_ c] t]]\n   844\t                                (let [[index c'] (go index c t)]\n   845\t                                  [index (conj acc c')]))\n   846\t                              [index []]\n   847\t                              (map vector (child-places row) ctxs))\n   848\t                      [index a'] (rebuild-row index row children')\n   849\t                      [index a'] (if (and (= :application tag)\n   850\t                                          (not= tail? (nth (get index a') 4)))\n   851\t                                   (intern-body index (assoc (subvec (get index a') 1) 3 tail?))\n   852\t                                   [index a'])]\n   853\t                  (vswap! memo assoc [a tail?] a')\n   854\t                  [index a'])))]\n   855\t      (go index root true))))\n   856\t\n   857\t\n   858\t(defn mark-tail\n   859\t  \"Recompute all observable tail slots of a tree packet, setting and\n   860\t   clearing marks (§6): the root is in tail context, an `:if` test is\n   861\t   non-tail and its branches inherit, application operators and operands are\n   862\t   non-tail, a lambda body is tail, and every other child is non-tail.\"\n   863\t  [packet]\n   864\t  (let [[index root] (retail (packet-index packet) (first packet))]\n   907\t\n   908\t(defn- post-harvest\n   909\t  \"The next batch's store: start from the store before initial harvest and\n   910\t   walk the final occurrence tree in declaration order — for an application\n   911\t   whose operator is a lambda, operands left to right then the lambda body;\n   912\t   otherwise child slots in grammar order. A plain definition removes its\n   913\t   name; a stand-in whose `k` exists and whose catalogue name matches\n   914\t   installs that entry; later occurrences win.\"\n   915\t  [store index root catalogue]\n   916\t  (letfn [(children\n   917\t            [row]\n   918\t            (let [places (child-places row)]\n   919\t              (if (and (= :application (row-tag row))\n   920\t                       (= :lambda (row-tag (get index (nth row 2)))))\n   921\t                (concat (map second (rest places))\n   922\t                        [(nth (get index (nth row 2)) 3)])\n   923\t                (map second places))))\n   924\t          (walk\n   925\t            [store a]\n   926\t            (let [row (get index a)\n   927\t                  store (cond\n   928\t                          (= standin-tag (row-tag row))\n   929\t                          (let [[_ _ nm k] row\n   930\t                                entry (get catalogue k)]\n   931\t                            (if (and entry (= nm (:name entry)))\n   932\t                              (assoc store nm (:macro-tree entry))\n   933\t                              store))\n   934\t\n   935\t                          :else\n  1082\t                                                      :path (conj path coord)\n  1083\t                                                      :rel (conj rel coord)\n  1084\t                                                      :shadow (shadow-of coord)))]\n  1085\t                      [st (conj acc c')])))\n  1086\t                [st []]\n  1087\t                places)]\n  1088\t    (if (:error st)\n  1089\t      [st (first row)]\n  1090\t      (let [[index a'] (rebuild-row (:index st) row places children')]\n  1091\t        [(assoc st :index index) a']))))\n  1092\t\n  1093\t\n  1094\t(defn- expand-node\n  1095\t  \"§4.2. `loc` carries the absolute `path` in the batch's run tree, the\n  1096\t   `rel` path within the current `frame` (`{:root r :parent event|nil\n  1097\t   :tree-index j}`), the lexical `shadow` set, and the expansion `depth`.\n  1098\t   Returns `[st address']`; a failure sets `(:error st)`.\"\n  1099\t  [st address {:keys [shadow] :as loc}]\n  1100\t  (if (:error st)\n  1101\t    [st address]\n  1102\t    (let [row (get (:index st) address)\n  1103\t          tag (row-tag row)]\n  1104\t      (cond\n  1105\t        (and (= :application tag) (macro-of st (nth row 2) shadow))\n  1106\t        (expand-call st address (macro-of st (nth row 2) shadow) loc)\n  1107\t\n  1108\t        (= :application tag)\n  1109\t        (let [op (nth row 2)\n  1110\t              [st op'] (expand-node st op (-> loc\n  1111\t                                              (update :path conj 2)\n  1112\t                                              (update :rel conj 2)))]\n  1113\t          (if (:error st)\n  1114\t            [st address]\n  1115\t            (let [[index app'] (if (= op op')\n  1116\t                                 [(:index st) address]\n  1117\t                                 (intern-body (:index st) (assoc (subvec row 1) 1 op')))\n  1118\t                  st (assoc st :index index)\n  1119\t                  row' (get index app')]\n  1120\t              (if (macro-of st op' shadow)\n  1121\t                ;; recognition is not expansion: depth is unchanged\n  1136\t(defn- log-packet\n  1137\t  [st]\n  1138\t  [:yin.macro/log (:events st) (:produced st)])\n  1139\t\n  1140\t\n  1141\t(defn- with-default-guards\n  1142\t  [ctx]\n  1143\t  (update ctx :guards #(merge default-guards %)))\n  1144\t\n  1145\t\n  1146\t(defn expand-batch\n  1147\t  \"Expand one input batch against `ctx` (§3.2). Returns\n  1148\t   `{:status :ok :tree packet :log log :ctx ctx'}` or\n  1149\t   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\n  1150\t   consumed the batch (`:t` + 1) and every attempt it allocated; only\n  1151\t   success changes the store, to the post-harvest store.\"\n  1152\t  [batch ctx]\n  1153\t  (let [ctx (with-default-guards ctx)\n  1154\t        source-batch (:t ctx)\n  1155\t        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\n  1156\t        finish (fn [st]\n  1157\t                 (let [ctx' (update (:ctx st) :t inc)]\n  1158\t                   (if-let [e (:error st)]\n  1159\t                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\n  1160\t                     {:status :ok, :tree (:tree st), :log (log-packet st),\n  1161\t                      :ctx (assoc ctx' :store (:next-store st))})))\n  1162\t        {:keys [admitted error]} (admit batch)]\n  1163\t    (if error\n  1164\t      (let [[st counter] (allocate-attempt base)]\n  1165\t        (finish (-> st\n   168\t(defn- definition-name\n   169\t  \"The name of a `(yin/def <literal-symbol> value)` AST node (§2.2), else nil.\"\n   170\t  [{:keys [type operator operands]}]\n   171\t  (when (and (= :application type)\n   172\t             (= :variable (:type operator))\n   173\t             (= 'yin/def (:name operator))\n   174\t             (= 2 (count operands))\n   175\t             (= :literal (:type (first operands)))\n   176\t             (symbol? (:value (first operands))))\n   177\t    (:value (first operands))))\n   178\t\n   179\t\n   180\t(defn- ast-children\n   181\t  \"`[[path-suffix child] ...]` of one AST node in grammar order. A suffix\n   182\t   holds one coordinate: the full-row position of a `node` slot or\n   183\t   `[position i]` of a `nodes` child, as in its canonical row (§2.1).\"\n   184\t  [node]\n   185\t  (apply concat\n   186\t         (map-indexed (fn [i [field kind]]\n   187\t                        (let [pos (+ i 2)]\n   188\t                          (case kind\n   189\t                            :node [[[pos] (get node field)]]\n   190\t                            :nodes (map-indexed (fn [k c] [[[pos k]] c])\n   191\t                                                (get node field))\n   192\t                            nil)))\n   193\t                      (get vm/semantic-bytecode-grammar (:type node)))))\n   194\t\n   195\t\n   196\t(defn- declaration-order\n   197\t  \"§3.5's declaration order for one node's children: for an application\n   198\t   whose operator is a lambda, the operands left to right and then the\n   199\t   lambda body (two coordinates below the application); otherwise grammar\n   200\t   order.\"\n   201\t  [node]\n   202\t  (let [places (ast-children node)]\n   203\t    (if (and (= :application (:type node)) (= :lambda (:type (:operator node))))\n   204\t      (concat (rest places) [[[2 3] (:body (:operator node))]])\n   205\t      places)))\n   206\t\n   207\t\n   208\t(defn- definition-occurrences\n   209\t  \"Every definition occurrence of one member AST as `{:path p :declared? b}`,\n   210\t   in source declaration order. A declared occurrence is one whose value is\n   211\t   a lambda the frontend flagged `:macro?`.\"\n   212\t  [ast]\n   213\t  (letfn [(walk [node path]\n   214\t            (concat (when (definition-name node)\n   215\t                      [{:path path,\n   216\t                        :declared? (boolean (:macro? (second (:operands node))))}])\n   217\t                    (mapcat (fn [[suffix child]] (walk child (into path suffix)))\n   218\t                            (declaration-order node))))]\n   219\t    (vec (walk ast []))))\n   220\t\n   221\t\n   222\t(defn- member-ast\n   223\t  [member]\n   224\t  (cond (and (map? member) (contains? member :type)) member\n   225\t        (sequential? member) (vm/datoms->ast (vec member))\n   226\t        :else (throw (ex-info \"Unsupported program batch member\"\n   227\t                              {:rule :batch-member, :member member}))))\n   228\t\n   229\t\n   230\t(defn program-batch\n   231\t  \"Encode frontend output as the expander's input batch (§2.1):\n   232\t   `[:yin.program/batch trees run-index declaration-rows harvest-rows]`.\n   233\t   Each member — a map AST or a `:yin/*` datom batch — projects to one tree\n   234\t   packet; `run-index` selects the one that becomes the program. Harvest\n   235\t   rows name every `(yin/def <literal-symbol> value)` occurrence in source\n   236\t   declaration order, member by member; declaration rows name those whose\n   237\t   lambda the frontend flagged `:macro?`. No syntax object crosses: every\n   238\t   code field is canonical rows.\"\n   239\t  ([member] (program-batch [member] 0))\n   240\t  ([members run-index]\n   241\t   (let [asts (mapv member-ast members)\n   242\t         trees (mapv (fn [ast]\n   243\t                       (let [{:keys [root rows]} (vm/ast->semantic-bytecode ast)]\n   244\t                         [root (vec (vals rows))]))\n   245\t                     asts)\n   246\t         occurrences (vec (mapcat (fn [j ast]\n   247\t                                    (map #(assoc % :tree j)\n   248\t                                         (definition-occurrences ast)))\n   249\t                                  (range) asts))]\n   250\t     [:yin.program/batch\n   295\t(defn- compile-form*\n   296\t  \"Compile a Clojure form to Universal AST.\n   297\t\n   298\t  This is the main entry point that dispatches to specific compilers\n   299\t  based on the form type.\n   300\t\n   301\t  macro-env: compile-time map of defmacro names in scope. A macro call is an\n   302\t  ordinary application; macro-env only stops the native defn lowering.\"\n   303\t  [form tail? env macro-env]\n   304\t  (cond\n   305\t    ;; Literals\n   306\t    (literal? form) (compile-literal form tail?)\n   307\t    ;; Variables (symbols)\n   308\t    (symbol? form) (compile-variable form tail?)\n   309\t    ;; Special forms and function application\n   310\t    (seq? form)\n   311\t    (let [[operator & operands] form]\n   312\t      (cond\n   313\t        ;; dao.stream.apply call: (dao.stream.apply/call :op/name arg1 arg2)\n   314\t        (= operator 'dao.stream.apply/call)\n   315\t        (let [[op & args] operands]\n   316\t          (compile-dao-stream-apply-call op args env tail? macro-env))\n   317\t        ;; Native defn fallback: used only when no defmacro defn is in scope\n   318\t        ;; and the form actually matches defn syntax.\n   319\t        (and (= operator 'defn)\n   320\t             (not (contains? macro-env 'defn))\n   321\t             (<= 2 (count operands))\n   322\t             (vector? (second operands)))\n   323\t        (let [[fn-name params & body-forms] operands]\n   324\t          (compile-defn fn-name params body-forms env tail? macro-env))\n   325\t\n   392\t\n   393\t\n   394\t(defn compile-program\n   395\t  \"Compile a sequence of Clojure forms into a single Universal AST.\n   396\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\n   397\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\n   398\t   with :macro? true on the lambda; the encoder turns that flag into a\n   399\t   declaration row and the expander, not this compiler, recognizes calls.\"\n   400\t  ([forms] (compile-program forms true))\n   401\t  ([forms tail?]\n   402\t   (letfn [(go\n   403\t             [forms macro-env]\n   404\t             (if (empty? forms)\n   405\t               (compile-literal nil tail?)\n   406\t               (let [head       (first forms)\n   407\t                     rest-forms (rest forms)]\n   408\t                 (cond\n   409\t                   ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\n   410\t                   ;; lambda the encoder declares; later forms see the name\n   411\t                   ;; only so the native defn lowering can yield to it.\n   412\t                   (and (seq? head) (= 'defmacro (first head)))\n   413\t                   (let [[_ name-form params & body-forms] head]\n   414\t                     (cond-> {:type     :application\n   415\t                              :operator {:type :lambda, :params ['_]\n   416\t                                         :body (go rest-forms\n   417\t                                                   (assoc macro-env\n   418\t                                                          (strip-symbol-meta name-form)\n   419\t                                                          {:type :user}))}\n   420\t                              :operands [(compile-defmacro name-form params body-forms\n   421\t                                                           {} false macro-env)]}\n   422\t                       tail? (assoc :tail? true)))\n   423\t                   ;; def: sequence with current macro-env\n   424\t                   (and (seq? head) (= 'def (first head)))\n   425\t                   (let [[_ name value] head]\n   426\t                     (cond-> {:type     :application\n   427\t                              :operator {:type :lambda, :params ['_]\n   428\t                                         :body (go rest-forms macro-env)}\n   429\t                              :operands [(compile-def name value {} false macro-env)]}\n   430\t                       tail? (assoc :tail? true)))\n   431\t                   ;; single form\n   432\t                   (= 1 (count forms))\n   433\t                   (compile-form head tail? {} macro-env)\n   434\t                   ;; sequence\n   435\t                   :else\n   436\t                   (cond-> {:type     :application\n   437\t                            :operator {:type :lambda, :params ['_]\n   438\t                                       :body (go rest-forms macro-env)}\n   439\t                            :operands [(compile-form head false {} macro-env)]}\n   440\t                     tail? (assoc :tail? true))))))]\n   441\t     (go forms initial-macro-env))))\n   442\t\n   443\t\n   444\t(defn compile\n   445\t  \"Main compiler entry point.\n","exit_code":0,"status":"completed"}}
