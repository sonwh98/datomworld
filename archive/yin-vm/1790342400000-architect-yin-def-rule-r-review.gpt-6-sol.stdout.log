\n   142\t                 :blocked? false\n   143\t                 :value nil))))))\n   144\t\n   145\t\n   146\t(defn create-vm\n   147\t  \"Build a fresh `DebruijnRegisterVM` over `segment`.\n   148\t   Options: `:free-env`, `:store`, `:primitives`, `:modules`, `:make-stream`,\n   149\t   `:call-in`/`:call-out`/`:call-capacity`, and `:bridge`.\"\n   150\t  ([segment] (create-vm segment {}))\n   151\t  ([segment opts]\n   152\t   (let [base (vm/empty-state\n   153\t                (assoc (select-keys opts [:modules :make-stream :call-in\n   154\t                                          :call-out :call-capacity])\n   155\t                       :primitives (or (:primitives opts) {})))]\n   156\t     (-> (map->DebruijnRegisterVM\n   157\t           {:segment {:bodies [], :instructions []},\n   158\t            :hash nil,\n   159\t            :pc 0,\n   160\t            :frames [],\n   161\t            :free-env (or (:free-env opts) {}),\n   162\t            :registers [],\n   163\t            :continuation [],\n   164\t            :store (merge (:store base) (:store opts)),\n   165\t            :blocked? false,\n   166\t            :halted? true,\n   625\t                                   (emit! e :yin/val-node val-id)))\n   626\t                  :vm/current-continuation\n   627\t                  (emit! e :yin/type :vm/current-continuation)\n   628\t                  ;; Default\n   629\t                  (throw (ex-info \"Unknown AST node type\"\n   630\t                                  {:type type, :node node})))\n   631\t                e))))]\n   632\t       (let [root-id (convert ast)]\n   633\t         (emit! root-id :yin/root true)\n   634\t         [root-id @datoms])))))\n   635\t\n   636\t\n   637\t(defn ast->datoms\n   638\t  \"Convert AST map into a vector of datoms. A datom is [e a v t m].\"\n   639\t  ([ast] (ast->datoms ast {}))\n   640\t  ([ast opts] (second (ast->datoms-with-root ast opts))))\n   641\t\n   642\t\n   643\t(declare index-datoms)\n