n   243\t                (cesk-return state\n   244\t                             next-node\n   245\t                             saved-env\n   375\t                          {:continuation-type cont-type, :continuation k}))))\n   376\t      (case type\n   377\t        :literal (cesk-return state nil env k (:value node))\n   378\t        :variable\n   379\t        (let [value (engine/resolve-var env store primitives modules (:name node))]\n   380\t          (cesk-return state nil env k value))\n   381\t        :lambda (let [{:keys [params body]} node]\n   382\t                  (cesk-return\n   383\t                    state\n   384\t                    nil\n   385\t                    env\n   386\t                    k\n   387\t                    {:type :closure, :params params, :body body, :env env}))\n   388\t        :application (cesk-return\n   389\t                       state\n   390\t                       (:operator node)\n   391\t                       env\n   392\t                       {:frame node, :next k, :env env, :type :eval-operator}\n   393\t                       (:value state))\n   394\t        :if (cesk-return state\n   395\t                         (:test node)\n   396\t                         env\n   397\t                         {:frame node, :next k, :env env, :type :eval-test}\n   398\t                         (:value state))\n   399\t        :dao.stream.apply/call\n   400\t        (let [operands (or (:operands node) [])\n   401\t              op (:op node)]\n   402\t          (if (empty? operands)\n   403\t            (park-and-call state op [] k env)\n   404\t            (cesk-return state\n   405\t                         (first operands)\n   406\t                         env\n   407\t                         {:frame {:op op, :operands operands, :evaluated []},\n   408\t                          :next k,\n   409\t                          :env env,\n   410\t                          :type :dao.stream.apply/eval-operand}\n   411\t                         (:value state))))\n   412\t        :vm/gensym (let [prefix (or (:prefix node) \"id\")\n   413\t                         [id s'] (engine/gensym state prefix)]\n   414\t                     (assoc s'\n   415\t                            :value id\n   416\t                            :control nil\n   417\t                            :halted? (nil? k)))\n   418\t        :vm/store-get (cesk-return state nil env k (get store (:key node)))\n   419\t        :vm/store-put (let [key (:key node)\n   420\t                            value (:val node)\n   421\t                            new-store (assoc store key value)]\n   422\t                        (assoc state\n   423\t                               :store new-store\n   424\t                               :value value\n   425\t                               :control nil\n   426\t                               :halted? (and (not (:blocked? state)) (nil? k))))\n   427\t        :vm/store-update (let [key (:key node)\n   428\t                               f (:fn node)\n   429\t                               args (:args node)\n   430\t                               current (get store key)\n   431\t                               new-value (apply f current args)\n   432\t                               new-store (assoc store key new-value)]\n   433\t                           (assoc state\n   434\t                                  :store new-store\n   435\t                                  :value new-value\n   436\t                                  :control nil\n   437\t                                  :halted? (and (not (:blocked? state))\n   438\t                                                (nil? k))))\n   439\t        :vm/current-continuation\n   525\t        (let [cont-type (:type k)]\n   526\t          (case cont-type\n   527\t            :eval-operator\n   528\t            (let [frame (:frame k)\n   529\t                  fn-value val\n   530\t                  operands (:operands frame)\n   531\t                  saved-env (or (:env k) env)]\n   532\t              (if (empty? operands)\n   533\t                (cond (= :closure (:type fn-value))\n   534\t                      (let [{:keys [params body], closure-env :env} fn-value\n   535\t                            extended-env (merge closure-env\n   536\t                                                (engine/bind-params params []))]\n   537\t                        (recur body extended-env (:next k) val vm))\n   538\t                      (fn? fn-value)\n   539\t                      (let [result (apply fn-value [])]\n   540\t                        (if (module/effect? result)\n   541\t                          (let [state (cesk-return vm control env k val)\n   542\t                                res (handle-primitive-result state\n   543\t                                                             result\n   544\t                                                             (:next k)\n   545\t                                                             saved-env)]\n   546\t                            (if (or (:blocked? res)\n   547\t                                    (and (nil? (:control res)) (nil? (:k res))))\n   548\t                              res\n   549\t                              (recur (:control res)\n   550\t                                     (:env res)\n   551\t                                     (:k res)\n   552\t                                     (:value res)\n   553\t                                     res)))\n   554\t                          (recur nil saved-env (:next k) result vm)))\n   555\t                      :else (throw (ex-info \"Cannot apply non-function\"\n   556\t                                            {:fn fn-value})))\n   557\t                (let [updated-frame (assoc frame\n   558\t                                           :operator-evaluated? true\n   559\t                                           :fn fn-value)]\n   560\t                  (recur (first operands)\n   561\t                         saved-env\n   562\t                         (assoc k\n   563\t                                :type :eval-operand\n   564\t                                :frame updated-frame)\n   565\t                         nil\n   566\t                         vm))))\n   567\t            :eval-operand\n   568\t            (let [frame (:frame k)\n   569\t                  operand-value val\n   570\t                  evaluated (conj (or (:evaluated frame) []) operand-value)\n   571\t                  operands (:operands frame)\n   572\t                  saved-env (or (:env k) env)]\n   573\t              (if (= (count evaluated) (count operands))\n   574\t                (let [fn-value (:fn frame)]\n   575\t                  (cond (= :closure (:type fn-value))\n   576\t                        (let [{:keys [params body], closure-env :env} fn-value\n   577\t                              extended-env (merge closure-env\n   578\t                                                  (engine/bind-params params\n   579\t                                                                      evaluated))]\n   580\t                          (recur body extended-env (:next k) val vm))\n   581\t                        (fn? fn-value)\n   582\t                        (let [result (apply fn-value evaluated)]\n   583\t                          (if (module/effect? result)\n   584\t                            (let [state (cesk-return vm control env k val)\n   585\t                                  res (handle-primitive-result state\n   586\t                                                               result\n   587\t                                                               (:next k)\n   588\t                                                               saved-env)]\n   589\t                              (if (or (:blocked? res)\n   590\t                                      (and (nil? (:control res))\n   591\t                                           (nil? (:k res))))\n   592\t                                res\n   593\t                                (recur (:control res)\n   594\t                                       (:env res)\n   595\t                                       (:k res)\n   596\t                                       (:value res)\n   597\t                                       res)))\n   598\t                            (recur nil saved-env (:next k) result vm)))\n   620\t                next\n   621\t                (recur (:control next)\n   622\t                       (:env next)\n   623\t                       (:k next)\n   624\t                       (:value next)\n   625\t                       next)))))\n   626\t        node (case type\n   627\t               :literal (recur nil env k (:value node) vm)\n   628\t               :variable (let [v (engine/resolve-var env\n   629\t                                                     (:store vm)\n   630\t                                                     (:primitives vm)\n   631\t                                                     (:modules vm)\n   632\t                                                     (:name node))]\n   633\t                           (recur nil env k v vm))\n   634\t               :lambda (recur nil\n   635\t                              env\n   636\t                              k\n   637\t                              {:type :closure,\n   638\t                               :params (:params node),\n   639\t                               :body (:body node),\n   640\t                               :env env}\n   641\t                              vm)\n   642\t               :application\n   643\t               (recur (:operator node)\n   644\t                      env\n   645\t                      {:frame node, :next k, :env env, :type :eval-operator}\n   646\t                      val\n   647\t                      vm)\n   648\t               :if (recur (:test node)\n   649\t                          env\n   650\t                          {:frame node, :next k, :env env, :type :eval-test}\n   651\t                          val\n   652\t                          vm)\n   653\t               (let [state (cesk-return vm node env k val)\n   654\t                     next (cesk-transition state nil)]\n   655\t                 (if (or (:blocked? next)\n   656\t                         (and (nil? (:control next)) (nil? (:k next))))\n   657\t                   next\n   658\t                   (recur (:control next)\n   659\t                          (:env next)\n   660\t                          (:k next)\n   661\t                          (:value next)\n   662\t                          next))))\n   663\t        :else (let [result (cesk-return vm control env k val)]\n   190\t                                {:park-entry-fns park-entry-fns}))]\n   191\t    (if blocked?\n   192\t      {:stop (assoc state :control nil :k nil)}\n   193\t      {:continue [state value]})))\n   194\t\n   195\t\n   196\t(defn- apply-call\n   197\t  \"The §4.2 call transition, with the arguments already isolated from the\n   198\t   operand stack. Returns `{:goto [seg pc val St E K vm image]}` to continue,\n   199\t   `{:stop vm}` when the call blocked, or throws for a non-function.\n   200\t\n   201\t   A tail call grows neither K nor St: the frame the caller would have pushed\n   202\t   is the frame its own caller gave it. A primitive that yields an effect\n   203\t   parks with the continuation after the call site.\"\n   204\t  [code seg pc val St E K vm tail? f args]\n   205\t  (cond\n   206\t    (= :closure (:type f))\n   207\t    (let [E' (merge (:env f) (engine/bind-params (:params f) args))\n   208\t          frame {:type :return, :segment seg, :pc (inc pc), :env E,\n   209\t                 :stack-base (count St)}\n   210\t          seg' (:segment f)]\n   211\t      {:goto [seg' (:entry f) val St E' (if tail? K (conj K frame))\n   212\t              vm (get code seg')]})\n   213\t    (fn? f)\n   214\t    (let [result (apply f args)]\n   215\t      (if (module/effect? result)\n   216\t        (let [{:keys [state value blocked?]}\n   217\t              (engine/handle-effect\n   218\t                (put-registers vm seg pc val St E K)\n   219\t                result\n   220\t                {:park-entry-fns (call-park-entries seg pc E St K)})]\n   221\t          (if blocked?\n   222\t            {:stop (assoc state :control nil :k nil)}\n   223\t            {:goto [seg (inc pc) value St E K state (get code seg)]}))\n   224\t        {:goto [seg (inc pc) result St E K vm (get code seg)]}))\n   225\t    :else (throw (ex-info \"Cannot apply non-function\" {:fn f}))))\n   226\t\n   227\t\n   228\t;; =============================================================================\n   250\t             E (:env vm)\n   251\t             K (or (:k vm) [])\n   252\t             vm vm\n   253\t             image (get code segment)\n   254\t             fuel fuel]\n   255\t        (if (and fuel (zero? fuel))\n   256\t          (put-registers vm seg pc val St E K)\n   257\t          (let [inst (nth (:code image) pc)\n   258\t                op (nth inst 0)]\n   259\t            (case op\n   260\t              ;; :const — val ← literal (opcode 1, :literal)\n   261\t              1 (recur seg (inc pc) (nth inst 1) St E K vm image\n   262\t                       (and fuel (dec fuel)))\n   263\t              ;; :var — val ← resolve(E, S, prims, modules, name) (2, :load-var)\n   264\t              2 (recur seg (inc pc)\n   265\t                       (engine/resolve-var E (:store vm) (:primitives vm)\n   266\t                                           (:modules vm) (nth inst 1))\n   267\t                       St E K vm image (and fuel (dec fuel)))\n   268\t              ;; :closure — val ← clo(params, entry, seg, E) (4, :lambda)\n   269\t              4 (recur seg (inc pc)\n   270\t                       {:type :closure,\n   271\t                        :params (nth inst 1),\n   272\t                        :entry (nth inst 2),\n   273\t                        :segment seg,\n   274\t                        :env E}\n   275\t                       St E K vm image (and fuel (dec fuel)))\n   276\t              ;; :push — St ← St ⧺ [val] (22, :push)\n   277\t              22 (recur seg (inc pc) val (conj St val) E K vm image\n   278\t                        (and fuel (dec fuel)))\n   279\t              ;; :jump — pc ← target (8, :jump)\n   280\t              8 (recur seg (nth inst 1) val St E K vm image\n   281\t                       (and fuel (dec fuel)))\n   282\t              ;; :branch-false — pc ← val ? pc+1 : target (7, :branch)\n   283\t              7 (recur seg (if val (inc pc) (nth inst 1)) val St E K vm image\n   284\t                       (and fuel (dec fuel)))\n   285\t              ;; :halt — halt with val as the result (23, :halt)\n   286\t              23 (put-registers vm nil nil val [] E nil)\n   287\t              ;; :return — pop a frame, or halt on an empty K (6, :return)\n   288\t              6 (if-let [frame (peek K)]\n   289\t                  (recur (:segment frame) (:pc frame) val\n   290\t                         (subvec St 0 (:stack-base frame))\n   291\t                         (:env frame) (pop K)\n   292\t                         vm (get (:code vm) (:segment frame))\n   293\t                         (and fuel (dec fuel)))\n   294\t                  (put-registers vm nil nil val [] E nil))\n   295\t              ;; :gensym — val ← fresh id; counter advances (9, :gensym)\n   296\t              9 (let [[id vm'] (engine/gensym vm (nth inst 1))]\n   297\t                  (recur seg (inc pc) id St E K vm' image\n   298\t                         (and fuel (dec fuel))))\n   299\t              ;; :store-get — val ← S[key] (10, :store-get)\n   300\t              10 (recur seg (inc pc) (get (:store vm) (nth inst 1))\n   301\t                        St E K vm image (and fuel (dec fuel)))\n   302\t              ;; :store-put — S[key] ← v; val ← v (11, :store-put)\n   303\t              11 (let [vm' (assoc vm :store (assoc (:store vm)\n   304\t                                                   (nth inst 1)\n   305\t                                                   (nth inst 2)))]\n   306\t                   (recur seg (inc pc) (nth inst 2) St E K vm' image\n   307\t                          (and fuel (dec fuel))))\n   308\t              ;; :current-continuation — val ← {seg, pc+1, E, St, K} (19)\n   309\t              19 (recur seg (inc pc)\n   310\t                        {:type :reified-continuation,\n   311\t                         :segment seg,\n   312\t                         :pc (inc pc),\n   313\t                         :env E,\n   314\t                         :stack St,\n   315\t                         :k K}\n   338\t                       control (:control vm')]\n   339\t                   (recur (:segment control) (:pc control) val\n   340\t                          (or (:stack vm') []) (:env vm') (or (:k vm') [])\n   341\t                          vm' (get (:code vm') (:segment control))\n   342\t                          (and fuel (dec fuel))))\n   343\t              ;; :call — apply f to argc popped arguments (5, :call)\n   344\t              5 (let [argc (nth inst 1)\n   345\t                      total (count St)\n   346\t                      f-pos (- total argc 1)\n   347\t                      r (apply-call code seg pc val\n   348\t                                    (subvec St 0 f-pos) E K vm\n   349\t                                    false (nth St f-pos)\n   350\t                                    (subvec St (inc f-pos) total))]\n   351\t                  (if-let [[seg' pc' val' St' E' K' vm' image'] (:goto r)]\n   352\t                    (recur seg' pc' val' St' E' K' vm' image'\n   353\t                           (and fuel (dec fuel)))\n   354\t                    (:stop r)))\n   355\t              ;; :call with :yin.code/tail? — same, frame-free (20, :tailcall)\n   356\t              20 (let [argc (nth inst 1)\n   357\t                       total (count St)\n   358\t                       f-pos (- total argc 1)\n   359\t                       r (apply-call code seg pc val\n   360\t                                     (subvec St 0 f-pos) E K vm\n   361\t                                     true (nth St f-pos)\n   362\t                                     (subvec St (inc f-pos) total))]\n   363\t                   (if-let [[seg' pc' val' St' E' K' vm' image'] (:goto r)]\n   364\t                     (recur seg' pc' val' St' E' K' vm' image'\n   365\t                            (and fuel (dec fuel)))\n   366\t                     (:stop r)))\n   367\t              ;; :stream-make — effect :stream/make (12)\n   368\t              12 (let [r (run-effect vm seg pc val St E K\n   369\t                                     {:effect :stream/make,\n   370\t                                      :capacity (or (nth inst 1)\n","exit_code":0,"status":"completed"}}
