   nil nil nil nil nil error))\n  1169\t                    (fail error))))\n  1170\t      (let [{:keys [trees indexes index run-index definitions]} admitted\n  1171\t            store0 (or (:store ctx) {})\n  1172\t            store (harvest store0 #(nth indexes %) definitions)\n  1173\t            catalogue (into []\n  1174\t                            (comp (filter :declared?)\n  1175\t                                  (map (fn [{:keys [name tree path value]}]\n  1176\t                                         {:name name,\n  1177\t                                          :macro-tree (packet-of (nth indexes tree) value),\n  1178\t                                          :source [tree path]})))\n  1179\t                            definitions)\n  1180\t            ;; only the run tree is expanded, so only its declarations are\n  1181\t            ;; replaced; every catalogue entry still resolves by index\n  1182\t            [index standins]\n  1183\t            (reduce (fn [[index acc] [k {:keys [name source]}]]\n  1184\t                      (if (= run-index (first source))\n  1185\t                        (let [[index s] (intern-body index [standin-tag name k])]\n    48\t   Extra args beyond params' length are dropped. §7.7.2: an under-arity\n    49\t   call leaves missing parameter names bound to nil, not absent.\"\n    50\t  [params args]\n    51\t  (into {} (map vector params (concat args (repeat nil)))))\n    52\t\n    53\t\n    54\t(defn resolve-var\n    55\t  \"Look up a variable name: env -> store -> primitives -> module registry.\n    56\t\n    57\t   The registry is a value supplied by the composition, not a global.\"\n    58\t  [env store primitives registry name]\n    59\t  (if-let [pair (find env name)]\n    60\t    (val pair)\n    61\t    (if-let [pair (find store name)]\n    62\t      (val pair)\n    63\t      (if-let [pair (find primitives name)]\n    64\t        (vm/primitive-function (val pair))\n    65\t        (if-let [resolved (when (namesp