{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/semantic.cljc | sed -n '1,350p'; nl -ba src/cljc/yin/vm/semantic/analysis.cljc; nl -ba src/cljc/yin/vm/semantic/frame.cljc | sed -n '1,210p'\"","aggregated_output":"     1\t(ns yin.vm.semantic\n     2\t  \"The register-shaped canonical evaluator, phase 4b (effects, continuations, FFI and module installation).\"\n     3\t  (:require [dao.jing :as jing]\n     4\t            [dao.stream.apply :as apply2]\n     5\t            [yin.vm :as vm]\n     6\t            [yin.vm.engine :as engine]\n     7\t            [yin.vm.ffi :as ffi]\n     8\t            [yin.vm.module :as module]\n     9\t            [yin.vm.telemetry :as telemetry]\n    10\t            [yin.vm.values :as values]\n    11\t            [yin.vm.semantic.code :as code]\n    12\t            [yin.vm.semantic.linearize :as linearize]\n    13\t            [yin.vm.semantic.analysis :as analysis]))\n    14\t\n    15\t\n    16\t(defrecord SemanticVM\n    17\t  [blocked?       ; boolean, true if blocked\n    18\t   bridge         ; explicit host-side FFI bridge state\n    19\t   halted?        ; boolean, true when active continuation has completed\n    20\t   k              ; continuation, a vector of frames (innermost last) or nil\n    21\t   program        ; segment id of the last loaded batch\n    22\t   control        ; {:segment id :pc n} or nil\n    23\t   env            ; persistent lexical scope map\n    24\t   free-env       ; checked initial environment, fixed for this instance\n    25\t   window         ; sparse body-local register map\n    26\t   id-counter     ; integer counter for unique IDs\n    27\t   parked         ; parked continuations map\n    28\t   primitives     ; primitive operations map\n    29\t   primitive-profiles ; portable primitive profile projection\n    30\t   primitive-canonical-names ; declared aliases for identity reverse lookup\n    31\t   modules        ; module registry value\n    32\t   make-stream    ; host-supplied stream constructor, or nil\n    33\t   call-capacity  ; declared capacity of the FFI pair\n    34\t   ready-queue    ; vector of runnable continuations\n    35\t   store          ; heap memory map\n    36\t   value          ; last computed value\n    37\t   wait-set       ; vector of continuations waiting on a transport\n    38\t   telemetry      ; telemetry config map ({:stream … :vm-id …}) or nil\n    39\t   telemetry-step ; telemetry snapshot counter\n    40\t   telemetry-t    ; telemetry transaction counter\n    41\t   telemetry-eid  ; telemetry entity-id seed, floored at datom/first-user-id\n    42\t   vm-model       ; telemetry model keyword\n    43\t   vm-id          ; telemetry instance id, minted by telemetry/install\n    44\t   code           ; {segment-id image}; built once per segment, never written\n    45\t   code-aliases   ; {address segment-id}; additive, one address one id (UCF §7.3.4)\n    46\t   gc])           ; {:since :base :threshold :pinned}: heap reclamation\n    47\t\n    48\t\n    49\t\n    50\t(defn put-registers\n    51\t  \"Materialize control, window, environment and continuation; value is exit-only.\"\n    52\t  [machine seg pc W E K]\n    53\t  (assoc machine :control (when seg {:segment seg :pc pc})\n    54\t         :window W :env E :k (when (seq K) K)\n    55\t         :halted? (and (not (:blocked? machine)) (nil? seg))))\n    56\t\n    57\t\n    58\t(defn- return-to\n    59\t  \"The one popped-frame delivery: retain exactly the saved window and write rd.\"\n    60\t  [frame value]\n    61\t  (assoc frame :window (assoc (:window frame) (:rd frame) value)))\n    62\t\n    63\t\n    64\t(defn- act-payload\n    65\t  [seg pc E W K rd facts]\n    66\t  {:segment seg :pc (inc pc) :env E\n    67\t   :window (select-keys W (analysis/saved facts (inc pc) rd))\n    68\t   :k K :deliver {:deliver :rd :rd rd}})\n    69\t\n    70\t\n    71\t(defn- entry-builders\n    72\t  [payload]\n    73\t  {:stream/put (fn [_state _effect result]\n    74\t                 (assoc payload :reason :put :stream-id (:stream-id result)))\n    75\t   :stream/next (fn [_state _effect result]\n    76\t                  (assoc payload :reason :next :cursor-ref (:cursor-ref result)\n    77\t                         :stream-id (:stream-id result)))\n    78\t   :module/require (fn [_state _effect _result] payload)})\n    79\t\n    80\t\n    81\t(defn- act-builders\n    82\t  [seg pc E W K rd facts]\n    83\t  (entry-builders (act-payload seg pc E W K rd facts)))\n    84\t\n    85\t\n    86\t(defn- tail-builders\n    87\t  [seg pc K]\n    88\t  (entry-builders {:segment seg :site pc :k K :deliver {:deliver :return}}))\n    89\t\n    90\t\n    91\t(defn- run-effect\n    92\t  [machine seg pc W E K effect builders]\n    93\t  (let [{:keys [state value blocked?]}\n    94\t        (engine/handle-effect (put-registers machine seg pc W E K) effect\n    95\t                              (when builders {:park-entry-fns builders}))]\n    96\t    (if blocked?\n    97\t      {:stop (assoc state :control nil :k nil)}\n    98\t      {:continue [state value]})))\n    99\t\n   100\t\n   101\t(defn register-restore\n   102\t  \"Re-park a retained FFI request, decode its response, then deliver exactly once.\"\n   103\t  ([base entry] (register-restore base entry (:value entry)))\n   104\t  ([base entry value]\n   105\t   (if (:request-sent entry)\n   106\t     (let [wait (cond-> (ffi/response-wait-entry entry (:call-id entry))\n   107\t                  (and (:response-cursor entry) (:response-stream entry))\n   108\t                  (assoc :cursor-ref {:type :cursor-ref :id (:response-cursor entry)}\n   109\t                         :stream-id (:response-stream entry)))]\n   110\t       (assoc base :wait-set (conj (vec (:wait-set base)) wait)\n   111\t              :control nil :k nil :value :yin/blocked :blocked? true :halted? false))\n   112\t     (let [call-id (:call-id entry)\n   113\t           base (if call-id (update base :parked dissoc call-id) base)\n   114\t           value (if call-id (ffi/call-result value call-id) value)]\n   115\t       (case (get-in entry [:deliver :deliver])\n   116\t         :rd (put-registers base (:segment entry) (:pc entry)\n   117\t                            (assoc (:window entry) (get-in entry [:deliver :rd]) value)\n   118\t                            (:env entry) (:k entry))\n   119\t         :return (if-let [frame (peek (:k entry))]\n   120\t                   (put-registers base (:segment frame) (:pc frame)\n   121\t                                  (:window (return-to frame value))\n   122\t                                  (:env frame) (pop (:k entry)))\n   123\t                   (assoc (put-registers base nil nil {}\n   124\t                                         (engine/without-store-of (:env base)) nil)\n   125\t                          :value value))\n   126\t         (throw (ex-info \"Entry carries no delivery record\" {:rule :deliver :entry entry})))))))\n   127\t\n   128\t\n   129\t(defn- scheduler-round\n   130\t  [machine]\n   131\t  (engine/scheduler-round machine register-restore))\n   132\t\n   133\t\n   134\t(defn vm-hot\n   135\t  \"Execute fuel instructions with the activation in locals; nil fuel runs to exit.\"\n   136\t  [machine fuel]\n   137\t  (if (and (nil? (:control machine)) (nil? (:k machine)))\n   138\t    (scheduler-round machine)\n   139\t    (let [{:keys [segment pc]} (:control machine)]\n   140\t      (loop [machine machine seg segment pc pc W (:window machine)\n   141\t             E (:env machine) K (or (:k machine) []) fuel fuel]\n   142\t        (if (and fuel (zero? fuel))\n   143\t          (put-registers machine seg pc W E K)\n   144\t          (let [image (get (:code machine) seg)\n   145\t                inst (nth (:vector image) pc)\n   146\t                op (nth inst 0)\n   147\t                remaining (when fuel (dec fuel))]\n   148\t            (case op\n   149\t              :const (recur machine seg (inc pc) (assoc W (nth inst 1) (nth inst 2)) E K remaining)\n   150\t              :var (recur machine seg (inc pc)\n   151\t                          (assoc W (nth inst 1)\n   152\t                                 (engine/resolve-var E\n   153\t                                                     (engine/active-store machine (engine/env-store-of E))\n   154\t                                                     (:primitives machine) (:modules machine) (nth inst 2)))\n   155\t                          E K remaining)\n   156\t              :closure (recur machine seg (inc pc)\n   157\t                              (assoc W (nth inst 1)\n   158\t                                     (values/closure (:owner machine)\n   159\t                                                     {:type :closure :params (vm/check-params! (nth inst 2))\n   160\t                                                      :entry (nth inst 3) :segment seg :env E}))\n   161\t                              E K remaining)\n   162\t              :jump (recur machine seg (nth inst 1) W E K remaining)\n   163\t              :branch-false (recur machine seg (if (get W (nth inst 1)) (inc pc) (nth inst 2)) W E K remaining)\n   164\t              :define (let [value (get W (nth inst 3))\n   165\t                            next-state (engine/put-active machine\n   166\t                                                          (engine/env-store-of E) (nth inst 2) value)]\n   167\t                        (recur next-state seg (inc pc) (assoc W (nth inst 1) value) E K remaining))\n   168\t              :gensym (let [[id next-state] (engine/gensym machine (nth inst 2))]\n   169\t                        (recur next-state seg (inc pc) (assoc W (nth inst 1) id) E K remaining))\n   170\t              :store-get (recur machine seg (inc pc)\n   171\t                                (assoc W (nth inst 1) (get (engine/active-store machine (engine/env-store-of E)) (nth inst 2)))\n   172\t                                E K remaining)\n   173\t              :store-put (let [next-state (engine/put-active machine\n   174\t                                                             (engine/env-store-of E) (nth inst 2) (nth inst 3))]\n   175\t                           (recur next-state seg (inc pc) (assoc W (nth inst 1) (nth inst 3)) E K remaining))\n   176\t              :halt (assoc (put-registers machine nil nil {} (engine/without-store-of E) nil) :value (get W (nth inst 1)))\n   177\t              :return (let [value (get W (nth inst 1))]\n   178\t                        (if-let [frame (peek K)]\n   179\t                          (recur machine (:segment frame) (:pc frame)\n   180\t                                 (:window (return-to frame value)) (:env frame) (pop K) remaining)\n   181\t                          (assoc (put-registers machine nil nil {} (engine/without-store-of E) nil) :value value)))\n   182\t              :call (let [rd (nth inst 1) f (get W (nth inst 2))\n   183\t                          args (mapv #(get W %) (nth inst 3)) tail? (nth inst 4)]\n   184\t                      (case (engine/operator-kind machine f)\n   185\t                        :closure (let [c (values/payload f)\n   186\t                                       frame (when-not tail?\n   187\t                                               {:type :return :segment seg :pc (inc pc) :env E\n   188\t                                                :window (select-keys W (analysis/saved (:analysis image) (inc pc) rd)) :rd rd})]\n   189\t                                   (recur machine (:segment c) (:entry c) {}\n   190\t                                          (merge (:env c) (engine/bind-params (:params c) args))\n   191\t                                          (if tail? K (conj K frame)) remaining))\n   192\t                        :host-fn\n   193\t                        (let [result (apply f args)\n   194\t                              effect? (module/effect? result)\n   195\t                              r (if effect?\n   196\t                                  (run-effect (engine/check-callee-effect!\n   197\t                                                (put-registers machine seg pc W E K) f result)\n   198\t                                              seg pc W E K result\n   199\t                                              (if tail? (tail-builders seg pc K)\n   200\t                                                  (act-builders seg pc E W K rd (:analysis image))))\n   201\t                                  {:continue [machine result]})]\n   202\t                          (if-let [[next-state value] (:continue r)]\n   203\t                            (let [E' (if effect? (:env next-state) E)\n   204\t                                  K' (if effect? (or (:k next-state) []) K)\n   205\t                                  W' (if effect? (:window next-state) W)]\n   206\t                              (if tail?\n   207\t                                (if-let [frame (peek K')]\n   208\t                                  (recur next-state (:segment frame) (:pc frame)\n   209\t                                         (:window (return-to frame value)) (:env frame) (pop K') remaining)\n   210\t                                  (assoc (put-registers next-state nil nil {} (engine/without-store-of E') nil) :value value))\n   211\t                                (recur next-state seg (inc pc) (assoc W' rd value) E' K' remaining)))\n   212\t                            (:stop r)))\n   213\t                        :continuation\n   214\t                        (let [value (engine/continuation-argument args)\n   215\t                              restored (register-restore machine (values/payload f) value)\n   216\t                              control (:control restored)]\n   217\t                          (recur restored (:segment control) (:pc control) (:window restored)\n   218\t                                 (:env restored) (or (:k restored) []) remaining))))\n   219\t              (:stream-make :stream-cursor :stream-close :stream-put :stream-next)\n   220\t              (let [rd (nth inst 1)\n   221\t                    effect (case op\n   222\t                             :stream-make (module/make-effect :stream/make {:capacity (nth inst 2)})\n   223\t                             :stream-cursor (module/make-effect :stream/cursor {:stream (get W (nth inst 2))})\n   224\t                             :stream-close (module/make-effect :stream/close {:stream (get W (nth inst 2))})\n   225\t                             :stream-put (module/make-effect :stream/put {:stream (get W (nth inst 2)) :val (get W (nth inst 3))})\n   226\t                             :stream-next (module/make-effect :stream/next {:cursor (get W (nth inst 2))}))\n   227\t                    r (run-effect machine seg pc W E K effect\n   228\t                                  (when (contains? #{:stream-put :stream-next} op)\n   229\t                                    (act-builders seg pc E W K rd (:analysis image))))]\n   230\t                (if-let [[next-state value] (:continue r)]\n   231\t                  (recur next-state seg (inc pc) (assoc (:window next-state) rd value)\n   232\t                         (:env next-state) (or (:k next-state) []) remaining)\n   233\t                  (:stop r)))\n   234\t              :ffi-call\n   235\t              (let [rd (nth inst 1) ffi-op (nth inst 2)\n   236\t                    args (mapv #(get W %) (nth inst 3))\n   237\t                    {:keys [call-in]} (ffi/require-call-pair! (:resources machine) ffi-op)\n   238\t                    state (put-registers (engine/pin-refs machine args) seg pc W E K)\n   239\t                    call-id (ffi/call-id state (engine/park-id state))\n   240\t                    payload (act-payload seg pc E W K rd (:analysis image))\n   241\t                    parked (engine/park-continuation state payload call-id)\n   242\t                    request (apply2/request call-id ffi-op args)\n   243\t                    result (ffi/put-request state call-in request)\n   244\t                    entry (case (:dao.stream/outcome result)\n   245\t                            :dao.stream/ok (ffi/response-wait-entry payload call-id)\n   246\t                            :dao.stream/full (assoc payload :request-sent true :call-id call-id\n   247\t                                                    :op ffi-op :reason :put\n   248\t                                                    :stream-id vm/call-in-stream-key :datom request)\n   249\t                            (throw (ex-info \"FFI request could not be appended\"\n   250\t                                            {:op ffi-op :outcome (or (:dao.stream/outcome result)\n   251\t                                                                     (:dao.stream.apply/outcome result))})))]\n   252\t                (-> parked\n   253\t                    (update :wait-set (fnil conj []) entry)\n   254\t                    (assoc :control nil :k nil :value :yin/blocked :blocked? true :halted? false)))\n   255\t              :current-continuation\n   256\t              (let [rd (nth inst 1)\n   257\t                    payload (assoc (act-payload seg pc E W K rd (:analysis image)) :type :reified-continuation)]\n   258\t                (recur machine seg (inc pc) (assoc W rd (values/continuation (:owner machine) payload)) E K remaining))\n   259\t              :park (-> (put-registers machine seg pc W E K)\n   260\t                        (engine/park-continuation (act-payload seg pc E W K (nth inst 1) (:analysis image)))\n   261\t                        (assoc :control nil :k nil))\n   262\t              :resume (let [restored (engine/resume-continuation (put-registers machine seg pc W E K)\n   263\t                                                                 (nth inst 1) (get W (nth inst 2)) register-restore)\n   264\t                            control (:control restored)]\n   265\t                        (if (:halted? restored) restored\n   266\t                            (recur restored (:segment control) (:pc control) (:window restored)\n   267\t                                   (:env restored) (or (:k restored) []) remaining)))\n   268\t              (throw (ex-info \"Unknown register instruction\" {:op op})))))))))\n   269\t\n   270\t\n   271\t(defn- register-run-scheduler\n   272\t  [machine]\n   273\t  (engine/run-loop machine engine/active-continuation? #(vm-hot % nil)\n   274\t                   #(engine/resume-from-run-queue % register-restore)))\n   275\t\n   276\t\n   277\t(defn- store-image\n   278\t  [images image]\n   279\t  (let [seg (:segment image)]\n   280\t    (if-let [existing (find images seg)]\n   281\t      (if (= (:address (val existing)) (:address image)) images\n   282\t          (throw (ex-info \"Cannot load segment: the id already holds different code\" {:segment seg})))\n   283\t      (assoc images seg image))))\n   284\t\n   285\t\n   286\t(defn- store-alias\n   287\t  [aliases image]\n   288\t  (let [address (:address image) seg (:segment image)]\n   289\t    (if-let [prior (find aliases address)]\n   290\t      (if (= (val prior) seg) aliases\n   291\t          (throw (ex-info \"Cannot load segment: the address is already aliased to another id\" {:address address :aliased-to (val prior)})))\n   292\t      (assoc aliases address seg))))\n   293\t\n   294\t\n   295\t(defn- admit-image\n   296\t  [machine v stamp opts]\n   297\t  (let [image (code/load-vector v stamp)\n   298\t        seg (or (get (:code-aliases machine) (:address image)) (:id opts)\n   299\t                (dec (vm/loaded-code-floor (:code machine))))]\n   300\t    (assoc image :segment seg :length (count v) :analysis (analysis/analyze v))))\n   301\t\n   302\t\n   303\t(defn load-vector\n   304\t  \"Validate and load a v4 vector; an existing address retains its local id.\"\n   305\t  ([machine v stamp] (load-vector machine v stamp {}))\n   306\t  ([machine v stamp opts]\n   307\t   (let [image (admit-image machine v stamp opts) seg (:segment image)]\n   308\t     (assoc machine :code (store-image (:code machine) image)\n   309\t            :code-aliases (store-alias (:code-aliases machine) image)\n   310\t            :program seg :control {:segment seg :pc 0} :window {} :k nil\n   311\t            :halted? false :blocked? false :value nil))))\n   312\t\n   313\t\n   314\t(defn attach-image\n   315\t  \"Attach a validated vector without changing execution fields.\"\n   316\t  [machine v stamp]\n   317\t  (let [image (admit-image machine v stamp {})]\n   318\t    (assoc machine :code (store-image (:code machine) image)\n   319\t           :code-aliases (store-alias (:code-aliases machine) image))))\n   320\t\n   321\t\n   322\t(defn load-ast\n   323\t  \"Project AST datoms through the phase-3 loader.\"\n   324\t  [machine datoms stamp]\n   325\t  (vm/check-contract! vm/ast-contract stamp)\n   326\t  (load-vector machine (:vector (linearize/project-datoms datoms)) code/contract))\n   327\t\n   328\t\n   329\t(extend-type SemanticVM\n   330\t  vm/IVM\n   331\t  (step [machine] (telemetry/emit-snapshot\n   332\t                    (if (engine/ready-for-ingress? machine) machine (vm-hot machine 1)) :step))\n   333\t  (run [machine] (ffi/maybe-run machine register-run-scheduler))\n   334\t  (eval [machine ast]\n   335\t    (when ast (throw (ex-info \"The semantic VM executes loaded vectors; use load-ast\" {:ast ast})))\n   336\t    (engine/restore-initial-env (:env machine) (vm/run machine)))\n   337\t  (reset [machine]\n   338\t    (assoc machine :control (when-let [seg (:program machine)] {:segment seg :pc 0})\n   339\t           :window {} :k nil :value nil :halted? (nil? (:program machine)) :blocked? false))\n   340\t  (halted? [machine] (engine/halted-with-empty-queue? machine))\n   341\t  (blocked? [machine] (engine/vm-blocked? machine))\n   342\t  (value [machine] (engine/vm-value machine))\n   343\t  vm/IVMState\n   344\t  (control [machine] (:control machine))\n   345\t  (environment [machine] (:env machine))\n   346\t  (store [machine] (:store machine))\n   347\t  (continuation [machine] (:k machine)))\n   348\t\n   349\t\n   350\t(defn create-vm\n     1\t(ns yin.vm.semantic.analysis\n     2\t  \"Static facts per pc derived from A\n     3\t   (`docs/design/yin.vm.semantic.md` §8.1): per body, the\n     4\t   explicit control-flow graph, `def`, `use`, the live-in set `L` by\n     5\t   backward liveness to a fixed point, and the saved-window rule\n     6\t   `saved(p, rd) = L(p) − {rd}`.\n     7\t\n     8\t   Pure functions of a vector that passed\n     9\t   `yin.vm.semantic.code/well-formed?`. Nothing here is persisted\n    10\t   in A; a receiver recomputes it from the vector alone.\"\n    11\t  (:require [clojure.set :as set]\n    12\t            [yin.vm.semantic.code :as code]))\n    13\t\n    14\t\n    15\t(defn successors\n    16\t  \"§8.1's successor relation for the instruction at `pc`: none for\n    17\t   `:return`, `:halt`, `:resume` and a tail `:call` (runtime\n    18\t   terminators); the target for `:jump`; `pc+1` and the target for\n    19\t   `:branch-false`; `pc+1` otherwise. Every edge stays inside the body\n    20\t   (§3.4 item 6).\"\n    21\t  [v pc]\n    22\t  (let [t (nth v pc)]\n    23\t    (case (nth t 0)\n    24\t      (:return :halt :resume) []\n    25\t      :jump [(nth t 1)]\n    26\t      :branch-false [(inc pc) (nth t 2)]\n    27\t      :call (if (code/tail-call? t) [] [(inc pc)])\n    28\t      [(inc pc)])))\n    29\t\n    30\t\n    31\t(defn defs\n    32\t  \"`def(pc)`: `#{rd}` for an instruction with a destination slot, `#{}`\n    33\t   otherwise. A tail `:call` names its `rd` and has no successor, so its\n    34\t   `def` never reaches an `L`.\"\n    35\t  [v pc]\n    36\t  (if-let [r (code/rd (nth v pc))] #{r} #{}))\n    37\t\n    38\t\n    39\t(defn uses\n    40\t  \"`use(pc)`: the instruction's register operands, as a set.\"\n    41\t  [v pc]\n    42\t  (set (code/uses (nth v pc))))\n    43\t\n    44\t\n    45\t(defn- body-live\n    46\t  \"Backward liveness over one body `[start, end)` to a fixed point:\n    47\t   `L(p) = use(p) ∪ (⋃ L(s) for s in succ(p)) − def(p)`, swept in\n    48\t   decreasing pc order until no set changes. Returns a vector of sets\n    49\t   indexed by `pc - start`.\"\n    50\t  [v start end]\n    51\t  (let [ps (range (dec end) (dec start) -1)\n    52\t        du (mapv (fn [pc] [(uses v pc) (defs v pc) (successors v pc)])\n    53\t                 (range start end))]\n    54\t    (loop [live (vec (repeat (- end start) #{}))]\n    55\t      (let [swept (reduce (fn [live pc]\n    56\t                            (let [[u d ss] (nth du (- pc start))\n    57\t                                  out (reduce (fn [acc s]\n    58\t                                                (into acc\n    59\t                                                      (nth live (- s start))))\n    60\t                                              #{}\n    61\t                                              ss)]\n    62\t                              (assoc live\n    63\t                                     (- pc start)\n    64\t                                     (into u (set/difference out d)))))\n    65\t                          live\n    66\t                          ps)]\n    67\t        (if (= swept live) live (recur swept))))))\n    68\t\n    69\t\n    70\t(defn analyze\n    71\t  \"The §8.1 facts of a well-formed vector. Returns `{:bodies [{:start s\n    72\t   :end e} …] :successors [succ …] :def [set …] :use [set …] :live [set\n    73\t   …]}`, the last four indexed by pc, `:live` being `L` computed per\n    74\t   body over the stated edges, so instructions unreachable from a\n    75\t   terminal path (layout syntax) have an `L` like any other node.\"\n    76\t  [v]\n    77\t  (let [bodies (mapv #(select-keys % [:start :end]) (code/body-ranges v))]\n    78\t    {:bodies bodies,\n    79\t     :successors (mapv #(successors v %) (range (count v))),\n    80\t     :def (mapv #(defs v %) (range (count v))),\n    81\t     :use (mapv #(uses v %) (range (count v))),\n    82\t     :live (into [] (mapcat (fn [{:keys [start end]}] (body-live v start end)))\n    83\t                 bodies)}))\n    84\t\n    85\t\n    86\t(defn live\n    87\t  \"`L(p)` from an `analyze` result.\"\n    88\t  [analysis p]\n    89\t  (nth (:live analysis) p))\n    90\t\n    91\t\n    92\t(defn saved\n    93\t  \"The saved-window rule (§2.4, §8.1): the registers a frame, wait,\n    94\t   parked record or capture resuming at `p` with delivery `{:deliver :rd\n    95\t   :rd rd}` carries, `L(p) − {rd}`. The subtraction is explicit.\"\n    96\t  [analysis p rd]\n    97\t  (disj (live analysis p) rd))\n    98\t\n    99\t\n   100\t(defn reachable\n   101\t  \"The pcs reachable from the start of the body holding `pc`, over the\n   102\t   stated successor edges.\"\n   103\t  [v pc]\n   104\t  (let [bodies (code/body-ranges v)\n   105\t        start (:start (nth bodies (code/body-index bodies pc)))]\n   106\t    (loop [seen #{start}\n   107\t           todo [start]]\n   108\t      (if-let [p (peek todo)]\n   109\t        (let [fresh (remove seen (successors v p))]\n   110\t          (recur (into seen fresh) (into (pop todo) fresh)))\n   111\t        seen))))\n     1\t(ns yin.vm.semantic.frame\n     2\t  \"Pure, ordered validation of decoded canonical continuation frames (§3).\"\n     3\t  (:require [dao.jing.cbor :as cbor]\n     4\t            [yin.vm :as vm]\n     5\t            [yin.vm.values :as values]\n     6\t            [yin.vm.semantic.code :as code]\n     7\t            [yin.vm.semantic.analysis :as analysis]))\n     8\t\n     9\t\n    10\t(defn- problem\n    11\t  [kind path]\n    12\t  {:yin.k/kind kind :yin.k/path path})\n    13\t\n    14\t\n    15\t(defn- closed?\n    16\t  [x required optional]\n    17\t  (and (map? x) (every? #(contains? x %) required)\n    18\t       (every? (into (set required) optional) (keys x))))\n    19\t\n    20\t\n    21\t(defn task-defect\n    22\t  \"X1, once per body, including a halted body with no frames.\"\n    23\t  [task]\n    24\t  (let [e (:free-env task)]\n    25\t    (cond\n    26\t      (not (and (map? e) (every? symbol? (keys e))))\n    27\t      (problem :free-env-shape [:free-env])\n    28\t      (some vm/reserved-name? (keys e))\n    29\t      (problem :reserved-name [:free-env]))))\n    30\t\n    31\t\n    32\t(defn- env?\n    33\t  [e]\n    34\t  (and (closed? e [:yin.k/bindings] [:yin.k/store-of])\n    35\t       (or (not (contains? e :yin.k/store-of)) (some? (:yin.k/store-of e)))\n    36\t       (map? (:yin.k/bindings e))\n    37\t       (every? symbol? (keys (:yin.k/bindings e)))))\n    38\t\n    39\t\n    40\t(defn- lexical-names\n    41\t  [v pc]\n    42\t  (let [bs (code/body-ranges v)]\n    43\t    (loop [b (code/body-index bs pc) names #{}]\n    44\t      (if-let [owner (:owner (nth bs b))]\n    45\t        (recur (code/body-index bs owner) (into names (nth (nth v owner) 2)))\n    46\t        names))))\n    47\t\n    48\t\n    49\t(defn- window-defect\n    50\t  [f v rd prefix path]\n    51\t  (let [pc (:yin.k/pc f) w (:yin.k/window f)\n    52\t        body (nth (code/parse v) (code/body-index (code/body-ranges v) pc))\n    53\t        wanted (analysis/saved (analysis/analyze v) pc rd)\n    54\t        ks (set (keys w))\n    55\t        kind (fn [s] (keyword (str prefix s)))\n    56\t        p (conj path :yin.k/window)]\n    57\t    (cond\n    58\t      (some #(>= % (:registers body)) ks) (problem (kind \"window-scope\") p)\n    59\t      (contains? w rd) (problem (kind \"window-self\") p)\n    60\t      (some #(not (contains? wanted %)) ks) (problem (kind \"window-extra\") p)\n    61\t      (some #(not (contains? w %)) wanted) (problem (kind \"window-missing\") p))))\n    62\t\n    63\t\n    64\t(defn- bindings=\n    65\t  \"Compare free bindings slotwise by encoder content, retaining host equality\n    66\t   for callables and stream, cursor or cell references as data-content= does.\"\n    67\t  [a b]\n    68\t  (let [opaque? (fn [x]\n    69\t                  (or (fn? x) (values/closure? x) (values/continuation? x)\n    70\t                      (and (map? x) (contains? #{:stream-ref :cursor-ref :cell-ref} (:type x)))))]\n    71\t    (and (= (set (keys a)) (set (keys b)))\n    72\t         (every? (fn [[k v]]\n    73\t                   (let [w (get b k)]\n    74\t                     (or (identical? v w)\n    75\t                         (if (or (opaque? v) (opaque? w))\n    76\t                           (= v w)\n    77\t                           (cbor/content= v w))))) a))))\n    78\t\n    79\t\n    80\t(defn defect\n    81\t  \"First §3 defect, or nil. Code is already well formed; task is plain\n    82\t   {:free-env map :parked-key P :ffi-call-ids set}. No engine is read.\n    83\t   Values have already passed the carrier's value-domain checks.\"\n    84\t  [frame code-map context task]\n    85\t  (let [act? (= :act (:yin.k/state frame))\n    86\t        required (if act?\n    87\t                   [:yin.k/state :yin.k/segment :yin.k/pc :yin.k/env\n    88\t                    :yin.k/window :yin.k/deliver :yin.k/k]\n    89\t                   [:yin.k/state :yin.k/segment :yin.k/site :yin.k/deliver :yin.k/k])\n    90\t        k (:yin.k/k frame)\n    91\t        returns (when (vector? k) (mapv (fn [i] [(nth k i) [:yin.k/k i]]) (range (count k))))\n    92\t        all (into [[frame []]] returns)\n    93\t        envs (if act? all returns)]\n    94\t    (or\n    95\t      ;; S1-S4, globally before any dependent read.\n    96\t      (when-not (and (contains? #{:act :tail} (:yin.k/state frame))\n    97\t                     (closed? frame required [:yin.k/pending]))\n    98\t        (problem :frame-shape []))\n    99\t      (when-not (vector? k) (problem :k-shape [:yin.k/k]))\n   100\t      (some (fn [[f p]]\n   101\t              (when-not (and (closed? f [:yin.k/frame-type :yin.k/segment :yin.k/pc\n   102\t                                         :yin.k/env :yin.k/window :yin.k/rd] [])\n   103\t                             (= :return (:yin.k/frame-type f)))\n   104\t                (problem :k-shape p))) returns)\n   105\t      (some (fn [[f p]]\n   106\t              (when-not (and (map? (:yin.k/window f))\n   107\t                             (every? code/reg? (keys (:yin.k/window f))))\n   108\t                (problem :window-representation (conj p :yin.k/window)))) envs)\n   109\t      (some (fn [[f p]]\n   110\t              (when-not (env? (:yin.k/env f))\n   111\t                (problem :env-shape (conj p :yin.k/env)))) envs)\n   112\t      (when-not (map? (:yin.k/deliver frame)) (problem :deliver-shape [:yin.k/deliver]))\n   113\t      ;; C1-C3 across the entire continuation.\n   114\t      (some (fn [[f p]]\n   115\t              (when-not (contains? code-map (:yin.k/segment f))\n   116\t                (problem :segment (conj p :yin.k/segment)))) all)\n   117\t      (some (fn [[f p]]\n   118\t              (let [slot (if (and (empty? p) (not act?)) :yin.k/site :yin.k/pc)\n   119\t                    n (get f slot) v (get code-map (:yin.k/segment f))]\n   120\t                (cond\n   121\t                  (not (code/reg? n)) (problem :pc-kind (conj p slot))\n   122\t                  (not (and (< n (count v)) (or (= slot :yin.k/site) (pos? n))))\n   123\t                  (problem :pc-bounds (conj p slot))))) all)\n   124\t      (some (fn [[f p]]\n   125\t              (let [pc (:yin.k/pc f) bs (code/body-ranges (get code-map (:yin.k/segment f)))]\n   126\t                (when-not (= (code/body-index bs (dec pc)) (code/body-index bs pc))\n   127\t                  (problem :pc-body (conj p :yin.k/pc))))) envs)\n   128\t      (let [v (get code-map (:yin.k/segment frame))\n   129\t            site (if act? (dec (:yin.k/pc frame)) (:yin.k/site frame))\n   130\t            inst (nth v site) op (first inst) rd (code/rd inst)\n   131\t            d (:yin.k/deliver frame)]\n   132\t        (or\n   133\t          (if act?\n   134\t            (or\n   135\t              (when-not (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} op)\n   136\t                            (and (= :call op) (not (code/tail-call? inst))))\n   137\t                (problem :site [:yin.k/pc]))\n   138\t              (when-not (= rd (:yin.k/rd d)) (problem :destination [:yin.k/deliver :yin.k/rd]))\n   139\t              (when-not (= {:yin.k/deliver :rd :yin.k/rd rd} d) (problem :deliver [:yin.k/deliver]))\n   140\t              (window-defect frame v rd \"\" []))\n   141\t            (or\n   142\t              (when-not (code/tail-call? inst) (problem :site [:yin.k/site]))\n   143\t              (when-not (= {:yin.k/deliver :return} d) (problem :deliver [:yin.k/deliver]))))\n   144\t          (some (fn [[f p]]\n   145\t                  (let [fv (get code-map (:yin.k/segment f)) fi (nth fv (dec (:yin.k/pc f)))\n   146\t                        frd (:yin.k/rd f)]\n   147\t                    (or\n   148\t                      (when-not (and (= :call (first fi)) (not (code/tail-call? fi)))\n   149\t                        (problem :return-site (conj p :yin.k/pc)))\n   150\t                      (when-not (= frd (code/rd fi)) (problem :return-destination (conj p :yin.k/rd)))\n   151\t                      (window-defect f fv frd \"return-\" p)))) returns)\n   152\t          (some (fn [[f p]]\n   153\t                  (when (some vm/reserved-name? (keys (get-in f [:yin.k/env :yin.k/bindings])))\n   154\t                    (problem :reserved-name (conj p :yin.k/env :yin.k/bindings)))) envs)\n   155\t          (some (fn [[f p]]\n   156\t                  (let [names (lexical-names (get code-map (:yin.k/segment f)) (:yin.k/pc f))\n   157\t                        bindings (get-in f [:yin.k/env :yin.k/bindings])]\n   158\t                    (when-not (and (every? #(contains? bindings %) names)\n   159\t                                   (bindings= (apply dissoc bindings names)\n   160\t                                              (apply dissoc (:free-env task) names)))\n   161\t                      (problem :free-env-mismatch (conj p :yin.k/env :yin.k/bindings))))) envs)\n   162\t          (when-not (and (contains? #{:wait :captured :parked} context)\n   163\t                         (= (= :wait context) (contains? frame :yin.k/pending)))\n   164\t            (problem :pending-presence [:yin.k/pending]))\n   165\t          (when (= :wait context)\n   166\t            (let [reasons (case op\n   167\t                            :stream-next #{:next}\n   168\t                            :stream-put #{:put}\n   169\t                            :ffi-call #{:ffi :ffi-request}\n   170\t                            :call #{:next :put :ffi :ffi-request :link-request :link-response :install}\n   171\t                            #{})]\n   172\t              (when-not (contains? reasons (get-in frame [:yin.k/pending :yin.k/reason]))\n   173\t                (problem :reason-mismatch [:yin.k/pending :yin.k/reason]))))\n   174\t          (when (and (= :wait context)\n   175\t                     (contains? #{:link-request :link-response :install}\n   176\t                                (get-in frame [:yin.k/pending :yin.k/reason]))\n   177\t                     (not (boolean? (get-in frame [:yin.k/pending :yin.k/try?]))))\n   178\t            (problem :pending-try [:yin.k/pending :yin.k/try?]))\n   179\t          (when (and (= :captured context) (not (and act? (= :current-continuation op))))\n   180\t            (problem :captured-site [(if act? :yin.k/pc :yin.k/site)]))\n   181\t          (when (and (= :parked context)\n   182\t                     (not (or (and act? (= :park op))\n   183\t                              (and (contains? (:ffi-call-ids task) (:parked-key task))\n   184\t                                   (or (and act? (= :ffi-call op))\n   185\t                                       (and (not act?) (code/tail-call? inst)))))))\n   186\t            (problem :parked-site [(if act? :yin.k/pc :yin.k/site)])))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"The plan keeps the ready queue as an export refusal, even when a fuel slice returns with an active continuation. I’m checking whether execution can reliably clear that queue, and whether the proposed fuel limit also bounds scheduler and module-install work."}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '430,550p;1450,1500p;2145,2370p'; nl -ba src/cljc/yin/vm/ucf/rows.cljc | sed -n '1570,1740p;1860,1898p;2020,2070p;2230,2330p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '430,550p;1450,1500p;2145,2370p'; nl -ba src/cljc/yin/vm/ucf/rows.cljc | sed -n '1570,1740p;1860,1898p;2020,2070p;2230,2330p'\"","aggregated_output":"   430\t   terminal-resume-outcome reads it.\n   431\t\n   432\t   A woken status the immediate `handle-put`/`handle-next` answers as the\n   433\t   shaped refusal -- `:dao.stream/refused`, or an outcome outside this\n   434\t   contract version -- is shaped into that same refusal value, so whether\n   435\t   the first attempt blocked does not change what the program sees. The\n   436\t   declared error outcomes stay raw, for terminal-resume-outcome to raise.\n   437\t\n   438\t   The ready entry stays pure data: any `:stream` handle a poll resolved\n   439\t   is dropped -- the resource updates carry the successor cursor, and\n   440\t   handles are re-resolved from ids when needed again -- so an entry\n   441\t   neither waits nor runs holding a host object.\"\n   442\t  [state woken]\n   443\t  (mapv (fn [{:keys [entry value cursor status], :as woken-entry}]\n   444\t          (let [cursor-ref (:cursor-ref entry)\n   445\t                value (if (wake-refusal? (:reason entry) status)\n   446\t                        (cond-> {:status :refused\n   447\t                                 :outcome status\n   448\t                                 :stream-id (:stream-id entry)}\n   449\t                          cursor-ref (assoc :cursor-id (:id cursor-ref)))\n   450\t                        value)\n   451\t                updates\n   452\t                (or (:resource-updates woken-entry)\n   453\t                    (when (and cursor-ref cursor)\n   454\t                      (let [cursor-id (:id cursor-ref)\n   455\t                            cursor-data (get (:resources state) cursor-id)]\n   456\t                        {cursor-id (assoc cursor-data :cursor cursor)})))]\n   457\t            (dissoc (assoc entry\n   458\t                           :value value\n   459\t                           :resource-updates updates\n   460\t                           :status status\n   461\t                           :cursor cursor)\n   462\t                    :stream)))\n   463\t        woken))\n   464\t\n   465\t\n   466\t(defn handle-make\n   467\t  \"Handle :stream/make. Creates a stream through the composition's\n   468\t   `:make-stream`, holds the handle in the private `:resources` table, and\n   469\t   answers a sealed reference; the reference is issued first, so a task\n   470\t   with no secret creates no stream.\n   471\t\n   472\t   A nil capacity has no v2 meaning, so the module path defaults exactly as\n   473\t   the AST path does. Absent a supplied constructor this fails and says so;\n   474\t   silently falling back to a private transport is the failure mode the rule\n   475\t   exists to prevent.\n   476\t   Returns [stream-ref updated-state].\"\n   477\t  [state effect id]\n   478\t  (let [capacity (or (:capacity effect) vm/default-stream-capacity)\n   479\t        stream-ref (issue-ref state :stream-ref id)\n   480\t        handle (vm/create-stream! (:make-stream state) capacity :stream/make)]\n   481\t    [stream-ref (assoc-in state [:resources id] handle)]))\n   482\t\n   483\t\n   484\t(defn- gate-refuse!\n   485\t  \"Refuse an immediate effect of a machine whose gate is `:exporting` or\n   486\t   `:ended`: nothing is observed. Returns the gate mode otherwise.\"\n   487\t  [state effect]\n   488\t  (let [mode (vm/gate-mode state)]\n   489\t    (when (contains? #{:exporting :ended} mode)\n   490\t      (fail \"Gate is closed: no observation\"\n   491\t            {:yin.k/gate mode, :effect (:effect effect)}))\n   492\t    mode))\n   493\t\n   494\t\n   495\t(defn- observe-put\n   496\t  \"Observe half of `:stream/put`: the append, as its outcome.\"\n   497\t  [state stream-id val]\n   498\t  (stream/append! (get (:resources state) stream-id) val))\n   499\t\n   500\t\n   501\t(defn- apply-put-outcome\n   502\t  \"Apply half of `:stream/put`: an append outcome to the effect's answer.\"\n   503\t  [state stream-id val result]\n   504\t  (let [o (outcome result)]\n   505\t    (case o\n   506\t      :dao.stream/ok {:value val, :state state}\n   507\t      :dao.stream/full {:park true, :stream-id stream-id, :state state}\n   508\t      (:dao.stream/closed\n   509\t        :dao.stream/invalid-value\n   510\t        :dao.stream/transport-error)\n   511\t      (fail \"Stream append failed\" {:outcome o, :stream-id stream-id})\n   512\t      {:state state,\n   513\t       :value {:status :refused, :outcome o, :stream-id stream-id}})))\n   514\t\n   515\t\n   516\t(defn handle-put\n   517\t  \"Handle :stream/put. Total over the six append outcomes, once the\n   518\t   reference verifies.\n   519\t   Returns {:value v :state s} on success, {:park true :stream-id id :state s}\n   520\t   on `full`. `closed`, `invalid-value` and `transport-error` are errors\n   521\t   that name their outcome, as v1's throw on a closed stream did.\n   522\t   `refused`, and any outcome outside this contract version, is not a\n   523\t   throw: the effect's value is the shaped refusal\n   524\t   {:status :refused, :outcome o, :stream-id id} -- data the program\n   525\t   reads, the way `poll-link-response` answers a refused link.\n   526\t\n   527\t   Under the `:running` gate nothing is observed: the put parks as it\n   528\t   would on `full`.\"\n   529\t  [state effect]\n   530\t  (let [stream-id (check-ref! state :stream/put :stream-ref (:stream effect))\n   531\t        val (:val effect)]\n   532\t    (if (= :running (gate-refuse! state effect))\n   533\t      {:park true, :stream-id stream-id, :state state}\n   534\t      (apply-put-outcome state stream-id val\n   535\t                         (observe-put state stream-id val)))))\n   536\t\n   537\t\n   538\t(defn handle-cursor\n   539\t  \"Handle :stream/cursor. Mints an opaque cursor at `:dao.stream/oldest`\n   540\t   into a cursor cell in `:resources`, and answers a sealed reference.\n   541\t\n   542\t   v1 fabricated `{:position 0}` and touched no stream. Minting is a stream\n   543\t   operation, so `closed` and `transport-error` arrive here.\n   544\t   Returns [cursor-ref updated-state].\"\n   545\t  [state effect id]\n   546\t  (let [stream-id (check-ref! state :stream/cursor :stream-ref (:stream effect))\n   547\t        cursor-ref (issue-ref state :cursor-ref id)\n   548\t        cursor (vm/mint-oldest (get (:resources state) stream-id)\n   549\t                               :stream/cursor)]\n   550\t    [cursor-ref\n  1450\t                                   (receive-module s m (dissoc dep :bindings))))\n  1451\t                               received\n  1452\t                               (linked-entries (:modules vm)))]\n  1453\t                (-> received\n  1454\t                    (update :installs dissoc module-name)\n  1455\t                    (wake-installed module-name module-name nil))))))))))\n  1456\t\n  1457\t\n  1458\t(defn- advance-install\n  1459\t  \"Step the install child of `module-name` in this round, beside every\n  1460\t   other task (section 7.3): `running` runs it until it halts or parks.\n  1461\t   A parked child stays `parked`; a halted one goes on to `validated`; an\n  1462\t   error refuses the install. An error while publishing -- attaching an\n  1463\t   origin image, lowering the slice or a store snapshot, or receiving a\n  1464\t   dependency -- refuses it too, at phase `:linked`, from the state the\n  1465\t   round started with: nothing half-published survives, every waiter is\n  1466\t   restored with the refusal, and no throw leaves the round.\n  1467\t\n  1468\t   Under a custody gate the child is stamped with the root's mode before\n  1469\t   it runs; in `:exporting` and `:ended` it does not run.\"\n  1470\t  [state module-name]\n  1471\t  (let [inst (get-in state [:installs module-name])\n  1472\t        mode (vm/gate-mode state)\n  1473\t        [child refusal]\n  1474\t        (when-not (contains? #{:exporting :ended} mode)\n  1475\t          (try [(vm/run (stamp-gate (:vm inst) mode)) nil]\n  1476\t               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n  1477\t                 [nil (error-refusal module-name e)])))]\n  1478\t    (cond\n  1479\t      (and (nil? child) (nil? refusal)) state\n  1480\t      refusal (refuse-install state module-name refusal)\n  1481\t      (:blocked? child)\n  1482\t      (assoc-in state [:installs module-name]\n  1483\t                (assoc inst :vm child :phase :parked))\n  1484\t      (:halted? child)\n  1485\t      (try (link-install state module-name (assoc inst :vm child))\n  1486\t           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n  1487\t             (refuse-install state module-name\n  1488\t                             (assoc (error-refusal module-name e)\n  1489\t                                    :phase :linked))))\n  1490\t      :else (assoc-in state [:installs module-name]\n  1491\t                      (assoc inst :vm child :phase :running)))))\n  1492\t\n  1493\t\n  1494\t(defn- advance-installs\n  1495\t  [state]\n  1496\t  (reduce advance-install state (sort-by str (keys (:installs state)))))\n  1497\t\n  1498\t\n  1499\t(defn- start-install\n  1500\t  \"`loading`: spawn the child, or refuse on a loader defect. Returns\n  2145\t   raises as an error fails the same way when the resume pops it — and a\n  2146\t   waitset diagnostic, an entry the sweep could not poll at all, raises\n  2147\t   there too, before any continuation is restored.\n  2148\t\n  2149\t   The link wait entries `require` adds (yin.vm.linker.md section 7.2) are\n  2150\t   polled first, by the engine rather than the stream sweep: a\n  2151\t   `:link-request` retries its envelope, a `:link-response` advances its\n  2152\t   own kept cursor to the response carrying its id, and an `:install`\n  2153\t   waits on its install child. The install children are then stepped in\n  2154\t   this same round (section 7.3), so a child that halts restores its\n  2155\t   waiters here; nothing about a child runs inside a restore.\n  2156\t\n  2157\t   The FFI response readers are routed next, also outside the stream\n  2158\t   sweep (`poll-ffi-responses`): a response wakes the reader whose call\n  2159\t   id it names, never whichever reader its cell reached first.\n  2160\t\n  2161\t   A gated machine (any `:yin.k/gate`) observes nothing here: no link\n  2162\t   retry or scan, no FFI response read, no put or next retry. Its install\n  2163\t   children are stamped and stepped in `:running` only.\"\n  2164\t  [state]\n  2165\t  (let [wait-set (:wait-set state)]\n  2166\t    (if (and (empty? wait-set) (empty? (:installs state)))\n  2167\t      state\n  2168\t      (let [state (poll-links state\n  2169\t                              (filterv link-entry? wait-set)\n  2170\t                              (remove link-entry? wait-set))\n  2171\t            wait-set (:wait-set state)\n  2172\t            gated? (some? (vm/gate-mode state))\n  2173\t            state (if gated?\n  2174\t                    state\n  2175\t                    (poll-ffi-responses state\n  2176\t                                        (filterv ffi-response-entry? wait-set)\n  2177\t                                        (remove ffi-response-entry?\n  2178\t                                                wait-set)))\n  2179\t            wait-set (:wait-set state)\n  2180\t            engine-polled? (some-fn link-entry?\n  2181\t                                    ffi-response-entry?\n  2182\t                                    observe-entry?\n  2183\t                                    (fn [e]\n  2184\t                                      (and gated?\n  2185\t                                           (contains? #{:put :next}\n  2186\t                                                      (:reason e)))))\n  2187\t            streams (filterv (complement engine-polled?) wait-set)\n  2188\t            {:keys [woken store], :as result}\n  2189\t            (waitset/check {:waiting streams}\n  2190\t                           waitset-resolver\n  2191\t                           (:resources state))\n  2192\t            v (assoc state\n  2193\t                     :resources store\n  2194\t                     :wait-set (into (:waiting (:waitset result))\n  2195\t                                     (filter engine-polled?)\n  2196\t                                     wait-set))]\n  2197\t        (update v\n  2198\t                :ready-queue (fnil into [])\n  2199\t                (make-woken-run-queue-entries v woken))))))\n  2200\t\n  2201\t\n  2202\t(declare handle-effect resume-continuation)\n  2203\t\n  2204\t\n  2205\t(defn run-loop\n  2206\t  \"Generic eval loop with scheduler support. Ready entries are pure data;\n  2207\t   `resume-fn` pops and restores them.\"\n  2208\t  [state active? step-fn resume-fn]\n  2209\t  (loop [v state]\n  2210\t    (let [q (or (:ready-queue v) [])]\n  2211\t      (cond (active? v) (recur (step-fn v))\n  2212\t            (:blocked? v) (let [v' (check-wait-set v)]\n  2213\t                            (if-let [resumed (resume-fn v')]\n  2214\t                              (recur resumed)\n  2215\t                              (telemetry/emit-snapshot v' :blocked)))\n  2216\t            (seq q) (if-let [resumed (resume-fn v)]\n  2217\t                      (recur resumed)\n  2218\t                      v)\n  2219\t            :else (if (:halted? v) (telemetry/emit-snapshot v :halt) v)))))\n  2220\t\n  2221\t\n  2222\t(def ^:private waitset-diagnostics\n  2223\t  \"The statuses `dao.stream.waitset/check` wakes an entry it could not poll\n  2224\t   at all with: an unsupported reason, an unresolvable entry, or an answer —\n  2225\t   or transport — it could not interpret. No park site in `yin.vm` produces\n  2226\t   an entry that earns one, and an entry that earns one must not reach a\n  2227\t   restore function as a value.\"\n  2228\t  #{:dao.stream.waitset/unsupported-reason\n  2229\t    :dao.stream.waitset/unresolved\n  2230\t    :dao.stream.waitset/invalid-answer})\n  2231\t\n  2232\t\n  2233\t(defn- terminal-resume-outcome\n  2234\t  \"The outcome a woken entry resolved with, when it is one the immediate\n  2235\t   path raises as an error. `handle-put` and `handle-next` raise exactly\n  2236\t   the declared error outcomes of their operation, and whether the first\n  2237\t   attempt blocked must not change that. An outcome outside this contract\n  2238\t   version is the shaped refusal on the immediate path, so it is the\n  2239\t   shaped refusal here too, never a raise. A waitset diagnostic is\n  2240\t   terminal whatever the entry's `:reason` -- an unsupported reason is by\n  2241\t   definition outside the `#{:next :put}` this check otherwise reads --\n  2242\t   so it is named here rather than falling through to the restore. An\n  2243\t   entry that was never polled carries no status.\"\n  2244\t  [entry]\n  2245\t  (let [status (:status entry)]\n  2246\t    (cond\n  2247\t      (contains? waitset-diagnostics status) status\n  2248\t      (= :link-refused status) status\n  2249\t      (contains? ffi/response-loss-statuses status) status\n  2250\t      (contains? #{:next :put} (:reason entry))\n  2251\t      (when (contains? (get wake-error-outcomes (:reason entry)) status)\n  2252\t        status))))\n  2253\t\n  2254\t\n  2255\t(defn- throw-terminal-resume!\n  2256\t  \"Fail a resumed entry exactly as the immediate operation would have. A\n  2257\t   waitset diagnostic names its status and the entry that earned it: there\n  2258\t   is no stream operation whose error vocabulary it belongs to.\"\n  2259\t  [entry o]\n  2260\t  (cond\n  2261\t    (contains? waitset-diagnostics o)\n  2262\t    (fail \"Wait-set entry woke with a diagnostic\" {:status o, :entry entry})\n  2263\t    ;; a refused or lost link, or a refused install: the effect's error\n  2264\t    (= :link-refused o)\n  2265\t    (fail (str \"Module link refused: \"\n  2266\t               (clojure.core/name (or (:reason (:refusal entry)) :refused)))\n  2267\t          (assoc (:refusal entry) :link-module (:name entry)))\n  2268\t    ;; an FFI response stream that can no longer answer this call\n  2269\t    (contains? ffi/response-loss-statuses o)\n  2270\t    (ffi/throw-response-lost! (ffi/response-call-id entry) o)\n  2271\t    (= :next (:reason entry))\n  2272\t    (fail \"Stream read failed\"\n  2273\t          {:outcome o,\n  2274\t           :stream-id (:stream-id entry),\n  2275\t           :cursor-id (:id (:cursor-ref entry))})\n  2276\t    :else (fail \"Stream append failed\"\n  2277\t                {:outcome o, :stream-id (:stream-id entry)})))\n  2278\t\n  2279\t\n  2280\t(defn resume-from-run-queue\n  2281\t  \"Pop first entry from the ready-queue, merge its resource updates into\n  2282\t   the private `:resources` table, and restore VM-specific context.\n  2283\t\n  2284\t   Restoration is dispatched here rather than carried on the entry, so a\n  2285\t   ready entry holds registers, ids, and values — never a closure. The\n  2286\t   terminal-outcome check runs before the restore: a woken retry that ended\n  2287\t   in an outcome the immediate operation raises as an error must fail the\n  2288\t   same way here, not reach Yin code as a value.\n  2289\t\n  2290\t   `restore-fn` is called with three arguments, `base entry val`, where\n  2291\t   `val` is the woken `:value` — the same signature `resume-continuation`\n  2292\t   uses, so one restore serves both engine call sites\n  2293\t   (`yin.vm.engine.md` §7, edit 2).\"\n  2294\t  [state restore-fn]\n  2295\t  (let [run-queue (or (:ready-queue state) [])]\n  2296\t    (when (seq run-queue)\n  2297\t      (let [entry (first run-queue)\n  2298\t            rest-queue (subvec run-queue 1)\n  2299\t            updates (:resource-updates entry)\n  2300\t            ;; a woken entry only ever carries engine-minted keyword keys\n  2301\t            ;; (cursor ids)\n  2302\t            _ (when-let [k (some #(when-not (keyword? %) %) (keys updates))]\n  2303\t                (fail \"Ready entry resource update carries a non-minted key\"\n  2304\t                      {:rule :resource-update-key, :key k}))\n  2305\t            base (assoc state\n  2306\t                        :ready-queue rest-queue\n  2307\t                        :resources (merge (:resources state) updates)\n  2308\t                        :blocked? false\n  2309\t                        :halted? false)]\n  2310\t        (if-let [terminal (terminal-resume-outcome entry)]\n  2311\t          (throw-terminal-resume! entry terminal)\n  2312\t          (restore-fn base entry (:value entry)))))))\n  2313\t\n  2314\t\n  2315\t(defn scheduler-round\n  2316\t  \"One round between continuations: poll the wait set, then resume whatever\n  2317\t   woke, through `restore-fn` (`base entry val -> state`, the one restore\n  2318\t   signature `yin.vm.engine.md` §2.1 states). Returns the polled state when\n  2319\t   nothing woke, so a caller always gets a state back.\n  2320\t\n  2321\t   The restore operation is a composition parameter\n  2322\t   (`yin.vm.engine.md` §7, edit 1); every VM was writing this composition\n  2323\t   by hand.\"\n  2324\t  [state restore-fn]\n  2325\t  (let [v' (check-wait-set state)]\n  2326\t    (or (resume-from-run-queue v' restore-fn) v')))\n  2327\t\n  2328\t\n  2329\t(defn park-id\n  2330\t  \"The local park id the next `park-continuation` mints: `:parked-N` from\n  2331\t   this VM's own counter, unique within the VM only.\"\n  2332\t  [state]\n  2333\t  (keyword (str \"parked-\" (or (:id-counter state) 0))))\n  2334\t\n  2335\t\n  2336\t(defn park-continuation\n  2337\t  \"Add a parked continuation entry and halt the VM.\n  2338\t\n  2339\t   With `id`, that id is both the `:parked` map key and the entry's `:id`\n  2340\t   -- an FFI call parks under its call id (`yin.vm.ffi/call-id`), so one\n  2341\t   id is retained and correlated, never a second mapping. The counter\n  2342\t   advances either way, so the local half of the next id stays fresh.\"\n  2343\t  ([state cont-fields] (park-continuation state cont-fields (park-id state)))\n  2344\t  ([state cont-fields id]\n  2345\t   (let [id-counter (or (:id-counter state) 0)\n  2346\t         parked (merge {:type :parked-continuation, :id id} cont-fields)]\n  2347\t     (-> state\n  2348\t         (update :parked assoc id parked)\n  2349\t         (assoc :value parked\n  2350\t                :halted? true\n  2351\t                :id-counter (inc id-counter))\n  2352\t         (telemetry/emit-snapshot :park {:parked-id id})))))\n  2353\t\n  2354\t\n  2355\t(defn resume-continuation\n  2356\t  \"Restore state from a parked continuation. A machine whose custody\n  2357\t   gate is `:exporting` or `:ended` refuses a direct resume.\"\n  2358\t  [state parked-id resume-val restore-fn]\n  2359\t  (gate-refuse! state {:effect :resume})\n  2360\t  (if-let [parked (get-in state [:parked parked-id])]\n  2361\t    (let [new-state (update state :parked dissoc parked-id)]\n  2362\t      (-> (restore-fn new-state parked resume-val)\n  2363\t          (telemetry/emit-snapshot :resume {:parked-id parked-id})))\n  2364\t    (fail \"Cannot resume: parked continuation not found\"\n  2365\t          {:parked-id parked-id})))\n  2366\t\n  2367\t\n  2368\t(defn gensym\n  2369\t  \"Generate a unique ID and return [id updated-state].\"\n  2370\t  ([state] (gensym state \"id\"))\n  1570\t\n  1571\t(defn- installing-names\n  1572\t  [m]\n  1573\t  (into #{} (mapcat (fn [[mn inst]]\n  1574\t                      (map #(symbol (name mn) (name %))\n  1575\t                           (get-in inst [:response :manifest :yin.module/exports]))))\n  1576\t        (:installs m)))\n  1577\t\n  1578\t\n  1579\t(defn live-pcs\n  1580\t  \"The pcs of v control flow can still reach from at: the successor\n  1581\t   relation (§8.1), so a backward jump makes earlier code live, and from\n  1582\t   each reachable :closure its body from the entry, since reachable code\n  1583\t   can still construct it.\"\n  1584\t  [v at]\n  1585\t  (loop [seen #{at}\n  1586\t         todo [at]]\n  1587\t    (if-let [p (peek todo)]\n  1588\t      (let [t (nth v p)\n  1589\t            fresh (remove seen (cond-> (analysis/successors v p)\n  1590\t                                 (= :closure (nth t 0)) (conj (nth t 3))))]\n  1591\t        (recur (into seen fresh) (into (pop todo) fresh)))\n  1592\t      seen)))\n  1593\t\n  1594\t\n  1595\t(defn- discharge!\n  1596\t  \"The dependency closure over the v4 vectors (§7.1), after the walk that\n  1597\t   found the contexts: every free occurrence control flow can still reach\n  1598\t   from a carried context (live-pcs) is answered there, in resolve-var's\n  1599\t   order: that context's\n  1600\t   E, then the one store engine/active-store selects for it (the root\n  1601\t   store, or the module store its store-of names; both travel), then a\n  1602\t   primitive, an installing module's export, the module registry. Else\n  1603\t   the lift is :yin.k/unsatisfied, discovery :incomplete.\"\n  1604\t  [ctx code]\n  1605\t  (let [m (:m ctx)\n  1606\t        installing (installing-names m)\n  1607\t        answered? (fn [sym e]\n  1608\t                    (let [store-of (engine/env-store-of e)\n  1609\t                          store (if (some? store-of) (get (:module-stores m) store-of {}) (:store m))]\n  1610\t                      (or (vm/reserved-name? sym) (contains? e sym) (contains? store sym)\n  1611\t                          (let [profile (vm/profile-of (:primitives m) sym)]\n  1612\t                            (when (= :host (:yin.k/class profile))\n  1613\t                              (outcome! :yin.k/non-portable :host-state-primitive {:yin.k/name sym}))\n  1614\t                            (or (some? profile) (contains? installing sym)\n  1615\t                                (and (some? (namespace sym))\n  1616\t                                     (some? (module/resolve-module (:modules m)\n  1617\t                                                                   (symbol (str (namespace sym) \".\" (name sym)))))))))))\n  1618\t        scanned (into {} (map (fn [[a v]] [a (scan/free-occurrences v)])) code)\n  1619\t        missing (into #{}\n  1620\t                      (mapcat (fn [{:keys [a at env]}]\n  1621\t                                (let [live (live-pcs (get code a) at)]\n  1622\t                                  (keep (fn [o]\n  1623\t                                          (when (and (contains? live (:at o))\n  1624\t                                                     (not (answered? (:name o) env)))\n  1625\t                                            (:name o)))\n  1626\t                                        (get scanned a)))))\n  1627\t                      (:contexts @(:acc ctx)))]\n  1628\t    (when (seq missing)\n  1629\t      (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:obligations missing}}))))\n  1630\t\n  1631\t\n  1632\t(declare lift-task*)\n  1633\t\n  1634\t\n  1635\t(defn- install-node\n  1636\t  [ctx mn inst opts]\n  1637\t  (let [{:keys [phase parent response]} inst\n  1638\t        response (dissoc response :yin.admit/id :yin.admit/decision\n  1639\t                         :yin.admit/asserters :yin.admit/address)]\n  1640\t    (when-not (contains? #{:running :parked} phase)\n  1641\t      (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name mn :yin.k/phase phase}))\n  1642\t    (when-not (try (cbor/encode response) true\n  1643\t                   (catch #?(:cljd Object :clj Throwable :cljs :default) _e false))\n  1644\t      (outcome! :yin.k/non-portable :install-response {:yin.k/name mn}))\n  1645\t   