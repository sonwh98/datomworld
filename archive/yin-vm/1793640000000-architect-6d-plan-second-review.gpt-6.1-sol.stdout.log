t\n  1380\t\n  1381\t(defn- cell-for!\n  1382\t  [ctx cid]\n  1383\t  (let [cell (get (:resources (:m ctx)) cid)]\n  1384\t    (when-not (and (map? cell) (contains? cell :stream-id))\n  1385\t      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint cid}))\n  1386\t    (cell! ctx cid (:stream-id cell) (:cursor cell))))\n  1387\t\n  1388\t\n  1389\t(defn- address!\n  1390\t  [ctx seg]\n  1391\t  (if-some [a (get-in (:m ctx) [:code seg :address])]\n  1392\t    (do (swap! (:acc ctx) update :segments conj a) a)\n  1393\t    (outcome! :yin.k/non-portable :unaddressed-segment {:yin.k/hint seg})))\n  1394\t\n  1395\t\n  1396\t(defn- scalar-literal?\n  1397\t  [x]\n  1398\t  (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x) (number? x)\n  1399\t      (and (not (cbor/byte-payload? x)) (cbor/numeric? x))))\n  1400\t\n  1401\t\n  1402\t(defn- primitive-name\n  1403\t  [ctx f]\n  1404\t  (let [m (:m ctx)\n  1405\t        n (vm/name-of (:primitives m) (or (:primitive-canonical-names m) {}) f)\n  1406\t        profile (when (symbol? n) (vm/profile-of (:primitives m) n))]\n  1407\t    (cond\n  1408\t      (nil? n) (outcome! :yin.k/non-portable :unnamed-function {})\n  1820\t      (when (vm/reserved-name? k)\n  1821\t        (outcome! :yin.k/undecodable :reserved-name {:yin.k/role :store-key :yin.k/name k})))))\n  1822\t\n  1823\t\n  1824\t(defn- attaches?\n  1825\t  \"The receiving kernel admits vector v (its loader's validation), under\n  1826\t   address a when a is given.\"\n  1827\t  [recv v a]\n  1828\t  (try (let [r (module/attach-module recv v)] (or (nil? a) (contains? (:code-aliases r) a)))\n  1829\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _e false)))\n  1830\t\n  1831\t\n  1832\t(defn- check-install!\n  1833\t  \"One install record: a phase the engine holds a carried child in, the\n  1834\t   retained response link-install reads (status, manifest naming this\n  1835\t   module, exports) with the image spawn-child loads, t