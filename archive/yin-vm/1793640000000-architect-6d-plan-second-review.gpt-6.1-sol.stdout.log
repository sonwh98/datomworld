 1675\t        installs (mapv (fn [[mn inst]] (install-node ctx mn inst opts)) (sort-by #(str (key %)) (:installs m)))\n  1676\t        module-stores (module-store-nodes ctx)\n  1677\t        acc @(:acc ctx)\n  1678\t        segments (:segments acc)\n  1679\t        code (into {} (map (fn [a]\n  1680\t                             (if-some [v (get-in m [:code (get (:code-aliases m) a) :vector])]\n  1681\t                               [a v]\n  1682\t                               (outcome! :yin.k/unsatisfied nil {:yin.k/segment a}))))\n  1683\t                   segments)\n  1684\t        _ (discharge! ctx code)\n  1685\t        index (or (:source-index opts) {})\n  1686\t        missing-trees (into #{} (remove #(seq (get index %))) segments)\n  1687\t        _ (when (seq missing-trees)\n  1688\t            (outcome! :yin.k/unsatisfied nil {:yin.k/discovery :incomplete :yin.k/missing {:yin.k/trees missing-trees}}))\n  1689\t        requires {:yin.k/cursor-profiles (if (seq (:cells acc)) remote/cursor-profiles #{})\n  1690\t                  :yin.k/segments segments\n  1691\t                  :yin.k/trees (select-keys index segments)}\n  1692\t        task (node :task [3 profile kind role (or (:id-counter m) 0) free-node store module-stores parked\n  1693\t                          (node :cursor-cells (mapcat identity (:cells acc))) requires code installs waits\n  1694\t                          (when (= :parked kind) (:id value)) result nil])]\n  1695\t    ;; §3.3: a frame the evaluator itself minted that fails is inconsistent\n  1696\t    (when-let [d (validate-frames task)]\n  1697\t      (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/defect d}))\n  1698\t    task))\n  1699\t\n  1700\t\n  1701\t(declare task-tree)\n  1702\t\n  1703\t\n  1704\t(defn- header-custody\n  1705\t  \"The root's custody slot from the caller's header, by kind: blocked or\n  1706\t   parked takes the occurrence, arbitration, counter and the exclusive\n  1707\t   policy, and the origin when the header names one; halted the origin\n  1708\t   alone (an empty map without one, which the grammar refuses). A nil\n  1709\t   value is an absent key (handoff.cljc's header-of).\"\n  1710\t  [header kind]\n  1711\t  (into {}\n  1712\t        (filter (comp some? val))\n  1713\t        (if (= :halted kind)\n  1714\t          (select-keys header [:yin.k/origin])\n  1715\t          (assoc (select-keys header [:yin.k/occurrence :yin.k/arbitration :yin.k/next-op-seq :yin.k/origin])\n  1716\t                 :yin.k/policy :yin.k/exclusive))))\n  1717\t\n  1718\t\n  1719\t(defn- protect!\n  1720\t  \"Every retained write of the tree under the header's enrolled set (UCF\n  1721\t   7.4.3, 7.7.8; handoff.cljc's protected!): an enrolled target without an\n  1722\t   operation id is :unprotected-pending, an id on an unenrolled target is\n  1723\t   :yin.k/unsatisfied naming the stream.\"\n  1724\t  [task enrolled]\n  1725\t  (doseq [[t _] (task-tree task :root)\n  1726\t          w (nth (:slots t) 13)]\n  1727\t    (let [ss (:slots (second (:slots w)))]\n  1728\t      (when-let [[ti _ oi] (get write-slots (first ss))]\n  1729\t        (let [identity (first (:slots (nth ss ti)))\n  1730\t              enrolled? (contains? enrolled identity)\n  1731\t              carried? (some? (nth ss oi))]\n  1732\t          (cond\n  1733\t            (and enrolled? (not carried?))\n  1734\t            (outcome! :yin.k/non-portable :unprotected-pending {:dao.stream/identity identity})\n  1735\t            (and carried? (not enrolled?))\n  1736\t            (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})\n  1737\t            :else nil))))))\n  1738\t\n  1739\t\n  1740\t(defn lift-task\n  1860\t                     (jing/segment-matches? (:yin.ledger/output record) (:value (:image response))))\n  1861\t        (outcome! :yin.k/undecodable :install-image {:yin.k/name mn})))\n  1862\t    (when-not (= :blocked child-kind)\n  1863\t      (outcome! :yin.k/undecodable :install-child {:yin.k/name mn :yin.k/task-kind child-kind}))))\n  1864\t\n  1865\t\n  1866\t(defn- check-pendings!\n  1867\t  \"Step 8, pending and operations: role, kind, parked id, every :install\n  1868\t   pending names a carried install, every install record.\"\n  1869\t  [recv task role]\n  1870\t  (let [[_ _ kind role' _ _ _ _ parked _ _ _ installs waits parked-id] (:slots task)]\n  1871\t    (when-not (= role role') (outcome! :yin.k/undecodable :role {:yin.k/role role'}))\n  1872\t    (let [names (into #{} (map #(first (:slots %))) installs)]\n  1873\t      (doseq [w waits]\n  1874\t        (let [[reason n] (:slots (second (:slots w)))]\n  1875\t          (when (and (= :install reason) (not (contains? names n)))\n  1876\t            (outcome! :yin.k/undecodable :incomplete-install {:yin.k/name n})))))\n  1877\t    (case kind\n  1878\t      :halted (when (seq waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n  1879\t      :blocked (when (empty? waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n  1880\t      :parked (when-not (some #(= parked-id %) (take-nth 2 (:slots parked)))\n  1881\t                (outcome! :yin.k/undecodable :parked-id {}))\n  1882\t      (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n  1883\t    (run! #(check-install! recv %) installs)))\n  1884\t\n  1885\t\n  1886\t(defn- check-install-admission!\n  1887\t  \"Carried children require the receiver composition's explicit name/address\n  1888\t   admission. Sender admission evidence never authorizes a receiver install.\"\n  1889\t  [task opts]\n  1890\t  (doseq [inst (nth (:slots task) 12)]\n  1891\t    (let [[mn _ _ response] (:slots inst)\n  1892\t          address (jing/segment-key (:manifest response))]\n  1893\t      (when-not (= address (get (:yin.k/admitted-modules opts) mn))\n  1894\t        (outcome! :yin.k/unsatisfied nil\n  1895\t                  {:yin.k/missing {:yin.k/modules {mn address}}})))))\n  1896\t\n  1897\t\n  1898\t(defn- check-closure!\n  2020\t         :tenure {:bound (:bound tenure)}}))))\n  2021\t\n  2022\t\n  2023\t(defn- check-custody!\n  2024\t  \"Step 10, once for the tree after the three staged checks: the custody\n  2025\t   grammar (custody-baseline), then by the root's slot: a fork (nil) is\n  2026\t   refused under :exclusive as :yin.k/profile-mismatch; an exclusive\n  2027\t   blocked or parked root runs the grant checks unless :fenced (an\n  2028\t   administrative rehydration: no grant, gate :exporting); a halted\n  2029\t   exclusive root needs no grant and is gated :ended. Answers\n  2030\t   {:exclusive? :fenced? :state}, which restore applies to every task.\"\n  2031\t  [task wire opts]\n  2032\t  (custody-baseline task)\n  2033\t  (let [[_ _ kind] (:slots task) c (nth (:slots task) 16) fenced? (boolean (:fenced opts))]\n  2034\t    (if (nil? c)\n  2035\t      (do (when (:exclusive opts)\n  2036\t            (outcome! :yin.k/profile-mismatch nil {:yin.k/policy :yin.k/exclusive}))\n  2037\t          {:exclusive? false :fenced? fenced?})\n  2038\t      {:exclusive? true :fenced? fenced?\n  2039\t       :state (when-not (or fenced? (= :halted kind)) (accept-grant! task c (pack-address wire) opts))})))\n  2040\t\n  2041\t\n  2042\t(defn- with-custody\n  2043\t  \"Restore's custody for one task of the tree: an exclusive tree numbers\n  2044\t   its retained :put waits (:yin.k/issue, :yin.k/issued, in carried\n  2045\t   order) and gates :running, a halted exclusive root :ended, the root\n  2046\t   holding the grant's custody state; a fenced tree gates :exporting with\n  2047\t   its waits and every parked record outside the scheduler\n  2048\t   (:yin.k/recovery-waits, :yin.k/recovery-parked), the shape\n  2049\t   holder.export's exporting machine has.\"\n  2050\t  [m {:keys [exclusive? fenced? state]} kind root?]\n  2051\t  (let [m (if exclusive?\n  2052\t            (let [[entries issued] (reduce (fn [[acc i] e]\n  2053\t                                             (if (= :put (:reason e))\n  2054\t                                               [(conj acc (assoc e :yin.k/issue i)) (inc i)]\n  2055\t                                               [(conj acc e) i]))\n  2056\t                                           [[] 0] (:wait-set m))]\n  2057\t              (cond-> (assoc m :wait-set entries :yin.k/issued issued\n  2058\t                             :yin.k/gate (if (and root? (= :halted kind)) :ended :running))\n  2059\t                (and root? (some? state)) (assoc :yin.k/custody state)))\n  2060\t            m)]\n  2061\t    (if fenced?\n  2062\t      (assoc m :yin.k/gate :exporting :yin.k/recovery-waits (:wait-set m) :wait-set []\n  2063\t             :yin.k/recovery-parked (:parked m) :parked {})\n  2064\t      m)))\n  2065\t\n  2066\t\n  2067\t(defn- attach-streams!\n  2068\t  \"Step 11: one attach per distinct stream identity of the whole tree.\"\n  2069\t  [attach! task]\n  2070\t  (reduce (fn [acc s]\n  2230\t            entries (mapv entry waits)\n  2231\t            link (some #(let [[reason _ _ req resp] (:slots (second (:slots %)))]\n  2232\t                          (when (contains? #{:link-request :link-response} reason) [req resp]))\n  2233\t                       waits)\n  2234\t            [base installs'] (reduce (fn [[r acc] inst]\n  2235\t                                       (let [[mn phase parent response child] (:slots inst)\n  2236\t                                             [spawned r'] (spawn-child r response mn (:fenced? custody))]\n  2237\t                                         [r' (assoc acc mn {:phase phase :parent parent :response response\n  2238\t                                                            :vm (restore-task spawned child handles custody false)})]))\n  2239\t                                     [base {}] installs)\n  2240\t            fe (keyed free-env)\n  2241\t            resources (merge (:resources base)\n  2242\t                             (into {} (map