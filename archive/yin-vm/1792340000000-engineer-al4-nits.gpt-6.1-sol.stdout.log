(defn- configure-admission
  "Apply session configuration to the linker, retaining its live state."
  [state admission]
  (let [linker (link/reconfigure (:linker state) admission)]
    (assoc state :admission admission :linker linker
           :link-source (:source linker))))


(defn- trust-command
  [state command args]
  (try
    (let [p (first args)]
      (when-not (and (= 1 (count args)) (string? p)
                     (str/starts-with? p "ed25519:"))
        (throw (ex-info "Expected one ed25519:<64 hex> principal id" {})))
      (let [p (config/parse-trust p)
            admission (if (= :external (:admission state))
                        {} (:admission state))]
        [(configure-admission
           state (update admission :trusted
                         (fn [trusted]
                           ((if (= command 'trust) conj disj)
                            (set trusted) p))))
         (str (if (= command 'trust) "Trusted " "Untrusted ") p)]))
    (catch #?(:cljd Object :clj Exception :cljs :default) e
      [state (str "Error: " (ex-message e))])))


(declare repl-state)


(ns yin.repl.state
  "The node's saved configuration: the command line a node was last started
   with, kept as EDN in `<node dir>/state.edn` so a bare `yin-repl` starts
   the same node again.

   The file holds flags, not evaluation state: the index store's durable
   directory already recovers what was evaluated.  A run resolves
   `saved flags < command-line flags` (a repeated flag's values replace the
   saved ones whole), starts from the result, and saves it.  One-shot flags
   (`--dht-manifest`, `--dht-keygen`) are never saved.  `--dht-follow` is
   saved; the head it installed never is: that is `heads.edn`'s, in the
   store directory (yin.vm.linker.dht.head.md 5.8)."
  (:require #?(:cljd [clojure.edn :as edn]
               :clj [clojure.edn :as edn]
               :cljs [cljs.reader :as reader])
            #?@(:cljd [["dart:io" :as dart-io]])
            [clojure.string :as str]
            [dao.space.store.fs :as fs]
            [yin.vm.linker.sign :as sign]))


(defn parse-trust
  "A `--dht-trust` value: a principal whose modules this node admits,
   `ed25519:<64 lowercase hex>` (the tag optional), as the principal id
   (yin.vm.linker.dht.md 7.5).  Trust is apart from `--dht-principal`:
   declaring a publisher honors its signed names, it does not admit its
   modules."
  [text]
  (if-some [[_ hex] (and (string? text)
                         (re-matches #"^(?:ed25519:)?([0-9a-f]{64})$" text))]
    (sign/principal hex)
    (throw (ex-info (str "--dht-trust takes ed25519:<64 lowercase "
                         "hexadecimal characters>, not " (pr-str text))
                    {:value text}))))


(def file-name "state.edn")


(def version 1)


(def ^:private saved-flags
  "The flags a state file keeps, in the order they are re-emitted, and how
   each takes its value: one value, a repeated value, or a bare switch."
  [["--index-store" :value]
   ["--vm" :value]
   ["--port" :value]
   ["--headless" :switch]
   ["--dht-peer" :many]
   ["--dht-publish" :switch]
   ["--dht-bind" :value]
   ["--dht-port" :value]
   ["--dht-max-inbound-bytes" :value]
   ["--dht-key" :value]
   ["--dht-principal" :many]
   ["--dht-trust" :many]
   ["--dht-follow" :many]])


(def ^:private kinds (into {} saved-flags))


(def ^:private one-shot-flags
  "Flags that take a value but are never saved."
  #{"--dht-manifest" "--dht-keygen"})


(defn- value-of
  "The value after `flag`, or a refusal: a missing value (or another flag
   in its place) must never fall back to the saved one."
  [flag more]
  (let [value (first more)]
    (if (and (some? value) (not (str/starts-with? value "--")))
      value
      (throw (ex-info (str flag " needs a value") {:flag flag})))))


(defn split-args
  "Split `args` into `{:flags {flag value} :rest [arg ...]}`: the flags a
   state file keeps (a switch is `true`, a repeated flag a vector) and
   everything else, in order, for the arguments parser.  A saved flag or a
   one-shot flag with no value is refused here, before it can be resolved
   against the saved value."
  [args]
  (loop [args (seq args) flags {} rest []]
    (if-let [arg (first args)]
      (let [kind (kinds arg)
            more (next args)]
        (cond
          (= :switch kind) (recur more (assoc flags arg true) rest)

          (#{:value :many} kind)
          (let [value (value-of arg more)]
            (recur (next more)
                   (if (= :many kind)
                     (update flags arg (fnil conj []) value)
                     (assoc flags arg value))
                   rest))

          (one-shot-flags arg)
          (recur (next more) flags (conj rest arg (value-of arg more)))

          :else (recur more flags (conj rest arg))))
      {:flags flags :rest rest})))


(defn flags->args
  "The argument vector that says `flags`, in a fixed order."
  [flags]
  (into []
        (mapcat (fn [[flag kind]]
                  (when-some [v (get flags flag)]
                    (case kind
                      :switch (when (true? v) [flag])
                      :value [flag v]
                      :many (mapcat (fn [x] [flag x]) v)))))
        saved-flags))


(defn resolve-flags
  "The flags this run starts with: `saved` overridden by `explicit`.  The
   `unset` flags a subcommand clears (by default `dht serve` clears saved
   publishing and key state) are dropped from `saved` only, so a flag the
   command line names explicitly always stands."
  [saved explicit unset]
  (merge (apply dissoc saved unset) explicit))


(defn changed
  "The flags, sorted, whose value in `resolved` differs from `saved`."
  [saved resolved]
  (->> (concat (keys saved) (keys resolved))
       distinct
       (remove #(= (get saved %) (get resolved %)))
       sort
       vec))


(defn describe
  "`flags` as one line of `--flag value` text."
  [flags]
  (str/join ", "
            (for [[flag _] saved-flags
                  :let [v (get flags flag)]
                  :when (some? v)]
              (cond
                (true? v) flag
                (vector? v) (str/join ", " (map #(str flag " " %) v))
                :else (str flag " " v)))))


(defn- config-key
  [flag]
  (keyword (subs flag 2)))


(defn- refuse
  [path why]
  (ex-info (str "state file " path ": " why "; --reset replaces it")
           {:path path}))


(defn- text->config
  "The flags a state file's text holds, or a refusal naming `path`."
  [path text]
  (let [data (try #?(:cljd (edn/read-string text)
                     :clj (edn/read-string text)
                     :cljs (reader/read-string text))
                  (catch #?(:cljd Object
                            :clj Throwable
                            :cljs :default)
                         _
                    (throw (refuse path "it is not readable EDN"))))
        config (when (map? data) (:config data))]
    (cond
      (not (and (map? data) (= version (:version data))))
      (throw (refuse path (str "it is not a version-" version " state file")))

      (not (map? config))
      (throw (refuse path "it has no :config map"))

      :else
      (reduce (fn [flags [k v]]
                (let [kind (when (keyword? k) (kinds (str "--" (name k))))
                      flag (when kind (str "--" (name k)))]
                  (cond
                    (nil? kind)
                    (throw (refuse path (str "unknown setting " (pr-str k))))

                    (and (= :switch kind) (not (true? v)))
                    (throw (refuse path (str (pr-str k) " must be true")))

                    (and (= :value kind) (not (string? v)))
                    (throw (refuse path (str (pr-str k) " must be a string")))

                    (and (= :many kind)
                         (not (and (vector? v) (every? string? v))))
                    (throw (refuse path (str (pr-str k) " must be a vector of"
                                             " strings")))

                    :else (assoc flags flag v))))
              {}
              config))))


(defn path
  "The state file's path in the node directory `dir`."
  [dir]
  (str dir "/" file-name))


(defn- read-text
  "The file at `path` as text, or nil only when no directory entry exists
   there.  Unlike `fs/read-file-text`, which answers nil for anything it
   cannot stat, a directory, an unreadable file and a dangling symlink all
   throw here, so a state file is never skipped for being unreadable.  Each
   host tells absence from an access failure by the error it gets on a
   direct read, not by an existence test."
  [path]
  #?(:cljd (try (.readAsStringSync (dart-io/File. path))
                (catch dart-io/PathNotFoundException e
                  ;; Dart also raises this class for Windows errors that are
                  ;; not absence (bad drive, bad name, name too long): only
                  ;; OS error 2 (ENOENT, file not found) and 3 (path not
                  ;; found) are.  A link whose target is missing is an entry,
                  ;; not absence.
                  (let [code (some-> (.-osError e) .-errorCode)]
                    (when (or (not (contains? #{2 3} code))
                              (.existsSync (dart-io/Link. path)))
                      (throw e)))))
     :clj (when-not (java.nio.file.Files/notExists
                      (java.nio.file.Paths/get path (make-array String 0))
                      (into-array java.nio.file.LinkOption
                                  [java.nio.file.LinkOption/NOFOLLOW_LINKS]))
            (slurp path))
     :cljs (let [fs (js/require "fs")
                 entry? (fn []
                          (try (.lstatSync ^js fs path) true
                               (catch :default e
                                 ;; only "no such entry" means no entry; an
                                 ;; access or I/O failure must not read as one
                                 (if (= "ENOENT" (.-code e)) false (throw e)))))]
             (try (.readFileSync ^js fs path "utf8")
                  (catch :default e
                    (when-not (and (= "ENOENT" (.-code e)) (not (entry?)))
                      (throw e)))))))


(defn load-flags
  "The saved flags in the node directory `dir`, or nil when there is no
   state file.  A file that cannot be understood or read is refused, never
   skipped."
  [dir]
  (when-some [text (try (read-text (path dir))
                        (catch #?(:cljd Object
                                  :clj Throwable
                                  :cljs :default)
                               e
                          (throw (refuse (path dir)
                                         (str "it cannot be read ("
                                              (or (ex-message e) (str e))
                                              ")")))))]
    (text->config (path dir) text)))


(defn- mkdirs!
  [dir]
  #?(:cljd (.createSync (dart-io/Directory. dir) .recursive true)
     :clj (.mkdirs (java.io.File. ^String dir))
     :cljs (.mkdirSync (js/require "fs") dir #js {:recursive true})))


(defn- render
  "The state file's text, one setting to a line, with no space before a
   closing bracket (ClojureDart's EDN reader refuses one)."
  [flags]
  (let [entries (for [[flag _] saved-flags
                      :let [v (get flags flag)]
                      :when (some? v)]
                  (str (config-key flag) " " (pr-str v)))]
    (str "{:version " version "\n :config {"
         (str/join "\n          " entries)
         "}}\n")))


(defn save!
  "Write `flags` as the state file of the node directory `dir`, creating the
   directory and replacing any earlier file atomically."
  [dir flags]
  (mkdirs! dir)
  (fs/atomic-replace! dir file-name (render flags)))
#### 7.5.8 Attachment and the interpreter contract

The admission interpreter answers each question with
`(verify decision context question)`: nil allows, a reason map refuses.
It is composed from `{:trusted #{...} :verify f :decision d
:decision-medium m}`. It attaches in one of three ways, none of which
edits the linker:

- **In process, the default.** The `:admission` configuration builds the
  policy: `trusted-asserter` over the own principal plus `:trusted`, or a
  composed `:verify` over a static `:decision` or a capacity-1
  `:decision-medium`. `round` serves it (7.5.6, step 3).
- **External.** `:admission :external` mints the admission pair and runs
  no interpreter in process. Another process reads the questions and
  appends the answers over any `dao.stream` exposure of the pair. There
  is no privileged node: the external interpreter is a peer of the
  medium like any other.
- **ShiBi.** A ShiBi interpreter attaches as either: a verify function
  over its own published snapshot, in process, or an external reader of
  the questions.

**The context is the holder.** "Who is asking" is a composition-owned
holder context the interpreter receives as the `context` argument of
`verify`; it never travels in a datum. Today `admission/context` builds
it from the session: `{:yin.admit/subject "ed25519:<hex>" | nil,
:yin.admit/session <token>}`, the subject being the own key's principal.
`:yin.admit/session` stays through AL-1 and AL-2. AL-3 replaces it: the
composition gains an optional `:holder` (a principal id, or a token the
verify understands), `context` answers the subject from it, defaulting to
the own key's principal, and `:yin.admit/session` is deleted.
Authorization vocabulary stays in the context and the policy; the
question and the linker carry none.

- **Composition-bounded synchronous verification.** `verify` runs
  synchronously inside one round on one snapshot. Its cost per question
  is bounded by the composition, and the interpreter answers at most
  `serve-budget` questions per round. `verify` opens, fetches and waits
  for nothing; a rule that would need a remote read is a rule the
  decision snapshot must already hold (`dao.shibi.md`, limits of the
  adapter contract).
- **The snapshot.** The decision snapshot is the static `:decision`
  value, or the newest value on a capacity-1 `:decision-medium`, read once
  per round. An **absent** snapshot gives no answer: the question stays
  pending and the round reports no progress. An **ended** snapshot
  refuses `:yin.admit/decision-ended`, with no load started.
- **The default interpreter.** The decision is the holder's own
  principal together with the `:trusted` set. It allows when some
  asserter of the question is in that set, and otherwise refuses
  `:yin.admit/untrusted-principal` naming the asserters.
- **Composition.** Policies compose as verify functions; the first reason
  wins. One interpreter writes the response medium.
- **Reconfiguration** (AL-3). `(interpreter/reconfigure linker config)`
  replaces the policy of a `:linker` value and preserves the
  interpreter's cursors, retained questions, serials and external mode.
- **At the REPL, configuration only.** `create-state` takes `:admission`
  beside `:link-policy`, defaulting to the own key from `:dht-key`;
  `--dht-trust` sets its `:trusted`; `:external` selects the external
  attachment. AL-4 adds `(trust p)`, `(untrust p)` and `(trusted)`: they
  edit the `:trusted` configuration and call `reconfigure`, and
  `(trusted)` prints the own principal and the trusted set. `(reset)`
  drops the trusted set unless it was given in `create-state`.

This is not the gate seam of `dao.shibi.md`. It reuses the `verify`
signature and the snapshot, but a request read off a stream and answered
with one decision per request is the path `dao.shibi.md` names as a
non-goal for the gate, to be added beside `verify`. This section is that
- **AL-2, the REPL reduction and the handoff** (REPL seat, with the
  linker-side `make` and `round` in the same slice). The session holds
  one `:linker` value; `serve-admission`, `admission-context`,
  `:admitter` and `recheck-on-answers` are deleted; `link-raise` and
  `carry-served` carry one `::linker` key; `abandon-pending` makes one
  `retire` call. The hook migration is explicit: `yin.repl.main/step-all`
  replaces its two hook calls with one `recheck-on-tick` call and one
  returned-text collection, and the direct callers in
  `test/yin/vm/linker/dht_end_to_end_test.cljc`,
  `test/yin/repl/dht_test.cljc` and `admission_test.cljc` move to the
  one hook. Acceptance:
  - (a) A require parks on an external question and the initial drive
    stops; an allow is appended; one tick's round delivers the response
    and the run completes with no further question, input line, load
    event or answer. The tick runs the VM exactly once before another
    round, and each round drains exactly once.
  - (b) The same with an empty decision medium at park time and a
    snapshot appended after parking: the in-process interpreter answers
    in one tick's round, the drain matches and the response lands inside
    the driver's loop, and the run completes, again with exactly one
    initial VM run before another round and one drain per round.
  - (c) A refusal arriving the same way raises as the VM's own, with the
    successor `:linker` carried into the rolled-back state; and an
    allowed response whose installation then raises does the same. In
    both, after rollback, the request, answer and question cursors, the
    serial and the settled admission state equal the round's successor.
  - (d) A tick with no progress and no relevant event re-checks nothing
    and leaves `:checks` unchanged.
  - Under continuing progress the driver stops at `link-round-budget`
    rounds.
  - F3, the late answer: a session composed with an external admission
    interpreter (none in process); require `pym.m`; the initial drive
    ends pending with `:admission` on the pending entry; a
    `recheck-on-tick` with unrelated events and no answer answers
    `[state nil]`; append an allow; the next `recheck-on-tick` returns
    text and the run loads and links, with no input line and no load
    event.
  - P1-2 (i) and (iii) through `recheck-on-tick`, below.
  - P2-3, the rollback: allow, then an install that raises, then a
    require of another module: the new question's serial is greater than
    the failed one's, `:asked` holds no entry for the failed link id, the
    answer map holds nothing under the failed admission id, and the next
    round reports progress only for the new question.
  - Lexical: `repl.cljc` requires `yin.vm.linker.interpreter` and not
    `yin.vm.linker.admission`; no session key `:admission` or
    `:admitter`; no call to `drain`, `judge`, `ask`, `settle` or the
    admission `serve`; exactly one tick hook. Configuration plumbing and
    display text are allowed.
- **AL-3, the holder context** (linker seat). `composition` gains the
  optional `:holder`; `context` answers the subject from it, defaulting
  to the own key's principal; `:yin.admit/session` is deleted;
