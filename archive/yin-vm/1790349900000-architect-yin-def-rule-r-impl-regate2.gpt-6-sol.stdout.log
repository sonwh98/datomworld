 ctx)\n  1208\t        source-batch (:t ctx)\n  1209\t        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\n  1210\t        finish (fn [st]\n  1211\t                 (let [ctx' (update (:ctx st) :t inc)]\n  1212\t                   (if-let [e (:error st)]\n  1213\t                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\n  1214\t                     {:status :ok, :tree (:tree st), :log (log-packet st),\n  1215\t                      :ctx (assoc ctx' :store (:next-store st))})))\n  1216\t        {:keys [admitted error]} (admit batch)]\n  1217\t    (if error\n  1218\t      (let [[st counter] (allocate-attempt base)]\n  1219\t        (finish (-> st\n  1220\t                    (record-event (event-row (attempt-id ctx counter) source-batch\n  1221\t                                             (source-origin ctx source-batch nil)\n  1222\t                                             nil nil nil nil nil error))\n  1223\t                    (fail error))))\n  1224\t      (let [{:keys [trees indexes index run-index definitions]} admitted\n  1225\t            store0 (or (:store ctx) {})\n  1226\t            store (harvest store0 #(nth indexes %) definitions)\n  1227\t            catalogue (into []\n  1228\t                            (comp (filter :declared?)\n  1229\t                                  (map (fn [{:keys [name tree path value]}]\n  1230\t                                         {:name name,\n  1231\t                                          :macro-tree (packet-of (nth indexes tree) value),\n  1232\t                                          :source [tree path]})))\n  1233\t                            definitions)\n  1234\t            ;; only the run tree is expanded, so only its declarations are\n  1235\t            ;; replaced; every catalogue entry still resolves by index\n  1236\t            [index standins]\n  1237\t            (reduce (fn [[index acc] [k {:keys [name source]}]]\n  1238\t                      (if (= run-index (first source))\n  1239\t                        (let [[index s] (intern-body index [standin-tag name k])]\n  1240\t                          [index (assoc acc (second source) s)])\n  1241\t                        [index acc]))\n  1242\t                    [index {}]\n  1243\t                    (map-indexed vector catalogue))\n  1244\t            [index root] (rebuild-paths index (first (nth trees run-index)) standins)\n  1245\t            st (assoc base :index index :store store)]\n  1246\t        (if-let [e (guard-batch-rows st)]\n  1247\t          (finish (fail st e))\n  1248\t          (let [[st root'] (expand-node st root\n  1249\t                                        {:path [], :rel [],\n  1250\t                                         :frame {:parent nil, :root root,\n  1251\t                                                 :tree-index run-index},\n  1252\t                                         :shadow #{}, :depth 0})]\n  1253\t            (if (:error st)\n  1254\t              (finish st)\n  1255\t              (let [next-store (post-harvest store0 (:index st) root' catalogue)\n  1256\t                    [index root'] (retail (:index st) root')\n  1257\t                    [index root'] (lower-standins index root')\n  1258\t                    tree (packet-of index root')]\n  1259\t                (if-let [e (valid-tree? tree)]\n  1260\t                  (throw (ex-info \"Expander produced a non-canonical tree\" e))\n  1261\t                  (finish (assoc st :tree tree :next-store next-store)))))))))))\n  1262\t\n  1263\t\n  1264\t(defn expand\n  1265\t  \"`expand-batch` returning the tree packet, or throwing `ex-info` carrying\n  1266\t   the error data.\"\n  1267\t  [batch ctx]\n  1268\t  (let [{:keys [status tree error]} (expand-batch batch ctx)]\n  1269\t    (if (= :ok status)\n  1270\t      tree\n  1271\t      (throw (ex-info \"Macro expansion failed\" error)))))\n  1272\t\n  1273\t\n  1274\t(defn make-ctx\n  1275\t  \"An expander context. The composition supplies the incarnation `token`\n  1276\t   and the opaque `source-medium` identity (S3.1); the store may be\n  1277\t   seeded with `macro-entry` values. A seeded store binding a reserved\n  1278\t   name, a macro named `yin/def`, is refused (Rule R), and so is any entry\n  1279\t   whose AST contract is absent (`:contract-missing`) or old\n  1280\t   (`:contract-mismatch`).\"\n  1281\t  [{:keys [token source-medium store guards], eval-fn :eval}]\n  1282\t  (cond-> {:store (check-store! (or store {})),\n  1283\t           :incarnation {:yin.expander/token token},\n  1284\t           :attempt 0,\n  1285\t           :source-medium source-medium,\n  1286\t           :t 0,\n  1287\t           :guards (merge default-guards guards)}\n  1288\t    eval-fn (assoc :eval eval-fn)))\n  1289\t\n  1290\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/vm/store_write_audit_test.clj | sed -n '1,45p;62,160p;178,218p;294,355p'; nl -ba docs/design/yin.vm.engine.md | sed -n '65,112p'; nl -ba docs/design/yin.vm.macro.md | sed -n '440,470p;770,810p'; nl -ba test/yin/vm/rule_r_test.cljc | sed -n '450,505p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/vm/store_write_audit_test.clj | sed -n '1,45p;62,160p;178,218p;294,355p'; nl -ba docs/design/yin.vm.engine.md | sed -n '65,112p'; nl -ba docs/design/yin.vm.macro.md | sed -n '440,470p;770,810p'; nl -ba test/yin/vm/rule_r_test.cljc | sed -n '450,505p'\"","aggregated_output":"     1\t(ns yin.vm.store-write-audit-test\n     2\t  \"The store-write audit (Rule R, the store-key invariant): every program\n     3\t   store write goes through `yin.vm.engine/store-put`, which refuses a\n     4\t   reserved key; every other store mutation it detects is state\n     5\t   construction on an allowlist. This gate reads every source file under\n     6\t   `src` as forms (tools.reader, reader conditionals preserved, so every\n     7\t   host's branch is read) and fails on any detected site outside the\n     8\t   allowlist, on any allowlisted site that no longer exists, and on any\n     9\t   source file it cannot read. The allowlist is exact for what the\n    10\t   detector sees; what it sees is exactly this:\n    11\t\n    12\t   - A call whose head is one of `mutation-heads` and that touches a store:\n    13\t     a `:store` argument (`(assoc vm :store x)`, `(update vm :store ...)`),\n    14\t     a key path whose first key is `:store` or that contains it\n    15\t     (`(assoc-in vm [:store k] v)`), or a store as its target. A store is a\n    16\t     symbol named `store`, `new-store`, `store0`, ...; `(:store x)`,\n    17\t     `(get x :store)`, or `(get-in x [:store ...])`; or a local alias of\n    18\t     one of these.\n    19\t   - A local alias: a symbol bound to a store by `let`, `let*`, `loop`,\n    20\t     `loop*`, `when-let`, `if-let`, `when-some`, `if-some`, `when-first`,\n    21\t     or `binding`, directly or through an earlier alias in the same or an\n    22\t     enclosing binding form, and a map destructuring key bound to `:store`\n    23\t     (`{heap :store}`). The alias is scoped to the binding form's body.\n    24\t   - A `->` or `some->` pipeline that threads through `:store`,\n    25\t     `(:store)`, or `(get :store)`: every mutation-head step after it.\n    26\t   - Every `store-put` call, and every map literal with a `:store` key (a\n    27\t     map rebuilt around the store).\n    28\t\n    29\t   A site is identified by its file, the name of its top-level form, and\n    30\t   its head, with a count, so the allowlist does not move with line\n    31\t   numbers. `negative-fixtures` pins every covered form, aliases included.\n    32\t\n    33\t   Residual, NOT detected: a store passed across a function boundary and\n    34\t   written under the parameter's own name (`(defn f [heap] (assoc heap k\n    35\t   v))` called as `(f (:store vm))`), a store carried inside another data\n    36\t   structure and taken out under another key, a mutation built\n    37\t   dynamically (`apply`, `partial`, `comp`, a head passed as a value),\n    38\t   `as->` and `cond->` pipelines, transients and host interop, and macros\n    39\t   that expand to a write. Those need review; this gate does not prove\n    40\t   them absent. JVM only: it reads source files.\"\n    41\t  (:require [clojure.java.io :as io]\n    42\t            [clojure.test :refer [deftest is testing]]\n    43\t            [clojure.tools.reader :as reader]\n    44\t            [clojure.tools.reader.reader-types :as rt]))\n    45\t\n    62\t(defn- store-symbol?\n    63\t  [x]\n    64\t  (and (symbol? x)\n    65\t       (boolean (re-find #\"(^|-)store\\d*'?$\" (name x)))))\n    66\t\n    67\t\n    68\t(defn- store-read?\n    69\t  \"`(:store x)`, `(get x :store)`, or `(get-in x [:store ...])`.\"\n    70\t  [x]\n    71\t  (and (seq? x)\n    72\t       (or (= :store (first x))\n    73\t           (and (= 'get (first x)) (= :store (nth x 2 nil)))\n    74\t           (and (= 'get-in (first x))\n    75\t                (vector? (nth x 2 nil))\n    76\t                (= :store (first (nth x 2)))))))\n    77\t\n    78\t\n    79\t(defn- store-expr?\n    80\t  [x aliases]\n    81\t  (or (store-symbol? x) (contains? aliases x) (store-read? x)))\n    82\t\n    83\t\n    84\t(defn- head-name\n    85\t  [form]\n    86\t  (when (and (seq? form) (symbol? (first form)))\n    87\t    (name (first form))))\n    88\t\n    89\t\n    90\t(defn- mutation?\n    91\t  [form aliases]\n    92\t  (let [[head & args] form]\n    93\t    (and (contains? mutation-heads (head-name form))\n    94\t         (or (= \"store-put\" (name head))\n    95\t             (some #(= :store %) args)\n    96\t             (some #(and (vector? %) (some #{:store} %)) args)\n    97\t             (store-expr? (first args) aliases)))))\n    98\t\n    99\t\n   100\t(defn- bound-aliases\n   101\t  \"The symbols `lhs` binds to a store, given its `init`.\"\n   102\t  [lhs init aliases]\n   103\t  (cond (symbol? lhs) (if (store-expr? init aliases) #{lhs} #{})\n   104\t        (map? lhs) (into #{}\n   105\t                         (keep (fn [[k v]]\n   106\t                                 (when (and (symbol? k) (= :store v)) k)))\n   107\t                         lhs)\n   108\t        :else #{}))\n   109\t\n   110\t\n   111\t(defn- threaded-sites\n   112\t  \"Mutation heads applied after a `->`/`some->` pipeline passes `:store`.\"\n   113\t  [form]\n   114\t  (when (contains? threading-heads (head-name form))\n   115\t    (let [steps (drop 2 form)\n   116\t          through? #(or (= :store %)\n   117\t                        (and (seq? %) (= :store (first %)))\n   118\t                        (and (seq? %) (= 'get (first %))\n   119\t                             (= :store (second %))))]\n   120\t      (->> (drop-while (complement through?) steps)\n   121\t           rest\n   122\t           (keep (fn [step]\n   123\t                   (cond (and (seq? step)\n   124\t                              (contains? mutation-heads (head-name step)))\n   125\t                         (str (first step))\n   126\t                         (and (symbol? step)\n   127\t                              (contains? mutation-heads (name step)))\n   128\t                         (str step))))))))\n   129\t\n   130\t\n   131\t(defn- walk-sites\n   132\t  \"Every site inside `form` under the store `aliases` in scope: a head\n   133\t   string for a mutation, `:map` for a map literal with a `:store` key.\"\n   134\t  [form aliases]\n   135\t  (cond\n   136\t    (reader-conditional? form) (walk-sites (:form form) aliases)\n   137\t    (and (contains? binding-heads (head-name form))\n   138\t         (vector? (second form)))\n   139\t    (let [[_ bindings & body] form\n   140\t          [sites inner] (reduce (fn [[sites al] [lhs init]]\n   141\t                                  [(into sites (walk-sites init al))\n   142\t                                   (into al (bound-aliases lhs init al))])\n   143\t                                [[] aliases]\n   144\t                                (partition 2 bindings))]\n   145\t      (into sites (mapcat #(walk-sites % inner)) body))\n   146\t    (seq? form)\n   147\t    (concat (when (mutation? form aliases) [(str (first form))])\n   148\t            (threaded-sites form)\n   149\t            (mapcat #(walk-sites % aliases) form))\n   150\t    (map? form)\n   151\t    (concat (when (contains? form :store) [:map])\n   152\t            (mapcat #(walk-sites % aliases) (concat (keys form) (vals form))))\n   153\t    (coll? form) (mapcat #(walk-sites % aliases) form)\n   154\t    :else nil))\n   155\t\n   156\t\n   157\t(defn- form-sites\n   158\t  [form]\n   159\t  (walk-sites form #{}))\n   160\t\n   178\t(defn sites-in-source\n   179\t  \"`{[top-level-name head] count}` of the store mutations in `text`, or\n   180\t   `{[:unreadable] 1}` when the text cannot be read as forms.\"\n   181\t  [text]\n   182\t  (try\n   183\t    (binding [reader/*alias-map* (alias-map text)\n   184\t              reader/*default-data-reader-fn* (fn [_ v] v)\n   185\t              *ns* (create-ns 'yin.vm.store-write-audit-reader)]\n   186\t      (let [rdr (rt/indexing-push-back-reader text)\n   187\t            opts {:read-cond :preserve, :eof ::eof}]\n   188\t        (loop [acc {}]\n   189\t          (let [form (reader/read opts rdr)]\n   190\t            (if (= ::eof form)\n   191\t              acc\n   192\t              (recur (reduce (fn [acc head]\n   193\t                               (update acc [(top-level-name form) head]\n   194\t                                       (fnil inc 0)))\n   195\t                             acc\n   196\t                             (form-sites form))))))))\n   197\t    (catch Exception e\n   198\t      {[:unreadable (ex-message e)] 1})))\n   199\t\n   200\t\n   201\t(defn- source-files\n   202\t  []\n   203\t  (->> (file-seq (io/file \"src\"))\n   204\t       (filter #(.isFile ^java.io.File %))\n   205\t       (map #(.getPath ^java.io.File %))\n   206\t       (filter #(re-find #\"\\.clj[csd]?$\" %))\n   207\t       sort))\n   208\t\n   209\t\n   210\t(defn source-sites\n   211\t  \"file -> `{[top-level-name head] count}` for every file with a site.\"\n   212\t  []\n   213\t  (into {}\n   214\t        (keep (fn [f]\n   215\t                (let [sites (sites-in-source (slurp f))]\n   216\t                  (when (seq sites) [f sites]))))\n   217\t        (source-files)))\n   218\t\n   294\t    [\"expand-batch\" \"assoc\"] 2}})\n   295\t\n   296\t\n   297\t(deftest every-store-mutation-is-on-the-allowlist\n   298\t  (is (= allowlist (source-sites))\n   299\t      \"a new store mutation must go through engine/store-put or join the\n   300\t       allowlist with its reason; an unreadable file fails too\"))\n   301\t\n   302\t\n   303\t(def negative-fixtures\n   304\t  \"Common store-mutation forms outside the allowlist; each must be caught.\"\n   305\t  [\"(defn f [state v] (assoc-in state [:store 'yin/def] v))\"\n   306\t   \"(defn f [vm v] (update vm :store assoc 'x v))\"\n   307\t   \"(defn f [vm v] (update-in vm [:store 'x] (constantly v)))\"\n   308\t   \"(defn f [vm v] (assoc vm :store (conj (:store vm) ['x v])))\"\n   309\t   \"(defn f [vm] (dissoc (:store vm) 'x))\"\n   310\t   \"(defn f [vm ks] (select-keys (get vm :store) ks))\"\n   311\t   \"(defn f [store v] (into store {'x v}))\"\n   312\t   \"(defn f [new-store v]\\n  (merge\\n    new-store\\n    {'x v}))\"\n   313\t   \"(defn f [a v] (swap! a assoc-in [:store 'x] v))\"\n   314\t   \"(defn f [a v] (reset! a {:store v}))\"\n   315\t   \"(defn f [vm m] (merge-with merge vm {:store m}))\"\n   316\t   \"(defn f [vm v] (engine/store-put (:store vm) 'x v))\"\n   317\t   \"(defn f [vm v] #?(:clj (assoc-in vm [:store 'x] v) :cljs vm))\"\n   318\t   ;; local aliases of a store value\n   319\t   \"(defn f [vm v] (let [heap (:store vm)] (assoc heap 'yin/def v)))\"\n   320\t   \"(defn f [vm v] (let [h (get vm :store) h2 h] (assoc h2 'x v)))\"\n   321\t   \"(defn f [vm v] (let [h (get-in vm [:store])] (merge h {'x v})))\"\n   322\t   \"(defn f [vm v] (when-let [h (:store vm)] (conj h ['x v])))\"\n   323\t   \"(defn f [vm v] (if-let [h (:store vm)] (dissoc h 'x) vm))\"\n   324\t   \"(defn f [vm] (loop [h (:store vm)] (recur (assoc h 'x 1))))\"\n   325\t   \"(defn f [vm v] (let [{heap :store} vm] (assoc heap 'x v)))\"\n   326\t   \"(defn f [vm v] (let [h (:store vm)] (let [g 1] (assoc h 'x g))))\"\n   327\t   ;; a pipeline threaded through the store\n   328\t   \"(defn f [vm v] (-> vm :store (assoc 'x v)))\"\n   329\t   \"(defn f [vm v] (some-> vm (get :store) (update 'x inc)))\"])\n   330\t\n   331\t\n   332\t(def residual-fixtures\n   333\t  \"Store writes this gate documents as NOT detected (the namespace\n   334\t   docstring's residual). Pinned so the documented guarantee matches the\n   335\t   code: if one of these starts being detected, move it to\n   336\t   `negative-fixtures` and narrow the docstring.\"\n   337\t  [\"(defn g [heap v] (assoc heap 'x v)) (defn f [vm v] (g (:store vm) v))\"\n   338\t   \"(defn f [vm v] (let [box {:s (:store vm)}] (assoc (:s box) 'x v)))\"\n   339\t   \"(defn f [vm v] (apply assoc (:store vm) ['x v]))\"\n   340\t   \"(defn f [vm v] (as-> vm m (:store m) (assoc m 'x v)))\"])\n   341\t\n   342\t\n   343\t(deftest residual-forms-are-not-claimed\n   344\t  (doseq [src residual-fixtures]\n   345\t    (testing src\n   346\t      (is (empty? (remove #(= [:map] (rest %))\n   347\t                          (keys (sites-in-source src))))\n   348\t          \"outside the detector: covered by review, not by this gate\"))))\n   349\t\n   350\t\n   351\t(deftest negative-fixtures-fail-the-audit\n   352\t  (doseq [src negative-fixtures]\n   353\t    (testing src\n   354\t      (let [sites (sites-in-source src)]\n   355\t        (is (seq sites) \"the mutation is detected\")\n    65\tEvery other store write the audit detects is state construction and\n    66\tsits on an allowlist, enforced by the store-write audit\n    67\t(`test/yin/vm/store_write_audit_test.clj`). The allowlist is exact for\n    68\twhat the detector sees, and no more. The audit reads every file under\n    69\t`src` as forms, every host's reader-conditional branch included, and\n    70\tdetects:\n    71\t\n    72\t- an `assoc`, `assoc-in`, `update`, `update-in`, `merge`, `merge-with`,\n    73\t  `into`, `dissoc`, `select-keys`, `conj`, `swap!`, `reset!`, `vswap!`,\n    74\t  or `vreset!` whose argument is `:store`, whose key path contains\n    75\t  `:store`, or whose target is a store: a symbol named `store`,\n    76\t  `new-store`, `store0`, ..., `(:store x)`, `(get x :store)`,\n    77\t  `(get-in x [:store ...])`, or a local alias of one;\n    78\t- a local alias bound by `let`, `let*`, `loop`, `loop*`, `when-let`,\n    79\t  `if-let`, `when-some`, `if-some`, `when-first`, or `binding`, directly\n    80\t  or through an earlier alias, or by a `{heap :store}` destructuring key,\n    81\t  scoped to the binding form's body;\n    82\t- the mutation-head steps of a `->` or `some->` pipeline after it passes\n    83\t  `:store`;\n    84\t- every `store-put` call and every map literal with a `:store` key.\n    85\t\n    86\tIt fails on any detected site, keyed by file, top-level form, and head,\n    87\toutside the list, on any listed site that is gone, and on an unreadable\n    88\tfile. Negative fixtures pin every detected form, the alias forms\n    89\tincluded.\n    90\t\n    91\tIt does NOT detect, and review must cover: a store passed across a\n    92\tfunction boundary and written under the parameter's own name, a store\n    93\tcarried inside another data structure and taken out under another key, a\n    94\tmutation built dynamically (`apply`, `partial`, `comp`, a head passed as\n    95\ta value), `as->` and `cond->` pipelines, transients and host interop,\n    96\tand macros that expand to a write. Residual fixtures pin a sample of\n    97\tthese as undetected, so the stated guarantee cannot silently drift from\n    98\tthe code.\n    99\t\n   100\tThe list: program writes through `engine/store-put`; engine-minted\n   101\tkeyword keys (stream ids, cursor ids, and cursor advance in\n   102\t`handle-next` and the wait-set resolver); the ready-queue merge\n   103\t(asserted keyword keys); VM construction (the FFI pair, and the two de\n   104\tBruijn constructor merges, checked); `dao.await` (checked keyword\n   105\tkeys); the REPL history keys `*1`, `*2`, `*3`; the continuation handoff\n   106\tdemo (checked); a JVM demo store transfer (`src/clj/yin/demo.clj`);\n   107\tdisplay projections in two browser demos; the waitset result and a\n   108\tdao.space index handle, which are not VM program writes; and the\n   109\texpander's macro store. A new store write must either route through\n   110\t`store-put` or join the allowlist in review.\n   111\t\n   112\t## 2. What a VM supplies\n   440\t  return rebuilt address, or address when unchanged\n   441\t```\n   442\t\n   443\tThe operator is expanded before operands. If it becomes a macro name, that\n   444\tmacro receives the original operands. This is required for binder macros: a\n   445\t`defn`-like transformer must establish parameters before its body is inspected\n   446\tfor same-name calls.\n   447\t\n   448\tRe-entry after invocation increments depth. Re-check after an operator rewrite\n   449\tdoes not, because recognition is not expansion. A generated chain therefore\n   450\tconsumes depth and cannot rewrite forever at a constant value.\n   451\t\n   452\t`invoke` runs the transformer on the bounded runner (S5.2), which is a\n   453\twalker: it inherits the walker's Rule R transition checks, so a\n   454\ttransformer body that reads, binds, or stores under `yin/def` is refused\n   455\twhen it runs. `invoke` verifies the entry's contract before anything\n   456\truns, direct calls included, and hands that verified stamp to the\n   457\trunner in its request (`:contract`); the runner checks it again and\n   458\tloads the body rows under it, never under a stamp of its own. The\n   459\texpander's input batches themselves carry no stamp: they are syntax\n   460\tadmitted by `valid-tree?`, and the packets harvested from them are this\n   461\texpander's fresh output.\n   462\t\n   463\t### 4.3 Properties\n   464\t\n   465\t- **Outermost first:** a transformer sees operands as written.\n   466\t- **Fixpoint:** each returned tree is reconsidered, including applications\n   467\t  whose operator becomes a macro name.\n   468\t- **Lexical shadowing:** lambda parameters shadow macro names only in their\n   469\t  body, never in sibling operands of the lambda's application occurrence.\n   470\t- **Occurrence correctness:** paths distinguish one shared row under different\n   770\t```\n   771\t\n   772\tEvery arrow carrying code carries canonical rows.\n   773\t\n   774\t---\n   775\t\n   776\t## 10. Compositions\n   777\t\n   778\t### 10.1 REPL\n   779\t\n   780\t`make-session` builds `program-in`, an expander seeded with standard forms,\n   781\t`program-out`, an optional log, and an evaluator observer. For each input:\n   782\t\n   783\t1. the frontend produces its internal Universal AST;\n   784\t2. the encoder projects it to canonical rows and supplies harvest and\n   785\t   declaration rows;\n   786\t3. the shell appends the batch tuple to `program-in`;\n   787\t4. it drives the expander and drains its summary;\n   788\t5. when `:forwarded` is positive, it drives the evaluator; and\n   789\t6. it prints drained expansion errors.\n   790\t\n   791\tThe stream boundary begins at canonical rows; no syntax object crosses\n   792\t`program-in`. `(compile expr)` may render frontend syntax, input row batch,\n   793\texpanded tree packet, and event rows. `(reset)` rebuilds expander and evaluator\n   794\tstate. `repl-state` lists macro names and lambda root addresses.\n   795\t\n   796\t### 10.2 Frontends and encoder\n   797\t\n   798\tFrontends identify macro-defining source forms. The encoder projects every\n   799\ttree to rows, emits one packet per root or disconnected definition tree, emits\n   800\tone harvest row per definition in source declaration order, and emits one\n   801\tdeclaration row per macro definition.\n   802\t\n   803\t`yang.clojure` lowers `defmacro` to ordinary `yin/def` syntax and supplies the\n   804\tdeclaration occurrence; it puts no macro metadata in the lambda row.\n   805\t`yang.python` and `yang.php` require no lookup: every call is an ordinary\n   806\tapplication row. A future macro-definition surface in either language need\n   807\tonly produce the same declaration and harvest rows.\n   808\t\n   809\t### 10.3 Builds and cross-platform behavior\n   810\t\n   450\t\n   451\t\n   452\t(deftest a-macro-packet-runs-only-under-its-verified-stamp\n   453\t  (let [packet (m/ast->packet (lam '[x] (v 'x)))\n   454\t        operand (m/ast->packet (lit 1))\n   455\t        call-batch [:yin.program/batch [(m/ast->packet (app (v 'm) (lit 1)))]\n   456\t                    0 [] []]\n   457\t        cases {\"unstamped\" [packet :contract-missing],\n   458\t               \"old-stamped\" [(m/macro-entry packet \"v2\") :contract-mismatch],\n   459\t               \"a stamp but no contract\" [(m/macro-entry packet nil)\n   460\t                                          :contract-missing]}]\n   461\t    (doseq [[label [entry rule]] cases]\n   462\t      (testing label\n   463\t        (is (= rule (rule-of #(m/make-ctx {:token \"t\", :store {'m entry}})))\n   464\t            \"a seeded store is verified at context construction\")\n   465\t        (let [ctx (assoc (m/make-ctx {:token \"t\"}) :store {'m entry})]\n   466\t          (is (= rule (rule-of #(m/expand-batch call-batch ctx)))\n   467\t              \"a store supplied past make-ctx is verified by expand-batch\"))\n   468\t        (let [ctx (m/make-ctx {:token \"t\"})]\n   469\t          (is (= rule (rule-of #(m/invoke entry [operand] ctx)))\n   470\t              \"direct invoke verifies before it runs anything\"))))\n   471\t    (testing \"the runner itself loads only under the stamp it is handed\"\n   472\t      (let [req {:macro-tree packet, :env {'x operand},\n   473\t                 :prelude (m/prelude identity), :max-steps 1000}]\n   474\t        (is (= :contract-missing\n   475\t               (rule-of #(m/bounded-row-evaluator req))))\n   476\t        (is (= :contract-mismatch\n   477\t               (rule-of #(m/bounded-row-evaluator\n   478\t                           (assoc req :contract \"v2\")))))\n   479\t        (is (= {:value operand}\n   480\t               (m/bounded-row-evaluator\n   481\t                 (assoc req :contract vm/ast-contract))))))\n   482\t    (testing \"a current-stamped packet expands and runs\"\n   483\t      (let [entry (m/macro-entry packet vm/ast-contract)\n   484\t            ctx (m/make-ctx {:token \"t\", :store {'m entry}})]\n   485\t        (is (= :ok (:status (m/expand-batch call-batch ctx))))\n   486\t        (is (= operand (m/invoke entry [operand] ctx)))))\n   487\t    (testing \"a harvested macro is stamped by the expander that produced it\"\n   488\t      (let [tree (m/ast->packet (app (v 'yin/def) (lit 'm)\n   489\t                                     (lam '[x] (v 'x))))\n   490\t            batch [:yin.program/batch [tree] 0\n   491\t                   [[:yin.macro/definition 0 []]]\n   492\t                   [[:yin.macro/harvest 0 0 []]]]\n   493\t            r (m/expand-batch batch (m/make-ctx {:token \"t\"}))]\n   494\t        (is (= vm/ast-contract\n   495\t               (:yin.macro/contract (get-in r [:ctx :store 'm]))))))))\n   496\t\n   497\t\n   498\t;; =============================================================================\n   499\t;; Contract stamps\n   500\t;; =============================================================================\n   501\t\n   502\t(deftest every-persistent-code-loader-requires-and-compares-a-stamp\n   503\t  (let [ast (app (v '+) (lit 1) (lit 2))\n   504\t        datoms (vm/ast->datoms ast)\n   505\t        rows (vm/ast->semantic-bytecode ast)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' collab/1790348400000-architect-yin-def-rule-r-impl-regate.gpt-6-sol.findings.md; sed -n '1,140p' collab/1790349600000-vm-engineer-yin-def-rule-r-commit-one-fix2.claude-opus-5-5.report.md; git diff --unified=0 -- src/cljc/yin/vm/macro.cljc test/yin/vm/store_write_audit_test.clj test/yin/vm/rule_r_test.cljc docs/design/yin.vm.engine.md docs/design/yin.vm.macro.md | head -230\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' collab/1790348400000-architect-yin-def-rule-r-impl-regate.gpt-6-sol.findings.md; sed -n '1,140p' collab/1790349600000-vm-engineer-yin-def-rule-r-commit-one-fix2.claude-opus-5-5.report.md; git diff --unified=0 -- src/cljc/yin/vm/macro.cljc test/yin/vm/store_write_audit_test.clj test/yin/vm/rule_r_test.cljc docs/design/yin.vm.engine.md docs/design/yin.vm.macro.md | head -230\"","aggregated_output":"Completed-GMT: 2026-09-25 17:12:26 GMT\nCompleted-Local: 2026-09-26 00:12:26 Asia/Ho_Chi_Minh\n\nThe three prior findings are **RESOLVED, PARTLY RESOLVED, RESOLVED**, respectively:\n\n1. **Adapter stamp laundering — RESOLVED.** Both adapters check the incoming AST contract before lowering (src/cljc/yin/vm/linearize.cljc:468-475,497-503); `ucf/canonicalize` now checks its input too (src/cljc/yin/vm/ucf.cljc:210-228). The direct negative tests cover missing and old stamps (test/yin/vm/rule_r_test.cljc:496-531).\n2. **Store-write audit — PARTLY RESOLVED.** It parses forms and host branches and catches the previously missed `assoc-in` form (test/yin/vm/store_write_audit_test.clj:68-83,227-249). It is not an exact audit of all writes; see the finding below.\n3. **Definition-key requirement — RESOLVED.** Both extraction queries include definition keys (src/cljc/yin/vm.cljc:1715-1728,1743-1753), matching the corrected documentation (docs/design/yin.vm.code-as-tuples.md:1356-1362) and the tree/segment test (test/dao/space/query_test.cljc:1537-1544). The completion fixture split retains its original per-key assertions (test/yin/vm/completion_test.cljc:222-240); the wider same-segment slice is conservative, not a hidden regression.\n\nP1 | src/cljc/yin/vm/macro.cljc:729-733 | `make-ctx` accepts a composition-supplied store of macro packets while checking only its reserved-name keys (line 1233). A packet taken from that store is passed to the transformer runner (lines 982-984,793-797), which loads its rows under `vm/ast-contract` without verifying any contract carried by the packet. An old or unstamped canonical macro packet can therefore be relabelled as `v3`. Direct `invoke` also accepts a packet (lines 810-815). | Carry and verify an AST contract with seeded macro packets before execution; stamp only packets freshly produced by the current expander. Test old and unstamped seeded packets.\n\nP2 | test/yin/vm/store_write_audit_test.clj:37-57 | The audit recognizes store-like symbol names and direct `:store` arguments, but not an alias such as `(let [heap (:store vm)] (assoc heap 'yin/def v))`. That write produces no audit site. The test itself acknowledges the alias residual (lines 21-24), whereas the design document calls the allowlist exact (docs/design/yin.vm.engine.md:65-75). | Track local store aliases and add this negative fixture, or narrow the documented guarantee and retain explicit review of alias-bearing writes.\n\nThe remaining automatic contract sources are either fresh-source paths or descriptive stamps as reported, **except the seeded macro-packet path above**. The query workaround is appropriate: the query engine binds bare symbols in patterns (src/cljc/dao/space/query.cljc:970-980); documenting that syntax separately is deferred, not a defect in this change.\n\nI did not rerun suites. The supplied independent JVM, Node, Dart, kondo, and cljstyle results are green, but they do not cover the unstamped seeded-macro route.\n\nVerdict: REQUEST CHANGES\nSign-off: DENIED\nCompleted-GMT: 2026-09-25 17:25:20 GMT\nCompleted-Local: 2026-09-26 00:25:20 +07\nCoding-Agent: claude\nSession-ID: resume-of-078d0a96-daf0-4cef-b994-076601d800d6\n\n# Report: Rule R commit one, fix round 2\n\nRole: VM Runtime Engineer. Worktree: /Users/sto/workspace/datomworld-ucf-rule-r\n(branch ucf-rule-r). Nothing is staged or committed. The whole uncommitted\ndiff is now 63 tracked files (+1832 / -543), plus two new test files.\n\n## Lanes\n\nEach lane ran solo under mise. Dart ran with `rm -rf test/cljd-out` first.\n\n| Lane | Last round | Now | Change |\n|---|---|---|---|\n| JVM | 2,049 / 180,956 | 2,051 tests / 180,998 assertions, 0 failures, 0 errors | +2 tests: the macro-stamp test and the residual-fixture test |\n| Node | 1,963 / 47,972 | 1,964 tests / 47,987 assertions, 0 failures, 0 errors | +1 test: the macro-stamp test |\n| Dart | 1,925 | 1,926 passed | +1 test: the macro-stamp test ran on Dart |\n\n- kondo on every changed file: 0 errors. Its 7 warnings all exist at HEAD.\n- cljstyle: clean.\n- Every added line in the uncommitted diff is ASCII and at most 80 columns.\n  The one exception is Markdown grid-table rows, as before.\n\n## P1: macro packets were relabelled v3 (fixed)\n\nEach macro-store value is now a stamped entry built with\n`(m/macro-entry packet contract)`, which gives\n`{:yin.macro/tree packet, :yin.macro/contract c}`. Stamps are checked in\nthree places:\n\n1. **The runner.** `invoke*` verifies the entry's contract against\n   `vm/ast-contract` before anything runs, and throws `:contract-missing`\n   or `:contract-mismatch`. This covers both routes into it:\n   - the expansion path (`expand-batch` -> `expand-call`);\n   - direct `m/invoke`, which now takes an entry.\n\n   A bare packet has no contract, so it fails with `:contract-missing`.\n2. **Construction.** `make-ctx` and `expand-batch` verify every entry in the\n   store they are given, through `check-store!`, before expansion starts.\n   The `expand-batch` check catches a store attached with `assoc`, which\n   never passes through `make-ctx`.\n3. **Stamping.** Only this expander stamps packets as current: harvest and\n   post-harvest mark the packets they produce from the batch they admitted\n   with `vm/ast-contract`. A seeded entry keeps its own stamp.\n\n`bounded-row-evaluator` is public, so it was a second route. Its request\nnow carries the verified stamp as `:contract`. It checks that stamp before\nrunning, and loads the body rows under it, never under its own constant.\nThe check happens before the `try`, so a stamp failure is thrown as a\nrefusal instead of being turned into `:body-error` data.\n\n**Tests** (in `rule_r_test/a-macro-packet-runs-only-under-its-verified-stamp`):\n\n- These are refused with the right rule on all three routes (`make-ctx`,\n  `expand-batch` with a store attached via `assoc`, and direct `invoke`):\n  - an unstamped packet: `:contract-missing`;\n  - an entry stamped \"v2\": `:contract-mismatch`;\n  - an entry with a nil contract: `:contract-missing`.\n- The runner called directly: no stamp gives `:contract-missing`, \"v2\"\n  gives `:contract-mismatch`, and \"v3\" runs.\n- A current-stamped entry expands and runs.\n- A harvested macro is stamped `vm/ast-contract`.\n\n**Callers updated:**\n\n- `macro_test`: the `macro-root` helper reads `:yin.macro/tree`; the\n  `prelude-and-invoke` test stamps its own fresh packets.\n- `repl_test` and `repl/repl-state`: the `:macros` summary reads the root\n  from the entry.\n\n**Sweep: every place that hands stored or supplied code to a loader under\nthe current contract.** I checked each of these:\n\n- **Macro store / `invoke` / runner.** Fixed above.\n- **`linearize` adapters and `ucf/canonicalize`.** Verified in round 1.\n- **`repl/program-loaders`** (lines 117, 138, 155, 163). These take packets\n  from `program-out`, whose only producer is the expander. It is the\n  trusted fresh-producer path, and the code says so.\n- **`vm/eval`.** Takes an AST map from its caller and validates the whole\n  tree; the design names it a fresh producer. Its callers are:\n  - `dao.await/run` (the process descriptor's `:ast`);\n  - the demos: `demo.clj`, `equation_plotter.cljs`,\n    `register_bench_cljd.cljd`.\n- **Continuation handoff.** The receiver loads under the stamp shipped in\n  the registers and verifies it.\n- **`compilation_pipeline.cljs` and `continuation_stream.cljs`.** They lower\n  fresh yang output.\n- **`completion`** (default `:contract`) and **`ledger`**\n  (`lowering-profile`). These only describe a contract or compare against\n  one; neither loads anything.\n- **Linker fetch (M1).** Returns an image and does not load it. The tests\n  load it with an explicit contract.\n- **`content.cljc`.** Fetches and materializes values; it does not load.\n\nNo other place relabels supplied code. One open point: the expander's\ninput batches are still unstamped syntax. They are admitted by\n`valid-tree?`, and the packets harvested from them count as this\nexpander's fresh output. If `program-in` batches should carry a stamp too,\nthat is a design question, not something this change decided.\n\n## P2: the audit missed local aliases (fixed, and its guarantee restated)\n\n**(a) Detection.** The audit walker now tracks store aliases in scope:\n\n- A symbol bound to a store by `let`, `let*`, `loop`, `loop*`, `when-let`,\n  `if-let`, `when-some`, `if-some`, `when-first`, or `binding`.\n- A binding made through an earlier alias, in the same or an enclosing\n  binding form.\n- A `{heap :store}` destructuring key.\n\nEach alias is scoped to its binding form's body.\n\nWhat counts as \"a store\" also grew:\n\n- `(get-in x [:store ...])` now counts;\n- in a `->` or `some->` pipeline, every mutation step after the pipeline\n  passes `:store` is flagged.\n\nI did not add alias tracking for fn parameters passed a store at a call\nsite. I could not do that reliably, so it stays in the documented residual.\n\nThere are 10 new negative fixtures, all caught:\n\n- codex's `(let [heap (:store vm)] (assoc heap 'yin/def v))`;\n- a chained alias (`h2` bound to `h`);\n- a `get-in` alias;\n- `when-let`, `if-let`, and `loop`/`recur` aliases;\n- destructuring `{heap :store}`;\n- a nested `let`;\n- `-> vm :store (assoc ..)`;\n- `some-> vm (get :store) (update ..)`.\n\nThe `src` allowlist did not change: no aliased store write exists in `src`\ntoday.\n\n**(b) The stated guarantee now matches the code.**\n\n","exit_code":0,"status":"completed"}}
