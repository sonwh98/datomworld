           (map-indexed vector trees))\n   428\t        (let [indexes (mapv packet-index trees)\n   429\t              merged (merge-indexes indexes)\n   430\t              roots (mapv first trees)\n   431\t              catalogue-error (fn [h & kvs] {:error (apply malformed :harvest-catalogue :ordinal h kvs)})\n   432\t              entries\n   433\t              (reduce\n   434\t                (fn [acc [i [_ h j path]]]\n   435\t                  (let [a (when (and (integer? j) (< -1 j (count trees)))\n   436\t                            (resolve-path (nth indexes j) (nth roots j) path))\n   437\t                        d (when a (definition-at (nth indexes j) a))]\n   438\t                    (cond (not= i h) (reduced (catalogue-error h))\n   439\t                          (nil? d) (reduced (catalogue-error h :tree j :path path))\n   440\t                          (contains? (:seen acc) [j path])\n   441\t                          (reduced (catalogue-error h :tree j :path path))\n   442\t                          :else (-> acc\n   443\t                                    (update :seen conj [j path])\n   444\t                                    (update :entries conj\n   445\t                                            (assoc d :ordinal h, :tree j, :path path\n   446\t                                                   :address a))))))\n   447\t                {:seen #{}, :entries []}\n   448\t                (map-indexed vector harvest))]\n   449\t          (cond\n   450\t            (:error merged) merged\n   451\t\n   452\t            (:error entries) entries\n   453\t\n   454\t            :else\n   455\t            (let [{:keys [seen entries]} entries]\n   456\t              (or\n   457\t                (some (fn [j]\n  1305\t                 :params '[b],\n  1306\t                 :body (app {:type :lambda,\n  1307\t                             :params '[l],\n  1308\t                             :body (app (v 'yin/make-def) (v 'fn-name) (v 'l))}\n  1309\t                            (app (v 'yin/make-lambda) (v 'fn-params) (v 'b)))}\n  1310\t                (app (v 'yin/sequence-body) (v 'body)))}))\n  1311\t\n  1312\t\n  1313\t(def stdlib-forms\n  1314\t  \"The standard forms as a row-native batch: one tree defining `defn`,\n  1315\t   declared and harvested. Seed a store by expanding it (`seed-store`).\"\n  1316\t  (let [def-ast {:type :application,\n  1317\t                 :operator {:type :variable, :name 'yin/def},\n  1318\t                 :operands [{:type :literal, :value 'defn} defn-lambda-ast]}]\n  1319\t    [:yin.program/batch\n  1320\t     [(ast->packet def-ast)]\n  1321\t     0\n  1322\t     [[:yin.macro/definition 0 []]]\n  1323\t     [[:yin.macro/harvest 0 0 []]]]))\n  1324\t\n  1325\t\n  1326\t(defn seed-store\n  1327\t  \"Fold validated input batches in order through `expand-batch`, returning\n  1328\t   the resulting store. Throws on a batch that fails.\"\n  1329\t  [ctx batches]\n  1330\t  (:store (reduce (fn [ctx batch]\n  1331\t                    (let [{:keys [status error] :as r} (expand-batch batch ctx)]\n  1332\t                      (when-not (= :ok status)\n  1333\t                        (throw (ex-info \"Store seeding batch failed\" error)))\n  1334\t                      (:ctx r)))\n  1335\t                  ctx\n  1336\t                  batches)))\n","exit_code":0,"status":"completed"}}
