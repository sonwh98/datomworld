ee)]\n  1260\t                  (throw (ex-info \"Expander produced a non-canonical tree\" e))\n  1261\t                  (finish (assoc st :tree tree :next-store next-store)))))))))))\n  1262\t\n  1263\t\n  1264\t(defn expand\n  1265\t  \"`expand-batch` returning the tree packet, or throwing `ex-info` carrying\n  1266\t   the error data.\"\n  1267\t  [batch ctx]\n  1268\t  (let [{:keys [status tree error]} (expand-batch batch ctx)]\n  1269\t    (if (= :ok status)\n  1270\t      tree\n  1271\t      (throw (ex-info \"Macro expansion failed\" error)))))\n  1272\t\n  1273\t\n  1274\t(defn make-ctx\n  1275\t  \"An expander context. The composition supplies the incarnation `token`\n  1276\t   and the opaque `source-medium` identity (S3.1); the store may be\n  1277\t   seeded with `macro-entry` values. A seeded store binding a reserved\n  1278\t   name, a macro named `yin/def`, is refused (Rule R), and so is any entry\n  1279\t   whose AST contract is absent (`:contract-missing`) or old\n  1280\t   (`:contract-mismatch`).\"\n  1281\t  [{:keys [token source-medium store guards], eval-fn :eval}]\n  1282\t  (cond-> {:store (check-store! (or store {})),\n  1283\t           :incarnation {:yin.expander/token token},\n  1284\t           :attempt 0,\n  1285\t           :source-medium source-medium,\n   420\t             \"register env\" #(rvm/create-vm nil {:free-env bound}),\n   421\t             \"register store\" #(rvm/create-vm nil {:store bound}),\n   422\t             \"register registry\" #(rvm/create-vm nil {:primitives registry})}]\n   423\t      (testing label\n   424\t        (is (= :reserved-name (rule-of thunk)))))))\n   425\t\n   426\t\n   427\t(deftest the-expander-refuses-the-name\n   428\t  (let [macro (m/macro-entry (m/ast->packet (lam '[x] (v 'x)))\n   429\t                             vm/ast-contract)]\n   430\t    (testing \"a seeded macro named yin/def is refused at context\n   431\t              construction\"\n   432\t      (is (= :macro (:role (refusal #(m/make-ctx {:token \"t\",\n   433\t                                                  :store {'yin/def\n   434\t                                                          macro}}))))))\n   435\t    (testing \"batch expansion refuses a context store binding it\"\n   436\t      (let [ctx (assoc (m/make-ctx {:token \"t\"}) :store {'yin/def macro})\n   437\t            batch [:yin.program/batch [(m/ast->packet (lit 1))] 0 [] []]]\n   438\t        (is (= :reserved-name (rule-of #(m/expand-batch batch ctx))))))\n   439\t    (testing \"harvest refuses it as a definition key\"\n   440\t      (let [tree (m/ast->packet (app (v 'yin/def) (lit 'yin/def) (lit 1)))\n   441\t            batch [:yin.program/batch [tree] 0 []\n   442\t                   [[:yin.macro/harvest 0 0 []]]]]\n   443\t        (is (= :definition-key\n   444\t               (:role (refusal #(m/expand-batch\n   445\t                                  batch (m/make-ctx {:token \"t\"}))))))))\n   446\t    (testing \"the transformer runner loads under the verified stamp\"\n   447\t      (is (= (m/ast->packet (lit 1))\n   448\t             (m/invoke macro [(m/ast->packet (lit 1))]\n   449\t                       (m/make-ctx {:token \"t\"})))))))\n   450\t\n   451\t\n   452\t(deftest a-macro-packet-runs-only-under-its-verified-stamp\n   453\t  (let [packet (m/ast->packet (lam '[x] (v 'x)))\n   454\t        operand (m/ast->packet (lit 1))\n   455\t        call-batch [:yin.program/batch [(m/ast->packet (app (v 'm) (lit 1)))]\n   456\t                    0 [] []]\n   457\t        cases {\"unstamped\" [packet :contract-missing],\n   458\t               \"old-stamped\" [(m/macro-entry packet \"v2\") :contract-mismatch],\n   459\t               \"a stamp but no contract\" [(m/macro-entry packet nil)\n   460\t                                          :contract-missing]}]\n   461\t    (doseq [[label [entry rule]] cases]\n   462\t      (testing label\n   463\t        (is (= rule (rule-of #(m/make-ctx {:token \"t\", :store {'m entry}})))\n   464\t            \"a seeded store is verified at context construction\")\n   465\t        (let [ctx (assoc (m/make-ctx {:token \"t\"}) :store {'m entry})]\n   466\t          (is (= rule (rule-of #(m/expand-batch call-batch ctx)))\n   467\t              \"a store supplied past make-ctx is verified by expand-batch\"))\n   468\t        (let [ctx (m/make-ctx {:token \"t\"})]\n   469\t          (is (= rule (rule-of #(m/invoke entry [operand] ctx)))\n   470\t              \"direct invoke verifies before it runs anything\"))))\n   471\t    (testing \"the runner itself loads only under the stamp it is handed\"\n   472\t      (let [req {:macro-tree packet, :env {'x operand},\n   473\t                 :prelude (m/prelude identity), :max-steps 1000}]\n   474\t        (is (= :contract-missing\n   475\t               (rule-of #(m/bounded-row-evaluator req))))\n   476\t        (is (= :contract-mismatch\n   477\t               (rule-of #(m/bounded-row-evaluator\n   478\t                           (assoc req :contract \"v2\")))))\n   479\t        (is (= {:value operand}\n   480\t               (m/bounded-row-evaluator\n   481\t                 (assoc req :contract vm/ast-contract))))))\n   482\t    (testing \"a current-stamped packet expands and runs\"\n   483\t      (let [entry (m/macro-entry packet vm/ast-contract)\n   484\t            ctx (m/make-ctx {:token \"t\", :store {'m entry}})]\n   485\t        (is (= :ok (:status (m/expand-batch call-batch ctx))))\n   486\t        (is (= operand (m/invoke entry [operand] ctx)))))\n   487\t    (testing \"a harvested macro is stamped by the expander that produced it\"\n   488\t      (let [tree (m/ast->packet (app (v 'yin/def) (lit 'm)\n   489\t                                     (lam '[x] (v 'x))))\n   490\t            batch [:yin.program/batch [tree] 0\n   491\t                   [[:yin.macro/definition 0 []]]\n   492\t                   [[:yin.macro/harvest 0 0 []]]]\n   493\t            r (m/expand-batch batch (m/make-ctx {:token \"t\"}))]\n   494\t        (is (= vm/ast-contract\n   495\t               (:yin.macro/contract (get-in r [:ctx :store 'm]))))))))\n   496\t\n   497\t\n   498\t;; =============================================================================\n   499\t;; Contract stamps\n   500\t;; =============================================================================\n   501\t\n   502\t(deftest every-persistent-code-loader-requires-and-compares-a-stamp\n   503\t  (let [ast (app (v '+) (lit 1) (lit 2))\n   504\t        datoms (vm/ast->datoms ast)\n   505\t        rows (vm/ast->semantic-bytecode ast)\n   506\t        batch (linearize/lower-ast ast)\n   507\t        v1 (:vector (linearize/lower-rows rows))\n   508\t        stack-image (:image (dl/adapt datoms))\n   509\t        register-image* (:image (rc/adapt datoms))\n   510\t        loaders\n   511\t        {\"walker datoms\" [#(ast-walker/vm-load-program (tu/create-vm)\n   512\t                                                       datoms %)\n   513\t                          \"v2\"],\n   514\t         \"walker rows\" [#(ast-walker/vm-load-rows (tu/create-vm) rows %)\n   515\t                        \"v2\"],\n   516\t         \"semantic datoms\" [#(semantic/vm-load-program (semantic/create-vm)\n   517\t                                                       batch %)\n   518\t                            \"v2\"],\n   519\t         \"semantic vector\" [#(semantic/load-vector (semantic/create-vm) v1 %)\n   520\t                            \"v2\"],\n   521\t         \"stack\" [#(dvm/create-vm stack-image\n   522\t                                  {:primitives vm/primitives, :contract %})\n   523\t                  \"b1\"],\n   524\t         \"register\" [#(rvm/create-vm register-image*\n   525\t                                     {:primitives vm/primitives,\n   526\t                                      :contract %})\n   527\t                     \"r1\"]}]\n   528\t    (doseq [[label [load old]] loaders]\n   529\t      (testing label\n   530\t        (is (= :contract-missing (rule-of #(load nil)))\n   531\t            \"an unstamped load is refused\")\n   532\t        (let [d (refusal #(load old))]\n","exit_code":0,"status":"completed"}}
