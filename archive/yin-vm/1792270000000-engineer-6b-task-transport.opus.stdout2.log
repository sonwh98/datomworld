{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TY42aREUMvTTPbb8ZqZTeQ","type":"tool_result","content":"1\t(ns yin.vm.semantic-register.frame-test\n2\t  (:require [clojure.test :refer [deftest is testing]]\n3\t            #?(:cljd nil :clj [clojure.java.io :as io])\n4\t            [yin.vm :as vm]\n5\t            [yin.vm.engine :as engine]\n6\t            [yin.vm.module :as module]\n7\t            [yin.vm.values :as values]\n8\t            [yin.vm.semantic-register.linearize :as linearize]\n9\t            [yin.vm.semantic-register.analysis :as analysis]\n10\t            [yin.vm.semantic-register.frame :as frame]\n11\t            [yin.vm.semantic-register.corpus :as corpus]\n12\t            [yin.vm.semantic-register.parity-test :as parity]\n13\t            [yin.vm.ucf.v2-support :as s]\n14\t            [yin.vm.ucf.lift-support :as support]\n15\t            [dao.stream :as stream]\n16\t            [dao.jing :as jing]\n17\t            [dao.jing.cbor :as cbor]))\n18\t\n19\t\n20\t(def task {:free-env {} :ffi-call-ids #{}})\n21\t\n22\t\n23\t(defn canonical\n24\t  \"Reshape evaluator payload; values remain opaque to the pure validator.\"\n25\t  [m f pending?]\n26\t  (let [address (fn [seg] (get-in m [:code seg :address]))\n27\t        env (fn [e]\n28\t              (cond-> {:yin.k/bindings (engine/without-store-of e)}\n29\t                (some? (engine/env-store-of e)) (assoc :yin.k/store-of (engine/env-store-of e))))\n30\t        act? (contains? f :pc)]\n31\t    (cond-> {:yin.k/state (if act? :act :tail) :yin.k/segment (address (:segment f))\n32\t             :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd (get-in f [:deliver :rd])}\n33\t                                {:yin.k/deliver :return})\n34\t             :yin.k/k (mapv (fn [k]\n35\t                              {:yin.k/frame-type :return :yin.k/segment (address (:segment k))\n36\t                               :yin.k/pc (:pc k) :yin.k/env (env (:env k))\n37\t                               :yin.k/window (:window k) :yin.k/rd (:rd k)}) (or (:k f) []))}\n38\t      act? (assoc :yin.k/pc (:pc f) :yin.k/env (env (:env f)) :yin.k/window (:window f))\n39\t      (not act?) (assoc :yin.k/site (:site f))\n40\t      pending? (assoc :yin.k/pending {:yin.k/reason (:reason f)}))))\n41\t\n42\t\n43\t(defn machine-code\n44\t  [m]\n45\t  (into {} (map (fn [[_ image]] [(:address image) (:vector image)])) (:code m)))\n46\t\n47\t\n48\t(defn- cat-of\n49\t  [p q]\n50\t  (s/app (s/v 'cat) p q))\n51\t\n52\t\n53\t(defn- with-cat\n54\t  [ast]\n55\t  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n56\t\n57\t\n58\t(defn- nest\n59\t  [depth op]\n60\t  (if (zero? depth) op\n61\t      (cat-of (s/lit [depth]) (s/app (s/lam ['x] (nest (dec depth) op)) (s/lit depth)))))\n62\t\n63\t\n64\t(def wrappers\n65\t  (mapv (fn [[label wrap]] [label (comp with-cat wrap)])\n66\t        [[:bare identity]\n67\t         [:operand #(cat-of (s/lit [:operand]) %)]\n68\t         [:depth-3 #(nest 3 %)]\n69\t         [:captured #(s/let1 'k (s/lit :captured)\n70\t                             (s/let1 'f (s/lam ['y] (cat-of (cat-of (cat-of (s/lit []) (s/v 'k)) (s/v 'y)) %))\n71\t                                     (s/app (s/v 'f) (s/lit :arg))))]]))\n72\t\n73\t\n74\t(defn- rows-program\n75\t  [n]\n76\t  (let [read (s/next-of (s/v 'c)) capture {:type :vm/current-continuation}]\n77\t    (case n\n78\t      1 (s/let1 'a read (cat-of (cat-of (s/lit []) (s/v 'a)) read))\n79\t      2 {:type :stream/put :target (s/v 'w) :val (s/lit \"v\")}\n80\t      5 (cat-of (s/lit [:ordinary]) (s/app (s/v 'stream/next!) (s/v 'c)))\n81\t      6 (s/app (s/lam ['u] (assoc (s/app (s/v 'stream/next!) (s/v 'c)) :tail? true)) (s/lit 0))\n82\t      13 {:type :vm/park}\n83\t      14 (s/let1 'k capture (cat-of (cat-of (s/lit []) (s/v 'k)) read))\n84\t      15 (s/let1 'k capture {:type :if :test (s/app (s/v '=) (s/v 'k) (s/lit :second))\n85\t                             :consequent (s/lit :done) :alternate (s/let1 'r read (s/app (s/v 'k) (s/lit :second)))})\n86\t      16 (s/let1 'k1 capture (s/let1 'k2 capture\n87\t                                     (cat-of (cat-of (cat-of (s/lit []) (s/v 'k1)) (s/v 'k2)) read)))\n88\t      18 (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))\n89\t      19 (s/lit 42)\n90\t      21 (s/let1 'f (s/lam [] (s/v 'x)) (s/app (s/lam ['x] (s/app (s/v 'f) read)) (s/lit 1)))\n91\t      22 (s/app (s/lam ['p 'q] (cat-of (cat-of (s/lit []) (s/v 'p)) (s/v 'q))) (s/lit nil) read))))\n92\t\n93\t\n94\t(defn- attach-reader\n95\t  [m ring]\n96\t  (let [[ref m] (engine/attach-resource m ring)\n97\t        [id m] (engine/gensym m \"cursor\")]\n98\t    (engine/handle-cursor m {:stream ref} id)))\n99\t\n100\t\n101\t(defn reference-machines\n102\t  []\n103\t  (into\n104\t    (mapv (fn [[n [label wrap]]]\n105\t            (let [ring (s/ring 4)\n106\t                  w (support/one-slot-stream (str \"frame-\" n))\n107\t                  _ (stream/append! w :warmed)\n108\t                  env (if (= n 21) {'x 99 'y 7} {})\n109\t                  m (parity/register-machine (wrap (rows-program n)) {:env env :modules (module/register-stream-module (module/default-registry))})\n110\t                  [cr m] (attach-reader m ring)\n111\t                  [wr m] (engine/attach-resource m w)\n112\t                  m (assoc m :store {'c cr 'w wr})\n113\t                  m (if (= n 18)\n114\t                      (let [[second-cursor m] (attach-reader m ring)\n115\t                            [seg image] (first (:code m))\n116\t                            closure (first (filter #(= :closure (first %)) (:vector image)))\n117\t                            clo (values/closure (:owner m) {:type :closure :params (nth closure 2)\n118\t                                                            :entry (nth closure 3) :segment seg\n119\t                                                            :env {engine/store-of-key 'host.mod}})]\n120\t                        (assoc m :store (assoc (:store m) 'mod clo)\n121\t                               :module-stores {'host.mod {'c cr 'd second-cursor}})) m)\n122\t                  blocked (vm/run m)\n123\t                  blocked (if (= n 1) (do (stream/append! ring \"A\") (vm/run blocked)) blocked)]\n124\t              {:row n :wrapper label :machine blocked :task (assoc task :free-env env)}))\n125\t          (mapcat (fn [n] (mapv #(vector n %) wrappers)) [1 2 5 6 13 14 15 16 18 19 21 22]))\n126\t    (let [ring (s/ring 4)\n127\t          m (parity/register-machine (assoc (s/app (s/v 'stream/next!) (s/v 'c)) :tail? true)\n128\t                                     {:modules (module/register-stream-module (module/default-registry))})\n129\t          [cr m] (attach-reader m ring)]\n130\t      [{:row 20 :wrapper :unwrapped :machine (vm/run (assoc m :store {'c cr})) :task task}])))\n131\t\n132\t\n133\t(defn reference-frames\n134\t  \"Every wait, parked payload, and capture reachable through their values.\"\n135\t  [{:keys [machine task] :as fixture}]\n136\t  (let [out (atom []) code-map (machine-code machine)]\n137\t    (letfn [(record\n138\t              [f context t]\n139\t              (let [cf (canonical machine f (= :wait context))]\n140\t                (swap! out conj {:frame cf :code code-map :context context :task t :fixture (select-keys fixture [:row :wrapper])})\n141\t                (walk (:env f)) (walk (:window f)) (walk (:k f))))\n142\t            (walk\n143\t              [x]\n144\t              (cond\n145\t                (values/continuation? x) (record (values/payload x) :captured task)\n146\t                (values/closure? x) (walk (:env (values/payload x)))\n147\t                (map? x) (doseq [[k v] x] (walk k) (walk v))\n148\t                (coll? x) (doseq [v x] (walk v))\n149\t                :else nil))]\n150\t      (doseq [f (:wait-set machine)] (record f :wait task))\n151\t      (doseq [[p f] (:parked machine)] (record f :parked (assoc task :parked-key p)))\n152\t      (walk (:value machine)) (walk (:store machine))\n153\t      @out)))\n154\t\n155\t\n156\t(def worked-vector (:vector (linearize/project (second (first (filter #(= :worked-example (first %)) corpus/programs))))))\n157\t(def worked-address (jing/segment-key worked-vector))\n158\t(def worked-code {worked-address worked-vector})\n159\t\n160\t\n161\t(def worked-frame\n162\t  {:yin.k/state :act :yin.k/segment worked-address :yin.k/pc 4\n163\t   :yin.k/env {:yin.k/bindings {}} :yin.k/window {1 :f}\n164\t   :yin.k/deliver {:yin.k/deliver :rd :yin.k/rd 2} :yin.k/k []\n165\t   :yin.k/pending {:yin.k/reason :next :yin.k/cursor-cell :test/cursor}})\n166\t\n167\t\n168\t(deftest contract-is-pure\n169\t  (is (nil? (frame/defect worked-frame worked-code :wait task)))\n170\t  #?(:cljd nil\n171\t     :clj (let [source (slurp (io/file \"src/cljc/yin/vm/semantic_register/frame.cljc\"))\n172\t                ns-form (first (re-seq #\"(?s)^.*?\\n\\n\" source))]\n173\t            (is (not (re-find #\"yin.vm.engine|yin.vm.semantic-register\\s+:|yin.vm.debruijn.(stack|register)\" ns-form))))))\n174\t\n175\t\n176\t(deftest every-reference-frame-validates\n177\t  (let [fixtures (reference-machines)]\n178\t    (is (= 49 (count fixtures)))\n179\t    (doseq [fixture fixtures]\n180\t      (testing (pr-str (select-keys fixture [:row :wrapper]))\n181\t        (let [frames (reference-frames fixture)]\n182\t          (if (= 19 (:row fixture))\n183\t            (is (vm/halted? (:machine fixture)))\n184\t            (is (seq frames)))\n185\t          (doseq [{:keys [frame code context task]} frames]\n186\t            (is (nil? (frame/defect frame code context task)))))))))\n187\t\n188\t\n189\t(defn kind\n190\t  [f c context t]\n191\t  (:yin.k/kind (frame/defect f c context t)))\n192\t\n193\t\n194\t(deftest worked-example-saved\n195\t  (is (= #{1} (analysis/saved (analysis/analyze worked-vector) 4 2)))\n196\t  (is (nil? (kind worked-frame worked-code :wait task)))\n197\t  (is (= :window-self (kind (ass