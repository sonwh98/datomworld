error-refusal module-name e)}))]\n1372\t        (if-let [refusal (:refusal lifted)]\n1373\t          (refuse-install state module-name refusal)\n1374\t          (let [verified (verified-images state vm response)\n1375\t                origin-of (fn [seg]\n1376\t                            (some #(when (module/image-holds? vm % seg) %)\n1377\t                                  verified))\n1378\t                foreign (first (remove origin-of\n1379\t                                       (sort-by str (:origins lifted))))]\n1380\t            (if (some? foreign)\n1381\t              (refuse-install state module-name\n1382\t                              {:status :refused,\n1383\t                               :reason :foreign-image,\n1384\t                               :module module-name,\n1385\t                               :segment foreign})\n1386\t              (let [images (into {}\n1387\t                                 (map (fn [seg]\n1388\t                                        (let [img (origin-of seg)]\n1389\t                                          [(module/image-identity vm img)\n1390\t                                           img])))\n1391\t                                 (:origins lifted))\n1392\t                    entry (module/module-entry\n1393\t                            (:modules (module/link-module\n1394\t                                        nil manifest (:derivation response)\n1395\t                                        (assoc lifted :images images)))\n1396\t                            module-name)\n1397\t                    ;; the admission the link rode on (yin.vm.linker.dht.md\n1398\t                    ;; 7.5): inherited and transferred with the entry\n1399\t                    entry (cond-> entry\n1400\t                            (= :allow (:yin.admit/decision response))\n1401\t                            (assoc :admission\n1402\t                                   (select-keys response\n1403\t                                                [:yin.admit/id\n1404\t                                                 :yin.admit/decision\n1405\t                                                 :yin.admit/asserters\n1406\t                                                 :yin.admit/address])))\n1407\t                    received (receive-module state module-name entry)\n1408\t                    received (reduce\n1409\t                               (fn [s [m dep]]\n1410\t                                 (if (some? (module/module-entry\n1411\t                                              (:modules (:modules s)) m))\n1412\t                                   s\n1413\t                                   (receive-module s m (dissoc dep :bindings))))\n1414\t                               received\n1415\t                               (linked-entries (:modules vm)))]\n1416\t                (-> received\n1417\t                    (update :installs dissoc module-name)\n1418\t                    (wake-installed module-name module-name nil))))))))))\n1419\t\n1420\t\n1421\t(defn- advance-install\n1422\t  \"Step the install child of `module-name` in this round, beside every\n1423\t   other task (section 7.3): `running` runs it until it halts or parks.\n1424\t   A parked child stays `parked`; a halted one goes on to `validated`; an\n1425\t   error refuses the install. An error while publishing -- attaching an\n1426\t   origin image, lowering the slice or a store snapshot, or receiving a\n1427\t   dependency -- refuses it too, at phase `:linked`, from the state the\n1428\t   round started with: nothing half-published survives, every waiter is\n1429\t   restored with the refusal, and no throw leaves the round.\n1430\t\n1431\t   Under a custody gate the child is stamped with the root's mode before\n1432\t   it runs; in `:exporting` and `:ended` it does not run.\"\n1433\t  [state module-name]\n1434\t  (let [inst (get-in state [:installs module-name])\n1435\t        mode (vm/gate-mode state)\n1436\t        [child refusal]\n1437\t        (when-not (contains? #{:exporting :ended} mode)\n1438\t          (try [(vm/run (stamp-gate (:vm inst) mode)) nil]\n1439\t               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n1440\t                 [nil (error-refusal module-name e)])))]\n1441\t    (cond\n1442\t      (and (nil? child) (nil? refusal)) state\n1443\t      refusal (refuse-install state module-name refusal)\n1444\t      (:blocked? child)\n1445\t      (assoc-in state [:installs module-name]\n1446\t                (assoc inst :vm child :phase :parked))\n1447\t      (:halted? child)\n1448\t      (try (link-install state module-name (assoc inst :vm child))\n1449\t           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n1450\t             (refuse-install state module-name\n1451\t                             (assoc (error-refusal module-name e)\n1452\t                                    :phase :linked))))\n1453\t      :else (assoc-in state [:installs module-name]\n1454\t                      (assoc inst :vm child :phase :running)))))\n1455\t\n1456\t\n1457\t(defn- advance-installs\n1458\t  [state]\n1459\t  (reduce advance-install state (sort-by str (keys (:installs state)))))\n1460\t\n1461\t\n1462\t(defn- start-install\n1463\t  \"`loading`: spawn the child, or refuse on a loader defect. Returns\n1464\t   `[state refusal]`.\"\n1465\t  [state module-name response link-id]\n1466\t  (try\n1467\t    (let [[child state] (spawn-child state module-name response)]\n1468\t      [(assoc-in state [:installs module-name]\n1469\t                 {:phase :running, :vm child, :parent link-id,\n1470\t                  :response response})\n1471\t       nil])\n1472\t    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n1473\t      [state (assoc (error-refusal module-name e) :phase :loading)])))\n1474\t\n1475\t\n1476\t(defn- settle\n1477\t  \"Act on the response correlated with `entry`: a refusal (or loss) is\n1478\t   raised as the effect's error; `:ok` runs step 5b against the live\n1479\t   state and, discharged, starts the install child, the entry becoming\n1480\t   an `:install` waiter. A module linked or installing meanwhile answers\n1481\t   or joins instead, and a manifest naming another module than the one\n1482\t   required is `:module-name-mismatch`, never installed. Returns `[state\n1483\t   waiting woken]`.\"\n1484\t  [state entry response]\n1485\t  (let [state (retire state (:link-id entry) :restored)\n1486\t        module-name (:name entry)\n1487\t        waiter (-> entry\n1488\t                   (dissoc :envelope :request :response :cursor :link-id)\n1489\t                   (assoc :reason :install))]\n1490\t    (cond\n1491\t      (not= :ok (:status response))\n1492\t      [state nil (refused-entry entry response)]\n1493\t\n1494\t      (some? (module/resolve-module (:modules state) module-name))\n1495\t      [state nil (ready entry module-name)]\n1496\t\n1497\t      (contains? (:installs state) module-name) [state waiter nil]\n1498\t\n1499\t      ;; the linker checks the name (section 8.1); a response that names\n1500\t      ;; another module is never installed under this one\n1501\t      (not= module-name (get-in response [:manifest :yin.module/name]))\n1502\t      [state nil\n1503\t       (refused-entry entry\n1504\t                      (linker/refused :module-name-mismatch\n1505\t                                      {:requested module-name,\n1506\t                                       :manifest (get-in\n1507\t                                                   response\n1508\t                                                   [:manifest\n1509\t                                                    :yin.module/name])}))]\n1510\t\n1511\t      :else\n1512\t      (if-let [refusal (discharge-defect state response)]\n1513\t        [state nil (refused-entry entry refusal)]\n1514\t        (let [[state refusal] (start-install state module-name response\n1515\t                                             (:link-id entry))]\n1516\t          (if refusal\n1517\t            [state nil (refused-entry entry refusal)]\n1518\t            [state waiter nil]))))))\n1519\t\n1520\t\n1521\t(defn- link-read-step\n1522\t  \"Apply one read outcome `r` to the `:link-response` `entry`, whose\n1523\t   `:cursor` is the position the read was made at (section 7.2, step 7):\n1524\t   an `ok` carrying another id's response advances the cursor and skips\n1525\t   it, `[:skipped state entry]`; every other result is final,\n1526\t   `[:done state waiting woken]`. An `ok` with the entry's own id settles;\n1527\t   `blocked` keeps waiting; `gap` and the terminal outcomes are raised as\n1528\t   the effect's error.\"\n1529\t  [state entry r]\n1530\t  (let [o (outcome r)]\n1531\t    (case o\n1532\t      :dao.stream/ok\n1533\t      (let [v (:dao.stream/value r)\n1534\t            id (when (map? v) (:yin.link/id v))\n1535\t            entry (assoc entry :cursor (:dao.stream/cursor r))]\n1536\t        (if (= id (:link-id entry))\n1537\t          (into [:done] (settle state entry v))\n1538\t          [:skipped (skip state entry id) entry]))\n1539\t      :dao.stream/blocked [:done state entry nil]"}]},"parent_tool_use_id":null,"session_id":"ee657710-cc1c-4c43-882b-5874c9a79051","uuid":"8008f9a6-1c1b-48dd-a406-bd456ca9e1e7","timestamp":"2026-10-12T15:55:51.265Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6b/src/cljc/yin/vm/engine.cljc","content":"                                    ;; the composition mints each task's\n                                    ;; secret (r10); without a source the\n                                    ;; child can issue no reference\n                                    :capability-secret\n                                    (when (fn? source) (source origin))})\n        child (reduce (fn [c [m entry]] (receive-module c m entry))\n                      child\n                      (linked-entries registry))]\n    [(stamp-gate child (vm/gate-mode state)) (assoc state :origins (inc n))]))\n\n\n(defn- wake-installed\n  \"Move every `:install` wait entry naming `module-name` to the ready\n   queue, woken with `value`, or with `refusal` raised.\"\n  [state module-name value refusal]\n  (let [waiter? (fn [e]\n                  (and (= :install (:reason e)) (= module-name (:name e))))\n        waiters (filter waiter? (:wait-set state))]\n    (-> state\n        (update :wait-set (fn [ws] (filterv (complement waiter?) ws)))\n        (update :ready-queue (fnil into [])\n                (map (fn [e]\n                       (if refusal (refused-entry e refusal) (ready e value))))\n                waiters))))\n\n\n(defn- refuse-install\n  \"`refused` (section 7.3): nothing from the child's store is published,\n   every waiter is restored with the refusal as the effect's error, and\n   the install entry is removed so a later require may try again.\"\n  [state module-name refusal]\n  (-> state\n      (update :installs dissoc module-name)\n      (wake-installed module-name nil refusal)))\n\n\n(defn- verified-images\n  \"Every image this scheduler verified that the child's slice may name as\n   an origin: the install's own, and those held by identity under the\n   registry of the child or of the receiving task (section 7.3, act 2).\"\n  [state child response]\n  (into [(:value (:image response))]\n        (mapcat (fn [[_ entry]] (vals (:images entry))))\n        (concat (linked-entries (:modules child))\n                (linked-entries (:modules state)))))\n\n\n(defn- link-install\n  \"`validated` then `linked` (section 7.3): the child reached halt; every\n   export must be a key of its store (`:export-missing`); the slice is\n   lifted (act 1) and its origins checked against the images this\n   scheduler verified (act 2, `:foreign-image`); the receiving task then\n   receives, first, the entry -- its store snapshots win over the plain\n   registry snapshot of a dependency, since the child's mutations are\n   what the slice carries -- and then every module the child linked that\n   it lacks (acts 3 and 4), and every waiter is restored with the name.\n   A response that rode on an admission allow records it on the entry\n   under `:admission`.\"\n  [state module-name {:keys [vm response]}]\n  (let [manifest (:manifest response)\n        address (manifest-address response)\n        exports (sort-by str (:yin.module/exports manifest))\n        missing (vec (remove #(contains? (:store vm) %) exports))]\n    (if (seq missing)\n      (refuse-install state module-name\n                      {:status :refused,\n                       :reason :export-missing,\n                       :module module-name,\n                       :names missing})\n      (let [lifted (try (lift-slice vm address exports)\n                        (catch #?(:cljd Object :clj Throwable :cljs :default) e\n                          {:refusal (error-refusal module-name e)}))]\n        (if-let [refusal (:refusal lifted)]\n          (refuse-install state module-name refusal)\n          (let [verified (verified-images state vm response)\n                origin-of (fn [seg]\n                            (some #(when (module/image-holds? vm % seg) %)\n                                  verified))\n                foreign (first (remove origin-of\n                                       (sort-by str (:origins lifted))))]\n            (if (some? foreign)\n              (refuse-install state module-name\n                              {:status :refused,\n                               :reason :foreign-image,\n                               :module module-name,\n                               :segment foreign})\n              (let [images (into {}\n                                 (map (fn [seg]\n                                        (let [img (origin-of seg)]\n                                          [(module/image-identity vm img)\n                                           img])))\n                                 (:origins lifted))\n                    entry (module/module-entry\n                            (:modules (module/link-module\n                                        nil manifest (:derivation response)\n                                        (assoc lifted :images images)))\n                            module-name)\n                    ;; the admission the link rode on (yin.vm.linker.dht.md\n                    ;; 7.5): inherited and transferred with the entry\n                    entry (cond-> entry\n                            (= :allow (:yin.admit/decision response))\n                            (assoc :admission\n                                   (select-keys response\n                                                [:yin.admit/id\n                                                 :yin.admit/decision\n                                                 :yin.admit/asserters\n                                                 :yin.admit/address])))\n                    received (receive-module state module-name entry)\n                    received (reduce\n                               (fn [s [m dep]]\n                                 (if (some? (module/module-entry\n                                              (:modules (:modules s)) m))\n                                   s\n                                   (receive-module s m (dissoc dep :bindings))))\n                               received\n                               (linked-entries (:modules vm)))]\n                (-> received\n                    (update :installs dissoc module-name)\n                    (wake-installed module-name module-name nil))))))))))\n\n\n(defn- advance-install\n  \"Step the install child of `module-name` in this round, beside every\n   other task (section 7.3): `running` runs it until it halts or parks.\n   A parked child stays `parked`; a halted one goes on to `validated`; an\n   error refuses the install. An error while publishing -- attaching an\n   origin image, lowering the slice or a store snapshot, or receiving a\n   dependency -- refuses it too, at phase `:linked`, from the state the\n   round started with: nothing half-published survives, every waiter is\n   restored with the refusal, and no throw leaves the round.\n\n   Under a custody gate the child is stamped with the root's mode before\n   it runs; in `:exporting` and `:ended` it does not run.\"\n  [state module-name]\n  (let [inst (get-in state [:installs module-name])\n        mode (vm/gate-mode state)\n        [child refusal]\n        (when-not (contains? #{:exporting :ended} mode)\n          (try [(vm/run (stamp-gate (:vm inst) mode)) nil]\n               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n                 [nil (error-refusal module-name e)])))]\n    (cond\n      (and (nil? child) (nil? refusal)) state\n      refusal (refuse-install state module-name refusal)\n      (:blocked? child)\n      (assoc-in state [:installs module-name]\n                (assoc inst :vm child :phase :parked))\n      (:halted? child)\n      (try (link-install state module-name (assoc inst :vm child))\n           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n             (refuse-install state module-name\n                             (assoc (error-refusal module-name e)\n                                    :phase :linked))))\n      :else (assoc-in state [:installs module-name]\n                      (assoc inst :vm child :phase :running)))))\n\n\n(defn- advance-installs\n  [state]\n  (reduce advance-install state (sort-by str (keys (:installs state)))))\n\n\n(defn- start-install\n  \"`loading`: spawn the child, or refuse on a loader defect. Returns\n   `[state refusal]`.\"\n  [state module-name response link-id]\n  (try\n    (let [[child state] (spawn-child state module-name response)]\n      [(assoc-in state [:installs module-name]\n                 {:phase :running, :vm child, :parent link-id,\n                  :response response})\n       nil])\n    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n      [state (assoc (error-refusal module-name e) :phase :loading)])))\n\n\n(defn- settle\n  \"Act on the response correlated with `entry`: a refusal (or loss) is\n   raised as the effect's error; `:ok` runs step 5b against the live\n   state and, discharged, starts the install child, the entry becoming\n   an `:install` waiter. A module linked or installing meanwhile answers\n   or joins instead, and a manifest naming another module than the one\n   required is `:module-name-mismatch`, never installed. Returns `[state\n   waiting woken]`.\"\n  [state entry response]\n  (let [state (retire state (:link-id entry) :restored)\n        module-name (:name entry)\n        waiter (-> entry\n                   (dissoc :envelope :request :response :cursor :link-id)\n                   (assoc :reason :install))]\n    (cond\n      (not= :ok (:status response))\n      [state nil (refused-entry entry response)]\n\n      (some? (module/resolve-module (:modules state) module-name))\n      [state nil (ready entry module-name)]\n\n      (contains? (:installs state) module-name) [state waiter nil]\n\n      ;; the linker checks the name (section 8.1); a response that names\n      ;; another module is never installed under this one\n      (not= module-name (get-in response [:manifest :yin.module/name]))\n      [state nil\n       (refused-entry entry\n                      (linker/refused :module-name-mismatch\n                                      {:requested module-name,\n                                       :manifest (get-in\n                                                   response\n                                                   [:manifest\n                                                    :yin.module/name])}))]\n\n      :else\n      (if-let [refusal (discharge-defect state response)]\n        [state nil (refused-entry entry refusal)]\n        (let [[state refusal] (start-install state module-name response\n                                             (:link-id entry))]\n          (if refusal\n            [state nil (refused-entry entry refusal)]\n            [state waiter nil]))))))\n\n\n(defn- link-read-step\n  \"Apply one read outcome `r` to the `:link-response` `entry`, whose\n   `:cursor` is the position the read was made at (section 7.2, step 7):\n   an `ok` carrying another id's response advances the cursor and skips\n   it, `[:skipped state entry]`; every other result is final,\n   `[:done state waiting woken]`. An `ok` with the entry's own id settles;\n   `blocked` keeps waiting; `gap` and the terminal outcomes are raised as\n   the effect's error.\"\n  [state entry r]\n  (let [o (outcome r)]\n    (case o\n      :dao.stream/ok\n      (let [v (:dao.stream/value r)\n            id (when (map? v) (:yin.link/id v))\n            entry (assoc entry :cursor (:dao.stream/cursor r))]\n        (if (= id (:link-id entry))\n          (into [:done] (settle state entry v))\n          [:skipped (skip state entry id) entry]))\n      :dao.stream/blocked [:done state entry nil]","numLines":240,"startLine":1300,"totalLines":2789}},"tool_result_meta":[{"id":"toolu_016KuN5NNAupBXxc8VKLwZdj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
