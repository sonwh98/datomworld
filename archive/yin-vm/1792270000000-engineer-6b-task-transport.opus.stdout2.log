set m1)) (get-in m1 [:installs 'host.mod :phase])))))","+  (let [m (:machine (h/bare 17))]","+    (prn :resolve (module/resolve-module (:modules m) 'host.mod.f))","+    (prn :entries (keys (:modules (:modules m))))","+    (prn :entry (some-> (module/module-entry (:modules (:modules m)) 'host.mod) keys))","+    (prn :stores (keys (:module-stores m)) (some-> (get (:module-stores m) 'host.mod) keys))))"]}],"originalFile":"(ns scratch.probe-test\n  (:require [clojure.test :refer [deftest]]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.semantic-register :as sr]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n(defn machine\n  [opts]\n  (sr/create-vm (merge {:make-stream tu/make-stream :capability-secret tu/secret\n                        :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))\n                        :modules (module/register-stream-module (module/default-registry))}\n                       opts)))\n\n\n(defn response\n  [body]\n  {:status :ok :image {:value (:vector (linearize/project body))}\n   :manifest {:yin.module/name 'host.mod :yin.module/exports #{'f}} :obligations []})\n\n\n(defn installing\n  [body]\n  (let [rq (s/ring 64) rs (s/ring 64)\n        m0 (vm/run (sr/load-vector (machine {:link-request rq :link-response rs})\n                                   (:vector (linearize/project (s/app (s/v 'require) (s/lit 'host.mod)))) code/contract))\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! rs (assoc (response body) :yin.link/id id))\n        swept (engine/check-wait-set m0)\n        _ (prn :swept (mapv :reason (:wait-set swept)) (count (:ready-queue swept))\n               (get-in swept [:installs 'host.mod :phase])\n               (mapv :reason (get-in swept [:installs 'host.mod :vm :wait-set]))\n               (get-in swept [:installs 'host.mod :vm :control]))\n        m1 (vm/run m0)]\n    m1))\n\n\n(deftest probe\n  (let [blocking (s/let1 's {:type :stream/make :buffer 4}\n                         (s/then (s/next-of (s/cursor-of (s/v 's))) (s/def! 'f (s/lam [] (s/lit 42)))))\n        m1 (installing blocking)\n        inst (get-in m1 [:installs 'host.mod])]\n    (prn :blocking (mapv :reason (:wait-set m1)) (:phase inst) (:blocked? (:vm inst)) (:halted? (:vm inst)))\n    (let [m2 (vm/run m1) inst (get-in m2 [:installs 'host.mod])]\n      (prn :again (mapv :reason (:wait-set m2)) (:phase inst))))\n  (doseq [body [(s/then (s/def! 'f (s/lam [] (s/lit 42))) {:type :vm/park})\n                (s/then {:type :vm/park} (s/def! 'f (s/lam [] (s/lit 42))))]]\n    (let [m1 (try (installing body) (catch Exception e (ex-data e)))]\n      (prn :park (if (map? m1) (select-keys m1 [:value :halted? :blocked?]) m1)\n           (mapv :reason (:wait-set m1)) (get-in m1 [:installs 'host.mod :phase])))))\n","userModified":false},"tool_result_meta":[{"id":"toolu_01UC5jXLfPSK7NUdDJoVTWBv","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
