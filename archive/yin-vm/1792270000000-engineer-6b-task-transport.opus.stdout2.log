{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ej93rwWgxMzJR3JtxeHrCA","type":"tool_result","content":"1\t(ns yin.vm.ucf.rows\n2\t  \"Version-3 row codec. Pure row construction, graph decoding and\n3\t   discovery-order cursor-cell numbering (design note §1); no machine\n4\t   attachment, dependency scanner or transport.\n5\t   An abstract row is {:kind keyword :slots vector}. Structural references\n6\t   contain abstract rows; values use [:lit d], [:row abstract-row], [:cursor-cell id].\n7\t   A task's :cursor-cells row holds alternating source identities and :cursor-cell-body\n8\t   rows. Install children are separate tasks with separate cursor-cell scopes.\n9\t\n10\t   The census is ordered numerically by n (draft §3, \\\"sorted by n\\\"), so\n11\t   :yin.k/cc-10 follows :yin.k/cc-9; its keys must spell cc-N with no leading\n12\t   zero, else :slot-kind.\n13\t\n14\t   Default value markers are plain maps {:yin.k/row abstract-row} and\n15\t   {:yin.k/cursor-cell keyword}. A guest map whose sole key is :yin.k/row or\n16\t   :yin.k/cursor-cell collides with them and is not portable: on encode and decode\n17\t   every literal of that shape is refused :yin.k/non-portable. Explicit\n18\t   markers use the caller value encoder.\"\n19\t  (:require [dao.jing :as jing]\n20\t            [dao.jing.cbor :as cbor]\n21\t            [yin.vm.semantic-register.code :as code]\n22\t            [yin.vm.semantic-register.frame :as frame]))\n23\t\n24\t\n25\t(def profile {:yin.code/contract \"v4\" :yin.k/version 1})\n26\t\n27\t\n28\t(def pending-table\n29\t  {:next [:C]\n30\t   :put [[:ref :stream] :V :D]\n31\t   :ffi [:C :D :D]\n32\t   :ffi-request [:D :V [:ref :stream] [:ref :stream] :C :D]\n33\t   :link-request [:D :S [:ref :stream] [:ref :stream] :C :D :D]\n34\t   :link-response [:D :S [:ref :stream] [:ref :stream] :C]\n35\t   :install [:S]})\n36\t\n37\t\n38\t(def row-table\n39\t  \"Slot descriptors, excluding id and kind. :repeat/:pairs are variadic;\n40\t   :refs is an ordered vector of structural references. :pending is\n41\t   discriminated by pending-table. Nothing in this table is executable.\"\n42\t  {:vec [:repeat :V] :list [:repeat :V] :set [:repeat :V]\n43\t   :map [:pairs :V :V] :bindings [:pairs :S :V] :store [:pairs :D :V]\n44\t   :env [[:ref :bindings] :optional-D]\n45\t   :closure [:A :N :syms [:ref :bindings] :optional-D]\n46\t   :prim [:S] :stream [:D :D] :reified [[:ref :act]] :parked-ref [:D]\n47\t   :act [:A :N [:ref :env] [:ref :window] [:ref :k] :N]\n48\t   :tail [:A :N [:ref :k]]\n49\t   :window [:pairs :N :V] :k [:repeat [:ref :kframe]]\n50\t   :kframe [:A :N [:ref :env] [:ref :window] :N]\n51\t   :wait [[:ref :act :tail] [:ref :pending]] :pending :pending\n52\t   :module-store [:D [:ref :store]]\n53\t   :parked-table [:pairs :D [:ref :act :tail]]\n54\t   :install [:S :D :D :D [:ref :task]]\n55\t   :cursor-cells [:pairs :C [:ref :cursor-cell-body]] :cursor-cell-body [[:ref :stream] :D]\n56\t   :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n57\t          [:refs :module-store] [:ref :parked-table] [:ref :cursor-cells]\n58\t          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n59\t\n60\t\n61\t(defn node\n62\t  [kind slots]\n63\t  {:kind kind :slots (if (= :window kind)\n64\t                       (vec (mapcat identity (sort-by first (partition 2 slots))))\n65\t                       (vec slots))})\n66\t\n67\t\n68\t(defn- refuse!\n69\t  [status kind path]\n70\t  (throw (ex-info \"Row codec refused data\"\n71\t                  {:yin.k/status status :yin.k/kind kind :yin.k/path path})))\n72\t\n73\t\n74\t(defn- bad!\n75\t  [kind path]\n76\t  (refuse! :yin.k/undecodable kind path))\n77\t\n78\t\n79\t(defn- marker-shaped?\n80\t  [x]\n81\t  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cursor-cell))))\n82\t\n83\t\n84\t(defn- check-literal-markers!\n85\t  [x]\n86\t  (when (marker-shaped? x) (refuse! :yin.k/non-portable :marker []))\n87\t  (when (coll? x)\n88\t    (doseq [v (if (map? x) (mapcat identity x) x)] (check-literal-markers! v)))\n89\t  (when (meta x) (check-literal-markers! (meta x))))\n90\t\n91\t\n92\t(defn- bytes-key\n93\t  [bs]\n94\t  ;; Unsigned bytewise order, without a length-first comparison.\n95\t  (mapv #(bit-and (int %) 255) (seq bs)))\n96\t\n97\t\n98\t(defn- compare-bytes\n99\t  [a b]\n100\t  (loop [i 0]\n101\t    (cond\n102\t      (= i (count a)) (if (= i (count b)) 0 -1)\n103\t      (= i (count b)) 1\n104\t      (= (nth a i) (nth b i)) (recur (inc i))\n105\t      :else (compare (nth a i) (nth b i)))))\n106\t\n107\t\n108\t(defn- byte-compare\n109\t  [a b]\n110\t  (compare-bytes (bytes-key (cbor/encode a)) (bytes-key (cbor/encode b))))\n111\t\n112\t\n113\t(defn- sorted-bytes\n114\t  [xs]\n115\t  (vec (sort byte-compare xs)))\n116\t\n117\t\n118\t(defn- descriptors\n119\t  [kind slots]\n120\t  ;; :entry is the numbering's synthetic map entry [:entry k v], never a carrier row.\n121\t  (let [schema (if (= :entry kind) [:V :V] (get row-table kind))]\n122\t    (cond\n123\t      (= schema :pending) (into [:D] (get pending-table (first slots)))\n124\t      (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n125\t      (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n126\t      :else schema)))\n127\t\n128\t\n129\t(defn- ref?\n130\t  [d]\n131\t  (and (vector? d) (= :ref (first d))))\n132\t\n133\t\n134\t(defn- refs?\n135\t  [d]\n136\t  (and (vector? d) (= :refs (first d))))\n137\t\n138\t\n139\t(def ^:private census-key #\"cc-([1-9][0-9]*)\")\n140\t\n141\t\n142\t(defn- census-order\n143\t  ;; Numeric order of cc-N without reading wire data: fewer digits first,\n144\t  ;; then the digits. Other keys (a partial emit-numbered) sort last.\n145\t  [k]\n146\t  (let [digits (when (keyword? k) (second (re-matches census-key (name k))))]\n147\t    (if digits [0 (count digits) digits] [1 0 (str k)])))\n148\t\n149\t\n150\t(defn- ordered-slots\n151\t  [kind slots]\n152\t  (cond\n153\t    (= kind :window) (vec (mapcat identity (sort-by first (partition 2 slots))))\n154\t    (= kind :cursor-cells) (vec (mapcat identity (sort-by #(census-order (first %)) (partition 2 slots))))\n155\t    (contains? #{:map :bindings :store :parked-table} kind)\n156\t    (vec (mapcat identity (sort #(byte-compare (first %1) (first %2)) (partition 2 slots))))\n157\t    (= kind :set) (sorted-bytes slots)\n158\t    :else slots))\n159\t\n160\t\n161\t(def default-budget\n162\t  \"Local resource bounds, independent of canonical bytes. :work counts the\n163\t   numbering's positions and the representation bound of every value it\n164\t   encodes for a comparison (design note §1.5).\"\n165\t  {:rows 10000 :cursor-cells 64 :depth 256 :work 4194304 :bytes 16777216})\n166\t\n167\t\n168\t(declare emit-node canonical-numbering child-numberer validate-frames)\n169\t\n170\t\n171\t(defn- emit-slot\n172\t  [d x numbering rows path number-child]\n173\t  (when-not (or (ref? d) (refs? d) (= :C d))\n174\t    (check-literal-markers! (if (contains? #{:V :optional-V} d)\n175\t                              (when (= :lit (first x)) (second x)) x)))\n176\t  (cond\n177\t    (ref? d) (emit-node x numbering rows path number-child)\n178\t    (refs? d) (reduce (fn [[out rs] [j n]]\n179\t                        (let [p (conj path (if (= :install (:kind n)) (first (:slots n)) j))\n180\t                              [id rs'] (emit-node n numbering rs p number-child)]\n181\t                          [(conj out id) rs']))\n182\t                      [[] rows] (map-indexed vector x))\n183\t    (= d :C) [(get numbering x x) rows]\n184\t    (contains? #{:V :optional-V} d)\n185\t    (case (first x)\n186\t      :row (let [[id rs] (emit-node (second x) numbering rows path number-child)] [[:row id] rs])\n187\t      :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n188\t      [x rows])\n189\t    :else [x rows]))\n190\t\n191\t\n192\t(defn- emit-node\n193\t  ;; path is the row path of n, so a child's refusal reports [12 <install name> ...].\n194\t  ([n numbering rows] (emit-node n numbering rows [] (child-numberer default-budget)))\n195\t  ([n numbering rows path number-child]\n196\t   (let [{:keys [kind slots]} n\n197\t         ;; A child is canonicalized in its own identity scope.\n198\t         [slots rows] (reduce (fn [[out rs] [i d x]]\n199\t                                (if (and (ref? d) (= :task (:kind x)))\n200\t                                  (let [[id child-rows] (emit-node x (number-child x path) {} path number-child)]\n201\t                                    [(conj out id) (merge rs child-rows)])\n202\t                                  (let [[x' rs'] (emit-slot d x numbering rs (conj path i) number-child)]\n203\t                                    [(conj out x') rs'])))\n204\t                              [[] rows] (map vector (range) (descriptors kind slots) slots))\n205\t         slots (if (= kind :task)\n206\t                 (-> slots\n207\t                     (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n208\t                     (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n209\t                 (ordered-slots kind slots))\n210\t         body (into [kind] slots) id (jing/segment-key body)]\n211\t     [id (assoc rows id (into [id] body))])))\n212\t\n213\t\n214\t(defn- spend!\n215\t  [counter budget category amount]\n216\t  (let [n (get (swap! counter update category (fnil + 0) amount) category)]\n217\t    (when (> n (get budget category))\n218\t      (refuse! :yin.k/unsupported :resource-limit [category]))))\n219\t\n220\t\n221\t;; Discovery-order cursor-cell numbering (design note\n222\t;; yin.vm.semantic-register-vm.cursor-cell-numbering.md §1). A cursor cell is\n223\t;; named by the order in which a fixed pre-order walk of the task meets it. A\n224\t;; guest :set or :map is entered as the vector of its members sorted by key:\n225\t;; the member's spelling by a key walk, numbered cursor cells by number and\n226\t;; the others by local first-occurrence index, body rank and occurrence\n227\t;; count. Members with equal keys form a tie group, postponed and re-keyed\n228\t;; until a pass numbers nothing; a surviving group is entered in host order\n229\t;; only when the tie test proves that harmless, else the lift refuses\n230\t;; :unresolved-cursor-cells.\n231\t\n232\t\n233\t(defn- work!\n234\t  [ctx amount]\n235\t  (spend! (:counter ctx) (:budget ctx) :work amount))\n236\t\n237\t\n238\t(defn- charge-representation!\n239\t  \"Charge to :work, before x is CBOR-encoded for a comparison, a conservative\n240\t   bound of its representation: 128 per node or scalar, 4 per character, 16\n241\t   plus the length per byte payload, metadata included. Iterative, against\n242\t   the budget remaining at the call: it stops as soon as its running total\n243\t   exceeds that, so it never reads to the end of a value it cannot afford.\"\n244\t  [ctx x]\n245\t  (let [{:keys [counter budget]} ctx\n246\t        remaining (- (:work budget) (get @counter :work 0))]\n247\t    (loop [stack (list (list x)) total 0 steps 0]\n248\t      (if (empty? stack)\n249\t        (do (swap! counter update :estimator-steps (fnil + 0) steps)\n250\t            (work! ctx total))\n251\t        (let [s (first stack) stack (rest stack)]\n252\t          (if (empty? s)\n253\t            (recur stack total steps)\n254\t            (let [x (first s)\n255\t                  stack (cons (rest s) stack)\n256\t                  total (+ total (cond\n257\t                                   (cbor/byte-payload? x) (+ 16 #?(:cljd (.-length x) :default (alength x)))\n258\t                                   (string? x) (+ 128 (* 4 (count x)))\n259\t                                   (or (keyword? x) (symbol? x)) (+ 128 (* 4 (count (str x))))\n260\t                                   :else 128))]\n261\t              (if (> total remaining)\n262\t                (do (swap! counter update :estimator-steps (fnil + 0) (inc steps))\n263\t                    (work! ctx total))\n264\t                (recur (cond->> stack\n265\t                         (coll? x) (cons (if (map? x) (mapcat identity x) (seq x)))\n266\t                         (meta x) (cons (list (meta x))))\n267\t                       total (inc steps))))))))))\n268\t\n269\t\n270\t(defn- key-bytes!\n271\t  \"Every comparison encoding of the numbering: charged, then encoded.\"\n272\t  [ctx x]\n273\t  (charge-representation! ctx x)\n274\t  (bytes-key (cbor/encode x)))\n275\t\n276\t\n277\t(defn- sort-by-key!\n278\t  \"xs in the bytewise order of (f x), each encoded once.\"\n279\t  [ctx f xs]\n280\t  (mapv second (sort #(compare-bytes (first %1) (first %2))\n281\t                     (mapv (fn [x] [(key-bytes! ctx (f x)) x]) xs))))\n282\t\n283\t\n284\t(def ^:private keyed-structural #{:bindings :store :parked-table})\n285\t\n286\t\n287\t(defn- value-slot?\n288\t  [d]\n289\t  (contains? #{:V :optional-V} d))\n290\t\n291\t\n292\t(defn- child-task?\n293\t  [ctx n]\n294\t  (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n295\t\n296\t\n297\t(defn- elem-item\n298\t  ;; A :set member is its V; a :map entry is the synthetic ordered row\n299\t  ;; [:entry k v], so the alias pattern across key and value is in its key.\n300\t  [kind e]\n301\t  (if (= :map kind) [:row (node :entry e)] e))\n302\t\n303\t\n304\t(defn- depth-scan!\n305\t  \"The :depth gate, before any recursive traversal of the task: one pre-order\n306\t   scan with an explicit stack over rows, members, structural and literal\n307\t   data and the census, install children skipped (each is gated by its own\n308\t   numbering). A position's depth is its slot steps from the task (a member\n309\t   step counts one, a map entry's key or value two) plus, inside data, its\n310\t   collection nesting. Each position costs one :work unit, charged when it\n311\t   is popped, before any work proportional to it.\"\n312\t  [ctx task]\n313\t  (let [limit (:depth (:budget ctx))\n314\t        row (fn [n k] [:row nil n k])\n315\t        slot (fn [d v k] [:slot d v k])\n316\t        data (fn [v k] [:data nil v k])]\n317\t    (loop [stack (list (list (row task 0)))]\n318\t      (when (seq stack)\n319\t        (let [s (first stack) stack (rest stack)]\n320\t          (if (empty? s)\n321\t            (recur stack)\n322\t            (let [[tag d x k] (first s)\n323\t                  stack (cons (rest s) stack)]\n324\t              (work! ctx 1)\n325\t              (when (> k limit) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n326\t              (recur\n327\t                (cons\n328\t                  (case tag\n329\t                    :row\n330\t                    (let [{:keys [kind slots]} x k' (inc k)]\n331\t                      (when-not (child-task? ctx x)\n332\t                        (let [ds (descriptors kind slots)]\n333\t                          (cond\n334\t                            (= :task kind)\n335\t                            (mapcat (fn [i d v]\n336\t                                      (if (contains? #{7 12} i)\n337\t                                        (map (fn [child] (row child (inc k'))) v)\n338\t                                        [(slot d v k')]))\n339\t                                    (range) ds slots)\n340\t                            (contains? keyed-structural kind)\n341\t                            (mapcat (fn [[key v]] [(data key k') (slot (second ds) v k')]) (partition 2 slots))\n342\t                            (= :window kind)\n343\t                            (mapcat (fn [[r v]] [(data r k') (slot :V v k')]) (partition 2 slots))\n344\t                            (= :set kind) (map (fn [v] (slot :V v k')) slots)\n345\t                            (= :map kind)\n346\t                            (mapcat (fn [[a b]] [(slot :V a (inc k')) (slot :V b (inc k'))]) (partition 2 slots))\n347\t                            :else (map (fn [d v] (slot d v k')) ds slots)))))\n348\t                    :slot\n349\t                    (cond\n350\t                      (ref? d) [(row x k)]\n351\t                      (refs? d) (map (fn [n] (row n (inc k))) x)\n352\t                      (= :C d) nil\n353\t                      (value-slot? d) (when x\n354\t                                        (case (first x)\n355\t                                          :cursor-cell nil\n356\t                                          :row [(row (second x) k)]\n357\t                                          :lit [(data (second x) k)]\n358\t                                          [(data x k)]))\n359\t                      :else [(data x k)])\n360\t                    :data\n361\t                    (concat (when (coll? x) (map (fn [e] (data e (inc k))) (if (map? x) (mapcat identity x) x)))\n362\t                            (when (meta x) [(data (meta x) (inc k))])))\n363\t                  stack)))))))))\n364\t\n365\t\n366\t(defn- walk-cells\n367\t  \"Call f on the cursor cell at every position under slot (d x), the census\n368\t   and install children excluded; one :work unit per position. Recursive,\n369\t   so it runs only after the depth scan.\"\n370\t  [ctx d x f]\n371\t  (letfn [(slot\n372\t            [d x]\n373\t            (work! ctx 1)\n374\t            (cond\n375\t              (ref? d) (row x)\n376\t              (refs? d) (doseq [n x] (row n))\n377\t              (= :C d) (f x)\n378\t              (value-slot? d) (when x\n379\t                                (case (first x)\n380\t                                  :cursor-cell (f (second x))\n381\t                                  :row (row (second x))\n382\t                                  nil))\n383\t              :else nil))\n384\t          (row\n385\t            [n]\n386\t            (when-not (or (= :cursor-cells (:kind n)) (child-task? ctx n))\n387\t              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))] (slot d x))))]\n388\t    (slot d x)))\n389\t\n390\t\n391\t(defn- item-cells\n392\t  \"The cursor cells under slot (d x), memoized per numbering on the slot.\"\n393\t  [ctx d x]\n394\t  (or (get @(:cells-memo ctx) [d x])\n395\t      (let [acc (atom #{})]\n396\t        (walk-cells ctx d x #(swap! acc conj %))\n397\t        (swap! (:cells-memo ctx) assoc [d x] @acc)\n398\t        @acc)))\n399\t\n400\t\n401\t(defn- body-ranks\n402\t  \"Cursor cell -> rank of its body label [:body [:stream identity\n403\t   descriptor] position] among the census's distinct labels in bytewise\n404\t   order, so a key never repeats a descriptor.\"\n405\t  [ctx bodies]\n406\t  (let [labels (into {} (map (fn [[c b]]\n407\t                               (let [[stream position] (:slots b)]\n408\t                                 [c [:body (into [:stream] (:slots stream)) position]])))\n409\t                     bodies)\n410\t        ranks (into {} (map-indexed (fn [i l] [l i]) (sort-by-key! ctx identity (distinct (vals labels)))))]\n411\t    (into {} (map (fn [[c l]] [c (get ranks l)])) labels)))\n412\t\n413\t\n414\t(defn- new-run\n415\t  [ctx num tag start]\n416\t  {:ctx ctx :num (atom num) :tag tag :next (atom start)\n417\t   :groups (atom []) :gid (atom 0) :refused (atom nil)})\n418\t\n419\t\n420\t(defn- meet!\n421\t  \"W2: a cursor cell met for the first time receives the run's next number.\"\n422\t  [run c]\n423\t  (when-not (contains? @(:num run) c)\n424\t    (swap! (:num run) assoc c [(:tag run) @(:next run)])\n425\t    (swap! (:next run) inc)))\n426\t\n427\t\n428\t(declare enter-node! unordered! key-walk spell-slot spell-node)\n429\t\n430\t\n431\t(defn- enter-slot!\n432\t  [run d x path]\n433\t  (let [ctx (:ctx run)]\n434\t    (work! ctx 1)\n435\t    (when (> (count path) (:depth (:budget ctx)))\n436\t      (refuse! :yin.k/unsupported :resource-limit [:depth]))\n437\t    (cond\n438\t      (ref? d) (enter-node! run x path)\n439\t      (refs? d) (doseq [[i n] (map-indexed vector x)] (enter-node! run n (conj path i)))\n440\t      (= :C d) (meet! run x)\n441\t      (value-slot? d) (when x\n442\t                        (case (first x)\n443\t                          :cursor-cell (meet! run (second x))\n444\t                          :row (enter-node! run (second x) path)\n445\t                          nil))\n446\t      :else nil)))\n447\t\n448\t\n449\t(defn- enter-node!\n450\t  \"W1: pre-order in table order; ordered repeated slots in order; keyed\n451\t   structural rows, installs and module stores in the byte order of the\n452\t   key; :window in register order; :set and :map by member keys, ties\n453\t   postponed; the census and install children are not entered.\"\n454\t  [run n path]\n455\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n456\t    (cond\n457\t      (or (= :cursor-cells kind) (child-task? ctx n)) nil\n458\t      (= :task kind)\n459\t      (doseq [[i d x] (map vector (range) ds slots)]\n460\t        (if (contains? #{7 12} i)\n461\t          (doseq [child (sort-by-key! ctx #(first (:slots %)) x)]\n462\t            (enter-node! run child (conj path i (first (:slots child)))))\n463\t          (enter-slot! run d x (conj path i))))\n464\t      (contains? keyed-structural kind)\n465\t      (doseq [[k v] (sort-by-key! ctx first (partition 2 slots))]\n466\t        (enter-slot! run (second ds) v (conj path k)))\n467\t      (= :window kind)\n468\t      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n469\t      (= :set kind) (unordered! run n :set (vec slots) path)\n470\t      (= :map kind) (unordered! run n :map (mapv vec (partition 2 slots)) path)\n471\t      :else (doseq [[i d x] (map vector (range) ds slots)] (enter-slot! run d x (conj path i))))))\n472\t\n473\t\n474\t(defn- unordered!\n475\t  \"Key every member by a key walk under the numbering at this moment; enter\n476\t   members with a unique key in key order and postpone each run of equal\n477\t   keys, a tie group, to the run's queue. A member's path is the\n478\t   container's path plus :member: no index into an unordered container is\n479\t   canonical.\"\n480\t  [run container kind elems path]\n481\t  (let [ctx (:ctx run)\n482\t        keyed (mapv (fn [e]\n483\t                      ;; One unit per member keyed, so key walks and memo lookups are charged.\n484\t                      (work! ctx 1)\n485\t                      [(key-walk run (elem-item kind e) (conj path :member)) e])\n486\t                    elems)\n487\t        groups (partition-by (comp :bytes first)\n488\t                             (sort #(compare-bytes (:bytes (first %1)) (:bytes (first %2))) keyed))]\n489\t    (doseq [g groups]\n490\t      (if (= 1 (count g))\n491\t        (enter-slot! run :V (elem-item kind (second (first g))) (conj path :member))\n492\t        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :container container :kind kind :path path\n493\t                                   :key (:spell (first (first g))) :complete? (:complete? (first (first g)))\n494\t                                   :elems (mapv second g)})))))\n495\t\n496\t\n497\t(defn- fixpoint!\n498\t  \"W3: re-key the postponed groups under the current numbering, in queue\n499\t   order; repeat while a pass numbers a cursor cell and groups remain.\"\n500\t  [run]\n501\t  (loop []\n502\t    (let [before (count @(:num run)) groups @(:groups run)]\n503\t      (reset! (:groups run) [])\n504\t      (doseq [{:keys [container kind elems path]} groups] (unordered! run container kind elems path))\n505\t      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n506\t\n507\t\n508\t(defn- unnumbered-cells\n509\t  [run kind e]\n510\t  (let [num @(:num run)]\n511\t    (set (remove #(contains? num %) (item-cells (:ctx run) :V (elem-item kind e))))))\n512\t\n513\t\n514\t(defn- tie-failure\n515\t  \"The tie test, nil when the group passes: its common key is complete, and\n516\t   its members' unnumbered cursor cells are pairwise disjoint and occur in\n517\t   no member of another surviving group.\"\n518\t  [run groups g]\n519\t  (let [own (mapv #(unnumbered-cells run (:kind g) %) (:elems g))\n520\t        others (reduce (fn [acc h]\n521\t                         (if (= (:id h) (:id g))\n522\t                           acc\n523\t                           (reduce #(into %1 (unnumbered-cells run (:kind h) %2)) acc (:elems h))))\n524\t                       #{} groups)]\n525\t    (cond\n526\t      (not (:complete? g)) :incomplete-key\n527\t      (not= (reduce + (map count own)) (count (reduce into #{} own))) :shared-within-group\n528\t      (some (fn [cells] (some #(contains? others %) cells)) own) :shared-across-groups\n529\t      :else nil)))\n530\t\n531\t\n532\t(defn- resolve!\n533\t  \"The postponed groups to completion: the fixpoint, then the tie test on\n534\t   every surviving group. All pass: enter them in host order and repeat. Any\n535\t   fails: the root walk refuses; a key walk leaves them as [:tie ...] residue.\"\n536\t  [run]\n537\t  (loop []\n538\t    (fixpoint! run)\n539\t    (let [groups @(:groups run)]\n540\t      (when (seq groups)\n541\t        (let [failing (filterv #(tie-failure run groups %) groups)]\n542\t          (cond\n543\t            (empty? failing)\n544\t            ;; Passing groups are independent (their cursor cells are\n545\t            ;; confined), so all are entered before the next pass.\n546\t            (do (reset! (:groups run) [])\n547\t                (doseq [g groups e (:elems g)]\n548\t                  (enter-slot! run :V (elem-item (:kind g) e) (conj (:path g) :member)))\n549\t                (recur))\n550\t            (= :n (:tag run))\n551\t            (reset! (:refused run)\n552\t                    {:path (:path (first failing))\n553\t                     :cursor-cells (vec (sort-by str (distinct (mapcat (fn [g] (mapcat #(unnumbered-cells run (:kind g) %) (:elems g)))\n554\t                                                                       failing))))})\n555\t            :else nil))))))\n556\t\n557\t\n558\t(defn- key-walk\n559\t  \"A member's key: the walk over the member from the enclosing walk's\n560\t   numbering, local numbers counted on from an enclosing key walk's counter,\n561\t   spelled under its final numbering. Memoized on the member, the numbering\n562\t   of its cursor cells and the counter.\"\n563\t  [run item path]\n564\t  (let [ctx (:ctx run)\n565\t        cells (item-cells ctx :V item)\n566\t        num @(:num run)\n567\t        start (if (= :u (:tag run)) @(:next run) 0)\n568\t        memo-key [item (select-keys num cells) start]]\n569\t    (or (get @(:memo ctx) memo-key)\n570\t        (let [sub (new-run ctx num :u start)]\n571\t          (work! ctx (count cells))\n572\t          (enter-slot! sub :V item path)\n573\t          (resolve! sub)\n574\t          (let [spelling (spell-slot sub :V item path)\n575\t                k {:spell spelling :bytes (key-bytes! ctx spelling) :complete? (empty? @(:groups sub))}]\n576\t            (swap! (:memo ctx) assoc memo-key k)\n577\t            k)))))\n578\t\n579\t\n580\t(defn- spell-cell\n581\t  [run c]\n582\t  (let [ctx (:ctx run) [tag k] (get @(:num run) c)]\n583\t    (case tag\n584\t      :n [:cursor-cell [:n k]]\n585\t      :u [:cursor-cell [:u k (get (:ranks ctx) c) (get (:counts ctx) c)]]\n586\t      (throw (ex-info \"Spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n587\t\n588\t\n589\t(defn- spell-slot\n590\t  [run d x path]\n591\t  (work! (:ctx run) 1)\n592\t  (cond\n593\t    (ref? d) (spell-node run x path)\n594\t    (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n595\t    (= :C d) (spell-cell run x)\n596\t    (value-slot? d) (if (nil? x)\n597\t                      x\n598\t                      (case (first x)\n599\t                        :cursor-cell (spell-cell run (second x))\n600\t                        :row [:row (spell-node run (second x) path)]\n601\t                        x))\n602\t    :else x))\n603\t\n604\t\n605\t(defn- spell-node\n606\t  \"Literals and structural data as themselves (by reference), rows expanded\n607\t   in place, keyed rows in key order, a :set or :map as the sorted vector of\n608\t   its members' spellings with each surviving tie group as [:tie K ... K].\"\n609\t  [run n path]\n610\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n611\t    (cond\n612\t      (= :cursor-cells kind) [:cursor-cells]\n613\t      (child-task? ctx n) [:child]\n614\t      (= :task kind)\n615\t      (into [kind] (map (fn [i d x]\n616\t                          (if (contains? #{7 12} i)\n617\t                            (sort-by-key! ctx #(nth % 1) (mapv #(spell-node run % (conj path i (first (:slots %)))) x))\n618\t                            (spell-slot run d x (conj path i))))\n619\t                        (range) ds slots))\n620\t      (contains? keyed-structural kind)\n621\t      (into [kind] (mapcat identity (sort-by-key! ctx first\n622\t                                                  (mapv (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n623\t                                                        (partition 2 slots)))))\n624\t      (= :window kind)\n625\t      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n626\t      (contains? #{:set :map} kind)\n627\t      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n628\t            tied (filterv #(identical? n (:container %)) @(:groups run))\n629\t            tied-elems (set (mapcat :elems tied))\n630\t            plain (into [] (keep (fn [e]\n631\t                                   (when-not (contains? tied-elems e)\n632\t                                     (spell-slot run :V (elem-item kind e) (conj path :member)))))\n633\t                        elems)\n634\t            ties (mapv #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n635\t        (into [kind] (sort-by-key! ctx identity (into plain ties))))\n636\t      :else (into [kind] (map (fn [i d x] (spell-slot run d x (conj path i))) (range) ds slots)))))\n637\t\n638\t\n639\t(defn- discovery-numbering\n640\t  \"The root walk: {:numbering {source -> :yin.k/cc-n}}, or {:refused {:path\n641\t   :cursor-cells}} when a tie group fails the tie test. The census's pair\n642\t   count is charged first, then the depth scan runs, before anything\n643\t   recursive. Throws the resource refusal, or a defect without\n644\t   :yin.k/status when the numbering is not a bijection onto the census.\"\n645\t  [task budget counter]\n646\t  (let [budget (merge default-budget budget)\n647\t        census (:slots (nth (:slots task) 9))]\n648\t    (spend! counter budget :cursor-cells (quot (count census) 2))\n649\t    (if (empty? census)\n650\t      {:numbering {}}\n651\t      (let [ctx {:task task :budget budget :counter counter :memo (atom {}) :cells-memo (atom {})}\n652\t            _ (depth-scan! ctx task)\n653\t            bodies (into {} (map vec) (partition 2 census))\n654\t            ranks (body-ranks ctx bodies)\n655\t            counts (let [acc (atom {})]\n656\t                     (walk-cells ctx [:ref :task] task #(swap! acc update % (fnil inc 0)))\n657\t                     @acc)\n658\t            run (new-run (assoc ctx :ranks ranks :counts counts) {} :n 1)]\n659\t        (enter-node! run task [])\n660\t        (resolve! run)\n661\t        (if-let [refused @(:refused run)]\n662\t          {:refused refused}\n663\t          (let [numbered (set (keys @(:num run))) declared (set (keys bodies))]\n664\t            (when (or (seq @(:groups run)) (not= numbered declared))\n665\t              (throw (ex-info \"Cursor-cell numbering is not total\"\n666\t                              {:missing (vec (sort-by str (remove numbered declared)))\n667\t                               :extra (vec (sort-by str (remove declared numbered)))})))\n668\t            {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))}))))))\n669\t\n670\t\n671\t(defn- unresolved!\n672\t  [refused prefix]\n673\t  (throw (ex-info \"Row codec refused data\"\n674\t                  {:yin.k/status :yin.k/non-portable :yin.k/kind :unresolved-cursor-cells\n675\t                   :yin.k/path (into prefix (:path refused)) :yin.k/cursor-cells (:cursor-cells refused)})))\n676\t\n677\t\n678\t(defn canonical-numbering\n679\t  \"Discovery-order cursor-cell numbering (design note §1): source cursor\n680\t   cell -> :yin.k/cc-n, the n-th cursor cell the canonical walk meets.\n681\t   Refuses :yin.k/non-portable :unresolved-cursor-cells when tied members of\n682\t   a guest set or map cannot be proved interchangeable. A budget exhaustion\n683\t   is a resource refusal, never a canonicality verdict. counter, when\n684\t   supplied, is the atom the charges accumulate in.\"\n685\t  ([task] (canonical-numbering task default-budget))\n686\t  ([task budget] (canonical-numbering task budget (atom {})))\n687\t  ([task budget counter]\n688\t   (let [r (discovery-numbering task budget counter)]\n689\t     (if-let [refused (:refused r)] (unresolved! refused []) (:numbering r)))))\n690\t\n691\t\n692\t(defn- child-numberer\n693\t  \"Numbers an install child in its own scope under budget; a refusal's path\n694\t   is prefixed by the install's row path [12 <name> ...].\"\n695\t  [budget]\n696\t  (fn [child path]\n697\t    (let [r (discovery-numbering child budget (atom {}))]\n698\t      (if-let [refused (:refused r)] (unresolved! refused path) (:numbering r)))))\n699\t\n700\t\n701\t(defn emit-numbered\n702\t  \"Emit under a supplied numbering. Useful for canonicality probes;\n703\t   ordinary callers use emit, which computes the canonical numbering.\n704\t   number-child, (fn [child path] numbering), numbers install children;\n705\t   by default canonically.\"\n706\t  ([task numbering] (emit-numbered task numbering (child-numberer default-budget)))\n707\t  ([task numbering number-child]\n708\t   (let [[id rows] (emit-node task numbering {} [] number-child)]\n709\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n710\t\n711\t\n712\t(defn emit\n713\t  \"Emit an abstract task as a self-contained carrier. This is a codec,\n714\t   not lift-task: the caller supplies the complete abstract row tree.\"\n715\t  ([task] (emit task default-budget))\n716\t  ([task budget]\n717\t   (let [budget (merge default-budget budget)\n718\t         [id rows] (emit-node task (canonical-numbering task budget) {} [] (child-numberer budget))]\n719\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n720\t\n721\t\n722\t(defn- structural?\n723\t  [kind d x]\n724\t  (cond\n725\t    (and (= :cursor-cells kind) (= :C d)) (and (keyword? x) (some? (re-matches census-key (name x))))\n726\t    (or (ref? d) (= :C d)) (keyword? x)\n727\t    (refs? d) (and (vector? x) (every? keyword? x))\n728\t    (contains? #{:V :optional-V} d)\n729\t    (or (and (= :optional-V d) (nil? x))\n730\t        (and (vector? x) (= 2 (count x)) (contains? #{:lit :row :cursor-cell} (first x))\n731\t             (or (= :lit (first x)) (keyword? (second x)))))\n732\t    (= :N d) (and (code/reg? x) (<= x 4503599627370495))\n733\t    (= :S d) (symbol? x)\n734\t    (= :syms d) (and (vector? x) (every? symbol? x))\n735\t    (= :A d) (some? (jing/parse-segment-address x))\n736\t    :else true))\n737\t\n738\t\n739\t(defn- literal?\n740\t  [x]\n741\t  (and (not (cbor/byte-payload? x))\n742\t       (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n743\t           (number? x)\n744\t           (and (coll? x)\n745\t                (every? literal? (if (map? x) (mapcat identity x) x))\n746\t                (or (nil? (meta x)) (literal? (meta x))))\n747\t           (try (some? (cbor/numeric-kind x))\n748\t                (catch #?(:cljd Object :clj Throwable :cljs :default) _e false)))))\n749\t\n750\t\n751\t(def value-row-kinds #{:vec :list :set :map :closure :prim :stream :reified :parked-ref})\n752\t\n753\t\n754\t(defn- check-abstract!\n755\t  [root]\n756\t  (letfn [(literal-value\n757\t            [x]\n758\t            (cond\n759\t              (map? x) [:map (into {} (map (fn [[k v]] [(literal-value k) (literal-value v)])) x)]\n760\t              (set? x) [:set (set (map literal-value x))]\n761\t              (sequential? x) [:seq (mapv literal-value x)]\n762\t              :else [:literal x]))\n763\t          (value\n764\t            [v]\n765\t            (case (first v)\n766\t              :lit (literal-value (second v))\n767\t              :cursor-cell [:identity (second v)]\n768\t              :row (let [n (second v) ss (:slots n)]\n769\t                     (case (:kind n)\n770\t                       :vec [:seq (mapv value ss)]\n771\t                       :list [:seq (mapv value ss)]\n772\t                       :set [:set (set (map value ss))]\n773\t                       :map [:map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))]\n774\t                       [:row n]))))\n775\t          (reference?\n776\t            [v]\n777\t            (case (first v)\n778\t              :cursor-cell true\n779\t              :lit false\n780\t              :row (let [n (second v)]\n781\t                     (if (contains? #{:vec :list :set :map} (:kind n))\n782\t                       (boolean (some reference? (:slots n))) true))\n783\t              false))\n784\t          (visit\n785\t            [n path cursor-cells reached]\n786\t            (let [{:keys [kind slots]} n ds (descriptors kind slots)]\n787\t              (when (contains? #{:map :set} kind)\n788\t                (let [vs (if (= :set kind) slots (map first (partition 2 slots)))\n789\t                      decoded (map value vs)]\n790\t                  (when-not (= (count decoded) (count (distinct decoded))) (bad! :duplicate-key path))))\n791\t              (when (and (contains? #{:vec :list :set :map} kind)\n792\t                         (not (some reference? slots))) (bad! :reference-free-row path))\n793\t              (doseq [[i d x] (map vector (range) ds slots)]\n794\t                (let [p (conj path i)]\n795\t                  (cond\n796\t                    (= :C d) (do (when-not (contains? cursor-cells x) (bad! :missing-cursor-cell p)) (swap! reached conj x))\n797\t                    (and (ref? d) (= :task (:kind x))) (check-task x p)\n798\t                    (and (ref? d) (not= :cursor-cells (:kind x))) (visit x p cursor-cells reached)\n799\t                    (refs? d) (doseq [[j child] (map-indexed vector x)]\n800\t                                (visit child (conj p j) cursor-cells reached))\n801\t                    (contains? #{:V :optional-V} d)\n802\t                    (when x\n803\t                      (case (first x)\n804\t                        :lit (when-not (literal? (second x)) (bad! :literal p))\n805\t                        :cursor-cell (do (when-not (contains? cursor-cells (second x)) (bad! :missing-cursor-cell p))\n806\t                                         (swap! reached conj (second x)))\n807\t                        :row (visit (second x) p cursor-cells reached)))\n808\t                    :else nil)))))\n809\t          (check-task\n810\t            [task path]\n811\t            (let [slots (:slots task) census (nth slots 9)\n812\t                  cursor-cells (into {} (map vec) (partition 2 (:slots census))) reached (atom #{})]\n813\t              (visit task path cursor-cells reached)\n814\t              (when-not (= (set (keys cursor-cells)) @reached) (bad! :extra-cursor-cell (conj path 9)))))]\n815\t    (when (= :task (:kind root)) (check-task root []))))\n816\t\n817\t\n818\t(defn- decode*\n819\t  \"Validate gate, local schema, finite reachable graph, hashes, canonical\n820\t   form and cursor-cell numbering, then expand structural refs. No attachment.\n821\t   Frame checks are available separately through validate-frames.\"\n822\t  ([wire] (decode* wire default-budget))\n823\t  ([wire budget]\n824\t   (let [budget (merge default-budget budget) counter (atom {})\n825\t         rs (:yin.k/rows wire)]\n826\t     (when-not (and (= true (:yin.k/handoff wire)) (= 3 (:yin.k/version wire))\n827\t                    (code/reg? (:yin.k/version wire)))\n828\t       (refuse! :yin.k/profile-mismatch :version [:yin.k/version]))\n829\t     (when-not (and (= #{:yin.k/handoff :yin.k/version :yin.k/root :yin.k/rows} (set (keys wire)))\n830\t                    (vector? rs) (every? #(and (vector? %) (<= 2 (count %))) rs))\n831\t       (bad! :row-shape [:yin.k/rows]))\n832\t     (spend! counter budget :rows (count rs))\n833\t     (spend! counter budget :bytes (count (seq (cbor/encode wire))))\n834\t     (let [index (into {} (map (fn [r] [(first r) r])) rs)\n835\t           root (:yin.k/root wire)]\n836\t       (when-not (= (count rs) (count index)) (bad! :duplicate-row [:yin.k/rows]))\n837\t       (when-not (contains? #{:task :act :tail :wait} (second (get index root))) (bad! :root [:yin.k/root]))\n838\t       ;; Gate children before schema, with an active path (DAG sharing is legal).\n839\t       (letfn [(gate\n840\t                 [id active]\n841\t                 (when (contains? active id) (bad! :cyclic [id]))\n842\t                 (let [row (get index id) slots (when row (subvec row 2))]\n843\t                   (when-not (and (= :task (second row)) (= 17 (count slots))\n844\t                                  (vector? (nth slots 12)) (every? keyword? (nth slots 12)))\n845\t                     (bad! :task-shape [id]))\n846\t                   (when-not (= 3 (nth slots 0)) (refuse! :yin.k/profile-mismatch :version [id 0]))\n847\t                   (when-not (= profile (nth slots 1)) (refuse! :yin.k/profile-mismatch :profile [id 1]))\n848\t                   (doseq [install (nth slots 12)]\n849\t                     (let [r (get index install)]\n850\t                       (when-not (and (= :install (second r)) (= 7 (count r))) (bad! :install-shape [install]))\n851\t                       (gate (nth r 6) (conj active id))))))]\n852\t         (when (= :task (second (get index root))) (gate root #{})))\n853\t       (doseq [[id kind & slots] rs]\n854\t         (let [schema (get row-table kind) ds (descriptors kind slots)]\n855\t           (when-not (and schema\n856\t                          (cond\n857\t                            (= schema :pending) (contains? pending-table (first slots))\n858\t                            (= :pairs (first schema)) (even? (count slots))\n859\t                            :else true)\n860\t                          (= (count ds) (count slots))) (bad! :row-shape [id]))\n861\t           (doseq [[i d x] (map vector (range) ds slots)]\n862\t             (when-not (structural? kind d x) (bad! :slot-kind [id i])))))\n863\t       (let [seen (atom #{})]\n864\t         (letfn [(walk\n865\t                   [id active depth]\n866\t                   (when (> depth (:depth budget)) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n867\t                   (when (contains? active id) (bad! :cyclic [id]))\n868\t                   (when-not (contains? @seen id)\n869\t                     (let [r (get index id)]\n870\t                       (when-not r (bad! :missing-row [id]))\n871\t                       (let [kind (second r) slots (subvec r 2)]\n872\t                         (doseq [[i d x] (map vector (range) (descriptors kind slots) slots)]\n873\t                           (let [targets (cond (ref? d) [x] (refs? d) x\n874\t                                               (and (contains? #{:V :optional-V} d) (= :row (first x))) [(second x)]\n875\t                                               :else [])]\n876\t                             (doseq [target targets]\n877\t                               (when (and (contains? #{:V :optional-V} d)\n878\t                                          (not (contains? value-row-kinds (second (get index target)))))\n879\t                                 (bad! :value-reference-kind [id i]))\n880\t                               (when (and (or (ref? d) (refs? d))\n881\t                                          (not (contains? (set (rest d)) (second (get index target)))))\n882\t                                 (bad! :reference-kind [id i]))\n883\t                               (walk target (conj active id) (inc depth))))))\n884\t                       (swap! seen conj id))))]\n885\t           (walk root #{} 0)\n886\t           (when-not (= @seen (set (keys index))) (bad! :unreachable-row [:yin.k/rows]))))\n887\t       (doseq [[id & body] rs]\n888\t         (when-not (and (= :blake3 (:algorithm (jing/parse-segment-address id)))\n889\t                        (= id (jing/segment-key (vec body))))\n890\t           (refuse! :yin.k/hash-mismatch :row [id])))\n891\t       (doseq [[id kind & slots] rs :when (= :task kind)]\n892\t         (doseq [[address v] (nth slots 11)]\n893\t           (when-not (= address (jing/segment-key v))\n894\t             (refuse! :yin.k/hash-mismatch :code [id 11 address]))\n895\t           (when (code/well-formed? v) (bad! :code [id 11 address]))))\n896\t       (doseq [[_ kind & slots] rs\n897\t               [d x] (map vector (descriptors kind slots) slots)]\n898\t         (when-not (or (ref? d) (refs? d) (= :C d))\n899\t           (check-literal-markers! (if (contains? #{:V :optional-V} d)\n900\t                                     (when (= :lit (first x)) (second x)) x))))\n901\t       (doseq [[id kind & slots] rs]\n902\t         (when-not (= (vec slots) (ordered-slots kind (vec slots))) (bad! :row-order [id]))\n903\t         (when (contains? #{:map :bindings :store :parked-table :window :cursor-cells :set} kind)\n904\t           (let [keys (if (= kind :set) slots (map first (partition 2 slots)))]\n905\t             (when-not (and (= (count keys) (count (distinct keys)))\n906\t                            (= (count keys) (count (distinct (map #(bytes-key (cbor/encode %)) keys)))))\n907\t               (bad! :duplicate-key [id])))))\n908\t       (letfn [(expand-slot\n909\t                 [d x]\n910\t                 (cond (ref? d) (expand x) (refs? d) (mapv expand x)\n911\t                       (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (expand (second x))]\n912\t                       :else x))\n913\t               (expand\n914\t                 [id]\n915\t                 (let [[_ kind & slots] (get index id)]\n916\t                   (node kind (mapv expand-slot (descriptors kind slots) slots))))]\n917\t         (let [task (expand root)\n918\t               _ (check-abstract! task)\n919\t               ;; Only the lift's tie refusal (root or child) is translated; a\n920\t               ;; resource refusal propagates as itself.\n921\t               canonical (if (= :task (:kind task))\n922\t                           (try (emit task budget)\n923\t                                (catch #?(:cljd Object :clj Throwable :cljs :default) e\n924\t                                  (let [d (ex-data e)]\n925\t                                    (if (and (= :yin.k/non-portable (:yin.k/status d))\n926\t                                             (= :unresolved-cursor-cells (:yin.k/kind d)))\n927\t                                      (throw (ex-info \"Row codec refused data\"\n928\t                                                      (assoc d :yin.k/status :yin.k/undecodable\n929\t                                                             :yin.k/path (into [root] (:yin.k/path d)))))\n930\t                                      (throw e)))))\n931\t                           (let [[id _] (emit-node task {} {})] {:yin.k/root id}))]\n932\t           (when (and (not= false (:check-numbering budget)) (not= root (:yin.k/root canonical)))\n933\t             (bad! :noncanonical-cursor-cells [root]))\n934\t           (when (= :task (:kind task))\n935\t             (when-let [d (validate-frames task)]\n936\t               (throw (ex-info \"Frame validation failed\" (update d :yin.k/path #(into [root] %))))))\n937\t           task))))))\n938\t\n939\t\n940\t(defn decode\n941\t  \"Validate and expand a row pack, including canonical cursor-cell numbering.\n942\t   For task roots, run X1 and frame validation after numbering.\"\n943\t  ([wire] (decode* wire default-budget))\n944\t  ([wire budget] (decode* wire (dissoc budget :check-numbering))))\n945\t\n946\t\n947\t(defn canonical-under\n948\t  \"Test-only §5.5 re-emission under an explicit stream correspondence.\n949\t   Missing marker coverage fails; neither traversal order nor original\n950\t   cursor-cell numbering chooses a logical identity. Accepts a carrier.\"\n951\t  [wire correspondence]\n952\t  (let [task (decode* wire (assoc default-budget :check-numbering false))]\n953\t    (letfn [(rewrite-slot\n954\t              [d x]\n955\t              (cond (ref? d) (rewrite x) (refs? d) (mapv rewrite x)\n956\t                    (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (rewrite (second x))]\n957\t                    :else x))\n958\t            (rewrite\n959\t              [n]\n960\t              (let [{:keys [kind slots]} n]\n961\t                (if (= :stream kind)\n962\t                  (let [id (first slots)]\n963\t                    (when-not (contains? correspondence id) (bad! :missing-stream-correspondence [id]))\n964\t                    (node :stream [(get correspondence id) (get correspondence id)]))\n965\t                  (node kind (mapv rewrite-slot (descriptors kind slots) slots)))))]\n966\t      (emit (rewrite task)))))\n967\t\n968\t\n969\t(defn- value-node\n970\t  [x]\n971\t  (check-literal-markers! x)\n972\t  [:lit x])\n973\t\n974\t\n975\t(defn- decoded-value\n976\t  [v]\n977\t  (case (first v)\n978\t    :row {:yin.k/row (second v)}\n979\t    :cursor-cell {:yin.k/cursor-cell (second v)}\n980\t    :lit (if (marker-shaped? (second v)) (refuse! :yin.k/non-portable :marker []) (second v))))\n981\t\n982\t\n983\t(defn- keyed-node\n984\t  [kind m encode]\n985\t  (node kind (mapcat (fn [[k v]] [k (encode v)]) m)))\n986\t\n987\t\n988\t(defn- env-node\n989\t  [e encode]\n990\t  (node :env [(keyed-node :bindings (:yin.k/bindings e) encode) (:yin.k/store-of e)]))\n991\t\n992\t\n993\t(defn- kframe-node\n994\t  [f encode]\n995\t  (node :kframe [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n996\t                 (keyed-node :window (:yin.k/window f) encode) (:yin.k/rd f)]))\n997\t\n998\t\n999\t(def pending-keys\n1000\t  {:next [:yin.k/cursor-cell]\n1001\t   :put [:yin.k/stream :yin.k/value :yin.k/op-id]\n1002\t   :ffi [:yin.k/cursor-cell :yin.k/call-id :yin.k/op]\n1003\t   :ffi-request [:yin.k/call-id :yin.k/envelope :yin.k/request-stream :yin.k/response-stream :yin.k/response-cursor-cell :yin.k/op-id]\n1004\t   :link-request [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell :yin.k/envelope :yin.k/op-id]\n1005\t   :link-response [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cursor-cell]\n1006\t   :install [:yin.k/name]})\n1007\t\n1008\t\n1009\t(defn frame->rows\n1010\t  \"Encode a keyed frame to a frame-rooted version-3 row pack. Values are\n1011\t   plain literals by default. An explicit value encoder classifies portable\n1012\t   references as [:row abstract-row] or [:cursor-cell id], distinct from guest maps.\n1013\t   This reshapes; frame/defect owns semantic validity.\"\n1014\t  ([f] (frame->rows f value-node))\n1015\t  ([f encode]\n1016\t   (let [k (node :k (mapv #(kframe-node % encode) (:yin.k/k f)))\n1017\t         state (if (= :act (:yin.k/state f))\n1018\t                 (node :act [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n1019\t                             (keyed-node :window (:yin.k/window f) encode) k (get-in f [:yin.k/deliver :yin.k/rd])])\n1020\t                 (node :tail [(:yin.k/segment f) (:yin.k/site f) k]))\n1021\t         pending (:yin.k/pending f)\n1022\t         reason (:yin.k/reason pending)\n1023\t         root (if (contains? f :yin.k/pending)\n1024\t                (node :wait [state (node :pending\n1025\t                                         (into [reason]\n1026\t                                               (map (fn [key d]\n1027\t                                                      (let [x (get pending key)]\n1028\t                                                        (if (= :V d) (encode x) x)))\n1029\t                                                    (get pending-keys reason) (get pending-table reason))))])\n1030\t                state)\n1031\t         [id rows] (emit-node root {} {})]\n1032\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n1033\t\n1034\t\n1035\t(defn- decode-keyed\n1036\t  [n decode-value]\n1037\t  (into {} (map (fn [[k v]] [k (decode-value v)])) (partition 2 (:slots n))))\n1038\t\n1039\t\n1040\t(defn- decode-env\n1041\t  [n decode-value]\n1042\t  (let [[bindings store-of] (:slots n)]\n1043\t    (cond-> {:yin.k/bindings (decode-keyed bindings decode-value)}\n1044\t      (some? store-of) (assoc :yin.k/store-of store-of))))\n1045\t\n1046\t\n1047\t(defn- decode-kframe\n1048\t  [n decode-value]\n1049\t  (let [[seg pc e w rd] (:slots n)]\n1050\t    {:yin.k/frame-type :return :yin.k/segment seg :yin.k/pc pc\n1051\t     :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value) :yin.k/rd rd}))\n1052\t\n1053\t\n1054\t(defn- decode-frame\n1055\t  [n decode-value]\n1056\t  (if (= :wait (:kind n))\n1057\t    (let [[state pending] (:slots n) [reason & slots] (:slots pending)]\n1058\t      (assoc (decode-frame state decode-value) :yin.k/pending\n1059\t             (into {:yin.k/reason reason}\n1060\t                   (map (fn [key d x] [key (if (= :V d) (decode-value x) x)])\n1061\t                        (get pending-keys reason) (get pending-table reason) slots))))\n1062\t    (let [act? (= :act (:kind n)) [seg pc e w k rd] (:slots n)\n1063\t          k (if act? k e)]\n1064\t      (cond-> {:yin.k/state (:kind n) :yin.k/segment seg\n1065\t               :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd rd} {:yin.k/deliver :return})\n1066\t               :yin.k/k (mapv #(decode-kframe % decode-value) (:slots k))}\n1067\t        act? (assoc :yin.k/pc pc :yin.k/env (decode-env e decode-value) :yin.k/window (decode-keyed w decode-value))\n1068\t        (not act?) (assoc :yin.k/site pc)))))\n1069\t\n1070\t\n1071\t(defn rows->frame\n1072\t  \"Validate row syntax and hashes, then reshape to the keyed frame.\n1073\t   Semantic code/context rules remain frame/defect's responsibility.\n1074\t   The default decoder produces in-band row/cursor-cell markers that the default\n1075\t   encoder refuses. frame->rows after rows->frame is identity only when\n1076\t   both sides are given a classifier for those values.\"\n1077\t  ([wire] (rows->frame wire decoded-value))\n1078\t  ([wire decode-value] (decode-frame (decode wire) decode-value)))\n1079\t\n1080\t\n1081\t(defn validate-frames\n1082\t  \"Carrier step 7, after decode's canonical numbering. Judge each task's\n1083\t   X1 first, then waits, parked states, and all reified values. Return the\n1084\t   first defect with the abstract row path, or nil.\"\n1085\t  [task]\n1086\t  (let [slots (:slots task) code-map (nth slots 11)\n1087\t        free-env (decode-keyed (nth slots 5) decoded-value)\n1088\t        waits (nth slots 13)\n1089\t        ffi-ids (into #{} (keep (fn [w]\n1090\t                                  (let [[_ p] (:slots w) [reason & xs] (:slots p)]\n1091\t                                    (case reason :ffi (second xs) :ffi-request (first xs) nil)))) waits)\n1092\t        ctx {:free-env free-env :ffi-call-ids ffi-ids}]\n1093\t    (letfn [(judge\n1094\t              [n context context-map path]\n1095\t              (when-let [d (frame/defect (decode-frame n decoded-value) code-map context context-map)]\n1096\t                (-> d (assoc :yin.k/status :yin.k/undecodable)\n1097\t                    (update :yin.k/path #(into path %)))))\n1098\t            (captures\n1099\t              [n path]\n1100\t              (if (= :reified (:kind n))\n1101\t                (or (judge (first (:slots n)) :captured ctx path)\n1102\t                    (captures (first (:slots n)) (conj path 0)))\n1103\t                (some (fn [[i d x]]\n1104\t                        (cond\n1105\t                          (and (ref? d) (= :task (:kind x))) (validate-frames x)\n1106\t                          (ref? d) (captures x (conj path i))\n1107\t                          (refs? d) (some (fn [[j child]] (captures child (conj path i j))) (map-indexed vector x))\n1108\t                          (and (contains? #{:V :optional-V} d) (= :row (first x))) (captures (second x) (conj path i))\n1109\t                          :else nil))\n1110\t                      (map vector (range) (descriptors (:kind n) (:slots n)) (:slots n)))))]\n1111\t      (or\n1112\t        (when-let [d (frame/task-defect ctx)] (assoc d :yin.k/status :yin.k/undecodable))\n1113\t        (some (fn [[i w]] (judge w :wait ctx [:frames i])) (map-indexed vector waits))\n1114\t        (some (fn [[p state]] (judge state :parked (assoc ctx :parked-key p) [:parked p]))\n1115\t              (partition 2 (:slots (nth slots 8))))\n1116\t        (captures task [])))))\n1117\t"}]},"parent_tool_use_id":null,"session_id":"ee657710-cc1c-4c43-882b-5874c9a79051","uuid":"548c9f50-8220-46ab-a36e-a9acd9e4f5c5","timestamp":"2026-10-12T15:52:47.355Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6b/src/cljc/yin/vm/ucf/rows.cljc","content":"(ns yin.vm.ucf.rows\n  \"Version-3 row codec. Pure row construction, graph decoding and\n   discovery-order cursor-cell numbering (design note §1); no machine\n   attachment, dependency scanner or transport.\n   An abstract row is {:kind keyword :slots vector}. Structural references\n   contain abstract rows; values use [:lit d], [:row abstract-row], [:cursor-cell id].\n   A task's :cursor-cells row holds alternating source identities and :cursor-cell-body\n   rows. Install children are separate tasks with separate cursor-cell scopes.\n\n   The census is ordered numerically by n (draft §3, \\\"sorted by n\\\"), so\n   :yin.k/cc-10 follows :yin.k/cc-9; its keys must spell cc-N with no leading\n   zero, else :slot-kind.\n\n   Default value markers are plain maps {:yin.k/row abstract-row} and\n   {:yin.k/cursor-cell keyword}. A guest map whose sole key is :yin.k/row or\n   :yin.k/cursor-cell collides with them and is not portable: on encode and decode\n   every literal of that shape is refused :yin.k/non-portable. Explicit\n   markers use the caller value encoder.\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.frame :as frame]))\n\n\n(def profile {:yin.code/contract \"v4\" :yin.k/version 1})\n\n\n(def pending-table\n  {:next [:C]\n   :put [[:ref :stream] :V :D]\n   :ffi [:C :D :D]\n   :ffi-request [:D :V [:ref :stream] [:ref :stream] :C :D]\n   :link-request [:D :S [:ref :stream] [:ref :stream] :C :D :D]\n   :link-response [:D :S [:ref :stream] [:ref :stream] :C]\n   :install [:S]})\n\n\n(def row-table\n  \"Slot descriptors, excluding id and kind. :repeat/:pairs are variadic;\n   :refs is an ordered vector of structural references. :pending is\n   discriminated by pending-table. Nothing in this table is executable.\"\n  {:vec [:repeat :V] :list [:repeat :V] :set [:repeat :V]\n   :map [:pairs :V :V] :bindings [:pairs :S :V] :store [:pairs :D :V]\n   :env [[:ref :bindings] :optional-D]\n   :closure [:A :N :syms [:ref :bindings] :optional-D]\n   :prim [:S] :stream [:D :D] :reified [[:ref :act]] :parked-ref [:D]\n   :act [:A :N [:ref :env] [:ref :window] [:ref :k] :N]\n   :tail [:A :N [:ref :k]]\n   :window [:pairs :N :V] :k [:repeat [:ref :kframe]]\n   :kframe [:A :N [:ref :env] [:ref :window] :N]\n   :wait [[:ref :act :tail] [:ref :pending]] :pending :pending\n   :module-store [:D [:ref :store]]\n   :parked-table [:pairs :D [:ref :act :tail]]\n   :install [:S :D :D :D [:ref :task]]\n   :cursor-cells [:pairs :C [:ref :cursor-cell-body]] :cursor-cell-body [[:ref :stream] :D]\n   :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n          [:refs :module-store] [:ref :parked-table] [:ref :cursor-cells]\n          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n\n\n(defn node\n  [kind slots]\n  {:kind kind :slots (if (= :window kind)\n                       (vec (mapcat identity (sort-by first (partition 2 slots))))\n                       (vec slots))})\n\n\n(defn- refuse!\n  [status kind path]\n  (throw (ex-info \"Row codec refused data\"\n                  {:yin.k/status status :yin.k/kind kind :yin.k/path path})))\n\n\n(defn- bad!\n  [kind path]\n  (refuse! :yin.k/undecodable kind path))\n\n\n(defn- marker-shaped?\n  [x]\n  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cursor-cell))))\n\n\n(defn- check-literal-markers!\n  [x]\n  (when (marker-shaped? x) (refuse! :yin.k/non-portable :marker []))\n  (when (coll? x)\n    (doseq [v (if (map? x) (mapcat identity x) x)] (check-literal-markers! v)))\n  (when (meta x) (check-literal-markers! (meta x))))\n\n\n(defn- bytes-key\n  [bs]\n  ;; Unsigned bytewise order, without a length-first comparison.\n  (mapv #(bit-and (int %) 255) (seq bs)))\n\n\n(defn- compare-bytes\n  [a b]\n  (loop [i 0]\n    (cond\n      (= i (count a)) (if (= i (count b)) 0 -1)\n      (= i (count b)) 1\n      (= (nth a i) (nth b i)) (recur (inc i))\n      :else (compare (nth a i) (nth b i)))))\n\n\n(defn- byte-compare\n  [a b]\n  (compare-bytes (bytes-key (cbor/encode a)) (bytes-key (cbor/encode b))))\n\n\n(defn- sorted-bytes\n  [xs]\n  (vec (sort byte-compare xs)))\n\n\n(defn- descriptors\n  [kind slots]\n  ;; :entry is the numbering's synthetic map entry [:entry k v], never a carrier row.\n  (let [schema (if (= :entry kind) [:V :V] (get row-table kind))]\n    (cond\n      (= schema :pending) (into [:D] (get pending-table (first slots)))\n      (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n      (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n      :else schema)))\n\n\n(defn- ref?\n  [d]\n  (and (vector? d) (= :ref (first d))))\n\n\n(defn- refs?\n  [d]\n  (and (vector? d) (= :refs (first d))))\n\n\n(def ^:private census-key #\"cc-([1-9][0-9]*)\")\n\n\n(defn- census-order\n  ;; Numeric order of cc-N without reading wire data: fewer digits first,\n  ;; then the digits. Other keys (a partial emit-numbered) sort last.\n  [k]\n  (let [digits (when (keyword? k) (second (re-matches census-key (name k))))]\n    (if digits [0 (count digits) digits] [1 0 (str k)])))\n\n\n(defn- ordered-slots\n  [kind slots]\n  (cond\n    (= kind :window) (vec (mapcat identity (sort-by first (partition 2 slots))))\n    (= kind :cursor-cells) (vec (mapcat identity (sort-by #(census-order (first %)) (partition 2 slots))))\n    (contains? #{:map :bindings :store :parked-table} kind)\n    (vec (mapcat identity (sort #(byte-compare (first %1) (first %2)) (partition 2 slots))))\n    (= kind :set) (sorted-bytes slots)\n    :else slots))\n\n\n(def default-budget\n  \"Local resource bounds, independent of canonical bytes. :work counts the\n   numbering's positions and the representation bound of every value it\n   encodes for a comparison (design note §1.5).\"\n  {:rows 10000 :cursor-cells 64 :depth 256 :work 4194304 :bytes 16777216})\n\n\n(declare emit-node canonical-numbering child-numberer validate-frames)\n\n\n(defn- emit-slot\n  [d x numbering rows path number-child]\n  (when-not (or (ref? d) (refs? d) (= :C d))\n    (check-literal-markers! (if (contains? #{:V :optional-V} d)\n                              (when (= :lit (first x)) (second x)) x)))\n  (cond\n    (ref? d) (emit-node x numbering rows path number-child)\n    (refs? d) (reduce (fn [[out rs] [j n]]\n                        (let [p (conj path (if (= :install (:kind n)) (first (:slots n)) j))\n                              [id rs'] (emit-node n numbering rs p number-child)]\n                          [(conj out id) rs']))\n                      [[] rows] (map-indexed vector x))\n    (= d :C) [(get numbering x x) rows]\n    (contains? #{:V :optional-V} d)\n    (case (first x)\n      :row (let [[id rs] (emit-node (second x) numbering rows path number-child)] [[:row id] rs])\n      :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n      [x rows])\n    :else [x rows]))\n\n\n(defn- emit-node\n  ;; path is the row path of n, so a child's refusal reports [12 <install name> ...].\n  ([n numbering rows] (emit-node n numbering rows [] (child-numberer default-budget)))\n  ([n numbering rows path number-child]\n   (let [{:keys [kind slots]} n\n         ;; A child is canonicalized in its own identity scope.\n         [slots rows] (reduce (fn [[out rs] [i d x]]\n                                (if (and (ref? d) (= :task (:kind x)))\n                                  (let [[id child-rows] (emit-node x (number-child x path) {} path number-child)]\n                                    [(conj out id) (merge rs child-rows)])\n                                  (let [[x' rs'] (emit-slot d x numbering rs (conj path i) number-child)]\n                                    [(conj out x') rs'])))\n                              [[] rows] (map vector (range) (descriptors kind slots) slots))\n         slots (if (= kind :task)\n                 (-> slots\n                     (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n                     (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n                 (ordered-slots kind slots))\n         body (into [kind] slots) id (jing/segment-key body)]\n     [id (assoc rows id (into [id] body))])))\n\n\n(defn- spend!\n  [counter budget category amount]\n  (let [n (get (swap! counter update category (fnil + 0) amount) category)]\n    (when (> n (get budget category))\n      (refuse! :yin.k/unsupported :resource-limit [category]))))\n\n\n;; Discovery-order cursor-cell numbering (design note\n;; yin.vm.semantic-register-vm.cursor-cell-numbering.md §1). A cursor cell is\n;; named by the order in which a fixed pre-order walk of the task meets it. A\n;; guest :set or :map is entered as the vector of its members sorted by key:\n;; the member's spelling by a key walk, numbered cursor cells by number and\n;; the others by local first-occurrence index, body rank and occurrence\n;; count. Members with equal keys form a tie group, postponed and re-keyed\n;; until a pass numbers nothing; a surviving group is entered in host order\n;; only when the tie test proves that harmless, else the lift refuses\n;; :unresolved-cursor-cells.\n\n\n(defn- work!\n  [ctx amount]\n  (spend! (:counter ctx) (:budget ctx) :work amount))\n\n\n(defn- charge-representation!\n  \"Charge to :work, before x is CBOR-encoded for a comparison, a conservative\n   bound of its representation: 128 per node or scalar, 4 per character, 16\n   plus the length per byte payload, metadata included. Iterative, against\n   the budget remaining at the call: it stops as soon as its running total\n   exceeds that, so it never reads to the end of a value it cannot afford.\"\n  [ctx x]\n  (let [{:keys [counter budget]} ctx\n        remaining (- (:work budget) (get @counter :work 0))]\n    (loop [stack (list (list x)) total 0 steps 0]\n      (if (empty? stack)\n        (do (swap! counter update :estimator-steps (fnil + 0) steps)\n            (work! ctx total))\n        (let [s (first stack) stack (rest stack)]\n          (if (empty? s)\n            (recur stack total steps)\n            (let [x (first s)\n                  stack (cons (rest s) stack)\n                  total (+ total (cond\n                                   (cbor/byte-payload? x) (+ 16 #?(:cljd (.-length x) :default (alength x)))\n                                   (string? x) (+ 128 (* 4 (count x)))\n                                   (or (keyword? x) (symbol? x)) (+ 128 (* 4 (count (str x))))\n                                   :else 128))]\n              (if (> total remaining)\n                (do (swap! counter update :estimator-steps (fnil + 0) (inc steps))\n                    (work! ctx total))\n                (recur (cond->> stack\n                         (coll? x) (cons (if (map? x) (mapcat identity x) (seq x)))\n                         (meta x) (cons (list (meta x))))\n                       total (inc steps))))))))))\n\n\n(defn- key-bytes!\n  \"Every comparison encoding of the numbering: charged, then encoded.\"\n  [ctx x]\n  (charge-representation! ctx x)\n  (bytes-key (cbor/encode x)))\n\n\n(defn- sort-by-key!\n  \"xs in the bytewise order of (f x), each encoded once.\"\n  [ctx f xs]\n  (mapv second (sort #(compare-bytes (first %1) (first %2))\n                     (mapv (fn [x] [(key-bytes! ctx (f x)) x]) xs))))\n\n\n(def ^:private keyed-structural #{:bindings :store :parked-table})\n\n\n(defn- value-slot?\n  [d]\n  (contains? #{:V :optional-V} d))\n\n\n(defn- child-task?\n  [ctx n]\n  (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n\n\n(defn- elem-item\n  ;; A :set member is its V; a :map entry is the synthetic ordered row\n  ;; [:entry k v], so the alias pattern across key and value is in its key.\n  [kind e]\n  (if (= :map kind) [:row (node :entry e)] e))\n\n\n(defn- depth-scan!\n  \"The :depth gate, before any recursive traversal of the task: one pre-order\n   scan with an explicit stack over rows, members, structural and literal\n   data and the census, install children skipped (each is gated by its own\n   numbering). A position's depth is its slot steps from the task (a member\n   step counts one, a map entry's key or value two) plus, inside data, its\n   collection nesting. Each position costs one :work unit, charged when it\n   is popped, before any work proportional to it.\"\n  [ctx task]\n  (let [limit (:depth (:budget ctx))\n        row (fn [n k] [:row nil n k])\n        slot (fn [d v k] [:slot d v k])\n        data (fn [v k] [:data nil v k])]\n    (loop [stack (list (list (row task 0)))]\n      (when (seq stack)\n        (let [s (first stack) stack (rest stack)]\n          (if (empty? s)\n            (recur stack)\n            (let [[tag d x k] (first s)\n                  stack (cons (rest s) stack)]\n              (work! ctx 1)\n              (when (> k limit) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n              (recur\n                (cons\n                  (case tag\n                    :row\n                    (let [{:keys [kind slots]} x k' (inc k)]\n                      (when-not (child-task? ctx x)\n                        (let [ds (descriptors kind slots)]\n                          (cond\n                            (= :task kind)\n                            (mapcat (fn [i d v]\n                                      (if (contains? #{7 12} i)\n                                        (map (fn [child] (row child (inc k'))) v)\n                                        [(slot d v k')]))\n                                    (range) ds slots)\n                            (contains? keyed-structural kind)\n                            (mapcat (fn [[key v]] [(data key k') (slot (second ds) v k')]) (partition 2 slots))\n                            (= :window kind)\n                            (mapcat (fn [[r v]] [(data r k') (slot :V v k')]) (partition 2 slots))\n                            (= :set kind) (map (fn [v] (slot :V v k')) slots)\n                            (= :map kind)\n                            (mapcat (fn [[a b]] [(slot :V a (inc k')) (slot :V b (inc k'))]) (partition 2 slots))\n                            :else (map (fn [d v] (slot d v k')) ds slots)))))\n                    :slot\n                    (cond\n                      (ref? d) [(row x k)]\n                      (refs? d) (map (fn [n] (row n (inc k))) x)\n                      (= :C d) nil\n                      (value-slot? d) (when x\n                                        (case (first x)\n                                          :cursor-cell nil\n                                          :row [(row (second x) k)]\n                                          :lit [(data (second x) k)]\n                                          [(data x k)]))\n                      :else [(data x k)])\n                    :data\n                    (concat (when (coll? x) (map (fn [e] (data e (inc k))) (if (map? x) (mapcat identity x) x)))\n                            (when (meta x) [(data (meta x) (inc k))])))\n                  stack)))))))))\n\n\n(defn- walk-cells\n  \"Call f on the cursor cell at every position under slot (d x), the census\n   and install children excluded; one :work unit per position. Recursive,\n   so it runs only after the depth scan.\"\n  [ctx d x f]\n  (letfn [(slot\n            [d x]\n            (work! ctx 1)\n            (cond\n              (ref? d) (row x)\n              (refs? d) (doseq [n x] (row n))\n              (= :C d) (f x)\n              (value-slot? d) (when x\n                                (case (first x)\n                                  :cursor-cell (f (second x))\n                                  :row (row (second x))\n                                  nil))\n              :else nil))\n          (row\n            [n]\n            (when-not (or (= :cursor-cells (:kind n)) (child-task? ctx n))\n              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))] (slot d x))))]\n    (slot d x)))\n\n\n(defn- item-cells\n  \"The cursor cells under slot (d x), memoized per numbering on the slot.\"\n  [ctx d x]\n  (or (get @(:cells-memo ctx) [d x])\n      (let [acc (atom #{})]\n        (walk-cells ctx d x #(swap! acc conj %))\n        (swap! (:cells-memo ctx) assoc [d x] @acc)\n        @acc)))\n\n\n(defn- body-ranks\n  \"Cursor cell -> rank of its body label [:body [:stream identity\n   descriptor] position] among the census's distinct labels in bytewise\n   order, so a key never repeats a descriptor.\"\n  [ctx bodies]\n  (let [labels (into {} (map (fn [[c b]]\n                               (let [[stream position] (:slots b)]\n                                 [c [:body (into [:stream] (:slots stream)) position]])))\n                     bodies)\n        ranks (into {} (map-indexed (fn [i l] [l i]) (sort-by-key! ctx identity (distinct (vals labels)))))]\n    (into {} (map (fn [[c l]] [c (get ranks l)])) labels)))\n\n\n(defn- new-run\n  [ctx num tag start]\n  {:ctx ctx :num (atom num) :tag tag :next (atom start)\n   :groups (atom []) :gid (atom 0) :refused (atom nil)})\n\n\n(defn- meet!\n  \"W2: a cursor cell met for the first time receives the run's next number.\"\n  [run c]\n  (when-not (contains? @(:num run) c)\n    (swap! (:num run) assoc c [(:tag run) @(:next run)])\n    (swap! (:next run) inc)))\n\n\n(declare enter-node! unordered! key-walk spell-slot spell-node)\n\n\n(defn- enter-slot!\n  [run d x path]\n  (let [ctx (:ctx run)]\n    (work! ctx 1)\n    (when (> (count path) (:depth (:budget ctx)))\n      (refuse! :yin.k/unsupported :resource-limit [:depth]))\n    (cond\n      (ref? d) (enter-node! run x path)\n      (refs? d) (doseq [[i n] (map-indexed vector x)] (enter-node! run n (conj path i)))\n      (= :C d) (meet! run x)\n      (value-slot? d) (when x\n                        (case (first x)\n                          :cursor-cell (meet! run (second x))\n                          :row (enter-node! run (second x) path)\n                          nil))\n      :else nil)))\n\n\n(defn- enter-node!\n  \"W1: pre-order in table order; ordered repeated slots in order; keyed\n   structural rows, installs and module stores in the byte order of the\n   key; :window in register order; :set and :map by member keys, ties\n   postponed; the census and install children are not entered.\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (or (= :cursor-cells kind) (child-task? ctx n)) nil\n      (= :task kind)\n      (doseq [[i d x] (map vector (range) ds slots)]\n        (if (contains? #{7 12} i)\n          (doseq [child (sort-by-key! ctx #(first (:slots %)) x)]\n            (enter-node! run child (conj path i (first (:slots child)))))\n          (enter-slot! run d x (conj path i))))\n      (contains? keyed-structural kind)\n      (doseq [[k v] (sort-by-key! ctx first (partition 2 slots))]\n        (enter-slot! run (second ds) v (conj path k)))\n      (= :window kind)\n      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n      (= :set kind) (unordered! run n :set (vec slots) path)\n      (= :map kind) (unordered! run n :map (mapv vec (partition 2 slots)) path)\n      :else (doseq [[i d x] (map vector (range) ds slots)] (enter-slot! run d x (conj path i))))))\n\n\n(defn- unordered!\n  \"Key every member by a key walk under the numbering at this moment; enter\n   members with a unique key in key order and postpone each run of equal\n   keys, a tie group, to the run's queue. A member's path is the\n   container's path plus :member: no index into an unordered container is\n   canonical.\"\n  [run container kind elems path]\n  (let [ctx (:ctx run)\n        keyed (mapv (fn [e]\n                      ;; One unit per member keyed, so key walks and memo lookups are charged.\n                      (work! ctx 1)\n                      [(key-walk run (elem-item kind e) (conj path :member)) e])\n                    elems)\n        groups (partition-by (comp :bytes first)\n                             (sort #(compare-bytes (:bytes (first %1)) (:bytes (first %2))) keyed))]\n    (doseq [g groups]\n      (if (= 1 (count g))\n        (enter-slot! run :V (elem-item kind (second (first g))) (conj path :member))\n        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :container container :kind kind :path path\n                                   :key (:spell (first (first g))) :complete? (:complete? (first (first g)))\n                                   :elems (mapv second g)})))))\n\n\n(defn- fixpoint!\n  \"W3: re-key the postponed groups under the current numbering, in queue\n   order; repeat while a pass numbers a cursor cell and groups remain.\"\n  [run]\n  (loop []\n    (let [before (count @(:num run)) groups @(:groups run)]\n      (reset! (:groups run) [])\n      (doseq [{:keys [container kind elems path]} groups] (unordered! run container kind elems path))\n      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n\n\n(defn- unnumbered-cells\n  [run kind e]\n  (let [num @(:num run)]\n    (set (remove #(contains? num %) (item-cells (:ctx run) :V (elem-item kind e))))))\n\n\n(defn- tie-failure\n  \"The tie test, nil when the group passes: its common key is complete, and\n   its members' unnumbered cursor cells are pairwise disjoint and occur in\n   no member of another surviving group.\"\n  [run groups g]\n  (let [own (mapv #(unnumbered-cells run (:kind g) %) (:elems g))\n        others (reduce (fn [acc h]\n                         (if (= (:id h) (:id g))\n                           acc\n                           (reduce #(into %1 (unnumbered-cells run (:kind h) %2)) acc (:elems h))))\n                       #{} groups)]\n    (cond\n      (not (:complete? g)) :incomplete-key\n      (not= (reduce + (map count own)) (count (reduce into #{} own))) :shared-within-group\n      (some (fn [cells] (some #(contains? others %) cells)) own) :shared-across-groups\n      :else nil)))\n\n\n(defn- resolve!\n  \"The postponed groups to completion: the fixpoint, then the tie test on\n   every surviving group. All pass: enter them in host order and repeat. Any\n   fails: the root walk refuses; a key walk leaves them as [:tie ...] residue.\"\n  [run]\n  (loop []\n    (fixpoint! run)\n    (let [groups @(:groups run)]\n      (when (seq groups)\n        (let [failing (filterv #(tie-failure run groups %) groups)]\n          (cond\n            (empty? failing)\n            ;; Passing groups are independent (their cursor cells are\n            ;; confined), so all are entered before the next pass.\n            (do (reset! (:groups run) [])\n                (doseq [g groups e (:elems g)]\n                  (enter-slot! run :V (elem-item (:kind g) e) (conj (:path g) :member)))\n                (recur))\n            (= :n (:tag run))\n            (reset! (:refused run)\n                    {:path (:path (first failing))\n                     :cursor-cells (vec (sort-by str (distinct (mapcat (fn [g] (mapcat #(unnumbered-cells run (:kind g) %) (:elems g)))\n                                                                       failing))))})\n            :else nil))))))\n\n\n(defn- key-walk\n  \"A member's key: the walk over the member from the enclosing walk's\n   numbering, local numbers counted on from an enclosing key walk's counter,\n   spelled under its final numbering. Memoized on the member, the numbering\n   of its cursor cells and the counter.\"\n  [run item path]\n  (let [ctx (:ctx run)\n        cells (item-cells ctx :V item)\n        num @(:num run)\n        start (if (= :u (:tag run)) @(:next run) 0)\n        memo-key [item (select-keys num cells) start]]\n    (or (get @(:memo ctx) memo-key)\n        (let [sub (new-run ctx num :u start)]\n          (work! ctx (count cells))\n          (enter-slot! sub :V item path)\n          (resolve! sub)\n          (let [spelling (spell-slot sub :V item path)\n                k {:spell spelling :bytes (key-bytes! ctx spelling) :complete? (empty? @(:groups sub))}]\n            (swap! (:memo ctx) assoc memo-key k)\n            k)))))\n\n\n(defn- spell-cell\n  [run c]\n  (let [ctx (:ctx run) [tag k] (get @(:num run) c)]\n    (case tag\n      :n [:cursor-cell [:n k]]\n      :u [:cursor-cell [:u k (get (:ranks ctx) c) (get (:counts ctx) c)]]\n      (throw (ex-info \"Spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n\n\n(defn- spell-slot\n  [run d x path]\n  (work! (:ctx run) 1)\n  (cond\n    (ref? d) (spell-node run x path)\n    (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n    (= :C d) (spell-cell run x)\n    (value-slot? d) (if (nil? x)\n                      x\n                      (case (first x)\n                        :cursor-cell (spell-cell run (second x))\n                        :row [:row (spell-node run (second x) path)]\n                        x))\n    :else x))\n\n\n(defn- spell-node\n  \"Literals and structural data as themselves (by reference), rows expanded\n   in place, keyed rows in key order, a :set or :map as the sorted vector of\n   its members' spellings with each surviving tie group as [:tie K ... K].\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (= :cursor-cells kind) [:cursor-cells]\n      (child-task? ctx n) [:child]\n      (= :task kind)\n      (into [kind] (map (fn [i d x]\n                          (if (contains? #{7 12} i)\n                            (sort-by-key! ctx #(nth % 1) (mapv #(spell-node run % (conj path i (first (:slots %)))) x))\n                            (spell-slot run d x (conj path i))))\n                        (range) ds slots))\n      (contains? keyed-structural kind)\n      (into [kind] (mapcat identity (sort-by-key! ctx first\n                                                  (mapv (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n                                                        (partition 2 slots)))))\n      (= :window kind)\n      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n      (contains? #{:set :map} kind)\n      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n            tied (filterv #(identical? n (:container %)) @(:groups run))\n            tied-elems (set (mapcat :elems tied))\n            plain (into [] (keep (fn [e]\n                                   (when-not (contains? tied-elems e)\n                                     (spell-slot run :V (elem-item kind e) (conj path :member)))))\n                        elems)\n            ties (mapv #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n        (into [kind] (sort-by-key! ctx identity (into plain ties))))\n      :else (into [kind] (map (fn [i d x] (spell-slot run d x (conj path i))) (range) ds slots)))))\n\n\n(defn- discovery-numbering\n  \"The root walk: {:numbering {source -> :yin.k/cc-n}}, or {:refused {:path\n   :cursor-cells}} when a tie group fails the tie test. The census's pair\n   count is charged first, then the depth scan runs, before anything\n   recursive. Throws the resource refusal, or a defect without\n   :yin.k/status when the numbering is not a bijection onto the census.\"\n  [task budget counter]\n  (let [budget (merge default-budget budget)\n        census (:slots (nth (:slots task) 9))]\n    (spend! counter budget :cursor-cells (quot (count census) 2))\n    (if (empty? census)\n      {:numbering {}}\n      (let [ctx {:task task :budget budget :counter counter :memo (atom {}) :cells-memo (atom {})}\n            _ (depth-scan! ctx task)\n            bodies (into {} (map vec) (partition 2 census))\n            ranks (body-ranks ctx bodies)\n            counts (let [acc (atom {})]\n                     (walk-cells ctx [:ref :task] task #(swap! acc update % (fnil inc 0)))\n                     @acc)\n            run (new-run (assoc ctx :ranks ranks :counts counts) {} :n 1)]\n        (enter-node! run task [])\n        (resolve! run)\n        (if-let [refused @(:refused run)]\n          {:refused refused}\n          (let [numbered (set (keys @(:num run))) declared (set (keys bodies))]\n            (when (or (seq @(:groups run)) (not= numbered declared))\n              (throw (ex-info \"Cursor-cell numbering is not total\"\n                              {:missing (vec (sort-by str (remove numbered declared)))\n                               :extra (vec (sort-by str (remove declared numbered)))})))\n            {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))}))))))\n\n\n(defn- unresolved!\n  [refused prefix]\n  (throw (ex-info \"Row codec refused data\"\n                  {:yin.k/status :yin.k/non-portable :yin.k/kind :unresolved-cursor-cells\n                   :yin.k/path (into prefix (:path refused)) :yin.k/cursor-cells (:cursor-cells refused)})))\n\n\n(defn canonical-numbering\n  \"Discovery-order cursor-cell numbering (design note §1): source cursor\n   cell -> :yin.k/cc-n, the n-th cursor cell the canonical walk meets.\n   Refuses :yin.k/non-portable :unresolved-cursor-cells when tied members of\n   a guest set or map cannot be proved interchangeable. A budget exhaustion\n   is a resource refusal, never a canonicality verdict. counter, when\n   supplied, is the atom the charges accumulate in.\"\n  ([task] (canonical-numbering task default-budget))\n  ([task budget] (canonical-numbering task budget (atom {})))\n  ([task budget counter]\n   (let [r (discovery-numbering task budget counter)]\n     (if-let [refused (:refused r)] (unresolved! refused []) (:numbering r)))))\n\n\n(defn- child-numberer\n  \"Numbers an install child in its own scope under budget; a refusal's path\n   is prefixed by the install's row path [12 <name> ...].\"\n  [budget]\n  (fn [child path]\n    (let [r (discovery-numbering child budget (atom {}))]\n      (if-let [refused (:refused r)] (unresolved! refused path) (:numbering r)))))\n\n\n(defn emit-numbered\n  \"Emit under a supplied numbering. Useful for canonicality probes;\n   ordinary callers use emit, which computes the canonical numbering.\n   number-child, (fn [child path] numbering), numbers install children;\n   by default canonically.\"\n  ([task numbering] (emit-numbered task numbering (child-numberer default-budget)))\n  ([task numbering number-child]\n   (let [[id rows] (emit-node task numbering {} [] number-child)]\n     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n\n\n(defn emit\n  \"Emit an abstract task as a self-contained carrier. This is a codec,\n   not lift-task: the caller supplies the complete abstract row tree.\"\n  ([task] (emit task default-budget))\n  ([task budget]\n   (let [budget (merge default-budget budget)\n         [id rows] (emit-node task (canonical-numbering task budget) {} [] (child-numberer budget))]\n     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n\n\n(defn- structural?\n  [kind d x]\n  (cond\n    (and (= :cursor-cells kind) (= :C d)) (and (keyword? x) (some? (re-matches census-key (name x))))\n    (or (ref? d) (= :C d)) (keyword? x)\n    (refs? d) (and (vector? x) (every? keyword? x))\n    (contains? #{:V :optional-V} d)\n    (or (and (= :optional-V d) (nil? x))\n        (and (vector? x) (= 2 (count x)) (contains? #{:lit :row :cursor-cell} (first x))\n             (or (= :lit (first x)) (keyword? (second x)))))\n    (= :N d) (and (code/reg? x) (<= x 4503599627370495))\n    (= :S d) (symbol? x)\n    (= :syms d) (and (vector? x) (every? symbol? x))\n    (= :A d) (some? (jing/parse-segment-address x))\n    :else true))\n\n\n(defn- literal?\n  [x]\n  (and (not (cbor/byte-payload? x))\n       (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n           (number? x)\n           (and (coll? x)\n                (every? literal? (if (map? x) (mapcat identity x) x))\n                (or (nil? (meta x)) (literal? (meta x))))\n           (try (some? (cbor/numeric-kind x))\n                (catch #?(:cljd Object :clj Throwable :cljs :default) _e false)))))\n\n\n(def value-row-kinds #{:vec :list :set :map :closure :prim :stream :reified :parked-ref})\n\n\n(defn- check-abstract!\n  [root]\n  (letfn [(literal-value\n            [x]\n            (cond\n              (map? x) [:map (into {} (map (fn [[k v]] [(literal-value k) (literal-value v)])) x)]\n              (set? x) [:set (set (map literal-value x))]\n              (sequential? x) [:seq (mapv literal-value x)]\n              :else [:literal x]))\n          (value\n            [v]\n            (case (first v)\n              :lit (literal-value (second v))\n              :cursor-cell [:identity (second v)]\n              :row (let [n (second v) ss (:slots n)]\n                     (case (:kind n)\n                       :vec [:seq (mapv value ss)]\n                       :list [:seq (mapv value ss)]\n                       :set [:set (set (map value ss))]\n                       :map [:map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))]\n                       [:row n]))))\n          (reference?\n            [v]\n            (case (first v)\n              :cursor-cell true\n              :lit false\n              :row (let [n (second v)]\n                     (if (contains? #{:vec :list :set :map} (:kind n))\n                       (boolean (some reference? (:slots n))) true))\n              false))\n          (visit\n            [n path cursor-cells reached]\n            (let [{:keys [kind slots]} n ds (descriptors kind slots)]\n              (when (contains? #{:map :set} kind)\n                (let [vs (if (= :set kind) slots (map first (partition 2 slots)))\n                      decoded (map value vs)]\n                  (when-not (= (count decoded) (count (distinct decoded))) (bad! :duplicate-key path))))\n              (when (and (contains? #{:vec :list :set :map} kind)\n                         (not (some reference? slots))) (bad! :reference-free-row path))\n              (doseq [[i d x] (map vector (range) ds slots)]\n                (let [p (conj path i)]\n                  (cond\n                    (= :C d) (do (when-not (contains? cursor-cells x) (bad! :missing-cursor-cell p)) (swap! reached conj x))\n                    (and (ref? d) (= :task (:kind x))) (check-task x p)\n                    (and (ref? d) (not= :cursor-cells (:kind x))) (visit x p cursor-cells reached)\n                    (refs? d) (doseq [[j child] (map-indexed vector x)]\n                                (visit child (conj p j) cursor-cells reached))\n                    (contains? #{:V :optional-V} d)\n                    (when x\n                      (case (first x)\n                        :lit (when-not (literal? (second x)) (bad! :literal p))\n                        :cursor-cell (do (when-not (contains? cursor-cells (second x)) (bad! :missing-cursor-cell p))\n                                         (swap! reached conj (second x)))\n                        :row (visit (second x) p cursor-cells reached)))\n                    :else nil)))))\n          (check-task\n            [task path]\n            (let [slots (:slots task) census (nth slots 9)\n                  cursor-cells (into {} (map vec) (partition 2 (:slots census))) reached (atom #{})]\n              (visit task path cursor-cells reached)\n              (when-not (= (set (keys cursor-cells)) @reached) (bad! :extra-cursor-cell (conj path 9)))))]\n    (when (= :task (:kind root)) (check-task root []))))\n\n\n(defn- decode*\n  \"Validate gate, local schema, finite reachable graph, hashes, canonical\n   form and cursor-cell numbering, then expand structural refs. No attachment.\n   Frame checks are available separately through validate-frames.\"\n  ([wire] (decode* wire default-budget))\n  ([wire budget]\n   (let [budget (merge default-budget budget) counter (atom {})\n         rs (:yin.k/rows wire)]\n     (when-not (and (= true (:yin.k/handoff wire)) (= 3 (:yin.k/version wire))\n                    (code/reg? (:yin.k/version wire)))\n       (refuse! :yin.k/profile-mismatch :version [:yin.k/version]))\n     (when-not (and (= #{:yin.k/handoff :yin.k/version :yin.k/root :yin.k/rows} (set (keys wire)))\n                    (vector? rs) (every? #(and (vector? %) (<= 2 (count %))) rs))\n       (bad! :row-shape [:yin.k/rows]))\n     (spend! counter budget :rows (count rs))\n     (spend! counter budget :bytes (count (seq (cbor/encode wire))))\n     (let [index (into {} (map (fn [r] [(first r) r])) rs)\n           root (:yin.k/root wire)]\n       (when-not (= (count rs) (count index)) (bad! :duplicate-row [:yin.k/rows]))\n       (when-not (contains? #{:task :act :tail :wait} (second (get index root))) (bad! :root [:yin.k/root]))\n       ;; Gate children before schema, with an active path (DAG sharing is legal).\n       (letfn [(gate\n                 [id active]\n                 (when (contains? active id) (bad! :cyclic [id]))\n                 (let [row (get index id) slots (when row (subvec row 2))]\n                   (when-not (and (= :task (second row)) (= 17 (count slots))\n                                  (vector? (nth slots 12)) (every? keyword? (nth slots 12)))\n                     (bad! :task-shape [id]))\n                   (when-not (= 3 (nth slots 0)) (refuse! :yin.k/profile-mismatch :version [id 0]))\n                   (when-not (= profile (nth slots 1)) (refuse! :yin.k/profile-mismatch :profile [id 1]))\n                   (doseq [install (nth slots 12)]\n                     (let [r (get index install)]\n                       (when-not (and (= :install (second r)) (= 7 (count r))) (bad! :install-shape [install]))\n                       (gate (nth r 6) (conj active id))))))]\n         (when (= :task (second (get index root))) (gate root #{})))\n       (doseq [[id kind & slots] rs]\n         (let [schema (get row-table kind) ds (descriptors kind slots)]\n           (when-not (and schema\n                          (cond\n                            (= schema :pending) (contains? pending-table (first slots))\n                            (= :pairs (first schema)) (even? (count slots))\n                            :else true)\n                          (= (count ds) (count slots))) (bad! :row-shape [id]))\n           (doseq [[i d x] (map vector (range) ds slots)]\n             (when-not (structural? kind d x) (bad! :slot-kind [id i])))))\n       (let [seen (atom #{})]\n         (letfn [(walk\n                   [id active depth]\n                   (when (> depth (:depth budget)) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n                   (when (contains? active id) (bad! :cyclic [id]))\n                   (when-not (contains? @seen id)\n                     (let [r (get index id)]\n                       (when-not r (bad! :missing-row [id]))\n                       (let [kind (second r) slots (subvec r 2)]\n                         (doseq [[i d x] (map vector (range) (descriptors kind slots) slots)]\n                           (let [targets (cond (ref? d) [x] (refs? d) x\n                                               (and (contains? #{:V :optional-V} d) (= :row (first x))) [(second x)]\n                                               :else [])]\n                             (doseq [target targets]\n                               (when (and (contains? #{:V :optional-V} d)\n                                          (not (contains? value-row-kinds (second (get index target)))))\n                                 (bad! :value-reference-kind [id i]))\n                               (when (and (or (ref? d) (refs? d))\n                                          (not (contains? (set (rest d)) (second (get index target)))))\n                                 (bad! :reference-kind [id i]))\n                               (walk target (conj active id) (inc depth))))))\n                       (swap! seen conj id))))]\n           (walk root #{} 0)\n           (when-not (= @seen (set (keys index