{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C8B9ufxD1DHLVWzMYTPbY2","type":"tool_result","content":"1100\t  [row]\n1101\t  (mapcat (fn [[_ kind] v]\n1102\t            (case kind :node [v] :nodes v nil))\n1103\t          (get vm/semantic-bytecode-grammar (nth row 1))\n1104\t          (drop 2 row)))\n1105\t\n1106\t\n1107\t(defn- ffi-bookkeeping?\n1108\t  \"A walker parked record that is FFI correlation bookkeeping, not an\n1109\t   explicit park: its continuation is the response wrapper.\"\n1110\t  [rec]\n1111\t  (= :dao.stream.apply/eval-call (:type (:k rec))))\n1112\t\n1113\t\n1114\t;; -----------------------------------------------------------------------------\n1115\t;; The positional profiles' sites, census and layouts\n1116\t;; -----------------------------------------------------------------------------\n1117\t\n1118\t(defn- pc-profile?\n1119\t  [engine]\n1120\t  (contains? #{:stack :register} engine))\n1121\t\n1122\t\n1123\t(defn- site-op\n1124\t  \"The mnemonic of the instruction a positional register map resumes\n1125\t   after: the one before the resume pc (stack), or at the carried site\n1126\t   (register).  nil when it names none.\"\n1127\t  [engine {:keys [segment pc site-pc]}]\n1128\t  (case engine\n1129\t    :stack (when (and (vector? segment) (pos? pc) (<= pc (count segment)))\n1130\t             (first (nth segment (dec pc))))\n1131\t    :register (when-some [ins (:instructions segment)]\n1132\t                (when (and (nat-int? site-pc) (< site-pc (count ins)))\n1133\t                  (first (nth ins site-pc))))\n1134\t    nil))\n1135\t\n1136\t\n1137\t(def ^:private site-reasons\n1138\t  \"The wire reasons each resume-site mnemonic admits (UCF v2 7.2): a\n1139\t   park and a captured continuation admit none, only their explicit\n1140\t   record.\"\n1141\t  {:stream-next #{:next}\n1142\t   :stream-put #{:put}\n1143\t   :ffi-call #{:ffi :ffi-request}\n1144\t   :call #{:next :put :ffi :ffi-request :link-request :link-response\n1145\t           :install}\n1146\t   :park #{}\n1147\t   :current-continuation #{}})\n1148\t\n1149\t\n1150\t(defn- explicit-park?\n1151\t  [engine vm rec]\n1152\t  (case engine\n1153\t    :walker (not (ffi-bookkeeping? rec))\n1154\t    (:stack :register) (= :park (site-op engine rec))\n1155\t    (boolean (some #(= :explicit-park %)\n1156\t                   (safepoint-kinds-at vm (:segment rec) (:pc rec))))))\n1157\t\n1158\t\n1159\t(defn- census-v2\n1160\t  \"The positional profiles' stand-in for the semantic completion walk:\n1161\t   every carried reference is discovered by the encoder itself, so the\n1162\t   census starts from the guest store whole and the explicit parked\n1163\t   records.  FFI bookkeeping records (a parked record whose id is a\n1164\t   retained call's id) are transport, not explicit parks.\"\n1165\t  [engine vm]\n1166\t  (let [justified (into #{}\n1167\t                        (keep #(when (walker-ffi-frame %)\n1168\t                                 (entry-call-id :walker %)))\n1169\t                        (:wait-set vm))]\n1170\t    {:yin.k/refusals []\n1171\t     :yin.k/missing {}\n1172\t     :yin.k/store (:store vm)\n1173\t     :yin.k/scheduler\n1174\t     {:yin.k/parked (into {}\n1175\t                          (filter (fn [[pid rec]]\n1176\t                                    (or (explicit-park? engine vm rec)\n1177\t                                        (and (= :walker engine)\n1178\t                                             (contains? justified pid)))))\n1179\t                          (:parked vm))}}))\n1180\t\n1181\t\n1182\t(defn reachable-parked\n1183\t  \"The ids of the parked records the lift of `vm` would carry, by the\n1184\t   same census the lift runs: the semantic completion walk, or the\n1185\t   positional and walker census.  Answers `{:ids #{...}}`, or\n1186\t   `{:refusal data}` for a walk refusal.  The holder's `enter` moves\n1187\t   exactly these records into its export record.\"\n1188\t  [vm]\n1189\t  (let [engine (try (engine-of vm)\n1190\t                    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n1191\t                      :semantic))]\n1192\t    (if (= :semantic engine)\n1193\t      (let [walked (completion/complete\n1194\t                     {:vm vm\n1195\t                      :cursor-profile (constantly :dao.stream.remote/v1)\n1196\t                      :modules (module-decls vm)})]\n1197\t        (if-some [r (first (:yin.k/refusals walked))]\n1198\t          {:refusal (if (= :yin.k/not-quiescent (:kind r))\n1199\t                      {:yin.k/status :yin.k/not-quiescent}\n1200\t                      (assoc (dissoc r :kind)\n1201\t                             :yin.k/status :yin.k/non-portable\n1202\t                             :yin.k/kind (:kind r)))}\n1203\t          {:ids (set (keys (:yin.k/parked (:yin.k/scheduler walked))))}))\n1204\t      {:ids (set (keys (:yin.k/parked\n1205\t                         (:yin.k/scheduler (census-v2 engine vm)))))})))\n1206\t\n1207\t\n1208\t(defn- walker-free-names\n1209\t  \"The names the walker rows reachable from `roots` read from outside\n1210\t   every enclosing lambda: a `:variable` not bound by a `:lambda` on its\n1211\t   path, the reserved definition operator excepted.\"\n1212\t  [rows roots]\n1213\t  (loop [work (mapv (fn [id] [id #{}]) roots), seen #{}, names #{}]\n1214\t    (if-some [[id bound :as item] (peek work)]\n1215\t      (let [work (pop work)]\n1216\t        (if (contains? seen item)\n1217\t          (recur work seen names)\n1218\t          (let [row (get rows id)\n1219\t                tag (nth row 1)]\n1220\t            (case tag\n1221\t              :variable\n1222\t              (let [n (nth row 2)]\n1223\t                (recur work (conj seen item)\n1224\t                       (if (or (contains? bound n) (vm/reserved-name? n))\n1225\t                         names\n1226\t                         (conj names n))))\n1227\t              :lambda\n1228\t              (recur (conj work [(nth row 3) (into bound (nth row 2))])\n1229\t                     (conj seen item) names)\n1230\t              (recur (into work (map (fn [c] [c bound])) (row-children row))\n1231\t                     (conj seen item) names)))))\n1232\t      names)))\n1233\t\n1234\t\n1235\t(defn- free-names-v2\n1236\t  \"Every name the carried code reads free, by profile: the `:load-free`\n1237\t   names of the layout's images, or the walker rows' free variables.\n1238\t   Over-approximation is admissible: a name that would never be read\n1239\t   still has to be dischargeable.\"\n1240\t  [engine layout code roots]\n1241\t  (case engine\n1242\t    :stack (into #{}\n1243\t                 (comp (mapcat (fn [[_ image]] image))\n1244\t                       (filter #(= :load-free (first %)))\n1245\t                       (map #(nth % 1)))\n1246\t                 layout)\n1247\t    :register (into #{}\n1248\t                    (comp (mapcat (fn [[_ image]] (:instructions image)))\n1249\t                          (filter #(= :load-free (first %)))\n1250\t                          (map #(nth % 2)))\n1251\t                    layout)\n1252\t    :walker (walker-free-names code roots)\n1253\t    #{}))\n1254\t\n1255\t\n1256\t(defn- discharge-names!\n1257\t  \"Rule every free name in `resolve-var`'s order -- the free environment\n1258\t   and every environment carried, the store, the primitives, the module\n1259\t   registry -- or refuse `:yin.k/unsatisfied`, discovery incomplete,\n1260\t   naming what nothing answers.  A host-state primitive is not portable,\n1261\t   and a primitive with no published profile is unsatisfied.\"\n1262\t  [vm names bound installing]\n1263\t  (let [primitives (:primitives vm)\n1264\t        missing (volatile! #{})\n1265\t        profiles (volatile! #{})]\n1266\t    (doseq [sym (remove vm/reserved-name? names)]\n1267\t      (let [profile (vm/profile-of primitives sym)]\n1268\t        (cond\n1269\t          (or (contains? (:free-env vm) sym) (contains? bound sym)\n1270\t              (contains? (:store vm) sym) (contains? installing sym))\n1271\t          nil\n1272\t\n1273\t          (some? profile)\n1274\t          (when (= :host (:yin.k/class profile))\n1275\t            (non-portable! :host-state-primitive {:yin.k/name sym}))\n1276\t\n1277\t          (contains? primitives sym) (vswap! profiles conj sym)\n1278\t\n1279\t          (and (namespace sym)\n1280\t               (some? (module/resolve-module\n1281\t                        (:modules vm)\n1282\t                        (symbol (str (namespace sym) \".\" (name sym))))))\n1283\t          nil\n1284\t\n1285\t          :else (vswap! missing conj sym))))\n1286\t    (when (or (seq @missing) (seq @profiles))\n1287\t      (refuse! :yin.k/unsatisfied\n1288\t               {:yin.k/discovery :incomplete\n1289\t                :yin.k/missing {:obligations @missing\n1290\t                                :profiles @profiles}}))))\n1291\t\n1292\t\n1293\t(defn- compose-v2\n1294\t  \"The code space a layout of `images` builds, under `engine`'s kernel.\"\n1295\t  [engine images]\n1296\t  (case engine\n1297\t    :stack (stack/compose images)\n1298\t    :register (register/compose images)))\n1299\t\n1300\t\n1301\t(defn- layout-images-v2\n1302\t  \"The task layout of positional `vm` as `[[identity image] ...]`, every\n1303\t   image its unrelocated component; a table that does not reproduce its\n1304\t   identities refuses.\"\n1305\t  [engine vm]\n1306\t  (let [v (case engine\n1307\t            :stack (stack/layout-images (:segment vm) (:images vm))\n1308\t            :register (register/layout-images (:segment vm) (:images vm))\n1309\t            nil)]\n1310\t    (when (nil? v)\n1311\t      (non-portable! :inconsistent-state {:yin.k/hint :layout}))\n1312\t    (mapv (fn [[ident _ _] image] [ident image]) (:images vm) v)))\n1313\t\n1314\t\n1315\t;; =============================================================================\n1316\t;; Export (14.1.2 lift): the whole blocked task as canonical bytes\n1317\t;; =============================================================================\n1318\t\n1319\t(defn- module-decls\n1320\t  \"The module declarations the completion walk asks for: each linked\n1321\t   module of the registry under its manifest address.\"\n1322\t  [vm]\n1323\t  (into {}\n1324\t        (map (fn [[m entry]]\n1325\t               [m {:yin.k/manifest (:address entry)}]))\n1326\t        (module/module-entries (:modules vm))))\n1327\t\n1328\t\n1329\t(defn- export-refusals\n1330\t  \"The completion walk's refusals as one data outcome.\"\n1331\t  [refusals]\n1332\t  (when-some [r (first refusals)]\n1333\t    (refuse! (if (= :yin.k/not-quiescent (:kind r))\n1334\t               :yin.k/not-quiescent\n1335\t               :yin.k/non-portable)\n1336\t             (assoc (dissoc r :kind) :yin.k/kind (:kind r)))))\n1337\t\n1338\t\n1339\t(defn- snapshot-module-stores\n1340\t  \"The encoded store snapshot of every module the encoding reached,\n1341\t   exactly as it stands in the task at export, mutations included,\n1342\t   walked in the same canonical order the task store is. Version 1's\n1343\t   fixed point corrects omitted transitive stores; canonical-order's\n1344\t   scratch census never populated this export's found map. Published\n1345\t   version 0 retains its one-pass bytes; only recovery closes its graph.\"\n1346\t  [vm encode found]\n1347\t  (when-some [m (first (remove #(contains? (:module-stores vm) %)\n1348\t                               (sort-by str (:stores @found))))]\n1349\t    (non-portable! :missing-module-store {engine/store-of-key m}))\n1350\t  (let [snapshot (fn [module-id]\n1351\t                   (when-not (contains? (:module-stores vm) module-id)\n1352\t                     (non-portable! :missing-module-store {engine/store-of-key module-id}))\n1353\t                   (into {}\n1354\t                         (map (fn [[key value]] [(encode key) (encode value)]))\n1355\t                         (ordered found key (get (:module-stores vm) module-id))))]\n1356\t    (if (or (:jing-codec @found) (:full-census @found))\n1357\t      (loop [stores {}]\n1358\t        (if-some [module-id (first (sort-by str (set/difference (:stores @found)\n1359\t                                                                (set (keys stores)))))]\n1360\t          (recur (assoc stores module-id (snapshot module-id)))\n1361\t          stores))\n1362\t      (into {} (map (fn [module-id] [module-id (snapshot module-id)]))\n1363\t            (sort-by str (:stores @found))))))\n1364\t\n1365\t\n1366\t(defn- bytes-address\n1367\t  \"The jing segment address of the exact emitted `bytes`, the scheme a\n1368\t   receiver verifies fetched bytes against (`jing/segment-bytes-match?`).\"\n1369\t  [bytes]\n1370\t  (let [algo jing/default-hash-algorithm]\n1371\t    (keyword \"segment\"\n1372\t             (str (get-in jing/registry [algo :address-id]) \"-\"\n1373\t                  (jing/digest-bytes algo bytes)))))\n1374\t\n1375\t\n1376\t(defn- header-of\n1377\t  \"The custody header keys the root body of `kind` carries, from the\n1378\t   caller's `header`: a blocked or parked root takes the occurrence,\n1379\t   arbitration, counter and the exclusive policy, and the origin when\n1380\t   the header names one; a halted root takes the origin alone, its other\n1381\t   values ignored.  A nil value is an absent key.\"\n1382\t  [header kind]\n1383\t  (into {}\n1384\t        (filter (comp some? val))\n1385\t        (if (= :halted kind)\n1386\t          (select-keys header [:yin.k/origin])\n1387\t          (assoc (select-keys header [:yin.k/occurrence :yin.k/arbitration\n1388\t                                      :yin.k/next-op-seq :yin.k/origin])\n1389\t                 :yin.k/policy :yin.k/exclusive))))\n1390\t\n1391\t\n1392\t(defn export-task\n1393\t  \"The lift of 14.1.2: `vm`, a blocked or halted task at a safepoint,\n1394\t   as canonical bytes under their content address.  Answers\n1395\t   `{:status :ok :kind k :body b :bytes encoded :address a}` with `k`\n1396\t   `:blocked`, `:parked` or `:halted`, or the S7.9 data outcome of the\n1397\t   first refusal -- `:yin.k/not-quiescent` for queued work,\n1398\t   `:yin.k/not-at-safepoint` for an undeclared pc, `:yin.k/non-portable`\n1399\t   for a value or reference that cannot cross, `:yin.k/unsatisfied`\n1400\t   for a stream that cannot be served, a cursor that cannot survive\n1401\t   the canonical codec, or -- when `opts` names cursor profiles that\n1402\t   do not cover the cells -- a claim the body cannot make.\n1403\t   `serve!` is the exporter's remote-table entry, exactly\n1404\t   `yin.vm.ucf.remote`'s.  A task that holds an `:observe` entry, an\n1405\t   entry or cell carrying `:yin.k/held`, an unminted cursor cell, a\n1406\t   pending close, or a cursorless `:link-request` entry -- itself or any\n1407\t   install child -- refuses `:yin.k/non-portable` of kind\n1408\t   `:reason-mismatch` before anything is lifted, the same holds\n1409\t   `yin.vm.ucf.holder.export/enter` refuses (UCF 7.4.1, 7.4.3).\n1410\t\n1411\t   `opts` may name `:header`, the version-1 custody header\n1412\t   (`yin.vm.ucf.holder.export/prepare` validates its shape): occurrence,\n1413\t   arbitration, next-op-seq, origin when the task has a predecessor, and\n1414\t   `:yin.k/enrolled`, the set of enrolled stream identities, which is a\n1415\t   lift input and never travels.  No header is the version-0 fork lift,\n1416\t   byte for byte as before; a header is the version-1 exclusive lift in\n1417\t   `dao.jing.cbor`, with `:yin.k/policy :yin.k/exclusive` added here.\n1418\t   The root carries the header by its kind (blocked or parked: all of\n1419\t   it; halted: the origin alone; an install child: none), refuses\n1420\t   `:op-seq-exhausted` at 2^52-1, `:unprotected-pending` and a stream\n1421\t   `:yin.k/unsatisfied` by the enrolled set, orders every map and set\n1422\t   by canonical key bytes, and before answering runs the version-1\n1423\t   inspector over its own bytes and address and then `validate-body`:\n1424\t   whatever either refuses is the lift's refusal, and nothing is\n1425\t   answered.  `:serve-keyed`, `(f [path resource-id] handle)`, replaces\n1426\t   `serve!` and retains each answer under the task path and the\n1427\t   resource id.\n1428\t\n1429\t   `:version 2` selects the version-2 body of the four execution\n1430\t   profiles (semantic, stack, register, walker), the profile being the\n1431\t   kernel's own: no header is the fork, a header the exclusive lift, and\n1432\t   the roles are structural (the v2 amendment, section 3).  The\n1433\t   composition chooses it; it is never inferred, and without it the lift\n1434\t   is exactly the version-0 or version-1 lift as before.\"\n1435\t  ([vm serve!]\n1436\t   (export-task vm serve! nil))\n1437\t  ([vm serve! opts]\n1438\t   (call!\n1439\t     (fn []\n1440\t       (when (seq (:ready-queue vm))\n1441\t         (refuse! :yin.k/not-quiescent\n1442\t                  {:yin.k/ready (count (:ready-queue vm))}))\n1443\t       (when-some [h (unliftable-hold vm)]\n1444\t         (non-portable! :reason-mismatch h))\n1445\t       (let [header (:header opts)\n1446\t             child? (::child opts)\n1447\t             v2? (= 2 (:version opts))\n1448\t             engine (when v2? (engine-of vm))\n1449\t             ;; `jing-codec?` names the jing wire and the exclusive-style\n1450\t             ;; lift, not \"version 1\": version 2 selects it too, and the\n1451\t             ;; version is dispatched separately, by `v2?` and the body's\n1452\t             ;; validated structural role (v2 amendment, section 10).\n1453\t             jing-codec? (boolean (or (some? header) (::jing-codec opts) v2?))\n1454\t             keyed (or (:serve-keyed opts) (fn [_ h] (serve! h)))\n1455\t             ;; grounded: ClojureDart compiles a many-key assoc onto nil\n1456\t             ;; as a conj, whose answer is a list no dissoc accepts\n1457\t             opts (assoc (or opts {})\n1458\t                         :path (or (:path opts) [])\n1459\t                         ::jing-codec jing-codec?\n1460\t                         ::enrolled (or (:yin.k/enrolled header)\n1461\t                                        (::enrolled opts)\n1462\t                                        #{})\n1463\t                         :serve-keyed keyed)\n1464\t             serve! (fn [id h] (keyed [(:path opts) id] h))\n1465\t             {:keys [encode-bytes decode-bytes]}\n1466\t             (if jing-codec?\n1467\t               {:encode-bytes jing.cbor/encode :decode-bytes jing.cbor/decode}\n1468\t               {:encode-bytes cbor/encode :decode-bytes cbor/decode})\n1469\t             walked (if (and v2? (not= :semantic engine))\n1470\t                      (census-v2 engine vm)\n1471\t                      (completion/complete\n1472\t                        {:vm vm\n1473\t                         :cursor-profile (constantly :dao.stream.remote/v1)\n1474\t                         :modules (module-decls vm)}))\n1475\t             _ (export-refusals (:yin.k/refusals walked))\n1476\t             ;; the pending-child gap the walk cannot close itself: an\n1477\t             ;; obligation a live install child will bind when it\n1478\t             ;; completes is discharged by the child this body carries\n1479\t             ;; beside the waiter, not by a store the emitter holds\n1480\t             installing (into #{}\n1481\t                              (mapcat (fn [[m inst]]\n1482\t                                        (map (fn [x]\n1483\t                                               (symbol (str (name m) \"/\"\n1484\t                                                            (name x))))\n1485\t                                             (get-in inst\n1486\t                                                     [:response :manifest\n1487\t                                                      :yin.module/exports])))\n1488\t                                      (:installs vm)))\n1489\t             missing (update (:yin.k/missing walked) :obligations\n1490\t                             #(set/difference (set %) installing))\n1491\t             discovery (cond\n1492\t                         (seq (:segments missing)) :blocked\n1493\t                         (some seq (vals (dissoc missing :segments)))\n1494\t                         :incomplete\n1495\t                         :else :complete)]\n1496\t         (when-not (= :complete discovery)\n1497\t           (refuse! :yin.k/unsatisfied\n1498\t                    {:yin.k/discovery discovery\n1499\t                     :yin.k/missing missing}))\n1500\t         (let [value (:value vm)\n1501\t               active (and (map? value)\n1502\t                           (= :parked-continuation (:type value))\n1503\t                           (contains? (:parked vm) (:id value)))\n1504\t               active-rec (when active (get (:parked vm) (:id value)))\n1505\t               kind (cond\n1506\t                      active :parked\n1507\t                      (engine/halted-with-empty-queue? vm) :halted\n1508\t                      (seq (:wait-set vm)) :blocked\n1509\t                      :else (not-at-safepoint!\n1510\t                              (get-in vm [:control :pc])))\n1511\t               _ (when (and (= :halted kind) (seq (:wait-set vm)))\n1512\t                   (non-portable! :inconsistent-halt {}))\n1513\t               _ (when (and jing-codec? (not child?) (not= :halted kind)\n1514\t                            (let [n (:yin.k/next-op-seq header)]\n1515\t                              (and (jing.cbor/numeric? n)\n1516\t                                   (jing.cbor/num= n checkpoint/max-exact))))\n1517\t                   (non-portable! :op-seq-exhausted\n1518\t                                  {:yin.k/next-op-seq\n1519\t                                   (:yin.k/next-op-seq header)}))\n1520\t               _ (when (and active\n1521\t                            (not (explicit-park? engine vm active-rec)))\n1522\t                   (non-portable! :reason-mismatch\n1523\t                                  {:yin.k/pc (:pc active-rec)}))\n1524\t               found (atom (cond-> (assoc (new-found)\n1525\t                                          :jing-codec jing-codec?\n1526\t                                          :full-census (::recovery opts)\n1527\t                                          :recovery-cell-ids (:yin.k/recovery-cell-ids vm)\n1528\t                                          :enrolled (::enrolled opts))\n1529\t                             v2? (assoc :v2 {:engine engine})\n1530\t                             jing-codec? (assoc :order\n1531\t                                                (canonical-order\n1532\t                                                  vm serve!\n1533\t                                                  (when v2? {:engine engine})))))\n1534\t               encode (value-encoder vm serve! found)\n1535\t               frames (mapv (partial lift-frame! vm serve! found encode)\n1536\t                            (:wait-set vm))\n1537\t               parked (into {}\n1538\t                            (map (fn [[pid rec]]\n1539\t                                   (when-not (and v2? (not= :semantic engine))\n1540\t                                     (safepoint-kinds-at vm (:segment rec)\n1541\t                                                         (:pc rec)))\n1542\t                                   [pid (if v2?\n1543\t                                          (registers-v2 engine found encode\n1544\t                                                        vm rec)\n1545\t                                          (encode-registers found encode\n1546\t                                                            vm rec))]))\n1547\t                            (ordered found key\n1548\t                                     (:yin.k/parked\n1549\t                                       (:yin.k/scheduler walked))))\n1550\t               store (into {}\n1551\t                           (map (fn [[k v]] [(encode k) (encode v)]))\n1552\t                           (ordered found key (:yin.k/store walked)))\n1553\t               ;; the halted result is encoded before any dependency is\n1554\t               ;; finalized: it can reach cells, module closures and code\n1555\t               ;; the halted result is encoded before any dependency is\n1556\t               ;; finalized: it can reach cells, module closures and code\n1557\t               result (when (= :halted kind) (encode (:value vm)))\n1558\t               module-stores (snapshot-module-stores vm encode found)\n1559\t               installs (export-installs vm nil (dissoc opts :header))\n1560\t               cells (:cells @found)\n1561\t               profiles (or (:cursor-profiles opts)\n1562\t                            (if (seq cells)\n1563\t                              ucf.remote/cursor-profiles\n1564\t                              #{}))\n1565\t               _ (when (and (seq cells)\n1566\t                            (not (contains? profiles\n1567\t                                            :dao.stream.remote/v1)))\n1568\t                   (unsatisfied!))\n1569\t               layout (when (pc-profile? engine)\n1570\t                        (layout-images-v2 engine vm))\n1571\t               free-env (when (pc-profile? engine)\n1572\t                          (encode-env-v2 found encode (:free-env vm)))\n1573\t               walker-code (when (= :walker engine)\n1574\t                             (walker-code-v2 vm found))\n1575\t               _ (when (and v2? (not= :semantic engine))\n1576\t                   (discharge-names!\n1577\t                     vm\n1578\t                     (free-names-v2 engine layout (or walker-code {})\n1579\t                                    (into (or (:roots @found) #{})\n1580\t                                          (:segments @found)))\n1581\t                     (or (:bound @found) #{})\n1582\t                     installing))\n1583\t               segments (if walker-code\n1584\t                          (set (keys walker-code))\n1585\t                          (into (:segments @found) (map first) layout))\n1586\t               images (into {} layout)\n1587\t               fetch (if (pc-profile? engine)\n1588\t                       #(get images %)\n1589\t                       (completion/vm-fetch vm nil))\n1590\t               code (or walker-code\n1591\t                        (into {}\n1592\t                              (map (fn [a]\n1593\t                                     (if-some [v (fetch a)]\n1594\t                                       [a v]\n1595\t                                       (refuse! :yin.k/unsatisfied\n1596\t                                                {:yin.k/segment a}))))\n1597\t                              (sort-by str segments)))\n1598\t               _ (when-some [p (first (remove #(contains? parked %)\n1599\t                                              (:parked-refs @found)))]\n1600\t                   (non-portable! :inconsistent-state\n1601\t                                  {:yin.k/hint :parked-reference\n1602\t                                   :yin.k/parked-id p}))\n1603\t               body (cond-> {handoff-tag true\n1604\t                             :yin.k/version (cond v2? 2 jing-codec? 1 :else 0)\n1605\t                             :yin.k/kind kind\n1606\t                             :yin.k/contract (if v2?\n1607\t                                               (get ucf/profiles engine)\n1608\t                                               ucf/contract-stamp)\n1609\t                             :yin.k/id-counter (or (:id-counter vm) 0)\n1610\t                             :yin.k/store store\n1611\t                             :yin.k/module-stores module-stores\n1612\t                             :yin.k/parked parked\n1613\t                             :yin.k/cells cells\n1614\t                             :yin.k/requires\n1615\t                             {:yin.k/cursor-profiles profiles\n1616\t                              :yin.k/segments (set segments)}\n1617\t                             :yin.k/code code}\n1618\t                      (pc-profile? engine)\n1619\t                      (assoc :yin.k/layout (mapv first layout)\n1620\t                             :yin.k/free-env free-env)\n1621\t                      (or v2? (seq installs))\n1622\t                      (assoc :yin.k/installs installs)\n1623\t                      (or (seq frames) (and v2? (= :parked kind)))\n1624\t                      (assoc :yin.k/frames frames)\n1625\t                      (= :parked kind)\n1626\t                      (assoc :yin.k/parked-id (:id value))\n1627\t                      (= :halted kind)\n1628\t                      (assoc :yin.k/result result)\n1629\t                      (and jing-codec? (not child?) header)\n1630\t                      (merge (header-of header kind)))\n1631\t               bytes (if jing-codec?\n1632\t                       (try (encode-bytes body)\n1633\t                            (catch #?(:cljd Object\n1634\t                                      :clj Throwable\n1635\t                                      :cljs :default) e\n1636\t                              (if (outcome e)\n1637\t                                (throw e)\n1638\t                                (non-portable! :non-canonicalizable\n1639\t                                               {:yin.k/hint\n1640\t                                                (jing.cbor/refusal e)}))))\n1641\t                       (encode-bytes body))\n1642\t               address (bytes-address bytes)\n1643\t               _ (when (and jing-codec? (not child?))\n1644\t                   (let [r (checkpoint/inspect address bytes)]\n1645\t                     (when (contains? r :yin.k/status)\n1646\t                       (refuse! (:yin.k/status r) (dissoc r :yin.k/status)))))\n1647\t               _ (validate-body (decode-bytes bytes))]\n1648\t           {:status :ok\n1649\t            :kind kind\n1650\t            :body body\n1651\t            :bytes bytes\n1652\t            :address address}))))))\n1653\t\n1654\t\n1655\t;; =============================================================================\n1656\t;; Grammar (S7.5.4): total, before anything is attached or restored\n1657\t;; =============================================================================\n1658\t\n1659\t(defn- marker?"}]},"parent_tool_use_id":null,"session_id":"ee657710-cc1c-4c43-882b-5874c9a79051","uuid":"87b5b1c7-a639-4042-a8e9-ead7a44cc49f","timestamp":"2026-10-12T15:53:12.378Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6b/src/cljc/yin/vm/ucf/handoff.cljc","content":"  [row]\n  (mapcat (fn [[_ kind] v]\n            (case kind :node [v] :nodes v nil))\n          (get vm/semantic-bytecode-grammar (nth row 1))\n          (drop 2 row)))\n\n\n(defn- ffi-bookkeeping?\n  \"A walker parked record that is FFI correlation bookkeeping, not an\n   explicit park: its continuation is the response wrapper.\"\n  [rec]\n  (= :dao.stream.apply/eval-call (:type (:k rec))))\n\n\n;; -----------------------------------------------------------------------------\n;; The positional profiles' sites, census and layouts\n;; -----------------------------------------------------------------------------\n\n(defn- pc-profile?\n  [engine]\n  (contains? #{:stack :register} engine))\n\n\n(defn- site-op\n  \"The mnemonic of the instruction a positional register map resumes\n   after: the one before the resume pc (stack), or at the carried site\n   (register).  nil when it names none.\"\n  [engine {:keys [segment pc site-pc]}]\n  (case engine\n    :stack (when (and (vector? segment) (pos? pc) (<= pc (count segment)))\n             (first (nth segment (dec pc))))\n    :register (when-some [ins (:instructions segment)]\n                (when (and (nat-int? site-pc) (< site-pc (count ins)))\n                  (first (nth ins site-pc))))\n    nil))\n\n\n(def ^:private site-reasons\n  \"The wire reasons each resume-site mnemonic admits (UCF v2 7.2): a\n   park and a captured continuation admit none, only their explicit\n   record.\"\n  {:stream-next #{:next}\n   :stream-put #{:put}\n   :ffi-call #{:ffi :ffi-request}\n   :call #{:next :put :ffi :ffi-request :link-request :link-response\n           :install}\n   :park #{}\n   :current-continuation #{}})\n\n\n(defn- explicit-park?\n  [engine vm rec]\n  (case engine\n    :walker (not (ffi-bookkeeping? rec))\n    (:stack :register) (= :park (site-op engine rec))\n    (boolean (some #(= :explicit-park %)\n                   (safepoint-kinds-at vm (:segment rec) (:pc rec))))))\n\n\n(defn- census-v2\n  \"The positional profiles' stand-in for the semantic completion walk:\n   every carried reference is discovered by the encoder itself, so the\n   census starts from the guest store whole and the explicit parked\n   records.  FFI bookkeeping records (a parked record whose id is a\n   retained call's id) are transport, not explicit parks.\"\n  [engine vm]\n  (let [justified (into #{}\n                        (keep #(when (walker-ffi-frame %)\n                                 (entry-call-id :walker %)))\n                        (:wait-set vm))]\n    {:yin.k/refusals []\n     :yin.k/missing {}\n     :yin.k/store (:store vm)\n     :yin.k/scheduler\n     {:yin.k/parked (into {}\n                          (filter (fn [[pid rec]]\n                                    (or (explicit-park? engine vm rec)\n                                        (and (= :walker engine)\n                                             (contains? justified pid)))))\n                          (:parked vm))}}))\n\n\n(defn reachable-parked\n  \"The ids of the parked records the lift of `vm` would carry, by the\n   same census the lift runs: the semantic completion walk, or the\n   positional and walker census.  Answers `{:ids #{...}}`, or\n   `{:refusal data}` for a walk refusal.  The holder's `enter` moves\n   exactly these records into its export record.\"\n  [vm]\n  (let [engine (try (engine-of vm)\n                    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n                      :semantic))]\n    (if (= :semantic engine)\n      (let [walked (completion/complete\n                     {:vm vm\n                      :cursor-profile (constantly :dao.stream.remote/v1)\n                      :modules (module-decls vm)})]\n        (if-some [r (first (:yin.k/refusals walked))]\n          {:refusal (if (= :yin.k/not-quiescent (:kind r))\n                      {:yin.k/status :yin.k/not-quiescent}\n                      (assoc (dissoc r :kind)\n                             :yin.k/status :yin.k/non-portable\n                             :yin.k/kind (:kind r)))}\n          {:ids (set (keys (:yin.k/parked (:yin.k/scheduler walked))))}))\n      {:ids (set (keys (:yin.k/parked\n                         (:yin.k/scheduler (census-v2 engine vm)))))})))\n\n\n(defn- walker-free-names\n  \"The names the walker rows reachable from `roots` read from outside\n   every enclosing lambda: a `:variable` not bound by a `:lambda` on its\n   path, the reserved definition operator excepted.\"\n  [rows roots]\n  (loop [work (mapv (fn [id] [id #{}]) roots), seen #{}, names #{}]\n    (if-some [[id bound :as item] (peek work)]\n      (let [work (pop work)]\n        (if (contains? seen item)\n          (recur work seen names)\n          (let [row (get rows id)\n                tag (nth row 1)]\n            (case tag\n              :variable\n              (let [n (nth row 2)]\n                (recur work (conj seen item)\n                       (if (or (contains? bound n) (vm/reserved-name? n))\n                         names\n                         (conj names n))))\n              :lambda\n              (recur (conj work [(nth row 3) (into bound (nth row 2))])\n                     (conj seen item) names)\n              (recur (into work (map (fn [c] [c bound])) (row-children row))\n                     (conj seen item) names)))))\n      names)))\n\n\n(defn- free-names-v2\n  \"Every name the carried code reads free, by profile: the `:load-free`\n   names of the layout's images, or the walker rows' free variables.\n   Over-approximation is admissible: a name that would never be read\n   still has to be dischargeable.\"\n  [engine layout code roots]\n  (case engine\n    :stack (into #{}\n                 (comp (mapcat (fn [[_ image]] image))\n                       (filter #(= :load-free (first %)))\n                       (map #(nth % 1)))\n                 layout)\n    :register (into #{}\n                    (comp (mapcat (fn [[_ image]] (:instructions image)))\n                          (filter #(= :load-free (first %)))\n                          (map #(nth % 2)))\n                    layout)\n    :walker (walker-free-names code roots)\n    #{}))\n\n\n(defn- discharge-names!\n  \"Rule every free name in `resolve-var`'s order -- the free environment\n   and every environment carried, the store, the primitives, the module\n   registry -- or refuse `:yin.k/unsatisfied`, discovery incomplete,\n   naming what nothing answers.  A host-state primitive is not portable,\n   and a primitive with no published profile is unsatisfied.\"\n  [vm names bound installing]\n  (let [primitives (:primitives vm)\n        missing (volatile! #{})\n        profiles (volatile! #{})]\n    (doseq [sym (remove vm/reserved-name? names)]\n      (let [profile (vm/profile-of primitives sym)]\n        (cond\n          (or (contains? (:free-env vm) sym) (contains? bound sym)\n              (contains? (:store vm) sym) (contains? installing sym))\n          nil\n\n          (some? profile)\n          (when (= :host (:yin.k/class profile))\n            (non-portable! :host-state-primitive {:yin.k/name sym}))\n\n          (contains? primitives sym) (vswap! profiles conj sym)\n\n          (and (namespace sym)\n               (some? (module/resolve-module\n                        (:modules vm)\n                        (symbol (str (namespace sym) \".\" (name sym))))))\n          nil\n\n          :else (vswap! missing conj sym))))\n    (when (or (seq @missing) (seq @profiles))\n      (refuse! :yin.k/unsatisfied\n               {:yin.k/discovery :incomplete\n                :yin.k/missing {:obligations @missing\n                                :profiles @profiles}}))))\n\n\n(defn- compose-v2\n  \"The code space a layout of `images` builds, under `engine`'s kernel.\"\n  [engine images]\n  (case engine\n    :stack (stack/compose images)\n    :register (register/compose images)))\n\n\n(defn- layout-images-v2\n  \"The task layout of positional `vm` as `[[identity image] ...]`, every\n   image its unrelocated component; a table that does not reproduce its\n   identities refuses.\"\n  [engine vm]\n  (let [v (case engine\n            :stack (stack/layout-images (:segment vm) (:images vm))\n            :register (register/layout-images (:segment vm) (:images vm))\n            nil)]\n    (when (nil? v)\n      (non-portable! :inconsistent-state {:yin.k/hint :layout}))\n    (mapv (fn [[ident _ _] image] [ident image]) (:images vm) v)))\n\n\n;; =============================================================================\n;; Export (14.1.2 lift): the whole blocked task as canonical bytes\n;; =============================================================================\n\n(defn- module-decls\n  \"The module declarations the completion walk asks for: each linked\n   module of the registry under its manifest address.\"\n  [vm]\n  (into {}\n        (map (fn [[m entry]]\n               [m {:yin.k/manifest (:address entry)}]))\n        (module/module-entries (:modules vm))))\n\n\n(defn- export-refusals\n  \"The completion walk's refusals as one data outcome.\"\n  [refusals]\n  (when-some [r (first refusals)]\n    (refuse! (if (= :yin.k/not-quiescent (:kind r))\n               :yin.k/not-quiescent\n               :yin.k/non-portable)\n             (assoc (dissoc r :kind) :yin.k/kind (:kind r)))))\n\n\n(defn- snapshot-module-stores\n  \"The encoded store snapshot of every module the encoding reached,\n   exactly as it stands in the task at export, mutations included,\n   walked in the same canonical order the task store is. Version 1's\n   fixed point corrects omitted transitive stores; canonical-order's\n   scratch census never populated this export's found map. Published\n   version 0 retains its one-pass bytes; only recovery closes its graph.\"\n  [vm encode found]\n  (when-some [m (first (remove #(contains? (:module-stores vm) %)\n                               (sort-by str (:stores @found))))]\n    (non-portable! :missing-module-store {engine/store-of-key m}))\n  (let [snapshot (fn [module-id]\n                   (when-not (contains? (:module-stores vm) module-id)\n                     (non-portable! :missing-module-store {engine/store-of-key module-id}))\n                   (into {}\n                         (map (fn [[key value]] [(encode key) (encode value)]))\n                         (ordered found key (get (:module-stores vm) module-id))))]\n    (if (or (:jing-codec @found) (:full-census @found))\n      (loop [stores {}]\n        (if-some [module-id (first (sort-by str (set/difference (:stores @found)\n                                                                (set (keys stores)))))]\n          (recur (assoc stores module-id (snapshot module-id)))\n          stores))\n      (into {} (map (fn [module-id] [module-id (snapshot module-id)]))\n            (sort-by str (:stores @found))))))\n\n\n(defn- bytes-address\n  \"The jing segment address of the exact emitted `bytes`, the scheme a\n   receiver verifies fetched bytes against (`jing/segment-bytes-match?`).\"\n  [bytes]\n  (let [algo jing/default-hash-algorithm]\n    (keyword \"segment\"\n             (str (get-in jing/registry [algo :address-id]) \"-\"\n                  (jing/digest-bytes algo bytes)))))\n\n\n(defn- header-of\n  \"The custody header keys the root body of `kind` carries, from the\n   caller's `header`: a blocked or parked root takes the occurrence,\n   arbitration, counter and the exclusive policy, and the origin when\n   the header names one; a halted root takes the origin alone, its other\n   values ignored.  A nil value is an absent key.\"\n  [header kind]\n  (into {}\n        (filter (comp some? val))\n        (if (= :halted kind)\n          (select-keys header [:yin.k/origin])\n          (assoc (select-keys header [:yin.k/occurrence :yin.k/arbitration\n                                      :yin.k/next-op-seq :yin.k/origin])\n                 :yin.k/policy :yin.k/exclusive))))\n\n\n(defn export-task\n  \"The lift of 14.1.2: `vm`, a blocked or halted task at a safepoint,\n   as canonical bytes under their content address.  Answers\n   `{:status :ok :kind k :body b :bytes encoded :address a}` with `k`\n   `:blocked`, `:parked` or `:halted`, or the S7.9 data outcome of the\n   first refusal -- `:yin.k/not-quiescent` for queued work,\n   `:yin.k/not-at-safepoint` for an undeclared pc, `:yin.k/non-portable`\n   for a value or reference that cannot cross, `:yin.k/unsatisfied`\n   for a stream that cannot be served, a cursor that cannot survive\n   the canonical codec, or -- when `opts` names cursor profiles that\n   do not cover the cells -- a claim the body cannot make.\n   `serve!` is the exporter's remote-table entry, exactly\n   `yin.vm.ucf.remote`'s.  A task that holds an `:observe` entry, an\n   entry or cell carrying `:yin.k/held`, an unminted cursor cell, a\n   pending close, or a cursorless `:link-request` entry -- itself or any\n   install child -- refuses `:yin.k/non-portable` of kind\n   `:reason-mismatch` before anything is lifted, the same holds\n   `yin.vm.ucf.holder.export/enter` refuses (UCF 7.4.1, 7.4.3).\n\n   `opts` may name `:header`, the version-1 custody header\n   (`yin.vm.ucf.holder.export/prepare` validates its shape): occurrence,\n   arbitration, next-op-seq, origin when the task has a predecessor, and\n   `:yin.k/enrolled`, the set of enrolled stream identities, which is a\n   lift input and never travels.  No header is the version-0 fork lift,\n   byte for byte as before; a header is the version-1 exclusive lift in\n   `dao.jing.cbor`, with `:yin.k/policy :yin.k/exclusive` added here.\n   The root carries the header by its kind (blocked or parked: all of\n   it; halted: the origin alone; an install child: none), refuses\n   `:op-seq-exhausted` at 2^52-1, `:unprotected-pending` and a stream\n   `:yin.k/unsatisfied` by the enrolled set, orders every map and set\n   by canonical key bytes, and before answering runs the version-1\n   inspector over its own bytes and address and then `validate-body`:\n   whatever either refuses is the lift's refusal, and nothing is\n   answered.  `:serve-keyed`, `(f [path resource-id] handle)`, replaces\n   `serve!` and retains each answer under the task path and the\n   resource id.\n\n   `:version 2` selects the version-2 body of the four execution\n   profiles (semantic, stack, register, walker), the profile being the\n   kernel's own: no header is the fork, a header the exclusive lift, and\n   the roles are structural (the v2 amendment, section 3).  The\n   composition chooses it; it is never inferred, and without it the lift\n   is exactly the version-0 or version-1 lift as before.\"\n  ([vm serve!]\n   (export-task vm serve! nil))\n  ([vm serve! opts]\n   (call!\n     (fn []\n       (when (seq (:ready-queue vm))\n         (refuse! :yin.k/not-quiescent\n                  {:yin.k/ready (count (:ready-queue vm))}))\n       (when-some [h (unliftable-hold vm)]\n         (non-portable! :reason-mismatch h))\n       (let [header (:header opts)\n             child? (::child opts)\n             v2? (= 2 (:version opts))\n             engine (when v2? (engine-of vm))\n             ;; `jing-codec?` names the jing wire and the exclusive-style\n             ;; lift, not \"version 1\": version 2 selects it too, and the\n             ;; version is dispatched separately, by `v2?` and the body's\n             ;; validated structural role (v2 amendment, section 10).\n             jing-codec? (boolean (or (some? header) (::jing-codec opts) v2?))\n             keyed (or (:serve-keyed opts) (fn [_ h] (serve! h)))\n             ;; grounded: ClojureDart compiles a many-key assoc onto nil\n             ;; as a conj, whose answer is a list no dissoc accepts\n             opts (assoc (or opts {})\n                         :path (or (:path opts) [])\n                         ::jing-codec jing-codec?\n                         ::enrolled (or (:yin.k/enrolled header)\n                                        (::enrolled opts)\n                                        #{})\n                         :serve-keyed keyed)\n             serve! (fn [id h] (keyed [(:path opts) id] h))\n             {:keys [encode-bytes decode-bytes]}\n             (if jing-codec?\n               {:encode-bytes jing.cbor/encode :decode-bytes jing.cbor/decode}\n               {:encode-bytes cbor/encode :decode-bytes cbor/decode})\n             walked (if (and v2? (not= :semantic engine))\n                      (census-v2 engine vm)\n                      (completion/complete\n                        {:vm vm\n                         :cursor-profile (constantly :dao.stream.remote/v1)\n                         :modules (module-decls vm)}))\n             _ (export-refusals (:yin.k/refusals walked))\n             ;; the pending-child gap the walk cannot close itself: an\n             ;; obligation a live install child will bind when it\n             ;; completes is discharged by the child this body carries\n             ;; beside the waiter, not by a store the emitter holds\n             installing (into #{}\n                              (mapcat (fn [[m inst]]\n                                        (map (fn [x]\n                                               (symbol (str (name m) \"/\"\n                                                            (name x))))\n                                             (get-in inst\n                                                     [:response :manifest\n                                                      :yin.module/exports])))\n                                      (:installs vm)))\n             missing (update (:yin.k/missing walked) :obligations\n                             #(set/difference (set %) installing))\n             discovery (cond\n                         (seq (:segments missing)) :blocked\n                         (some seq (vals (dissoc missing :segments)))\n                         :incomplete\n                         :else :complete)]\n         (when-not (= :complete discovery)\n           (refuse! :yin.k/unsatisfied\n                    {:yin.k/discovery discovery\n                     :yin.k/missing missing}))\n         (let [value (:value vm)\n               active (and (map? value)\n                           (= :parked-continuation (:type value))\n                           (contains? (:parked vm) (:id value)))\n               active-rec (when active (get (:parked vm) (:id value)))\n               kind (cond\n                      active :parked\n                      (engine/halted-with-empty-queue? vm) :halted\n                      (seq (:wait-set vm)) :blocked\n                      :else (not-at-safepoint!\n                              (get-in vm [:control :pc])))\n               _ (when (and (= :halted kind) (seq (:wait-set vm)))\n                   (non-portable! :inconsistent-halt {}))\n               _ (when (and jing-codec? (not child?) (not= :halted kind)\n                            (let [n (:yin.k/next-op-seq header)]\n                              (and (jing.cbor/numeric? n)\n                                   (jing.cbor/num= n checkpoint/max-exact))))\n                   (non-portable! :op-seq-exhausted\n                                  {:yin.k/next-op-seq\n                                   (:yin.k/next-op-seq header)}))\n               _ (when (and active\n                            (not (explicit-park? engine vm active-rec)))\n                   (non-portable! :reason-mismatch\n                                  {:yin.k/pc (:pc active-rec)}))\n               found (atom (cond-> (assoc (new-found)\n                                          :jing-codec jing-codec?\n                                          :full-census (::recovery opts)\n                                          :recovery-cell-ids (:yin.k/recovery-cell-ids vm)\n                                          :enrolled (::enrolled opts))\n                             v2? (assoc :v2 {:engine engine})\n                             jing-codec? (assoc :order\n                                                (canonical-order\n                                                  vm serve!\n                                                  (when v2? {:engine engine})))))\n               encode (value-encoder vm serve! found)\n               frames (mapv (partial lift-frame! vm serve! found encode)\n                            (:wait-set vm))\n               parked (into {}\n                            (map (fn [[pid rec]]\n                                   (when-not (and v2? (not= :semantic engine))\n                                     (safepoint-kinds-at vm (:segment rec)\n                                                         (:pc rec)))\n                                   [pid (if v2?\n                                          (registers-v2 engine found encode\n                                                        vm rec)\n                                          (encode-registers found encode\n                                                            vm rec))]))\n                            (ordered found key\n                                     (:yin.k/parked\n                                       (:yin.k/scheduler walked))))\n               store (into {}\n                           (map (fn [[k v]] [(encode k) (encode v)]))\n                           (ordered found key (:yin.k/store walked)))\n               ;; the halted result is encoded before any dependency is\n               ;; finalized: it can reach cells, module closures and code\n               ;; the halted result is encoded before any dependency is\n               ;; finalized: it can reach cells, module closures and code\n               result (when (= :halted kind) (encode (:value vm)))\n               module-stores (snapshot-module-stores vm encode found)\n               installs (export-installs vm nil (dissoc opts :header))\n               cells (:cells @found)\n               profiles (or (:cursor-profiles opts)\n                            (if (seq cells)\n                              ucf.remote/cursor-profiles\n                              #{}))\n               _ (when (and (seq cells)\n                            (not (contains? profiles\n                                            :dao.stream.remote/v1)))\n                   (unsatisfied!))\n               layout (when (pc-profile? engine)\n                        (layout-images-v2 engine vm))\n               free-env (when (pc-profile? engine)\n                          (encode-env-v2 found encode (:free-env vm)))\n               walker-code (when (= :walker engine)\n                             (walker-code-v2 vm found))\n               _ (when (and v2? (not= :semantic engine))\n                   (discharge-names!\n                     vm\n                     (free-names-v2 engine layout (or walker-code {})\n                                    (into (or (:roots @found) #{})\n                                          (:segments @found)))\n                     (or (:bound @found) #{})\n                     installing))\n               segments (if walker-code\n                          (set (keys walker-code))\n                          (into (:segments @found) (map first) layout))\n               images (into {} layout)\n               fetch (if (pc-profile? engine)\n                       #(get images %)\n                       (completion/vm-fetch vm nil))\n               code (or walker-code\n                        (into {}\n                              (map (fn [a]\n                                     (if-some [v (fetch a)]\n                                       [a v]\n                                       (refuse! :yin.k/unsatisfied\n                                                {:yin.k/segment a}))))\n                              (sort-by str segments)))\n               _ (when-some [p (first (remove #(contains? parked %)\n                                              (:parked-refs @found)))]\n                   (non-portable! :inconsistent-state\n                                  {:yin.k/hint :parked-reference\n                                   :yin.k/parked-id p}))\n               body (cond-> {handoff-tag true\n                             :yin.k/version (cond v2? 2 jing-codec? 1 :else 0)\n                             :yin.k/kind kind\n                             :yin.k/contract (if v2?\n                                               (get ucf/profiles engine)\n                                               ucf/contract-stamp)\n                             :yin.k/id-counter (or (:id-counter vm) 0)\n                             :yin.k/store store\n                             :yin.k/module-stores module-stores\n                             :yin.k/parked parked\n                             :yin.k/cells cells\n                             :yin.k/requires\n                             {:yin.k/cursor-profiles profiles\n                              :yin.k/segments (set segments)}\n                             :yin.k/code code}\n                      (pc-profile? engine)\n                      (assoc :yin.k/layout (mapv first layout)\n                             :yin.k/free-env free-env)\n                      (or v2? (seq installs))\n                      (assoc :yin.k/installs installs)\n                      (or (seq frames) (and v2? (= :parked kind)))\n                      (assoc :yin.k/frames frames)\n                      (= :parked kind)\n                      (assoc :yin.k/parked-id (:id value))\n                      (= :halted kind)\n                      (assoc :yin.k/result result)\n                      (and jing-codec? (not child?) header)\n                      (merge (header-of header kind)))\n               bytes (if jing-codec?\n                       (try (encode-bytes body)\n                            (catch #?(:cljd Object\n                                      :clj Throwable\n                                      :cljs :default) e\n                              (if (outcome e)\n                                (throw e)\n                                (non-portable! :non-canonicalizable\n                                               {:yin.k/hint\n                                                (jing.cbor/refusal e)}))))\n                       (encode-bytes body))\n               address (bytes-address bytes)\n               _ (when (and jing-codec? (not child?))\n                   (let [r (checkpoint/inspect address bytes)]\n                     (when (contains? r :yin.k/status)\n                       (refuse! (:yin.k/status r) (dissoc r :yin.k/status)))))\n               _ (validate-body (decode-bytes bytes))]\n           {:status :ok\n            :kind kind\n            :body body\n            :bytes bytes\n            :address address}))))))\n\n\n;; =============================================================================\n;; Grammar (S7.5.4): total, before anything is attached or restored\n;; =============================================================================\n\n(defn- marker?","numLines":560,"startLine":1100,"totalLines":3784}},"tool_result_meta":[{"id":"toolu_01C8B9ufxD1DHLVWzMYTPbY2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G6v93PVoEMQCbJPWRS6L8r","type":"tool_result","content":"2850\t\n2851\t(def ^:private fixed-resource-keys\n2852\t  \"The VM's fixed private resource keys, never allocated by the lower\n2853\t   (`yin.vm.ucf.remote`'s discipline).\"\n2854\t  #{vm/call-in-stream-key vm/call-out-stream-key\n2855\t    vm/call-out-cursor-key module/link-request-resource\n2856\t    module/link-response-resource})\n2857\t\n2858\t\n2859\t(defn- fresh-key\n2860\t  [used]\n2861\t  (loop [n (inc (count @used))]\n2862\t    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n2863\t      (if (contains? @used k)\n2864\t        (recur (inc n))\n2865\t        (do (swap! used conj k) k)))))\n2866\t\n2867\t\n2868\t(defn- body-markers\n2869\t  \"Every stream marker the body's encoded roots name: the cells' own\n2870\t   streams, the pendings' endpoint markers, and every marker a store,\n2871\t   a register, a parked record, a closure or the halt result carries.\n2872\t   A stream referenced only there is attached exactly like one a\n2873\t   pending names -- collecting less would have the decoder refuse a\n2874\t   reference the encoder minted.  `attach-all!` deduplicates by\n2875\t   stream identity.\"\n2876\t  [body]\n2877\t  (mapcat #(tagged-of :yin.k/stream %)\n2878\t          (reachable-values body)))\n2879\t\n2880\t\n2881\t(defn- attach-all!\n2882\t  \"One attach per distinct stream identity, through `attach!`; the\n2883\t   first refusal -- a reflection marked gone included -- is\n2884\t   :yin.k/unsatisfied naming that identity.\"\n2885\t  [attach! markers]\n2886\t  (reduce (fn [acc mkr]\n2887\t            (let [identity (:dao.stream/identity mkr)]\n2888\t              (if (contains? acc identity)\n2889\t                acc\n2890\t                (if-some [h (ucf.remote/lower-marker attach! mkr)]\n2891\t                  (assoc acc identity h)\n2892\t                  (unsatisfied! identity)))))\n2893\t          {}\n2894\t          markers))\n2895\t\n2896\t\n2897\t(defn- decode-env-v2\n2898\t  [decode e]\n2899\t  (cond-> (into {}\n2900\t                (map (fn [[k v]] [k (decode v)]))\n2901\t                (:yin.k/bindings e))\n2902\t    (some? (:yin.k/store-of e))\n2903\t    (assoc engine/store-of-key (:yin.k/store-of e))))\n2904\t\n2905\t\n2906\t(defn- decode-kw\n2907\t  \"The native walker continuation chain a wire frame chain denotes:\n2908\t   addressed nodes are the receiver's decoded rows, runtime fields come\n2909\t   back as values, and an absent environment stays absent.\"\n2910\t  [node-of decode kw]\n2911\t  (when (some? kw)\n2912\t    (let [t (:yin.k/type kw)\n2913\t          base (cond-> {:type t\n2914\t                        :next (decode-kw node-of decode (:yin.k/next kw))}\n2915\t                 (contains? kw :yin.k/env)\n2916\t                 (assoc :env (decode-env-v2 decode (:yin.k/env kw))))\n2917\t          node (node-of (:yin.k/node kw))]\n2918\t      (case t\n2919\t        (:eval-operator :eval-test :eval-stream-put-target\n2920\t                        :eval-stream-cursor-source :eval-stream-next-cursor\n2921\t                        :eval-stream-close-source)\n2922\t        (assoc base :frame node)\n2923\t\n2924\t        :eval-operand\n2925\t        (assoc base :frame (assoc node\n2926\t                                  :operator-evaluated? true\n2927\t                                  :fn (decode (:yin.k/function kw))\n2928\t                                  :evaluated (mapv decode\n2929\t                                                   (:yin.k/evaluated kw))))\n2930\t\n2931\t        :dao.stream.apply/eval-operand\n2932\t        (assoc base :frame {:op (:op node)\n2933\t                            :operands (:operands node)\n2934\t                            :evaluated (mapv decode (:yin.k/evaluated kw))})\n2935\t\n2936\t        :eval-stream-put-val\n2937\t        (assoc base\n2938\t               :frame node\n2939\t               :stream-ref (decode (:yin.k/stream-ref kw)))\n2940\t\n2941\t        :dao.stream.apply/request-sent\n2942\t        (assoc base :parked-id (:yin.k/parked-id kw) :op (:yin.k/op kw))\n2943\t\n2944\t        :dao.stream.apply/eval-call\n2945\t        (cond-> base\n2946\t          (contains? kw :yin.k/call-id) (assoc :call-id (:yin.k/call-id kw)))\n2947\t\n2948\t        :eval-define (assoc base :name (:yin.k/name kw))\n2949\t        :eval-resume-val (assoc base :parked-id (:yin.k/parked-id kw))))))\n2950\t\n2951\t\n2952\t(defn- decode-registers-v2\n2953\t  \"One version-2 register map back in the receiver's native coordinates:\n2954\t   segments through the alias column of the attached code (`ctx`'s\n2955\t   `:aliases`), or the layout rebuilt from the carried `:code`, values\n2956\t   decoded and re-sealed under the receiving task.\"\n2957\t  [engine decode {:keys [aliases code node-of]} r]\n2958\t  (case engine\n2959\t    :walker\n2960\t    {:env (decode-env-v2 decode (:yin.k/env r))\n2961\t     :k (decode-kw node-of decode (:yin.k/k r))}\n2962\t    :stack\n2963\t    (let [c (stack/compose (mapv code (:yin.k/layout r)))\n2964\t          frames (fn [fs] (mapv #(mapv decode %) fs))]\n2965\t      (cond-> {:segment (:segment c)\n2966\t               :hash (:hash c)\n2967\t               :format stack/format-tag\n2968\t               :image (:yin.k/image r)\n2969\t               :pc (:yin.k/pc r)\n2970\t               :frames (frames (:yin.k/frames r))\n2971\t               :stack (mapv decode (:yin.k/stack r))\n2972\t               :continuation\n2973\t               (mapv (fn [f]\n2974\t                       (cond-> {:return-pc (:yin.k/return-pc f)\n2975\t                                :frames (frames (:yin.k/frames f))\n2976\t                                :stack-base (:yin.k/stack-base f)}\n2977\t                         (some? (:yin.k/store-of f))\n2978\t                         (assoc :store-of (:yin.k/store-of f))))\n2979\t                     (:yin.k/continuation r))}\n2980\t        (some? (:yin.k/store-of r))\n2981\t        (assoc :store-of (:yin.k/store-of r))))\n2982\t    :register\n2983\t    (let [c (register/compose (mapv code (:yin.k/layout r)))\n2984\t          frames (fn [fs] (mapv #(mapv decode %) fs))\n2985\t          pairs (fn [regs] (mapv (fn [[i x]] [i (decode x)]) regs))]\n2986\t      (cond-> {:segment (:segment c)\n2987\t               :hash (:hash c)\n2988\t               :format reffects/format-tag\n2989\t               :image (:yin.k/image r)\n2990\t               :site-pc (:yin.k/site-pc r)\n2991\t               :pc (:yin.k/pc r)\n2992\t               :frames (frames (:yin.k/frames r))\n2993\t               :regs (pairs (:yin.k/regs r))\n2994\t               :live (:yin.k/live r)\n2995\t               :continuation\n2996\t               (mapv (fn [f]\n2997\t                       (cond-> {:site-pc (:yin.k/site-pc f)\n2998\t                                :return-pc (:yin.k/return-pc f)\n2999\t                                :frames (frames (:yin.k/frames f))\n3000\t                                :regs (pairs (:yin.k/regs f))\n3001\t                                :live (:yin.k/live f)\n3002\t                                :dest (:yin.k/dest f)}\n3003\t                         (some? (:yin.k/store-of f))\n3004\t                         (assoc :store-of (:yin.k/store-of f))))\n3005\t                     (:yin.k/continuation r))\n3006\t               :dest (:yin.k/dest r)\n3007\t               :resume-mode (:yin.k/resume-mode r)}\n3008\t        (< 1 (count (:images c))) (assoc :images (:images c))\n3009\t        (some? (:yin.k/store-of r))\n3010\t        (assoc :store-of (:yin.k/store-of r))))\n3011\t    :semantic\n3012\t    {:segment (get aliases (:yin.k/segment r))\n3013\t     :pc (:yin.k/pc r)\n3014\t     :env (decode-env-v2 decode (:yin.k/env r))\n3015\t     :stack (mapv decode (:yin.k/stack r))\n3016\t     :k (mapv (fn [f]\n3017\t                {:type :return\n3018\t                 :segment (get aliases (:yin.k/segment f))\n3019\t                 :pc (:yin.k/pc f)\n3020\t                 :env (decode-env-v2 decode (:yin.k/env f))\n3021\t                 :stack-base (:yin.k/stack-base f)})\n3022\t              (:yin.k/k r))}\n3023\t    (undecodable! {:yin.k/kind :unsupported-profile})))\n3024\t\n3025\t\n3026\t(defn- value-decoder\n3027\t  \"The decode half, over the receiver's coordinates: literals back to\n3028\t   maps, closures through the kernel against the attached code,\n3029\t   primitives from the receiver's own registry under an equal profile,\n3030\t   and stream and cursor markers as fresh references sealed under the\n3031\t   receiving task's own secret.\"\n3032\t  ([recv streams cells]\n3033\t   (value-decoder recv streams cells nil))\n3034\t  ([recv streams cells frames]\n3035\t   (letfn [(decode\n3036\t             [x]\n3037\t             (cond\n3038\t               (scalar? x) x\n3039\t               (jing.cbor/numeric? x) x\n3040\t               (map? x)\n3041\t               (case (:yin.k/tag x)\n3042\t                 :yin.k/frame\n3043\t                 (if (and frames (contains? x :yin.k/parked-id))\n3044\t                   ((:parked @frames) (:yin.k/parked-id x))\n3045\t                   (if frames\n3046\t                     (values/continuation\n3047\t                       (:owner recv)\n3048\t                       (assoc ((:reified @frames) (:yin.k/registers x))\n3049\t                              :type :reified-continuation))\n3050\t                     (undecodable! {:yin.k/tag :yin.k/frame})))\n3051\t                 :yin.k/literal\n3052\t                 (let [e (:yin.k/entries x)]\n3053\t                   (if (even? (count e))\n3054\t                     (into {}\n3055\t                           (map (fn [[k v]] [(decode k) (decode v)]))\n3056\t                           (partition 2 e))\n3057\t                     (undecodable! {:yin.k/tag :yin.k/literal})))\n3058\t                 :yin.k/closure (module/lower-closure recv x decode)\n3059\t                 :yin.k/primitive\n3060\t                 (let [n (:yin.k/name x)\n3061\t                       entry (get (:primitives recv) n)]\n3062\t                   (if (and (some? entry)\n3063\t                            (= (:yin.k/profile x)\n3064\t                               (:yin.k/profile\n3065\t                                 (vm/profile-of (:primitives recv) n))))\n3066\t                     (vm/primitive-function entry)\n3067\t                     (refuse! :yin.k/unsatisfied {:yin.k/name n})))\n3068\t                 :yin.k/stream\n3069\t                 (if-some [k (get streams (:dao.stream/identity x))]\n3070\t                   (engine/issue-ref recv :stream-ref k)\n3071\t                   (undecodable! {:dao.stream/identity\n3072\t                                  (:dao.stream/identity x)}))\n3073\t                 :yin.k/cursor-ref\n3074\t                 (if-some [k (get cells (:yin.k/cell x))]\n3075\t                   (engine/issue-ref recv :cursor-ref k)\n3076\t                   (undecodable! {:yin.k/cell (:yin.k/cell x)}))\n3077\t                 (undecodable! {:yin.k/tag (:yin.k/tag x)}))\n3078\t               (vector? x) (mapv decode x)\n3079\t               (set? x) (into #{} (map decode) x)\n3080\t               (seq? x) (apply list (map decode x))\n3081\t               :else (undecodable! {:yin.k/kind :host-object})))]\n3082\t     decode)))\n3083\t\n3084\t\n3085\t(defn- spawn-child-template\n3086\t  \"A fresh child VM of the receiver's composition for one install\n3087\t   response -- the engine's own spawn discipline (yin.vm.linker.md\n3088\t   7.3): nothing of the receiver's state but its composition values,\n3089\t   a fresh origin tag, and the secret the composition's source mints\n3090\t   for it.\"\n3091\t  [recv response module-name fenced?]\n3092\t  (let [n (or (:origins recv) 0)\n3093\t        origin (keyword (str (name (or (:origin recv) :t0)) \".\" n))\n3094\t        registry (reduce (fn [r [m e]]\n3095\t                           (module/assoc-module r m (dissoc e :bindings)))\n3096\t                         (:modules recv)\n3097\t                         (module/module-entries (:modules recv)))\n3098\t        source (:secret-source recv)\n3099\t        child (module/spawn-module\n3100\t                (cond-> recv fenced? (assoc :make-stream nil :resources {}))\n3101\t                (:value (:image response))\n3102\t                {:modules registry\n3103\t                 :origin origin\n3104\t                 :ancestry (conj (vec (:ancestry recv)) module-name)\n3105\t                 :capability-secret (when (fn? source) (source origin))})]\n3106\t    (assoc child :origins (inc n) :make-stream (:make-stream recv))))\n3107\t\n3108\t\n3109\t(defn- child-bytes\n3110\t  \"A child body re-encoded for its own recursive resume under the codec\n3111\t   its version rides: version 1 in jing canonical bytes, version 0 in\n3112\t   the stream codec, exactly as it arrived inside its parent.\"\n3113\t  [child-body]\n3114\t  (if (= 0 (:yin.k/version child-body))\n3115\t    (cbor/encode child-body)\n3116\t    (jing.cbor/encode child-body)))\n3117\t\n3118\t\n3119\t(defn- resume-installs\n3120\t  \"Each install child resumed into a fresh child of the receiver's\n3121\t   composition, its phase and response carried: the receiver's own\n3122\t   scheduler steps it exactly as the source's did.  A child that\n3123\t   refuses -- its bytes undecodable, a stream it names unattachable\n3124\t   -- aborts the parent's restoration: the refusal is thrown here,\n3125\t   before any machine value is assembled, so the parent never answers\n3126\t   :ok over a child that did not lower.  The child is resumed as an\n3127\t   install child, not a custody root: its own reader pass skips the\n3128\t   custody step the root already ran over it.\"\n3129\t  [recv body attach! opts fenced?]\n3130\t  (into {}\n3131\t        (map-indexed (fn [index [m inst]]\n3132\t                       (let [response (:yin.k/response inst)\n3133\t                             child-body (:yin.k/child inst)\n3134\t                             resumed (resume-task*\n3135\t                                       (if-some [spawn (:child-of opts)]\n3136\t                                         (spawn recv response m)\n3137\t                                         (spawn-child-template\n3138\t                                           (cond-> recv\n3139\t                                             fenced? (assoc :origins (+ (or (:origins recv) 0) index)))\n3140\t                                           response m fenced?))\n3141\t                                       (child-bytes child-body)\n3142\t                                       attach!\n3143\t                                       opts\n3144\t                                       true\n3145\t                                       fenced?)]\n3146\t                         (when (not= :ok (:status resumed))\n3147\t                           (refuse! (:yin.k/status resumed)\n3148\t                                    (dissoc resumed :yin.k/status)))\n3149\t                         [m {:phase (or (:yin.k/phase inst) :running)\n3150\t                             :parent (:yin.k/parent inst)\n3151\t                             :response response\n3152\t                             :vm (:vm resumed)}])))\n3153\t        (:yin.k/installs body)))\n3154\t\n3155\t\n3156\t(defn- link-pair-resources\n3157\t  \"The engine's fixed link keys mapped onto the reflections a lowered\n3158\t   link wait uses, so a migrated link wait parks where the engine's\n3159\t   own sweep polls it.\"\n3160\t  [streams resources pendings]\n3161\t  (reduce (fn [acc pending]\n3162\t            (if (contains? #{:link-request :link-response}\n3163\t                           (:yin.k/reason pending))\n3164\t              (let [req (get resources\n3165\t                             (streams (get-in pending\n3166\t                                              [:yin.k/request\n3167\t                                               :dao.stream/identity])))\n3168\t                    resp (get resources\n3169\t                              (streams (get-in pending\n3170\t                                               [:yin.k/response\n3171\t                                                :dao.stream/identity])))]\n3172\t                (if (and req resp)\n3173\t                  (assoc acc\n3174\t                         module/link-request-resource req\n3175\t                         module/link-response-resource resp)\n3176\t                  acc))\n3177\t              acc))\n3178\t          {}\n3179\t          pendings))\n3180\t\n3181\t\n3182\t(defn- lower-frame!\n3183\t  \"One pending lowered back into the engine's own wait-set entry\n3184\t   shape, the receiver's register context riding verbatim under the\n3185\t   fields the variant rebuilds (`yin.vm.ucf.remote`'s shapes, through\n3186\t   this lower's own fresh keys).\"\n3187\t  [engine decode streams cells cell-keys pending ctx]\n3188\t  (let [walker? (= :walker engine)\n3189\t        stream-of (fn [marker]\n3190\t                    (streams (:dao.stream/identity marker)))\n3191\t        cell-stream (fn [cid]\n3192\t                      (stream-of (get-in cells [cid :yin.k/stream])))\n3193\t        cell-key (fn [cid] (get cell-keys cid))]\n3194\t    (case (:yin.k/reason pending)\n3195\t      :next\n3196\t      (merge ctx\n3197\t             {:reason :next\n3198\t              :stream-id (cell-stream (:yin.k/cell pending))\n3199\t              :cursor-ref {:type :cursor-ref\n3200\t                           :id (cell-key (:yin.k/cell pending))}})\n3201\t\n3202\t      :ffi\n3203\t      (merge ctx\n3204\t             (cond-> {:reason :next\n3205\t                      :stream-id (cell-stream (:yin.k/cell pending))\n3206\t                      :cursor-ref {:type :cursor-ref\n3207\t                                   :id (cell-key (:yin.k/cell pending))}}\n3208\t               (not walker?)\n3209\t               (assoc :call-id (:yin.k/call-id pending))\n3210\t               (and (not walker?) (contains? pending :yin.k/op))\n3211\t               (assoc :op (:yin.k/op pending))))\n3212\t\n3213\t      :put\n3214\t      (merge ctx\n3215\t             {:reason :put\n3216\t              :stream-id (stream-of (:yin.k/stream pending))\n3217\t              :datom (decode (:yin.k/value pending))})\n3218\t\n3219\t      :ffi-request\n3220\t      (merge ctx\n3221\t             (cond-> {:reason :put\n3222\t                      :stream-id (stream-of (:yin.k/request pending))\n3223\t                      :datom (decode (:yin.k/request-envelope pending))}\n3224\t               (not walker?)\n3225\t               (assoc :request-sent true\n3226\t                      :call-id (:yin.k/call-id pending)\n3227\t                      :op (:yin.k/request-op pending)\n3228\t                      :response-cursor (cell-key (:yin.k/response-cell pending))\n3229\t                      :response-stream (stream-of (:yin.k/response pending)))))\n3230\t\n3231\t      (:link-request :link-response)\n3232\t      (let [cid (:yin.k/cell pending)]\n3233\t        (merge ctx\n3234\t               (cond-> {:reason (:yin.k/reason pending)\n3235\t                        :link-id (:yin.k/link-id pending)\n3236\t                        :name (:yin.k/name pending)\n3237\t                        :request module/link-request-resource\n3238\t                        :response module/link-response-resource\n3239\t                        :cursor (:yin.k/position (get cells cid))}\n3240\t                 (= :link-request (:yin.k/reason pending))\n3241\t                 (assoc :envelope (decode (:yin.k/envelope pending))))))\n3242\t\n3243\t      :install\n3244\t      (merge ctx {:reason :install :name (:yin.k/name pending)})\n3245\t\n3246\t      (undecodable! {:yin.k/reason (:yin.k/reason pending)}))))\n3247\t\n3248\t\n3249\t;; =============================================================================\n3250\t;; The version-aware reader (M-next D7): two codecs, one grammar each\n3251\t;; =============================================================================\n3252\t\n3253\t(def ^:private codec-versions\n3254\t  \"The body-version contract of each accepting codec, the two-codec\n3255\t   split of the D plan's residual 3: stage-1 `dao.stream.cbor` bytes are\n3256\t   version 0 only -- that wire is frozen -- and `dao.jing.cbor` canonical\n3257\t   bytes are version 1 only, the stream codec's tag-39 identifiers being\n3258\t   refused by jing's decoder.  Scalar overlap between the codecs\n3259\t   establishes no body compatibility; which codec accepted decides.\"\n3260\t  {:stream #{0} :jing #{1 2}})\n3261\t\n3262\t\n3263\t(defn- decode-two\n3264\t  \"Reader step 1: the version-1 decode first (jing), then the version-0\n3265\t   decode (the stream codec).  Answers `{:codec c :body b}` for the\n3266\t   first codec that accepted the bytes; bytes neither decodes are\n3267\t   `:yin.k/undecodable`.\"\n3268\t  [bytes]\n3269\t  (letfn [(attempt\n3270\t            [decode]\n3271\t            (try {:body (decode bytes)}\n3272\t                 (catch #?(:cljd Object :clj Throwable :cljs :default) _\n3273\t                   nil)))]\n3274\t    (or (when-some [r (attempt jing.cbor/decode)]\n3275\t          (assoc r :codec :jing))\n3276\t        (when-some [r (attempt cbor/decode)]\n3277\t          (assoc r :codec :stream))\n3278\t        (undecodable! {:yin.k/kind :bytes}))))\n3279\t\n3280\t\n3281\t(defn- require-tag!\n3282\t  \"Reader step 2: the S7.5.1 tag, before any version or address rule.\"\n3283\t  [body]\n3284\t  (when-not (and (map? body) (true? (get body handoff-tag)))\n3285\t    (undecodable! {:yin.k/kind :body})))\n3286\t\n3287\t\n3288\t(defn- version-gate!\n3289\t  \"Reader step 3, before the address check (UCF 7.2.1): the version\n3290\t   contract of the codec that accepted the bytes.  A version the codec\n3291\t   does not speak, an absent version, or one not of the integer kind is\n3292\t   `:yin.k/profile-mismatch`, carrying the version as found and the\n3293\t   supported set.  Under `opts`' `:exclusive` a version-0 body is the\n3294\t   same refusal: a reader that requires exclusive custody never\n3295\t   downgrades a fork into it.\"\n3296\t  [codec body opts install-child?]\n3297\t  (let [supported (get codec-versions codec)\n3298\t        v (get body :yin.k/version)]\n3299\t    (when-not (and (jing.cbor/numeric? v)\n3300\t                   (= :integer (jing.cbor/numeric-kind v))\n3301\t                   (contains? supported v))\n3302\t      (refuse! :yin.k/profile-mismatch\n3303\t               {:yin.k/version v :yin.k/supported supported}))\n3304\t    (when (and (:exclusive opts)\n3305\t               (if (v2-body? body)\n3306\t                 ;; version 2 is a fork exactly when it carries no custody\n3307\t                 ;; header key, and only a root is a custody subject\n3308\t                 (and (not install-child?)\n3309\t                      (not-any? #(contains? body %)\n3310\t                                [:yin.k/policy :yin.k/occurrence\n3311\t                                 :yin.k/arbitration :yin.k/origin\n3312\t                                 :yin.k/next-op-seq]))\n3313\t                 (not= 1 v)))\n3314\t      (refuse! :yin.k/profile-mismatch\n3315\t               {:yin.k/version v\n3316\t                :yin.k/supported #{1 2}\n3317\t                :yin.k/policy :yin.k/exclusive}))))\n3318\t\n3319\t\n3320\t(defn- custody-inspect!\n3321\t  \"Reader step 4, version 1 only: `checkpoint/inspect` over the claimed\n3322\t   address and the exact bytes -- the address (`:yin.k/hash-mismatch`)\n3323\t   first, then the custody grammar, including an entry for every install\n3324\t   pending.  The address is the one `opts` names, the address the bytes\n3325\t   were fetched under; unnamed, it is the address of the bytes\n3326\t   themselves.  A structural failure here is never reinterpreted as\n3327\t   version 0: the accepting codec is already fixed.  Answers the\n3328\t   operation baseline D10's lower will consume.\"\n3329\t  [bytes opts]\n3330\t  (let [address (or (:address opts) (bytes-address bytes))\n3331\t        r (checkpoint/inspect address bytes)]\n3332\t    (when (contains? r :yin.k/status)\n3333\t      (refuse! (:yin.k/status r) (dissoc r :yin.k/status)))\n3334\t    r))\n3335\t\n3336\t\n3337\t(defn- task-bodies\n3338\t  [body]\n3339\t  (tree-seq #(seq (:yin.k/installs %))\n3340\t            #(map :yin.k/child (vals (:yin.k/installs %))) body))\n3341\t\n3342\t\n3343\t(defn- accept-grant!\n3344\t  [body opts]\n3345\t  (let [grant (:grant opts)\n3346\t        evidence (:evidence grant)]\n3347\t    (when-not (and (or (nil? grant) (map? grant))\n3348\t                   (or (nil? evidence) (map? evidence)))\n3349\t      (throw (ex-info \"Malformed lower grant or evidence\" {})))\n3350\t    (when-not evidence\n3351\t      (refuse! :yin.k/awaiting-grant {}))\n3352\t    (when-not (= :yin.k/ready (:yin.k/status evidence))\n3353\t      (refuse! (if (= :yin.k/awaiting-grant (:yin.k/status evidence))\n3354\t                 :yin.k/awaiting-grant :yin.k/unsatisfied)\n3355\t               (dissoc evidence :yin.k/status)))\n3356\t    (let [binding (:yin.k/binding evidence)\n3357\t          prefix (:yin.k/prefix evidence)\n3358\t          tenure (:tenure grant)\n3359\t          occurrence (:yin.k/occurrence body)\n3360\t          lease (:dao.lease/lease grant)\n3361\t          holder (:dao.lease/holder grant)\n3362\t          frontier (:yin.k/frontier prefix)\n3363\t          records (:yin.k/inputs prefix)]\n3364\t      (when-not (and (map? binding) (map? tenure))\n3365\t        (throw (ex-info \"Malformed lower binding or tenure\" {})))\n3366\t      (when (or (nil? prefix) (:yin.k/status prefix))\n3367\t        (refuse! :yin.k/unsatisfied\n3368\t                 {:yin.k/reason (or (:yin.k/reason prefix) :unavailable)}))\n3369\t      (when-not (and (some? (:address opts))\n3370\t                     (= (:checkpoint grant) (:address opts))\n3371\t                     (= occurrence (:yin.k/occurrence binding))\n3372\t                     (some? lease) (= lease (:dao.lease/lease binding))\n3373\t                     (some? holder) (= holder (:dao.lease/holder binding))\n3374\t                     (= (get-in body [:yin.k/arbitration :dao.stream/identity])\n3375\t                        (get-in binding [:yin.k/transaction :yin.k/arbitration]))\n3376\t                     (custody/exact? (:yin.k/epoch binding))\n3377\t                     (true? (:live tenure))\n3378\t                     (number? (:now tenure)) (number? (:bound tenure))\n3379\t                     (< (:now tenure) (:bound tenure))\n3380\t                     (= occurrence (:yin.k/occurrence prefix))\n3381\t                     (= lease (:dao.lease/lease prefix))\n3382\t                     (custody/exact? frontier) (vector? records)\n3383\t                     (= frontier (count records))\n3384\t                     (every? true? (map-indexed\n3385\t                                     (fn [index record]\n3386\t                                       (and (custody/exact? (:yin.k/input-seq record))\n3387\t                                            (= index (:yin.k/input-seq record))))\n3388\t                                     records)))\n3389\t        (refuse! :yin.k/not-holder {}))\n3390\t      (let [classes (:protection opts)\n3391\t            enrolled (:yin.k/enrolled evidence)]\n3392\t        (when-not (and (map? classes)\n3393\t                       (every? #{:enrolled :at-least-once :fail-stop} (vals classes))\n3394\t                       (set? enrolled))\n3395\t          (throw (ex-info \"Malformed lower protection or enrollment\" {})))\n3396\t        (doseq [task (task-bodies body)\n3397\t                marker (body-markers task)]\n3398\t          (let [identity (:dao.stream/identity marker)\n3399\t                class (get classes identity)]\n3400\t            (when-not (and class (= (= class :enrolled)\n3401\t                                    (contains? enrolled identity)))\n3402\t              (unsatisfied! identity))))\n3403\t        (doseq [task (task-bodies body)\n3404\t                frame (:yin.k/frames task)\n3405\t                :let [pending (:yin.k/pending frame)\n3406\t                      reason (:yin.k/reason pending)]\n3407\t                :when (contains? #{:put :ffi-request :link-request} reason)]\n3408\t          (let [marker (if (= :put reason) (:yin.k/stream pending)\n3409\t                           (:yin.k/request pending))\n3410\t                identity (:dao.stream/identity marker)]\n3411\t            (when-not (= (= :enrolled (get classes identity))\n3412\t                         (contains? pending :yin.k/op-id))\n3413\t              (unsatisfied! identity))))\n3414\t        {:yin.k/occurrence occurrence\n3415\t         :dao.lease/lease lease :dao.lease/holder holder\n3416\t         :yin.k/epoch (:yin.k/epoch binding)\n3417\t         :yin.k/arbitration (:yin.k/arbitration body)\n3418\t         :yin.k/next-op-seq (:yin.k/next-op-seq body)\n3419\t         :protection classes :input {:next 0 :prefix prefix}\n3420\t         :tenure {:bound (:bound tenure)}}))))\n3421\t\n3422\t\n3423\t(defn- isolated-receiver\n3424\t  [recv]\n3425\t  (reduce (fn [machine [module-name entry]]\n3426\t            (update machine :modules module/assoc-module module-name\n3427\t                    entry))\n3428\t          (-> recv\n3429\t              (assoc :store {} :module-stores {} :parked {} :installs {})\n3430\t              (assoc-in [:modules :modules] {})\n3431\t              (dissoc :yin.k/custody :yin.k/gate :yin.k/closes :yin.k/issued\n3432\t                      :yin.k/recovery-cell-ids :yin.k/recovery-waits))\n3433\t          (filter (fn [[_ entry]] (nil? (:address entry)))\n3434\t                  (module/module-entries (:modules recv)))))\n3435\t\n3436\t\n3437\t(defn- primitives-satisfied!\n3438\t  \"Every primitive any task of the tree names exists in `recv`'s own\n3439\t   registry under an equal profile, or the lower is `:yin.k/unsatisfied`\n3440\t   naming it: judged on the bytes' markers before one attachment is made,\n3441\t   never found missing at decode time.\"\n3442\t  [recv body]\n3443\t  (doseq [task (task-bodies body)\n3444\t          root (reachable-values task)\n3445\t          marker (tagged-of :yin.k/primitive root)]\n3446\t    (let [n (:yin.k/name marker)\n3447\t          entry (get (:primitives recv) n)]\n3448\t      (when-not (and (some? entry)\n3449\t                     (= (:yin.k/profile marker)\n3450\t                        (:yin.k/profile (vm/profile-of (:primitives recv) n))))\n3451\t        (refuse! :yin.k/unsatisfied {:yin.k/name n})))))\n3452\t\n3453\t\n3454\t(defn- resume-task*\n3455\t  \"The lower of 14.1.2 behind the version-aware reader of M-next D7:\n3456\t   `bytes`, a handoff body this namespace minted, resumed into a fresh\n3457\t   task over `recv` -- a machine of the receiver's own composition.\n3458\t   Before any attachment or restoration, in this order: the two-codec\n3459\t   decode (jing first, then the stream codec; neither accepting is\n3460\t   `:yin.k/undecodable`), the tag, the version gate of the accepting\n3461\t   codec (`:yin.k/profile-mismatch`, before the address check), and --\n3462\t   version 1 only -- `checkpoint/inspect` over the address `opts` names\n3463\t   (`:yin.k/hash-mismatch`, then the custody grammar); then the full\n3464\t   recursive grammar of `validate-body`, the contract stamp and the\n3465\t   restoration itself.  `opts` may name `:exclusive` (a version-0 body\n3466\t   is then refused; without it such a body still lowers as a fork) and\n3467\t   `:address`. A blocked or parked version-1 root additionally requires\n3468\t   `:grant` (checkpoint, lease, holder, evidence and current tenure) and\n3469\t   `:protection` keyed by portable stream identity. Grant consistency and\n3470\t   recursive protection checks precede all attachments. Missing evidence\n3471\t   answers `:yin.k/awaiting-grant`, invalid binding `:yin.k/not-holder`,\n3472\t   and unavailable evidence or protection mismatch `:yin.k/unsatisfied`.\n3473\t   Accepted custody restores the body's operation counter exactly and\n3474\t   starts input replay at zero. Halted version-1 results need no grant\n3475\t   and are gated ended. Install children are resumed as children, their pass\n3476\t   skipping the custody step their root already ran.  Answers\n3477\t   `{:status :ok :kind k :vm resumed}` or the first data refusal:\n3478\t   `:yin.k/undecodable` bytes or grammar, `:yin.k/profile-mismatch`\n3479\t   stamp or version, `:yin.k/hash-mismatch` address or code,\n3480\t   `:yin.k/unsatisfied` a stream that cannot be attached or a primitive\n3481\t   the receiver cannot answer.  Nothing partially runnable is ever\n3482\t   exposed: the machine value is assembled only after every restoration\n3483\t   step passes.  `attach!` is the receiver's own `:dao.stream/attach`\n3484\t   dispatch, exactly `yin.vm.ucf.remote`'s; a version-0 resume is a\n3485\t   fork.\"\n3486\t  ([recv bytes attach!]\n3487\t   (resume-task recv bytes attach! nil))\n3488\t  ([recv bytes attach! opts install-child?]\n3489\t   (resume-task* recv bytes attach! opts install-child? false))\n3490\t  ([recv bytes attach! opts install-child? fenced?]\n3491\t   (call!\n3492\t     (fn []\n3493\t       (let [{:keys [codec body]} (decode-two bytes)\n3494\t             _ (require-tag! body)\n3495\t             _ (version-gate! codec body opts install-child?)\n3496\t             v2? (v2-body? body)\n3497\t             _ (when (and (or v2? (= 1 (:yin.k/version body)))\n3498\t                          (not install-child?))\n3499\t                 (custody-inspect! bytes opts))\n3500\t             _ (validate-body body)\n3501\t             engine (when v2? (ucf/profile-engine (:yin.k/contract body)))\n3502\t             _ (if v2?\n3503\t                 (when-not (= engine (engine-of recv))\n3504\t                   (refuse! :yin.k/profile-mismatch\n3505\t                            {:yin.k/contract (:yin.k/contract body)\n3506\t                             :yin.k/supported ucf/supported-profiles}))\n3507\t                 (when-not (= ucf/contract-stamp\n3508\t                              (:yin.k/contract body))\n3509\t                   (refuse! :yin.k/profile-mismatch\n3510\t                            {:yin.k/contract (:yin.k/contract body)})))\n3511\t             _ (when v2?\n3512\t                 (primitives-satisfied! recv body))\n3513\t             kind (:yin.k/kind body)\n3514\t             ;; a version-2 tree is a fork exactly when its root carries no\n3515\t             ;; custody header key; its children inherit the root's role\n3516\t             tree-fork? (if install-child?\n3517\t                          (boolean (::fork opts))\n3518\t                          (and v2? (not-any? #(contains? body %)\n3519\t                                             [:yin.k/policy :yin.k/occurrence\n3520\t                                              :yin.k/arbitration :yin.k/origin\n3521\t                                              :yin.k/next-op-seq])))\n3522\t             opts (assoc opts ::fork tree-fork?)\n3523\t             version-one? (or (= 1 (:yin.k/version body))\n3524\t                              (and v2? (not tree-fork?)))\n3525\t             custody-state (when (and version-one? (not install-child?) (not fenced?)\n3526\t                                      (not= :halted kind))\n3527\t                             (accept-grant! body opts))\n3528\t             cells (:yin.k/cells body)\n3529\t             pendings (mapv :yin.k/pending\n3530\t                            (or (:yin.k/frames body) []))\n3531\t             recv' (cond\n3532\t                     (= :walker engine)\n3533\t                     (walker/attach-rows\n3534\t                       (walker/clear-code (isolated-receiver recv))\n3535\t                       (:yin.k/code body)\n3536\t                       vm/ast-contract)\n3537\t                     (pc-profile? engine)\n3538\t                     ((if (= :stack engine) stack/rebuild register/rebuild)\n3539\t                      (isolated-receiver recv)\n3540\t                      (mapv (:yin.k/code body) (:yin.k/layout body)))\n3541\t                     :else\n3542\t                     (reduce (fn [r [_a v]] (module/attach-module r v))\n3543\t                             (cond\n3544\t                               (= :semantic engine)\n3545\t                               ;; the receiver's own code layout is cleared\n3546\t                               ;; before the body's is rebuilt (v2, 9)\n3547\t                               (assoc (isolated-receiver recv)\n3548\t                                      :code {} :code-aliases {} :program nil)\n3549\t                               (or version-one? v2? fenced?)\n3550\t                               (isolated-receiver recv)\n3551\t                               :else recv)\n3552\t                             (:yin.k/code body)))\n3553\t             handles (attach-all! attach! (body-markers body))\n3554\t             used (atom (into fixed-resource-keys\n3555\t                              (keys (:resources recv))))\n3556\t             streams (into {}\n3557\t                           (map (fn [identity]\n3558\t                                  [identity (fresh-key used)]))\n3559\t                           (sort-by str (keys handles)))\n3560\t             resources (into {}\n3561\t                             (map (fn [[identity k]]\n3562\t                                    [k (get handles identity)]))\n3563\t                             streams)\n3564\t             cell-keys (into {}\n3565\t                             (map (fn [cid] [cid (fresh-key used)]))\n3566\t                             (sort-by str (keys cells)))\n3567\t             cell-resources (into {}\n3568\t                                  (map (fn [[cid k]]\n3569\t                                         [k\n3570\t                                          {:stream-id\n3571\t                                           (streams\n3572\t                                             (get-in cells\n3573\t                                                     [cid :yin.k/stream\n3574\t                                                      :dao.stream/identity]))\n3575\t                                           :cursor\n3576\t                                           (get-in cells\n3577\t                                                   [cid\n3578\t                                                    :yin.k/position])}]))\n3579\t                                  cell-keys)\n3580\t             frame-hooks (atom nil)\n3581\t             decode (value-decoder recv' streams cell-keys frame-hooks)\n3582\t             aliases (:code-aliases recv')\n3583\t             decode-regs (if v2?\n3584\t                           (partial decode-registers-v2 engine decode\n3585\t                                    {:aliases aliases\n3586\t                                     :code (:yin.k/code body)\n3587\t                                     :node-of (partial walker/row-node recv')})\n3588\t                           (partial decode-registers decode aliases))\n3589\t             parked-cache (atom {})\n3590\t             resolving (atom #{})\n3591\t             resolve-parked\n3592\t             (fn [pid]\n3593\t               (or (get @parked-cache pid)\n3594\t                   (do (when (contains? @resolving pid)\n3595\t                         (non-portable! :non-canonicalizable\n3596\t                                        {:yin.k/hint :parked-cycle}))\n3597\t                       (swap! resolving conj pid)\n3598\t                       (let [rec (assoc (decode-regs\n3599\t                                          (get-in body [:yin.k/parked pid]))\n3600\t                                        :type :parked-continuation\n3601\t                                        :id pid)]\n3602\t                         (swap! parked-cache assoc pid rec)\n3603\t                         (swap! resolving disj pid)\n3604\t                         rec))))\n3605\t             _ (when v2?\n3606\t                 (reset! frame-hooks {:parked resolve-parked\n3607\t                                      :reified decode-regs}))\n3608\t             ;; the isolated slice installs through `store-put`, so a\n3609\t             ;; reserved key inside a tampered body refuses here exactly\n3610\t             ;; as a program write would (Rule R), before the checked\n3611\t             ;; store lands on the receiver in one write\n3612\t             store (reduce (fn [s [k v]]\n3613\t                             (engine/store-put s (decode k) (decode v)))\n3614\t                           (or (:store recv') {})\n3615\t                           (:yin.k/store body))\n3616\t             module-stores (into {}\n3617\t                                 (map (fn [[m s]]\n3618\t                                        [m (into {}\n3619\t                                                 (map (fn [[k v]]\n3620\t                                                        [(decode k)\n3621\t                                                         (decode v)]))\n3622\t                                                 s)]))\n3623\t                                 (:yin.k/module-stores body))\n3624\t             parked (into {}\n3625\t                          (map (fn [[pid r]]\n3626\t                                 [pid (if v2?\n3627\t                                        (resolve-parked pid)\n3628\t                                        (assoc\n3629\t                                          (decode-registers decode aliases r)\n3630\t                                          :type :parked-continuation\n3631\t                                          :id pid))]))\n3632\t                          (:yin.k/parked body))\n3633\t             installs (resume-installs recv' body attach! opts fenced?)\n3634\t             registers (mapv (fn [frame]\n3635\t                               (decode-regs (:yin.k/registers frame)))\n3636\t                             (or (:yin.k/frames body) []))\n3637\t             raw-entries (mapv (fn [pending ctx]\n3638\t                                 (cond-> (lower-frame! engine decode streams cells cell-keys\n3639\t                                                       pending ctx)\n3640\t                                   (and version-one? (contains? pending :yin.k/op-id))\n3641\t                                   (assoc :op-id (:yin.k/op-id pending))))\n3642\t                               pendings registers)\n3643\t             [entries issued] (if version-one?\n3644\t                                (reduce (fn [[acc issue] entry]\n3645\t                                          (if (= :put (:reason entry))\n3646\t                                            [(conj acc (assoc entry :yin.k/issue issue)) (inc issue)]\n3647\t                                            [(conj acc entry) issue]))\n3648\t                                        [[] 0]\n3649\t                                        raw-entries)\n3650\t                                [raw-entries nil])\n3651\t             machine (cond-> (-> recv'\n3652\t                                 (assoc :store store\n3653\t                                        :module-stores (merge (:module-stores recv')\n3654\t                                                              module-stores)\n3655\t                                        :parked (merge (:parked recv') parked)\n3656\t                                        :installs (merge (:installs recv') installs)\n3657\t                                        :resources (merge (:resources recv')\n3658\t                                                          resources\n3659\t                                                          cell-resources\n3660\t                                                          (when (or fenced? (= :walker engine))\n3661\t                                                            (reduce (fn [acc pending]\n3662\t                                                                      (if (= :ffi-request (:yin.k/reason pending))\n3663\t                                                                        (assoc acc\n3664\t                                                                               vm/call-in-stream-key\n3665\t                                                                               (get resources (streams (get-in pending [:yin.k/request :dao.stream/identity])))\n3666\t                                                                               vm/call-out-stream-key\n3667\t                                                                               (get resources (streams (get-in pending [:yin.k/response :dao.stream/identity])))\n3668\t                                                                               vm/call-out-cursor-key\n3669\t                                                                               (get cell-resources (cell-keys (:yin.k/response-cell pending))))\n3670\t                                                                        acc))\n3671\t                                                                    {} pendings))\n3672\t                                                          (link-pair-resources\n3673\t                                                            streams resources\n3674\t                                                            pendings))\n3675\t                                        :id-counter (max (or (:id-counter recv') 0)\n3676\t                                                         (or (:yin.k/id-counter body)\n3677\t                                                             0))\n3678\t                                        :ready-queue []\n3679\t                                        :control nil\n3680\t                                        :k nil))\n3681\t                       (pc-profile? engine)\n3682\t                       (assoc :free-env (decode-env-v2 decode (:yin.k/free-env body)))\n3683\t                       version-one?\n3684\t                       (assoc :yin.k/issued issued\n3685\t                              :yin.k/gate (if (and (not install-child?)\n3686\t                                                   (= :halted kind))\n3687\t                                            :ended :running))\n3688\t                       fenced? (assoc :yin.k/gate :exporting\n3689\t                                      :yin.k/recovery-cell-ids\n3690\t                                      (into (into {} (map (fn [[cell-id resource-id]]\n3691\t                                                            [resource-id cell-id])) cell-keys)\n3692\t                                            (keep (fn [pending]\n3693\t                                                    (when (contains? #{:link-request :link-response}\n3694\t                                                                     (:yin.k/reason pending))\n3695\t                                                      [[module/link-response-resource\n3696\t                                                        (get-in cells [(:yin.k/cell pending) :yin.k/position])]\n3697\t                                                       (:yin.k/cell pending)])))\n3698\t                                            pendings)\n3699\t                                      :id-counter (or (:yin.k/id-counter body) 0))\n3700\t                       custody-state (assoc :yin.k/custody custody-state))]\n3701\t         (cond-> {:status :ok\n3702\t                  :kind kind\n3703\t                  :vm (case kind\n3704\t                        :halted\n3705\t                        (assoc machine\n3706\t                               :halted? true :blocked? false\n3707\t                               :value (decode (:yin.k/result body))\n3708\t                               :wait-set [])\n3709\t\n3710\t                        ;; the parked activation waits on nothing; every other\n3711\t                        ;; carried frame is still an ordered wait (UCF 7.4.3)\n3712\t                        :parked\n3713\t                        (assoc machine\n3714\t                               :halted? true :blocked? false\n3715\t                               :value (get parked (:yin.k/parked-id body))\n3716\t                               :wait-set entries)\n3717\t\n3718\t                        (assoc machine\n3719\t                               :halted? false :blocked? true\n3720\t                               :value :yin/blocked\n3721\t                               :wait-set entries))}\n3722\t           fenced? (update :vm (fn [restored]\n3723\t                                 (assoc restored\n3724\t                                        :yin.k/recovery-waits (:wait-set restored)\n3725\t                                        :wait-set [])))))))))\n3726\t\n3727\t\n3728\t(defn rehydrate-fenced-body\n3729\t  \"Administrative reconstruction of a validated handoff snapshot.\n3730\t   Unlike resume-task, never admits execution or restores custody. Root\n3731\t   and install children remain exporting with waits outside the scheduler.\"\n3732\t  [receiver bytes attach! address]\n3733\t  (resume-task* receiver bytes attach! {:address address} false true))\n3734\t\n3735\t\n3736\t(defn inspect-recovery-body\n3737\t  \"Validate an embedded export snapshot before administrative attachment.\"\n3738\t  ([bytes address header]\n3739\t   (inspect-recovery-body bytes address header true))\n3740\t  ([bytes address header complete?]\n3741\t   (call!\n3742\t     (fn []\n3743\t       (let [{:keys [codec body]} (decode-two bytes)]\n3744\t         (require-tag! body)\n3745\t         (version-gate! codec body nil false)\n3746\t         (when (or (v2-body? body) (= 1 (:yin.k/version body)))\n3747\t           (custody-inspect! bytes {:address address}))\n3748\t         (when-not (jing/segment-bytes-match? address bytes)\n3749\t           (refuse! :yin.k/hash-mismatch {}))\n3750\t         (validate-body body)\n3751\t         (doseq [task (task-bodies body)\n3752\t                 root (reachable-values task)\n3753\t                 closure (tagged-of :yin.k/closure root)\n3754\t                 :let [store-of (:yin.k/store-of closure)]\n3755\t                 :when (and complete? (some? store-of))]\n3756\t           (when-not (contains? (:yin.k/module-stores task) store-of)\n3757\t             (non-portable! :missing-module-store {engine/store-of-key store-of})))\n3758\t         (when-not (and (if (v2-body? body)\n3759\t                          (some? (ucf/profile-engine (:yin.k/contract body)))\n3760\t                          (= ucf/contract-stamp (:yin.k/contract body)))\n3761\t                        (= (some? header)\n3762\t                           (if (v2-body? body)\n3763\t                             (boolean (some #(contains? body %)\n3764\t                                            [:yin.k/policy :yin.k/occurrence\n3765\t                                             :yin.k/arbitration :yin.k/origin\n3766\t                                             :yin.k/next-op-seq]))\n3767\t                             (= 1 (:yin.k/version body))))\n3768\t                        (or (nil? header)\n3769\t                            (and (map? header) (set? (:yin.k/enrolled header))\n3770\t                                 (every? (fn [[key value]] (= value (get body key)))\n3771\t                                         (header-of header (:yin.k/kind body))))))\n3772\t           (undecodable! {:yin.k/reason :recovery-header}))\n3773\t         {:status :ok :body body\n3774\t          :descriptors (set (map :dao.stream/descriptor\n3775\t                                 (mapcat body-markers (task-bodies body))))})))))\n3776\t\n3777\t\n3778\t(defn resume-task\n3779\t  \"Public entry for 14.1.2 lower.\"\n3780\t  ([recv bytes attach!]\n3781\t   (resume-task recv bytes attach! nil))\n3782\t  ([recv bytes attach! opts]"}]},"parent_tool_use_id":null,"session_id":"ee657710-cc1c-4c43-882b-5874c9a79051","uuid":"37e7cb3c-31dd-4e7f-90bd-5b304f8e26b3","timestamp":"2026-10-12T15:53:13.052Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6b/src/cljc/yin/vm/ucf/handoff.cljc","content":"\n(def ^:private fixed-resource-keys\n  \"The VM's fixed private resource keys, never allocated by the lower\n   (`yin.vm.ucf.remote`'s discipline).\"\n  #{vm/call-in-stream-key vm/call-out-stream-key\n    vm/call-out-cursor-key module/link-request-resource\n    module/link-response-resource})\n\n\n(defn- fresh-key\n  [used]\n  (loop [n (inc (count @used))]\n    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n      (if (contains? @used k)\n        (recur (inc n))\n        (do (swap! used conj k) k)))))\n\n\n(defn- body-markers\n  \"Every stream marker the body's encoded roots name: the cells' own\n   streams, the pendings' endpoint markers, and every marker a store,\n   a register, a parked record, a closure or the halt result carries.\n   A stream referenced only there is attached exactly like one a\n   pending names -- collecting less would have the decoder refuse a\n   reference the encoder minted.  `attach-all!` deduplicates by\n   stream identity.\"\n  [body]\n  (mapcat #(tagged-of :yin.k/stream %)\n          (reachable-values body)))\n\n\n(defn- attach-all!\n  \"One attach per distinct stream identity, through `attach!`; the\n   first refusal -- a reflection marked gone included -- is\n   :yin.k/unsatisfied naming that identity.\"\n  [attach! markers]\n  (reduce (fn [acc mkr]\n            (let [identity (:dao.stream/identity mkr)]\n              (if (contains? acc identity)\n                acc\n                (if-some [h (ucf.remote/lower-marker attach! mkr)]\n                  (assoc acc identity h)\n                  (unsatisfied! identity)))))\n          {}\n          markers))\n\n\n(defn- decode-env-v2\n  [decode e]\n  (cond-> (into {}\n                (map (fn [[k v]] [k (decode v)]))\n                (:yin.k/bindings e))\n    (some? (:yin.k/store-of e))\n    (assoc engine/store-of-key (:yin.k/store-of e))))\n\n\n(defn- decode-kw\n  \"The native walker continuation chain a wire frame chain denotes:\n   addressed nodes are the receiver's decoded rows, runtime fields come\n   back as values, and an absent environment stays absent.\"\n  [node-of decode kw]\n  (when (some? kw)\n    (let [t (:yin.k/type kw)\n          base (cond-> {:type t\n                        :next (decode-kw node-of decode (:yin.k/next kw))}\n                 (contains? kw :yin.k/env)\n                 (assoc :env (decode-env-v2 decode (:yin.k/env kw))))\n          node (node-of (:yin.k/node kw))]\n      (case t\n        (:eval-operator :eval-test :eval-stream-put-target\n                        :eval-stream-cursor-source :eval-stream-next-cursor\n                        :eval-stream-close-source)\n        (assoc base :frame node)\n\n        :eval-operand\n        (assoc base :frame (assoc node\n                                  :operator-evaluated? true\n                                  :fn (decode (:yin.k/function kw))\n                                  :evaluated (mapv decode\n                                                   (:yin.k/evaluated kw))))\n\n        :dao.stream.apply/eval-operand\n        (assoc base :frame {:op (:op node)\n                            :operands (:operands node)\n                            :evaluated (mapv decode (:yin.k/evaluated kw))})\n\n        :eval-stream-put-val\n        (assoc base\n               :frame node\n               :stream-ref (decode (:yin.k/stream-ref kw)))\n\n        :dao.stream.apply/request-sent\n        (assoc base :parked-id (:yin.k/parked-id kw) :op (:yin.k/op kw))\n\n        :dao.stream.apply/eval-call\n        (cond-> base\n          (contains? kw :yin.k/call-id) (assoc :call-id (:yin.k/call-id kw)))\n\n        :eval-define (assoc base :name (:yin.k/name kw))\n        :eval-resume-val (assoc base :parked-id (:yin.k/parked-id kw))))))\n\n\n(defn- decode-registers-v2\n  \"One version-2 register map back in the receiver's native coordinates:\n   segments through the alias column of the attached code (`ctx`'s\n   `:aliases`), or the layout rebuilt from the carried `:code`, values\n   decoded and re-sealed under the receiving task.\"\n  [engine decode {:keys [aliases code node-of]} r]\n  (case engine\n    :walker\n    {:env (decode-env-v2 decode (:yin.k/env r))\n     :k (decode-kw node-of decode (:yin.k/k r))}\n    :stack\n    (let [c (stack/compose (mapv code (:yin.k/layout r)))\n          frames (fn [fs] (mapv #(mapv decode %) fs))]\n      (cond-> {:segment (:segment c)\n               :hash (:hash c)\n               :format stack/format-tag\n               :image (:yin.k/image r)\n               :pc (:yin.k/pc r)\n               :frames (frames (:yin.k/frames r))\n               :stack (mapv decode (:yin.k/stack r))\n               :continuation\n               (mapv (fn [f]\n                       (cond-> {:return-pc (:yin.k/return-pc f)\n                                :frames (frames (:yin.k/frames f))\n                                :stack-base (:yin.k/stack-base f)}\n                         (some? (:yin.k/store-of f))\n                         (assoc :store-of (:yin.k/store-of f))))\n                     (:yin.k/continuation r))}\n        (some? (:yin.k/store-of r))\n        (assoc :store-of (:yin.k/store-of r))))\n    :register\n    (let [c (register/compose (mapv code (:yin.k/layout r)))\n          frames (fn [fs] (mapv #(mapv decode %) fs))\n          pairs (fn [regs] (mapv (fn [[i x]] [i (decode x)]) regs))]\n      (cond-> {:segment (:segment c)\n               :hash (:hash c)\n               :format reffects/format-tag\n               :image (:yin.k/image r)\n               :site-pc (:yin.k/site-pc r)\n               :pc (:yin.k/pc r)\n               :frames (frames (:yin.k/frames r))\n               :regs (pairs (:yin.k/regs r))\n               :live (:yin.k/live r)\n               :continuation\n               (mapv (fn [f]\n                       (cond-> {:site-pc (:yin.k/site-pc f)\n                                :return-pc (:yin.k/return-pc f)\n                                :frames (frames (:yin.k/frames f))\n                                :regs (pairs (:yin.k/regs f))\n                                :live (:yin.k/live f)\n                                :dest (:yin.k/dest f)}\n                         (some? (:yin.k/store-of f))\n                         (assoc :store-of (:yin.k/store-of f))))\n                     (:yin.k/continuation r))\n               :dest (:yin.k/dest r)\n               :resume-mode (:yin.k/resume-mode r)}\n        (< 1 (count (:images c))) (assoc :images (:images c))\n        (some? (:yin.k/store-of r))\n        (assoc :store-of (:yin.k/store-of r))))\n    :semantic\n    {:segment (get aliases (:yin.k/segment r))\n     :pc (:yin.k/pc r)\n     :env (decode-env-v2 decode (:yin.k/env r))\n     :stack (mapv decode (:yin.k/stack r))\n     :k (mapv (fn [f]\n                {:type :return\n                 :segment (get aliases (:yin.k/segment f))\n                 :pc (:yin.k/pc f)\n                 :env (decode-env-v2 decode (:yin.k/env f))\n                 :stack-base (:yin.k/stack-base f)})\n              (:yin.k/k r))}\n    (undecodable! {:yin.k/kind :unsupported-profile})))\n\n\n(defn- value-decoder\n  \"The decode half, over the receiver's coordinates: literals back to\n   maps, closures through the kernel against the attached code,\n   primitives from the receiver's own registry under an equal profile,\n   and stream and cursor markers as fresh references sealed under the\n   receiving task's own secret.\"\n  ([recv streams cells]\n   (value-decoder recv streams cells nil))\n  ([recv streams cells frames]\n   (letfn [(decode\n             [x]\n             (cond\n               (scalar? x) x\n               (jing.cbor/numeric? x) x\n               (map? x)\n               (case (:yin.k/tag x)\n                 :yin.k/frame\n                 (if (and frames (contains? x :yin.k/parked-id))\n                   ((:parked @frames) (:yin.k/parked-id x))\n                   (if frames\n                     (values/continuation\n                       (:owner recv)\n                       (assoc ((:reified @frames) (:yin.k/registers x))\n                              :type :reified-continuation))\n                     (undecodable! {:yin.k/tag :yin.k/frame})))\n                 :yin.k/literal\n                 (let [e (:yin.k/entries x)]\n                   (if (even? (count e))\n                     (into {}\n                           (map (fn [[k v]] [(decode k) (decode v)]))\n                           (partition 2 e))\n                     (undecodable! {:yin.k/tag :yin.k/literal})))\n                 :yin.k/closure (module/lower-closure recv x decode)\n                 :yin.k/primitive\n                 (let [n (:yin.k/name x)\n                       entry (get (:primitives recv) n)]\n                   (if (and (some? entry)\n                            (= (:yin.k/profile x)\n                               (:yin.k/profile\n                                 (vm/profile-of (:primitives recv) n))))\n                     (vm/primitive-function entry)\n                     (refuse! :yin.k/unsatisfied {:yin.k/name n})))\n                 :yin.k/stream\n                 (if-some [k (get streams (:dao.stream/identity x))]\n                   (engine/issue-ref recv :stream-ref k)\n                   (undecodable! {:dao.stream/identity\n                                  (:dao.stream/identity x)}))\n                 :yin.k/cursor-ref\n                 (if-some [k (get cells (:yin.k/cell x))]\n                   (engine/issue-ref recv :cursor-ref k)\n                   (undecodable! {:yin.k/cell (:yin.k/cell x)}))\n                 (undecodable! {:yin.k/tag (:yin.k/tag x)}))\n               (vector? x) (mapv decode x)\n               (set? x) (into #{} (map decode) x)\n               (seq? x) (apply list (map decode x))\n               :else (undecodable! {:yin.k/kind :host-object})))]\n     decode)))\n\n\n(defn- spawn-child-template\n  \"A fresh child VM of the receiver's composition for one install\n   response -- the engine's own spawn discipline (yin.vm.linker.md\n   7.3): nothing of the receiver's state but its composition values,\n   a fresh origin tag, and the secret the composition's source mints\n   for it.\"\n  [recv response module-name fenced?]\n  (let [n (or (:origins recv) 0)\n        origin (keyword (str (name (or (:origin recv) :t0)) \".\" n))\n        registry (reduce (fn [r [m e]]\n                           (module/assoc-module r m (dissoc e :bindings)))\n                         (:modules recv)\n                         (module/module-entries (:modules recv)))\n        source (:secret-source recv)\n        child (module/spawn-module\n                (cond-> recv fenced? (assoc :make-stream nil :resources {}))\n                (:value (:image response))\n                {:modules registry\n                 :origin origin\n                 :ancestry (conj (vec (:ancestry recv)) module-name)\n                 :capability-secret (when (fn? source) (source origin))})]\n    (assoc child :origins (inc n) :make-stream (:make-stream recv))))\n\n\n(defn- child-bytes\n  \"A child body re-encoded for its own recursive resume under the codec\n   its version rides: version 1 in jing canonical bytes, version 0 in\n   the stream codec, exactly as it arrived inside its parent.\"\n  [child-body]\n  (if (= 0 (:yin.k/version child-body))\n    (cbor/encode child-body)\n    (jing.cbor/encode child-body)))\n\n\n(defn- resume-installs\n  \"Each install child resumed into a fresh child of the receiver's\n   composition, its phase and response carried: the receiver's own\n   scheduler steps it exactly as the source's did.  A child that\n   refuses -- its bytes undecodable, a stream it names unattachable\n   -- aborts the parent's restoration: the refusal is thrown here,\n   before any machine value is assembled, so the parent never answers\n   :ok over a child that did not lower.  The child is resumed as an\n   install child, not a custody root: its own reader pass skips the\n   custody step the root already ran over it.\"\n  [recv body attach! opts fenced?]\n  (into {}\n        (map-indexed (fn [index [m inst]]\n                       (let [response (:yin.k/response inst)\n                             child-body (:yin.k/child inst)\n                             resumed (resume-task*\n                                       (if-some [spawn (:child-of opts)]\n                                         (spawn recv response m)\n                                         (spawn-child-template\n                                           (cond-> recv\n                                             fenced? (assoc :origins (+ (or (:origins recv) 0) index)))\n                                           response m fenced?))\n                                       (child-bytes child-body)\n                                       attach!\n                                       opts\n                                       true\n                                       fenced?)]\n                         (when (not= :ok (:status resumed))\n                           (refuse! (:yin.k/status resumed)\n                                    (dissoc resumed :yin.k/status)))\n                         [m {:phase (or (:yin.k/phase inst) :running)\n                             :parent (:yin.k/parent inst)\n                             :response response\n                             :vm (:vm resumed)}])))\n        (:yin.k/installs body)))\n\n\n(defn- link-pair-resources\n  \"The engine's fixed link keys mapped onto the reflections a lowered\n   link wait uses, so a migrated link wait parks where the engine's\n   own sweep polls it.\"\n  [streams resources pendings]\n  (reduce (fn [acc pending]\n            (if (contains? #{:link-request :link-response}\n                           (:yin.k/reason pending))\n              (let [req (get resources\n                             (streams (get-in pending\n                                              [:yin.k/request\n                                               :dao.stream/identity])))\n                    resp (get resources\n                              (streams (get-in pending\n                                               [:yin.k/response\n                                                :dao.stream/identity])))]\n                (if (and req resp)\n                  (assoc acc\n                         module/link-request-resource req\n                         module/link-response-resource resp)\n                  acc))\n              acc))\n          {}\n          pendings))\n\n\n(defn- lower-frame!\n  \"One pending lowered back into the engine's own wait-set entry\n   shape, the receiver's register context riding verbatim under the\n   fields the variant rebuilds (`yin.vm.ucf.remote`'s shapes, through\n   this lower's own fresh keys).\"\n  [engine decode streams cells cell-keys pending ctx]\n  (let [walker? (= :walker engine)\n        stream-of (fn [marker]\n                    (streams (:dao.stream/identity marker)))\n        cell-stream (fn [cid]\n                      (stream-of (get-in cells [cid :yin.k/stream])))\n        cell-key (fn [cid] (get cell-keys cid))]\n    (case (:yin.k/reason pending)\n      :next\n      (merge ctx\n             {:reason :next\n              :stream-id (cell-stream (:yin.k/cell pending))\n              :cursor-ref {:type :cursor-ref\n                           :id (cell-key (:yin.k/cell pending))}})\n\n      :ffi\n      (merge ctx\n             (cond-> {:reason :next\n                      :stream-id (cell-stream (:yin.k/cell pending))\n                      :cursor-ref {:type :cursor-ref\n                                   :id (cell-key (:yin.k/cell pending))}}\n               (not walker?)\n               (assoc :call-id (:yin.k/call-id pending))\n               (and (not walker?) (contains? pending :yin.k/op))\n               (assoc :op (:yin.k/op pending))))\n\n      :put\n      (merge ctx\n             {:reason :put\n              :stream-id (stream-of (:yin.k/stream pending))\n              :datom (decode (:yin.k/value pending))})\n\n      :ffi-request\n      (merge ctx\n             (cond-> {:reason :put\n                      :stream-id (stream-of (:yin.k/request pending))\n                      :datom (decode (:yin.k/request-envelope pending))}\n               (not walker?)\n               (assoc :request-sent true\n                      :call-id (:yin.k/call-id pending)\n                      :op (:yin.k/request-op pending)\n                      :response-cursor (cell-key (:yin.k/response-cell pending))\n                      :response-stream (stream-of (:yin.k/response pending)))))\n\n      (:link-request :link-response)\n      (let [cid (:yin.k/cell pending)]\n        (merge ctx\n               (cond-> {:reason (:yin.k/reason pending)\n                        :link-id (:yin.k/link-id pending)\n                        :name (:yin.k/name pending)\n                        :request module/link-request-resource\n                        :response module/link-response-resource\n                        :cursor (:yin.k/position (get cells cid))}\n                 (= :link-request (:yin.k/reason pending))\n                 (assoc :envelope (decode (:yin.k/envelope pending))))))\n\n      :install\n      (merge ctx {:reason :install :name (:yin.k/name pending)})\n\n      (undecodable! {:yin.k/reason (:yin.k/reason pending)}))))\n\n\n;; =============================================================================\n;; The version-aware reader (M-next D7): two codecs, one grammar each\n;; =============================================================================\n\n(def ^:private codec-versions\n  \"The body-version contract of each accepting codec, the two-codec\n   split of the D plan's residual 3: stage-1 `dao.stream.cbor` bytes are\n   version 0 only -- that wire is frozen -- and `dao.jing.cbor` canonical\n   bytes are version 1 only, the stream codec's tag-39 identifiers being\n   refused by jing's decoder.  Scalar overlap between the codecs\n   establishes no body compatibility; which codec accepted decides.\"\n  {:stream #{0} :jing #{1 2}})\n\n\n(defn- decode-two\n  \"Reader step 1: the version-1 decode first (jing), then the version-0\n   decode (the stream codec).  Answers `{:codec c :body b}` for the\n   first codec that accepted the bytes; bytes neither decodes are\n   `:yin.k/undecodable`.\"\n  [bytes]\n  (letfn [(attempt\n            [decode]\n            (try {:body (decode bytes)}\n                 (catch #?(:cljd Object :clj Throwable :cljs :default) _\n                   nil)))]\n    (or (when-some [r (attempt jing.cbor/decode)]\n          (assoc r :codec :jing))\n        (when-some [r (attempt cbor/decode)]\n          (assoc r :codec :stream))\n        (undecodable! {:yin.k/kind :bytes}))))\n\n\n(defn- require-tag!\n  \"Reader step 2: the S7.5.1 tag, before any version or address rule.\"\n  [body]\n  (when-not (and (map? body) (true? (get body handoff-tag)))\n    (undecodable! {:yin.k/kind :body})))\n\n\n(defn- version-gate!\n  \"Reader step 3, before the address check (UCF 7.2.1): the version\n   contract of the codec that accepted the bytes.  A version the codec\n   does not speak, an absent version, or one not of the integer kind is\n   `:yin.k/profile-mismatch`, carrying the version as found and the\n   supported set.  Under `opts`' `:exclusive` a version-0 body is the\n   same refusal: a reader that requires exclusive custody never\n   downgrades a fork into it.\"\n  [codec body opts install-child?]\n  (let [supported (get codec-versions codec)\n        v (get body :yin.k/version)]\n    (when-not (and (jing.cbor/numeric? v)\n                   (= :integer (jing.cbor/numeric-kind v))\n                   (contains? supported v))\n      (refuse! :yin.k/profile-mismatch\n               {:yin.k/version v :yin.k/supported supported}))\n    (when (and (:exclusive opts)\n               (if (v2-body? body)\n                 ;; version 2 is a fork exactly when it carries no custody\n                 ;; header key, and only a root is a custody subject\n                 (and (not install-child?)\n                      (not-any? #(contains? body %)\n                                [:yin.k/policy :yin.k/occurrence\n                                 :yin.k/arbitration :yin.k/origin\n                                 :yin.k/next-op-seq]))\n                 (not= 1 v)))\n      (refuse! :yin.k/profile-mismatch\n               {:yin.k/version v\n                :yin.k/supported #{1 2}\n                :yin.k/policy :yin.k/exclusive}))))\n\n\n(defn- custody-inspect!\n  \"Reader step 4, version 1 only: `checkpoint/inspect` over the claimed\n   address and the exact bytes -- the address (`:yin.k/hash-mismatch`)\n   first, then the custody grammar, including an entry for every install\n   pending.  The address is the one `opts` names, the address the bytes\n   were fetched under; unnamed, it is the address of the bytes\n   themselves.  A structural failure here is never reinterpreted as\n   version 0: the accepting codec is already fixed.  Answers the\n   operation baseline D10's lower will consume.\"\n  [bytes opts]\n  (let [address (or (:address opts) (bytes-address bytes))\n        r (checkpoint/inspect address bytes)]\n    (when (contains? r :yin.k/status)\n      (refuse! (:yin.k/status r) (dissoc r :yin.k/status)))\n    r))\n\n\n(defn- task-bodies\n  [body]\n  (tree-seq #(seq (:yin.k/installs %))\n            #(map :yin.k/child (vals (:yin.k/installs %))) body))\n\n\n(defn- accept-grant!\n  [body opts]\n  (let [grant (:grant opts)\n        evidence (:evidence grant)]\n    (when-not (and (or (nil? grant) (map? grant))\n                   (or (nil? evidence) (map? evidence)))\n      (throw (ex-info \"Malformed lower grant or evidence\" {})))\n    (when-not evidence\n      (refuse! :yin.k/awaiting-grant {}))\n    (when-not (= :yin.k/ready (:yin.k/status evidence))\n      (refuse! (if (= :yin.k/awaiting-grant (:yin.k/status evidence))\n                 :yin.k/awaiting-grant :yin.k/unsatisfied)\n               (dissoc evidence :yin.k/status)))\n    (let [binding (:yin.k/binding evidence)\n          prefix (:yin.k/prefix evidence)\n          tenure (:tenure grant)\n          occurrence (:yin.k/occurrence body)\n          lease (:dao.lease/lease grant)\n          holder (:dao.lease/holder grant)\n          frontier (:yin.k/frontier prefix)\n          records (:yin.k/inputs prefix)]\n      (when-not (and (map? binding) (map? tenure))\n        (throw (ex-info \"Malformed lower binding or tenure\" {})))\n      (when (or (nil? prefix) (:yin.k/status prefix))\n        (refuse! :yin.k/unsatisfied\n                 {:yin.k/reason (or (:yin.k/reason prefix) :unavailable)}))\n      (when-not (and (some? (:address opts))\n                     (= (:checkpoint grant) (:address opts))\n                     (= occurrence (:yin.k/occurrence binding))\n                     (some? lease) (= lease (:dao.lease/lease binding))\n                     (some? holder) (= holder (:dao.lease/holder binding))\n                     (= (get-in body [:yin.k/arbitration :dao.stream/identity])\n                        (get-in binding [:yin.k/transaction :yin.k/arbitration]))\n                     (custody/exact? (:yin.k/epoch binding))\n                     (true? (:live tenure))\n                     (number? (:now tenure)) (number? (:bound tenure))\n                     (< (:now tenure) (:bound tenure))\n                     (= occurrence (:yin.k/occurrence prefix))\n                     (= lease (:dao.lease/lease prefix))\n                     (custody/exact? frontier) (vector? records)\n                     (= frontier (count records))\n                     (every? true? (map-indexed\n                                     (fn [index record]\n                                       (and (custody/exact? (:yin.k/input-seq record))\n                                            (= index (:yin.k/input-seq record))))\n                                     records)))\n        (refuse! :yin.k/not-holder {}))\n      (let [classes (:protection opts)\n            enrolled (:yin.k/enrolled evidence)]\n        (when-not (and (map? classes)\n                       (every? #{:enrolled :at-least-once :fail-stop} (vals classes))\n                       (set? enrolled))\n          (throw (ex-info \"Malformed lower protection or enrollment\" {})))\n        (doseq [task (task-bodies body)\n                marker (body-markers task)]\n          (let [identity (:dao.stream/identity marker)\n                class (get classes identity)]\n            (when-not (and class (= (= class :enrolled)\n                                    (contains? enrolled identity)))\n              (unsatisfied! identity))))\n        (doseq [task (task-bodies body)\n                frame (:yin.k/frames task)\n                :let [pending (:yin.k/pending frame)\n                      reason (:yin.k/reason pending)]\n                :when (contains? #{:put :ffi-request :link-request} reason)]\n          (let [marker (if (= :put reason) (:yin.k/stream pending)\n                           (:yin.k/request pending))\n                identity (:dao.stream/identity marker)]\n            (when-not (= (= :enrolled (get classes identity))\n                         (contains? pending :yin.k/op-id))\n              (unsatisfied! identity))))\n        {:yin.k/occurrence occurrence\n         :dao.lease/lease lease :dao.lease/holder holder\n         :yin.k/epoch (:yin.k/epoch binding)\n         :yin.k/arbitration (:yin.k/arbitration body)\n         :yin.k/next-op-seq (:yin.k/next-op-seq body)\n         :protection classes :input {:next 0 :prefix prefix}\n         :tenure {:bound (:bound tenure)}}))))\n\n\n(defn- isolated-receiver\n  [recv]\n  (reduce (fn [machine [module-name entry]]\n            (update machine :modules module/assoc-module module-name\n                    entry))\n          (-> recv\n              (assoc :store {} :module-stores {} :parked {} :installs {})\n              (assoc-in [:modules :modules] {})\n              (dissoc :yin.k/custody :yin.k/gate :yin.k/closes :yin.k/issued\n                      :yin.k/recovery-cell-ids :yin.k/recovery-waits))\n          (filter (fn [[_ entry]] (nil? (:address entry)))\n                  (module/module-entries (:modules recv)))))\n\n\n(defn- primitives-satisfied!\n  \"Every primitive any task of the tree names exists in `recv`'s own\n   registry under an equal profile, or the lower is `:yin.k/unsatisfied`\n   naming it: judged on the bytes' markers before one attachment is made,\n   never found missing at decode time.\"\n  [recv body]\n  (doseq [task (task-bodies body)\n          root (reachable-values task)\n          marker (tagged-of :yin.k/primitive root)]\n    (let [n (:yin.k/name marker)\n          entry (get (:primitives recv) n)]\n      (when-not (and (some? entry)\n                     (= (:yin.k/profile marker)\n                        (:yin.k/profile (vm/profile-of (:primitives recv) n))))\n        (refuse! :yin.k/unsatisfied {:yin.k/name n})))))\n\n\n(defn- resume-task*\n  \"The lower of 14.1.2 behind the version-aware reader of M-next D7:\n   `bytes`, a handoff body this namespace minted, resumed into a fresh\n   task over `recv` -- a machine of the receiver's own composition.\n   Before any attachment or restoration, in this order: the two-codec\n   decode (jing first, then the stream codec; neither accepting is\n   `:yin.k/undecodable`), the tag, the version gate of the accepting\n   codec (`:yin.k/profile-mismatch`, before the address check), and --\n   version 1 only -- `checkpoint/inspect` over the address `opts` names\n   (`:yin.k/hash-mismatch`, then the custody grammar); then the full\n   recursive grammar of `validate-body`, the contract stamp and the\n   restoration itself.  `opts` may name `:exclusive` (a version-0 body\n   is then refused; without it such a body still lowers as a fork) and\n   `:address`. A blocked or parked version-1 root additionally requires\n   `:grant` (checkpoint, lease, holder, evidence and current tenure) and\n   `:protection` keyed by portable stream identity. Grant consistency and\n   recursive protection checks precede all attachments. Missing evidence\n   answers `:yin.k/awaiting-grant`, invalid binding `:yin.k/not-holder`,\n   and unavailable evidence or protection mismatch `:yin.k/unsatisfied`.\n   Accepted custody restores the body's operation counter exactly and\n   starts input replay at zero. Halted version-1 results need no grant\n   and are gated ended. Install children are resumed as children, their pass\n   skipping the custody step their root already ran.  Answers\n   `{:status :ok :kind k :vm resumed}` or the first data refusal:\n   `:yin.k/undecodable` bytes or grammar, `:yin.k/profile-mismatch`\n   stamp or version, `:yin.k/hash-mismatch` address or code,\n   `:yin.k/unsatisfied` a stream that cannot be attached or a primitive\n   the receiver cannot answer.  Nothing partially runnable is ever\n   exposed: the machine value is assembled only after every restoration\n   step passes.  `attach!` is the receiver's own `:dao.stream/attach`\n   dispatch, exactly `yin.vm.ucf.remote`'s; a version-0 resume is a\n   fork.\"\n  ([recv bytes attach!]\n   (resume-task recv bytes attach! nil))\n  ([recv bytes attach! opts install-child?]\n   (resume-task* recv bytes attach! opts install-child? false))\n  ([recv bytes attach! opts install-child? fenced?]\n   (call!\n     (fn []\n       (let [{:keys [codec body]} (decode-two bytes)\n             _ (require-tag! body)\n             _ (version-gate! codec body opts install-child?)\n             v2? (v2-body? body)\n             _ (when (and (or v2? (= 1 (:yin.k/version body)))\n                          (not install-child?))\n                 (custody-inspect! bytes opts))\n             _ (validate-body body)\n             engine (when v2? (ucf/profile-engine (:yin.k/contract body)))\n             _ (if v2?\n                 (when-not (= engine (engine-of recv))\n                   (refuse! :yin.k/profile-mismatch\n                            {:yin.k/contract (:yin.k/contract body)\n                             :yin.k/supported ucf/supported-profiles}))\n                 (when-not (= ucf/contract-stamp\n                              (:yin.k/contract body))\n                   (refuse! :yin.k/profile-mismatch\n                            {:yin.k/contract (:yin.k/contract body)})))\n             _ (when v2?\n                 (primitives-satisfied! recv body))\n             kind (:yin.k/kind body)\n             ;; a version-2 tree is a fork exactly when its root carries no\n             ;; custody header key; its children inherit the root's role\n             tree-fork? (if install-child?\n                          (boolean (::fork opts))\n                          (and v2? (not-any? #(contains? body %)\n                                             [:yin.k/policy :yin.k/occurrence\n                                              :yin.k/arbitration :yin.k/origin\n                                              :yin.k/next-op-seq])))\n             opts (assoc opts ::fork tree-fork?)\n             version-one? (or (= 1 (:yin.k/version body))\n                              (and v2? (not tree-fork?)))\n             custody-state (when (and version-one? (not install-child?) (not fenced?)\n                                      (not= :halted kind))\n                             (accept-grant! body opts))\n             cells (:yin.k/cells body)\n             pendings (mapv :yin.k/pending\n                            (or (:yin.k/frames body) []))\n             recv' (cond\n                     (= :walker engine)\n                     (walker/attach-rows\n                       (walker/clear-code (isolated-receiver recv))\n                       (:yin.k/code body)\n                       vm/ast-contract)\n                     (pc-profile? engine)\n                     ((if (= :stack engine) stack/rebuild register/rebuild)\n                      (isolated-receiver recv)\n                      (mapv (:yin.k/code body) (:yin.k/layout body)))\n                     :else\n                     (reduce (fn [r [_a v]] (module/attach-module r v))\n                             (cond\n                               (= :semantic engine)\n                               ;; the receiver's own code layout is cleared\n                               ;; before the body's is rebuilt (v2, 9)\n                               (assoc (isolated-receiver recv)\n                                      :code {} :code-aliases {} :program nil)\n                               (or version-one? v2? fenced?)\n                               (isolated-receiver recv)\n                               :else recv)\n                             (:yin.k/code body)))\n             handles (attach-all! attach! (body-markers body))\n             used (atom (into fixed-resource-keys\n                              (keys (:resources recv))))\n             streams (into {}\n                           (map (fn [identity]\n                                  [identity (fresh-key used)]))\n                           (sort-by str (keys handles)))\n             resources (into {}\n                             (map (fn [[identity k]]\n                                    [k (get handles identity)]))\n                             streams)\n             cell-keys (into {}\n                             (map (fn [cid] [cid (fresh-key used)]))\n                             (sort-by str (keys cells)))\n             cell-resources (into {}\n                                  (map (fn [[cid k]]\n                                         [k\n                                          {:stream-id\n                                           (streams\n                                             (get-in cells\n                                                     [cid :yin.k/stream\n                                                      :dao.stream/identity]))\n                                           :cursor\n                                           (get-in cells\n                                                   [cid\n                                                    :yin.k/position])}]))\n                                  cell-keys)\n             frame-hooks (atom nil)\n             decode (value-decoder recv' streams cell-keys frame-hooks)\n             aliases (:code-aliases recv')\n             decode-regs (if v2?\n                           (partial decode-registers-v2 engine decode\n                                    {:aliases aliases\n                                     :code (:yin.k/code body)\n                                     :node-of (partial walker/row-node recv')})\n                           (partial decode-registers decode aliases))\n             parked-cache (atom {})\n             resolving (atom #{})\n             resolve-parked\n             (fn [pid]\n               (or (get @parked-cache pid)\n                   (do (when (contains? @resolving pid)\n                         (non-portable! :non-canonicalizable\n                                        {:yin.k/hint :parked-cycle}))\n                       (swap! resolving conj pid)\n                       (let [rec (assoc (decode-regs\n                                          (get-in body [:yin.k/parked pid]))\n                                        :type :parked-continuation\n                                        :id pid)]\n                         (swap! parked-cache assoc pid rec)\n                         (swap! resolving disj pid)\n                         rec))))\n             _ (when v2?\n                 (reset! frame-hooks {:parked resolve-parked\n                                      :reified decode-regs}))\n             ;; the isolated slice installs through `store-put`, so a\n             ;; reserved key inside a tampered body refuses here exactly\n             ;; as a program write would (Rule R), before the checked\n             ;; store lands on the receiver in one write\n             store (reduce (fn [s [k v]]\n                             (engine/store-put s (decode k) (decode v)))\n                           (or (:store recv') {})\n                           (:yin.k/store body))\n             module-stores (into {}\n                                 (map (fn [[m s]]\n                                        [m (into {}\n                                                 (map (fn [[k v]]\n                                                        [(decode k)\n                                                         (decode v)]))\n                                                 s)]))\n                                 (:yin.k/module-stores body))\n             parked (into {}\n                          (map (fn [[pid r]]\n                                 [pid (if v2?\n                                        (resolve-parked pid)\n                                        (assoc\n                                          (decode-registers decode aliases r)\n                                          :type :parked-continuation\n                                          :id pid))]))\n                          (:yin.k/parked body))\n             installs (resume-installs recv' body attach! opts fenced?)\n             registers (mapv (fn [frame]\n                               (decode-regs (:yin.k/registers frame)))\n                             (or (:yin.k/frames body) []))\n             raw-entries (mapv (fn [pending ctx]\n                                 (cond-> (lower-frame! engine decode streams cells cell-keys\n                                                       pending ctx)\n                                   (and version-one? (contains? pending :yin.k/op-id))\n                                   (assoc :op-id (:yin.k/op-id pending))))\n                               pendings registers)\n             [entries issued] (if version-one?\n                                (reduce (fn [[acc issue] entry]\n                                          (if (= :put (:reason entry))\n                                            [(conj acc (assoc entry :yin.k/issue issue)) (inc issue)]\n                                            [(conj acc entry) issue]))\n                                        [[] 0]\n                                        raw-entries)\n                                [raw-entries nil])\n             machine (cond-> (-> recv'\n                                 (assoc :store store\n                                        :module-stores (merge (:module-stores recv')\n                                                              module-stores)\n                                        :parked (merge (:parked recv') parked)\n                                        :installs (merge (:installs recv') installs)\n                                        :resources (merge (:resources recv')\n                                                          resources\n                                                          cell-resources\n                                                          (when (or fenced? (= :walker engine))\n                                                            (reduce (fn [acc pending]\n                                                                      (if (= :ffi-request (:yin.k/reason pending))\n                                                                        (assoc acc\n                                                                               vm/call-in-stream-key\n                                                                               (get resources (streams (get-in pending [:yin.k/request :dao.stream/identity])))\n                                                                               vm/call-out-stream-key\n                                                                               (get resources (streams (get-in pending [:yin.k/response :dao.stream/identity])))\n                                                                               vm/call-out-cursor-key\n                                                                               (get cell-resources (cell-keys (:yin.k/response-cell pending))))\n                                                                        acc))\n                                                                    {} pendings))\n                                                          (link-pair-resources\n                                                            streams resources\n                                                            pendings))\n                                        :id-counter (max (or (:id-counter recv') 0)\n                                                         (or (:yin.k/id-counter body)\n                                                             0))\n                                        :ready-queue []\n                                        :control nil\n                                        :k nil))\n                       (pc-profile? engine)\n                       (assoc :free-env (decode-env-v2 decode (:yin.k/free-env body)))\n                       version-one?\n                       (assoc :yin.k/issued issued\n                              :yin.k/gate (if (and (not install-child?)\n                                                   (= :halted kind))\n                                            :ended :running))\n                       fenced? (assoc :yin.k/gate :exporting\n                                      :yin.k/recovery-cell-ids\n                                      (into (into {} (map (fn [[cell-id resource-id]]\n                                                            [resource-id cell-id])) cell-keys)\n                                            (keep (fn [pending]\n                                                    (when (contains? #{:link-request :link-response}\n                                                                     (:yin.k/reason pending))\n                                                      [[module/link-response-resource\n                                                        (get-in cells [(:yin.k/cell pending) :yin.k/position])]\n                                                       (:yin.k/cell pending)])))\n                                            pendings)\n                                      :id-counter (or (:yin.k/id-counter body) 0))\n                       custody-state (assoc :yin.k/custody custody-state))]\n         (cond-> {:status :ok\n                  :kind kind\n                  :vm (case kind\n                        :halted\n                        (assoc machine\n                               :halted? true :blocked? false\n                               :value (decode (:yin.k/result body))\n                               :wait-set [])\n\n                        ;; the parked activation waits on nothing; every other\n                        ;; carried frame is still an ordered wait (UCF 7.4.3)\n                        :parked\n                        (assoc machine\n                               :halted? true :blocked? false\n                               :value (get parked (:yin.k/parked-id body))\n                               :wait-set entries)\n\n                        (assoc machine\n                               :halted? false :blocked? true\n                               :value :yin/blocked\n                               :wait-set entries))}\n           fenced? (update :vm (fn [restored]\n                                 (assoc restored\n                                        :yin.k/recovery-waits (:wait-set restored)\n                                        :wait-set [])))))))))\n\n\n(defn rehydrate-fenced-body\n  \"Administrative reconstruction of a validated handoff snapshot.\n   Unlike resume-task, never admits execution or restores custody. Root\n   and install children remain exporting with waits outside the scheduler.\"\n  [receiver bytes attach! address]\n  (resume-task* receiver bytes attach! {:address address} false true))\n\n\n(defn inspect-recovery-body\n  \"Validate an embedded export snapshot before administrative attachment.\"\n  ([bytes address header]\n   (inspect-recovery-body bytes address header true))\n  ([bytes address header complete?]\n   (call!\n     (fn []\n       (let [{:keys [codec body]} (decode-two bytes)]\n         (require-tag! body)\n         (version-gate! codec body nil false)\n         (when (or (v2-body? body) (= 1 (:yin.k/version body)))\n           (custody-inspect! bytes {:address address}))\n         (when-not (jing/segment-bytes-match? address bytes)\n           (refuse! :yin.k/hash-mismatch {}))\n         (validate-body body)\n         (doseq [task (task-bodies body)\n                 root (reachable-values task)\n                 closure (tagged-of :yin.k/closure root)\n                 :let [store-of (:yin.k/store-of closure)]\n                 :when (and complete? (some? store-of))]\n           (when-not (contains? (:yin.k/module-stores task) store-of)\n             (non-portable! :missing-module-store {engine/store-of-key store-of})))\n         (when-not (and (if (v2-body? body)\n                          (some? (ucf/profile-engine (:yin.k/contract body)))\n                          (= ucf/contract-stamp (:yin.k/contract body)))\n                        (= (some? header)\n                           (if (v2-body? body)\n                             (boolean (some #(contains? body %)\n                                            [:yin.k/policy :yin.k/occurrence\n                                             :yin.k/arbitration :yin.k/origin\n                                             :yin.k/next-op-seq]))\n                             (= 1 (:yin.k/version body))))\n                        (or (nil? header)\n                            (and (map? header) (set? (:yin.k/enrolled header))\n                                 (every? (fn [[key value]] (= value (get body key)))\n                                         (header-of header (:yin.k/kind body))))))\n           (undecodable! {:yin.k/reason :recovery-header}))\n         {:status :ok :body body\n          :descriptors (set (map :dao.stream/descriptor\n                                 (mapcat body-markers (task-bodies body))))})))))\n\n\n(defn resume-task\n  \"Public entry for 14.1.2 lower.\"\n  ([recv bytes attach!]\n   (resume-task recv bytes attach! nil))\n  ([recv bytes attach! opts]","numLines":933,"startLine":2850,"totalLines":3784}},"tool_result_meta":[{"id":"toolu_01G6v93PVoEMQCbJPWRS6L8r","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
