ngine/authentic-ref? m :stream-ref x)","+                      [:row (stream-row! ctx (:id x))]","+                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :stream-ref}))","+        :cursor-ref (if (engine/authentic-ref? m :cursor-ref x)","+                      [:cursor-cell (cell-for! ctx (:id x))]","+                      (outcome! :yin.k/non-portable :forged-resource-reference {:yin.k/hint :cursor-ref}))","+        :parked-continuation (if (contains? (:parked m) (:id x))","+                               [:row (node :parked-ref [(:id x)])]","+                               (outcome! :yin.k/non-portable :inconsistent-state {:yin.k/hint :parked-reference}))","+        :cell-ref (outcome! :yin.k/non-portable :cell {:yin.k/hint (:id x)})","+        (collection-value ctx :map (mapcat identity x) x))","+      (vector? x) (collection-value ctx :vec x x)","+      (set? x) (collection-value ctx :set (vec x) x)","+      (seq? x) (collection-value ctx :list (vec x) x)","+      (scalar-literal? x) [:lit x]","+      :else (outcome! :yin.k/non-portable :host-object {}))))","+","+","+(defn- window-node","+  [ctx w]","+  (node :window (mapcat (fn [[r v]] [r (lift-value ctx v)]) w)))","+","+","+(defn- k-node","+  [ctx k]","+  (node :k (mapv (fn [f]","+                   (node :kframe [(address! ctx (:segment f)) (:pc f) (env-node ctx (:env f))","+                                  (window-node ctx (:window f)) (:rd f)]))","+                 (or k []))))","+","+","+(defn- state-node","+  \"An evaluator payload (wait entry, parked record, reified payload) as","+   its :act or :tail row; engine fields are the pending's.\"","+  [ctx p]","+  (if (contains? p :site)","+    (node :tail [(address! ctx (:segment p)) (:site p) (k-node ctx (:k p))])","+    (node :act [(address! ctx (:segment p)) (:pc p) (env-node ctx (:env p))","+                (window-node ctx (:window p)) (k-node ctx (:k p)) (get-in p [:deliver :rd])])))","+","+","+(defn- pending-node","+  \"The observed wait's pending (draft §5.3): the reason is the entry's,","+   never the site's static kind.\"","+  [ctx e]","+  (let [m (:m ctx)]","+    (case (:reason e)","+      :next (if (contains? e :call-id)","+              (node :pending [:ffi (cell-for! ctx (get-in e [:cursor-ref :id])) (:call-id e) (:op e)])","+              (node :pending [:next (cell-for! ctx (get-in e [:cursor-ref :id]))]))","+      :put (if (:request-sent e)","+             (let [carried? (and (:response-cursor e) (:response-stream e))","+                   cursor (if carried? (:response-cursor e) vm/call-out-cursor-key)","+                   response (if carried? (:response-stream e) vm/call-out-stream-key)]","+               (when-not (get (:resources m) cursor) (outcome! :yin.k/unsatisfied nil {}))","+               (node :pending [:ffi-request (:call-id e) (lift-value ctx (:datom e)) (stream-row! ctx (:stream-id e))","+                               (stream-row! ctx response) (cell-for! ctx cursor) (:op-id e)]))","+             (do (when-not (contains? e :datom) (outcome! :yin.k/non-portable :incomplete-write {}))","+                 (node :pending [:put (stream-row! ctx (:stream-id e)) (lift-value ctx (:datom e)) (:op-id e)])))","+      (:link-request :link-response)","+      (let [c (cell! ctx [(:response e) (:cursor e)] (:response e) (:cursor e))","+            base [(:reason e) (:link-id e) (:name e) (stream-row! ctx (:request e)) (stream-row! ctx (:response e)) c]]","+        (node :pending (if (= :link-request (:reason e)) (conj base (:envelope e) (:op-id e)) base)))","+      :install (do (when-not (contains? (:installs m) (:name e))","+                     (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name (:name e)}))","+                   (node :pending [:install (:name e)]))","+      (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/reason (:reason e)}))))","+","+","+(defn- store-node","+  [ctx s]","+  (node :store (mapcat (fn [[k v]]","+               