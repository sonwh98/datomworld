{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UypTVZpCtbLudnL9h9Bdnx","type":"tool_result","content":"1\t(ns yin.vm.ucf.v2-support\n2\t  \"The shared harness of the UCF version-2 rows (docs/design/\n3\t   yin.vm.universal-continuation-format.v2-amendment.md section 11): one\n4\t   machine builder per execution profile, the toy channel and served\n5\t   table of the stage-1 suites, and the reference and resumed drivers.\n6\t   Every row runs real source machines the engine itself parked, over a\n7\t   fresh receiver of the same composition.\"\n8\t  (:require [clojure.walk :as walk]\n9\t            [dao.jing :as jing]\n10\t            [dao.jing.cbor :as jing.cbor]\n11\t            [dao.stream :as stream]\n12\t            [dao.stream.remote :as remote]\n13\t            [dao.stream.ringbuffer :as ringbuffer]\n14\t            [yin.vm :as vm]\n15\t            [yin.vm.engine :as engine]\n16\t            [yin.vm.linearize :as linearize]\n17\t            [yin.vm.module :as module]\n18\t            [yin.vm.ast-walker :as walker]\n19\t            [yin.vm.debruijn-code :as dcode]\n20\t            [yin.vm.debruijn-linearize :as dl]\n21\t            [yin.vm.debruijn-register-code :as rcode]\n22\t            [yin.vm.debruijn-register-compile :as rc]\n23\t            [yin.vm.debruijn.register :as register]\n24\t            [yin.vm.debruijn.stack :as stack]\n25\t            [yin.vm.semantic :as semantic]\n26\t            [yin.vm.test-utils :as tu]\n27\t            [yin.vm.ucf.handoff :as handoff]\n28\t            [yin.vm.ucf.lift-support :as support]))\n29\t\n30\t\n31\t(defn ring\n32\t  [capacity]\n33\t  (:dao.stream/handle\n34\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n35\t                         ringbuffer/capacity-key capacity})))\n36\t\n37\t\n38\t(defn make-ring-stream\n39\t  [capacity]\n40\t  (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n41\t                       ringbuffer/capacity-key capacity}))\n42\t\n43\t\n44\t(def composition\n45\t  \"The composition values every profile's machine shares.\"\n46\t  {:make-stream make-ring-stream\n47\t   :capability-secret tu/secret\n48\t   :modules (module/default-registry)\n49\t   :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))})\n50\t\n51\t\n52\t;; =============================================================================\n53\t;; AST builders\n54\t;; =============================================================================\n55\t\n56\t(defn lit\n57\t  [x]\n58\t  {:type :literal, :value x})\n59\t\n60\t\n61\t(defn v\n62\t  [n]\n63\t  {:type :variable, :name n})\n64\t\n65\t\n66\t(defn lam\n67\t  [params body]\n68\t  {:type :lambda, :params params, :body body})\n69\t\n70\t\n71\t(defn app\n72\t  [f & args]\n73\t  {:type :application, :operator f, :operands (vec args)})\n74\t\n75\t\n76\t(defn def!\n77\t  [k val]\n78\t  (app (v 'yin/def) (lit k) val))\n79\t\n80\t\n81\t(defn then\n82\t  [a b]\n83\t  (app (lam ['_] b) a))\n84\t\n85\t\n86\t(defn cursor-of\n87\t  [source]\n88\t  {:type :stream/cursor, :source source})\n89\t\n90\t\n91\t(defn next-of\n92\t  [source]\n93\t  {:type :stream/next, :source source})\n94\t\n95\t\n96\t(defn let1\n97\t  [param init body]\n98\t  (app (lam [param] body) init))\n99\t\n100\t\n101\t;; =============================================================================\n102\t;; One machine builder per profile\n103\t;; =============================================================================\n104\t\n105\t(def ^:private semantic-vector\n106\t  (comp :vector linearize/lower-rows vm/ast->semantic-bytecode))\n107\t\n108\t\n109\t(defn new-machine\n110\t  \"A fresh empty machine of `engine` over the shared composition.\"\n111\t  ([engine] (new-machine engine nil))\n112\t  ([engine opts]\n113\t   (case engine\n114\t     :semantic (semantic/create-vm (merge composition opts))\n115\t     :stack (stack/create-vm [] (merge composition\n116\t                                       {:primitives vm/primitives}\n117\t                                       opts))\n118\t     :walker (walker/create-vm (merge composition\n119\t                                      {:primitives vm/primitives}\n120\t                                      opts))\n121\t     :register (register/create-vm {:bodies [] :instructions []}\n122\t                                   (merge composition\n123\t                                          {:primitives vm/primitives}\n124\t                                          opts)))))\n125\t\n126\t\n127\t(defn load-ast\n128\t  \"`ast` loaded into `machine` of `engine`.\"\n129\t  [engine machine ast]\n130\t  (case engine\n131\t    :semantic (semantic/load-vector machine (semantic-vector ast)\n132\t                                    vm/semantic-contract)\n133\t    :stack (stack/load-image machine\n134\t                             (:image (dl/adapt (vm/ast->datoms ast)))\n135\t                             vm/stack-contract)\n136\t    :register (register/load-image\n137\t                machine\n138\t                (:image (rc/adapt (vm/ast->datoms ast)))\n139\t                vm/register-contract)\n140\t    :walker (walker/vm-load-rows machine (vm/ast->semantic-bytecode ast)\n141\t                                 vm/ast-contract)))\n142\t\n143\t\n144\t(defn run-ast\n145\t  [engine ast]\n146\t  (vm/run (load-ast engine (new-machine engine) ast)))\n147\t\n148\t\n149\t;; =============================================================================\n150\t;; The toy channel, the served table and the drivers\n151\t;; =============================================================================\n152\t\n153\t(defn toy\n154\t  []\n155\t  (let [ab (ring 64)\n156\t        ba (ring 64)\n157\t        cd {:dao.stream/type :dao.stream.test/channel\n158\t            :dao.stream/identity \"ucf-handoff-toy\"}]\n159\t    {:channel cd, :ab ab, :ba ba,\n160\t     :a-end {:reader ba, :writer ab},\n161\t     :b-end {:reader ab, :writer ba}}))\n162\t\n163\t\n164\t(defn served-peer\n165\t  [t]\n166\t  {:table (atom {})\n167\t   :b-reader (:reader (:b-end t))\n168\t   :b-writer (:writer (:b-end t))\n169\t   :mirror (atom (:dao.stream/cursor\n170\t                   (stream/cursor (:reader (:b-end t))\n171\t                                  :dao.stream/oldest)))})\n172\t\n173\t\n174\t(defn serve-mirror!\n175\t  [peer]\n176\t  (swap! (:mirror peer)\n177\t         #(remote/mirror-step @(:table peer) (:b-reader peer) %\n178\t                              (:b-writer peer))))\n179\t\n180\t\n181\t(defn server\n182\t  \"The exporter's `serve!`: a stable identity per handle, entering it in\n183\t   the peer's table under the toy channel.\"\n184\t  ([peer chan] (server peer chan #{:reader}))\n185\t  ([peer chan surfaces]\n186\t   (fn [h]\n187\t     (if-let [existing (some (fn [[id e]] (when (= h (:handle e)) id))\n188\t                             @(:table peer))]\n189\t       {:dao.stream/identity existing, :dao.stream/channel chan}\n190\t       (let [id (str (gensym \"seg\"))]\n191\t         (swap! (:table peer) assoc id {:handle h, :surface surfaces})\n192\t         {:dao.stream/identity id, :dao.stream/channel chan})))))\n193\t\n194\t\n195\t(defn attacher\n196\t  [t]\n197\t  (remote/attacher\n198\t    {:dao.stream.remote/channels {(:channel t) (:a-end t)}}))\n199\t\n200\t\n201\t(defn drive-local\n202\t  \"Run a blocked machine against its own local streams until it stops\n203\t   blocking: the reference run.\"\n204\t  ([m] (drive-local m 64))\n205\t  ([m rounds]\n206\t   (loop [m (vm/run m), n rounds]\n207\t     (if (or (not (vm/blocked? m)) (zero? n))\n208\t       m\n209\t       (recur (vm/run m) (dec n))))))\n210\t\n211\t\n212\t(defn drive\n213\t  \"Run a resumed machine through its reflections, stepping the source's\n214\t   mirror between rounds, until it stops blocking.\"\n215\t  ([m peer] (drive m peer 64))\n216\t  ([m peer rounds]\n217\t   (loop [m (vm/run m), n rounds]\n218\t     (if (or (not (vm/blocked? m)) (zero? n))\n219\t       m\n220\t       (do (serve-mirror! peer)\n221\t           (recur (vm/run m) (dec n)))))))\n222\t\n223\t\n224\t(defn stream-of\n225\t  \"The stream handle a parked reader's first wait entry polls.\"\n226\t  [parked]\n227\t  (let [entry (first (:wait-set parked))]\n228\t    (get (:resources parked) (:stream-id entry))))\n229\t\n230\t\n231\t;; =============================================================================\n232\t;; Parked programs, by profile\n233\t;; =============================================================================\n234\t\n235\t(defn parked-reader\n236\t  \"A real machine of `engine` parked on the second read of the stream it\n237\t   makes, A consumed.  Answers [parked source-stream].\"\n238\t  [engine]\n239\t  (let [m0 (run-ast engine\n240\t                    (let1 's {:type :stream/make, :buffer 4}\n241\t                          (let1 'c (cursor-of (v 's))\n242\t                                (then (next-of (v 'c))\n243\t                                      (next-of (v 'c))))))\n244\t        src (stream-of m0)]\n245\t    (stream/append! src \"A\")\n246\t    [(vm/run m0) src]))\n247\t\n248\t\n249\t(defn parked-explicit\n250\t  \"A real machine at an explicit park; the record's environment holds a\n251\t   cursor on a blocked stream.\"\n252\t  [engine]\n253\t  (run-ast engine\n254\t           (let1 's {:type :stream/make, :buffer 4}\n255\t                 (app (lam ['c] {:type :vm/park})\n256\t                      (cursor-of (v 's))))))\n257\t\n258\t\n259\t(defn halted-with\n260\t  [engine ast]\n261\t  (run-ast engine ast))\n262\t\n263\t\n264\t;; =============================================================================\n265\t;; Custody parts (the version-2 exclusive arm)\n266\t;; =============================================================================\n267\t\n268\t(def occurrence \"8f0c6a52-6a1e-4e43-9d55-3f0a4c1b2e01\")\n269\t(def predecessor \"1d3e5b7a-0c2f-4a69-8b11-7e6d5c4b3a02\")\n270\t\n271\t\n272\t(def origin\n273\t  {:yin.k/occurrence predecessor\n274\t   :dao.lease/lease \"lease-7\"\n275\t   :yin.k/emitter \"peer-a\"})\n276\t\n277\t\n278\t(def arbitration\n279\t  {:dao.stream/identity \"arbitration-1\"\n280\t   :dao.stream/descriptor {:dao.stream/type :remote :peer \"peer-b\"}})\n281\t\n282\t\n283\t(defn header\n284\t  \"The exclusive header of an export: counter `n`, the predecessor `o`\n285\t   when the task has one, and the enrolled stream identities.\"\n286\t  ([] (header 0 nil))\n287\t  ([n o] (header n o #{}))\n288\t  ([n o enrolled]\n289\t   (cond-> {:yin.k/occurrence occurrence\n290\t            :yin.k/arbitration arbitration\n291\t            :yin.k/next-op-seq n\n292\t            :yin.k/enrolled enrolled}\n293\t     (some? o) (assoc :yin.k/origin o))))\n294\t\n295\t\n296\t(defn segment-address\n297\t  [bs]\n298\t  (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 bs))))\n299\t\n300\t\n301\t(defn lower-options\n302\t  \"The D10 lower inputs that satisfy all seven grant checks over `bytes`.\"\n303\t  [bytes]\n304\t  (let [body (jing.cbor/decode bytes)\n305\t        identities (into #{}\n306\t                         (comp (filter #(and (map? %)\n307\t                                             (= :yin.k/stream (:yin.k/tag %))))\n308\t                               (map :dao.stream/identity))\n309\t                         (tree-seq coll? seq body))\n310\t        address (segment-address bytes)\n311\t        occurrence (:yin.k/occurrence body)]\n312\t    {:address address\n313\t     :exclusive true\n314\t     :protection (zipmap identities (repeat :at-least-once))\n315\t     :grant {:checkpoint address\n316\t             :dao.lease/lease \"lease-new\"\n317\t             :dao.lease/holder \"holder-new\"\n318\t             :tenure {:now 10 :bound 20 :live true}\n319\t             :evidence {:yin.k/status :yin.k/ready\n320\t                        :yin.k/binding\n321\t                        {:yin.k/occurrence occurrence\n322\t                         :dao.lease/lease \"lease-new\"\n323\t                         :dao.lease/holder \"holder-new\"\n324\t                         :yin.k/epoch 2\n325\t                         :yin.k/transaction\n326\t                         {:yin.k/arbitration\n327\t                          (get-in body [:yin.k/arbitration\n328\t                                        :dao.stream/identity])}}\n329\t                        :yin.k/enrolled #{}\n330\t                        :yin.k/prefix {:yin.k/occurrence occurrence\n331\t                                       :dao.lease/lease \"lease-new\"\n332\t                                       :yin.k/frontier 0\n333\t                                       :yin.k/inputs []}}}}))\n334\t\n335\t\n336\t;; =============================================================================\n337\t;; Parked programs that wait on a write or a call\n338\t;; =============================================================================\n339\t\n340\t(defn call-node\n341\t  [op arg]\n342\t  {:type :dao.stream.apply/call, :op op, :operands [(lit arg)]})\n343\t\n344\t\n345\t(defn parked-writer\n346\t  \"A real machine of `engine` parked on a blocked write: the warm\n347\t   one-slot stream keeps the value retained.  Answers [parked stream].\"\n348\t  [engine]\n349\t  (let [w (support/one-slot-stream \"w\")]\n350\t    (stream/append! w :warmed)\n351\t    (let [m0 (load-ast engine (new-machine engine)\n352\t                       {:type :stream/put, :target (v 'w), :val (lit \"v\")})\n353\t          [ref m0'] (engine/attach-resource m0 w)]\n354\t      [(vm/run (assoc m0' :store {'w ref})) w])))\n355\t\n356\t\n357\t(defn calling-machine\n358\t  ([engine call-in call-out] (calling-machine engine call-in call-out nil))\n359\t  ([engine call-in call-out bridge]\n360\t   (new-machine engine\n361\t                {:call-in call-in\n362\t                 :call-out call-out\n363\t                 :call-out-cursor (vm/mint-oldest call-out :test)\n364\t                 :bridge bridge})))\n365\t\n366\t\n367\t(defn parked-sent-caller\n368\t  \"A machine whose first FFI call was sent and waits for its response;\n369\t   answers [parked call-in call-out].\"\n370\t  [engine]\n371\t  (let [call-in (ring 8)\n372\t        call-out (ring 8)\n373\t        parked (vm/run (load-ast engine\n374\t                                 (calling-machine engine call-in call-out)\n375\t                                 (then (call-node :op/echo \"hello\")\n376\t                                       (call-node :op/echo \"world\"))))]\n377\t    [parked call-in call-out]))\n378\t\n379\t\n380\t(defn parked-retained-caller\n381\t  \"A machine whose first FFI call's request is retained, the call-in\n382\t   stream being full; answers [parked call-in call-out].\"\n383\t  [engine]\n384\t  (let [call-in (support/one-slot-stream \"call-in\")\n385\t        call-out (ring 8)\n386\t        _ (stream/append! call-in :warmed)\n387\t        parked (vm/run (load-ast engine\n388\t                                 (calling-machine engine call-in call-out)\n389\t                                 (then (call-node :op/echo \"hello\")\n390\t                                       (call-node :op/echo \"world\"))))]\n391\t    [parked call-in call-out]))\n392\t\n393\t\n394\t;; =============================================================================\n395\t;; Link waits and install children\n396\t;; =============================================================================\n397\t\n398\t(defn module-image\n399\t  \"The module image of `ast` the linker response carries, by profile.\"\n400\t  [engine ast]\n401\t  (case engine\n402\t    :semantic (semantic-vector ast)\n403\t    :stack (:image (dl/adapt (vm/ast->datoms ast)))\n404\t    :register (:image (rc/adapt (second (vm/ast->datoms-with-root ast))))\n405\t    :walker (vm/ast->semantic-bytecode ast)))\n406\t\n407\t\n408\t(defn module-response\n409\t  \"The `:ok` link response for module `host.mod` exporting `f`: it\n410\t   blocks on one read of its own stream, then defines `f`.\"\n411\t  [engine]\n412\t  {:status :ok\n413\t   :image {:value (module-image\n414\t                    engine\n415\t                    (let1 's {:type :stream/make, :buffer 4}\n416\t                          (then (next-of (cursor-of (v 's)))\n417\t                                (def! 'f (lam [] (lit 42))))))}\n418\t   :manifest {:yin.module/name 'host.mod\n419\t              :yin.module/exports #{'f}}\n420\t   :obligations []})\n421\t\n422\t\n423\t(defn linking-machine\n424\t  [engine request response]\n425\t  (new-machine engine {:link-request request :link-response response}))\n426\t\n427\t\n428\t(defn require-program\n429\t  [name]\n430\t  (app (v 'require) (lit name)))\n431\t\n432\t\n433\t(defn parked-link-request\n434\t  \"A machine whose `:link-request` envelope is retained (the request\n435\t   stream is full).\"\n436\t  [engine]\n437\t  (let [request (support/one-slot-stream \"link-request\")\n438\t        response (ring 64)\n439\t        _ (stream/append! request :warmed)]\n440\t    (vm/run (load-ast engine (linking-machine engine request response)\n441\t                      (require-program 'host.the-module)))))\n442\t\n443\t\n444\t(defn parked-link-response\n445\t  \"A machine whose `:link-request` was sent and waits for the response.\"\n446\t  [engine]\n447\t  (let [request (ring 64)\n448\t        response (ring 64)]\n449\t    (vm/run (load-ast engine (linking-machine engine request response)\n450\t                      (require-program 'host.the-module)))))\n451\t\n452\t\n453\t(defn parked-installer\n454\t  \"A real machine parked at `:install` with a live blocked child:\n455\t   answers [parked child-stream].\"\n456\t  [engine]\n457\t  (let [request (ring 64)\n458\t        response (ring 64)\n459\t        m0 (vm/run (load-ast engine (linking-machine engine request response)\n460\t                             (then (require-program 'host.mod)\n461\t                                   (app (v 'host.mod/f)))))\n462\t        entry (first (:wait-set m0))\n463\t        _ (stream/append! response\n464\t                          (assoc (module-response engine)\n465\t                                 :yin.link/id (:link-id entry)))\n466\t        parked (vm/run m0)\n467\t        child (get-in parked [:installs 'host.mod :vm])\n468\t        child-stream (get (:resources child)\n469\t                          (:stream-id (first (:wait-set child))))]\n470\t    [parked child-stream]))\n471\t\n472\t\n473\t;; =============================================================================\n474\t;; Lift, read and deliver\n475\t;; =============================================================================\n476\t\n477\t(def engines [:semantic :stack :register :walker])\n478\t\n479\t\n480\t(defn lift\n481\t  \"The version-2 lift of `machine` over a toy's served table: fork with a\n482\t   nil header, exclusive with one.\"\n483\t  ([machine t peer] (lift machine t peer nil))\n484\t  ([machine t peer header] (lift machine t peer header #{:reader}))\n485\t  ([machine t peer header surfaces]\n486\t   (handoff/export-task machine (server peer (:channel t) surfaces)\n487\t                        (cond-> {:version 2}\n488\t                          (some? header) (assoc :header header)))))\n489\t\n490\t\n491\t(defn read!\n492\t  \"The version-aware reader over a counting attach!, into a fresh\n493\t   `engine` receiver composed with the attach seam.  Answers\n494\t   [outcome attaches].\"\n495\t  [engine t bytes opts]\n496\t  (let [attaches (atom 0)\n497\t        base (attacher t)\n498\t        attach! (fn [descriptor]\n499\t                  (swap! attaches inc)\n500\t                  (base descriptor))]\n501\t    [(handoff/resume-task (new-machine engine {:attach-stream attach!})\n502\t                          bytes attach! opts)\n503\t     @attaches]))\n504\t\n505\t\n506\t(defn frame-pending\n507\t  [export]\n508\t  (get-in export [:body :yin.k/frames 0 :yin.k/pending]))\n509\t\n510\t\n511\t(defn deliver-next\n512\t  \"The controlled engine apply of one read outcome to the first wait of\n513\t   the gated machine `m`, then normal scheduling to the end.\"\n514\t  [m value]\n515\t  (let [entry (first (:wait-set m))\n516\t        cid (get-in entry [:cursor-ref :id])\n517\t        position (get-in m [:resources cid :cursor])\n518\t        applied (engine/apply-next m entry\n519\t                                   {:dao.stream/outcome :dao.stream/ok\n520\t                                    :dao.stream/value value\n521\t                                    :dao.stream/cursor position})]\n522\t    (drive-local applied)))\n523\t\n524\t\n525\t(defn decoded\n526\t  \"The body the export's canonical bytes decode to.\"\n527\t  [export]\n528\t  (jing.cbor/decode (:bytes export)))\n529\t\n530\t\n531\t(defn stream-blind\n532\t  \"`body` with every served stream identity and channel replaced by a\n533\t   placeholder: two lifts over different served tables compare by the\n534\t   census alone.\"\n535\t  [body]\n536\t  (walk/postwalk (fn [x]\n537\t                   (if (and (map? x) (contains? x :dao.stream/identity))\n538\t                     (assoc x :dao.stream/identity :served\n539\t                            :dao.stream/channel :served)\n540\t                     x))\n541\t                 body))\n542\t\n543\t\n544\t(defn run-beside\n545\t  \"Run `ast` on `m` keeping its code: the semantic and walker profiles\n546\t   load beside what they hold; stack and register attach the program's\n547\t   image to the current layout (a load would replace it, and a parked\n548\t   record names rows of the layout it was parked under) and start there.\"\n549\t  [engine m ast]\n550\t  (vm/run\n551\t    (case engine\n552\t      (:semantic :walker) (load-ast engine m ast)\n553\t      :stack\n554\t      (let [img (:image (dl/adapt (vm/ast->datoms ast)))\n555\t            attached (stack/attach-image m img vm/stack-contract)]\n556\t        (assoc attached\n557\t               :pc (stack/absolute-pc attached [(dcode/image-hash img) 0])\n558\t               :frames [] :stack [] :continuation []\n559\t               :halted? false :blocked? false :value nil))\n560\t      :register\n561\t      (let [img (:image (rc/adapt (vm/ast->datoms ast)))\n562\t            attached (register/attach-image m img vm/register-contract)\n563\t            pc (register/absolute-pc attached [(rcode/register-hash img) 0])\n564\t            body (some #(when (= pc (:start %)) %)\n565\t                       (:bodies (:segment attached)))]\n566\t        (assoc attached\n567\t               :pc pc :frames [] :continuation []\n568\t               :registers (vec (repeat (:registers body) nil))\n569\t               :halted? false :blocked? false :value nil)))))\n570\t"}]},"parent_tool_use_id":null,"session_id":"ee657710-cc1c-4c43-882b-5874c9a79051","uuid":"bb18cf2f-a7e7-46fc-90b9-80b6628d30aa","timestamp":"2026-10-12T15:53:32.175Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6b/test/yin/vm/ucf/v2_support.cljc","content":"(ns yin.vm.ucf.v2-support\n  \"The shared harness of the UCF version-2 rows (docs/design/\n   yin.vm.universal-continuation-format.v2-amendment.md section 11): one\n   machine builder per execution profile, the toy channel and served\n   table of the stage-1 suites, and the reference and resumed drivers.\n   Every row runs real source machines the engine itself parked, over a\n   fresh receiver of the same composition.\"\n  (:require [clojure.walk :as walk]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as jing.cbor]\n            [dao.stream :as stream]\n            [dao.stream.remote :as remote]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.linearize :as linearize]\n            [yin.vm.module :as module]\n            [yin.vm.ast-walker :as walker]\n            [yin.vm.debruijn-code :as dcode]\n            [yin.vm.debruijn-linearize :as dl]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn-register-compile :as rc]\n            [yin.vm.debruijn.register :as register]\n            [yin.vm.debruijn.stack :as stack]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.ucf.handoff :as handoff]\n            [yin.vm.ucf.lift-support :as support]))\n\n\n(defn ring\n  [capacity]\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                         ringbuffer/capacity-key capacity})))\n\n\n(defn make-ring-stream\n  [capacity]\n  (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                       ringbuffer/capacity-key capacity}))\n\n\n(def composition\n  \"The composition values every profile's machine shares.\"\n  {:make-stream make-ring-stream\n   :capability-secret tu/secret\n   :modules (module/default-registry)\n   :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))})\n\n\n;; =============================================================================\n;; AST builders\n;; =============================================================================\n\n(defn lit\n  [x]\n  {:type :literal, :value x})\n\n\n(defn v\n  [n]\n  {:type :variable, :name n})\n\n\n(defn lam\n  [params body]\n  {:type :lambda, :params params, :body body})\n\n\n(defn app\n  [f & args]\n  {:type :application, :operator f, :operands (vec args)})\n\n\n(defn def!\n  [k val]\n  (app (v 'yin/def) (lit k) val))\n\n\n(defn then\n  [a b]\n  (app (lam ['_] b) a))\n\n\n(defn cursor-of\n  [source]\n  {:type :stream/cursor, :source source})\n\n\n(defn next-of\n  [source]\n  {:type :stream/next, :source source})\n\n\n(defn let1\n  [param init body]\n  (app (lam [param] body) init))\n\n\n;; =============================================================================\n;; One machine builder per profile\n;; =============================================================================\n\n(def ^:private semantic-vector\n  (comp :vector linearize/lower-rows vm/ast->semantic-bytecode))\n\n\n(defn new-machine\n  \"A fresh empty machine of `engine` over the shared composition.\"\n  ([engine] (new-machine engine nil))\n  ([engine opts]\n   (case engine\n     :semantic (semantic/create-vm (merge composition opts))\n     :stack (stack/create-vm [] (merge composition\n                                       {:primitives vm/primitives}\n                                       opts))\n     :walker (walker/create-vm (merge composition\n                                      {:primitives vm/primitives}\n                                      opts))\n     :register (register/create-vm {:bodies [] :instructions []}\n                                   (merge composition\n                                          {:primitives vm/primitives}\n                                          opts)))))\n\n\n(defn load-ast\n  \"`ast` loaded into `machine` of `engine`.\"\n  [engine machine ast]\n  (case engine\n    :semantic (semantic/load-vector machine (semantic-vector ast)\n                                    vm/semantic-contract)\n    :stack (stack/load-image machine\n                             (:image (dl/adapt (vm/ast->datoms ast)))\n                             vm/stack-contract)\n    :register (register/load-image\n                machine\n                (:image (rc/adapt (vm/ast->datoms ast)))\n                vm/register-contract)\n    :walker (walker/vm-load-rows machine (vm/ast->semantic-bytecode ast)\n                                 vm/ast-contract)))\n\n\n(defn run-ast\n  [engine ast]\n  (vm/run (load-ast engine (new-machine engine) ast)))\n\n\n;; =============================================================================\n;; The toy channel, the served table and the drivers\n;; =============================================================================\n\n(defn toy\n  []\n  (let [ab (ring 64)\n        ba (ring 64)\n        cd {:dao.stream/type :dao.stream.test/channel\n            :dao.stream/identity \"ucf-handoff-toy\"}]\n    {:channel cd, :ab ab, :ba ba,\n     :a-end {:reader ba, :writer ab},\n     :b-end {:reader ab, :writer ba}}))\n\n\n(defn served-peer\n  [t]\n  {:table (atom {})\n   :b-reader (:reader (:b-end t))\n   :b-writer (:writer (:b-end t))\n   :mirror (atom (:dao.stream/cursor\n                   (stream/cursor (:reader (:b-end t))\n                                  :dao.stream/oldest)))})\n\n\n(defn serve-mirror!\n  [peer]\n  (swap! (:mirror peer)\n         #(remote/mirror-step @(:table peer) (:b-reader peer) %\n                              (:b-writer peer))))\n\n\n(defn server\n  \"The exporter's `serve!`: a stable identity per handle, entering it in\n   the peer's table under the toy channel.\"\n  ([peer chan] (server peer chan #{:reader}))\n  ([peer chan surfaces]\n   (fn [h]\n     (if-let [existing (some (fn [[id e]] (when (= h (:handle e)) id))\n                             @(:table peer))]\n       {:dao.stream/identity existing, :dao.stream/channel chan}\n       (let [id (str (gensym \"seg\"))]\n         (swap! (:table peer) assoc id {:handle h, :surface surfaces})\n         {:dao.stream/identity id, :dao.stream/channel chan})))))\n\n\n(defn attacher\n  [t]\n  (remote/attacher\n    {:dao.stream.remote/channels {(:channel t) (:a-end t)}}))\n\n\n(defn drive-local\n  \"Run a blocked machine against its own local streams until it stops\n   blocking: the reference run.\"\n  ([m] (drive-local m 64))\n  ([m rounds]\n   (loop [m (vm/run m), n rounds]\n     (if (or (not (vm/blocked? m)) (zero? n))\n       m\n       (recur (vm/run m) (dec n))))))\n\n\n(defn drive\n  \"Run a resumed machine through its reflections, stepping the source's\n   mirror between rounds, until it stops blocking.\"\n  ([m peer] (drive m peer 64))\n  ([m peer rounds]\n   (loop [m (vm/run m), n rounds]\n     (if (or (not (vm/blocked? m)) (zero? n))\n       m\n       (do (serve-mirror! peer)\n           (recur (vm/run m) (dec n)))))))\n\n\n(defn stream-of\n  \"The stream handle a parked reader's first wait entry polls.\"\n  [parked]\n  (let [entry (first (:wait-set parked))]\n    (get (:resources parked) (:stream-id entry))))\n\n\n;; =============================================================================\n;; Parked programs, by profile\n;; =============================================================================\n\n(defn parked-reader\n  \"A real machine of `engine` parked on the second read of the stream it\n   makes, A consumed.  Answers [parked source-stream].\"\n  [engine]\n  (let [m0 (run-ast engine\n                    (let1 's {:type :stream/make, :buffer 4}\n                          (let1 'c (cursor-of (v 's))\n                                (then (next-of (v 'c))\n                                      (next-of (v 'c))))))\n        src (stream-of m0)]\n    (stream/append! src \"A\")\n    [(vm/run m0) src]))\n\n\n(defn parked-explicit\n  \"A real machine at an explicit park; the record's environment holds a\n   cursor on a blocked stream.\"\n  [engine]\n  (run-ast engine\n           (let1 's {:type :stream/make, :buffer 4}\n                 (app (lam ['c] {:type :vm/park})\n                      (cursor-of (v 's))))))\n\n\n(defn halted-with\n  [engine ast]\n  (run-ast engine ast))\n\n\n;; =============================================================================\n;; Custody parts (the version-2 exclusive arm)\n;; =============================================================================\n\n(def occurrence \"8f0c6a52-6a1e-4e43-9d55-3f0a4c1b2e01\")\n(def predecessor \"1d3e5b7a-0c2f-4a69-8b11-7e6d5c4b3a02\")\n\n\n(def origin\n  {:yin.k/occurrence predecessor\n   :dao.lease/lease \"lease-7\"\n   :yin.k/emitter \"peer-a\"})\n\n\n(def arbitration\n  {:dao.stream/identity \"arbitration-1\"\n   :dao.stream/descriptor {:dao.stream/type :remote :peer \"peer-b\"}})\n\n\n(defn header\n  \"The exclusive header of an export: counter `n`, the predecessor `o`\n   when the task has one, and the enrolled stream identities.\"\n  ([] (header 0 nil))\n  ([n o] (header n o #{}))\n  ([n o enrolled]\n   (cond-> {:yin.k/occurrence occurrence\n            :yin.k/arbitration arbitration\n            :yin.k/next-op-seq n\n            :yin.k/enrolled enrolled}\n     (some? o) (assoc :yin.k/origin o))))\n\n\n(defn segment-address\n  [bs]\n  (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 bs))))\n\n\n(defn lower-options\n  \"The D10 lower inputs that satisfy all seven grant checks over `bytes`.\"\n  [bytes]\n  (let [body (jing.cbor/decode bytes)\n        identities (into #{}\n                         (comp (filter #(and (map? %)\n                                             (= :yin.k/stream (:yin.k/tag %))))\n                               (map :dao.stream/identity))\n                         (tree-seq coll? seq body))\n        address (segment-address bytes)\n        occurrence (:yin.k/occurrence body)]\n    {:address address\n     :exclusive true\n     :protection (zipmap identities (repeat :at-least-once))\n     :grant {:checkpoint address\n             :dao.lease/lease \"lease-new\"\n             :dao.lease/holder \"holder-new\"\n             :tenure {:now 10 :bound 20 :live true}\n             :evidence {:yin.k/status :yin.k/ready\n                        :yin.k/binding\n                        {:yin.k/occurrence occurrence\n                         :dao.lease/lease \"lease-new\"\n                         :dao.lease/holder \"holder-new\"\n                         :yin.k/epoch 2\n                         :yin.k/transaction\n                         {:yin.k/arbitration\n                          (get-in body [:yin.k/arbitration\n                                        :dao.stream/identity])}}\n                        :yin.k/enrolled #{}\n                        :yin.k/prefix {:yin.k/occurrence occurrence\n                                       :dao.lease/lease \"lease-new\"\n                                       :yin.k/frontier 0\n                                       :yin.k/inputs []}}}}))\n\n\n;; =============================================================================\n;; Parked programs that wait on a write or a call\n;; =============================================================================\n\n(defn call-node\n  [op arg]\n  {:type :dao.stream.apply/call, :op op, :operands [(lit arg)]})\n\n\n(defn parked-writer\n  \"A real machine of `engine` parked on a blocked write: the warm\n   one-slot stream keeps the value retained.  Answers [parked stream].\"\n  [engine]\n  (let [w (support/one-slot-stream \"w\")]\n    (stream/append! w :warmed)\n    (let [m0 (load-ast engine (new-machine engine)\n                       {:type :stream/put, :target (v 'w), :val (lit \"v\")})\n          [ref m0'] (engine/attach-resource m0 w)]\n      [(vm/run (assoc m0' :store {'w ref})) w])))\n\n\n(defn calling-machine\n  ([engine call-in call-out] (calling-machine engine call-in call-out nil))\n  ([engine call-in call-out bridge]\n   (new-machine engine\n                {:call-in call-in\n                 :call-out call-out\n                 :call-out-cursor (vm/mint-oldest call-out :test)\n                 :bridge bridge})))\n\n\n(defn parked-sent-caller\n  \"A machine whose first FFI call was sent and waits for its response;\n   answers [parked call-in call-out].\"\n  [engine]\n  (let [call-in (ring 8)\n        call-out (ring 8)\n        parked (vm/run (load-ast engine\n                                 (calling-machine engine call-in call-out)\n                                 (then (call-node :op/echo \"hello\")\n                                       (call-node :op/echo \"world\"))))]\n    [parked call-in call-out]))\n\n\n(defn parked-retained-caller\n  \"A machine whose first FFI call's request is retained, the call-in\n   stream being full; answers [parked call-in call-out].\"\n  [engine]\n  (let [call-in (support/one-slot-stream \"call-in\")\n        call-out (ring 8)\n        _ (stream/append! call-in :warmed)\n        parked (vm/run (load-ast engine\n                                 (calling-machine engine call-in call-out)\n                                 (then (call-node :op/echo \"hello\")\n                                       (call-node :op/echo \"world\"))))]\n    [parked call-in call-out]))\n\n\n;; =============================================================================\n;; Link waits and install children\n;; =============================================================================\n\n(defn module-image\n  \"The module image of `ast` the linker response carries, by profile.\"\n  [engine ast]\n  (case engine\n    :semantic (semantic-vector ast)\n    :stack (:image (dl/adapt (vm/ast->datoms ast)))\n    :register (:image (rc/adapt (second (vm/ast->datoms-with-root ast))))\n    :walker (vm/ast->semantic-bytecode ast)))\n\n\n(defn module-response\n  \"The `:ok` link response for module `host.mod` exporting `f`: it\n   blocks on one read of its own stream, then defines `f`.\"\n  [engine]\n  {:status :ok\n   :image {:value (module-image\n                    engine\n                    (let1 's {:type :stream/make, :buffer 4}\n                          (then (next-of (cursor-of (v 's)))\n                                (def! 'f (lam [] (lit 42))))))}\n   :manifest {:yin.module/name 'host.mod\n              :yin.module/exports #{'f}}\n   :obligations []})\n\n\n(defn linking-machine\n  [engine request response]\n  (new-machine engine {:link-request request :link-response response}))\n\n\n(defn require-program\n  [name]\n  (app (v 'require) (lit name)))\n\n\n(defn parked-link-request\n  \"A machine whose `:link-request` envelope is retained (the request\n   stream is full).\"\n  [engine]\n  (let [request (support/one-slot-stream \"link-request\")\n        response (ring 64)\n        _ (stream/append! request :warmed)]\n    (vm/run (load-ast engine (linking-machine engine request response)\n                      (require-program 'host.the-module)))))\n\n\n(defn parked-link-response\n  \"A machine whose `:link-request` was sent and waits for the response.\"\n  [engine]\n  (let [request (ring 64)\n        response (ring 64)]\n    (vm/run (load-ast engine (linking-machine engine request response)\n                      (require-program 'host.the-module)))))\n\n\n(defn parked-installer\n  \"A real machine parked at `:install` with a live blocked child:\n   answers [parked child-stream].\"\n  [engine]\n  (let [request (ring 64)\n        response (ring 64)\n        m0 (vm/run (load-ast engine (linking-machine engine request response)\n                             (then (require-program 'host.mod)\n                                   (app (v 'host.mod/f)))))\n        entry (first (:wait-set m0))\n        _ (stream/append! response\n                          (assoc (module-response engine)\n                                 :yin.link/id (:link-id entry)))\n        parked (vm/run m0)\n        child (get-in parked [:installs 'host.mod :vm])\n        child-stream (get (:resources child)\n                          (:stream-id (first (:wait-set child))))]\n    [parked child-stream]))\n\n\n;; =============================================================================\n;; Lift, read and deliver\n;; =============================================================================\n\n(def engines [:semantic :stack :register :walker])\n\n\n(defn lift\n  \"The version-2 lift of `machine` over a toy's served table: fork with a\n   nil header, exclusive with one.\"\n  ([machine t peer] (lift machine t peer nil))\n  ([machine t peer header] (lift machine t peer header #{:reader}))\n  ([machine t peer header surfaces]\n   (handoff/export-task machine (server peer (:channel t) surfaces)\n                        (cond-> {:version 2}\n                          (some? header) (assoc :header header)))))\n\n\n(defn read!\n  \"The version-aware reader over a counting attach!, into a fresh\n   `engine` receiver composed with the attach seam.  Answers\n   [outcome attaches].\"\n  [engine t bytes opts]\n  (let [attaches (atom 0)\n        base (attacher t)\n        attach! (fn [descriptor]\n                  (swap! attaches inc)\n                  (base descriptor))]\n    [(handoff/resume-task (new-machine engine {:attach-stream attach!})\n                          bytes attach! opts)\n     @attaches]))\n\n\n(defn frame-pending\n  [export]\n  (get-in export [:body :yin.k/frames 0 :yin.k/pending]))\n\n\n(defn deliver-next\n  \"The controlled engine apply of one read outcome to the first wait of\n   the gated machine `m`, then normal scheduling to the end.\"\n  [m value]\n  (let [entry (first (:wait-set m))\n        cid (get-in entry [:cursor-ref :id])\n        position (get-in m [:resources cid :cursor])\n        applied (engine/apply-next m entry\n                                   {:dao.stream/outcome :dao.stream/ok\n                                    :dao.stream/value value\n                                    :dao.stream/cursor position})]\n    (drive-local applied)))\n\n\n(defn decoded\n  \"The body the export's canonical bytes decode to.\"\n  [export]\n  (jing.cbor/decode (:bytes export)))\n\n\n(defn stream-blind\n  \"`body` with every served stream identity and channel replaced by a\n   placeholder: two lifts over different served tables compare by the\n   census alone.\"\n  [body]\n  (walk/postwalk (fn [x]\n                   (if (and (map? x) (contains? x :dao.stream/identity))\n                     (assoc x :dao.stream/identity :served\n                            :dao.stream/channel :served)\n                     x))\n                 body))\n\n\n(defn run-beside\n  \"Run `ast` on `m` keeping its code: the semantic and walker profiles\n   load beside what they hold; stack and register attach the program's\n   image to the current layout (a load would replace it, and a parked\n   record names rows of the layout it was parked under) and start there.\"\n  [engine m ast]\n  (vm/run\n    (case engine\n      (:semantic :walker) (load-ast engine m ast)\n      :stack\n      (let [img (:image (dl/adapt (vm/ast->datoms ast)))\n            attached (stack/attach-image m img vm/stack-contract)]\n        (assoc attached\n               :pc (stack/absolute-pc attached [(dcode/image-hash img) 0])\n               :frames [] :stack [] :continuation []\n               :halted? false :blocked? false :value nil))\n      :register\n      (let [img (:image (rc/adapt (vm/ast->datoms ast)))\n            attached (register/attach-image m img vm/register-contract)\n            pc (register/absolute-pc attached [(rcode/register-hash img) 0])\n            body (some #(when (= pc (:start %)) %)\n                       (:bodies (:segment attached)))]\n        (assoc attached\n               :pc pc :frames [] :continuation []\n               :registers (vec (repeat (:registers body) nil))\n               :halted? false :blocked? false :value nil)))))\n","numLines":570,"startLine":1,"totalLines":570}},"tool_result_meta":[{"id":"toolu_01UypTVZpCtbLudnL9h9Bdnx","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
