1 :f} :yin.k/rd 2}\n230\t        with-k (assoc worked-frame :yin.k/k [ret])\n231\t        tail-v [[:var 1 'f] [:call 0 1 [] true] [:halt 0]]\n232\t        tail-a (jing/segment-key tail-v) tail-c {tail-a tail-v}\n233\t        tail-f {:yin.k/state :tail :yin.k/segment tail-a :yin.k/site 1\n234\t                :yin.k/k [] :yin.k/deliver {:yin.k/deliver :return} :yin.k/pending {:yin.k/reason :next :yin.k/cursor-cell :test/cursor}}\n235\t        boundary-v [[:closure 0 [] 2] [:halt 0] [:current-continuation 0] [:return 0]]\n236\t        boundary-a (jing/segment-key boundary-v)\n237\t        rows [[\"S1\" :frame-shape (assoc worked-frame :extra true) worked-code :wait task]\n238\t              [\"S2\" :k-shape (assoc worked-frame :yin.k/k [nil]) worked-code :wait task]\n239\t              [\"S3\" :window-representation (assoc worked-frame :yin.k/window {-1 nil}) worked-code :wait task]\n240\t              [\"S4\" :env-shape (assoc worked-frame :yin.k/env {}) worked-code :wait task]\n241\t              [\"C1\" :segment worked-frame {} :wait task]\n242\t              [\"C2-kind\" :pc-kind (assoc worked-frame :yin.k/pc 4.5) worked-code :wait task]\n243\t              [\"C2-bounds\" :pc-bounds (assoc worked-frame :yin.k/pc 99) worked-code :wait task]\n244\t              [\"C3\" :pc-body (assoc worked-frame :yin.k/segment boundary-a :yin.k/pc 2) {boundary-a boundary-v} :wait task]\n245\t              [\"A1\" :site (assoc worked-frame :yin.k/pc 3) worked-code :wait task]\n246\t              [\"A2\" :destination (assoc-in worked-frame [:yin.k/deliver :yin.k/rd] 0) worked-code :wait task]\n247\t              [\"A3\" :window-scope (assoc-in worked-frame [:yin.k/window 99] nil) worked-code :wait task]\n248\t              [\"A4\" :window-self (assoc-in worked-frame [:yin.k/window 2] nil) worked-code :wait task]\n249\t              [\"A5\" :window-extra (assoc-in worked-frame [:yin.k/window 3] nil) worked-code :wait task]\n250\t              [\"A6\" :window-missing (assoc worked-frame :yin.k/window {}) worked-code :wait task]\n251\t              [\"T1\" :site (assoc tail-f :yin.k/site 0) tail-c :wait task]\n252\t              [\"K1\" :return-site (assoc-in with-k [:yin.k/k 0 :yin.k/pc] 3) worked-code :wait task]\n253\t              [\"K2\" :return-destination (assoc-in with-k [:yin.k/k 0 :yin.k/rd] 0) worked-code :wait task]\n254\t              [\"K3\" :return-window-missing (assoc-in with-k [:yin.k/k 0 :yin.k/window] {}) worked-code :wait task]\n255\t              [\"E1\" :reserved-name (assoc-in worked-frame [:yin.k/env :yin.k/bindings 'yin/def] nil) worked-code :wait task]\n256\t              [\"E2\" :free-env-mismatch (assoc-in worked-frame [:yin.k/env :yin.k/bindings 'x] nil) worked-code :wait task]\n257\t              [\"P1\" :pending-presence (dissoc worked-frame :yin.k/pending) worked-code :wait task]\n258\t              [\"P2\" :reason-mismatch (assoc-in worked-frame [:yin.k/pending :yin.k/reason] :bogus) worked-code :wait task]\n259\t              [\"P3\" :captured-site (dissoc worked-frame :yin.k/pending) worked-code :captured task]\n260\t              [\"P4\" :parked-site (dissoc tail-f :yin.k/pending) tail-c :parked task]]]\n261\t    (is (= 24 (count rows)))\n262\t    (doseq [[rule expected f c ctx t] rows]\n263\t      (testing rule\n264\t        (let [d (frame/defect f c ctx t)]\n265\t          (is (= expected (:yin.k/kind d))) (is (vector? (:yin.k/path d))))))\n266\t    (is (= :free-env-shape (:yin.k/kind (frame/task-defect {:free-env {1 nil}}))))))\n267\t\n268\t\n269\t(deftest rule-boundaries-refuse-their-tamper\n270\t  ;; Supplements the prescribed table at each rule's other edge.\n271\t  (let [resume (fn [op]\n272\t                 (let [v [[:closure 0 [] 2] [:halt 0] [op 0] [:return 0]] a (jing/segment-key v)]\n273\t                   [(assoc worked-frame :yin.k/segment a :yin.k/pc 3 :yin.k/window {}\n274\t                           :yin.k/deliver {:yin.k/deliver :rd :yin.k/rd 0}) {a v}]))\n275\t        [park-f park-c] (resume :park)\n276\t        [cc-f cc-c] (resume :current-continuation)]\n277\t    (is (nil? (kind (dissoc park-f :yin.k/pending) park-c :parked task)))\n278\t    (is (nil? (kind (dissoc cc-f :yin.k/pending) cc-c :captured task)))\n279\t    (doseq [[rule expected f c] [[\"S2 map K\" :k-shape (assoc worked-frame :yin.k/k {}) worked-code]\n280\t                                 [\"S2 nil K\" :k-shape (assoc worked-frame :yin.k/k nil) worked-code]\n281\t                                 [\"S4 nil store-of\" :env-shape (assoc-in worked-frame [:yin.k/env :yin.k/store-of] nil) worked-code]\n282\t                                 [\"C2 pc 0\" :pc-bounds (assoc worked-frame :yin.k/pc 0) worked-code]\n283\t                                 [\"A5 before A6\" :window-extra (assoc worked-frame :yin.k/window {3 :x}) worked-code]\n284\t                                 [\"P2 park\" :reason-mismatch park-f park-c]\n285\t                                 [\"P2 current-continuation\" :reason-mismatch cc-f cc-c]]]\n286\t      (testing rule\n287\t        (is (= expected (kind f c :wait task)))))))\n288\t\n289\t\n290\t(deftest tail-bookkeeping-and-delivery\n291\t  (let [fixture (last (reference-machines)) {:keys [frame code]} (first (reference-frames fixture))\n292\t        f (dissoc frame :yin.k/pending)]\n293\t    (is (= [] (:yin.k/k frame)))\n294\t    (is (nil? (kind f code :parked (assoc task :parked-key :call :ffi-call-ids #{:call}))))\n295\t    (is (= :parked-site (kind f code :parked (assoc task :parked-key :other :ffi-call-ids #{:call}))))\n296\t    (is (= :deliver (kind (assoc frame :yin.k/deliver {:yin.k/deliver :rd :yin.k/rd 0}) code :wait task)))))\n297\t\n298\t\n299\t(deftest integral-float-is-not-a-pc\n300\t  (is (= :pc-kind (kind (assoc worked-frame :yin.k/pc (cbor/float64 4)) worked-code :wait task)))\n301\t  (is (= :window-representation\n302\t         (kind (assoc worked-frame :yin.k/window {(cbor/float64 1) nil}) worked-code :wait task))))\n303\t"}]},"parent_tool_use_id":null,"session_id":"ee657710-cc1c-4c43-882b-5874c9a79051","uuid":"47963a54-55ea-4060-be65-62c08289492c","timestamp":"2026-10-12T15:52:57.624Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p6b/test/yin/vm/semantic_register/frame_test.cljc","content":"(ns yin.vm.semantic-register.frame-test\n  (:require [clojure.test :refer [deftest is testing]]\n            #?(:cljd nil :clj [clojure.java.io :as io])\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.semantic-register.analysis :as analysis]\n            [yin.vm.semantic-register.frame :as frame]\n            [yin.vm.semantic-register.corpus :as corpus]\n            [yin.vm.semantic-register.parity-test :as parity]\n            [yin.vm.ucf.v2-support :as s]\n            [yin.vm.ucf.lift-support :as support]\n            [dao.stream :as stream]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]))\n\n\n(def task {:free-env {} :ffi-call-ids #{}})\n\n\n(defn canonical\n  \"Reshape evaluator payload; values remain opaque to the pure validator.\"\n  [m f pending?]\n  (let [address (fn [seg] (get-in m [:code seg :address]))\n        env (fn [e]\n              (cond-> {:yin.k/bindings (engine/without-store-of e)}\n                (some? (engine/env-store-of e)) (assoc :yin.k/store-of (engine/env-store-of e))))\n        act? (contains? f :pc)]\n    (cond-> {:yin.k/state (if act? :act :tail) :yin.k/segment (address (:segment f))\n             :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd (get-in f [:deliver :rd])}\n                                {:yin.k/deliver :return})\n             :yin.k/k (mapv (fn [k]\n                              {:yin.k/frame-type :return :yin.k/segment (address (:segment k))\n                               :yin.k/pc (:pc k) :yin.k/env (env (:env k))\n                               :yin.k/window (:window k) :yin.k/rd (:rd k)}) (or (:k f) []))}\n      act? (assoc :yin.k/pc (:pc f) :yin.k/env (env (:env f)) :yin.k/window (:window f))\n      (not act?) (assoc :yin.k/site (:site f))\n      pending? (assoc :yin.k/pending {:yin.k/reason (:reason f)}))))\n\n\n(defn machine-code\n  [m]\n  (into {} (map (fn [[_ image]] [(:address image) (:vector image)])) (:code m)))\n\n\n(defn- cat-of\n  [p q]\n  (s/app (s/v 'cat) p q))\n\n\n(defn- with-cat\n  [ast]\n  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n\n\n(defn- nest\n  [depth op]\n  (if (zero? depth) op\n      (cat-of (s/lit [depth]) (s/app (s/lam ['x] (nest (dec depth) op)) (s/lit depth)))))\n\n\n(def wrappers\n  (mapv (fn [[label wrap]] [label (comp with-cat wrap)])\n        [[:bare identity]\n         [:operand #(cat-of (s/lit [:operand]) %)]\n         [:depth-3 #(nest 3 %)]\n         [:captured #(s/let1 'k (s/lit :captured)\n                             (s/let1 'f (s/lam ['y] (cat-of (cat-of (cat-of (s/lit []) (s/v 'k)) (s/v 'y)) %))\n                                     (s/app (s/v 'f) (s/lit :arg))))]]))\n\n\n(defn- rows-program\n  [n]\n  (let [read (s/next-of (s/v 'c)) capture {:type :vm/current-continuation}]\n    (case n\n      1 (s/let1 'a read (cat-of (cat-of (s/lit []) (s/v 'a)) read))\n      2 {:type :stream/put :target (s/v 'w) :val (s/lit \"v\")}\n      5 (cat-of (s/lit [:ordinary]) (s/app (s/v 'stream/next!) (s/v 'c)))\n      6 (s/app (s/lam ['u] (assoc (s/app (s/v 'stream/next!) (s/v 'c)) :tail? true)) (s/lit 0))\n      13 {:type :vm/park}\n      14 (s/let1 'k capture (cat-of (cat-of (s/lit []) (s/v 'k)) read))\n      15 (s/let1 'k capture {:type :if :test (s/app (s/v '=) (s/v 'k) (s/lit :second))\n                             :consequent (s/lit :done) :alternate (s/let1 'r read (s/app (s/v 'k) (s/lit :second)))})\n      16 (s/let1 'k1 capture (s/let1 'k2 capture\n                                     (cat-of (cat-of (cat-of (s/lit []) (s/v 'k1)) (s/v 'k2)) read)))\n      18 (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))\n      19 (s/lit 42)\n      21 (s/let1 'f (s/lam [] (s/v 'x)) (s/app (s/lam ['x] (s/app (s/v 'f) read)) (s/lit 1)))\n      22 (s/app (s/lam ['p 'q] (cat-of (cat-of (s/lit []) (s/v 'p)) (s/v 'q))) (s/lit nil) read))))\n\n\n(defn- attach-reader\n  [m ring]\n  (let [[ref m] (engine/attach-resource m ring)\n        [id m] (engine/gensym m \"cursor\")]\n    (engine/handle-cursor m {:stream ref} id)))\n\n\n(defn reference-machines\n  []\n  (into\n    (mapv (fn [[n [label wrap]]]\n            (let [ring (s/ring 4)\n                  w (support/one-slot-stream (str \"frame-\" n))\n                  _ (stream/append! w :warmed)\n                  env (if (= n 21) {'x 99 'y 7} {})\n                  m (parity/register-machine (wrap (rows-program n)) {:env env :modules (module/register-stream-module (module/default-registry))})\n                  [cr m] (attach-reader m ring)\n                  [wr m] (engine/attach-resource m w)\n                  m (assoc m :store {'c cr 'w wr})\n                  m (if (= n 18)\n                      (let [[second-cursor m] (attach-reader m ring)\n                            [seg image] (first (:code m))\n                            closure (first (filter #(= :closure (first %)) (:vector image)))\n                            clo (values/closure (:owner m) {:type :closure :params (nth closure 2)\n                                                            :entry (nth closure 3) :segment seg\n                                                            :env {engine/store-of-key 'host.mod}})]\n                        (assoc m :store (assoc (:store m) 'mod clo)\n                               :module-stores {'host.mod {'c cr 'd second-cursor}})) m)\n                  blocked (vm/run m)\n                  blocked (if (= n 1) (do (stream/append! ring \"A\") (vm/run blocked)) blocked)]\n              {:row n :wrapper label :machine blocked :task (assoc task :free-env env)}))\n          (mapcat (fn [n] (mapv #(vector n %) wrappers)) [1 2 5 6 13 14 15 16 18 19 21 22]))\n    (let [ring (s/ring 4)\n          m (parity/register-machine (assoc (s/app (s/v 'stream/next!) (s/v 'c)) :tail? true)\n                                     {:modules (module/register-stream-module (module/default-registry))})\n          [cr m] (attach-reader m ring)]\n      [{:row 20 :wrapper :unwrapped :machine (vm/run (assoc m :store {'c cr})) :task task}])))\n\n\n(defn reference-frames\n  \"Every wait, parked payload, and capture reachable through their values.\"\n  [{:keys [machine task] :as fixture}]\n  (let [out (atom []) code-map (machine-code machine)]\n    (letfn [(record\n              [f context t]\n              (let [cf (canonical machine f (= :wait context))]\n                (swap! out conj {:frame cf :code code-map :context context :task t :fixture (select-keys fixture [:row :wrapper])})\n                (walk (:env f)) (walk (:window f)) (walk (:k f))))\n            (walk\n              [x]\n              (cond\n                (values/continuation? x) (record (values/payload x) :captured task)\n                (values/closure? x) (walk (:env (values/payload x)))\n                (map? x) (doseq [[k v] x] (walk k) (walk v))\n                (coll? x) (doseq [v x] (walk v))\n                :else nil))]\n      (doseq [f (:wait-set machine)] (record f :wait task))\n      (doseq [[p f] (:parked machine)] (record f :parked (assoc task :parked-key p)))\n      (walk (:value machine)) (walk (:store machine))\n      @out)))\n\n\n(def worked-vector (:vector (linearize/project (second (first (filter #(= :worked-example (first %)) corpus/programs))))))\n(def worked-address (jing/segment-key worked-vector))\n(def worked-code {worked-address worked-vector})\n\n\n(def worked-frame\n  {:yin.k/state :act :yin.k/segment worked-address :yin.k/pc 4\n   :yin.k/env {:yin.k/bindings {}} :yin.k/window {1 :f}\n   :yin.k/deliver {:yin.k/deliver :rd :yin.k/rd 2} :yin.k/k []\n   :yin.k/pending {:yin.k/reason :next :yin.k/cursor-cell :test/cursor}})\n\n\n(deftest contract-is-pure\n  (is (nil? (frame/defect worked-frame worked-code :wait task)))\n  #?(:cljd nil\n     :clj (let [source (slurp (io/file \"src/cljc/yin/vm/semantic_register/frame.cljc\"))\n                ns-form (first (re-seq #\"(?s)^.*?\\n\\n\" source))]\n            (is (not (re-find #\"yin.vm.engine|yin.vm.semantic-register\\s+:|yin.vm.debruijn.(stack|register)\" ns-form))))))\n\n\n(deftest every-reference-frame-validates\n  (let [fixtures (reference-machines)]\n    (is (= 49 (count fixtures)))\n    (doseq [fixture fixtures]\n      (testing (pr-str (select-keys fixture [:row :wrapper]))\n        (let [frames (reference-frames fixture)]\n          (if (= 19 (:row fixture))\n            (is (vm/halted? (:machine fixture)))\n            (is (seq frames)))\n          (doseq [{:keys [frame code context task]} frames]\n            (is (nil? (frame/defect frame code context task)))))))))\n\n\n(defn kind\n  [f c context t]\n  (:yin.k/kind (frame/defect f c context t)))\n\n\n(deftest worked-example-saved\n  (is (= #{1} (analysis/saved (analysis/analyze worked-vector) 4 2)))\n  (is (nil? (kind worked-frame worked-code :wait task)))\n  (is (= :window-self (kind (assoc worked-frame :yin.k/window {1 :f 2 :x}) worked-code :wait task)))\n  (is (= :window-missing (kind (assoc worked-frame :yin.k/window {}) worked-code :wait task)))\n  (is (= :window-extra (kind (assoc worked-frame :yin.k/window {1 :f 3 :x}) worked-code :wait task))))\n\n\n(deftest nil-valued-register-is-a-member\n  (let [fixture (first (filter #(and (= 22 (:row %)) (= :bare (:wrapper %))) (reference-machines)))\n        {:keys [frame code context task]} (first (reference-frames fixture))\n        nil-key (first (keep (fn [[k v]] (when (nil? v) k)) (:yin.k/window frame)))]\n    (is (some? nil-key))\n    (is (nil? (kind frame code context task)))\n    (is (= :window-missing (kind (update frame :yin.k/window diss