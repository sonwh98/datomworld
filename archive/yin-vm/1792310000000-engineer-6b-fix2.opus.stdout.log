  :parked-ids (extract '[:find ?pid :in $code :where [$code _ _ :resume ?pid _]])\n     :effects (into #{} (mapcat footprint-mnemonics) mnemonics)}))\n     111 src/cljc/yin/vm/semantic_register/analysis.cljc\n     879 src/cljc/yin/vm/semantic_register/code.cljc\n     222 src/cljc/yin/vm/semantic_register/derive.cljc\n     163 src/cljc/yin/vm/semantic_register/frame.cljc\n     302 src/cljc/yin/vm/semantic_register/linearize.cljc\n      99 src/cljc/yin/vm/semantic_register/scan.cljc\n    1776 total","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01NEJQXnEHHnMqtKUR49DWUd","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
