         r))\n422\t     :origin origin :count n}))\n423\t\n424\t\n425\t(defn handed-off\n426\t  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n427\t   the source's streams.\"\n428\t  [world]\n429\t  (let [surfaces (or (:surfaces world) #{:reader})\n430\t        {:keys [toy peer serve!]} (served surfaces)\n431\t        wire (rows/lift-task (:machine world) serve! (lift-opts))\n432\t        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n433\t        receiver ((or (:receiver world) (constantly nil)))\n434\t        {:keys [attach! origin] n :count} (recording-attacher toy)\n435\t        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n436\t        attaches @n\n437\t        again (served surfaces)\n438\t        relift (rows/lift-task recv (:serve! again) (lift-opts))\n439\t        corr2 (into {} (map (fn [[id e]] [id (get @origin (:handle e))])) @(:table (:peer again)))\n440\t        done (satisfy world recv #(drive-peers % [peer]))\n441\t        _ (s/serve-mirror! peer)]\n442\t    (when-let [f (:finish world)] (f))\n443\t    (when-let [f (:finish receiver)] (f))\n444\t    {:wire wire :recv recv :relift relift :corr corr :corr2 corr2 :attaches attaches\n445\t     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n446\t\n447\t\n448\t(defn root-task\n449\t  [wire]\n450\t  (rows/decode wire))\n451\t\n452\t\n453\t(defn stream-identities\n454\t  \"The distinct stream identities of the whole carrier, install children\n455\t   included: one row table serves the tree.\"\n456\t  [wire]\n457\t  (into #{} (keep (fn [r] (when (= :stream (second r)) (nth r 2)))) (:yin.k/rows wire)))\n458\t\n459\t\n460\t(defn rows-in\n461\t  \"Every row node the decoded tree x reaches, once per path.\"\n462\t  [x]\n463\t  (cond\n464\t    (and (map? x) (contains? x :kind) (contains? x :slots)) (cons x (rows-in (:slots x)))\n465\t    (sequential? x) (mapcat rows-in x)\n466\t    :e