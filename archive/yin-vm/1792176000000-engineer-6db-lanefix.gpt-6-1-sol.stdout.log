r\n                 :devtools {:use-document-protocol true}\n                 :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :local {:target :browser\n                  :devtools {:use-document-protocol true}\n                  :closure-defines {datomworld.demo/WEBSOCKET_PORT 8090}\n                  :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :test {:target :node-test\n                 :output-to \"target/node-tests.js\"\n                 :autorun true}\n\n          :vm-bench {:target :node-script\n                     :main bench.yin-vm-bench/-main\n                     :output-to \"target/vm-bench.js\"}\n\n          :yin-repl {:target :node-script\n                        :main yin.repl.main/-main\n                        :output-to \"target/yin-repl.js\"}}}\n(ns cljd-agg\n  \"Dart test runner that aggregates the generated test files.\n\n   `flutter test` loads every generated *_test.dart separately (about 7.5 s\n   each). This runner compiles the test namespaces through the cljd tool,\n   groups the generated files into a few shard files that import them and call\n   each `main`, and runs `flutter test` on the shards only. Shards live under\n   build/, never under test/, so a plain `cljd test` never runs them twice.\n\n   Run with babashka:\n     bb src/dev/cljd_agg.clj [--slow-only | --slow-regex | --only NS,NS...]\n   --slow-only restricts the run to the namespaces that use dao.test-slow/guard.\n   A namespace in that set with no generated Dart file is fatal.\n   --only compiles and runs only the given test namespaces (bb test:changed);\n   one with no generated Dart file is fatal too.\n   --slow-regex prints, for bb.edn, an anchored alternation of those\n   namespaces with its dots already escaped for embedding in an EDN string\n   (shadow-cljs --config-merge); it is not a ready-to-use regex. It exits 1\n   when no namespace uses the guard, so a slow lane cannot be vacuous.\n   DATOM_SLOW_TESTS is inherited from the environment.\"\n  (:require\n    [babashka.fs :as fs]\n    [babashka.process :as p]\n    [clojure.string :as str]))\n\n\n(def test-root \"test\")\n(def out-root \"test/cljd-out\")\n(def shard-dir \"build/cljd-agg\")\n(def max-shards 8)\n\n\n(defn- ns-of\n  \"The namespace declared by the first ns form of `file`.\"\n  [file]\n  (second (re-find #\"\\(ns\\s+\\^?(?:\\{[^}]*\\}\\s+)?([^\\s\\)]+)\" (slurp file))))\n\n\n(defn- source-files\n  []\n  (->> (file-seq (fs/file test-root))\n       (filter #(re-find #\"_test\\.clj[cd]$\" (str %)))\n       (remove #(str/includes? (str %) \"cljd-out\"))\n       (map str)\n       sort))\n\n\n(defn- test-namespaces\n  \"Distinct: a namespace with both a .cljc and a .cljd source (for example\n   dao.stream.cbor-test) has one generated Dart file, which must run once.\"\n  []\n  (distinct (keep ns-of (source-files))))\n\n\n(defn- slow-namespaces\n  \"Namespaces whose source uses dao.test-slow/guard, derived from the tree.\"\n  []\n  (->> (source-files)\n       (filter #(re-find #\"slow/guard\" (slurp %)))\n       (keep ns-of)\n       distinct\n       sort))\n\n\n(defn- dart-file\n  \"Generated file path for namespace `ns-name`.\"\n  [ns-name]\n  (str out-root \"/\" (str/replace ns-name \".\" \"/\") \"_test.dart\"))\n\n\n(defn- run!*\n  [& args]\n  (let [{:keys [exit]} (apply p/shell {:continue true} args)]\n    exit))\n\n\n(defn compile-tests\n  \"Compile every test namespace through the cljd tool.\"\n  [namespaces]\n  (let [exit (apply run!* \"clojure\" \"-M:clojuredart:cljd\" \"compile\"\n                    namespaces)]\n    (when-not (zero? exit)\n      (println \"cljd compile failed, exit\" exit)\n      (System/exit exit))))\n\n\n(defn shard\n  \"Greedy balanced partition of `files` into `n` groups by file size.\n   Deterministic: ties are broken by path.\"\n  [files n]\n  (let [sized (sort-by (juxt (comp - fs/size) identity) files)\n        init  (vec (repeat n {:size 0 :files []}))]\n    (->> sized\n         (reduce (fn [shards f]\n                   (let [i (first (first (sort-by\n                                           (juxt (comp :size second) first)\n                                           (map-indexed vector shards))))]\n                     (-> shards\n                         (update-in [i :size] + (fs/size f))\n                         (update-in [i :files] conj f))))\n","exit_code":0,"status":"completed"}}
