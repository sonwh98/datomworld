{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"cat > /tmp/6a-r3-source.py <<'PY'\nfrom pathlib import Path\np=Path('src/cljc/yin/vm/ucf/rows.cljc'); s=p.read_text()\ns=s.replace('on encode one whose\\\\n   payload is not a well-formed marker, and on decode any [:lit] of that\\\\n   shape, is refused :yin.k/non-portable.','on encode and decode every literal of that shape is refused\\\\n   :yin.k/non-portable. Explicit markers use the caller value encoder.')\npos=s.index('(defn- bytes-key')\ns=s[:pos]+'''(defn- marker-shaped?\n  [x]\n  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cell))))\n\n\n(defn- check-literal-markers\"'!\n  [x]\n  (when (marker-shaped? x) (refuse! :yin.k/non-portable :marker []))\n  (when (coll? x)\n    (doseq [v (if (map? x) (mapcat identity x) x)] (check-literal-markers! v))\n    (when (meta x) (check-literal-markers! (meta x)))))\n\n\n'\"'''+s[pos:]\ns=s.replace('  (cond\\\\n    (ref? d) (emit-node x numbering rows)','  (when-not (or (ref? d) (refs? d) (= :C d))\\\\n    (check-literal-markers\"'! (if (contains? #{:V :optional-V} d)'\"\\\\n                              (when (= :lit (first x)) (second x)) x)))\\\\n  (cond\\\\n    (ref? d) (emit-node x numbering rows)',1)\ns=s.replace(':bytes 16777216}', ':bytes 16777216 :label-bytes 1048576}')\npos=s.index('(declare canonical-numbering)\\\\n',s.index('(defn- spend\"'!'\"'))\ns=s[:pos]+'''(defn- check-label-bytes\"'!\n  \"Conservative byte/representation bound before CBOR normalization or\n   comparison vectors allocate. Byte payloads are counted without copying;\n   container overhead also bounds the number of intermediate tree nodes.\"\n  [x budget]\n  (let [limit (:label-bytes budget)]\n    (letfn [(size [x remaining]\n              (let [n (cond\n                        (cbor/byte-payload? x) (+ 16 (count x))\n                        (string? x) (+ 128 (* 4 (count x)))\n                        (or (keyword? x) (symbol? x)) (+ 128 (* 4 (count (str x))))\n                        (coll? x) (reduce (fn [total v] (+ total (size v (- remaining total))))\n                                          128 (if (map? x) (mapcat identity x) x))\n                        :else 128)]\n                (when (> n remaining)\n                  (refuse! :yin.k/unsupported :resource-limit [:label-bytes]))\n                (if (and (coll? x) (meta x)) (+ n (size (meta x) (- remaining n))) n)))]\n      (size x limit))))\n\n\n'\"'''+s[pos:]\n# only canonical-numbering local encoding/comparison calls\nstart=s.index('(defn canonical-numbering'); end=s.index('(defn emit-numbered',start)\na=s[start:end]\na=a.replace('         labels (into', '         checked-encode (fn [x] (check-label-bytes\"'! x budget) (cbor/encode x))'\"\\\\n         checked-key (fn [x] (check-label-bytes\"'! x budget) (bytes-key x))'\"\\\\n         checked-sort (fn [xs]\\\\n                        (doseq [x xs] (check-label-bytes\"'! x budget))'\"\\\\n                        (vec (sort (fn [a b] (compare-bytes (checked-key (checked-encode a))\\\\n                                                          (checked-key (checked-encode b)))) xs)))\\\\n         labels (into')\na=a.replace('(cbor/encode ', '(checked-encode ').replace('(bytes-key ', '(checked-key ').replace('sorted-bytes','checked-sort')\n# undo recursive fn definitions generated by replacement\n a_dummy=0\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
