{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport tempfile, pathlib, subprocess, os\ncp=pathlib.Path('.cpcache/3644903311.cp').read_text().strip()\nwith tempfile.TemporaryDirectory(prefix='h3-review-') as root:\n    root=pathlib.Path(root)\n    cases={'bound':b'{:version 1 :heads {}} ;'+b'x'*(1048576-22), 'over':b'{:version 1 :heads {}} ;'+b'x'*(1048577-22), 'invalid':b'{:version 1 :heads {}} ;\\\\xff', 'overlong':b'{:version 1 :heads {}} ;\\\\xc0\\\\xaf', 'surrogate':b'{:version 1 :heads {}} ;\\\\xed\\\\xa0\\\\x80', 'bom':b'\\\\xef\\\\xbb\\\\xbf{:version 1 :heads {}}'}\n    for label, bs in cases.items():\n        d=root/label; d.mkdir(); (d/'heads.edn').write_bytes(bs)\n    (root/'directory').mkdir(); (root/'directory'/'heads.edn').mkdir()\n    (root/'symlink').mkdir(); (root/'symlink'/'heads.edn').symlink_to(root/'bound'/'heads.edn')\n    (root/'dangling').mkdir(); (root/'dangling'/'heads.edn').symlink_to(root/'absent')\n    expr='(require (quote [yin.repl.dht :as rd])) (doseq [label [\\\"bound\\\" \\\"over\\\" \\\"invalid\\\" \\\"overlong\\\" \\\"surrogate\\\" \\\"bom\\\" \\\"directory\\\" \\\"symlink\\\" \\\"dangling\\\"]] (prn label (rd/read-heads (str \\\"'+str(root)+'/\\\" label))))'\n    p=subprocess.run(['java','-cp',cp,'clojure.main','-e',expr],capture_output=True,text=True,timeout=40)\n    print(p.stdout); print(p.stderr[:1000])\n    d=root/'fifo'; d.mkdir(); os.mkfifo(d/'heads.edn')\n    expr='(require (quote [yin.repl.dht :as rd])) (println \\\"ENTERING-READ\\\") (flush) (prn (rd/read-heads \\\"'+str(d)+'\\\"))'\n    p=subprocess.Popen(['java','-cp',cp,'clojure.main','-e',expr],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)\n    try:\n        out,err=p.communicate(timeout=15)\n        print('FIFO completed:',out,err)\n    except subprocess.TimeoutExpired:\n        p.kill(); out,err=p.communicate(); print('FIFO still blocked at 15s:',out)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
