ertex-attrs), identical to the web backend's interleave-vertex-data.\"\n  ^type/Float32List [op]\n  (let [^type/Float32List data (type/Float32List. (* (count (:vertices op))\n                                                     12))]\n    (pack/pack-vertex-floats! op (fn [i x] (aset ^type/Float32List data i x)))\n    data))\n\n\n(defn- floats->view\n  \"Copies a sequence of doubles into a fresh Float32List and emplaces it on the\n   host buffer, returning the buffer view ready to bind as a uniform.\"\n  [^gpu/HostBuffer host-buffer floats]\n  (let [n (count floats)\n        ^type/Float32List data (type/Float32List. n)]\n    (loop [i 0\n           s (seq floats)]\n      (when s\n        (aset ^type/Float32List data i (double (first s)))\n        (recur (inc i) (next s))))\n    (.emplace host-buffer (.asByteData (.-buffer data)))))\n\n\n(defn- indices->uint16-list\n  \"Flattens index tuples (triangles or edges) into a Uint16List via the shared\n   packing/pack-indices! layout.\"\n  ^type/Uint16List [tuples width]\n  (let [^type/Uint16List data (type/Uint16List. (* width (count tuples)))]\n    (pack/pack-indices! tuples (fn [i x] (aset ^type/Uint16List data i x)))\n    data))\n\n\n(defonce ^:private gpu-state\n  (atom {:context nil, :pipeline nil, :host-buffer nil, :white-texture nil}))\n\n\n(defonce ^:private gpu-init-inflight? (atom false))\n\n\n(defn- require-rgba-byte-size!\n  [^int width ^int height ^type/ByteData rgba]\n  (let [expected (* width height 4)\n        actual (.-lengthInBytes rgba)]\n    (when (not= expected actual)\n      (v/reject! :validation-failure\n                 (str\n                   \"RGBA texture byte length must be width*height*4; expected \"\n                   expected\n                   \", got \" actual)))))\n\n\n(declare init-gpu!)\n\n\n(defn create-rgba-texture!\n  \"Creates a PgTexture carrying both a Flutter GPU texture and the host bytes.\n\n   The returned PgTexture is the value to place in draw3d/mesh\n   :texture/source. GP