l? rgba)\n                      (throw (dart/Exception. (str \"Failed to decode asset: \"\n                                                   asset-path)))\n                      (create-rgba-texture! w h ^type/ByteData rgba))))))))))))\n\n\n(defn- sampler-filter\n  [filter]\n  (case filter\n    :nearest gpu/MinMagFilter.nearest\n    gpu/MinMagFilter.linear))\n\n\n(defn- sampler-mip-filter\n  [mipmap?]\n  (if mipmap? gpu/MipFilter.linear gpu/MipFilter.nearest))\n\n\n(defn- sampler-address-mode\n  [wrap]\n  (case wrap\n    :repeat gpu/SamplerAddressMode.repeat\n    :mirror gpu/SamplerAddressMode.mirror\n    gpu/SamplerAddressMode.clampToEdge))\n\n\n(defn- sampler-options\n  [op]\n  (let [filter (sampler-filter (get op :texture/filter :linear))\n        mip-filter (sampler-mip-filter (true? (:texture/mipmap op)))\n        address-mode (sampler-address-mode (get op :texture/wrap :clamp))]\n    (gpu/SamplerOptions. .minFilter\n                         filter\n                         .magFilter\n                         filter\n                         .mipFilter\n                         mip-filter\n                         .widthAddressMode\n                         address-mode\n                         .heightAddressMode\n                         address-mode)))\n\n\n(defn- is-emulator?\n  \"Synchronous emulator/simulator detection.  iOS: SIMULATOR_DEVICE_NAME\n   env var.  Android: getprop ro.kernel.qemu returns \\\"1\\\" on emulators.\"\n  []\n  (or (.containsKey (.-environment io/Platform) \"SIMULATOR_DEVICE_NAME\")\n      (try (= \"1\"\n              (.trim ^String\n               (.-stdout\n                 (.runSync io/Process \"getprop\" [\"ro.kernel.qemu\"]))))\n           (catch Object _ false))))\n\n\n(defn gpu-available?\n  \"True when Flutter GPU (Impeller) exposes a context AND the device is not an\n   emulator or simulator.  Emulators run Impeller through software Vulkan\n   (Swiftshader), which satisfies context creation but silently fails to render\n   custom mesh pipelines — so we exclude them via synchronous detection.\"\n  []\n  (and (some? gpu/gpuContext) (not (is-emulator?))))\n\n\n(defn- install-gpu-state!\n  [^gpu/GpuContext ctx ^gpu/ShaderLibrary lib]\n  (let [vert (. lib \"[]\" \"SimpleVertex\")\n        frag (. lib \"[]\" \"SimpleFragment\")]\n    (if (and vert frag)\n      (let [pipeline (.createRenderPipeline ctx vert frag)\n            white-texture (let [bytes (type/ByteData. 4)]\n                            (.setUint8 bytes 0 255)\n                            (.setUint8 bytes 1 255)\n                            (.setUint8 bytes 2 255)\n                            (.setUint8 bytes 3 255)\n                            (let [texture (.createTexture\n                                            ctx\n                                            gpu/StorageMode.hostVisible\n                                            1\n                                            1)]\n                              (.overwrite texture bytes)\n                              texture))]\n        (swap! gpu-state assoc\n               :context ctx\n               :pipeline pipeline\n               :host-buffer (.createHostBuffer ctx)\n               :white-texture white-texture))\n      (dart/print \"GPU shaders not found in bundle.\"))))\n\n\n(defn- init-gpu!\n  \"Idempotently kicks off GPU pipeline setup. `ShaderLibrary.fromAsset`\n   returns a `Future<ShaderLibrary?>` (not the synchronous value earlier\n   Flutter GPU versions returned), so this cannot populate `gpu-state`\n   before returning: every caller (`create-rgba-texture!`, `submit-gpu!`)\n   already tolerates a still-nil `:context` — the former via its `when\n   context` guard, the latter by rejecting the frame — so callers made\n   during the load window simply see \\\"not ready yet\\\" and later calls,\n   once the future resolves, see the real state. `gpu-init-inflight?`\n   guards against firing the asset load again on every frame while one is\n   already in progress; it is cleared on both success and failure so a\n   transient failure (or a first call before the engine is fully up) is\n   retried on the next frame, matching this function's prior behavior of\n   retrying every call until `:context` is set.\"\n  []\n  (when (and (not (:context @gpu-state)) (not @gpu-init-inflight?))\n    (let [ctx gpu/gpuContext]\n      (if (nil? ctx)\n        (dart/print \"Flutter GPU is not available on this device.\")\n        (do\n          (reset! gpu-init-inflight? true)\n          (-> ^async/Future (gpu/ShaderLibrary.fromAsset\n                              \"assets/shaders/simple_mesh.shaderbundle\")\n              (.then (fn [lib]\n                       (reset! gpu-init-inflight? false)\n                       (if (nil? lib)\n                         (dart/print \"Failed to load shader library\")\n                         (install-gpu-state! ctx lib))))\n              (.catchError (fn [e]\n                             (reset! gpu-init-inflight? false)\n                             (dart/print\n                               (str \"Failed to load GPU shaders: \" e))))))))))\n\n\n(defn- render-mesh-gpu!\n  [^gpu/RenderPass pass draw ^gpu/RenderPipeline pipeline\n   ^gpu/HostBuffer host-buffer]\n  (let [{:keys [op]} draw\n        verts (:vertices op)\n        indices (:indices op)\n        pg-tex (:texture/source op)\n        texture (or (when (instance? tex/PgTexture pg-tex)\n                      (.-gpu ^tex/PgTexture pg-tex))\n                    (:white-texture @gpu-state))\n        sampler (sampler-options op)\n        v-data (vertices->float32-list op)\n        ^type/Uint16List i-data (indices->uint16-list indices 3)\n        ;; Upload vertex and index data via HostBuffer\n        v-view (.emplace host-buffer (.asByteData (.-buffer v-data)))\n        i-view (.emplace host-buffer (.asByteData (.-buffer i-data)))\n        ;; Vertex-stage matrices + fragment-stage lighting, both packed by\n        ;; the shared software helpers so