      [dao.postgraphics.validation :as v]))\\n\\n\\n;; --- GPU helpers ---\\n\\n(defn- vertices->float32-list\\n  \\\"Packs (pos uv normal color) per vertex into a Float32List via the shared\\n   packing/pack-vertex-floats! layout (12 floats/vertex, attrs through\\n   vertex-attrs), identical to the web backend's interleave-vertex-data.\\\"\\n  ^type/Float32List [op]\\n  (let [^type/Float32List data (type/Float32List. (* (count (:vertices op))\\n                                                     12))]\\n    (pack/pack-vertex-floats! op (fn [i x] (aset ^type/Float32List data i x)))\\n    data))\\n\\n\\n(defn- floats->view\\n  \\\"Copies a sequence of doubles into a fresh Float32List and emplaces it on the\\n   host buffer, returning the buffer view ready to bind as a uniform.\\\"\\n  [^gpu/HostBuffer host-buffer floats]\\n  (let [n (count floats)\\n        ^type/Float32List data (type/Float32List. n)]\\n    (loop [i 0\\n           s (seq floats)]\\n      (when s\\n        (aset ^type/Float32List data i (double (first s)))\\n        (recur (inc i) (next s))))\\n    (.emplace host-buffer (.asByteData (.-buffer data)))))\\n\\n\\n(defn- indices->uint16-list\\n  \\\"Flattens index tuples (triangles or edges) into a Uint16List via the shared\\n   packing/pack-indices! layout.\\\"\\n  ^type/Uint16List [tuples width]\\n  (let [^type/Uint16List data (type/Uint16List. (* width (count tuples)))]\\n    (pack/pack-indices! tuples (fn [i x] (aset ^type/Uint16List data i x)))\\n    data))\\n\\n\\n(defonce ^:private gpu-state\\n  (atom {:context nil, :pipeline nil, :host-buffer nil, :white-texture nil}))\\n\\n\\n(defonce ^:private gpu-init-inflight? (atom false))\\n\\n\\n(defn- require-rgba-byte-size!\\n  [^int width ^int height ^type/ByteData rgba]\\n  (let [expected (* width height 4)\\n        actual (.-lengthInBytes rgba)]\\n    (when (not= expected actual)\\n      (v/reject! :validation-failure\\n                 (str\\n                   \\\"RGBA texture byte length must be width*height*4; expected \\\"\\n                   expected\\n                   \\\", got \\\" actual)))))\\n\\n\\n(declare init-gpu!)\\n\\n\\n(defn create-rgba-texture!\\n  \\\"Creates a PgTexture carrying both a Flutter GPU texture and the host bytes.\\n\\n   The returned PgTexture is the value to place in draw3d/mesh\\n   :texture/source. GPU sampling uses the .gpu field; software sampling uses\\n   the .rgba field.\\\"\\n  ^tex/PgTexture [^int width ^int height ^type/ByteData rgba]\\n  (when-not (and (> width 0) (> height 0))\\n    (v/reject! :validation-failure \\\"Texture width and height must be positive\\\"))\\n  (require-rgba-byte-size! width height rgba)\\n  (let [rgba-list (.asUint8List (.-buffer rgba)\\n                                (.-offsetInBytes rgba)\\n                                (.-lengthInBytes rgba))]\\n    (init-gpu!)\\n    (let [^gpu/GpuContext context (:context @gpu-state)\\n          gpu-tex (when context\\n                    (let [^gpu/Texture texture (.createTexture\\n                                                 context\\n                                                 gpu/StorageMode.hostVisible\\n                                                 width\\n                                                 height)]\\n                      (.overwrite texture rgba)\\n                      texture))]\\n      (tex/->PgTexture gpu-tex rgba-list width height))))\\n\\n\\n(defn load-rgba-texture-from-asset!\\n  \\\"Asynchronously loads a PNG/JPG asset, decodes it to RGBA8 bytes, and\\n   uploads the result to a PgTexture. Returns a Future that resolves to a\\n   PgTexture suitable for use as :texture/source.\\\"\\n  ^async/Future [^String asset-path]\\n  (.then\\n    ^async/Future (.load services/rootBundle asset-path)\\n    (fn [^type/ByteData asset-bytes]\\n      (.then\\n        ^async/Future\\n        (ui/instantiateImageCodec (.asUint8List (.-buffer asset-bytes)))\\n        (fn [^ui/Codec codec]\\n          (.then\\n            ^async/Future (.getNextFrame codec)\\n            (fn [^ui/FrameInfo frame]\\n              (let [^ui/Image image (.-image frame)\\n                    w (.-width image)\\n                    h (.-height image)]\\n                (.then\\n                  ^async/Future\\n                  (.toByteData image .format ui/ImageByteFormat.rawRgba)\\n                  (fn [rgba]\\n                    (if (nil? rgba)\\n                      (throw (dart/Exception. (str \\\"Failed to decode asset: \\\"\\n                                                   asset-path)))\\n                      (create-rgba-texture! w h ^type/ByteData rgba))))))))))))\\n\\n\\n(defn- sampler-filter\\n  [filter]\\n  (case filter\\n    :nearest gpu/MinMagFilter.nearest\\n    gpu/MinMagFilter.linear))\\n\\n\\n(defn- sampler-mip-filter\\n  [mipmap?]\\n  (if mipmap? gpu/MipFilter.linear gpu/MipFilter.nearest))\\n\\n\\n(defn- sampler-address-mode\\n  [wrap]\\n  (case wrap\\n    :repeat gpu/SamplerAddressMode.repeat\\n    :mirror gpu/SamplerAddressMode.mirror\\n    gpu/SamplerAddressMode.clampToEdge))\\n\\n\\n(defn- sampler-options\\n  [op]\\n  (let [filter (sampler-filter (get op :texture/filter :linear))\\n        mip-filter (sampler-mip-filter (true? (:texture/mipmap op)))\\n        address-mode (sampler-address-mode (get op :texture/wrap :clamp))]\\n    (gpu/SamplerOptions. .minFilter\\n                         filter\\n                         .magFilter\\n                         filter\\n                         .mipFilter\\n                         mip-filter\\n                         .widthAddressMode\\n                         address-mode\\n                         .heightAddressMode\\n                         address-mode)))\\n\\n\\n(defn- is-emulator?\\n  \\\"Synchronous emulator/simulator detection.  iOS: SIMULATOR_DEVICE_NAME\\n   env var.  Android: getprop ro.kernel.qemu returns \\\\\\\"1\\\\\\\" on emulators.\\\"\\n  []\\n  (or (.containsKey (.-environment io/Platform) \\\"SIMULATOR_DEVICE_NAME\\\")\\n      (try (= \\\"1\\\"\\n              (.trim ^String\\n               (.-stdout\\n                 (.runSync io/Process \\\"getprop\\\" [\\\"ro.kernel.qemu\\\"]))))\\n           (catch Object _ false))))\\n\\n\\n(defn gpu-available?\\n  \\\"True when Flutter GPU (Impeller) exposes a context AND the device is not an\\n   emulator or simulator.  Emulators run Impeller through software Vulkan\\n   (Swiftshader), which satisfies context creation but silently fails to render\\n   custom mesh pipelines — so we exclude them via synchronous detection.\\\"\\n  []\\n  (and (some? gpu/gpuContext) (not (is-emulator?))))\\n\\n\\n(defn- install-gpu-state!\\n  [^gpu/GpuContext ctx ^gpu/ShaderLibrary lib]\\n  (let [vert (. lib \\\"[]\\\" \\\"SimpleVertex\\\")\\n        frag (. lib \\\"[]\\\" \\\"SimpleFragment\\\")]\\n    (if (and vert frag)\\n      (let [pipeline (.createRenderPipeline ctx vert frag)\\n            white-texture (let [bytes (type/ByteData. 4)]\\n                            (.setUint8 bytes 0 255)\\n                            (.setUint8 bytes 1 255)\\n                            (.setUint8 bytes 2 255)\\n                            (.setUint8 bytes 3 255)\\n                            (let [texture (.createTexture\\n                                            ctx\\n                                            gpu/StorageMode.hostVisible\\n                                            1\\n                                            1)]\\n                              (.overwrite texture bytes)\\n                              texture))]\\n        (swap! gpu-state assoc\\n               :context ctx\\n               :pipeline pipeline\\n               :host-buffer (.createHostBuffer ctx)\\n               :white-texture white-texture))\\n      (dart/print \\\"GPU shaders not found in bundle.\\\"))))\\n\\n\\n(defn- init-gpu!\\n  \\\"Idempotently kicks off GPU pipeline setup. `ShaderLibrary.fromAsset`\\n   returns a `Future<ShaderLibrary?>` (not the synchronous value earlier\\n   Flutter GPU versions returned), so this cannot populate `gpu-state`\\n   before returning: every caller (`create-rgba-texture!`, `submit-gpu!`)\\n   already tolerates a still-nil `:context` — the former via its `when\\n   context` guard, the latter by rejecting the frame — so callers made\\n   during the load window simply see \\\\\\\"not ready yet\\\\\\\" and later calls,\\n   once the future resolves, see the real state. `gpu-init-inflight?`\\n   guards against firing the asset load again on every frame while one is\\n   already in progress; it is cleared on both success and failure so a\\n   transient failure (or a first call before the engine is fully up) is\\n   retried on the next frame, matching this function's prior behavior of\\n   retrying every call until `:context` is set.\\\"\\n  []\\n  (when (and (not (:context @gpu-state)) (not @gpu-init-inflight?))\\n    (let [ctx gpu/gpuContext]\\n      (if (nil? ctx)\\n        (dart/print \\\"Flutter GPU is not available on this device.\\\")\\n        (do\\n          (reset! gpu-init-inflight? true)\\n          (-> ^async/Future (gpu/ShaderLibrary.fromAsset\\n                              \\\"assets/shaders/simple_mesh.shaderbundle\\\")\\n              (.then (fn [lib]\\n                       (reset! gpu-init-inflight? false)\\n                       (if (nil? lib)\\n                         (dart/print \\\"Failed to load shader library\\\")\\n                         (install-gpu-state! ctx lib))))\\n              (.catchError (fn [e]\\n                             (reset! gpu-init-inflight? false)\\n                             (dart/print\\n                               (str \\\"Failed to load GPU shaders: \\\" e))))))))))\\n\\n\\n(defn- render-mesh-gpu!\\n  [^gpu/RenderPass pass draw ^gpu/RenderPipeline pipeline\\n   ^gpu/HostBuffer host-buffer]\\n  (let [{:keys [op]} draw\\n        verts (:vertices op)\\n        indices (:indices op)\\n        pg-tex (:texture/source op)\\n        texture (or (when (instance? tex/PgTexture pg-tex)\\n                      (.-gpu ^tex/PgTexture pg-tex))\\n                    (:white-texture @gpu-state))\\n        sampler (sampler-options op)\\n        v-data (vertices->float32-list op)\\n        ^type/Uint16List i-data (indices->uint16-list indices 3)\\n        ;; Upload vertex and index data via HostBuffer\\n        v-view (.emplace host-buffer (.asByteData (.-buffer v-data)))\\n        i-view (.emplace host-buffer (.asByteData (.-buffer i-data)))\\n        ;; Vertex-stage matrices + fragment-stage lighting, both packed by\\n        ;; the shared software helpers so the GLSL shader lights exactly\\n        ;; like the\\n        ;; CPU path.\\n        u-view (floats->view host-buffer (pack/packed-vertex-uniforms draw))\\n        f-view (floats->view host-buffer (pack/packed-lighting-block draw))\\n        vert-shader (.-vertexShader pipeline)\\n        frag-shader (.-fragmentShader pipeline)\\n        u-slot (.getUniformSlot vert-shader \\\"Uniforms\\\")\\n        frag-slot (.getUniformSlot frag-shader \\\"Frag\\\")\\n        tex-slot (.getUniformSlot frag-shader \\\"tex\\\")]\\n    (.bindPipeline pass pipeline)\\n    (.setPrimitiveType pass gpu/PrimitiveType.triangle)\\n    (.bindVertexBuffer pass v-view)\\n    (.bindIndexBuffer pass i-view gpu/IndexType.int16)\\n    (.bindUniform pass u-slot u-view)\\n    (.bindUniform pass frag-slot f-view)\\n    (.bindTexture pass tex-slot texture .sampler sampler)\\n    (.drawIndexed pass (.-length i-data))))\\n\\n\\n\\n(defn- render-lines-gpu!\\n  \\\"Renders a :draw3d/lines op as a GPU line list. Reuses the textured-mesh\\n   shader by binding the 1x1 white texture and a per-op constant vertex\\n   color, so the lit fragment becomes (1,1,1,1) * color. setPrimitiveType\\n   is set on every draw because RenderPass topology is sticky and could\\n   leak from a prior lines/triangles draw in the same pass.\\\"\\n  [^gpu/RenderPass pass draw ^gpu/RenderPipeline pipeline\\n   ^gpu/HostBuffer host-buffer]\\n  (let [;; lines are unlit and single-coloured; the shared collapse forces\\n        ;; lighting off and feeds :color through :fill for every vertex.\\n        line-draw (pack/unlit-line-draw draw)\\n        line-op (:op line-draw)\\n        verts (:vertices line-op)\\n        edges (:edges line-op)\\n        texture (:white-texture @gpu-state)\\n        sampler (sampler-options line-op)\\n        v-data (vertices->float32-list line-op)\\n        ^type/Uint16List i-data (indices->uint16-list edges 2)\\n        v-view (.emplace host-buffer (.asByteData (.-buffer v-data)))\\n        i-view (.emplace host-buffer (.asByteData (.-buffer i-data)))\\n        u-view (floats->view host-buffer\\n                             (pack/packed-vertex-uniforms line-draw))\\n        f-view (floats->view host-buffer (pack/packed-lighting-block line-draw))\\n        vert-shader (.-vertexShader pipeline)\\n        frag-shader (.-fragmentShader pipeline)\\n        u-slot (.getUniformSlot vert-shader \\\"Uniforms\\\")\\n        frag-slot (.getUniformSlot frag-shader \\\"Frag\\\")\\n        tex-slot (.getUniformSlot frag-shader \\\"tex\\\")]\\n    (.bindPipeline pass pipeline)\\n    (.setPrimitiveType pass gpu/PrimitiveType.line)\\n    (.bindVertexBuffer pass v-view)\\n    (.bindIndexBuffer pass i-view gpu/IndexType.int16)\\n    (.bindUniform pass u-slot u-view)\\n    (.bindUniform pass frag-slot f-view)\\n    (.bindTexture pass tex-slot texture .sampler sampler)\\n    (.drawIndexed pass (.-length i-data))))\\n\\n\\n(defn- gpu-supported-draw?\\n  \\\"True when a lowered draw is one this Flutter renderer can paint — either\\n   directly via Flutter GPU (clear, camera-reset, mesh-3d, draw-3d) or via\\n   the 2D Canvas overlay in PostgraphicsPainter (draw-2d, text). The name\\n   is historical; reject-non-gpu-draws! is really 'reject unrenderable\\n   draws'.\\\"\\n  [draw]\\n  (case (:pipeline draw)\\n    (:clear :camera-reset :mesh-3d :line-3d :draw-2d :text) true\