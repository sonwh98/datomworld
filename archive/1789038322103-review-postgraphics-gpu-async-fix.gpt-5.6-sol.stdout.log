e-state)))\n\n\n(defn- stop-frame-timer!\n  []\n  (when-let [stop-fn @frame-timer-stop-fn]\n    (stop-fn)\n    (reset! frame-timer-stop-fn nil))\n  :stopped)\n\n\n(defn pause!\n  []\n  (swap! scene-state assoc :animating? false)\n  (emit-frame!)\n  :paused)\n\n\n(defn reset-scene!\n  []\n  (reset! scene-state scene/initial-state)\n  (emit-frame!)\n  :reset)\n\n\n(defn stop!\n  []\n  (stop-frame-timer!) :stopped)\n\n\n(defn start!\n  []\n  (stop-frame-timer!)\n  (reset! scene-state scene/initial-state)\n  (let [port flutter-repl/default-port\n        sched (fn [period-ms tick!]\n                (let [timer (async/Timer.periodic (core/Duration .milliseconds\n                                                                 period-ms)\n                                                  (fn [_] (tick!)))]\n                  (fn [] (.cancel ^async/Timer timer))))\n        frame-stop-fn (sched scene/frame-interval-ms\n                             (fn []\n                               (swap! scene-state scene/advance-state\n                                      scene/frame-step-seconds)\n                               (emit-frame!)))\n        extra-prims\n        {'bodies (fn []\n                   (->> (:bodies @scene-state)\n                        (remove (fn [[_ body]] (= (:kind body) :group)))\n                        (map first)\n                        sort\n                        vec)),\n         'translate! (fn [id x y z]\n                       (swap! scene-state assoc-in\n                              [:bodies (keyword id) :translate]\n                              [(double x) (double y) (double z)])\n                       (emit-frame!)\n                       :translated),\n         'rotate-body! (fn [id rx ry rz]\n                         (swap! scene-state assoc-in\n                                [:bodies (keyword id) :rotate]\n                                [(double rx) (double ry) (double rz)])\n                         (emit-frame!)\n                         :rotated),\n         'color! (fn [id r g b]\n                   (swap! scene-state assoc-in\n                          [:bodies (keyword id) :color]\n                          [(double r) (double g) (double b) 1.0])\n                   (emit-frame!)\n                   :colored),\n         'scale! (fn [id s]\n                   (swap! scene-state assoc-in\n                          [:bodies (keyword id) :scale]\n                          [(double s) (double s) (double s)])\n                   (emit-frame!)\n                   :scaled),\n         'camera! (fn [x y z]\n                    (swap! scene-state assoc-in\n                           [:camera :translate]\n                           [(double x) (double y) (double z)])\n                    (emit-frame!)\n                    :camera-moved),\n         'camera-rotate! (fn [rx ry rz]\n                           (swap! scene-state assoc-in\n                                  [:camera :rotate]\n                                  [(double rx) (double ry) (double rz)])\n                           (emit-frame!)\n                           :camera-rotated),\n         'camera-fov!\n         (fn [fov]\n           (swap! scene-state assoc-in [:camera :fov] (double fov))\n           (emit-frame!)\n           :camera-fov),\n         'animate!\n         (fn [] (swap! scene-state assoc :animating? true) :animating),\n         'pause! pause!,\n         'reset! reset-scene!}]\n    (reset! frame-timer-stop-fn frame-stop-fn)\n    (flutter-repl/start-server! {:port port, :extra-primitives extra-prims})\n    (emit-frame!)\n    :started))\n\n\n(defn view\n  []\n  (m/Scaffold .appBar\n              (m/AppBar .title (m/Text \"Solar System\"))\n              .backgroundColor\n              (m/Color.fromARGB 255 5 7 17)\n              .body\n              (m/LayoutBuilder .builder\n                               (fn [_context ^m/BoxConstraints constraints]\n                                 (let [max-w (.-maxWidth constraints)\n                                       max-h (.-maxHeight constraints)\n                                       side (if (< max-w max-h) max-w max-h)]\n                                   (m/Center .child\n                                             (m/SizedBox .width\n                                                         side\n                                                         .height\n                                                         side\n                                                         .child\n                                                         (pg/postgraphics-widget\n                                                           frame-stream))))))))\n\n\n(defn main\n  []\n  (start!)\n  (m/runApp (m/MaterialApp .title\n                           \"postgraphics solar system\"\n                           .theme\n                           (m/ThemeData .colorScheme (m/ColorScheme.dark))\n                           .home\n                           (view))))\n(ns datomworld.demo.voxel\n  (:require [\"dart:async\" :as async]\n            [\"dart:core\" :as core]\n            [\"package:flutter/material.dart\" :as m]\n            [\"package:flutter/services.dart\" :as services]\n            [dao.postgraphics.flutter :as pg]\n            [dao.postgraphics.flutter.gpu :as pg-gpu]\n            [datomworld.demo.voxel-runner :as runner]\n            [datomworld.demo.voxel-scene :as scene]))\n\n\n(def ^:private W 720.0)\n(def ^:private H 540.0)\n\n\n(defonce ^:private timer* (atom nil))\n(defonce ^:private last-tick* (atom nil))\n\n\n;; --- keyboard ---\n\n(def ^:private key->action\n  {services/LogicalKeyboardKey.keyW :forward,\n   services/LogicalKeyboardKey.keyS :back,\n   services/LogicalKeyboardKey.keyA :left,\n   services/LogicalKeyboardKey.keyD :right,\n   services/LogicalKeyboardKey.space :up,\n   services/LogicalKeyboardKey.shiftLeft :down,\n   services/LogicalKeyboardKey.arrowLeft :look-left,\n   services/LogicalKeyboardKey.arrowRight :look-right,\n   services/LogicalKeyboardKey.arrowUp :look-up,\n   services/LogicalKeyboardKey.arrowDown :look-down})\n\n\n(defn- handle-key-event\n  ^m/KeyEventResult [_node ^services/KeyEvent event]\n  (let [action (get key->action (.-logicalKey event))]\n    (cond (nil? action) m/KeyEventResult.ignored\n          (instance? services/KeyDownEvent event) (do (runner/key-down! action)\n                                                      m/KeyEventResult.handled)\n          (instance? services/KeyUpEvent event) (do (runner/key-up! action)\n                                                    m/KeyEventResult.handled)\n          :else m/KeyEventResult.handled)))\n\n\n;; --- tick loop ---\n\n(defn- tick!\n  []\n  (let [now (core/DateTime.now)\n        last @last-tick*\n        dt (if last\n             (/ (double (.-inMicroseconds (.difference now last))) 1.0e6)\n             (/ (double scene/frame-interval-ms) 1000.0))]\n    (reset! last-tick* now)\n    (runner/tick! dt)))\n\n\n(defn stop!\n  []\n  (when-let [^async/Timer timer @timer*]\n    (.cancel timer)\n    (reset! timer* nil))\n  (runner/clear-keys!)\n  :stopped)\n\n\n(defn start!\n  []\n  (stop!)\n  (runner/ensure-chunk-mesh!)\n  (runner/reset-player!)\n  (reset! last-tick* nil)\n  (tick!)\n  (reset! timer* (async/Timer.periodic (core/Duration .milliseconds\n                                                      scene/frame-interval-ms)\n                                       (fn [_] (tick!))))\n  :started)\n\n\n(defn view\n  []\n  (let [focus-node (m/FocusNode)]\n    (m/Scaffold\n      .appBar\n      (m/AppBar .title (m/Text \"Voxel Demo\"))\n      .backgroundColor\n      (m/Color.fromARGB 255 6 5 16)\n      .body\n      (m/Center\n        .child\n        (m/Column\n          .mainAxisAlignment\n          m/MainAxisAlignment.center\n          .children\n          [(m/Focus .focusNode\n                    focus-node\n                    .autofocus\n                    true\n                    .onKeyEvent\n                    handle-key-event\n                    .child\n                    (m/SizedBox .width\n                                W\n                                .height\n                                H\n                                .child\n                                (pg/postgraphics-widget runner/frame-stream)))\n           (m/SizedBox .height 12.0)\n           (m/Text \"WASD to move, Space/Shift to fly, arrows to look\"\n                   .style\n                   (m/TextStyle .color m.Colors/white70 .fontSize 14.0))])))))\n`getContext(\"webgpu\")` is called, `getContext(\"2d\")` returns null, and vice\nversa. Consequences:\n- `web.gpu` holds the `\"webgpu\"` context, which has no 2D methods, so it stays\n  **3D-only** (2D/text ignored, as today).\n- `web.canvas` holds the `\"2d\"` context and does **everything**: the 3D is\n  rasterized on the CPU into `ImageData` and blitted, then 2D/text draw on top.\n  One context suffices only because software rasterization already reduced 3D to\n  pixels.\n\nThis is why Flutter's single `ui/Canvas` *can* composite a GPU image + 2D + text\n(its GPU path overlays 2D) but the web GPU path cannot. That asymmetry is the\nonly reason `web.gpu` is 3D-only while `web.canvas` is full 2D+3D.\n\n## Cross-cutting decisions (lessons from the reverted attempt, made explicit)\n\n1. **Pixel buffer + single blit, never per-pixel draw.** Both software backends\n   rasterize into a typed pixel buffer and blit once (`putImageData` /\n   `decodeImageFromPixels`+`drawImage`). This is the design's load-bearing perf\n   decision and the reason the shared rasterizer is viable on both platforms.\n\n2. **CPU-samplable textures.** GPU textures aren't CPU-readable, so the software\n   path can't sample them. `dao.postgraphics.flutter.texture/PgTexture {gpu rgba\n   width height}` carries both; `create-rgba-texture!` /\n   `load-rgba-texture-from-asset!` return one. GPU path binds `:gpu`; software\n   path samples `:rgba`. (Hint carefully: a `^PgTexture` cast over `nil` for\n   untextured meshes is a real crash the prior attempt hit on the GPU path too.)\n\n3. **Lighting parity is a renderer concern, never a scene-data hack.** The prior\n   attempt left the GPU shaders unlit while software did Blinn-Phong, then\n   *flipped a scene's light direction* so the lit side faced the camera under\n   software. That couples scene content to a backend accident and breaks the\n   moment the GPU shader is lit. **Decision (settled in Phase 6):** scene data is\n   authoritative and backend-agnostic, and we reach parity by **lighting the GPU\n   shaders** (the preferred option). Both WebGPU (WGSL) and Flutter GPU (GLSL)\n   shaders now reproduce `raster/shade-mesh-fragment` exactly — Blinn-Phong in\n   linear space with the same sRGB encode — driven by the shared uniform layout\n   in `packing/packed-vertex-uniforms` + `packing/packed-lighting-block`. No scene is\n   edited to compensate. The one accepted divergence is a fixed light cap\n   (`packing/max-packed-lights`, 8) on the GPU paths; software has no cap.\n\n4. **GPU detection is \"does it render,\" not \"does it init.\"** Flutter GPU\n   (Impeller) initializes on Android emulators but silently renders no custom\n   mesh pipelines. `gpu-available?` returning true there keeps a broken path.\n   Mitigation (kept from the prior attempt, isolated behind one probe): an\n   `isEmulator` `MethodChannel` in `MainActivity.kt`, probed once at bind\n   (cached), with `use-gpu? = (and (not emulator?) gpu-available?)` decided per\n(ns dao.postgraphics.flutter.texture\n  (:require [\"dart:core\" :as core]\n            [dao.postgraphics.raster :as raster]))\n\n\n(defrecord PgTexture\n  [gpu rgba width height])\n\n\n;; Each texture value owns its generated mip pyramid via an Expando so the\n;; decoded {:rgba :width :height :levels} bundle is GC-eligible with the\n;; texture and is computed only once, not per frame.  Unlike the old\n;; rasterizer's ui/Image source, a PgTexture already carries host-visible\n;; rgba bytes synchronously (see flutter.gpu/create-rgba-texture!), so no\n;; async ui/Image.toByteData round-trip is needed here.\n(defonce ^:private texture-levels\n  (core/Expando. \"dao.postgraphics/texture-levels\"))\n\n\n(defn cpu-texture\n  \"Given a lowered draw's :texture value, returns a CPU-samplable\n   {:rgba bytes :width int :height int :levels [{:rgba :width :height} ...]}\n   map for the software sampler, or nil when no rgba bytes are available\n   (e.g. a placeholder / render-target resource).  Caches the generated mip\n   pyramid in a dart/Expando keyed by the texture value.\"\n  [texture-draw-value]\n  (when (some? texture-draw-value)\n    (if (and (map? texture-draw-value) (:levels texture-draw-value))\n      texture-draw-value\n      (let [^core/Expando levels texture-levels\n            rgba (:rgba texture-draw-value)\n            width (:width texture-draw-value)\n            height (:height texture-draw-value)]\n        (when (and rgba width height)\n          ;; Expando is keyed by identity via its [] / []= operators;\n          ;; aget/aset cannot be used here because they hint the target as\n          ;; List and would cast-fail at runtime.\n          (or (. levels \"[]\" texture-draw-value)\n              (let [w (int width)\n                    h (int height)\n                    cpu {:rgba rgba,\n                         :width w,\n                         :height h,\n                         :levels (raster/generate-mipmaps rgba w h)}]\n                (. levels \"[]=\" texture-draw-value cpu)\n                cpu)))))))\n","exit_code":0,"status":"completed"}}
