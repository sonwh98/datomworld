    u-view (floats->view host-buffer\n                             (pack/packed-vertex-uniforms line-draw))\n        f-view (floats->view host-buffer (pack/packed-lighting-block line-draw))\n        vert-shader (.-vertexShader pipeline)\n        frag-shader (.-fragmentShader pipeline)\n        u-slot (.getUniformSlot vert-shader \"Uniforms\")\n        frag-slot (.getUniformSlot frag-shader \"Frag\")\n        tex-slot (.getUniformSlot frag-shader \"tex\")]\n    (.bindPipeline pass pipeline)\n    (.setPrimitiveType pass gpu/PrimitiveType.line)\n    (.bindVertexBuffer pass v-view)\n    (.bindIndexBuffer pass i-view gpu/IndexType.int16)\n    (.bindUniform pass u-slot u-view)\n    (.bindUniform pass frag-slot f-view)\n    (.bindTexture pass tex-slot texture .sampler sampler)\n    (.drawIndexed pass (.-length i-data))))\n\n\n(defn- gpu-supported-draw?\n  \"True when a lowered draw is one this Flutter renderer can paint — either\n   directly via Flutter GPU (clear, camera-reset, mesh-3d, draw-3d) or via\n   the 2D Canvas overlay in PostgraphicsPainter (draw-2d, text). The name\n   is historical; reject-non-gpu-draws! is really 'reject unrenderable\n   draws'.\"\n  [draw]\n  (case (:pipeline draw)\n    (:clear :camera-reset :mesh-3d :line-3d :draw-2d :text) true\n    :draw-3d (contains? #{:draw3d/triangles :draw3d/lines}\n                        (get-in draw [:op :op/kind]))\n    false))\n\n\n(defn- reject-non-gpu-draws!\n  [lowered]\n  (when-let [draw (some (fn [pass]\n                          (some (fn [draw]\n                                  (when-not (gpu-supported-draw? draw) draw))\n                                (:draws pass)))\n                        (:passes lowered))]\n    (v/reject! :unsupported-op\n               (str \"Flutter GPU renderer does not support pipeline \" (:pipeline\n                                                                        draw)\n                    \"; add a Flutter GPU pipeline for this op instead of \"\n                    \"falling back to Canvas\"))))\n\n\n(defn submit-gpu!\n  [lowered ^double width ^double height]\n  (reject-non-gpu-draws! lowered)\n  (init-gpu!)\n  (let [state @gpu-state\n        ^gpu/GpuContext context (:context state)\n        ^gpu/RenderPipeline pipeline (:pipeline state)\n        ^gpu/HostBuffer host-buffer (:host-buffer state)]\n    (if (and context pipeline host-buffer)\n      (let [clear-col (pack/clear-color lowered)\n            ^double r (double (nth clear-col 0))\n            ^double g (double (nth clear-col 1))\n            ^double b (double (nth clear-col 2))\n            ^double a (double (or (nth clear-col 3) 1.0))\n            ^gpu/CommandBuffer command-buffer (.createCommandBuffer context)\n            ^gpu/Texture texture (.createTexture context\n                                                 gpu/StorageMode.devicePrivate\n                                                 (int width)\n                                                 (int height))\n            ^gpu/Texture depth-texture (.createTexture\n                                         context\n                                         gpu/StorageMode.devicePrivate\n                                         (int width)\n                                         (int height)\n                                         .format\n                                         gpu/PixelFormat.d24UnormS8Uint)\n            render-target (gpu/RenderTarget.singleColor\n                            (gpu/ColorAttachment. .texture\n                                                  texture\n                                                  .clearValue\n                                                  (vm32/Vector4. r g b a)\n                                                  .loadAction\n                                                  gpu/LoadAction.clear\n                                                  .storeAction\n                                                  gpu/StoreAction.store)\n                            .depthStencilAttachment\n                            (gpu/DepthStencilAttachment.\n                              .texture\n                              depth-texture\n                              .depthLoadAction\n                              gpu/LoadAction.clear\n                              .depthStoreAction\n                              gpu/StoreAction.dontCare\n                              .depthClearValue\n                              1.0))\n            ^gpu/RenderPass render-pass (.createRenderPass command-buffer\n                                                           render-target)]\n        (.setDepthCompareOperation render-pass gpu/CompareFunction.less)\n        (.setDepthWriteEnable render-pass true)\n        (.reset host-buffer)\n        ;; TODO: implement other pipelines (clear, text, 2D)\n        (doseq [pass (:passes lowered)\n                draw (:draws pass)]\n          (case (:pipeline draw)\n            :mesh-3d (render-mesh-gpu! render-pass draw pipeline host-buffer)\n            :line-3d (render-lines-gpu! render-pass draw pipeline host-buffer)\n            :draw-3d\n            (case (get-in draw [:op :op/kind])\n              :draw3d/triangles\n              (render-mesh-gpu! render-pass draw pipeline host-buffer)\n              :draw3d/lines\n              (render-lines-gpu! render-pass draw pipeline host-buffer)\n              nil)\n            nil))\n        (.submit command-buffer)\n        (.asImage texture))\n      (v/reject! :unsupported-op\n                 \"Flutter GPU is not available; Canvas fallback is disabled\"))))\n(ns datomworld.demo.earth-moon\n  (:require [\"dart:async\" :as async]\n            [\"dart:core\" :as core]\n            [\"dart:typed_data\" :as type]\n            [\"package:flutter/material.dart\" :as m]\n            [dao.postgraphics.flutter :as pg]\n            [dao.postgraphics.flutter.gpu :as pg-gpu]\n            [datomworld.demo.earth-moon-runner :as runner]\n            [datomworld.demo.earth-moon-scene :as scene]))\n\n\n(def ^:private earth-asset \"assets/images/earth_land_ocean_ice_1024.jpg\")\n(def ^:private moon-asset \"assets/images/moon_texture_512.jpg\")\n(def ^:private ring-tex-width 4)\n(def ^:private ring-tex-height 256)\n\n\n(defonce ^:private timer* (atom nil))\n\n\n(defn- now-ms\n  ^int []\n  (.-millisecondsSinceEpoch (core/DateTime.now)))\n\n\n(defn- ensure-asset-texture!\n  [setter! asset-path]\n  (-> ^async/Future (pg-gpu/load-rgba-texture-from-asset! asset-path)\n      (.then (fn [tex] (setter! tex)))\n      (.catchError (fn [e]\n                     (core/print\n                       (str \"Texture load failed for \" asset-path \": \" e))))))\n\n\n(defn- ring-texture-bytes\n  ^type/ByteData [^int width ^int height]\n  (let [bytes (type/ByteData. (* width height 4))]\n    (dotimes [y height]\n      (let [v (/ (double y) (double (dec height)))\n            b (runner/ring-darkness v)\n            r (int (* 255.0 (* 0.92 b)))\n            g (int (* 255.0 (* 0.84 b)))\n            blue (int (* 255.0 (* 0.66 b)))]\n        (dotimes [x width]\n          (let [offset (* (+ (* y width) x) 4)]\n            (.setUint8 bytes offset r)\n            (.setUint8 bytes (+ offset 1) g)\n            (.setUint8 bytes (+ offset 2) blue)\n            (.setUint8 bytes (+ offset 3) 255)))))\n    bytes))\n\n\n(defn- ensure-ring-texture!\n  []\n  (try (runner/set-ring-texture! (pg-gpu/create-rgba-texture!\n                                   ring-tex-width\n                                   ring-tex-height\n                                   (ring-texture-bytes ring-tex-width\n                                                       ring-tex-height)))\n       (catch Object e (core/print (str \"Ring texture creation failed: \" e)))))\n\n\n(defn stop!\n  []\n  (when-let [^async/Timer timer @timer*]\n    (.cancel timer)\n    (reset! timer* nil))\n  :stopped)\n\n\n(defn start!\n  []\n  (stop!)\n  (runner/reset-scene! (now-ms))\n  (ensure-asset-texture! runner/set-earth-texture! earth-asset)\n  (ensure-asset-texture! runner/set-moon-texture! moon-asset)\n  (ensure-ring-texture!)\n  (reset! timer* (async/Timer.periodic (core/Duration .milliseconds\n                                                      scene/frame-interval-ms)\n                                       (fn [_] (runner/tick! (now-ms)))))\n  :started)\n\n\n(defn view\n  []\n  (m/Scaffold .appBar\n              (m/AppBar .title (m/Text \"Earth and Moon\"))\n              .backgroundColor\n              (m/Color.fromARGB 255 6 5 16)\n              .body\n              (m/LayoutBuilder .builder\n                               (fn [_context ^m/BoxConstraints constraints]\n                                 (let [max-w (.-maxWidth constraints)\n                                       max-h (.-maxHeight constraints)\n                                       side (if (< max-w max-h) max-w max-h)]\n                                   (m/Center .child\n                                             (m/SizedBox\n                                               .width\n                                               side\n                                               .height\n                                               side\n                                               .child\n                                               (pg/postgraphics-widget\n                                                 runner/frame-stream))))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"One material contract risk has emerged: the initialization guard itself is cooperative-safe, but making initialization asynchronous changes what the first texture-creation call can produce. I’m tracing those call sites now, because a `PgTexture` created while the shader Future is pending keeps a permanently nil GPU handle; it is not retroactively uploaded when initialization finishes."}}
