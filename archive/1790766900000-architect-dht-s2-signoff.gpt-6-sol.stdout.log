{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/jing/dht_test.cljc | sed -n '155,220p;380,510p;555,590p'; nl -ba test/dao/jing/dht/facade_test.clj\"","aggregated_output":"   155\t\n   156\t(defn- zeros\n   157\t  [n]\n   158\t  (dht/hex->bytes (apply str (repeat (* 2 n) \"0\"))))\n   159\t\n   160\t\n   161\t(deftest the-gate-answers-need-cookie-or-silence\n   162\t  (let [net (mesh/mesh)\n   163\t        b (mesh/join! net 2 {::dht/publish? true})\n   164\t        _ (mesh/join! net 9)\n   165\t        s (dht/state b)\n   166\t        v [:gate 1]\n   167\t        address (jing/segment-key v)\n   168\t        base {::dht/v 1, :q 7, :id (dht/hex->bytes (mesh/node-id 9))}]\n   169\t    (mesh/tick! b 0)\n   170\t    (testing \"a short cookie-less ping is answered with silence\"\n   171\t      (inject! b 9 (assoc base :op :ping))\n   172\t      (let [before (mesh/log-size net)\n   173\t            s (dht/step s 64)]\n   174\t        (is (= before (mesh/log-size net)))\n   175\t        (is (empty? (dht/routing-entries s)))\n   176\t        (testing \"a padded ping gets exactly the need-cookie reply\"\n   177\t          (inject! b 9 (assoc base :op :ping :pad (zeros 300)))\n   178\t          (let [s (dht/step s 64)\n   179\t                [reply & more] (drop before (mesh/sent net))\n   180\t                m (:message reply)]\n   181\t            (is (nil? more))\n   182\t            (is (= [mesh/host 9] (:to reply)))\n   183\t            (is (= #{::dht/v :op :q :id :cookie :need-cookie} (set (keys m))))\n   184\t            (is (= [1 :reply 7 true] [(::dht/v m) (:op m) (:q m) (:need-cookie m)]))\n   185\t            (is (= (mesh/node-id 2) (hex (:id m))))\n   186\t            (is (= (hex (dht/cookie-for 0 mesh/host 9)) (hex (:cookie m))))\n   187\t            (is (<= (:size reply) dht/first-contact-bytes))\n   188\t            (is (empty? (dht/routing-entries s)) \"no routing entry\")\n   189\t            (testing \"a store with a missing or wrong cookie causes no work\"\n   190\t              (let [bs (jing/canonical-bytes v)\n   191\t                    store (assoc base :op :store :address address :bytes bs\n   192\t                                 :pad (zeros 300))\n   193\t                    before (mesh/log-size net)\n   194\t                    _ (inject! b 9 store)\n   195\t                    _ (inject! b 9 (assoc store :cookie (zeros 16)))\n   196\t                    s (dht/step s 64)\n   197\t                    replies (map :message (drop before (mesh/sent net)))]\n   198\t                (is (= [true true] (map :need-cookie replies)))\n   199\t                (is (every? #(= #{::dht/v :op :q :id :cookie :need-cookie}\n   200\t                                (set (keys %)))\n   201\t                            replies))\n   202\t                (is (nil? (jing/get (:local b) address nil)) \"nothing stored\")\n   203\t                (is (empty? (dht/routing-entries s)))\n   204\t                (testing \"the same store with the valid cookie is served\"\n   205\t                  (let [before (mesh/log-size net)\n   206\t                        _ (inject! b 9 (-> store\n   207\t                                           (dissoc :pad)\n   208\t                                           (assoc :cookie (dht/cookie-for\n   209\t                                                            0 mesh/host 9))))\n   210\t                        s (dht/step s 64)\n   211\t                        [m] (map :message (drop before (mesh/sent net)))]\n   212\t                    (is (= true (:ok m)))\n   213\t                    (is (= v (jing/get (:local b) address nil)))\n   214\t                    (is (= [{:id (mesh/node-id 9), :host mesh/host, :port 9}]\n   215\t                           (dht/routing-entries s)))))))))))))\n   216\t\n   217\t\n   218\t(deftest first-contact-is-a-padded-ping\n   219\t  (let [net (mesh/mesh)\n   220\t        comps (grid net [1 2] {})\n   380\t                 ::dht/local :inserted}]\n   381\t               (fact-of a ::dht/unacknowledged)))))))\n   382\t\n   383\t\n   384\t(deftest every-at-once-unacknowledged-reason\n   385\t  (testing \"solo: answered in the step that reads the request\"\n   386\t    (let [c (mesh/solo)\n   387\t          v [:solo 1]\n   388\t          address (jing/segment-key v)\n   389\t          missing (jing/segment-key [:nowhere])]\n   390\t      (is (not (contains? c :traffic)))\n   391\t      (is (not (contains? c :datagrams)))\n   392\t      (mesh/request! c (put-request \"r1\" v))\n   393\t      (mesh/request! c {:jing/request \"r2\", :jing/get missing})\n   394\t      (mesh/request! c {::dht/replicate address})\n   395\t      (mesh/request! c (get-request \"r3\" v))\n   396\t      (let [s (dht/step (dht/state c) 64)]\n   397\t        (is (= [{:jing/request \"r1\", :jing/unacknowledged ::dht/solo}\n   398\t                {:jing/request \"r2\", :jing/found? false, :jing/bytes nil}\n   399\t                {:jing/request \"r3\", :jing/found? true, :jing/bytes (b64 v)}]\n   400\t               (mesh/answers c)))\n   401\t        (is (= [{::dht/fact ::dht/unacknowledged, ::dht/address address,\n   402\t                 ::dht/reason ::dht/solo, ::dht/peers 0, ::dht/local :inserted}\n   403\t                {::dht/fact ::dht/miss, ::dht/address missing,\n   404\t                 ::dht/reason ::dht/solo}\n   405\t                {::dht/fact ::dht/unacknowledged, ::dht/address address,\n   406\t                 ::dht/reason ::dht/solo, ::dht/peers 0, ::dht/local nil}]\n   407\t               (mesh/facts c)))\n   408\t        (testing \"solo holds no pending work\"\n   409\t          (is (= [{} {} {}] [(:writes s) (:gets s) (:queries s)])))\n   410\t        (is (= v (jing/get (:local c) address nil))))))\n   411\t  (testing \"unpublished: answered at once, nothing sent\"\n   412\t    (let [net (mesh/mesh)\n   413\t          c (mesh/join! net 1 {::dht/bootstrap [(mesh/contact 2)]})\n   414\t          _ (mesh/join! net 2 {::dht/publish? true})\n   415\t          v [:unpublished 1]]\n   416\t      (mesh/request! c (put-request \"u\" v))\n   417\t      (let [s (dht/step (dht/state c) 64)]\n   418\t        (is (= [{:jing/request \"u\", :jing/unacknowledged ::dht/unpublished}]\n   419\t               (mesh/answers c)))\n   420\t        (is (= ::dht/unpublished\n   421\t               (::dht/reason (first (fact-of c ::dht/unacknowledged)))))\n   422\t        (is (zero? (mesh/log-size net)))\n   423\t        (is (= {} (:writes s))))))\n   424\t  (testing \"oversize: refused before the local insert, in every mode\"\n   425\t    (doseq [c [(mesh/solo {::dht/max-message-bytes 300})\n   426\t               (mesh/join! (mesh/mesh) 1 {::dht/publish? true\n   427\t                                          ::dht/max-message-bytes 300})]]\n   428\t      (let [address (jing/segment-key big-value)]\n   429\t        (mesh/request! c (put-request \"o\" big-value))\n   430\t        (dht/step (dht/state c) 64)\n   431\t        (is (= [{:jing/request \"o\", :jing/unacknowledged ::dht/oversize}]\n   432\t               (mesh/answers c)))\n   433\t        (is (= [{::dht/fact ::dht/unacknowledged, ::dht/address address,\n   434\t                 ::dht/reason ::dht/oversize, ::dht/peers 0, ::dht/local nil}]\n   435\t               (mesh/facts c)))\n   436\t        (is (nil? (jing/get (:local c) address nil)) \"no local insert\"))))\n   437\t  (testing \"absent: a replicate names an address :local does not hold\"\n   438\t    (let [c (mesh/join! (mesh/mesh) 1 {::dht/publish? true})\n   439\t          address (jing/segment-key [:absent])]\n   440\t      (mesh/request! c {::dht/replicate address})\n   441\t      (dht/step (dht/state c) 64)\n   442\t      (is (= [{::dht/fact ::dht/unacknowledged, ::dht/address address,\n   443\t               ::dht/reason ::dht/absent, ::dht/peers 0, ::dht/local nil}]\n   444\t             (mesh/facts c)))))\n   445\t  (testing \"busy: max-pending-writes reached\"\n   446\t    (let [c (mesh/join! (mesh/mesh) 1 {::dht/publish? true\n   447\t                                       ::dht/max-pending-writes 1\n   448\t                                       ::dht/bootstrap [(mesh/contact 2)]})]\n   449\t      (mesh/request! c (put-request \"b1\" [:busy 1]))\n   450\t      (mesh/request! c (put-request \"b2\" [:busy 2]))\n   451\t      (let [s (dht/step (dht/state c) 64)]\n   452\t        (is (= [{:jing/request \"b2\", :jing/unacknowledged ::dht/busy}]\n   453\t               (mesh/answers c)))\n   454\t        (is (= [(jing/segment-key [:busy 1])] (keys (:writes s))))))))\n   455\t\n   456\t\n   457\t(deftest time-advances-only-by-appended-ticks\n   458\t  (let [c (mesh/join! (mesh/mesh) 1 {::dht/publish? true\n   459\t                                     ::dht/bootstrap [(mesh/contact 2)]})\n   460\t        _ (mesh/request! c (put-request \"t\" [:no-ticks]))\n   461\t        s (reduce (fn [s _] (dht/step s 64)) (dht/state c) (range 50))]\n   462\t    (is (empty? (mesh/facts c)) \"no tick observed: nothing expires\")\n   463\t    (is (= 1 (count (:writes s))))\n   464\t    (mesh/tick! c 0)\n   465\t    (let [s (dht/step s 64)]\n   466\t      (is (empty? (mesh/facts c)) \"the write began at the first reading\")\n   467\t      (mesh/tick! c 5000)\n   468\t      (dht/step s 64))\n   469\t    (is (= ::dht/too-few-peers\n   470\t           (::dht/reason (first (fact-of c ::dht/unacknowledged)))))))\n   471\t\n   472\t\n   473\t(deftest an-unpublished-peer-is-sent-to-but-stores-nothing\n   474\t  (let [net (mesh/mesh)\n   475\t        comps {1 (mesh/join! net 1 {::dht/publish? true\n   476\t                                    ::dht/bootstrap [(mesh/contact 2)\n   477\t                                                     (mesh/contact 3)]})\n   478\t               2 (mesh/join! net 2)\n   479\t               3 (mesh/join! net 3)}\n   480\t        a (comps 1)\n   481\t        v [:refused 1]\n   482\t        address (jing/segment-key v)]\n   483\t    (mesh/request! a (put-request \"r\" v))\n   484\t    (drive (start comps) comps 0 8)\n   485\t    (is (= {::dht/fact ::dht/sent, ::dht/address address, ::dht/peers 2}\n   486\t           (first (fact-of a ::dht/sent)))\n   487\t        \"acknowledged: sent to 2, never stored by 2\")\n   488\t    (is (= {::dht/fact ::dht/replicated, ::dht/address address,\n   489\t            ::dht/peers 2, ::dht/confirmed 0}\n   490\t           (first (fact-of a ::dht/replicated))))\n   491\t    (is (nil? (jing/get (:local (comps 2)) address nil)))))\n   492\t\n   493\t\n   494\t;; ---------------------------------------------------------------------------\n   495\t;; Section 4.5: reads\n   496\t;; ---------------------------------------------------------------------------\n   497\t\n   498\t(defn- get-through-client\n   499\t  \"Issue a :jing/get for v from node 1 through the unmodified stepped\n   500\t   client, drive every node, and return [completions states].\"\n   501\t  [net comps v]\n   502\t  (let [a (comps 1)\n   503\t        c0 (client/client-state (:requests a) (:answers a) (oldest (:answers a)))\n   504\t        {c :state} (client/request-get c0 (jing/segment-key v))\n   505\t        states (drive (start comps) comps 0 10)]\n   506\t    (is (some? net))\n   507\t    [(:completions (client/step c 16)) states]))\n   508\t\n   509\t\n   510\t(deftest a-remote-read-is-verified-and-cached\n   555\t(deftest read-deadline-and-busy\n   556\t  (testing \"no candidate answers before get-ticks: not found, /deadline\"\n   557\t    (let [c (mesh/join! (mesh/mesh) 1 {::dht/bootstrap [(mesh/contact 2)]})\n   558\t          address (jing/segment-key [:far])]\n   559\t      (mesh/request! c {:jing/request \"g\", :jing/get address})\n   560\t      (mesh/tick! c 0)\n   561\t      (let [s (dht/step (dht/state c) 64)]\n   562\t        (is (= 1 (count (:gets s))))\n   563\t        (mesh/tick! c 5000)\n   564\t        (let [s (dht/step s 64)]\n   565\t          (is (= [{:jing/request \"g\", :jing/found? false, :jing/bytes nil}]\n   566\t                 (mesh/answers c)))\n   567\t          (is (= [{::dht/fact ::dht/miss, ::dht/address address,\n   568\t                   ::dht/reason ::dht/deadline}]\n   569\t                 (mesh/facts c)))\n   570\t          (is (= {} (:gets s)))))))\n   571\t  (testing \"max-pending-gets reached: not found, /busy\"\n   572\t    (let [c (mesh/join! (mesh/mesh) 1 {::dht/max-pending-gets 1\n   573\t                                       ::dht/bootstrap [(mesh/contact 2)]})]\n   574\t      (mesh/request! c (get-request \"g1\" [:g 1]))\n   575\t      (mesh/request! c (get-request \"g2\" [:g 2]))\n   576\t      (dht/step (dht/state c) 64)\n   577\t      (is (= [{:jing/request \"g2\", :jing/found? false, :jing/bytes nil}]\n   578\t             (mesh/answers c)))\n   579\t      (is (= [{::dht/fact ::dht/miss, ::dht/address (jing/segment-key [:g 2]),\n   580\t               ::dht/reason ::dht/busy}]\n   581\t             (mesh/facts c))))))\n   582\t\n   583\t\n   584\t;; ---------------------------------------------------------------------------\n   585\t;; The content clients drive a DHT\n   586\t;; ---------------------------------------------------------------------------\n   587\t\n   588\t(deftest the-unmodified-content-client-materializes-through-a-dht\n   589\t  (let [{:keys [comps states]} (warm)\n   590\t        a (comps 1)\n     1\t(ns dao.jing.dht.facade-test\n     2\t  \"The JVM blocking facade (docs/design/dao.jing.dht.md section 5.2): one\n     3\t   driver thread is the DHT state's one step owner and the tick cadence; a\n     4\t   get-bytes-fn miss waits on dao.jing.content.driver to its deadline; the\n     5\t   put-bytes-fn returns the local verdict without waiting.\"\n     6\t  (:require [clojure.test :refer [deftest is testing]]\n     7\t            [dao.jing :as jing]\n     8\t            [dao.jing.dht :as dht]\n     9\t            [dao.jing.dht.facade :as facade]\n    10\t            [dao.jing.dht.mesh :as mesh]))\n    11\t\n    12\t\n    13\t(deftest a-miss-waits-on-the-driver-and-one-thread-steps\n    14\t  (let [net (mesh/mesh)\n    15\t        stepping (atom #{})\n    16\t        real-step dht/step\n    17\t        v {:facade \"remote\"}\n    18\t        address (jing/segment-key v)]\n    19\t    (with-redefs [dht/step (fn [state budget]\n    20\t                             (swap! stepping conj (Thread/currentThread))\n    21\t                             (real-step state budget))]\n    22\t      (let [b (facade/start! (mesh/join! net 2 {::dht/publish? true})\n    23\t                             {:poll-interval-ms 1})\n    24\t            a (facade/start! (mesh/join! net 1 {::dht/bootstrap\n    25\t                                                [(mesh/contact 2)]})\n    26\t                             {:poll-interval-ms 1\n    27\t                              :request-timeout-ms 5000})]\n    28\t        (try\n    29\t          (is (= :inserted ((:put-bytes-fn b) address\n    30\t                                              (jing/canonical-bytes v)))\n    31\t              \"the local verdict, at once\")\n    32\t          (is (= v (jing/get a address nil)) \"a remote miss waits and finds\")\n    33\t          (is (= v (jing/get (:local a) address nil)) \"and is cached locally\")\n    34\t          (finally\n    35\t            (jing/close! a)\n    36\t            (jing/close! b)))\n    37\t        (testing \"each state has one step owner, never the caller\"\n    38\t          (is (= 2 (count @stepping)))\n    39\t          (is (not (contains? @stepping (Thread/currentThread)))))))))\n    40\t\n    41\t\n    42\t(deftest a-miss-respects-the-driver-deadline\n    43\t  (let [a (facade/start! (mesh/join! (mesh/mesh) 1\n    44\t                                     {::dht/bootstrap [(mesh/contact 9)]})\n    45\t                         {:poll-interval-ms 1\n    46\t                          :request-timeout-ms 150})\n    47\t        started (System/nanoTime)]\n    48\t    (try\n    49\t      (let [data (try (jing/get a (jing/segment-key [:nowhere]) nil)\n    50\t                      nil\n    51\t                      (catch Exception e (ex-data e)))\n    52\t            waited-ms (quot (- (System/nanoTime) started) 1000000)]\n    53\t        (is (= 150 (:timeout-ms data)))\n    54\t        (is (< waited-ms 2000) \"the driver deadline, not get-ticks\"))\n    55\t      (finally (jing/close! a)))))\n    56\t\n    57\t\n    58\t(deftest solo-misses-answer-at-once\n    59\t  (let [a (facade/start! (mesh/solo) {:poll-interval-ms 1})]\n    60\t    (try\n    61\t      (is (= ::none (jing/get a (jing/segment-key [:absent]) ::none)))\n    62\t      (finally (jing/close! a)))))\n","exit_code":0,"status":"completed"}}
