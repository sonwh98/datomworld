    21	#?(:cljs (defmacro async-deftest
    22	           [name & body]
    23	           `(deftest ~name
    24	              (async ~'done
    25	                     (-> (identity nil)
    26	                         ~@(map (fn [form] `(.then (fn [] ~form))) body)
    27	                         (.then (fn [] (~'done)))
    28	                         (.catch (fn [e#] (is nil e#) (~'done))))))))
