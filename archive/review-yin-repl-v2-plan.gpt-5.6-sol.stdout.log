   184	(deftest telemetry-command-test
   185	  #?(:clj (testing
   186	            "telemetry wires a stream into the active VM and records snapshots"
   187	            (let [sink (ds/open! {:dao.stream/type :ringbuffer, :capacity nil})
   188	                  [state-1 _msg] @(repl/eval-input (repl/create-state)
   189	                                                   "(telemetry)")
   190	                  state-1 (assoc state-1
   191	                                 :telemetry-mode {:type :stream, :stream sink})
   192	                  telemetry-stream (:telemetry-stream state-1)
   193	                  [state-2 result] @(repl/eval-input state-1 "(+ 1 2)")
   194	                  datoms (vec (ds/->seq nil sink))]
   195	              (is (= "3" result))
   196	              (is (= telemetry-stream (:telemetry-stream state-2)))
   197	              (is (fact? datoms :vm/phase :step))
   198	              (is (fact? datoms :vm/phase :halt))))
   199	     :cljs (async done
   200	                  (let [sink (ds/open! {:dao.stream/type :ringbuffer,
   201	                                        :capacity nil})]
   202	                    (-> (repl/eval-input (repl/create-state) "(telemetry)")
   203	                        (.then (fn [[state-1 _msg]]
   204	                                 (let [state-1 (assoc state-1
   205	                                                      :telemetry-mode {:type :stream,
   206	                                                                       :stream
   207	                                                                       sink})]
   208	                                   (repl/eval-input state-1 "(+ 1 2)"))))
   209	                        (.then (fn [[_state-2 result]]
   210	                                 (let [datoms (vec (ds/->seq nil sink))]
   211	                                   (is (= "3" result))
   212	                                   (is (fact? datoms :vm/phase :step))
   213	                                   (is (fact? datoms :vm/phase :halt))
   214	                                   (done)))))))))
