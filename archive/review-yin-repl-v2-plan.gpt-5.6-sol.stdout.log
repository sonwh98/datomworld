     1	(ns yin.vm
     2	  "Defines the canonical data model (Datoms), schema, and primitives for the Yin Abstract Machine.
     3	   This namespace acts as the shared kernel/substrate for all execution engines (stack, register, walker)."
     4	  (:refer-clojure :exclude [eval])
     5	  (:require [dao.datom :as datom]
     6	            [dao.stream :as ds]
     7	            #?(:clj [dao.stream.ringbuffer])
     8	            #?(:cljs [dao.stream.ringbuffer])
     9	            #?(:cljd [dao.stream.ringbuffer :as ringbuffer])))
    10	
    11	
    12	;; =============================================================================
    13	;; Protocols
    14	;; =============================================================================
    15	;; Common VM interfaces implemented by all execution engines.
    16	
    17	(defprotocol IVM
    18	  "Unified VM protocol for execution, evaluation, and observable state."
    19	
    20	  (step
    21	    [vm]
    22	    "Execute one step of the VM. Reads from :in-stream if idle.")
    23	
    24	  (run
    25	    [vm]
    26	    "Run VM until halted or blocked.")
    27	
    28	  (eval
    29	    [vm ast]
    30	    "Compile and evaluate an AST.")
    31	
    32	  (reset
    33	    [vm]
    34	    "Reset execution state to a known initial state, preserving loaded program.")
    35	
    36	  (halted?
    37	    [vm]
    38	    "Returns true if VM has halted (completed or error).")
    39	
    40	  (blocked?
    41	    [vm]
    42	    "Returns true if VM is blocked waiting for external input.")
    43	
    44	  (value
    45	    [vm]
    46	    "Returns the current result value, or nil if not yet computed."))
    47	
    48	
    49	(defprotocol IVMState
    50	  "CESK state accessor protocol.
    51	   Exposes the four components of the CESK machine model.
    52	   Representations are VM-specific but the structure is universal."
    53	
    54	  (control
    55	    [vm]
    56	    "Returns the current control state (what is being evaluated).
    57	     VM-specific: AST node, instruction pointer, node ID, etc.")
    58	
    59	  (environment
    60	    [vm]
    61	    "Returns the current lexical environment (variable bindings).")
    62	
    63	  (store
    64	    [vm]
    65	    "Returns the current store (heap/global state).")
    66	
    67	  (continuation
    68	    [vm]
    69	    "Returns the current continuation (what to do next).
    70	     VM-specific: linked frames, stack vector, call-stack, etc."))
    71	
    72	
    73	;; Primitive operations
    74	;; Arithmetic and comparison ops are direct clojure.core references.
    75	;; Wrapped in (fn ...) only where VM semantics require it:
    76	;; - rest: clojure.core/rest returns a lazy seq; wrapped to return a vector
    77	;;   so that conj appends rather than prepends.
    78	;; - yin/def, require: return effect descriptors consumed by the engine.
    79	(def primitives
    80	  {'+ +,
    81	   '- -,
    82	   '* *,
    83	   '/ /,
    84	   '= =,
    85	   '== =,
    86	   '!= not=,
    87	   '< <,
    88	   '> >,
    89	   '<= <=,
    90	   '>= >=,
    91	   'not not,
    92	   'nil? nil?,
    93	   'empty? empty?,
    94	   'first first,
    95	   'rest (fn [a] (vec (rest a))), ; clojure.core/rest returns a lazy seq;
    96	   ;; vec coerces to vector so conj appends rather than prepends
    97	   'conj conj,
    98	   'assoc assoc,
    99	   'get get,
   100	   'vec vec,
   101	   'bytes->str #?(:clj (fn
   102	                         ([b] (String. ^bytes b "UTF-8"))
   103	                         ([b enc] (String. ^bytes b ^String enc)))
   104	                  :cljs (fn [b] (.apply js/String.fromCharCode nil b))
   105	                  :cljd (fn [b] (dart:core/String.fromCharCodes b))),
   106	   ;; Definition primitive - returns an effect
   107	   'yin/def (fn [k v] {:effect :vm/store-put, :key k, :val v}),
   108	   ;; Module loading primitive - returns an effect dispatched to the host
   109	   'require (fn [spec]
   110	              (let [ns-sym (if (vector? spec) (first spec) spec)]
   111	                {:effect :module/require, :module ns-sym}))})
   112	
   113	
   114	(def call-in-stream-key
   115	  "Store key for the shared dao.stream.apply inbound request stream (caller writes, callee reads)."
   116	  :yin/call-in)
   117	
   118	
   119	(def call-in-cursor-key
   120	  "Store key for the shared dao.stream.apply inbound stream cursor."
   121	  :yin/call-in-cursor)
   122	
   123	
   124	(def call-out-stream-key
   125	  "Store key for the shared dao.stream.apply outbound response stream (callee writes, caller reads)."
   126	  :yin/call-out)
   127	
   128	
   129	(def call-out-cursor-key
   130	  "Store key for the shared dao.stream.apply outbound stream cursor."
   131	  :yin/call-out-cursor)
   132	
   133	
   134	(defn- open-local-stream
   135	  "Create an in-process DaoStream for VM-local request/response plumbing."
   136	  []
   137	  #?(:cljd (ringbuffer/make-ring-buffer-stream nil)
   138	     :default (ds/open!
   139	                {:dao.stream/type :ringbuffer, :mode :create, :capacity nil})))
   140	
   141	
   142	;; =============================================================================
   143	;; Bytecode Opcodes
   144	;; =============================================================================
   145	;; Shared instruction set for stack and register bytecode VMs.
   146	
   147	(def opcode-table
   148	  {:literal 1,
   149	   :load-var 2,
   150	   :move 3,
   151	   :lambda 4,
   152	   :call 5,
   153	   :return 6,
   154	   :branch 7,
   155	   :jump 8,
   156	   :gensym 9,
   157	   :store-get 10,
   158	   :store-put 11,
   159	   :stream-make 12,
   160	   :stream-put 13,
   161	   :stream-cursor 14,
   162	   :stream-next 15,
   163	   :stream-close 16,
   164	   :park 17,
   165	   :resume 18,
   166	   :current-cont 19,
   167	   :tailcall 20,
   168	   :dao.stream.apply/call 21})
   169	
   170	
   171	#?(:clj
   172	   (defmacro opcase
   173	     "Dispatch on a numeric opcode using keyword mnemonics.
   174	      Resolved at compile-time to a standard 'case' over integers."
   175	     [op-expr & clauses]
   176	     (let [default (when (odd? (count clauses)) (last clauses))
   177	           paired (if default (butlast clauses) clauses)
   178	           pairs (partition 2 paired)
   179	           ;; Keep a local literal map so CLJD macro host compilation
   180	           ;; does not depend on resolving `opcode-table` as a host
   181	           ;; symbol.
   182	           opcodes {:literal 1,
   183	                    :load-var 2,
   184	                    :move 3,
   185	                    :lambda 4,
   186	                    :call 5,
   187	                    :return 6,
   188	                    :branch 7,
   189	                    :jump 8,
   190	                    :gensym 9,
   191	                    :store-get 10,
   192	                    :store-put 11,
   193	                    :stream-make 12,
   194	                    :stream-put 13,
   195	                    :stream-cursor 14,
   196	                    :stream-next 15,
   197	                    :stream-close 16,
   198	                    :park 17,
   199	                    :resume 18,
   200	                    :current-cont 19,
   201	                    :tailcall 20,
   202	                    :dao.stream.apply/call 21}
   203	           resolved (mapcat (fn [[kw body]] [(get opcodes kw) body]) pairs)]
   204	       `(case (int ~op-expr) ~@resolved ~@(when default [default])))))
   205	
   206	
   207	(def schema
   208	  "DaoDB schema for :yin/ AST datoms.
   209	   Complete data model for the Universal AST as queryable datoms."
   210	  {;; Ref attributes (entity references, tempid resolution)
   211	   :yin/body {:db/valueType :db.type/ref},
   212	   :yin/operator {:db/valueType :db.type/ref},
   213	   :yin/operands {:db/valueType :db.type/ref,
   214	                  :db/cardinality :db.cardinality/many},
   215	   :yin/test {:db/valueType :db.type/ref},
   216	   :yin/consequent {:db/valueType :db.type/ref},
   217	   :yin/alternate {:db/valueType :db.type/ref},
   218	   :yin/source {:db/valueType :db.type/ref},
   219	   :yin/target {:db/valueType :db.type/ref},
   220	   :yin/val-node {:db/valueType :db.type/ref},
   221	   ;; Ground-value attributes. The data model uses Datomic-style schema
   222	   ;; definitions. Value types are declared in comments for the data
   223	   ;; model.
   224	   :yin/type {},      ; keyword (:literal, :variable, :lambda,
   225	   ;; :yin/macro-expand, ...)
   226	   :yin/value {},     ; polymorphic (number, string, boolean, keyword, ...)
   227	   :yin/name {},      ; symbol
   228	   :yin/op {},        ; keyword (dao.stream.apply operation key)
   229	   :yin/params {},    ; vector of symbols
   230	   :yin/key {},       ; symbol
   231	   :yin/prefix {},    ; string
   232	   :yin/buffer {},    ; long
   233	   :yin/parked-id {}, ; keyword
   234	   :yin/tail? {},     ; boolean (tail-position flag)
   235	   ;; Macro attributes
   236	   :yin/macro? {},       ; boolean — true if lambda is a macro
   237	   :yin/phase-policy {}, ; keyword — :compile | :runtime | :both
   238	   ;; Macro expansion event attributes
   239	   :yin/source-call {:db/valueType :db.type/ref}, ; EID of the
   240	   ;; :yin/macro-expand call site
   240	   ;; :yin/macro-expand call site
   241	   :yin/macro {:db/valueType :db.type/ref}, ; EID of the macro lambda
   242	   ;; entity
   243	   :yin/expansion-root {:db/valueType :db.type/ref}, ; EID of the top
   244	   ;; expansion node
   245	   :yin/phase {},     ; keyword — :compile or :runtime
   246	   :yin/error {},     ; structured error (optional)
   247	   :yin/capability {} ; Shibi capability ref (optional)
   248	   })
   249	
   250	
   251	(def ^:private cardinality-many-attrs
   252	  "Attributes with :db.cardinality/many — their values are vectors of refs
   253	   that must be expanded into individual :db/add assertions."
   254	  #{:yin/operands})
   255	
   256	
   257	(defn datoms->tx-data
   258	  "Convert [e a v t m] datoms to DaoDB tx-data [:db/add e a v m].
   259	   Expands cardinality-many vector values into individual assertions.
   260	
   261	   DaoDB implementations like InMemoryDaoDB do not allow nil as a stored
   262	   value, so nil-valued assertions are omitted in this index projection.
   263	   The canonical datom stream remains unchanged and still carries the
   264	   original nil facts."
   265	  [datoms]
   266	  (mapcat (fn [[e a v _t m]]
   267	            (cond (and (contains? cardinality-many-attrs a) (vector? v))
   268	                  (->> v
   269	                       (remove nil?)
   270	                       (map (fn [ref] [:db/add e a ref m])))
   271	                  (nil? v) []
   272	                  :else [[:db/add e a v m]]))
   273	          datoms))
   274	
   275	
   276	(defn ast->datoms-with-root
   277	  "Convert AST map into a vector of datoms. A datom is [e a v t m].
   278	   Returns [root-id datoms].
   279	
   280	   Entity IDs are tempids (negative integers: -16, -17, -18...) that get resolved
