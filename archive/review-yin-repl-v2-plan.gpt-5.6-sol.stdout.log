   330	(defn- read-clojure-forms
   331	  [input-str]
   332	  ;; Use the full Clojure reader (not EDN) so that reader macros like
   333	  ;; ' (quote), # (dispatch), etc. are supported in REPL input.
   334	  #?(:clj (clojure.core/read-string (str "[" input-str "]"))
   335	     :cljs (cljs.reader/read-string (str "[" input-str "]"))
   336	     :cljd (edn/read-string (str "[" input-str "]"))))
