   830	        (recur (nnext args) (assoc opts :telemetry-stream (second args)))
   831	        "--headless" (recur (next args) (assoc opts :headless? true))
   832	        (recur (next args) (update opts :extra (fnil conj []) arg)))
   833	      opts)))
