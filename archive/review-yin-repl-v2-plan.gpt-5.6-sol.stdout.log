   424	(deftest failed-reconnect-preserves-prior-connection-test
   425	  #?(:cljs
   426	     (async
   427	       done
   428	       (let [good-client {:stream ::good}]
   429	         (with-redefs [dao.stream.rpc.ws/connect!
   430	                       (fn
   431	                         ([url]
   432	                          (case url
   433	                            "ws://good" (js/Promise.resolve good-client)
   434	                            "ws://bad" (js/Promise.reject (js/Error.
   435	                                                            "boom"))))
   436	                         ([url _opts]
   437	                          (case url
   438	                            "ws://good" (js/Promise.resolve good-client)
   439	                            "ws://bad" (js/Promise.reject (js/Error.
   440	                                                            "boom")))))]
   441	           (->
   442	             (repl/eval-input (repl/create-state) "(connect \"ws://good\")")
   443	             (.then (fn [[state-1 _msg]]
   444	                      (repl/eval-input state-1 "(connect \"ws://bad\")")))
   445	             (.then
   446	               (fn [[state-2 _msg]]
   447	                 (is
   448	                   (= good-client (:remote-endpoint state-2))
   449	                   "a failed reconnect attempt should leave the prior working connection intact, not tear it down before the new connection is confirmed")
   450	                 (done)))))))
   451	     :default (is true)))
