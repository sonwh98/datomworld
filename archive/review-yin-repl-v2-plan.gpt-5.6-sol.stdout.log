   364	
   365	(defn- close-telemetry-sink!
   366	  [state]
   367	  (when-let [telemetry-mode (:telemetry-mode state)]
   368	    (when (= :stream (:type telemetry-mode))
   369	      (ds/close! (:stream telemetry-mode)))))
   370	
   371	
   372	(defn- set-telemetry-stream
   373	  [state telemetry-stream telemetry-mode]
   374	  (-> state
   375	      (assoc :telemetry-stream telemetry-stream)
   376	      (assoc :telemetry-mode telemetry-mode)
   377	      (assoc :telemetry-cursor {:position 0})
   378	      (update :vm install-telemetry (:vm-type state) telemetry-stream)))
   379	
   380	
   381	(defn- collect-telemetry
   382	  [state]
   383	  (if-not (:telemetry-stream state)
   384	    [state []]
   385	    (loop [cursor (:telemetry-cursor state)
   386	           datoms []]
   387	      (let [result (ds/next (:telemetry-stream state) cursor)]
   388	        (if (map? result)
   389	          (recur (:cursor result) (conj datoms (:ok result)))
   390	          [(assoc state :telemetry-cursor cursor) datoms])))))
   391	
   392	
   393	(defn- flush-telemetry
   394	  [state]
   395	  (let [[state' datoms] (collect-telemetry state)
   396	        telemetry-mode (:telemetry-mode state')]
   397	    (doseq [datom datoms]
   398	      (case (if (map? telemetry-mode) (:type telemetry-mode) telemetry-mode)
   399	        :stderr #?(:clj (binding [*out* *err*] (println (format-value datom)))
   400	                   :cljs (*print-err-fn* (format-value datom))
   401	                   :cljd (binding [*out* *err*] (println (format-value datom))))
   402	        :stream (ds/append! (:stream telemetry-mode) datom)
   403	        nil))
   404	    state'))
   405	
   406	
   407	(defn- collect-output
   408	  [state]
   409	  (if-not (:output-stream state)
   410	    [state ""]
   411	    (loop [cursor (:output-cursor state)
   412	           chunks []]
   413	      (let [result (ds/next (:output-stream state) cursor)]
   414	        (if (map? result)
   415	          (let [event (:ok result)
   416	                text (if (map? event) (:text event) (str event))]
   417	            (recur (:cursor result) (conj chunks text)))
   418	          [(assoc state :output-cursor cursor) (apply str chunks)])))))
   419	
   420	
   421	(defn- format-eval-result
   422	  [state value]
   423	  (let [[state' output-text] (collect-output state)]
   424	    [state' (str output-text (format-value value))]))
   425	
