   175	(defn create-state
   176	  ([] (create-state {}))
   177	  ([{:keys [exposed-ports exposed-streams lang output-cursor output-stream
   178	            request-scope telemetry-stream vm-type],
   179	     :or {exposed-ports {},
   180	          exposed-streams {},
   181	          lang :clojure,
   182	          output-cursor {:position 0},
   183	          vm-type :semantic}}]
   184	   (let [output-stream (or output-stream (make-local-stream))]
   185	     {:lang lang,
   186	      :exposed-ports exposed-ports,
   187	      :exposed-streams exposed-streams,
   188	      :last-value nil,
   189	      :last-value-2 nil,
   190	      :last-value-3 nil,
   191	      :output-cursor output-cursor,
   192	      :output-stream output-stream,
   193	      :remote-endpoint nil,
   194	      :remote-response-cursor {:position 0},
   195	      :request-id 0,
   196	      :request-scope (or request-scope (make-request-scope)),
   197	      :running? true,
   198	      :telemetry-cursor {:position 0},
   199	      :telemetry-mode (when telemetry-stream :stderr),
   200	      :telemetry-stream telemetry-stream,
   201	      :vm (make-vm vm-type telemetry-stream output-stream),
   202	      :vm-type vm-type})))
