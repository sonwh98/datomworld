    98	(deftest command-dispatch-test
    99	  #?(:clj
   100	     (do
   101	       (testing "vm and lang commands change subsequent evaluation semantics"
   102	         (let [[state-1 vm-msg] @(repl/eval-input (repl/create-state)
   103	                                                  "(vm :register)")
   104	               [_state-2 vm-result] @(repl/eval-input state-1 "(+ 1 2)")
   105	               [state-3 lang-msg] @(repl/eval-input state-1 "(lang :python)")
   106	               [_state-4 py-result] @(repl/eval-input state-3 "1 + 2")
   107	               [state-5 php-msg] @(repl/eval-input state-3 "(lang :php)")
   108	               [_state-6 php-result] @(repl/eval-input state-5 "1 + 2;")]
   109	           (is (str/includes? vm-msg "RegisterVM"))
   110	           (is (= "3" vm-result))
   111	           (is (str/includes? lang-msg "Python"))
   112	           (is (= "3" py-result))
   113	           (is (str/includes? php-msg "PHP"))
   114	           (is (= "3" php-result))))
   115	       (testing "compile prints AST and datoms without executing"
   116	         (let [[_state output] @(repl/eval-input (repl/create-state)
   117	                                                 "(compile (+ 1 2))")]
   118	           (is (str/includes? output "AST:"))
   119	           (is (str/includes? output "Datoms:"))
   120	           (is (str/includes? output ":type :application"))))
   121	       (testing "collection values are pretty-printed"
   122	         (let
   123	           [[_state result]
   124	            @(repl/eval-input
   125	               (repl/create-state)
   126	               "{:type :literal
   127	                                    :value {:alpha-long-keyword 1
   128	                                            :beta-long-keyword 2
   129	                                            :gamma-long-keyword 3
   130	                                            :delta-long-keyword 4
   131	                                            :epsilon-long-keyword 5}}")]
   132	           (is (str/includes? result "\n"))
   133	           (is (str/includes? result ":beta-long-keyword"))))
   134	       (testing "quit marks the shell as no longer running"
   135	         (let [[state result] @(repl/eval-input (repl/create-state) "(quit)")]
   136	           (is (false? (:running? state)))
   137	           (is (str/includes? result "Bye")))))
   138	     :cljs
   139	     (async
   140	       done
   141	       (->
   142	         (repl/eval-input (repl/create-state) "(vm :register)")
   143	         (.then (fn [[state-1 vm-msg]]
   144	                  (is (str/includes? vm-msg "RegisterVM"))
   145	                  (repl/eval-input state-1 "(+ 1 2)")))
   146	         (.then (fn [[state-2 vm-result]]
   147	                  (is (= "3" vm-result))
   148	                  (repl/eval-input state-2 "(lang :python)")))
   149	         (.then (fn [[state-3 lang-msg]]
   150	                  (is (str/includes? lang-msg "Python"))
   151	                  (repl/eval-input state-3 "1 + 2")))
   152	         (.then (fn [[state-4 py-result]]
   153	                  (is (= "3" py-result))
   154	                  (repl/eval-input state-4 "(lang :php)")))
   155	         (.then (fn [[state-5 php-msg]]
   156	                  (is (str/includes? php-msg "PHP"))
   157	                  (repl/eval-input state-5 "1 + 2;")))
   158	         (.then (fn [[_state-6 php-result]]
   159	                  (is (= "3" php-result))
   160	                  (repl/eval-input (repl/create-state) "(compile (+ 1 2))")))
   161	         (.then
   162	           (fn [[_state output]]
   163	             (is (str/includes? output "AST:"))
   164	             (is (str/includes? output "Datoms:"))
   165	             (is (str/includes? output ":type :application"))
   166	             (repl/eval-input
   167	               (repl/create-state)
   168	               "{:type :literal
   169	                             :value {:alpha-long-keyword 1
   170	                                     :beta-long-keyword 2
   171	                                     :gamma-long-keyword 3
   172	                                     :delta-long-keyword 4
   173	                                     :epsilon-long-keyword 5}}")))
   174	         (.then (fn [[_state result]]
   175	                  (is (str/includes? result "\n"))
   176	                  (is (str/includes? result ":beta-long-keyword"))
   177	                  (repl/eval-input (repl/create-state) "(quit)")))
   178	         (.then (fn [[state result]]
   179	                  (is (false? (:running? state)))
   180	                  (is (str/includes? result "Bye"))
   181	                  (done)))))))
