   477	(defn- compile-clojure-forms
   478	  [forms]
   479	  (if (= 1 (count forms))
   480	    (yang.clojure/compile (first forms))
   481	    (yang.clojure/compile-program forms)))
   482	
   483	
   484	(defn- compile-source
   485	  [lang input-str]
   486	  (case lang
   487	    :clojure (compile-clojure-forms (read-clojure-forms input-str))
   488	    :python (yang.python/compile input-str)
   489	    :php (yang.php/compile input-str)
   490	    (throw (ex-info "Unsupported Yin REPL language" {:lang lang}))))
   491	
   492	
   493	(defn- eval-clojure-forms
   494	  [state forms]
   495	  (eval-ast state (compile-clojure-forms forms)))
   496	
   497	
   498	(defn- eval-source
   499	  [state input-str]
   500	  (eval-ast state (compile-source (:lang state) input-str)))
   501	
   502	
   503	(defn- compile-command-ast
   504	  [state arg]
   505	  (case (:lang state)
   506	    :clojure (if (string? arg)
   507	               (compile-source :clojure arg)
   508	               (yang.clojure/compile arg))
   509	    :python (if (string? arg)
   510	              (compile-source :python arg)
   511	              (throw (ex-info "Python compile command expects a source string"
   512	                              {:arg arg})))
   513	    :php (if (string? arg)
   514	           (compile-source :php arg)
   515	           (throw (ex-info "PHP compile command expects a source string"
   516	                           {:arg arg})))
   517	    (throw (ex-info "Unsupported Yin REPL language" {:lang (:lang state)}))))
   518	
   519	
   520	(defn- render-compile-output
   521	  [ast]
   522	  (str "AST:\n" (format-value ast)
   523	       "\n\nDatoms:\n" (format-value (vec (vm/ast->datoms ast)))))
   524	
   525	
   526	(defn- deliver-result
   527	  [val]
   528	  #?(:clj (let [p (promise)]
   529	            (deliver p val)
   530	            p)
   531	     :cljs (js/Promise.resolve val)
   532	     :cljd (async/Future.value val)))
   533	
   534	
   535	(defn- eval-remote-input
   536	  [state input-str]
   537	  (let [client (:remote-endpoint state)]
   538	    #?(:clj (deliver-result
   539	              (try [state (rpc-client/call! client :op/eval [input-str])]
   540	                   (catch Exception e [state (format-error e)])))
   541	       :cljs (-> (rpc-client/call! client :op/eval [input-str])
   542	                 (.then (fn [res] [state res]))
   543	                 (.catch (fn [err] [state (format-error err)])))
   544	       :cljd (-> ^async/Future (rpc-client/call! client :op/eval [input-str])
   545	                 (.then (fn [res] [state res]))
   546	                 (.catchError (fn [err] [state (format-error err)]))))))
   547	
   548	
   549	(declare eval-input)
