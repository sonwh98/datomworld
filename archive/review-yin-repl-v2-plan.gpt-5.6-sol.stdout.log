   458	(defn await-connected
   459	  "Poll a WebSocketStream's connection-status until :connected, :closed,
   460	   or timeout. Returns the stream itself on :clj (blocking), a js/Promise
   461	   on :cljs, or a dart:async Future on :cljd that resolves to the stream.
   462	   Rejects/throws on connection failure or timeout.
   463	
   464	   error-context is an optional map merged into ex-info data on failure,
   465	   e.g. {:url url} so callers can preserve connection context in errors."
   466	  ([stream timeout-ms] (await-connected stream timeout-ms nil))
   467	  ([stream timeout-ms error-context]
   468	   (let [attempts-max (max-attempts timeout-ms)
   469	         #?@(:cljs [p-resolve (atom nil)
   470	                    p-reject (atom nil)
   471	                    p (js/Promise. (fn [resolve reject]
   472	                                     (reset! p-resolve resolve)
   473	                                     (reset! p-reject reject)))]
   474	             :cljd [completer (async/Completer.)])]
   475	     (letfn
   476	       [(succeed
   477	          []
   478	          #?(:clj stream
   479	             :cljs (@p-resolve stream)
   480	             :cljd (do (.complete ^async/Completer completer stream) nil)))
   481	        (fail
   482	          [ex]
   483	          #?(:clj (throw ex)
   484	             :cljs (@p-reject ex)
   485	             :cljd (do (.completeError ^async/Completer completer ex) nil)))
   486	        (poll
   487	          [attempts]
   488	          (let [status (connection-status stream)]
   489	            (cond (= :connected status) (succeed)
   490	                  (= :closed status) (fail (ex-info "Connection failed"
   491	                                                    (merge {} error-context)))
   492	                  (> attempts attempts-max)
   493	                  (fail (ex-info "Connection timeout"
   494	                                 (merge {:timeout-ms timeout-ms}
   495	                                        error-context)))
   496	                  :else #?(:clj (do (Thread/sleep poll-interval-ms)
   497	                                    (recur (inc attempts)))
   498	                           :cljs (js/setTimeout #(poll (inc attempts))
   499	                                                poll-interval-ms)
   500	                           :cljd (do (.then (async/Future.delayed
   501	                                              (core/Duration .milliseconds
   502	                                                             poll-interval-ms))
   503	                                            (fn [_] (poll (inc attempts))))
   504	                                     nil)))))]
   505	       #?(:clj (poll 0)
   506	          :cljs (do (poll 0) p)
   507	          :cljd (do (poll 0) (.-future ^async/Completer completer)))))))

