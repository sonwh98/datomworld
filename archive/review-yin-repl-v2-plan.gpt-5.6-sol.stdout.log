   257	(defn repl-state
   258	  "Return a serializable summary of shell state, streams, and exposed ports."
   259	  [state]
   260	  (let [remote-endpoint (:remote-endpoint state)]
   261	    {:lang (:lang state),
   262	     :vm {:type (:vm-type state),
   263	          :halted? (try (vm/halted? (:vm state))
   264	                        (catch #?(:clj Exception
   265	                                  :cljs js/Error
   266	                                  :cljd Object)
   267	                               _
   268	                          :unknown)),
   269	          :blocked? (try (vm/blocked? (:vm state))
   270	                         (catch #?(:clj Exception
   271	                                   :cljs js/Error
   272	                                   :cljd Object)
   273	                                _
   274	                           :unknown))},
   275	     :running? (:running? state),
   276	     :output {:cursor (:output-cursor state),
   277	              :stream (stream-summary (:output-stream state))},
   278	     :telemetry {:enabled? (some? (:telemetry-stream state)),
   279	                 :mode (telemetry-mode-summary (:telemetry-mode state)),
   280	                 :cursor (:telemetry-cursor state),
   281	                 :stream (stream-summary (:telemetry-stream state))},
   282	     :remote
   283	     {:connected? (some? remote-endpoint),
   284	      :request-id (if remote-endpoint @(:request-id-atom remote-endpoint) 0),
   285	      :response-cursor (if remote-endpoint
   286	                         @(:response-cursor-atom remote-endpoint)
   287	                         {:position 0}),
   288	      :streams {:request (stream-summary (when remote-endpoint
   289	                                           (:stream remote-endpoint))),
   290	                :response (stream-summary (when remote-endpoint
   291	                                            (:stream remote-endpoint)))}},
   292	     :streams {:output (stream-summary (:output-stream state)),
   293	               :telemetry (stream-summary (:telemetry-stream state)),
   294	               :remote/request (stream-summary (when remote-endpoint
   295	                                                 (:stream remote-endpoint))),
   296	               :remote/response (stream-summary (when remote-endpoint
   297	                                                  (:stream remote-endpoint)))},
   298	     :exposed-streams (exposed-streams-summary (:exposed-streams state)),
   299	     :ports (exposed-ports-summary (:exposed-ports state))}))
   300	
