   141	
   142	   Returns the result value directly on :clj (blocking). Returns a js/Promise on
   143	   :cljs or a dart:async Future on :cljd that resolves to the result value, or
   144	   rejects on remote error/timeout."
   145	  [{:keys [stream response-cursor-atom request-id-atom closed-atom
   146	           request-timeout-ms]} op args]
   147	  (when @closed-atom (throw (ex-info "Client is closed" {:operation op})))
   148	  ;; Snapshot the cursor before sending: the eventual response can only
   149	  ;; appear at or after this position, so starting the scan here (rather
   150	  ;; than re-derefing response-cursor-atom after another thread may have
   151	  ;; advanced it further) guarantees this call's own response can't be
   152	  ;; skipped.
   153	  (let [start-cursor @response-cursor-atom
   154	        req-id (swap! request-id-atom inc)]
   155	    (dao-apply/put-request! stream req-id op args)
   156	    (wait-for-response stream
   157	                       response-cursor-atom
   158	                       start-cursor
   159	                       req-id
   160	                       (or request-timeout-ms default-timeout-ms))))
   161	
   162	
   163	(defn close!
   164	  "Close a connected client. Idempotent."
   165	  [{:keys [stream closed-atom]}]
   166	  (when (compare-and-set! closed-atom false true) (ds/close! stream)))
     1	(ns dao.stream.rpc.server
     2	  "Transport-agnostic RPC server: exposes a caller-supplied handlers map over
     3	   any IDaoStream via dao.stream.apply.
     4	
     5	   For WebSocket convenience (connect!, start!, stop!), see dao.stream.rpc.ws.
     6	
     7	   Portable across :clj, :cljs, and :cljd. Each client connection gets its own
     8	   request loop that reads requests and sends responses over that connection's
     9	   stream: on :clj this is a real background thread (a future) blocking briefly
    10	   between polls; on :cljs/:cljd there is no blocking thread, so the loop
    11	   self-reschedules via js/setTimeout / dart:async Future.delayed instead."
    12	  (:require #?(:cljd ["dart:async" :as async])
    13	            #?(:cljd ["dart:core" :as core])
    14	            [dao.stream :as ds]
    15	            [dao.stream.apply :as dao-apply]))
    16	
    17	
    18	(def ^:private max-consecutive-errors
    19	  "Stop retrying and close the connection after this many consecutive malformed
    20	   requests, rather than retrying the same broken stream forever."
    21	  20)
    22	
    23	
    24	(defn- dispatch-and-wrap
    25	  "Dispatch a request op through handlers and return a wire-safe response value.
    26	
    27	   Reuses dao.stream.apply/dispatch-request for the handler lookup/apply. Unwraps
    28	   its response envelope back down to the raw result and catches handler
    29	   exceptions, since dispatch-request itself does not catch."
    30	  [handlers op args]
    31	  (try (let [request (dao-apply/request ::dispatch op args)
    32	             response (dao-apply/dispatch-request handlers request)]
    33	         {:ok (dao-apply/response-value response)})
    34	       (catch #?(:clj Exception
    35	                 :cljs :default
    36	                 :cljd Object)
    37	              e
    38	         {:error (ex-message e)})))
    39	
    40	
    41	(defn- handle-one!
    42	  "Read a request at cursor and dispatch it through dispatch-fn, a
    43	   (req-id, op, args) -> {:ok val} | {:error msg} function -- the same
    44	   envelope shape dao.stream.apply/response expects as its result argument.
    45	   The default dispatch-fn serve-connection! builds just wraps
    46	   dispatch-and-wrap over handlers; a caller-supplied dispatch-fn (e.g.
    47	   dao.stream.rpc.dedup/wrap-dedup around that default) can short-circuit
    48	   without re-invoking the handler, which is what makes client-side retries
    49	   safe for non-idempotent handlers.
    50	
    51	   Returns {:cursor next-cursor} on success, the underlying ds/next sentinel
    52	   (:blocked, :end, :daostream/gap) unchanged when nothing was available, or
    53	   {:cursor next-cursor :malformed? true} when reading/decoding the request itself
    54	   threw (the cursor is advanced defensively past the bad position so the loop
    55	   cannot retry the same broken entry forever)."
    56	  [stream cursor dispatch-fn]
    57	  (try (let [req-result (dao-apply/next-request stream cursor)]
    58	         (if (map? req-result)
    59	           (let [request (:ok req-result)
    60	                 req-id (dao-apply/request-id request)
    61	                 op (dao-apply/request-op request)
    62	                 args (dao-apply/request-args request)
    63	                 result (dispatch-fn req-id op args)
    64	                 response (dao-apply/response req-id result)]
    65	             (dao-apply/put-response! stream response)
    66	             {:cursor (:cursor req-result)})
    67	           req-result))
    68	       (catch #?(:clj Exception
    69	                 :cljs :default
    70	                 :cljd Object)
    71	              _
    72	         {:cursor (update cursor :position (fnil inc 0)), :malformed? true})))
    73	
    74	
    75	(defn serve-connection!
    76	  "Serve requests from a single client connection until the connection closes or
    77	   stop-atom is set.
    78	
    79	   opts:
    80	     :wrap-dispatch — a (fn [dispatch-fn] dispatch-fn') that wraps the
    81	                      default dispatch before serving, e.g.
    82	                      dao.stream.rpc.dedup/wrap-dedup for a lossy transport
    83	                      where the same req-id may be resent. Omitted by
    84	                      default: the reliable-transport path never allocates a
    85	                      cache (every request still goes through one
    86	                      dispatch-fn closure call either way).
    87	
    88	   Example transport-agnostic usage (e.g. over an in-memory stream):
    89	   ```clojure
    90	   (let [handlers {:demo/add +}
    91	         stream (ds/open! {:dao.stream/type :ringbuffer, :capacity 1024})
    92	         stop-atom (atom false)]
    93	     (serve-connection! handlers stream stop-atom))
    94	   ```"
    95	  ([handlers stream stop-atom] (serve-connection! handlers stream stop-atom {}))
    96	  ([handlers stream stop-atom {:keys [wrap-dispatch]}]
    97	   (let [dispatch-fn (cond-> (fn [_req-id op args]
    98	                               (dispatch-and-wrap handlers op args))
    99	                       wrap-dispatch wrap-dispatch)]
   100	     (letfn
   101	       [(step
   102	          [cursor consecutive-errors]
   103	          (when-not (or @stop-atom (ds/closed? stream))
   104	            (let [result (handle-one! stream cursor dispatch-fn)]
   105	              (cond (:malformed? result)
   106	                    (let [errors' (inc consecutive-errors)]
   107	                      (if (> errors' max-consecutive-errors)
   108	                        (ds/close! stream)
   109	                        #?(:clj (do (Thread/sleep 10)
   110	                                    (recur (:cursor result) errors'))
   111	                           :cljs (js/setTimeout #(step (:cursor result)
   112	                                                       errors')
   113	                                                10)
   114	                           :cljd (.then (async/Future.delayed
   115	                                          (core/Duration .milliseconds 10))
   116	                                        (fn [_]
   117	                                          (step (:cursor result) errors'))))))
   118	                    ;; No async boundary is crossed here (unlike the
   119	                    ;; :blocked and :malformed? branches, which must hand
   120	                    ;; off to setTimeout/Future.delayed), so recur is valid
   121	                    ;; -- and required -- on every platform: a plain (step
   122	                    ;; ...) call on :cljs/:cljd would grow the stack on
   123	                    ;; every request in a back-to-back burst with no
   124	                    ;; :blocked gap between them.
   125	                    (map? result) (recur (:cursor result) 0)
   126	                    (or (= result :blocked)
   127	                        (= result :end)
   128	                        (= result :daostream/gap))
   129	                    #?(:clj (do (Thread/sleep 10) (recur cursor 0))
   130	                       :cljs (js/setTimeout #(step cursor 0) 10)
   131	                       :cljd (.then (async/Future.delayed
   132	                                      (core/Duration .milliseconds 10))
   133	                                    (fn [_] (step cursor 0))))
   134	                    ;; Anything else (unrecognized sentinel/empty loop
   135	                    ;; exit) -- exit the loop.
   136	                    :else nil))))]
   137	       #?(:clj (future (step {:position 0} 0))
   138	          :cljs (step {:position 0} 0)
   139	          :cljd (step {:position 0} 0))))))
     1	(ns dao.stream.rpc.ws
     2	  "WebSocket convenience layer over the transport-agnostic dao.stream.rpc
     3	   primitives. Use this when your transport is a WebSocket; use
     4	   dao.stream.rpc.client/init-client and dao.stream.rpc.server/serve-connection!
     5	   directly for any other IDaoStream transport."
     6	  (:require [dao.stream :as ds]
     7	            [dao.stream.rpc.client :as rpc-client]
     8	            [dao.stream.rpc.server :as rpc-server]
     9	            [dao.stream.ws :as ws]))
    10	
    11	
    12	(defn connect!
    13	  "Connect to an RPC server at url. Returns an rpc-client client map
    14	   directly on :clj (blocking until the WebSocket handshake completes).
    15	   Returns a js/Promise on :cljs or a dart:async Future on :cljd that
    16	   resolves to the same client map, or rejects on connection
    17	   failure/timeout.
    18	
    19	   Args:
    20	     url  - WebSocket URL (e.g. \"ws://localhost:8080\")
    21	     opts - optional map:
    22	       :timeout-ms         - WebSocket handshake timeout (default 5000)
    23	       :request-timeout-ms - per-call! timeout (default 5000), stored on
    24	                              the returned client
    25	       :capacity           - ringbuffer capacity, passed through to ws/connect!
    26	       :eviction-policy    - ringbuffer eviction policy, passed through to
    27	                              ws/connect!"
    28	  ([url] (connect! url {}))
    29	  ([url opts]
    30	   (let [timeout-ms (get opts :timeout-ms 5000)
    31	         stream (ws/connect! url opts)
    32	         client (rpc-client/init-client stream opts)]
    33	     #?(:clj (do (ws/await-connected stream timeout-ms {:url url}) client)
    34	        :cljs (-> (ws/await-connected stream timeout-ms {:url url})
    35	                  (.then (fn [_] client)))
    36	        :cljd (-> (ws/await-connected stream timeout-ms {:url url})
    37	                  (.then (fn [_] client)))))))
    38	
    39	
    40	(defn start!
    41	  "Start a WebSocket RPC server exposing handlers.
    42	
    43	   Args:
    44	     handlers - a {op-keyword fn} map built by the caller in trusted
    45	                process code. The op keyword arriving over the wire is
    46	                only ever used as a lookup key into this map.
    47	     port     - port number to listen on
    48	     opts     - optional map passed to ws/listen!, plus :on-connect /
    49	                :on-disconnect callbacks that run after the RPC layer
    50	                has accepted the connection
    51	
    52	   Returns:
    53	     {:port <port> :stop! <fn> :server <handle> :conns <atom-of-streams>}"
    54	  ([handlers port] (start! handlers port {}))
    55	  ([handlers port opts]
    56	   (let [stop-atom (atom false)
    57	         conns-atom (atom #{})
    58	         caller-on-connect (:on-connect opts)
    59	         caller-on-disconnect (:on-disconnect opts)
    60	         server-handle
    61	         (ws/listen!
    62	           port
    63	           (assoc opts
    64	                  :on-connect
    65	                  (fn [stream]
    66	                    (swap! conns-atom conj stream)
    67	                    (rpc-server/serve-connection! handlers stream stop-atom)
    68	                    (when caller-on-connect (caller-on-connect stream)))
    69	                  :on-disconnect (fn [stream]
    70	                                   (swap! conns-atom disj stream)
    71	                                   (when caller-on-disconnect
    72	                                     (caller-on-disconnect stream)))))]
    73	     {:port port,
    74	      :stop! (fn []
    75	               (reset! stop-atom true)
    76	               ;; Grace period so in-flight polling loops observe stop-atom
    77	               ;; before their stream is closed out from under them.
    78	               #?(:clj (Thread/sleep 100))
    79	               (doseq [stream @conns-atom] (ds/close! stream))
    80	               ((:stop-fn server-handle))),
    81	      :server server-handle,
    82	      :conns conns-atom})))
    83	
    84	
    85	(defn stop!
    86	  "Stop a running WebSocket RPC server."
    87	  [server]
    88	  ((:stop! server)))
     1	(ns dao.stream
     2	  "DaoStream: bidirectional channel with cursors.
     3	
     4	  Three orthogonal protocol boundaries:
     5	
     6	  IDaoStreamReader (canonical read model):
     7	    Non-destructive, cursor-based reading. Multiple cursors advance independently.
     8	    (next [stream cursor]) → {:ok val :cursor cursor'} | :blocked | :end | :daostream/gap
     9	
    10	  IDaoStreamWriter (canonical write model):
    11	    Append-only writes.
    12	    (append! [stream val]) → {:result :ok, :woke [...]} | {:result :full} (throws if closed)
    13	
    14	  IDaoStreamBound (lifecycle):
    15	    (close! [stream]) → {:woke [...]}
    16	    (closed? [stream]) → boolean
    17	
    18	  IDaoStreamWaitable (optional — transport-local reader and writer waking):
    19	    (register-reader-waiter! [stream position entry])
    20	    (register-writer-waiter! [stream entry])
    21	
    22	  Descriptor (serializable):
    23	    {:dao.stream/type :ringbuffer
    24	     :capacity nil-or-int
    25	     :eviction-policy nil-or-:reject-or-:evict-oldest}
    26	
    27	  Cursor (plain map, constructed inline by caller):
    28	    {:position n}"
    29	  (:refer-clojure :exclude [next comparator]))
    30	
    31	
    32	;; =============================================================================
    33	;; Stream Protocols (Orthogonal Boundaries)
    34	;; =============================================================================
    35	
    36	(defprotocol IDaoStreamReader
    37	  "Non-destructive, cursor-based reading. Multiple cursors on the same stream
    38	   advance independently without consuming values."
    39	
    40	  (next
    41	    [this cursor]
    42	    "Returns {:ok val :cursor cursor'} if value exists at cursor position.
    43	     Returns :blocked if stream is open and position is at end.
    44	     Returns :end if stream is closed and position is at or past end.
    45	     Returns :daostream/gap if cursor position has been evicted by transport."))
    46	
    47	
    48	(defprotocol IDaoStreamWriter
    49	  "Append-only writes. No destructive consumption."
    50	
    51	  (append!
    52	    [this val]
    53	    "Appends val. Returns :ok if successful, :full if transport is capacity-bounded
    54	     and full. Throws ex-info if stream is closed."))
    55	
    56	
    57	(defprotocol IDaoStreamBound
    58	  "Lifecycle: closing streams and checking closed status."
    59	
    60	  (close!
    61	    [this]
    62	    "Marks stream closed. Does not erase existing data. Returns {:woke [...]}
    63	     with any reader-waiters that were resolved.")
    64	
    65	  (closed?
    66	    [this]
    67	    "Returns boolean. True if stream has been closed."))
    68	
    69	
    70	(defprotocol IDaoStreamWaitable
    71	  "Optional protocol: transport-local waiter registration.
    72	   Enables readers and writers to register at the transport instead of the VM scheduler."
    73	
    74	  (register-reader-waiter!
    75	    [this position entry]
    76	    "Register a reader waiter for a specific cursor position.
    77	     Called when ds/next returns :blocked to avoid polling.")
    78	
    79	  (register-writer-waiter!
    80	    [this entry]
    81	    "Register a writer waiter. Called when ds/append! returns :full to avoid polling.
    82	     The entry contains the datom to write; drain-one! will write it and wake the waiter."))
    83	
    84	
    85	(defprotocol IDaoStreamDrainable
    86	  "Optional protocol for destructive consumption."
    87	
    88	  (-drain-one!
    89	    [this]
    90	    "Destructively consume one value from stream.
    91	     Returns {:ok val, :woke [...]} if a value exists (including any woken writers),
    92	     :empty if stream is open and no values available, or :end if stream is closed and drained."))
    93	
    94	
    95	(defmulti open!
    96	  "Realize a descriptor into an operational IStream transport."
    97	  (fn [descriptor] (:dao.stream/type descriptor)))
    98	
    99	
   100	#?(:clj
   101	   (defmacro defopen
   102	     "Register an `open!` implementation for descriptors of `{:dao.stream/type dispatch-val}`.
   103	
   104	      Reads like `defmethod`:
   105	
   106	        (defopen :http [descriptor] ...body...)
   107	
   108	      On clj/cljs this expands to `(defmethod open! dispatch-val ...)`.
   109	      On ClojureDart, where `defmethod` cannot extend a multimethod defined in
   110	      another namespace (the generated type name is munged from the multifn
   111	      symbol and fails to resolve), it expands to the equivalent :type-only
   112	      deftype + `contribute*` registration."
   113	     [dispatch-val argv & body]
   114	     ;; This body is selected at macro-load time: the ClojureDart host
   115	     ;; pass reads with :cljd active, every other host reads :default.
   116	     ;; The when-not guard is load-bearing, not dead code: during a
   117	     ;; ClojureDart host-eval pass the compiler evaluates macro bodies
   118	     ;; that are not compile-time constants (e.g. defopen forms whose
   119	     ;; bodies close over runtime values, as test fixtures do) and
   120	     ;; rejects them with "^{:const :required} but expression is not
   121	     ;; const". Returning nil under *host-eval* skips emission for that
   122	     ;; pass only; the real Dart compilation pass re-expands and emits.
   123	     #?(:cljd (when-not (some-> (resolve 'cljd.compiler/*host-eval*)
   124	                                deref)
   125	                (let [s (name dispatch-val)
   126	                      ;; PascalCase each hyphen-separated segment so
   127	                      ;; dispatch keywords like :file-input-stream yield
   128	                      ;; a valid Dart id.
   129	                      cap (fn [w]
   130	                            (str (.toUpperCase (subs w 0 1)) (subs w 1)))
   131	                      tname (symbol (str (apply str (map cap (.split s "-")))
   132	                                         "OpenMethod"))
   133	                      ;; contribute* needs a fully-qualified contributing
   134	                      ;; type; the compiling namespace is exposed on &env
   135	                      ;; by ClojureDart.
   136	                      qname (symbol (name (get-in &env [:nses :current-ns]))
   137	                                    (name tname))]
   138	                  `(do (deftype ~tname
   139	                         []
   140	                         :type-only
   141	                         true
   142	
   143	                         cljd.core/IFn
   144	
   145	                         (~'-invoke
   146	                           [_# tm#]
   147	                           (assoc! tm# ~dispatch-val (fn ~argv ~@body))))
   148	                       (~'contribute* :multi-method open! ~qname ~qname))))
   149	        :default `(~'defmethod open! ~dispatch-val ~argv ~@body))))
   150	
   151	
   152	;; =============================================================================
   153	;; Utilities (Non-Protocol)
   154	;; =============================================================================
   155	
   156	(defn descriptor?
   157	  "Returns true if x is a DaoStream descriptor map."
   158	  [x]
   159	  (and (map? x) (contains? x :dao.stream/type) (keyword? (:dao.stream/type x))))
   160	
   161	
   162	(defn realization?
   163	  "Returns true if x is a realized DaoStream transport (satisfies IDaoStreamReader)."
   164	  [x]
   165	  (satisfies? IDaoStreamReader x))
   166	
   167	
   168	(defn descriptor
   169	  "Returns the descriptor map of a stream realization x, or x itself if x is a descriptor."
   170	  [x]
   171	  (cond (descriptor? x) x
   172	        (realization? x) (:dao.stream/descriptor (meta x))
   173	        :else nil))
   174	
   175	
   176	(defn exact-bound?
   177	  "True when bound is an explicit finite coordinate rather than a lifecycle
   178	   flag. The concrete shape belongs to the stream interpreter."
   179	  [bound]
   180	  (and (some? bound)
   181	       (not (boolean? bound))
   182	       (not= :open bound)
   183	       (not= :closed bound)))
   184	
   185	
   186	(defn bound
   187	  "Returns the bound of descriptor or stream realization x."
   188	  [x]
   189	  (when-let [d (descriptor x)] (:dao.stream/bound d)))
   190	
   191	
   192	(defn comparator
   193	  "Returns the comparator of descriptor or stream realization x."
   194	  [x]
   195	  (when-let [d (descriptor x)] (or (:dao.stream/comparator d) (:comparator d))))
   196	
   197	
   198	(defn drain-one!
   199	  "Destructively consume one value from stream.
   200	   Returns {:ok val, :woke [...]} if a value exists (including any woken writers),
   201	   :empty if stream is open and no values available, or :end if stream is closed and drained.
   202	
   203	   NOT part of the canonical model. Use (next stream cursor) with cursor-based
   204	   reading for reliable, non-destructive traversal. drain-one! exists for
   205	   consumers that need destructive consumption (dao.runtime's take, the
   206	   yin.vm engine, writer-waiter wakeup).
   207	
   208	   When a writer-waiter is woken, its datom is atomically written to the stream
   209	   and included in the :woke return value."
   210	  [stream]
   211	  (if (satisfies? IDaoStreamDrainable stream)
   212	    (-drain-one! stream)
   213	    (throw (ex-info "drain-one! not supported for this stream transport"
   214	                    {:stream stream}))))
   215	
   216	
   217	(defn ->seq
   218	  "Convert a stream into a lazy Clojure sequence of values using cursor-based
   219	   reading via the IDaoStreamReader protocol. A cursor walks the stream until
   220	   (next stream cursor) hits :blocked, :end, or a gap, at which point the lazy
   221	   sequence terminates.
   222	
   223	   The returned sequence is a snapshot at call time. For open streams, the
   224	   sequence does not grow as new values are appended; create a new sequence
   225	   or use cursors directly to observe new appends.
   226	
   227	   The `ctx` argument is ignored but retained for compatibility with other
   228	   stream helpers."
   229	  [_ stream]
   230	  (when stream
   231	    (letfn [(walk
   232	              [cursor]
   233	              (lazy-seq (let [result (next stream cursor)]
   234	                          (cond (map? result) (cons (:ok result)
   235	                                                    (walk (:cursor result)))
   236	                                (#{:blocked :end :daostream/gap} result) nil
   237	                                :else nil))))]
   238	      (walk {:position 0}))))
   239	
   240	
   241	(defn strict-vec
   242	  "Traverses a finite stream snapshot from position 0 using cursor-based reading.
   243	   Returns a vector of all values until `:end`.
   244	   Throws ex-info if `:blocked`, `:daostream/gap`, or any unexpected signal is encountered."
   245	  [stream]
   246	  (loop [cursor {:position 0}
   247	         acc []]
   248	    (let [result (next stream cursor)]
   249	      (cond
   250	        (map? result)
   251	        (if (and (contains? result :ok) (contains? result :cursor))
   252	          (recur (:cursor result) (conj acc (:ok result)))
   253	          (throw (ex-info
   254	                   "Malformed stream read result: missing :ok or :cursor"
   255	                   {:stream stream, :result result})))
   256	        (= result :end) acc
   257	        (= result :blocked)
   258	        (throw (ex-info
   259	                 "Unexpected :blocked signal during finite snapshot traversal"
   260	                 {:stream stream, :cursor cursor}))
   261	        (= result :daostream/gap)
   262	        (throw
   263	          (ex-info
   264	            "Unexpected :daostream/gap signal during finite snapshot traversal"
   265	            {:stream stream, :cursor cursor}))
   266	        :else (throw
   267	                (ex-info
   268	                  "Malformed stream signal during finite snapshot traversal"
   269	                  {:stream stream, :signal result}))))))
   270	
   271	
   272	(defn take!!
   273	  "Block until one value is available at the stream head, then return it.
   274	
   275	   Cursor-based and non-destructive: reads position 0 via (next stream ...),
   276	   polling every 10ms while the stream is open but empty (:blocked). Returns the
   277	   value on success, nil when the stream closes without a value (:end), and throws
   278	   on :daostream/gap (the position was evicted before it could be read).
   279	
   280	   JVM only — blocks the calling thread. Intended for CLI / REPL / test code; in
   281	   the async runtime, consume streams via dao.runtime instead."
   282	  [stream]
   283	  #?(:clj (loop [cursor {:position 0}]
   284	            (let [result (next stream cursor)]
   285	              (cond (map? result) (:ok result)
   286	                    (= :end result) nil
   287	                    (= :daostream/gap result)
   288	                    (throw (ex-info
