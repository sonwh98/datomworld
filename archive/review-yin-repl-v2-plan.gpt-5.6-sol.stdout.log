   315	(defn- datom?
   316	  [value]
   317	  (and (vector? value) (= 5 (count value))))
   318	
   319	
   320	(defn- datom-stream?
   321	  [value]
   322	  (and (vector? value) (seq value) (every? datom? value)))
   323	
   324	
   325	(defn- ast-map?
   326	  [value]
   327	  (and (map? value) (keyword? (:type value))))
