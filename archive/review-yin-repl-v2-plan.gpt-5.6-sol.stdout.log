   120	(defn- make-repl-primitives
   121	  [output-stream]
   122	  (merge
   123	    vm/primitives
   124	    {'print (fn [& args] (emit-output! output-stream :print (print-text args))),
   125	     'println
   126	     (fn [& args]
   127	       (emit-output! output-stream :println (str (print-text args) "\n"))),
   128	     'prn (fn [& args] (emit-output! output-stream :prn (prn-text args))),
   129	     'ast->datoms vm/ast->datoms,
   130	     'datoms->ast vm/datoms->ast}))
