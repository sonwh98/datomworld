   683	(defn- eval-input-sync
   684	  [state input-str]
   685	  (let [pending (:pending-input state "")
   686	        combined (if (str/blank? pending)
   687	                   (str/trim input-str)
   688	                   (str pending "\n" (str/trim input-str)))
   689	        balance (bracket-balance combined)]
   690	    (if (pos? balance)
   691	      [(assoc state :pending-input combined) ""]
   692	      (let [state' (dissoc state :pending-input)
   693	            trimmed combined
   694	            parsed (try {:forms (read-clojure-forms trimmed)}
   695	                        (catch #?(:clj Exception
   696	                                  :cljs js/Error
   697	                                  :cljd Object)
   698	                               error
   699	                          {:error error}))]
   700	        (eval-input-sync-preparsed state' trimmed parsed)))))
