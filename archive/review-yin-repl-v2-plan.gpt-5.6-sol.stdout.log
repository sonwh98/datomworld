    49	(defn step-on-stream
    50	  "If the VM is idle, ingest one pending program batch before executing a single step."
    51	  [vm in-stream load-fn step-fn]
    52	  (cond (and in-stream (ready-for-ingress? vm))
    53	        (let [{:keys [status state]}
    54	              (ingest-next-program vm in-stream load-fn)]
    55	          (case status
    56	            :ok (step-fn state)
    57	            state))
    58	        (ready-for-ingress? vm) vm
    59	        :else (step-fn vm)))
