   454	(deftest op-eval-handler-with-async-local-command-test
   455	  #?(:cljs
   456	     (async
   457	       done
   458	       (testing
   459	         "op/eval handler should not corrupt state when the evaluated command resolves asynchronously on this platform"
   460	         (let [state-atom (atom (repl/create-state))
   461	               client {:stream ::stream}
   462	               eval-handler (get (repl/make-handlers state-atom) :op/eval)]
   463	           (with-redefs [dao.stream.rpc.ws/connect!
   464	                         (fn
   465	                           ([_url] (js/Promise.resolve client))
   466	                           ([_url _opts] (js/Promise.resolve client)))]
   467	             (->
   468	               (eval-handler "(connect \"ws://remote\")")
   469	               (.then
   470	                 (fn [_]
   471	                   (is
   472	                     (= client (:remote-endpoint @state-atom))
   473	                     "a remote op/eval request for a command that resolves asynchronously (like connect on :cljs/:cljd) should still correctly attach the client, not destructure the pending Promise as [state result]")
   474	                   (done)))
   475	               (.catch
   476	                 (fn [e]
   477	                   (is
   478	                     false
   479	                     (str
   480	                       "op/eval handler threw while evaluating an async local command: "
   481	                       (.-message e)))
   482	                   (done))))))))
   483	     :default (is true)))
