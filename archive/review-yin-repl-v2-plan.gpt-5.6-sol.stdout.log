   148	(defn- install-telemetry
   149	  [vm-state vm-type stream]
   150	  (-> vm-state
   151	      (assoc :telemetry (telemetry-config vm-type stream))
   152	      (assoc :vm-model vm-type)
   153	      (update :telemetry-step #(or % 0))
   154	      (update :telemetry-t #(or % 0))))
