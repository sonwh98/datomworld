   551	
   552	(defn- handle-command
   553	  [state form]
   554	  (let [[command & args] form]
   555	    (case command
   556	      vm (let [vm-type (first args)]
   557	           (when-not (contains? vm-constructors vm-type)
   558	             (throw (ex-info "Unknown Yin REPL VM type"
   559	                             {:vm-type vm-type,
   560	                              :supported (vec (keys vm-constructors))})))
   561	           [(assoc state
   562	                   :vm-type vm-type
   563	                   :vm (make-vm vm-type
   564	                                (:telemetry-stream state)
   565	                                (:output-stream state)))
   566	            (str "Switched to " (get vm-labels vm-type) " (store cleared)")])
   567	      lang (let [lang (first args)]
   568	             (when-not (contains? lang-labels lang)
   569	               (throw (ex-info "Unknown Yin REPL language" {:lang lang})))
   570	             [(assoc state :lang lang)
   571	              (str "Switched to " (get lang-labels lang))])
   572	      compile (let [ast (compile-command-ast state (first args))]
   573	                [state (render-compile-output ast)])
   574	      reset [(assoc state
   575	                    :vm (make-vm (:vm-type state)
   576	                                 (:telemetry-stream state)
   577	                                 (:output-stream state)))
   578	             (str (get vm-labels (:vm-type state)) " reset")]
   579	      connect
   580	      #?(:clj (let [url (normalize-daostream-url (first args))
   581	                    client (rpc-ws/connect! url)
   582	                    state' (detach-remote-endpoint state)]
   583	                [(attach-remote-endpoint state' client)
   584	                 (str "Connected to " url)])
   585	         :cljs (let [url (normalize-daostream-url (first args))
   586	                     p (rpc-ws/connect! url)]
   587	                 (-> p
   588	                     (.then (fn [client]
   589	                              (let [state' (detach-remote-endpoint state)]
   590	                                [(attach-remote-endpoint state' client)
   591	                                 (str "Connected to " url)])))
   592	                     (.catch (fn [err] [state (format-error err)]))))
   593	         :cljd (let [url (normalize-daostream-url (first args))
   594	                     f (rpc-ws/connect! url)]
   595	                 (-> ^async/Future f
   596	                     (.then (fn [client]
   597	                              (let [state' (detach-remote-endpoint state)]
   598	                                [(attach-remote-endpoint state' client)
   599	                                 (str "Connected to " url)])))
   600	                     (.catchError (fn [err] [state (format-error err)])))))
   601	      disconnect [(detach-remote-endpoint state)
   602	                  "Disconnected from remote shell"]
   603	      telemetry
   604	      (let [arg (first args)]
   605	        (cond arg (let [telemetry-stream (or (:telemetry-stream state)
   606	                                             (make-local-stream))
