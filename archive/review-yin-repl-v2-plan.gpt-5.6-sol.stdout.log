   160	(defn- make-vm
   161	  ([vm-type] (make-vm vm-type nil nil))
   162	  ([vm-type telemetry-stream] (make-vm vm-type telemetry-stream nil))
   163	  ([vm-type telemetry-stream output-stream]
   164	   (when-not (contains? vm-constructors vm-type)
   165	     (throw (ex-info "Unknown Yin REPL VM type"
   166	                     {:vm-type vm-type,
   167	                      :supported (vec (keys vm-constructors))})))
   168	   (let [constructor (get vm-constructors vm-type)
   169	         in-stream (make-local-stream)]
   170	     (cond-> (constructor {:primitives (make-repl-primitives output-stream),
   171	                           :in-stream in-stream})
   172	       telemetry-stream (install-telemetry vm-type telemetry-stream)))))
