     7	  [& args]
     8	  (println "Compiling ClojureDart namespace...")
     9	  (let [{:keys [exit out err]} (sh/sh "clj" "-M:cljd-yin-repl-build" "compile")]
    10	    (if (zero? exit)
    11	      (do (println "ClojureDart compilation successful. Starting Dart REPL...")
    12	          (let [pb (ProcessBuilder.
    13	                     (into ["dart" "run" "bin/yin_repl_main.dart"] args))
    14	                _ (.inheritIO pb)
    15	                process (.start pb)]
    16	            (.addShutdownHook
    17	              (Runtime/getRuntime)
    18	              (Thread. (fn [] (when (.isAlive process) (.destroy process)))))
    19	            (System/exit (.waitFor process))))
    20	      (do (binding [*out* *err*]
    21	            (println "ClojureDart compilation failed:")
    22	            (println err)
    23	            (println out))
    24	          (System/exit exit)))))
