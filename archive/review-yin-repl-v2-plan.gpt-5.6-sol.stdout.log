   205	(defn- format-error
   206	  [error]
   207	  (str "Error: "
   208	       #?(:clj (or (ex-message error) (str error))
   209	          :cljs (or (ex-message error) (.-message error) (str error))
   210	          :cljd (or (ex-message error) (str error)))))
