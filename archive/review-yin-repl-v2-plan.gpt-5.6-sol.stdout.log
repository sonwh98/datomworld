   302	(defn- shell-command-form?
   303	  [form]
   304	  (and (seq? form)
   305	       (symbol? (first form))
   306	       (contains? command-heads (first form))))
   307	
   308	
   309	(defn- local-only-command-form?
   310	  [form]
   311	  (and (shell-command-form? form)
   312	       (contains? local-only-command-heads (first form))))
