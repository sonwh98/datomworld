    21	(defn ingest-next-program
    22	  "Poll one program batch from in-stream and hand it to load-fn.
    23	   Returns {:status :ok|:blocked|:end :state vm'}."
    24	  [vm in-stream load-fn]
    25	  (let [cursor (or (:in-cursor vm) {:position 0})
    26	        result (ds/next in-stream cursor)]
    27	    (cond (map? result) (let [cursor' (:cursor result)
    28	                              vm' (-> (assoc vm :in-cursor cursor')
    29	                                      (load-fn (:ok result))
    30	                                      (assoc :in-cursor cursor'))]
    31	                          {:status :ok, :state vm'})
    32	          (= :blocked result) {:status :blocked,
    33	                               :state (assoc vm
    34	                                             :halted? true
    35	                                             :blocked? false)}
    36	          (= :end result) {:status :end,
    37	                           :state (assoc vm
    38	                                         :halted? true
    39	                                         :blocked? false)}
    40	          (= :daostream/gap result)
    41	          (throw (ex-info "VM ingress cursor fell behind the input stream"
    42	                          {:cursor cursor, :vm-model (:vm-model vm)}))
    43	          :else (throw
    44	                  (ex-info
    45	                    "Unexpected DaoStream response while ingesting VM program"
    46	                    {:result result, :vm-model (:vm-model vm)})))))
