   628	
   629	(defn- bracket-balance
   630	  "Count open minus close brackets in s, ignoring string literals and ; comments.
   631	   Positive → input is incomplete (unclosed brackets).
   632	   Zero     → balanced.
   633	   Negative → extra closers."
   634	  [s]
   635	  (loop [chars (seq s)
   636	         depth 0
   637	         in-str? false]
   638	    (if (empty? chars)
   639	      depth
   640	      (let [ch (first chars)
   641	            tail (rest chars)]
   642	        (cond in-str? (cond (= ch \\) (recur (rest tail) depth true)
   643	                            (= ch \") (recur tail depth false)
   644	                            :else (recur tail depth true))
   645	              (= ch \") (recur tail depth true)
   646	              (= ch \;) (recur (drop-while #(not= % \newline) tail) depth false)
   647	              (#{\( \[ \{} ch) (recur tail (inc depth) false)
   648	              (#{\) \] \}} ch) (recur tail (dec depth) false)
   649	              :else (recur tail depth false))))))
   650	
   651	
   652	(defn- eval-input-sync-preparsed
   653	  [state' trimmed parsed]
   654	  (try (cond (and (:forms parsed)
   655	                  (= 1 (count (:forms parsed)))
   656	                  (local-only-command-form? (first (:forms parsed))))
   657	             (handle-command state' (first (:forms parsed)))
   658	             (and (:forms parsed)
   659	                  (= 1 (count (:forms parsed)))
   660	                  (shell-command-form? (first (:forms parsed))))
   661	             (handle-command state' (first (:forms parsed)))
   662	             (and (:forms parsed)
   663	                  (= 1 (count (:forms parsed)))
   664	                  (datom-stream? (first (:forms parsed))))
   665	             (eval-datoms state' (first (:forms parsed)))
   666	             (and (:forms parsed)
   667	                  (= 1 (count (:forms parsed)))
   668	                  (ast-map? (first (:forms parsed))))
   669	             (eval-ast state' (first (:forms parsed)))
   670	             (:forms parsed) (if (= :clojure (:lang state'))
   671	                               (eval-clojure-forms state' (:forms parsed))
   672	                               (eval-source state' trimmed))
   673	             (= :clojure (:lang state')) [state' (format-error (:error parsed))]
   674	             :else (eval-source state' trimmed))
   675	       (catch #?(:clj Exception
   676	                 :cljs js/Error
   677	                 :cljd Object)
   678	              error
   679	         (let [[state'' output-text] (collect-output state')]
   680	           [state'' (str output-text (format-error error))]))))
   681	
   682	
   683	(defn- eval-input-sync
   684	  [state input-str]
   685	  (let [pending (:pending-input state "")
   686	        combined (if (str/blank? pending)
   687	                   (str/trim input-str)
   688	                   (str pending "\n" (str/trim input-str)))
   689	        balance (bracket-balance combined)]
   690	    (if (pos? balance)
   691	      [(assoc state :pending-input combined) ""]
   692	      (let [state' (dissoc state :pending-input)
   693	            trimmed combined
   694	            parsed (try {:forms (read-clojure-forms trimmed)}
   695	                        (catch #?(:clj Exception
   696	                                  :cljs js/Error
   697	                                  :cljd Object)
   698	                               error
   699	                          {:error error}))]
   700	        (eval-input-sync-preparsed state' trimmed parsed)))))
   701	
   702	
   703	(defn eval-input
   704	  [state input-str]
   705	  (let [pending (:pending-input state "")
   706	        combined (if (str/blank? pending)
   707	                   (str/trim input-str)
   708	                   (str pending "\n" (str/trim input-str)))
   709	        balance (bracket-balance combined)]
   710	    (if (pos? balance)
   711	      (deliver-result [(assoc state :pending-input combined) ""])
   712	      (let [state' (dissoc state :pending-input)
   713	            trimmed combined
   714	            parsed (try {:forms (read-clojure-forms trimmed)}
   715	                        (catch #?(:clj Exception
   716	                                  :cljs js/Error
   717	                                  :cljd Object)
   718	                               error
   719	                          {:error error}))
   720	            local-only? (and (:forms parsed)
   721	                             (= 1 (count (:forms parsed)))
   722	                             (local-only-command-form? (first (:forms
   723	                                                                parsed))))]
   724	        (if (and (:remote-endpoint state') (not local-only?))
   725	          (eval-remote-input state' trimmed)
   726	          (let [res (eval-input-sync-preparsed state' trimmed parsed)]
   727	            (if #?(:cljs (and res (.-then res))
   728	                   :cljd (instance? async/Future res)
   729	                   :default false)
   730	              res
   731	              (deliver-result res))))))))
   732	
   733	
   734	(defn make-handlers
   735	  [state-atom]
   736	  {:op/eval (fn [input-str]
   737	              (let [state @state-atom]
   738	                (if (:remote-endpoint state)
   739	                  (let [res (eval-input state input-str)]
   740	                    #?(:clj (let [[state' result] @res]
   741	                              (reset! state-atom state')
   742	                              result)
   743	                       :cljs (.then res
   744	                                    (fn [[state' result]]
   745	                                      (reset! state-atom state')
   746	                                      result))
   747	                       :cljd (.then ^async/Future res
   748	                                    (fn [[state' result]]
   749	                                      (reset! state-atom state')
   750	                                      result))))
   751	                  (let [res (eval-input-sync state input-str)]
   752	                    (if #?(:cljs (and res (.-then res))
   753	                           :cljd (instance? async/Future res)
   754	                           :default false)
   755	                      #?(:cljs (.then res
   756	                                      (fn [[state' result]]
   757	                                        (reset! state-atom state')
   758	                                        result))
   759	                         :cljd (.then ^async/Future res
   760	                                      (fn [[state' result]]
   761	                                        (reset! state-atom state')
   762	                                        result))
   763	                         :default nil)
   764	                      (let [[state' result] res]
   765	                        (reset! state-atom state')
   766	                        result))))))})
