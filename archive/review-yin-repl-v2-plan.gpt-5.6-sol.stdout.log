   769	(defn- expose-repl-server
   770	  [state port server-handle]
   771	  (-> state
   772	      (assoc-in [:exposed-ports :repl]
   773	                {:transport :websocket, :port port, :server server-handle})))
   774	
   775	
   776	(defn- unexpose-repl-server
   777	  [state]
   778	  (-> state
   779	      (update :exposed-ports #(dissoc (or % {}) :repl))))
   780	
   781	
   782	(defn serve!
   783	  ([state-atom port] (serve! state-atom port {}))
   784	  ([state-atom port opts]
   785	   (let [host (or (:host opts) "127.0.0.1")
   786	         handlers (make-handlers state-atom)
   787	         server-handle (rpc-ws/start!
   788	                         handlers
   789	                         port
   790	                         (assoc opts
   791	                                :host host
   792	                                :on-connect
   793	                                (fn [stream]
   794	                                  (log-repl!
   795	                                    (str "Yin REPL client connected on ws://" host
   796	                                         ":" port))
   797	                                  (when-let [on-connect (:on-connect opts)]
   798	                                    (on-connect stream)))))]
   799	     (swap! state-atom expose-repl-server port (:server server-handle))
   800	     (log-repl! (str "Yin REPL server listening on ws://" host ":" port))
   801	     {:port port,
   802	      :server (:server server-handle),
   803	      :conns (:conns server-handle),
   804	      :stop! (fn []
   805	               (rpc-ws/stop! server-handle)
   806	               (swap! state-atom unexpose-repl-server))})))
