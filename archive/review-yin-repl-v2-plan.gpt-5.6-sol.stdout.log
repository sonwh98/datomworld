   213	(defn- stream-status
   214	  [stream]
   215	  (try (if (ds/closed? stream) :closed :open)
   216	       (catch #?(:clj Exception
   217	                 :cljs js/Error
   218	                 :cljd Object)
   219	              _
   220	         :unknown)))
   221	
   222	
   223	(defn- stream-summary
   224	  [stream]
   225	  {:present? (some? stream),
   226	   :status (if stream (stream-status stream) :absent)})
   227	
   228	
   229	(defn- telemetry-mode-summary
   230	  [telemetry-mode]
   231	  (if (map? telemetry-mode)
   232	    (cond-> {:type (:type telemetry-mode)}
   233	      (:url telemetry-mode) (assoc :url (:url telemetry-mode)))
   234	    telemetry-mode))
   235	
   236	
   237	(defn- exposed-streams-summary
   238	  [streams]
   239	  (->> streams
   240	       (sort-by (comp str key))
   241	       (map (fn [[stream-name stream]] [stream-name (stream-summary stream)]))
   242	       (into {})))
   243	
   244	
   245	(defn- exposed-ports-summary
   246	  [ports]
   247	  (->> ports
   248	       (sort-by (comp str key))
   249	       (mapv (fn [[port-name {:keys [transport port stream url]}]]
   250	               (cond-> {:name port-name}
   251	                 transport (assoc :transport transport)
   252	                 (some? port) (assoc :port port)
   253	                 stream (assoc :stream stream)
   254	                 url (assoc :url url))))))
