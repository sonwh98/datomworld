    31	(deftest eval-input-dispatch-test
    32	  #?(:clj
    33	     (do
    34	       (testing "Clojure source evaluation persists VM state across inputs"
    35	         (let [[state-1 result-1] @(repl/eval-input (repl/create-state)
    36	                                                    "(+ 20 22)")
    37	               [state-2 result-2] @(repl/eval-input state-1 "(def x 10)")
    38	               [_state-3 result-3] @(repl/eval-input state-2 "x")]
    39	           (is (= "42" result-1))
    40	           (is (= "10" result-2))
    41	           (is (= "10" result-3))))
    42	       (testing "AST maps are evaluated directly"
    43	         (let [[_state result] @(repl/eval-input (repl/create-state)
    44	                                                 "{:type :literal :value 7}")]
    45	           (is (= "7" result))))
    46	       (testing
    47	         "Undefined symbols report an error instead of evaluating to nil"
    48	         (let [[state-1 missing-result] @(repl/eval-input (repl/create-state)
    49	                                                          "missing-symbol")
    50	               [_state-2 nil-result] @(repl/eval-input state-1 "nil")]
    51	           (is (str/includes?
    52	                 missing-result
    53	                 "Unable to resolve symbol: missing-symbol in this context"))
    54	           (is (= "nil" nil-result))))
    55	       (testing "Raw datom streams are executed directly on datom VMs"
    56	         (let
    57	           [[_state result]
    58	            @(repl/eval-input
    59	               (repl/create-state)
    60	               "[[-1 :yin/type :literal 0 1]
    61	                                                    [-1 :yin/value 99 0 1]]")]
    62	           (is (= "99" result)))))
    63	     :cljs
    64	     (async
    65	       done
    66	       (->
    67	         (repl/eval-input (repl/create-state) "(+ 20 22)")
    68	         (.then (fn [[state-1 result-1]]
    69	                  (is (= "42" result-1))
    70	                  (repl/eval-input state-1 "(def x 10)")))
    71	         (.then (fn [[state-2 result-2]]
    72	                  (is (= "10" result-2))
    73	                  (repl/eval-input state-2 "x")))
    74	         (.then (fn [[_state-3 result-3]]
    75	                  (is (= "10" result-3))
    76	                  (repl/eval-input (repl/create-state)
    77	                                   "{:type :literal :value 7}")))
    78	         (.then (fn [[_state result]]
    79	                  (is (= "7" result))
    80	                  (repl/eval-input (repl/create-state) "missing-symbol")))
    81	         (.then
    82	           (fn [[state-1 missing-result]]
    83	             (is
    84	               (str/includes?
    85	                 missing-result
    86	                 "Unable to resolve symbol: missing-symbol in this context"))
    87	             (repl/eval-input state-1 "nil")))
    88	         (.then
    89	           (fn [[_state-2 nil-result]]
    90	             (is (= "nil" nil-result))
    91	             (repl/eval-input
    92	               (repl/create-state)
    93	               "[[-1 :yin/type :literal 0 1]
    94	                                             [-1 :yin/value 99 0 1]]")))
    95	         (.then (fn [[_state result]] (is (= "99" result)) (done)))))))
