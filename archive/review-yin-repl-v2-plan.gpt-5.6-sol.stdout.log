   427	(defn- inject-last-value
   428	  [state]
   429	  (let [vm (:vm state)
   430	        v1 (:last-value state)
   431	        v2 (:last-value-2 state)
   432	        v3 (:last-value-3 state)]
   433	    (assoc state :vm (update vm :store assoc '*1 v1 '*2 v2 '*3 v3))))
   434	
   435	
   436	(defn- record-last-value
   437	  [state state-after value]
   438	  (assoc state-after
   439	         :last-value value
   440	         :last-value-2 (:last-value state)
   441	         :last-value-3 (:last-value-2 state)))
   442	
   443	
   444	(defn- finalize-eval
   445	  [state vm']
   446	  (let [value (vm/value vm')
   447	        [state' result-str] (format-eval-result (-> state
   448	                                                    (assoc :vm vm')
   449	                                                    flush-telemetry)
   450	                                                value)]
   451	    [(record-last-value state state' value) result-str]))
   452	
   453	
   454	(defn- eval-datoms
   455	  [state datoms]
   456	  (let [state' (inject-last-value state)
   457	        vm0 (:vm state')
   458	        _ (ds/append! (:in-stream vm0) (vec datoms))
   459	        vm' (vm/run vm0)]
   460	    (if (vm/halted? vm')
   461	      (finalize-eval state' vm')
   462	      (throw
   463	        (ex-info
   464	          "Datom stream did not form a complete, runnable Yin VM program.
   465	Hint: If you wanted to evaluate these datoms as data, use a quote: '[[...]]"
   466	          {:root-id (:root-id (vm/index-datoms datoms)),
   467	           :datom-count (count datoms)})))))
   468	
   469	
   470	(defn- eval-ast
   471	  [state ast]
   472	  (let [state' (inject-last-value state)
   473	        vm' (vm/eval (:vm state') ast)]
   474	    (finalize-eval state' vm')))
