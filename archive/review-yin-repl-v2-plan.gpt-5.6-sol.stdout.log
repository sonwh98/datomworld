    41	        [state' msg] (link/local-put state val)]
    42	    (if-let [send-fn @send-fn-atom]
    43	      (do (reset! link-state-atom (assoc state'
    44	                                         :local-sent-pos (:local-pos state')))
    45	          (send-fn (transit/encode msg)))
    46	      (reset! link-state-atom state'))
    47	    {:result :ok, :woke []}))
