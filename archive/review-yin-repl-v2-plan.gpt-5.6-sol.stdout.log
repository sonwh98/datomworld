   354	(defn- attach-remote-endpoint
   355	  [state client]
   356	  (assoc state :remote-endpoint client))
   357	
   358	
   359	(defn- detach-remote-endpoint
   360	  [state]
   361	  (when-let [client (:remote-endpoint state)] (rpc-client/close! client))
   362	  (assoc state :remote-endpoint nil))
