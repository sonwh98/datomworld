ace does not; the descriptor answer\\\\n     6\\\\t   carrying the surface; a kept cursor from a reflection accepted by\\\\n     7\\\\t   the source handle; the budget chase and its terminal non-ok outcome;\\\\n     8\\\\t   oversize; resend-after on an unreliable toy channel; append-unknown\\\\n     9\\\\t   on channel end and at close; refused returned verbatim; close!\\\\n    10\\\\t   semantics; the mirror's four-step order on the wire, its channel\\\\n    11\\\\t   context, and malformed input dropped; the remote descriptor\\\\n    12\\\\t   dispatch; position errors only ever relayed; a send the writer\\\\n    13\\\\t   refuses with full leaving nothing outstanding, a refused probe\\\\n    14\\\\t   kept and retried on a later drain; and the installed outcomes kept\\\\n    15\\\\t   to their own served stream.\\\\\\\"\\\\n    16\\\\t  (:require [clojure.test :refer [deftest is testing]]\\\\n    17\\\\t            [dao.stream :as stream]\\\\n    18\\\\t            [dao.stream.middleware :as middleware]\\\\n    19\\\\t            [dao.stream.remote :as remote]\\\\n    20\\\\t            [dao.stream.ringbuffer :as ringbuffer]))\\\\n    21\\\\t\\\\n    22\\\\t\\\\n    23\\\\t;; =============================================================================\\\\n    24\\\\t;; The toy: two in-process ring buffers as the channel\\\\n    25\\\\t;; =============================================================================\\\\n    26\\\\t\\\\n    27\\\\t(defn- ring\\\\n    28\\\\t  \\\\\\\"An open owner ring-buffer handle with the given capacity.\\\\\\\"\\\\n    29\\\\t  [capacity]\\\\n    30\\\\t  (:dao.stream/handle\\\\n    31\\\\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\\\\n    32\\\\t                         :dao.stream.ringbuffer/capacity capacity})))\\\\n    33\\\\t\\\\n    34\\\\t\\\\n    35\\\\t(defn- toy\\\\n    36\\\\t  \\\\\\\"The toy channel: buffer `:ab` carries peer A's values toward peer B,\\\\n    37\\\\t   `:ba` carries B's toward A. Each side's end is {:reader r :writer\\\\n    38\\\\t   w}: A reads ba and writes ab; B's mirror reads ab and writes ba.\\\\\\\"\\\\n    39\\\\t  []\\\\n    40\\\\t  (let [ab (ring 64)\\\\n    41\\\\t        ba (ring 64)\\\\n    42\\\\t        cd {:dao.stream/type :dao.stream.test/channel\\\\n    43\\\\t            :dao.stream/identity \\\\\\\"toy-channel\\\\\\\"}]\\\\n    44\\\\t    {:channel cd\\\\n    45\\\\t     :ab ab\\\\n    46\\\\t     :ba ba\\\\n    47\\\\t     :a-end {:reader ba :writer ab}\\\\n    48\\\\t     :b-end {:reader ab :writer ba}}))\\\\n    49\\\\t\\\\n    50\\\\t\\\\n    51\\\\t(defn- entry\\\\n    52\\\\t  \\\\\\\"One table entry: the handle and its declared surface.\\\\\\\"\\\\n    53\\\\t  [h surface]\\\\n    54\\\\t  {:handle h :surface surface})\\\\n    55\\\\t\\\\n    56\\\\t\\\\n    57\\\\t(defn- served-peer\\\\n    58\\\\t  \\\\\\\"Peer B: an atom of the table it serves plus its side of the toy,\\\\n    59\\\\t   with the mirror step's own cursor held in an atom.\\\\\\\"\\\\n    60\\\\t  [table t]\\\\n    61\\\\t  {:table (atom table)\\\\n    62\\\\t   :b-reader (:reader (:b-end t))\\\\n    63\\\\t   :b-writer (:writer (:b-end t))\\\\n    64\\\\t   :mirror (atom (:dao.stream/cursor\\\\n    65\\\\t                   (stream/cursor (:reader (:b-end t))\\\\n    66\\\\t                                  :dao.stream/oldest)))})\\\\n    67\\\\t\\\\n    68\\\\t\\\\n    69\\\\t(defn- serve!\\\\n    70\\\\t  \\\\\\\"One mirror step over everything pending on the toy's request\\\\n    71\\\\t   buffer.\\\\\\\"\\\\n    72\\\\t  [peer]\\\\n    73\\\\t  (swap! (:mirror peer)\\\\n    74\\\\t         #(remote/mirror-step @(:table peer) (:b-reader peer)\\\\n    75\\\\t                              % (:b-writer peer))))\\\\n    76\\\\t\\\\n    77\\\\t\\\\n    78\\\\t(defn- attach\\\\n    79\\\\t  \\\\\\\"Attach one reflection for `identity` through `end`, a channel end\\\\n    80\\\\t   {:reader r :writer w}, with the attacher's composition data `opts`.\\\\n    81\\\\t   One call builds one attacher, so one call per toy makes one link.\\\\\\\"\\\\n    82\\\\t  [end identity opts]\\\\n    83\\\\t  (let [cd {:dao.stream/type :dao.stream.test/channel\\\\n    84\\\\t            :dao.stream/identity \\\\\\\"toy-channel\\\\\\\"}\\\\n    85\\\\t        attach! (remote/attacher\\\\n    86\\\\t                  (merge {:dao.stream.remote/channels {cd end}} opts))]\\\\n    87\\\\t    (attach! {:dao.stream/type :dao.stream/remote\\\\n    88\\\\t              :dao.stream/identity identity\\\\n    89\\\\t              :dao.stream/channel cd})))\\\\n    90\\\\t\\\\n    91\\\\t\\\\n    92\\\\t(defn- values\\\\n    93\\\\t  \\\\\\\"Every retained value of `h`, oldest first, by a fresh cursor walk.\\\\\\\"\\\\n    94\\\\t  [h]\\\\n    95\\\\t  (loop [c (:dao.stream/cursor (stream/cursor h :dao.stream/oldest))\\\\n    96\\\\t         acc []]\\\\n    97\\\\t    (let [r (stream/next h c)]\\\\n    98\\\\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\\\\n    99\\\\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\\\\n   100\\\\t        acc))))\\\\n   101\\\\t\\\\n   102\\\\t\\\\n   103\\\\t(defn- wire-requests\\\\n   104\\\\t  \\\\\\\"The request values currently retained on wire buffer `h`, oldest\\\\n   105\\\\t   first.\\\\\\\"\\\\n   106\\\\t  [h]\\\\n   107\\\\t  (filter #(and (map? %) (contains? % :dao.stream.remote/op))\\\\n   108\\\\t          (values h)))\\\\n   109\\\\t\\\\n   110\\\\t\\\\n   111\\\\t(defn- op-requests\\\\n   112\\\\t  \\\\\\\"The retained requests on wire buffer `h` whose op is `op`. Ring\\\\n   113\\\\t   buffers retain what they carried, so counts of the wire's traffic\\\\n   114\\\\t   are per op.\\\\\\\"\\\\n   115\\\\t  [h op]\\\\n   116\\\\t  (filter #(= op (:dao.stream.remote/op %)) (wire-requests h)))\\\\n   117\\\\t\\\\n   118\\\\t\\\\n   119\\\\t(defn- capped-writer\\\\n   120\\\\t  \\\\\\\"A channel writer that carries values to `h` but refuses, with\\\\n   121\\\\t   invalid-value, any carrying a more vector: the toy's frame budget\\\\n   122\\\\t   stops at one outcome per answer.\\\\\\\"\\\\n   123\\\\t  [h]\\\\n   124\\\\t  (reify stream/IDaoStreamWriter\\\\n   125\\\\t    (append!\\\\n   700\\\\t    (stream/append! s :v1)\\\\n   701\\\\t    (let [peer (served-peer {\\\\\\\"x\\\\\\\" (entry s #{:reader :writer})} t)\\\\n   702\\\\t          r (:dao.stream/handle\\\\n   703\\\\t              (attach (:a-end t) \\\\\\\"x\\\\\\\"\\\\n   704\\\\t                      {:dao.stream.remote/events events\\\\n   705\\\\t                       :dao.stream.remote/budget 2}))]\\\\n   706\\\\t      (serve! peer)\\\\n   707\\\\t      (stream/descriptor r)\\\\n   708\\\\t      (stream/cursor r :dao.stream/oldest)\\\\n   709\\\\t      (serve! peer)\\\\n   710\\\\t      (let [c0 (:dao.stream/cursor (stream/cursor r :dao.stream/oldest))]\\\\n   711\\\\t        (stream/next r c0)\\\\n   712\\\\t        (serve! peer)\\\\n   713\\\\t        (let [v1 (stream/next r c0)\\\\n   714\\\\t              c1 (:dao.stream/cursor v1)\\\\n   715\\\\t              wr (stream/append! r :w2)\\\\n   716\\\\t              sent (last (wire-requests (:ab t)))]\\\\n   717\\\\t          (is (= :dao.stream/ok (:dao.stream/outcome wr))\\\\n   718\\\\t              \\\\\\\"acceptance on the outbound path\\\\\\\")\\\\n   719\\\\t          (stream/close! (:ab t))\\\\n   720\\\\t          (stream/close! (:ba t))\\\\n   721\\\\t          (testing \\\\\\\"the end observation runs the channel-loss path\\\\\\\"\\\\n   722\\\\t            (is (= :dao.stream/blocked\\\\n   723\\\\t                   (:dao.stream/outcome (stream/next r c1)))\\\\n   724\\\\t                \\\\\\\"a filed answer is still returned\\\\\\\")\\\\n   725\\\\t            (is (= {:dao.stream.remote/event\\\\n   726\\\\t                    :dao.stream.remote/append-unknown\\\\n   727\\\\t                    :dao.stream.remote/id\\\\n   728\\\\t                    (:dao.stream.remote/id sent)}\\\\n   729\\\\t                   (last (values events)))\\\\n   730\\\\t                \\\\\\\"the abandoned append! is reported append-unknown\\\\\\\"))\\\\n   731\\\\t          (testing \\\\\\\"later cursor and next are channel-gone, not\\\\n   732\\\\t                    retryable\\\\\\\"\\\\n   733\\\\t            (let [ans (stream/next r c1)]\\\\n   734\\\\t              (is (= :dao.stream/transport-error\\\\n   735\\\\t                     (:dao.stream/outcome ans)))\\\\n   736\\\\t              (is (= :dao.stream.remote/channel-gone\\\\n   737\\\\t                     (:dao.stream.remote/reason ans)))\\\\n   738\\\\t              (is (not (contains? ans :dao.stream/retry?))))\\\\n   739\\\\t            (is (= :dao.stream/transport-error\\\\n   740\\\\t                   (:dao.stream/outcome (stream/cursor r c0)))))\\\\n   741\\\\t          (testing \\\\\\\"append! keeps answering the writer's own outcome\\\\\\\"\\\\n   742\\\\t            (is (= :dao.stream/closed\\\\n   743\\\\t                   (:dao.stream/outcome (stream/append! r :w3))))))))))\\\\n   744\\\\t\\\\n   745\\\\t\\\\n   746\\\\t;; =============================================================================\\\\n   747\\\\t;; Refused, close, and what only the source may say\\\\n   748\\\\t;; =============================================================================\\\\n   749\\\\t\\\\n   750\\\\t(deftest refused-is-returned-verbatim-and-marks-nothing\\\\n   751\\\\t  (let [t (toy)\\\\n   752\\\\t        s (ring 8)]\\\\n   753\\\\t    (stream/append! s :v1)\\\\n   754\\\\t    (let [gate (middleware/gate\\\\n   755\\\\t                 {:dao.stream.middleware/verify\\\\n   756\\\\t                  (fn [_d _ctx req]\\\\n   757\\\\t                    (when (= :dao.stream/cursor\\\\n   758\\\\t                             (:dao.stream.remote/op req))\\\\n   759\\\\t                      :remote-test/no-cursor))\\\\n   760\\\\t                  :dao.stream.middleware/decision (ring 1)})\\\\n   761\\\\t          gated (middleware/wrap s [gate])\\\\n   762\\\\t          peer (served-peer {\\\\\\\"x\\\\\\\" (entry gated #{:reader})} t)\\\\n   763\\\\t          r (:dao.stream/handle (attach (:a-end t) \\\\\\\"x\\\\\\\" {}))\\\\n   764\\\\t          c0 (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))]\\\\n   765\\\\t      (serve! peer)\\\\n   766\\\\t      (stream/descriptor r)\\\\n   767\\\\t      (is (= :dao.stream/transport-error\\\\n   768\\\\t             (:dao.stream/outcome (stream/cursor r :dao.stream/oldest))))\\\\n   769\\\\t      (serve! peer)\\\\n   770\\\\t      (testing \\\\\\\"the source's refusal comes back verbatim\\\\\\\"\\\\n   771\\\\t        (is (= {:dao.stream/outcome :dao.stream/refused\\\\n   772\\\\t                :dao.stream.middleware/reason :remote-test/no-cursor}\\\\n   773\\\\t               (stream/cursor r :dao.stream/oldest))))\\\\n   774\\\\t      (testing \\\\\\\"refusal is per operation: nothing was marked\\\\\\\"\\\\n   775\\\\t        (is (= :dao.stream/blocked\\\\n   776\\\\t               (:dao.stream/outcome (stream/next r c0))))\\\\n   777\\\\t        (serve! peer)\\\\n   778\\\\t        (let [ans (stream/next r c0)]\\\\n   779\\\\t          (is (= :dao.stream/ok (:dao.stream/outcome ans)))\\\\n   780\\\\t          (is (= :v1 (:dao.stream/value ans))))))))\\\\n   781\\\\t\\\\n   782\\\\t\\\\n   783\\\\t(deftest close-semantics\\\\n   784\\\\t  (testing \\\\\\\"outstanding ids are forgotten; nothing crosses the wire\\\\\\\"\\\\n   785\\\\t    (let [t (toy)\\\\n   786\\\\t          s (ring 8)]\\\\n   787\\\\t      (stream/append! s \\\\\\\"hello\\\\\\\")\\\\n   788\\\\t      (let [peer (served-peer {\\\\\\\"str-1\\\\\\\" (entry s #{:reader})} t)\\\\n   789\\\\t            r (:dao.stream/handle (attach (:a-end t) \\\\\\\"str-1\\\\\\\" {}))]\\\\n   790\\\\t        (serve! peer)\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba docs/design/dao.stream.remote.md | sed -n '245,320p'; nl -ba src/cljc/dao/stream/remote.cljc | sed -n '304,324p;505,545p'; rg -n \\\\\\\\\\\\\\\"close.*probe|probe.*close|full-then-forward-writer|shared.*link|two.*reflect\\\\\\\\\\\\\\\" test/dao/stream/remote_test.cljc\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba docs/design/dao.stream.remote.md | sed -n '245,320p'; nl -ba src/cljc/dao/stream/remote.cljc | sed -n '304,324p;505,545p'; rg -n \\\\\\\\\\\\\\\"close.*probe|probe.*close|full-then-forward-writer|shared.*link|two.*reflect\\\\\\\\\\\\\\\" test/dao/stream/remote_test.cljc\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"   245\\\\t- `next` `c`: a filed answer for `c` is returned and forgotten. Otherwise a\\\\n   246\\\\t  `next` request for `c` is sent if none is outstanding, and the answer is\\\\n   247\\\\t  `blocked`: nothing is observable at this position through this handle\\\\n   248\\\\t  yet.\\\\n   249\\\\t- `append!` `v`: send the request and return the channel writer's outcome.\\\\n   250\\\\t  `ok` is acceptance on the outbound path, exactly `dao.stream.md`\\\\n   251\\\\t  Writing's rule for a transport that carries values toward a stream\\\\n   252\\\\t  elsewhere. The source's outcome is appended to the event writer when it\\\\n   253\\\\t  is filed, correlated by id; without an event writer it is dropped.\\\\n   254\\\\t- `close!`: local. The reflection forgets its outstanding ids; afterwards\\\\n   255\\\\t  `append!` answers `closed`, `cursor` answers `closed`, `next` answers\\\\n   256\\\\t  filed outcomes then `end`. Nothing crosses the wire.\\\\n   257\\\\t\\\\n   258\\\\t**Protocol errors at the reflection.** A filed `not-found` marks the\\\\n   259\\\\treflection gone; once gone, every later `cursor`, `next` and `append!`\\\\n   260\\\\tanswers `transport-error` with\\\\n   261\\\\t`:dao.stream.remote/reason :dao.stream.remote/not-found`, while\\\\n   262\\\\t`descriptor` still answers `ok`: a name outlives what it named. A filed\\\\n   263\\\\t`no-surface` or `oversize` marks nothing; each is returned, for the\\\\n   264\\\\toperation that caused it, as `transport-error` with\\\\n   265\\\\t`:dao.stream.remote/reason` set to the error's name. A reflection marked\\\\n   266\\\\tgone is how a remote holder observes reclaim (section 6). A request send\\\\n   267\\\\tthe channel writer refuses with `full` (establishment, back pressure)\\\\n   268\\\\tleaves the request unsent and the operation answers as though unanswered:\\\\n   269\\\\tthe retry cases above, `blocked` for `next`.\\\\n   270\\\\t\\\\n   271\\\\t**Channel loss.** A channel ends when its reader answers `end`: the\\\\n   272\\\\tprojection closed it (3.1), the pair adapter closed it on an `in` gap or\\\\n   273\\\\tend (3.3), or the medium is gone. The link then abandons its outstanding\\\\n   274\\\\tids and reports each\\\\n   275\\\\tabandoned `append!` on the event writer as `append-unknown` (2.5), and\\\\n   276\\\\tanswers later `cursor` and `next` `transport-error` with\\\\n   277\\\\t`:dao.stream.remote/reason :dao.stream.remote/channel-gone`, not retryable;\\\\n   278\\\\t`append!` keeps answering the channel writer's own outcome, `closed` once\\\\n   279\\\\tthe channel is down. Filed answers are still returned. Reattachment is the\\\\n   280\\\\tcaller's policy, by `attach!` on the same descriptor.\\\\n   281\\\\t\\\\n   282\\\\t**Refused.** A filed `:dao.stream/refused` is returned verbatim for the\\\\n   283\\\\toperation it answers and marks nothing: refusal is per operation\\\\n   284\\\\t(`dao.stream.md`, Result Convention).\\\\n   285\\\\t\\\\n   286\\\\t**Declared nature.** A reflection declares the surface its remote\\\\n   287\\\\tdescriptor's source declares plus `:closable`, learned from the attach\\\\n   288\\\\tprobe's answer (2.1); before that answer it declares\\\\n   289\\\\t`#{:reader :writer :closable}`, and an operation the source turns out to\\\\n   290\\\\tlack is answered as the `no-surface` case above. Its `blocked` is\\\\n   291\\\\thandle-relative, as the contract's Concurrency section already makes every\\\\n   292\\\\toutcome: one perspective at one moment. Its excluded outcomes: `next` never\\\\n   293\\\\tanswers `cursor-mismatch` or `invalid-cursor` from its own judgement, only\\\\n   294\\\\trelayed, and `append!` never answers the source's `full`, which arrives on\\\\n   295\\\\tthe event writer.\\\\n   296\\\\t\\\\n   297\\\\t### 2.5 Loss and resend\\\\n   298\\\\t\\\\n   299\\\\tThe reflection reads no clock. A link's `:dao.stream.remote/resend-after k`\\\\n   300\\\\tmeans: an outstanding `descriptor`, `cursor` or `next` request is re-sent\\\\n   301\\\\twhen the caller has asked `k` further times and it is still unanswered.\\\\n   302\\\\t`k` is unbounded on an ordered reliable channel and small on UDP. Those\\\\n   303\\\\tthree operations are idempotent, so a duplicate request recomputes the same\\\\n   304\\\\tor a later, equally true answer. `append!` is never re-sent:\\\\n   305\\\\tdeduplication and correlation are the payload's (OD-2, accepted), and an\\\\n   306\\\\tappend whose answer never arrives has unknown effect, reported on the\\\\n   307\\\\tevent writer as `{:dao.stream.remote/event :dao.stream.remote/append-unknown\\\\n   308\\\\t:dao.stream.remote/id n}` when the reflection is closed or the channel ends.\\\\n   309\\\\tThere are no sessions, no acknowledgement vectors, no windows and no result\\\\n   310\\\\tretention at the answering peer: the cursor is the sequence number for\\\\n   311\\\\treads, and `gap` remains the source's declaration, never a channel artifact.\\\\n   312\\\\t\\\\n   313\\\\t## 3. Channels\\\\n   314\\\\t\\\\n   315\\\\tA channel declares a portable value domain, a frame budget, and whether it\\\\n   316\\\\tis ordered and reliable; the link reads the last as composition data for\\\\n   317\\\\t`:dao.stream.remote/resend-after`, and nothing else in section 2 changes\\\\n   318\\\\tper channel.\\\\n   319\\\\t\\\\n   320\\\\t### 3.1 WebSocket\\\\n   304\\\\t(defn- count-ask!\\\\n   305\\\\t  \\\\\\\"Count one further ask of the outstanding request `id`; on reaching\\\\n   306\\\\t   the link's resend-after k, re-send it once -- the same id, a\\\\n   307\\\\t   duplicate of an idempotent operation, which recomputes the same or a\\\\n   308\\\\t   later, equally true answer -- and start counting afresh. append! is\\\\n   309\\\\t   never re-sent: it never stays outstanding beyond its send.\\\\\\\"\\\\n   310\\\\t  [link id]\\\\n   311\\\\t  (when-some [entry (get (:outstanding @link) id)]\\\\n   312\\\\t    (let [k (:resend-after @link)\\\\n   313\\\\t          asks (inc (:asks entry))]\\\\n   314\\\\t      (swap! link assoc-in [:outstanding id :asks] asks)\\\\n   315\\\\t      (when (and (integer? k) (pos? k) (<= k asks))\\\\n   316\\\\t        (stream/append! (:writer @link) (:req entry))\\\\n   317\\\\t        (swap! link assoc-in [:outstanding id :asks] 0)))))\\\\n   318\\\\t\\\\n   319\\\\t\\\\n   320\\\\t(defn- outstanding-for\\\\n   321\\\\t  \\\\\\\"The id of the link's outstanding request for `op` with `arg` sent by\\\\n   322\\\\t   `refl`, if any; the request each outstanding id was sent for makes\\\\n   323\\\\t   the correlation.\\\\\\\"\\\\n   324\\\\t  [link refl op arg]\\\\n   505\\\\t(defn- refl-descriptor\\\\n   506\\\\t  \\\\\\\"Local: ok with the remote descriptor the reflection was attached\\\\n   507\\\\t   with and the identity -- the same identity as the source's own\\\\n   508\\\\t   descriptor, different reachability. A name outlives what it named:\\\\n   509\\\\t   descriptor still answers ok once gone, once closed, and after\\\\n   510\\\\t   channel loss.\\\\\\\"\\\\n   511\\\\t  [refl]\\\\n   512\\\\t  (drain! (:link @refl))\\\\n   513\\\\t  {:dao.stream/outcome :dao.stream/ok\\\\n   514\\\\t   :dao.stream/descriptor (:descriptor @refl)\\\\n   515\\\\t   :dao.stream/identity (:identity @refl)})\\\\n   516\\\\t\\\\n   517\\\\t\\\\n   518\\\\t(defn- surface-lacks?\\\\n   519\\\\t  \\\\\\\"True when the source's declared surface is learned and lacks the\\\\n   520\\\\t   surface `op` needs. Before the probe's answer the reflection\\\\n   521\\\\t   declares #{:reader :writer :closable}, so every operation is\\\\n   522\\\\t   attempted; an operation the source turns out to lack is answered as\\\\n   523\\\\t   the no-surface case.\\\\\\\"\\\\n   524\\\\t  [refl op]\\\\n   525\\\\t  (let [s (:surface @refl)]\\\\n   526\\\\t    (and (some? s) (not (contains? s (required-surface op))))))\\\\n   527\\\\t\\\\n   528\\\\t\\\\n   529\\\\t(defn- filed-answer-outcome\\\\n   530\\\\t  \\\\\\\"The outcome a filed answer yields: a protocol error translated per\\\\n   531\\\\t   the rules, otherwise the source's outcome map verbatim.\\\\\\\"\\\\n   532\\\\t  [ans]\\\\n   533\\\\t  (or (some-> (:dao.stream.remote/error ans) translated)\\\\n   534\\\\t      (bare-outcome ans)))\\\\n   535\\\\t\\\\n   536\\\\t\\\\n   537\\\\t(defn- filed-cursor\\\\n   538\\\\t  \\\\\\\"A filed answer for anchor `a` sent by `refl`, returned without\\\\n   539\\\\t   being forgotten: minting is idempotent, so the answer stays as true\\\\n   540\\\\t   as when it was minted.\\\\\\\"\\\\n   541\\\\t  [link refl a]\\\\n   542\\\\t  (when-some [[_ entry] (filed-for link refl :dao.stream/cursor a)]\\\\n   543\\\\t    (filed-answer-outcome (:ans entry))))\\\\n   544\\\\t\\\\n   545\\\\t\\\\n149:(defn- full-then-forward-writer\\\\n593:               :writer (full-then-forward-writer (:ab t) 4)}\\\\n621:             :writer (full-then-forward-writer (:ab t) 2)}\\\\n1153:              \\\\\\\"the shared link files each answer for its own\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_10\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"I found a close seam: `refl-close` drains before removing its pending probe, so a recovered writer can accept that probe during `close!`. I’m checking whether this is a contract violation and whether the same drain can also advance probes belonging to other reflections.\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_11\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba test/dao/stream/remote_test.cljc | sed -n '145,170p'; rg -n \\\\\\\\\\\\\\\"retry-pending\\\\\\\"'!|:pending\\\\\\\" src/cljc/dao/stream/remote.cljc'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_11\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba test/dao/stream/remote_test.cljc | sed -n '145,170p'; rg -n \\\\\\\\\\\\\\\"retry-pending\\\\\\\"'!|:pending\\\\\\\" src/cljc/dao/stream/remote.cljc'\\\",\\\"aggregated_output\\\":\\\"   145\\\\t            {:dao.stream/outcome :dao.stream/ok}\\\\n   146\\\\t            (stream/append! h v)))))))\\\\n   147\\\\t\\\\n   148\\\\t\\\\n   149\\\\t(defn- full-then-forward-writer\\\\n   150\\\\t  \\\\\\\"A channel writer that refuses, with full, the first `n` appends and\\\\n   151\\\\t   carries every later one to `h`: the toy's back pressure, transient\\\\n   152\\\\t   and then recovered.\\\\\\\"\\\\n   153\\\\t  [h n]\\\\n   154\\\\t  (let [left (atom n)]\\\\n   155\\\\t    (reify stream/IDaoStreamWriter\\\\n   156\\\\t      (append!\\\\n   157\\\\t        [_ v]\\\\n   158\\\\t        (if (pos? @left)\\\\n   159\\\\t          (do (swap! left dec)\\\\n   160\\\\t              {:dao.stream/outcome :dao.stream/full})\\\\n   161\\\\t          (str