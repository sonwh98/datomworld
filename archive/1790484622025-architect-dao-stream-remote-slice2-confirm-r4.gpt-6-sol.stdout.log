riter (:ab t) 2)}\n622-        r (:dao.stream/handle\n623-            (attach end \"str-1\" {:dao.stream.remote/events events}))]\n624-    (testing \"the attach's refused probe is kept on the link, unsent\"\n625-      (is (= :dao.stream/ok\n626-             (:dao.stream/outcome (stream/descriptor r)))\n627-          \"attach answers ok at once\")\n628-      ;; the descriptor's drain retried the kept probe once: refused\n629-      ;; again, and kept for the next drain\n630-      (is (empty? (op-requests (:ab t) :dao.stream/descriptor))\n631-          \"both sends were refused; the probe is not lost\")\n632-      (is (empty? (values events))\n633-          \"no answer, so no confirmation event\"))\n634-    (testing \"a later drain retries the kept probe, once\"\n635-      (is (= :dao.stream/ok\n636-             (:dao.stream/outcome (stream/descriptor r))))\n637-      (is (= 1 (count (op-requests (:ab t) :dao.stream/descriptor)))\n638-          \"the writer has recovered: the one retry crossed and is the\n639-           outstanding probe now\"))\n640-    (serve! peer)\n641-    (testing \"the kept probe's answer confirms the normal way\"\n642-      (is (= :dao.stream/ok\n643-             (:dao.stream/outcome (stream/descriptor r)))\n644-          \"the drain that reads the answer\")\n645-      (let [evs (values events)]\n646-        (is (= 1 (count evs)))\n647-        (is (= \"str-1\" (:dao.stream/identity (first evs))))\n648-        (is (= :dao.stream/ok (:dao.stream/outcome (first evs))))\n649-        (is (= #{:reader}\n650-               (:dao.stream.remote/surface (first evs)))\n651-            \"the confirmation event carries the declared surface\")))\n652-    (testing \"close! after the refusal sends no probe at all\"\n653-      ;; the writer refuses the attach send, then ACCEPTS: under the old\n654-      ;; ordering (drain before forget) close!'s own drain would re-send\n655-      ;; the kept probe and it would cross; under the fix it is\n656-      ;; forgotten before the drain and never crosses\n657-      (let [t2 (toy)\n658-            events2 (ring 16)\n659-            peer2 (served-peer {\"str-2\" (entry (ring 8) #{:reader})} t2)\n660-            r2 (:dao.stream/handle\n661-                 (attach {:reader (:ba t2)\n662:                          :writer (full-then-forward-writer (:ab t2) 2)}\n663-                         \"str-2\"\n664-                         {:dao.stream.remote/events events2}))]\n665-        (stream/descriptor r2)\n666-        (is (empty? (op-requests (:ab t2) :dao.stream/descriptor))\n667-            \"the attach send and the descriptor drain's one retry were\n668-             both refused; the probe is kept, not sent\")\n669-        (stream/close! r2)\n670-        (is (empty? (op-requests (:ab t2) :dao.stream/descriptor))\n671-            \"close! is local: its drain does not send the kept probe,\n672-             even though the writer now accepts\")))\n673-    (testing \"the learned surface answers no-surface locally\"\n674-      (let [before (count (wire-requests (:ab t)))\n675-            ans (stream/append! r :x)]\n676-        (is (= :dao.stream/transport-error (:dao.stream/outcome ans)))\n677-        (is (= :dao.stream.remote/no-surface\n678-               (:dao.stream.remote/reason ans))\n679-            \"answered from the surface the probe's answer taught\")\n680-        (is (= before (count (wire-requests (:ab t))))\n681-            \"nothing crossed\")))))\n682-\n683-\n684-(deftest resend-after-resends-an-unanswered-request\n685-  (let [t (toy)\n686-        s (ring 8)]\n687-    (stream/append! s \"hello\")\n688-    (let [peer (served-peer {\"str-1\" (entry s #{:reader})} t)\n689-          end {:reader (:ba t)\n690-               :writer (dropping-writer (:ab t) 1\n691-                                        #{:dao.stream/cursor})}\n692-          r (:dao.stream/handle\n693-              (attach end \"str-1\" {:dao.stream.remote/resend-after 2}))]\n694-      (serve! peer)\n695-      (is (= :dao.stream/ok\n696-             (:dao.stream/outcome (stream/descriptor r)))\n697-          \"the probe crossed; only cursor requests are dropped\")\n698-      (is (= :dao.stream/transport-error\n699-             (:dao.stream/outcome (stream/cursor r :dao.stream/oldest)))\n700-          \"sent, and dropped by the channel\")\n701-      (is (= :dao.stream/transport-error\n702-             (:dao.stream/outcome (stream/cursor r :dao.stream/oldest)))\n703-          \"one further ask, still unanswered\")\n704-      (is (empty? (op-requests (:ab t) :dao.stream/cursor))\n705-          \"the drop swallowed it\")\n706-      (is (= :dao.stream/transport-error\n707-             (:dao.stream/outcome (stream/cursor r :dao.stream/oldest)))\n708-          \"the second further ask re-sends the same request\")\n709-      (is (= 1 (count (op-requests (:ab t) :dao.stream/cursor)))\n710-          \"the duplicate crossed\")\n711-      (serve! peer)\n712-      (let [ans (stream/cursor r :dao.stream/oldest)]\n713-        (is (= (stream/cursor s :dao.stream/oldest) ans)\n714-            \"the duplicate recomputed the same, equally true answer\")))))\n715-\n716-\n717-(deftest channel-loss\n718-  (let [t (toy)\n719-        s (ring 8)\n720-        events (ring 16)]\n721-    (stream/append! s :v1)\n722-    (let [peer (served-peer {\"x\" (entry s #{:reader :writer})} t)\n723-          r (:dao.stream/handle\n724-              (attach (:a-end t) \"x\"\n725-                      {:dao.stream.remote/events events\n726-                       :dao.stream.remote/budget 2}))]\n727-      (serve! peer)\n728-      (stream/descriptor r)\n729-      (stream/cursor r :dao.stream/oldest)\n730-      (serve! peer)\n731-      (let [c0 (:dao.stream/cursor (stream/cursor r :dao.stream/oldest))]\n732-        (stream/next r c0)\n733-        (serve! peer)\n734-        (let [v1 (stream/next r c0)\n735-              c1 (:dao.stream/cursor v1)\n736-              wr (stream/append! r :w2)\n737-              sent (last (wire-requests (:ab t)))]\n","exit_code":0,"status":"completed"}}
