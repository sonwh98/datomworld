#!/bin/bash
# Recreated keep-awake script
PID=$1
TIMEOUT=$2

if [ "$EUID" -ne 0 ]; then
  echo "Please run as root"
  exit 1
fi

# Restore sleep on any exit path, including Ctrl+C and kill: the restore at the
# bottom of this script is unreachable while the sleep loop below is running.
BG_PID=
restore_sleep() {
  [ -n "$BG_PID" ] && kill "$BG_PID" 2>/dev/null
  pmset -a disablesleep 0
}
trap restore_sleep EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Bash defers a trap while a foreground command runs, so a signal sent to this
# script alone would wait out the whole sleep. Run the command in the
# background and `wait` on it: `wait` is interrupted by a trapped signal.
hold() { "$@" & BG_PID=$!; wait "$BG_PID"; }

echo "Keeping system awake..."
# Prevent sleep even when lid is closed
pmset -a disablesleep 1

# If PID is provided, we can use caffeinate to monitor it
if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
  echo "Monitoring PID $PID..."
  hold caffeinate -i -s -d -w "$PID"
else
  # Otherwise just sleep for the duration (if provided) or forever
  if [ -n "$TIMEOUT" ]; then
    hold sleep $((TIMEOUT * 3600)) # Assuming timeout is in hours
  else
    # Infinite loop to keep process alive so user can Ctrl+C it
    while true; do hold sleep 3600; done
  fi
fi
