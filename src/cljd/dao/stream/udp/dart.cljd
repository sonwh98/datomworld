(ns dao.stream.udp.dart
  "The dart:io host edge for dao.stream.udp: one RawDatagramSocket,
   bound once, whose event stream feeds every datagram's source
   address and raw bytes to a composed `receive-fn`
   (dao.stream.udp/receive!, partially applied over the port), and the
   :send! seam dao.stream.udp/make-port composes over. All protocol
   logic -- fragmentation, reassembly, the deposit shape -- stays in
   dao.stream.udp; this adapter only owns the socket."
  (:require ["dart:async" :as async]
            ["dart:io" :as io]))


(defn bind!
  "Bind a RawDatagramSocket at `port` (0 for an ephemeral port).
   Returns a Future of {:socket s :local-port p :send! f :close! f}."
  ([receive-fn] (bind! receive-fn 0))
  ([receive-fn port]
   (-> ^async/Future (io/RawDatagramSocket.bind "0.0.0.0" port)
       (.then
         (fn [socket]
           (let [socket ^io/RawDatagramSocket socket]
             (.listen socket
                      (fn [event]
                        (when (= event io/RawSocketEvent.read)
                          (when-some [^io/Datagram datagram
                                      (.receive socket)]
                            (receive-fn
                              (.-address ^io/InternetAddress
                               (.-address datagram))
                              (.-port datagram)
                              (.-data datagram))))))
             {:socket socket
              :local-port (.-port socket)
              :send! (fn [host dest-port bytes]
                       (.send socket bytes (io/InternetAddress. host)
                              dest-port)
                       nil)
              :close! (fn [] (.close socket) nil)}))))))
