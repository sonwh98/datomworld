(ns datomworld.demo.artifact
  (:require ["dart:async" :as async]
            ["dart:core" :as core]
            ["package:flutter/material.dart" :as m]
            [dao.gui.event :as event]
            [dao.postgraphics.flutter :as pg]
            [dao.stream :as stream]
            [dao.stream.ringbuffer :as rb]
            [datomworld.demo.artifact-runner :as runner]
            [datomworld.demo.artifact-scene :as scene]))


(def ^:private frame-stream
  (:dao.stream/handle (rb/create! {:dao.stream/type rb/transport-type,
                                   rb/capacity-key 4})))


(def ^:private scene-state (atom runner/initial-state))
(def ^:private timer-stop* (atom nil))


(def ^:private runtime-input-stream* (atom nil))


(def ^:private event-binding* (atom nil))
(def ^:private output-streams* (atom nil))
(def ^:private output-cursors* (atom {}))
(def ^:private runtime-seq* (atom 0))
(def ^:private pointer-seq* (atom -1))
(def ^:private runtime-time* (atom -1))


(defn- ring-stream
  "A v2 evict-oldest ring buffer handle."
  [capacity]
  (:dao.stream/handle
    (rb/create! {:dao.stream/type rb/transport-type,
                 rb/capacity-key capacity})))


(defn- open-runtime-input-stream
  []
  (ring-stream 1024))


(def ^:private ids*
  (atom {:generation-id 1, :frame-id 1, :coordinate-space-id 1, :profile-id 1}))


(def ^:private viewport* (atom [800.0 600.0]))


(def ^:private signal-stream
  ;; evict-oldest is the only v2 ring buffer; nothing reads this lane in a
  ;; tight loop, so eviction over refusal changes nothing observable
  (ring-stream 32))


(def ^:private active-pointers* (atom #{}))


(def ^:private output-keys
  [:effects :trace :pointer :keyboard :gesture :dispatch :diagnostic])


(defn- open-output-streams
  []
  (zipmap output-keys (map (fn [_k] (ring-stream 64)) output-keys)))


(defn- advance!
  []
  (when-let [binding @event-binding*]
    (let [result (runner/advance-until-progress binding 64)]
      (reset! event-binding* (:binding result))
      (doseq [[k out] @output-streams*]
        (loop [cursor (get @output-cursors* k)]
          (let [read (stream/next out cursor)]
            (let [outcome (:dao.stream/outcome read)]
              (cond
                (= :dao.stream/ok outcome)
                (do (when (= k :gesture)
                      (swap! scene-state
                             runner/reduce-gesture
                             (:dao.stream/value read)))
                    (recur (:dao.stream/cursor read)))
                ;; an evicted output position: resume from the recovery
                ;; cursor the gap outcome carried
                (= :dao.stream/gap outcome)
                (do (prn "dao.stream output gap; resuming" k)
                    (swap! output-cursors*
                           assoc
                           k
                           (:dao.stream/cursor read)))
                ;; blocked, end, and terminal outcomes park the cursor
                :else (swap! output-cursors* assoc k cursor)))))))))


(defn- append-runtime!
  [value]
  (when-let [input @runtime-input-stream*]
    (let [seq (inc @runtime-seq*)
          requested-time (or (:runtime/time-us value) seq)
          time-us (max (inc @runtime-time*) (long requested-time))
          envelope (assoc value
                          :runtime/seq seq
                          :runtime/time-us time-us)]
      (when (= :dao.stream/ok (:dao.stream/outcome
                                (stream/append! input envelope)))
        (reset! runtime-seq* seq)
        (reset! runtime-time* time-us)
        (advance!)))))


(defn- boot-events!
  []
  (let [input-stream (open-runtime-input-stream)
        outputs (open-output-streams)
        [width height] @viewport*
        ids (reset! ids* {:generation-id 1,
                          :frame-id 1,
                          :coordinate-space-id 1,
                          :profile-id 1})]
    (reset! runtime-input-stream* input-stream)
    (reset! output-streams* outputs)
    ;; mint one origin cursor per output over the empty stream, so an
    ;; eviction between advances is a reported gap, never a silent skip
    (reset! output-cursors*
            (into {} (map (fn [[k out]]
                            [k (:dao.stream/cursor
                                 (stream/cursor out stream/anchor-oldest))]))
                  outputs))
    (reset! runtime-seq* 0)
    (reset! pointer-seq* -1)
    (reset! runtime-time* -1)
    (reset! active-pointers* #{})
    (reset! event-binding* (event/bind {:inputs {:runtime-input input-stream},
                                        :outputs outputs}))
    (doseq [value (runner/boot-values {:generation-id (:generation-id ids),
                                       :frame-id (:frame-id ids),
                                       :coordinate-space-id (:coordinate-space-id ids),
                                       :profile-id (:profile-id ids),
                                       :width width,
                                       :height height})]
      (append-runtime! value))))


(defn- resize!
  [size]
  (when (not= size @viewport*)
    (reset! viewport* size)
    (when @event-binding*
      (let [old-space-id (:coordinate-space-id @ids*)
            ids (swap! ids* (fn [ids]
                              (-> ids
                                  (update :frame-id inc)
                                  (update :coordinate-space-id inc))))
            [width height] size]
        (doseq [value [{:runtime/source :terminal,
                        :runtime/value
                        {:message/kind :dao.terminal/coordinate-space-change,
                         :generation-id (:generation-id ids),
                         :old-coordinate-space-id old-space-id,
                         :coordinate-space-id (:coordinate-space-id ids),
                         :viewport {:width width, :height height}}}
                       {:runtime/source :geometry,
                        :runtime/value (runner/presented-geometry
                                         (:generation-id ids)
                                         (:frame-id ids)
                                         (:coordinate-space-id ids)
                                         width
                                         height)}]]
          (append-runtime! value))))))


(defn- pointer-type
  [e]
  (let [kind (str (.-kind e))]
    (cond (.contains kind "touch") :touch
          (.contains kind "stylus") :stylus
          :else :mouse)))


(defn- emit-pointer!
  [phase e]
  (let [id (.-pointer e)
        active (if (= phase :up)
                 (disj @active-pointers* id)
                 (conj @active-pointers* id))
        _ (reset! active-pointers* active)
        pos (.-localPosition e)
        p-seq (swap! pointer-seq* inc)
        seq (inc @runtime-seq*)
        packet {:input/kind :pointer,
                :generation-id (:generation-id @ids*),
                :frame-id (:frame-id @ids*),
                :coordinate-space-id (:coordinate-space-id @ids*),
                :profile-id (:profile-id @ids*),
                :input-seq p-seq,
                :pointer {:id id,
                          :type (pointer-type e),
                          :primary? (= id (first (sort active))),
                          :buttons (.-buttons e),
                          :modifiers #{},
                          :pressure (.-pressure e)},
                :phase phase,
                :samples [{:time-us (.-inMicroseconds (.-timeStamp e)),
                           :position {:x (.-dx pos), :y (.-dy pos)},
                           :sample/kind :actual}]}]
    (append-runtime! (runner/pointer-runtime-input {:runtime-seq seq,
                                                    :runtime-time-us seq,
                                                    :packet packet}))))


(defn- emit-frame!
  []
  (pg/put-frame! frame-stream (scene/build-frame @scene-state @viewport*)))


(defn stop!
  []
  (when-let [stop-fn @timer-stop*]
    (stop-fn)
    (reset! timer-stop* nil))
  :stopped)


(defn dispose!
  []
  (stop!)
  (when @event-binding*
    (append-runtime! {:runtime/source :control,
                      :runtime/value {:input/kind :dao.gui.event/teardown}})
    (reset! event-binding* nil))
  (reset! runtime-input-stream* nil)
  :disposed)


(defn start!
  []
  (when-not @timer-stop*
    (boot-events!)
    (emit-frame!)
    (let [timer (async/Timer.periodic
                  (core/Duration .milliseconds 16)
                  (fn [_] (swap! scene-state runner/tick-state) (emit-frame!)))]
      (reset! timer-stop* (fn [] (.cancel timer)))))
  :started)


(defn view
  []
  (m/Scaffold .appBar
              (m/AppBar .title (m/Text "Glowing Artifact"))
              .body
              (m/LayoutBuilder
                .builder
                (fn [_context ^m/BoxConstraints constraints]
                  (let [w (.-maxWidth constraints)
                        h (min w (.-maxHeight constraints))]
                    (resize! [w h])
                    (m/Center .child
                              (m/SizedBox .width
                                          w
                                          .height
                                          h
                                          .child
                                          (m/Listener
                                            .onPointerDown
                                            (fn [e] (emit-pointer! :down e))
                                            .onPointerMove
                                            (fn [e] (emit-pointer! :move e))
                                            .onPointerUp
                                            (fn [e] (emit-pointer! :up e))
                                            .onPointerCancel
                                            (fn [e] (emit-pointer! :cancel e))
                                            .child
                                            (pg/postgraphics-widget
                                              frame-stream
                                              :signal-stream signal-stream
                                              :on-error (fn [e] (core/print e))
                                              :on-paint-error
                                              (fn [e] (core/print e)))))))))))
