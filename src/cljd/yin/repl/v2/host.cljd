(ns yin.repl.v2.host
  "ClojureDart composition of the Yin REPL v2 host seam."
  (:require [dao.stream.v2.ws.dart :as dart]))


(def missing-code :yin.repl.v2.host/no-websocket-package)


(def missing-text
  "no host WebSocket package is composed for this build")


(defn adapter?
  [x]
  (and (map? x) (fn? (:connect! x))))


(defn binder?
  [x]
  (and (map? x) (fn? (:bind! x)) (fn? (:unbind! x))))


(defn websocket
  "Return this build's real dart:io WebSocket adapter."
  []
  (dart/websocket))


(defn missing-message
  [what]
  (str what ": " missing-text))
