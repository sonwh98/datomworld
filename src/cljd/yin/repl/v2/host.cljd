(ns yin.repl.v2.host
  "ClojureDart composition of the Yin REPL v2 host seam.

   Shadows the `.cljc` namespace, so it carries only `websocket`; the portable
   contract is `yin.repl.v2.host.common`."
  (:require [dao.stream.v2.ws.dart :as dart]))


(defn websocket
  "Return this build's real dart:io WebSocket adapter."
  []
  (dart/websocket))
