(ns yin.repl.flutter
  "A reusable Flutter component to embed a DaoStream v2 Yin REPL server inside
   any application: a thin view over `yin.repl.embed`.

   One `Timer.periodic` per started server is the endpoint's only state owner.
   It alone writes the endpoint atom; `stop-server!` only asks it to stop."
  (:require ["dart:async" :as async]
            ["dart:core" :as dart-core]
            ["dart:io" :as io]
            ["package:flutter/material.dart" :as m]
            [clojure.string :as str]
            [yin.repl :as v2]
            [yin.repl.embed :as embed]))


(def device-ip (m/ValueNotifier "..."))
(def interface-addresses (m/ValueNotifier []))
(def server-status (m/ValueNotifier "starting"))


(def ^:private active-run
  "The run `start-server!` last began, or nil once `stop-server!` asked it to
   stop.  A run is `{:stop-requested (atom false)}`; it holds no endpoint."
  (atom nil))


(def default-port (if io/Platform.isIOS 7778 7777))


(defn load-device-ip!
  "Asynchronously loads the local network interfaces and populates the device-ip and interface-addresses notifiers."
  []
  (.then
    ^async/Future (io/NetworkInterface.list)
    (fn [interfaces]
      (let [found (atom nil)
            rows (atom [])]
        (doseq [iface (seq interfaces)]
          (let [ips (keep (fn [addr]
                            (let [a (.-address ^io/InternetAddress addr)]
                              (when (str/includes? a ".")
                                (when (and (nil? @found)
                                           (not (str/starts-with? a "127.")))
                                  (reset! found a))
                                a)))
                          (seq (.-addresses ^io/NetworkInterface iface)))]
            (when (seq ips)
              (swap! rows conj [(.-name ^io/NetworkInterface iface) ips]))))
        (set! (.-value ^m/ValueNotifier device-ip) (or @found "localhost"))
        (set! (.-value ^m/ValueNotifier interface-addresses) @rows)))))


(defn- set-status!
  [text]
  (set! (.-value ^m/ValueNotifier server-status) text))


(defn- run-endpoint!
  "Start the one timer that owns `endpoint` for `run`.

   While the run is active each tick steps the endpoint and shows its status.
   Once a stop is requested the timer stops the endpoint and keeps stepping it
   until `stopped?` or `stop-ticks`, then cancels itself."
  [run endpoint]
  (let [box (atom {:endpoint endpoint :stopping nil})]
    (async/Timer.periodic
      (dart-core/Duration .milliseconds v2/tick-millis)
      (fn [^async/Timer timer]
        (let [{:keys [endpoint stopping]} @box
              now (.-millisecondsSinceEpoch (dart-core/DateTime.now))
              [endpoint' lines] (embed/step endpoint now)]
          (doseq [line lines]
            (println line))
          (cond
            (and (nil? stopping) @(:stop-requested run))
            (reset! box {:endpoint (embed/stop endpoint') :stopping v2/stop-ticks})

            (nil? stopping)
            (do (reset! box {:endpoint endpoint' :stopping nil})
                (when (identical? run @active-run)
                  (set-status! (embed/status-text (embed/status endpoint')))))

            (or (embed/stopped? endpoint') (zero? stopping))
            (do (reset! box {:endpoint endpoint' :stopping 0})
                (.cancel timer)
                (when-not (embed/stopped? endpoint')
                  (println v2/stop-timeout-text))
                ;; A newer run owns the status line once it has started.
                (when (nil? @active-run)
                  (set-status! "stopped")))

            :else
            (reset! box {:endpoint endpoint' :stopping (dec stopping)}))
          nil)))))


(defn stop-server!
  "Asks the active REPL server to stop.  The server's own timer completes the
   stop and sets the status to \"stopped\"."
  []
  (when-let [run @active-run]
    (reset! (:stop-requested run) true)
    (reset! active-run nil)
    (set-status! "stopping")
    :stopped))


(defn start-server!
  "Starts the REPL server on the specified port (default: 7778 on iOS, 7777 elsewhere) and populates the device-ip and server-status notifiers.

   The device IP is loaded first so the endpoint advertises it."
  [{:keys [port extra-primitives], :or {port default-port}}]
  (stop-server!)
  (let [run {:stop-requested (atom false)}]
    (reset! active-run run)
    (set-status! "starting")
    (.then
      ^async/Future (load-device-ip!)
      (fn [_]
        (if @(:stop-requested run)
          (when (nil? @active-run)
            (set-status! "stopped"))
          (let [ip (.-value ^m/ValueNotifier device-ip)]
            (run-endpoint!
              run
              (embed/start {:port port
                            :advertised-host (if (= "..." ip) "localhost" ip)
                            :primitives (or extra-primitives {})}))))
        nil))))


(defn- mono
  ([text] (mono text 12.0))
  ([text size]
   (m/Text text .style (m/TextStyle .fontFamily "monospace" .fontSize size))))


(defn info-card
  "A Flutter Widget that displays the REPL server status and device IPs."
  [{:keys [port], :or {port default-port}}]
  (m/Card
    .child
    (m/Padding .padding
               (m/EdgeInsets.all 12.0)
               .child
               (m/Column
                 .crossAxisAlignment
                 m/CrossAxisAlignment.start
                 .children
                 [(m/Text "REPL Server Active"
                          .style
                          (m/TextStyle .fontWeight m/FontWeight.bold))
                  (m/SizedBox .height 6.0)
                  (mono (str "daostream:ws://0.0.0.0:" port "/repl"))
                  (m/SizedBox .height 2.0)
                  (m/ValueListenableBuilder
                    .valueListenable
                    device-ip
                    .builder
                    (fn [_ ip _]
                      (mono (str "daostream:ws://" ip ":" port "/repl"))))
                  (m/SizedBox .height 10.0)
                  (m/Text "Interface IPs"
                          .style
                          (m/TextStyle .fontWeight m/FontWeight.bold))
                  (m/SizedBox .height 4.0)
                  (m/ValueListenableBuilder
                    .valueListenable
                    interface-addresses
                    .builder
                    (fn [_ rows _]
                      (m/Column
                        .crossAxisAlignment
                        m/CrossAxisAlignment.start
                        .children
                        (if (seq rows)
                          (mapv (fn [[iface ips]]
                                  (mono (str iface ": " (str/join ", " ips))))
                                rows)
                          [(mono "loading...")])))) (m/SizedBox .height 6.0)
                  (m/ValueListenableBuilder
                    .valueListenable
                    server-status
                    .builder
                    (fn [_ status _] (mono (str "status: " status))))]))))
