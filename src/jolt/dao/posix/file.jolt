(ns dao.posix.file
  "Jolt-only POSIX descriptor plumbing for the jolt branch of dao.jing.file's
   file seams (J4a, collab/1792769713135-architect-j4-file-seams-design §2):
   descriptor I/O over native/jolt-file, which `bb build:jolt-native` builds.

   dao.posix.* is not the dao.host profile (src/jolt/README.md): it has no
   src/cljc counterpart, no portable entries and no refusal table, and it is
   reached only from :jolt arms, never from a :default arm. It is linkage behind
   dao.jing.file's existing seams (open-file!, file-length!, read-int!,
   read-bytes!, truncate-file!, append-frame!, sync-file!, close-file!), which
   call it from their :jolt arms. The framing, validation, recovery cut and
   replay stay in dao.jing.file; nothing here decides what a frame is or where
   to truncate.

   A handle owns one descriptor, opened read/write with close-on-exec, never
   truncated and never O_APPEND. Reads and writes are positional (pread,
   pwrite), so no seek position is shared. The read and write loops live here:
   short transfers continue, EINTR retries, and a read that meets end of file
   before its count, or a write that makes no progress, throws: no zero
   padding and no silent short frame. The frame's signed 32-bit big-endian
   length prefix is packed and unpacked by the wrapper (review F2).

   Every native buffer is caller-owned, its release established as soon as
   it is acquired (`with-native`), and every bytes argument is copied in and
   every result copied out, so no caller array is ever shared with C. Native
   entries that can wait on the disk are bound :blocking, so a collection
   does not wait for them.

   Loading this namespace is the library gate: it refuses, by throwing, when
   the wrapper is missing or answers another layout, before any file is
   touched."
  (:require
    [clojure.string :as str]
    [dao.host.text :as text]
    [jolt.ffi :as ffi]))


;; =============================================================================
;; The native library
;; =============================================================================

(def ^:private platform
  ;; as dao.host.hash decides it
  (let [os (str/lower-case (or (System/getProperty "os.name") ""))
        arch (System/getProperty "os.arch")]
    (str (if (str/includes? os "mac") "darwin" "linux") "-"
         (if (#{"aarch64" "arm64"} arch) "arm64" "x86_64"))))


(def ^:private library
  (str (System/getProperty "user.dir") "/build/native/" platform
       "/jolt-file/lib/libjolt_file"
       (if (str/starts-with? platform "darwin") ".dylib" ".so")))


(defn- refuse-load
  [message data]
  (throw (ex-info (str "jolt-file refused: " message)
                  (assoc data :library library))))


(when-not (.exists (java.io.File. ^String library))
  (refuse-load "the wrapper is not built (bb build:jolt-native)" {}))


(ffi/load-library library)
(ffi/defcfn ^:private c-layout-version "jolt_file_layout_version" [] :int32)


;; native/jolt-file/jolt_file.c JOLT_FILE_LAYOUT (3 since J4d: an older
;; library is refused here, not at the first key-file write)
(def ^:private layout 3)


(let [actual (c-layout-version)]
  (when-not (= layout actual)
    (refuse-load "the library writes another layout"
                 {:expected layout, :actual actual})))


(ffi/defcfn ^:private c-eintr "jolt_file_eintr" [] :int32)
(ffi/defcfn ^:private c-make-parents "jolt_file_make_parents"
  [:pointer :int64] :int64 :blocking)
(ffi/defcfn ^:private c-open "jolt_file_open" [:pointer :int64] :int64 :blocking)
(ffi/defcfn ^:private c-length "jolt_file_length" [:int64] :int64 :blocking)
(ffi/defcfn ^:private c-pread "jolt_file_pread"
  [:int64 :int64 :pointer :int64 :int64] :int64 :blocking)
(ffi/defcfn ^:private c-pwrite "jolt_file_pwrite"
  [:int64 :int64 :pointer :int64 :int64] :int64 :blocking)
(ffi/defcfn ^:private c-truncate "jolt_file_truncate" [:int64 :int64] :int64 :blocking)
(ffi/defcfn ^:private c-sync "jolt_file_sync" [:int64] :int64 :blocking)
(ffi/defcfn ^:private c-close "jolt_file_close" [:int64] :int64 :blocking)
(ffi/defcfn ^:private c-s32be-get "jolt_file_s32be_get" [:pointer :int64] :int32)
(ffi/defcfn ^:private c-s32be-put "jolt_file_s32be_put" [:pointer :int64 :int32] :void)
(ffi/defcfn ^:private c-strerror "jolt_file_strerror" [:int64 :pointer :int64] :int64)
;; J4b (layout 2)
(ffi/defcfn ^:private c-classify "jolt_file_classify"
  [:pointer :int64 :int32] :int64 :blocking)
(ffi/defcfn ^:private c-fclassify "jolt_file_fclassify" [:int64] :int64 :blocking)
(ffi/defcfn ^:private c-fidentity "jolt_file_fidentity" [:int64 :pointer] :int64 :blocking)
(ffi/defcfn ^:private c-open-excl "jolt_file_open_excl" [:pointer :int64] :int64 :blocking)
(ffi/defcfn ^:private c-open-read "jolt_file_open_read" [:pointer :int64] :int64 :blocking)
;; J4d (layout 3)
(ffi/defcfn ^:private c-open-private "jolt_file_open_private" [:pointer :int64] :int64 :blocking)
(ffi/defcfn ^:private c-eexist "jolt_file_eexist" [] :int32)
(ffi/defcfn ^:private c-lock "jolt_file_lock" [:int64] :int64 :blocking)
(ffi/defcfn ^:private c-realpath "jolt_file_realpath"
  [:pointer :int64 :pointer :int64] :int64 :blocking)
(ffi/defcfn ^:private c-rename "jolt_file_rename"
  [:pointer :int64 :pointer :int64] :int64 :blocking)
(ffi/defcfn ^:private c-sync-dir "jolt_file_sync_dir" [:pointer :int64] :int64 :blocking)


(def ^:private eintr (c-eintr))


;; =============================================================================
;; Native memory and errors
;; =============================================================================

(defn- with-native
  "(f p) over caller-owned native memory `p` of `n` bytes (one for an empty
   request), freed however `f` exits. The release is established before
   anything else can fail."
  [n f]
  (let [p (ffi/alloc (max 1 n))]
    ;; a null answer acquired nothing, so it is refused before the release
    ;; is established, never handed to ffi/free (J4a review R4)
    (when (ffi/null? p)
      (throw (ex-info "jolt-file native allocation failed" {:bytes n})))
    (try
      (f p)
      (finally (ffi/free p)))))


(defn- error-text
  [errno]
  (with-native 256
    (fn [buf]
      (let [n (c-strerror errno buf 256)]
        (if (pos? n) (ffi/read-bytes buf n) (str "errno " errno))))))


(defn- io-error
  "The host exception for a failed operation: the operation, the path, the
   errno this invocation answered and its text, plus any offset context."
  [handle operation errno data]
  (ex-info (str "dao.jing.file " operation " failed on " (:path handle) ": "
                (error-text errno) " (errno " errno ")")
           (merge {:operation operation, :path (:path handle), :errno errno} data)))


(defn- path-bytes!
  "The UTF-8 path bytes copied into native memory, (f p n)."
  [path f]
  (let [bs (text/utf8-encode path)
        n (alength bs)]
    (with-native n
      (fn [p]
        (when (pos? n) (ffi/write-array p bs))
        (f p n)))))


;; =============================================================================
;; Single transfers: the test seam
;; =============================================================================

;; One system call each, answering a count or -errno. The loops below call
;; them through these vars, which is the test-only indirection the J4a gate
;; redefines to inject short, EINTR, zero-progress and failing transfers.
;; There is no production fault mode.

(defn- pread-once
  [fd offset buf at n]
  (c-pread fd offset buf at n))


(defn- pwrite-once
  [fd offset buf at n]
  (c-pwrite fd offset buf at n))


(defn- fsync-once
  [fd]
  (c-sync fd))


(defn- close-once
  [fd]
  (c-close fd))


;; =============================================================================
;; The handle
;; =============================================================================

(defn- fd-of
  [handle]
  (when @(:released handle)
    (throw (ex-info (str "dao.jing.file descriptor already closed: " (:path handle))
                    {:path (:path handle)})))
  (:fd handle))


(defn open
  "Open or create the file at path for positional reading and writing,
   creating its missing parent directories (checked: a component that cannot
   be a directory fails). Never truncates. Answers the handle.

   A relative path resolves against user.dir, as java.io.File does: the jolt
   launcher runs the process from its own root and passes the caller's
   working directory as user.dir, so the process cwd is not it."
  [path]
  (let [native-path (.getAbsolutePath (java.io.File. ^String path))
        made (path-bytes! native-path c-make-parents)]
    (when (neg? made)
      (throw (io-error {:path path} "create-parents" (- made) {})))
    (let [fd (path-bytes! native-path c-open)]
      (when (neg? fd)
        (throw (io-error {:path path} "open" (- fd) {})))
      ;; :failed is the content log's fail-closed state (review F3): nil, or
      ;; the operation whose failure left the file's tail uncertain
      {:fd fd, :path path, :released (atom false), :failed (atom nil)})))


(defn length
  "The file's size by fstat."
  [handle]
  (let [n (c-length (fd-of handle))]
    (when (neg? n) (throw (io-error handle "fstat" (- n) {})))
    n))


(defn- read-into!
  "Fill buf[0, n) from file offset `offset`: short reads continue, EINTR
   retries, end of file before n bytes throws."
  [handle buf offset n]
  (let [fd (fd-of handle)]
    (loop [done 0]
      (when (< done n)
        (let [r (pread-once fd (+ offset done) buf done (- n done))]
          (cond
            (pos? r) (recur (+ done r))
            (zero? r) (throw (ex-info (str "dao.jing.file pread met end of file on "
                                           (:path handle) " before a complete read")
                                      {:operation "pread", :path (:path handle),
                                       :offset offset, :wanted n, :read done}))
            (= r (- eintr)) (recur done)
            :else (throw (io-error handle "pread" (- r)
                                   {:offset offset, :wanted n, :read done}))))))))


(defn read-s32be
  "The signed 32-bit big-endian integer at offset, converted by the wrapper
   (review F2): a prefix with the top bit set is negative."
  [handle offset]
  (with-native 4
    (fn [buf]
      (read-into! handle buf offset 4)
      (c-s32be-get buf 0))))


(defn read-bytes
  "The n bytes at offset, copied into a fresh byte array."
  [handle offset n]
  (if (zero? n)
    (byte-array 0)
    (with-native n
      (fn [buf]
        (read-into! handle buf offset n)
        (ffi/read-array buf n)))))


(defn truncate!
  "ftruncate to len. dao.jing.file calls it only at its validated recovery
   cut; nothing here truncates on a failed read."
  [handle len]
  (let [r (c-truncate (fd-of handle) len)]
    (when (neg? r) (throw (io-error handle "ftruncate" (- r) {:length len})))
    nil))


(defn- write-from!
  "Write buf[0, n) at file offset `offset`: short writes continue, EINTR
   retries, zero progress or an error throws."
  [handle buf offset n]
  (let [fd (fd-of handle)]
    (loop [done 0]
      (when (< done n)
        (let [r (pwrite-once fd (+ offset done) buf done (- n done))]
          (cond
            (pos? r) (recur (+ done r))
            (= r (- eintr)) (recur done)
            (zero? r) (throw (ex-info (str "dao.jing.file pwrite made no progress on "
                                           (:path handle))
                                      {:operation "pwrite", :path (:path handle),
                                       :offset offset, :wanted n, :written done}))
            :else (throw (io-error handle "pwrite" (- r)
                                   {:offset offset, :wanted n, :written done}))))))))


(defn- refuse-if-failed!
  "Throw when this handle is fail-closed (review F3): a previous append or
   fsync failed, so the end of the file is uncertain and nothing more may be
   appended through this descriptor until it is closed and the file reopened
   (where dao.jing.file's validated recovery decides what stands)."
  [handle]
  (when-let [operation (some-> (:failed handle) deref)]
    (throw (ex-info (str "dao.jing.file " (:path handle) " refuses further appends: a "
                         "previous " operation " failed on this descriptor; close and "
                         "reopen the file to recover")
                    {:path (:path handle), :operation operation,
                     :dao.posix.file/fail-closed true}))))


(defn- fail-closed!
  "Record operation's failure on the handle (first failure wins)."
  [handle operation]
  (when-let [failed (:failed handle)]
    (compare-and-set! failed nil operation)))


(defn append-frame!
  "Write the length-prefixed frame at the current end of the file (fstat):
   the s32BE length (packed by the wrapper, review F2), then the frame bytes,
   as one copied buffer. The caller holds the handle lock (dao.jing.file's
   make-put), which is what makes end-of-file stable here.

   Fail-closed (review F3, J4c): a failure part-way through this write can
   leave a torn frame at the end of the file, and appending a later valid
   frame behind it would make the next open refuse or, if the torn bytes
   happen to parse, truncate acknowledged data. So the failure is recorded on
   this descriptor (private to the handle, never shared state): every later
   append or sync through it throws, naming the path and the failed
   operation; dao.jing.file's get keeps serving its in-memory map (nothing
   here touches it); close still closes once. Reopening the file runs the
   shared validated recovery, which drops a torn tail. This is a jolt-only
   divergence: the JVM, Node and Dart handles stay usable after a failed
   write (spec §5, Files row). The mark is set by any throwable from the
   write loop, broader than the design's persistence-uncertain criterion
   (deepseek's J4c review): a failure that wrote nothing also closes the
   handle, which is conservative and safe."
  [handle frame]
  (refuse-if-failed! handle)
  (let [len (alength frame)
        total (+ 4 len)
        end (length handle)]
    (with-native total
      (fn [buf]
        (c-s32be-put buf 0 len)
        (when (pos? len) (ffi/write-array buf :int8 frame 4))
        (try (write-from! handle buf end total)
             (catch Throwable t
               (fail-closed! handle "pwrite")
               (throw t)))))
    nil))


(defn sync!
  "fsync: a full sync of the descriptor, not a port flush and not
   fdatasync. A put is acknowledged only after it.

   A failed fsync is never retried, here or by the caller, and it makes the
   handle fail-closed like a failed append (review F3). The reason a retry
   is unsafe: on Linux a failed fsync may already have dropped the dirty
   pages it could not write (marking them clean), so a second fsync can
   answer success while the frame never reached storage. Only a reopen,
   whose validated recovery reads what the file actually holds, can say
   which frames stand."
  [handle]
  (refuse-if-failed! handle)
  (let [r (fsync-once (fd-of handle))]
    (when (neg? r)
      (fail-closed! handle "fsync")
      (throw (io-error handle "fsync" (- r) {})))
    nil))


(defn close!
  "Release the descriptor: exactly one close attempt per handle, never
   retried after EINTR (the descriptor is released anyway, and a retry could
   close one another thread was given since). A second call is a no-op."
  [handle]
  (when (compare-and-set! (:released handle) false true)
    (let [r (close-once (:fd handle))]
      (when (and (neg? r) (not= r (- eintr)))
        (throw (io-error handle "close" (- r) {})))))
  nil)


;; =============================================================================
;; J4b: directory ownership, bounded reads, HEAD replacement
;; =============================================================================

;; dao.space.store.fs's :jolt arms call these. Its `held` registry, the
;; refusal texts and the lock!/atomic-replace! sequences stay there; this is
;; only the syscalls behind them.

(defn- native-path
  "path resolved against user.dir, as java.io.File does (see `open`)."
  [path]
  (.getAbsolutePath (java.io.File. ^String path)))


(defn- fs-error
  [operation path errno data]
  (ex-info (str "dao.posix.file " operation " failed on " path ": "
                (error-text errno) " (errno " errno ")")
           (merge {:operation operation, :path path, :errno errno} data)))


;; native/jolt-file/jolt_file.c JF_*
(def ^:private kinds
  {0 :absent, 1 :regular, 2 :directory, 3 :fifo, 4 :symlink, 5 :other})


(defn classify
  "What path names, as :absent, :regular, :directory, :fifo, :symlink or
   :other: lstat without `follow?` (a symlink is :symlink, dangling or not),
   stat with it (a dangling symlink is :absent). Any failure other than no
   entry throws; it is never read as absence."
  [path follow?]
  (let [r (path-bytes! (native-path path) #(c-classify %1 %2 (if follow? 1 0)))]
    (when (neg? r) (throw (fs-error (if follow? "stat" "lstat") path (- r) {})))
    (kinds r)))


;; Single system calls the J4b sequences make, through vars for the same
;; test-only indirection as pread-once: the HEAD seam trace and the injected
;; lock, rename and directory-sync failures redefine them.

(defn- lock-once
  [fd]
  (c-lock fd))


(defn- open-excl-once
  [p n]
  (c-open-excl p n))


(defn- rename-once
  [from to]
  (path-bytes! from (fn [a n1] (path-bytes! to (fn [b n2] (c-rename a n1 b n2))))))


(defn- sync-dir-once
  [dir]
  (path-bytes! dir c-sync-dir))


(defn fidentity
  "[st_dev st_ino] of the open descriptor fd (the O_CLOEXEC gate compares
   descriptors by identity, never by number)."
  [fd]
  (with-native 16
    (fn [out]
      (let [r (c-fidentity fd out)]
        (when (neg? r) (throw (fs-error "fstat" (str "fd " fd) (- r) {})))
        (vec (ffi/read-array out :uint64 2))))))


(defn lock-file!
  "Open (creating) the lock file at path, close-on-exec, and take its
   whole-file fcntl write lock without waiting. Answers the handle on
   success, :held when another process holds the lock (EAGAIN/EACCES; this
   handle is closed first, and only this one), and throws on any other
   failure (closing this handle). The lock is released by close! of the
   handle, exactly once: a record lock drops with the descriptor."
  [path]
  (let [fd (path-bytes! (native-path path) c-open)]
    (when (neg? fd) (throw (fs-error "open" path (- fd) {})))
    (let [h {:fd fd, :path path, :released (atom false)}
          r (try (lock-once fd)
                 (catch Throwable t (close! h) (throw t)))]
      (cond
        (zero? r) h
        (= 1 r) (do (close! h) :held)
        :else (do (close! h) (throw (fs-error "fcntl(F_SETLK)" path (- r) {})))))))


(defn realpath
  "The canonical path of an existing path (realpath)."
  [path]
  (with-native 4096
    (fn [buf]
      (let [r (path-bytes! (native-path path) #(c-realpath %1 %2 buf 4096))]
        (when (neg? r) (throw (fs-error "realpath" path (- r) {})))
        (text/utf8-decode (ffi/read-array buf r))))))


(defn- read-to!
  "pread from fd into buf[0, cap) until end of file or cap bytes: the count.
   Short reads continue, EINTR retries, an error throws."
  [path fd buf cap]
  (loop [done 0]
    (if (>= done cap)
      done
      (let [r (pread-once fd done buf done (- cap done))]
        (cond
          (pos? r) (recur (+ done r))
          (zero? r) done
          (= r (- eintr)) (recur done)
          :else (throw (fs-error "pread" path (- r) {:read done})))))))


(defn- with-read-descriptor
  "(f fd) over path opened read-only, non-blocking and close-on-exec, the
   descriptor rechecked by fstat: :not-regular unless it is a regular file.
   Closed however f exits."
  [path f]
  (let [fd (path-bytes! (native-path path) c-open-read)]
    (when (neg? fd) (throw (fs-error "open" path (- fd) {})))
    (let [h {:fd fd, :path path, :released (atom false)}]
      (try
        (let [k (c-fclassify fd)]
          (when (neg? k) (throw (fs-error "fstat" path (- k) {})))
          (if (= :regular (kinds k)) (f fd) :not-regular))
        (finally (close! h))))))


(def ^:private max-bound
  ;; the JVM arm reads (int (inc limit)) bytes: one more than the limit must
  ;; fit a signed 32-bit count
  2147483646)


(defn read-bounded
  "At most limit + 1 bytes of the regular file at path, as a fresh byte
   array; :absent when no entry exists there (lstat); :not-regular for a
   dangling symlink, a directory, a FIFO or anything else that is not a
   regular file, decided by stat before the open and by fstat of the
   non-blocking descriptor after it, so a FIFO never blocks. A symlink to a
   regular file is followed."
  [path limit]
  (when-not (and (integer? limit) (<= 0 limit max-bound))
    (throw (ex-info (str "read-bounded limit out of range: " limit)
                    {:path path, :limit limit})))
  (cond
    (= :absent (classify path false)) :absent
    (not= :regular (classify path true)) :not-regular
    :else (let [cap (inc limit)]
            (with-native cap
              (fn [buf]
                (with-read-descriptor path
                  (fn [fd]
                    (let [n (read-to! path fd buf cap)]
                      (if (zero? n) (byte-array 0) (ffi/read-array buf n))))))))))


(def ^:private text-chunk (* 64 1024))


(defn read-all
  "Every byte of the regular file at path (following a symlink), or :absent
   when nothing is there (stat); :not-regular otherwise. Read to end of file
   in bounded chunks."
  [path]
  (case (classify path true)
    :absent :absent
    :regular (with-native text-chunk
               (fn [buf]
                 (with-read-descriptor path
                   (fn [fd]
                     (loop [offset 0, acc (transient [])]
                       (let [n (loop [done 0]
                                 (if (>= done text-chunk)
                                   done
                                   (let [r (pread-once fd (+ offset done) buf done
                                                       (- text-chunk done))]
                                     (cond
                                       (pos? r) (recur (+ done r))
                                       (zero? r) done
                                       (= r (- eintr)) (recur done)
                                       :else (throw (fs-error "pread" path (- r)
                                                              {:offset offset}))))))
                             acc (if (pos? n)
                                   (reduce conj! acc (ffi/read-array buf n))
                                   acc)]
                         (if (< n text-chunk)
                           (byte-array (persistent! acc))
                           (recur (+ offset n) acc))))))))
    :not-regular))


(defn- write-new-from!
  "Write every byte of bs to the descriptor fd just created for path, fsync,
   then close with its outcome checked (closing on any failure first)."
  [path fd bs]
  (let [h {:fd fd, :path path, :released (atom false)}
        n (alength bs)]
    (try
      (when (pos? n)
        (with-native n
          (fn [buf]
            (ffi/write-array buf bs)
            (write-from! h buf 0 n))))
      (sync! h)
      (catch Throwable t
        (try (close! h) (catch Throwable _ nil))
        (throw t)))
    (close! h)))


(defn write-new-synced!
  "The HEAD temp, steps 1-3 of the replacement: create path exclusively
   (O_CREAT | O_EXCL, mode 0666 under the umask, close-on-exec), write every
   byte of bs (short writes continue, EINTR retries, zero progress throws),
   fsync, then close with its outcome checked. The temp is left in place on
   failure, as the other hosts leave theirs; nothing here renames."
  [path bs]
  (let [fd (path-bytes! (native-path path) open-excl-once)]
    (when (neg? fd) (throw (fs-error "open(O_EXCL)" path (- fd) {})))
    (write-new-from! path fd bs)))


(def ^:private eexist (c-eexist))


(defn write-new-private!
  "A key file (J4d): create path exclusively with mode 0600 (owner-only;
   the umask can only narrow it), close-on-exec, write every byte of bs,
   fsync and close checked. Answers :exists, writing nothing, when any entry
   is already there: a key file is never overwritten."
  [path bs]
  (let [fd (path-bytes! (native-path path) c-open-private)]
    (cond
      (= fd (- eexist)) :exists
      (neg? fd) (throw (fs-error "open(O_EXCL, 0600)" path (- fd) {}))
      :else (do (write-new-from! path fd bs) nil))))


(defn rename!
  "rename(from, to), atomic within one directory: no copy-and-delete
   fallback, so a cross-device rename fails."
  [from to]
  (let [r (rename-once (native-path from) (native-path to))]
    (when (neg? r) (throw (fs-error "rename" from (- r) {:to to})))
    nil))


(defn sync-dir!
  "Open the directory, fsync it, close it: a rename in it is then durable,
   not merely visible. A failure throws; it is never read as a host without
   directory sync."
  [dir]
  (let [r (sync-dir-once (native-path dir))]
    (when (neg? r) (throw (fs-error "fsync(directory)" dir (- r) {})))
    nil))
