(ns dao.stream.udp
  "The jolt native datagram host seam and UDP value channel facade
   (docs/design/dao.stream.datagram.md §§3-7; J7 architecture findings).

   Exposes the shared value channel API from `dao.stream.udp.common`,
   `UdpHandle`, `make-attacher`, and the production native datagram `bind!`."
  (:require
    [clojure.string :as str]
    [dao.host.bytes :as bytes]
    [dao.stream :as stream]
    [dao.stream.datagram :as datagram]
    [dao.stream.udp.common :as common]
    [jolt.ffi :as ffi]
    [jolt.io-poller :as poller]
    [jolt.socket.native :as native]))


;; =============================================================================
;; Re-export common value-channel surface
;; =============================================================================

(def transport-type common/transport-type)
(def max-datagram common/max-datagram)
(def default-max-message-bytes common/default-max-message-bytes)
(def default-max-partial-messages common/default-max-partial-messages)
(def default-step-budget common/default-step-budget)

(def descriptor? common/descriptor?)
(def address-key common/address-key)
(def make-port common/make-port)
(def send-value! common/send-value!)
(def send-to! common/send-to!)
(def receive! common/receive!)
(def projection common/projection)
(def step! common/step!)
(def reading-cursor common/reading-cursor)

(defn port-step!
  ([port] (common/port-step! port))
  ([port budget] (common/port-step! port budget)))


(defn diagnostics
  "Access the instance-owned diagnostics of a datagram seam."
  [seam]
  (when-let [d (:diagnostics seam)]
    (if (fn? d) (d) @d)))


(deftype UdpHandle
  [port host dest-port descriptor]

  stream/IDaoStreamDescriptor

  (descriptor
    [_]
    {:dao.stream/outcome :dao.stream/ok
     :dao.stream/descriptor descriptor
     :dao.stream/identity (:dao.stream/identity descriptor)})


  stream/IDaoStreamWriter

  (append!
    [_ v]
    (common/send-value! port host dest-port v)))


(defn make-attacher
  [config]
  (common/make-attacher ->UdpHandle config))


;; =============================================================================
;; Native Datagram Constants and Syscalls
;; =============================================================================

(def platform native/os)

(def consts
  (case platform
    :macos {:sock-dgram 2 :ipproto-udp 17 :so-sndbuf 0x1001 :so-rcvbuf 0x1002
            :eagain 35 :emsgsize 40 :enobufs 55 :ebadf 9 :eintr 4}
    :linux {:sock-dgram 2 :ipproto-udp 17 :so-sndbuf 7 :so-rcvbuf 8
            :eagain 11 :emsgsize 90 :enobufs 105 :ebadf 9 :eintr 4}
    (throw (ex-info "dao.stream.udp: unsupported platform" {:platform platform}))))

(def SOCK-DGRAM (:sock-dgram consts))
(def IPPROTO-UDP (:ipproto-udp consts))
(def EAGAIN (:eagain consts))
(def ENOBUFS (:enobufs consts))
(def EMSGSIZE (:emsgsize consts))
(def EBADF (:ebadf consts))
(def EINTR (:eintr consts))

(ffi/defcfn c-sendto "sendto" [:int :pointer :size_t :int :pointer :uint] :ssize_t
            {:capture-native-error true})

(ffi/defcfn c-recvfrom "recvfrom" [:int :pointer :size_t :int :pointer :pointer] :ssize_t
            {:capture-native-error true})

(def ^:dynamic *sendto* c-sendto)
(def ^:dynamic *recvfrom* c-recvfrom)


;; =============================================================================
;; Exception-Safe Native Helpers
;; =============================================================================

(defn- int-cell [v]
  (let [p (ffi/alloc 4)]
    (ffi/write p :int v 0)
    p))

(defn- write-header! [sa family len]
  (if (= platform :macos)
    (do (ffi/write sa :uint8 len 0) (ffi/write sa :uint8 family 1))
    (ffi/write sa :uint16 family 0)))

(defn- alloc-sockaddr
  "Exception-safe allocation of sockaddr_storage and in/out length cell.
   Wraps the acquisition sequence so if length-cell allocation throws,
   the sockaddr buffer is freed immediately."
  []
  (let [sa (ffi/alloc native/sockaddr-storage-size)]
    (try
      (let [lenp (int-cell native/sockaddr-storage-size)]
        [sa lenp])
      (catch Throwable t
        (ffi/free sa)
        (throw t)))))

(defn- make-sockaddr
  "Exception-safe make-sockaddr: wraps acquisition sequence so that if
   address-string allocation (or any subsequent step) throws,
   the sockaddr buffer is freed immediately."
  ([family ip port] (make-sockaddr family ip port 0))
  ([family ip port scope-id]
   (let [len (native/sockaddr-length family)
         sa  (ffi/alloc len)]
     (try
       (let [src (ffi/string->ptr (str ip))]
         (try
           (native/write-header! sa family len)
           (native/set-sockaddr-port! sa port)
           (if (= 1 (native/c-inet-pton family src (+ sa (if (= family native/af-inet6) 8 4))))
             (do (when (and (= family native/af-inet6) scope-id)
                   (ffi/write sa :uint scope-id 24))
                 [sa len])
             (do (ffi/free sa) nil))
           (finally
             (ffi/free src))))
       (catch Throwable t
         (ffi/free sa)
         (throw t))))))

(alter-var-root #'native/alloc-sockaddr (constantly alloc-sockaddr))
(alter-var-root #'native/make-sockaddr (constantly make-sockaddr))


;; =============================================================================
;; Helpers
;; =============================================================================

(defn- parse-literal-host
  "Parse literal IP host (IPv4 or IPv6), stripping brackets if present.
   Rejects hostnames like 'localhost'."
  [h]
  (try
    (when (string? h)
      (let [clean (if (and (str/starts-with? h "[") (str/ends-with? h "]"))
                    (subs h 1 (dec (count h)))
                    h)]
        (if-let [[sa _] (native/make-sockaddr native/af-inet clean 0)]
          (do (ffi/free sa) {:family native/af-inet :ip clean})
          (if-let [[sa _] (native/make-sockaddr native/af-inet6 clean 0)]
            (do (ffi/free sa) {:family native/af-inet6 :ip clean})
            nil))))
    (catch Throwable _ nil)))


(defn- deposit-event!
  [deposit event]
  (try
    (stream/append! deposit event)
    (catch Throwable _ nil)))


(defn- failed-seam
  [deposit identity reason]
  (deposit-event! deposit (datagram/bind-failed-event identity reason))
  (let [diagnostics (atom [{:kind :bind-failed :reason reason}])]
    {:send! (fn [_ _ _]
              {:dao.stream/outcome :dao.stream/transport-error
               :dao.stream.datagram/reason "bind failed"})
     :close! (fn [] nil)
     :step! (fn [] {:progressed? false})
     :diagnostics diagnostics
     :diagnostic (fn [] (last @diagnostics))}))


;; =============================================================================
;; Native Datagram Seam bind!
;; =============================================================================

(defn bind!
  "Bind one native datagram socket per the seam contract (§3).
   `:bind-host` defaults to '127.0.0.1', `:bind-port` to 0 (ephemeral),
   `:max-bytes` to 1200.
   Returns {:send! f :close! f :step! f :diagnostics a :diagnostic f}."
  [{:keys [identity deposit bind-host bind-port max-bytes]
    :or {bind-host "127.0.0.1" bind-port 0}}]
  (let [max-bytes (long (or max-bytes datagram/default-max-bytes))
        parsed-bind (parse-literal-host bind-host)]
    (if-not parsed-bind
      (failed-seam deposit identity (str "invalid bind-host literal: " (pr-str bind-host)))
      (let [family (:family parsed-bind)
            bind-ip (:ip parsed-bind)
            [fd sock-err] (native/c-socket family SOCK-DGRAM IPPROTO-UDP)]
        (if (neg? fd)
          (failed-seam deposit identity (str "socket failed: errno " sock-err))
          (let [closed? (atom false)
                close-fd! (fn []
                            (when (compare-and-set! closed? false true)
                              (try (poller/cancel! fd) (catch Throwable _ nil))
                              (try (poller/forget! fd) (catch Throwable _ nil))
                              (native/c-close fd)))]
            (try
              (if-not (native/close-on-exec! fd)
                (do
                  (close-fd!)
                  (failed-seam deposit identity "close-on-exec! failed"))
                (let [[r-nb err-nb] (native/set-blocking! fd false)]
                  (if (neg? r-nb)
                    (do
                      (close-fd!)
                      (failed-seam deposit identity (str "O_NONBLOCK failed: errno " err-nb)))
                    (let [v6-fail (when (= family native/af-inet6)
                                    (let [[r-v6 err-v6] (native/set-int-option! fd native/ipproto-ipv6 native/ipv6-v6only 1)]
                                      (when (neg? r-v6)
                                        (str "IPV6_V6ONLY failed: errno " err-v6))))]
                      (if v6-fail
                        (do
                          (close-fd!)
                          (failed-seam deposit identity v6-fail))
                        (let [[sa len] (native/make-sockaddr family bind-ip bind-port)]
                          (if-not sa
                            (do
                              (close-fd!)
                              (failed-seam deposit identity (str "make-sockaddr failed for " bind-ip ":" bind-port)))
                            (let [[bind-r bind-err] (try
                                                      (native/c-bind fd sa len)
                                                      (finally (ffi/free sa)))]
                              (if (neg? bind-r)
                                (do
                                  (close-fd!)
                                  (failed-seam deposit identity (str "bind failed: errno " bind-err)))
                                (let [local (native/local-address fd)]
                                  (if-not local
                                    (do
                                      (close-fd!)
                                      (failed-seam deposit identity "getsockname failed"))
                                    (let [diagnostics (atom [])
                                          close-fn
                                          (fn []
                                            (when (compare-and-set! closed? false true)
                                              (try (poller/cancel! fd) (catch Throwable _ nil))
                                              (try (poller/forget! fd) (catch Throwable _ nil))
                                              (native/c-close fd)
                                              (deposit-event! deposit (datagram/closed-event identity)))
                                            nil)

                                          send-fn
                                          (fn [dest-host dest-port ^bytes payload]
                                            (if @closed?
                                              {:dao.stream/outcome :dao.stream/closed}
                                              (let [parsed-dest (parse-literal-host dest-host)]
                                                (if (or (nil? parsed-dest) (not= (:family parsed-dest) family))
                                                  (let [reason "IP family mismatch"]
                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))
                                                    {:dao.stream/outcome :dao.stream/transport-error
                                                     :dao.stream.datagram/reason reason})
                                                  (let [len (bytes/length payload)
                                                        buf (ffi/alloc (max 1 len))]
                                                    (try
                                                      (let [[dsa dlen] (native/make-sockaddr family (:ip parsed-dest) dest-port)]
                                                        (try
                                                          (if-not dsa
                                                            (let [reason "make-sockaddr failed for destination"]
                                                              (deposit-event! deposit (datagram/send-failed-event identity reason))
                                                              {:dao.stream/outcome :dao.stream/transport-error
                                                               :dao.stream.datagram/reason reason})
                                                            (do
                                                              (when (pos? len)
                                                                (ffi/write-array buf payload))
                                                              (let [[n e] (*sendto* fd buf len 0 dsa dlen)]
                                                                (cond
                                                                  (neg? n)
                                                                  (let [reason (str "sendto failed: errno " e)]
                                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))
                                                                    {:dao.stream/outcome :dao.stream/transport-error
                                                                     :dao.stream.datagram/reason reason})

                                                                  (not= n len)
                                                                  (let [reason (str "short send: sent " n " of " len " bytes")]
                                                                    (deposit-event! deposit (datagram/send-failed-event identity reason))
                                                                    {:dao.stream/outcome :dao.stream/transport-error
                                                                     :dao.stream.datagram/reason reason})

                                                                  :else
                                                                  {:dao.stream/outcome :dao.stream/ok}))))
                                                          (finally
                                                            (when dsa (ffi/free dsa)))))
                                                      (finally
                                                        (ffi/free buf))))))))

                                          step-fn
                                          (fn []
                                            (if @closed?
                                              {:progressed? false}
                                              (let [cap (inc max-bytes)
                                                    buf (ffi/alloc cap)]
                                                (try
                                                  (let [[rsa rlenp] (native/alloc-sockaddr)]
                                                    (try
                                                      (let [progressed? (volatile! false)]
                                                        (loop [budget 64]
                                                          (when (pos? budget)
                                                            (ffi/write rlenp :int native/sockaddr-storage-size 0)
                                                            (let [[n e] (*recvfrom* fd buf cap 0 rsa rlenp)]
                                                              (cond
                                                                (neg? n)
                                                                (cond
                                                                  ;; would-block: silent
                                                                  (or (= e EAGAIN) (= e ENOBUFS))
                                                                  nil

                                                                  ;; interruption: recoverable, no retry inside turn
                                                                  (= e EINTR)
                                                                  (swap! diagnostics conj
                                                                         {:kind :interrupted
                                                                          :errno e
                                                                          :reason (str "recvfrom interrupted: errno " e)})

                                                                  ;; fatal descriptor error: close seam once
                                                                  :else
                                                                  (do
                                                                    (swap! diagnostics conj
                                                                           {:kind :fatal-descriptor-error
                                                                            :errno e
                                                                            :reason (str "recvfrom fatal error: errno " e)})
                                                                    (close-fn)))

                                                                :else
                                                                (do
                                                                  (vreset! progressed? true)
                                                                  (if (> n max-bytes)
                                                                    ;; Oversize drop
                                                                    (recur (dec budget))
                                                                    (let [bs (if (zero? n)
                                                                               (bytes/alloc 0)
                                                                               (ffi/read-array buf n))
                                                                          src-ip (native/sockaddr-ip rsa)
                                                                          src-port (native/sockaddr-port rsa)]
                                                                      (deposit-event! deposit
                                                                                      (datagram/datagram-event identity src-ip src-port bs))
                                                                      (recur (dec budget)))))))))
                                                        {:progressed? @progressed?})
                                                      (finally
                                                        (when rsa (ffi/free rsa))
                                                        (when rlenp (ffi/free rlenp)))))
                                                  (finally
                                                    (ffi/free buf))))))

                                          seam {:send! send-fn
                                                :close! close-fn
                                                :step! step-fn
                                                :diagnostics diagnostics
                                                :diagnostic (fn [] (last @diagnostics))}]
                                      (deposit-event! deposit (datagram/bound-event identity (:ip local) (:port local)))
                                      seam))))))))))))
              (catch Throwable t
                (close-fd!)
                (failed-seam deposit identity (or (ex-message t) (str t)))))))))))
