{:deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/core.async {:mvn/version "1.8.741"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        http-kit/http-kit {:mvn/version "2.8.0"}
        ;; http-kit's websocket support requires ring.websocket.protocols
        org.ring-clojure/ring-websocket-protocols {:mvn/version "1.14.1"}
        io.github.rctcwyvrn/blake3 {:mvn/version "1.3"}}
 ;; The demo needs none of datomic, postgres, antlr, jsoup or stigmergy/chp.
 ;; Paths are relative to the Docker build context root (the repo root).
 :paths ["src/clj" "src/cljc" "resources"]}
