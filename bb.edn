{:tasks
 {gen:antlr
  {:doc "Generate the pinned grammars-v4 parsers for every target (antlr/*/manifest.edn): Java compiled into build/antlr/<g>/classes, JavaScript in build/antlr/<g>/js, Dart in lib/antlr/<g>; filters after --: --grammar g --target t"
   :task (apply shell "clojure" "-M:antlr-gen" *command-line-args*)}

  ;; jolt host lane (experimental, docs/design/yin.repl-jolt-implementation.md)
  bootstrap:jolt
  {:doc "Materialize the jolt-toolchain.edn pins into build/tools/jolt (mise Chez/CMake checked, jolt cloned at the full SHA, never pulled) and write build/tools/jolt-env.sh"
   :task (System/exit
           (:exit (shell {:continue true} "bb" "src/dev/jolt_bootstrap.clj")))}

  smoke:jolt
  {:doc "J0a baseline smoke under jolt -Srepro -M:jolt: tracked load of yang.antlr.export/packet and defcfn :blocking calls (needs bb bootstrap:jolt)"
   :task (System/exit
           (:exit (shell {:continue true} "sh" "-c"
                         ". build/tools/jolt-env.sh && \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt src/dev/jolt_smoke.clj")))}

  jolt
  {:doc "Run jolt -Srepro -M:jolt with the arguments given (a script path, -e ...), under build/tools/jolt-env.sh"
   :task (System/exit
           (:exit (apply shell {:continue true} "sh" "-c"
                         ". build/tools/jolt-env.sh && exec \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt \"$@\""
                         "jolt" *command-line-args*)))}

  qualify:jolt-libcrypto
  {:doc "J1b requalification: print this platform's observed libcrypto identity {:canonical-path :version-num :version :sha256} for jolt-toolchain.edn :native :libcrypto :qualified (the digest from bb and from the library, required equal); changes nothing (needs a built wrapper: bb build:jolt-native, or --requalify after a library change)"
   :task (System/exit
           (:exit (shell {:continue true} "bb" "native/jolt-crypto/qualify.clj")))}

  probe:jolt-crypto
  {:doc "J1b: libcrypto provenance (qualified, missing, undeclared, version-floor, wrong-library-first, Linux LD_PRELOAD) and 256 MiB :blocking hash collect-safety, each in a child jolt process (needs bb build:jolt-native)"
   :task (System/exit
           (:exit (shell {:continue true} "bb" "native/jolt-crypto/probes/run.clj")))}

  build:jolt-native
  {:doc "Fetch (by pinned SHA-256, only when absent) and build the jolt-toolchain.edn :native sources with the mise-pinned CMake into build/native/<platform>/"
   :task (System/exit
           (:exit (apply shell {:continue true} "bb" "src/dev/jolt_native.clj" *command-line-args*)))}

  test:jolt-host
  {:doc "J1: the dao.host oracle (conformance, bytes, float, text tests) under jolt -Srepro -M:jolt:jolt-test through src/dev/jolt_test_runner.clj; counts per namespace, nonzero exit on any failure, error or load failure (needs bb bootstrap:jolt)"
   :task (System/exit
           (:exit (shell {:continue true} "sh" "-c"
                         ". build/tools/jolt-env.sh && \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-test src/dev/jolt_test_runner.clj dao.host.conformance-test dao.host.bytes-test dao.host.float-test dao.host.text-test")))}

  compare:jolt-host
  {:doc "J1: run src/dev/jolt_profile_compare.cljc on the JVM and on jolt (public vars, arities, refusal data, a differential case battery over dao.host.*) and diff the two; writes build/j1-logs/compare-{jvm,jolt}.edn and compare.diff; exit 1 when they differ"
   :task (System/exit
           (:exit (shell {:continue true} "sh" "-c"
                         "mkdir -p build/j1-logs && clojure -M src/dev/jolt_profile_compare.cljc | grep '^\\[' > build/j1-logs/compare-jvm.edn && . build/tools/jolt-env.sh && \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt src/dev/jolt_profile_compare.cljc | grep '^\\[' > build/j1-logs/compare-jolt.edn && diff build/j1-logs/compare-jvm.edn build/j1-logs/compare-jolt.edn > build/j1-logs/compare.diff; s=$?; cat build/j1-logs/compare.diff; exit $s")))}

  test:jolt-host-diag
  {:doc "J1 DIAGNOSTIC, not the oracle verdict: dao.host.float-test and dao.host.text-test, unchanged, under jolt with the :jolt-diag stand-in for the corpus loader dao.jing.cbor-fixtures (which cannot load on jolt); see src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc"
   :task (System/exit
           (:exit (shell {:continue true} "sh" "-c"
                         ". build/tools/jolt-env.sh && \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-diag:jolt-test src/dev/jolt_test_runner.clj dao.host.float-test dao.host.text-test")))}

  test:jolt-json
  {:doc "J1: the jolt clojure.data.json shim (src/jolt/clojure/data/json.jolt) against src/dev/jolt_json_test.cljc, under jolt; the same file passes against the real data.json on the JVM (clojure -M:dev, see its header)"
   :task (System/exit
           (:exit (shell {:continue true} "sh" "-c"
                         ". build/tools/jolt-env.sh && \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-test src/dev/jolt_test_runner.clj jolt-json-test")))}

  test:jolt-runner-self
  {:doc "J1: prove src/dev/jolt_test_runner.clj counts a throwing test as one error and keeps running (the jolt-runner-sentinel namespace)"
   :task (System/exit
           (:exit (shell {:continue true} "sh" "-c"
                         ". build/tools/jolt-env.sh && \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-test src/dev/jolt_test_runner.clj --self-test")))}

  build:yin-repl-node
  {:doc "Compile the Node yin.repl (shadow-cljs build :yin-repl) to target/yin-repl.js"
   ;; The Node lanes (test:cljs and its variants) depend on this task, so the
   ;; generated JavaScript parser reaches them through it.
   :depends [gen:antlr]
   ;; yin.repl.dht-process-test spawns it as the JVM-to-Node reader of
   ;; DHT epic S5, a required leg: a missing build fails that test.
   :task (shell "clj -M:cljs -m shadow.cljs.devtools.cli compile yin-repl")}

  build:yin-repl-peer
  {:doc "Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe"
   ;; The Dart lanes depend on this task, so the generated Dart parser
   ;; reaches them through it.
   :depends [gen:antlr]
   ;; Process B of the R5 slice is a whole program rather than a test
   ;; namespace, and this project's cljd.core carries the Flutter extensions,
   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.
   ;; It is compiled alone and first: the test build rewrites the same
   ;; cljd-out tree, so a peer built after it would import a tree it does
   ;; not match.  The R5 cross-host tests spawn this one exe from the JVM
   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or
   ;; `bb test:cljs` without it skips those tests with a printed notice
   ;; rather than failing.
   :task (do (shell "mkdir -p build")
             (shell "clojure -M:clojuredart:cljd compile yin.repl.slice-peer")
             (shell "dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer"))}

  ;; Fast default lanes: no ^:slow test, no dao.test-slow/guard body.
  test:clj {:doc "JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build"
            :depends [build:yin-repl-node gen:antlr]
            :task (shell "clojure -M:test -e :slow")}

  test:cljs {:doc "Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build"
             :depends [build:yin-repl-node]
             :task (shell "clj -M:cljs -m shadow.cljs.devtools.cli compile test")}

  test:cljd {:doc "Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP"
             :depends [build:yin-repl-peer]
             :task (shell "bb src/dev/cljd_agg.clj")}

  ;; Every test, slow ones included (about 20+ minutes on the JVM).
  test:all:clj {:doc "Every JVM test, ^:slow included (20+ minutes); for unattended runs"
                :depends [build:yin-repl-node gen:antlr]
                :task (shell "clojure -M:test")}

  test:all:cljs {:doc "Every Node test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)"
                 :depends [build:yin-repl-node]
                 :task (shell {:extra-env {"DATOM_SLOW_TESTS" "1"}}
                              "clj -M:cljs -m shadow.cljs.devtools.cli compile test")}

  test:all:cljd {:doc "Every Dart test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)"
                 :depends [build:yin-repl-peer]
                 :task (shell {:extra-env {"DATOM_SLOW_TESTS" "1"}}
                              "bb src/dev/cljd_agg.clj")}

  ;; Only the slow tests. Node and Dart select by namespace, so the other
  ;; tests inside the nine namespaces that use dao.test-slow/guard also run.
  test:slow:clj {:doc "Only the ^:slow JVM tests (about 14 minutes for long-loops-test); for unattended runs"
                 :depends [build:yin-repl-node gen:antlr]
                 :task (shell "clojure -M:test -i :slow")}

  test:slow:cljs {:doc "Node: only namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)"
                  :depends [build:yin-repl-node]
                  :task (let [re (-> (shell {:out :string}
                                            "bb src/dev/cljd_agg.clj --slow-regex")
                                     :out
                                     clojure.string/trim)]
                          (shell {:extra-env {"DATOM_SLOW_TESTS" "1"}}
                                 "clj" "-M:cljs" "-m" "shadow.cljs.devtools.cli"
                                 "compile" "test" "--config-merge"
                                 (str "{:ns-regexp \"" re "\"}")))}

  test:slow:cljd {:doc "Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)"
                  :depends [build:yin-repl-peer]
                  :task (shell {:extra-env {"DATOM_SLOW_TESTS" "1"}}
                               "bb src/dev/cljd_agg.clj --slow-only")}

  test:slow {:doc "Only the slow tests on every lane: JVM by tag, Node and Dart by namespace"
             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}

  test:all {:doc "Every test on every lane, slow ones included (JVM, Node, Dart)"
            :depends [test:all:clj test:all:cljs test:all:cljd]}

  test {:doc "All three lanes in their fast default form (JVM, Node, Dart)"
        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}

  ;; Only the tests a change can affect (src/dev/affected.clj): the
  ;; reverse require closure of the changed files since the merge-base
  ;; with master. Extra args pass through (--base REF, --changed FILE...).
  ;; Exit 2 on a wide change (deps.edn, bb.edn, src/dev/, ...): run bb test.
  test:changed {:doc "Fast tests a change can affect, three lanes in parallel"
                :task (System/exit
                        (:exit (apply shell {:continue true}
                                      "bb" "src/dev/affected.clj"
                                      *command-line-args*)))}

  test:changed:clj {:doc "JVM lane of test:changed"
                    :task (System/exit
                            (:exit (apply shell {:continue true}
                                          "bb" "src/dev/affected.clj"
                                          "--lane" "clj" *command-line-args*)))}

  test:changed:cljs {:doc "Node lane of test:changed"
                     :task (System/exit
                             (:exit (apply shell {:continue true}
                                           "bb" "src/dev/affected.clj"
                                           "--lane" "cljs"
                                           *command-line-args*)))}

  test:changed:cljd {:doc "Dart lane of test:changed"
                     :task (System/exit
                             (:exit (apply shell {:continue true}
                                           "bb" "src/dev/affected.clj"
                                           "--lane" "cljd"
                                           *command-line-args*)))}

  test:changed:list {:doc "What test:changed would run and why; runs nothing"
                     :task (System/exit
                             (:exit (apply shell {:continue true}
                                           "bb" "src/dev/affected.clj"
                                           "--list" *command-line-args*)))}

  ;; Subsystem tests (src/dev/affected.clj): canonical subsystems defined
  ;; in src/dev/subsystems.edn. Positional arguments name subsystems; flags
  ;; pass through (--lane L, --list, --slow).
  test:sub {:doc "Subsystem tests, three lanes in parallel: bb test:sub <subsystem>... [--slow]"
            :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg "--")))
                                                 *command-line-args*)
                        sub-args (mapcat (fn [s] ["--subsystem" s]) subs)]
                    (System/exit
                      (:exit (apply shell {:continue true}
                                    "bb" "src/dev/affected.clj"
                                    (concat sub-args flags)))))}

  test:sub:clj {:doc "JVM lane of test:sub: bb test:sub:clj <subsystem>... [--slow]"
                :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg "--")))
                                                     *command-line-args*)
                            sub-args (mapcat (fn [s] ["--subsystem" s]) subs)]
                        (System/exit
                          (:exit (apply shell {:continue true}
                                        "bb" "src/dev/affected.clj"
                                        "--lane" "clj"
                                        (concat sub-args flags)))))}

  test:sub:cljs {:doc "Node lane of test:sub: bb test:sub:cljs <subsystem>... [--slow]"
                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg "--")))
                                                      *command-line-args*)
                             sub-args (mapcat (fn [s] ["--subsystem" s]) subs)]
                         (System/exit
                           (:exit (apply shell {:continue true}
                                         "bb" "src/dev/affected.clj"
                                         "--lane" "cljs"
                                         (concat sub-args flags)))))}

  test:sub:cljd {:doc "Dart lane of test:sub: bb test:sub:cljd <subsystem>... [--slow]"
                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg "--")))
                                                      *command-line-args*)
                             sub-args (mapcat (fn [s] ["--subsystem" s]) subs)]
                         (System/exit
                           (:exit (apply shell {:continue true}
                                         "bb" "src/dev/affected.clj"
                                         "--lane" "cljd"
                                         (concat sub-args flags)))))}

  test:sub:list {:doc "What test:sub would run, prerequisites and seams: bb test:sub:list <subsystem>..."
                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg "--")))
                                                      *command-line-args*)
                             sub-args (mapcat (fn [s] ["--subsystem" s]) subs)]
                         (System/exit
                           (:exit (apply shell {:continue true}
                                         "bb" "src/dev/affected.clj"
                                         "--list"
                                         (concat sub-args flags)))))}
  }}
