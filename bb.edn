{:tasks
 {gen:python-antlr
  {:doc "Generate and compile the pinned grammars-v4 Python3 parser into build/antlr/python3/classes (antlr/python3/manifest.edn)"
   :task (shell "clojure -M:antlr-gen")}

  test:clj {:doc "Run JVM tests (via clj), skipping ^:slow ones; the DHT process test needs the Node REPL build"
            :depends [build:yin-repl-node gen:python-antlr]
            :task (shell "clojure -M:test -e :slow")}

  test:slow {:doc "Run only the ^:slow JVM tests (about 14 minutes for long-loops-test); for unattended runs"
             :depends [build:yin-repl-node gen:python-antlr]
             :task (shell "clojure -M:test -i :slow")}

  build:yin-repl-node
  {:doc "Compile the Node yin.repl (shadow-cljs build :yin-repl) to target/yin-repl.js"
   ;; yin.repl.dht-process-test spawns it as the JVM-to-Node reader of
   ;; DHT epic S5, a required leg: a missing build fails that test.
   :task (shell "clj -M:cljs -m shadow.cljs.devtools.cli compile yin-repl")}

  test:cljs {:doc "Run Node tests (via shadow-cljs with :cljs alias)"
             :task (shell "clj -M:cljs -m shadow.cljs.devtools.cli compile test")}

  build:yin-repl-peer
  {:doc "Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe"
   ;; Process B of the R5 slice is a whole program rather than a test
   ;; namespace, and this project's cljd.core carries the Flutter extensions,
   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.
   ;; It is compiled alone and first: the test build rewrites the same
   ;; cljd-out tree, so a peer built after it would import a tree it does
   ;; not match.  The R5 cross-host tests spawn this one exe from the JVM
   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or
   ;; `bb test:cljs` without it skips those tests with a printed notice
   ;; rather than failing.
   :task (do (shell "mkdir -p build")
             (shell "clojure -M:clojuredart:cljd compile yin.repl.slice-peer")
             (shell "dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer"))}

  test:cljd {:doc "Run Dart tests (via clojure -M:clojuredart:cljd)"
             :depends [build:yin-repl-peer]
             :task (shell "clojure -M:clojuredart:cljd test")}

  test {:doc "Run all tests (cross-host R5 pairs need the Dart peer, and the DHT process test the Node REPL, so build them first)"
        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}}}
