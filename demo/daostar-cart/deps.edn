;; The dao.star cart demo: a self-contained project.
;;
;; The library it composes (dao.stream, dao.star, dao.space, dao.lease,
;; dao.await, yin.vm) is not a path dependency: it is pinned to one datomworld
;; master commit and resolved from GitHub, so this demo builds and runs
;; reproducibly from a clean checkout.  `:deps/root "src"` points
;; tools.deps at the manifest inside that checkout whose :paths reach the
;; library sources; this file's own :paths shadow the demo sources locally.
;;
;; Bump :git/sha deliberately: the demo freezes the design it showcases.

{:paths ["src/clj" "src/cljc" "resources"]
 :deps {datomworld/datomworld
        {:git/url "https://github.com/sonwh98/datomworld.git"
         :git/sha "fce91d22303f6246c38560ee2f9066f2b2a0fdf9"
         :deps/root "src"}
        org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/core.async {:mvn/version "1.8.741"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        http-kit/http-kit {:mvn/version "2.8.0"}
        ;; http-kit's websocket support requires ring.websocket.protocols
        org.ring-clojure/ring-websocket-protocols {:mvn/version "1.14.1"}
        io.github.rctcwyvrn/blake3 {:mvn/version "1.3"}}
 ;; The demo needs none of datomic, postgres, antlr, jsoup or stigmergy/chp.
 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/url "https://github.com/cognitect-labs/test-runner"
                 :git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test"]}}}
